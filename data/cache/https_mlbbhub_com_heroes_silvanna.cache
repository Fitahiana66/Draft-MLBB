s-3\",\"children\":[[\"$\",\"article\",\"epic\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #B07ECC, #B07ECC33)\",\"boxShadow\":\"0 0 12px -2px #B07ECC80\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#B07ECC\",\"background\":\"#B07ECC1a\",\"border\":\"1px solid #B07ECC40\"},\"children\":\"Epic\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Silvanna\",\"rank\":\"Epic\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=epic\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Epic\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Epic\",\"name\":\"Silvanna\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"52.17\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Silvanna\",\"delta\":\"+0.94%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"1.69\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"3.25\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Epic\"}}]]}]]}],[\"$\",\"article\",\"legend\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #4dc9f6, #4dc9f633)\",\"boxShadow\":\"0 0 12px -2px #4dc9f680\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#4dc9f6\",\"background\":\"#4dc9f61a\",\"border\":\"1px solid #4dc9f640\"},\"children\":\"Legend\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Silvanna\",\"rank\":\"Legend\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=legend\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Legend\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Legend\",\"name\":\"Silvanna\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"51.83\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Silvanna\",\"delta\":\"+0.60%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"1.37\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"2.70\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Legend\"}}]]}]]}],[\"$\",\"article\",\"mythic\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[\"$La0\",\"$La1\",\"$La2\"]}],\"$La3\",\"$La4\"]}]\n7e:[\"$\",\"h2\",\"h2-1\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Silvanna is a private duel inside a public fight\"]}]\n7f:[\"$\",\"p\",\"p-4\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Silvanna is not a general-purpose initiator. She is a private duel inside a public fight.\"}]\n80:[\"$\",\"p\",\"p-5\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Everything in her kit points toward one idea: trap one hero, stay glued to that hero, and let repeated hits make the later part of the trade stronger than the first. Her passive rewards staying on target. Her first skill is not there to start every engage on sight; it is there to make sure the target cannot walk away once the fight has started. Her second skill is the actual verdict. The spin keeps pulling, keeps hitting, keeps stacking pressure, and forces the target to either leave immediately or die where they stand.\"}]\n81:[\"$\",\"p\",\"p-6\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"That is why Silvanna feels unfair in the right draft and toothless in the wrong one. When the enemy cannot displace her and cannot cleanse the catch, every repeated hit becomes a countdown. When they can break the cage or drag her off the target, the whole hero collapses into a melee body with mediocre waveclear and no second plan.\"}]\n82:[\"$\",\"p\",\"p-7\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Play her like a specialist. She does not want to \\\"start the fight.\\\" She wants to decide who is not allowed to play it.\"}]\n83:[\"$\",\"h2\",\"h2-2\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Laning: the first 5 minutes\"]}]\n84:[\"$\",\"p\",\"p-8\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Silvanna's first job in lane is not winning every trade. It is arriving at the first Turtle with health, level lead, and one spell still worth respecting.\"}]\n85:[\"$\",\"ol\",\"ol-0\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Take Spiral Strangling first and angle it through both hero and wave.\"}],\" The skill deals reduced damage to minions, so a pure waveclear cast is a bad trade. Stand off-center, clip the opposing EXP laner with the outer path, and make the lane shove only when it also taxes their HP bar.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Treat Cometic Lance as the answer, not the question.\"}],\" Hold it until the enemy burns a dash, steps up for the cannon minion, or commits into your side of the lane. Missing the first hit removes your stick tool and your escape in the same breath.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Spend Vengeance only on real all-ins or the first objective fight.\"}],\" Press it after Imperial Justice lands and your spin has already started. If you use it on a half trade at minute 2, the minute 3 rotation becomes harmless and the enemy gets to contest Turtle without respecting you.\"]}],\"\\n\"]}]\n86:[\"$\",\"p\",\"p-9\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"If you are even on lane by minute 4, that is fine. Silvanna is not farming for an endless side-lane. She is farming for one forced fight around river where a trapped jungler or mid laner decides the objective.\"}]\n87:[\"$\",\"h2\",\"h2-3\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The power spike you are farming toward\"]}]\n88:[\"$\",\"p\",\"p-10\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Silvanna's real two-item spike is Genius Wand plus Concentrated Energy, usually around minute 8 to 10 after boots.\"}]\n89:[\"$\",\"p\",\"p-11\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Genius Wand is the first half of the trick. Its passive strips magic defense every time you keep damage flowing, which is exactly what Silvanna does once Spiral Strangling starts ticking. The target enters the trade with one amount of magic defense and finishes the trade with far less, which means the later hits matter more than the early ones.\"}]\n8a:[\"$\",\"p\",\"p-12\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Concentrated Energy is the second half. Silvanna has no trouble stacking Recharge because her damage arrives in repeated hits, not one burst packet. That means the item reaches its extra Magic Power and then its short magic-damage boost inside the same committed fight where she already wants to stand on top of someone. The bonus HP matters too, because Silvanna does not need another glass-cannon slot at this timing. She needs enough life to stay in the cage for the full spin.\"}]\n8b:[\"$\",\"p\",\"p-13\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Before this pair, Silvanna threatens but still needs help finishing. After this pair, she starts killing cleanly off one caught carry or deleting half of an objective fight by removing the enemy jungler on entry. That is the window where you stop asking whether you can force and start asking which target is worth the spell cycle.\"}]\n8c:[\"$\",\"$La5\",null,{\"slot\":\"7246933188\",\"variant\":\"in-article\",\"className\":\"my-8\"}]\n8d:[[\"$\",\"h2\",\"h2-0\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Teamfight positioning and target priority\"]}],\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The common bad reflex is ulting the first body that crosses vision. Silvanna is not paid by crowd control duration. She is paid by clean kills on the right target.\"}],\"\\n\",[\"$\",\"ol\",\"ol-0\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Wait for one peel button to disappear.\"}],\" If Valir still has knockback, Akai still has Heavy Spin, or Franco is still holding hook plus suppress, your engage is not ready yet. Let your tank or mage pull one answer first, then dive.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Place Imperial Justice on the exit path, not the center of the model.\"}],\" Cast slightly behind a retreating target so the closest trapped hero is the one trying to leave, not the frontliner stepping in front.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Spin through one target, then reset your feet.\"}],\" Once the pick is secured, do not stand in place autoing whoever is nearby just because the circle is still up. Reposition with the second cast of Cometic Lance if it is available, or step out and look for the next angle.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The support-dependent edge case matters. If Angela, Mathilda, or Floryn is already connected to your dive, you can jump deeper and trust the sustain to finish the commit. Without that support layer, only dive targets your mid laner can reach immediately. Silvanna looks brave when she enters alone. She also dies alone.\"}],\"\\n\",[\"$\",\"h2\",\"h2-1\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Itemization: defaults vs flex slots\"]}],\"\\n\",[\"$\",\"p\",\"p-2\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Default boots are Tough Boots. Default damage spine is Genius Wand plus Concentrated Energy. After that, the build should answer the lobby, not a screenshot from an old guide.\"}],\"\\n\",[\"$\",\"p\",\"p-3\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Boot choice is the first conversation. Stay on Tough Boots as the ranked default, because the control-duration reduction is what keeps Silvanna attached to a target that keeps trying to shake the cage. Swap to Arcane Boots when the enemy EXP lane is light on early crowd control and the first cage needs extra Magic Penetration to finish the trapped target. Swap to Warrior Boots when the EXP matchup is basic-attack heavy and you need to survive lane long enough to reach your first spike.\"}],\"\\n\",\"$La6\",\"\\n\",\"$La7\",\"\\n\",\"$La8\",\"\\n\",\"$La9\",\"\\n\",\"$Laa\",\"\\n\",\"$Lab\",\"\\n\",\"$Lac\",\"\\n\",\"$Lad\",\"\\n\",\"$Lae\",\"\\n\",\"$Laf\",\"\\n\",\"$Lb0\",\"\\n\",\"$Lb1\",\"\\n\",\"$Lb2\",\"\\n\",\"$Lb3\"]\n8e:[\"$\",\"$Lb4\",null,{\"heroName\":\"Silvanna\"}]\n"])</script><script>self.__next_f.push([1,"8f:[\"$\",\"div\",null,{\"className\":\"relative bg-surface-4 border border-mlbb-gold/20 overflow-hidden card-hover hover:border-mlbb-gold/50\",\"style\":{\"boxShadow\":\"0 2px 8px rgba(0,0,0,0.3)\"},\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 p-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative w-14 h-14 rounded-full overflow-hidden flex-shrink-0 bg-surface-3\",\"children\":[\"$\",\"$L6b\",null,{\"src\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100