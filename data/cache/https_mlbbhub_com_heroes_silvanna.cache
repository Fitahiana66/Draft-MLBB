type\":\"HowToSupply\",\"name\":\"Holy Crystal\"},{\"@type\":\"HowToSupply\",\"name\":\"Immortality\"}],\"tool\":[{\"@type\":\"HowToTool\",\"name\":\"Mage Emblem\"},{\"@type\":\"HowToTool\",\"name\":\"Retribution Battle Spell\"}],\"step\":[{\"@type\":\"HowToStep\",\"position\":1,\"name\":\"Buy Arcane Boots\",\"text\":\"Purchase Arcane Boots (690 gold) as item 1 in the Jungle Tempo Cage build for Silvanna.\",\"url\":\"https://mlbbhub.com/heroes/silvanna#build-jungle-tempo-cage\"},{\"@type\":\"HowToStep\",\"position\":2,\"name\":\"Buy Genius Wand\",\"text\":\"Purchase Genius Wand (2,000 gold) as item 2 in the Jungle Tempo Cage build for Silvanna.\",\"url\":\"https://mlbbhub.com/heroes/silvanna#build-jungle-tempo-cage\"},{\"@type\":\"HowToStep\",\"position\":3,\"name\":\"Buy Concentrated Energy\",\"text\":\"Purchase Concentrated Energy (2,020 gold) as item 3 in the Jungle Tempo Cage build for Silvanna.\",\"url\":\"https://mlbbhub.com/heroes/silvanna#build-jungle-tempo-cage\"},{\"@type\":\"HowToStep\",\"position\":4,\"name\":\"Buy Glowing Wand\",\"text\":\"Purchase Glowing Wand (2,050 gold) as item 4 in the Jungle Tempo Cage build for Silvanna.\",\"url\":\"https://mlbbhub.com/heroes/silvanna#build-jungle-tempo-cage\"},{\"@type\":\"HowToStep\",\"position\":5,\"name\":\"Buy Holy Crystal\",\"text\":\"Purchase Holy Crystal (3,000 gold) as item 5 in the Jungle Tempo Cage build for Silvanna.\",\"url\":\"https://mlbbhub.com/heroes/silvanna#build-jungle-tempo-cage\"},{\"@type\":\"HowToStep\",\"position\":6,\"name\":\"Buy Immortality\",\"text\":\"Purchase Immortality (2,120 gold) as item 6 in the Jungle Tempo Cage build for Silvanna.\",\"url\":\"https://mlbbhub.com/heroes/silvanna#build-jungle-tempo-cage\"}],\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://mlbbhub.com/heroes/silvanna\"},\"datePublished\":\"2026-04-20T00:00:00.000Z\",\"dateModified\":\"2026-08-02T00:00:00.000Z\",\"author\":{\"@type\":\"Organization\",\"name\":\"MLBBHub\",\"url\":\"https://mlbbhub.com\"}}5f:[\"$\",\"script\",\"2\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$64\"}}]\n60:[\"$\",\"$L65\",null,{\"hero\":{\"id\":90,\"name\":\"Silvanna\",\"slug\":\"silvanna\",\"title\":\"Imperial Knightess\",\"role\":[\"Fighter\"],\"specialty\":[\"Initiator\",\"Magic Damage\"],\"lane\":[\"EXP\"],\"tier\":\"B\",\"difficulty\":1,\"releaseYear\":2019,\"stats\":{\"durability\":50,\"offense\":40,\"controlEffect\":70,\"difficulty\":30},\"winRate\":51.07,\"pickRate\":0.98,\"banRate\":1.67,\"counters\":{\"strongAgainst\":[{\"heroSlug\":\"layla\",\"heroName\":\"Layla\",\"advantage\":\"strong\",\"tip\":\"Silvanna has a long attack range and powerful crowd control abilities,which makes her stronger against back-row Mages and Marksmen,such as Layla and Valir.\"},{\"heroSlug\":\"valir\",\"heroName\":\"Valir\",\"advantage\":\"strong\",\"tip\":\"Silvanna has a long attack range and powerful crowd control abilities,which makes her stronger against back-row Mages and Marksmen,such as Layla and Valir.\"}],\"weakAgainst\":[{\"heroSlug\":\"martis\",\"heroName\":\"Martis\",\"advantage\":\"weak\",\"tip\":\"But she can be weak against Fighters with multiple CCs\\nlike Martis because they can easily interrupt her 2nd Skill.\"}]},\"splashArt\":\"https://akmweb.youngjoygame.com/web/svnres/file/mlbb/homepage/100_a9de8642b6e62f44652c519f153620d2.jpg\",\"portrait\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_5e7b297af7c6e32a420b897aa4998071.png\",\"officialMatchups\":[{\"kind\":\"best_ally\",\"heroId\":\"6\",\"heroName\":\"Tigreal\",\"heroSlug\":\"tigreal\",\"icon\":\"https://akmwebstatic.yuanzhanapp.com/web/madmin/image_23a7a603ff9d20074777d52e2eb202f3.jpg\",\"tip\":\"Tigreal, Ruby, Gatotkaca\"},{\"kind\":\"counters\",\"heroId\":\"31\",\"heroName\":\"Moskov\",\"heroSlug\":\"moskov\",\"icon\":\"https://akmweb.youngjoygame.com/web/madmin/image/2f37c7bb49843330b8b972f11b60da08.png?w=150-150-3f498a\",\"tip\":\"Moskov, Claude, Kimmy\"},{\"kind\":\"countered_by\",\"heroId\":\"57\",\"heroName\":\"Valir\",\"heroSlug\":\"valir\",\"icon\":\"https://akmwebstatic.yuanzhanapp.com/web/madmin/image_11c3284b5ea83dfd377f4d1b9724c960.jpg\",\"tip\":\"Eudora, Gusion, Valir\"}],\"skills\":{\"skills\":[{\"name\":\"Knightess' Resolve\",\"type\":\"Passive\",\"description\":\"Silvanna's Basic Attacks deal 25 (+45% Total Physical Attack) (+75% Total Magic Power) Magic Damage.\\nSilvanna's attacks apply a mark on enemy heroes for 5s on hit, each mark reducing their Hybrid Defense by 3-6 (up to 5 stacks).\\nSilvanna's skills and Basic Attacks deal 30% extra damage to enemy heroes with the max number of marks.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Silvanna's Basic Attacks deal 25\"},{\"type\":\"text\",\"text\":\" (+45% Total Physical Attack)\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"(+75% Total Magic Power)\",\"color\":\"#62f8fe\"},{\"type\":\"text\",\"text\":\" Magic Damage.\\nSilvanna's attacks apply a mark on enemy heroes for 5s on hit, each mark reducing their Hybrid Defense by 3-6 (up to 5 stacks).\\nSilvanna's skills and Basic Attacks deal 30% extra damage to enemy heroes with the max number of marks.\"}],\"cooldown\":null,\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_8a659e353c870bc077564afaaf4d8c2c.png\",\"tags\":[\"Buff\",\"Debuff\"]},{\"name\":\"Cometic Lance\",\"type\":\"Skill 1\",\"description\":\"Silvanna dashes forward. Upon reaching the max range or hitting a non-Minion enemy, she swings her lance, dealing 250 (+100% Total Magic Power) Magic Damage to nearby enemies and stunning them for 1s.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Silvanna dashes forward. Upon reaching the max range or hitting a non-Minion enemy, she swings her lance, dealing 250\"},{\"type\":\"text\",\"text\":\" (+100% Total Magic Power)\",\"color\":\"#62f8fe\"},{\"type\":\"text\",\"text\":\" Magic Damage to nearby enemies and stunning them for 1s.\"}],\"cooldown\":\"11s\",\"manaCost\":\"70\",\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_dbeca4aa319bdc1e24af7f53f6e6f8b9.png\",\"tags\":[\"Mobility\",\"CC\"]},{\"name\":\"Spiral Strangling\",\"type\":\"Skill 2\",\"description\":\"Silvanna thrusts her lance in the target direction and spins it 6 times while gaining a 350 (+150% Total Magic Power) shield. Each spin deals 165 (+45% Total Magic Power) Magic Damage and slightly pulls targets toward the center. Silvanna spins 1 additional time for every 50% of extra Attack Speed she possesses.\\n\\nThe skill deals only 50% damage against Minions.\\n\\nSpiral Strangling counts as a Basic Attack but cannot Crit.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Silvanna thrusts her lance in the target direction and spins it 6 times while gaining a 350\"},{\"type\":\"text\",\"text\":\" (+150% Total Magic Power)\",\"color\":\"#62f8fe\"},{\"type\":\"text\",\"text\":\" shield. Each spin deals 165\"},{\"type\":\"text\",\"text\":\" (+45% Total Magic Power)\",\"color\":\"#62f8fe\"},{\"type\":\"text\",\"text\":\" Magic Damage and slightly pulls targets toward the center. Silvanna spins 1 additional time for every 50% of extra Attack Speed she possesses.\\n\\nThe skill deals only 50% damage against Minions.\\n\\n\"},{\"type\":\"text\",\"text\":\"Spiral Strangling\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" counts as a Basic Attack but cannot Crit.\"}],\"cooldown\":\"5s\",\"manaCost\":\"35\",\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_e72b0d82cfd40062ad9bb1485232b91f.png\",\"tags\":[\"AOE\",\"Shield\"]},{\"name\":\"Imperial Justice\",\"type\":\"Ultimate\",\"description\":\"Silvanna leaps to the target location and creates a Circle of Light upon landing, dealing 350 (+110% Total Magic Power) Magic Damage to enemies in the area, slowing them by 40% for 1.5s, and restraining the closest enemy hero to the area for 3.5s. (This skill cannot be interrupted.)\\n\\nSilvanna gains 100% Attack Speed and 40% Lifesteal when in the Circle.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Silvanna leaps to the target location and creates a Circle of Light upon landing, dealing 350\"},{\"type\":\"text\",\"text\":\" (+110% Total Magic Power)\",\"color\":\"#62f8fe\"},{\"type\":\"text\",\"text\":\" Magic Damage to enemies in the area, slowing them by 40% for 1.5s, and restraining the closest enemy hero to the area for 3.5s. (This skill cannot be interrupted.)\\n\\nSilvanna gains 100% Attack Speed and 40% Lifesteal when in the Circle.\"}],\"cooldown\":\"52s\",\"manaCost\":\"130\",\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_ef133226f4bc7ef8b815463980daa1a6.png\",\"tags\":[\"CC\",\"AOE\"]}],\"skillUpgradePriority\":\"3-2-1\",\"skillPriorityTip\":\"Mage Emblem Talent is recommended. (Flow - Catastrophe - Magic Worship)\\nThis set of Emblem could greatly increase the damage Silvanna deals. Therefore, in Early and Mid Game, she could slay enemies with this combination of skills and gain the upper hand.\",\"skillPriorityTipRich\":[{\"type\":\"text\",\"text\":\"Mage Emblem Talent is recommended. (Flow - Catastrophe - Magic Worship)\"},{\"type\":\"lineBreak\"},{\"type\":\"text\",\"text\":\"This set of Emblem could greatly increase the damage Silvanna deals. Therefore, in Early and Mid Game, she could slay enemies with this combination of skills and gain the upper hand.\"}]},\"synergies\":[{\"heroSlug\":\"atlas\",\"heroName\":\"Atlas\",\"synergyScore\":8,\"reason\":\"Pairing Silvanna with Tanks gives her sufficient space to dish out damage.\\nFor example, Atlas and Tigreal.\"},{\"heroSlug\":\"tigreal\",\"heroName\":\"Tigreal\",\"synergyScore\":8,\"reason\":\"Pairing Silvanna with Tanks gives her sufficient space to dish out damage.\\nFor example, Atlas and Tigreal.\"}],\"combos\":[{\"type\":\"teamfight\",\"title\":\"TEAMFIGHT COMBOS\",\"description\":\"In teamfights,\\r\\nSilvanna can control back-row enemies with her [ULTIMATE]\\r\\nand then stun them with her [1st Skill].\\r\\nFinally, she can deal damage with her [2nd Skill] and Basic Attacks.\",\"skillSequence\":[{\"skillId\":9030,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_ef133226f4bc7ef8b815463980daa1a6.png\"},{\"skillId\":9010,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_dbeca4aa319bdc1e24af7f53f6e6f8b9.png\"},{\"skillId\":9020,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_e72b0d82cfd40062ad9bb1485232b91f.png\"},{\"skillId\":9000,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_f98d2e98eaebfb31c6c5101cf1c3201a.png\"}]},{\"type\":\"laning\",\"title\":\"LANING COMBOS\",\"description\":\"Silvanna can poke enemies with her [2nd Skill]\\r\\nand use her 1st Skill to close the distance once they're low on HP.\\r\\nThen, she can control them and finish them off with her [ULTIMATE].\",\"skillSequence\":[{\"skillId\":9020,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_e72b0d82cfd40062ad9bb1485232b91f.png\"},{\"skillId\":9010,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_dbeca4aa319bdc1e24af7f53f6e6f8b9.png\"},{\"skillId\":9010,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_dbeca4aa319bdc1e24af7f53f6e6f8b9.png\"},{\"skillId\":9030,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_ef133226f4bc7ef8b815463980daa1a6.png\"},{\"skillId\":9000,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_f98d2e98eaebfb31c6c5101cf1c3201a.png\"}]}],\"metaDescription\":\"Silvanna build, counter, and emblem guide for Mobile Legends. Learn her Genius Wand spike, EXP lane plan, target priority, and when not to draft her cleanly.\",\"builds\":[],\"overviewLede\":\"Silvanna is a pick tool disguised as an EXP fighter. She wins when the draft gives her one high-value body to isolate and a second teammate close enough to punish the cage. She feels awful when you ask her to blind-frontline into peel, cleanse, or repeated displacement.\"},\"serverLocale\":\"en\",\"curatedBuilds\":{\"source\":\"curated\",\"hero\":\"silvanna\",\"patch\":\"2.1.67\",\"lastReviewed\":\"2026-08-02\",\"stalePatch\":true,\"currentPatch\":\"2.2.16a\",\"builds\":[{\"slot\":1,\"id\":\"exp-pickoff-bruiser\",\"name\":\"EXP Pickoff Bruiser\",\"roleContext\":\"EXP\",\"items\":[{\"slug\":\"tough-boots\",\"name\":\"Tough Boots\",\"cost\":700,\"fixed\":false},{\"slug\":\"genius-wand\",\"name\":\"Genius Wand\",\"cost\":2000,\"fixed\":false},{\"slug\":\"concentrated-energy\",\"name\":\"Concentrated Energy\",\"cost\":2020,\"fixed\":false},{\"slug\":\"glowing-wand\",\"name\":\"Glowing Wand\",\"cost\":2050,\"fixed\":false},{\"slug\":\"antique-cuirass\",\"name\":\"Antique Cuirass\",\"cost\":2170,\"fixed\":false},{\"slug\":\"immortality\",\"name\":\"Immortality\",\"cost\":2120,\"fixed\":false}],\"coreItems\":[{\"slug\":\"genius-wand\",\"name\":\"Genius Wand\"},{\"slug\":\"concentrated-energy\",\"name\":\"Concentrated Energy\"},{\"slug\":\"glowing-wand\",\"name\":\"Glowing Wand\"}],\"emblem\":{\"slug\":\"mage\",\"name\":\"Mage Emblem\",\"talents\":[{\"slug\":\"rupture\",\"name\":\"Rupture\",\"iconUrl\":\"/images/talents/rupture.png\",\"bucket\":\"standard\"},{\"slug\":\"bargain-hunter\",\"name\":\"Bargain Hunter\",\"iconUrl\":\"/images/talents/bargain-hunter.png\",\"bucket\":\"standard\"},{\"slug\":\"lethal-ignition\",\"name\":\"Lethal Ignition\",\"iconUrl\":\"/images/talents/lethal-ignition.png\",\"bucket\":\"core\"}]},\"spell\":{\"slug\":\"flicker\",\"name\":\"Flicker\"},\"blessing\":null,\"flexItems\":[{\"item\":{\"slug\":\"arcane-boots\",\"name\":\"Arcane Boots\"},\"replace\":{\"slug\":\"tough-boots\",\"name\":\"Tough Boots\"},\"trigger\":\"Use when the enemy EXP lane lacks early crowd control and the first cage needs more Magic Penetration than tenacity.\"},{\"item\":{\"slug\":\"athenas-shield\",\"name\":\"Athena's Shield\"},\"replace\":{\"slug\":\"antique-cuirass\",\"name\":\"Antique Cuirass\"},\"trigger\":\"Use against front-loaded magic burst that can remove Silvanna before Spiral Strangling finishes, when the counterturn is magic rather than physical.\"},{\"item\":{\"slug\":\"divine-glaive\",\"name\":\"Divine Glaive\"},\"replace\":{\"slug\":\"immortality\",\"name\":\"Immortality\"},\"trigger\":\"Use when the enemy front line stacks Magic Defense and your team still needs Silvanna to finish trapped targets.\"},{\"item\":{\"slug\":\"winter-crown\",\"name\":\"Winter Crown\"},\"replace\":{\"slug\":\"immortality\",\"name\":\"Immortality\"},\"trigger\":\"Use when the enemy saves counterburst for after your ultimate lands and stasis can protect the full spin.\"}],\"notes\":\"Default EXP lane setup for ranked games where Silvanna needs one reliable catch, repeated Magic Defense shred, anti-sustain burn, and enough durability to survive the counterturn.\",\"totalCost\":11060,\"statLines\":[{\"key\":\"magicpower\",\"labelKey\":\"common.stats.magicPower\",\"unit\":\"flat\",\"group\":\"offensive\",\"value\":210,\"sources\":[\"Genius Wand\",\"Concentrated Energy\",\"Glowing Wand\"]},{\"key\":\"magicpenFlat\",\"labelKey\":\"common.stats.magicPenetration\",\"unit\":\"flat\",\"group\":\"offensive\",\"value\":10,\"sources\":[\"Genius Wand\"]},{\"key\":\"hybridsteal\",\"labelKey\":\"common.stats.hybridLifesteal\",\"unit\":\"percent\",\"group\":\"offensive\",\"value\":20,\"sources\":[\"Concentrated Energy\"]},{\"key\":\"hp\",\"labelKey\":\"common.stats.hp\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":2420,\"sources\":[\"Concentrated Energy\",\"Glowing Wand\",\"Antique Cuirass\",\"Immortality\"]},{\"key\":