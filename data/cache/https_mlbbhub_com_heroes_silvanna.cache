splashUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/silvanna/Silvanna-Meowkin-Warden-20250601063943.webp\",\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Silvanna/Cosmetics\"},{\"name\":\"Classroom Glam\",\"tier\":\"Exceptional\",\"rawTier\":\"Exceptional\",\"tag\":\"Special\",\"tagSlug\":\"special\",\"price\":\"Limited-time Event\",\"portraitFile\":null,\"portraitUrl\":null,\"splashUrl\":null,\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Silvanna/Cosmetics\"}],\"lore\":{\"backstory\":\"Silvanna is the Imperial Knightess, the eldest princess of the Moniyan Empire and commander of its holy vanguard. Unlike her peers who rule from gilded thrones, Silvanna charges into battle wielding a sacred lance imbued with the light of the ancient Moniyan kings. She chose the battlefield over the palace after witnessing the Abyss corrupt her younger brother Dyrroth, swearing an oath to purge the darkness and bring him home. Her Imperial Justice traps enemies in a radiant circle of light, and her unwavering resolve has made her the shining beacon of Moniyan's resistance against the encroaching Abyss.\",\"allies\":[{\"heroSlug\":\"tigreal\",\"heroName\":\"Tigreal\",\"relationship\":\"Captain of the Royal Guard and her most trusted knight\"},{\"heroSlug\":\"gatotkaca\",\"heroName\":\"Gatotkaca\",\"relationship\":\"Iron warrior who fights alongside Moniyan's defenders\"}],\"rivals\":[{\"heroSlug\":\"thamuz\",\"heroName\":\"Thamuz\",\"relationship\":\"Demon lord whose lava armies threaten her empire\"},{\"heroSlug\":\"dyrroth\",\"heroName\":\"Dyrroth\",\"relationship\":\"Her corrupted younger brother lost to the Abyss\"}]},\"loreUrlName\":\"$undefined\",\"statsHistory\":[{\"date\":\"2026-09-07\",\"winRate\":51.5,\"pickRate\":1.12,\"banRate\":2.43},{\"date\":\"2026-09-10\",\"winRate\":51.5,\"pickRate\":1.1,\"banRate\":2.42},{\"date\":\"2026-09-16\",\"winRate\":51.65,\"pickRate\":1.07,\"banRate\":2.38},{\"date\":\"2026-09-28\",\"winRate\":50.21,\"pickRate\":0.98,\"