"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#B07ECC\",\"background\":\"#B07ECC1a\",\"border\":\"1px solid #B07ECC40\"},\"children\":\"Epic\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Joy\",\"rank\":\"Epic\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=epic\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Epic\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Epic\",\"name\":\"Joy\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"46.46\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Joy\",\"delta\":\"-2.70%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.05\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.20\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Epic\"}}]]}]]}],[\"$\",\"article\",\"legend\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #4dc9f6, #4dc9f633)\",\"boxShadow\":\"0 0 12px -2px #4dc9f680\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#4dc9f6\",\"background\":\"#4dc9f61a\",\"border\":\"1px solid #4dc9f640\"},\"children\":\"Legend\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Joy\",\"rank\":\"Legend\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=legend\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Legend\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Legend\",\"name\":\"Joy\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"46.92\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Joy\",\"delta\":\"-2.24%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.08\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.21\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Legend\"}}]]}]]}],[\"$\",\"article\",\"mythic\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #f59e0b, #f59e0b33)\",\"boxShadow\":\"0 0 12px -2px #f59e0b80\"}}],\"$La3\",\"$La4\"]}],\"$La5\",\"$La6\"]}]\n7e:[\"$\",\"h2\",\"h2-1\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The one thing that makes Joy work\"]}]\n7f:[\"$\",\"p\",\"p-4\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Joy is a metronome with claws. Her entire kit is built around the tight recast window on Meow, Rhythm of Joy!, and every other ability exists to feed that window or cash it in.\"}]\n80:[\"$\",\"p\",\"p-5\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Her S1 (Look, Leonin Crystal!) is not a damage spell. It is a beat target: a stationary object she can dash to in order to keep the rhythm alive when no enemy is in range. Her S2 dashes in a direction, and a hit (on an enemy or the Crystal) reopens that recast window and banks 1 Beat Energy. Land four dashes in succession and the fourth one doubles its damage and grants a shield. Land enough Beat Energy and the ultimate (Ha, Electrifying Beats!) stops being a damage spell and becomes a status reset: cast it with 3 Beat Energy and Joy cleanses every debuff on her, then becomes immune to slows for the entire pulse window.\"}]\n81:[\"$\",\"p\",\"p-6\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"This is why she does not have mana. Mana would gate the rhythm. Cooldowns gate the rhythm instead, and the rhythm itself is the resource. Hitting her S2 on time is not \\\"good play\\\"; it is the only play.\"}]\n82:[\"$\",\"p\",\"p-7\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The reflex Joy players have to unlearn is treating her like a burst assassin who blows everything in 2 seconds. She is not. She is a sustained engagement: drop, dash, dash, dash, dash, ultimate, continue dashing on-beat through the whole pulse window. Players who try to one-shot a marksman and leave will hit twice and run out of damage. Players who commit to the full rhythm cycle, including the in-ult dashes, will land all eight pulses at full amplification and walk out with the spell vamp that perfect rhythm grants.\"}]\n83:[\"$\",\"h2\",\"h2-2\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Laning: the first 4 minutes\"]}]\n84:[\"$\",\"p\",\"p-8\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Joy is jungle-only in any serious draft. She does not lane.\"}]\n85:[\"$\",\"ol\",\"ol-0\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Take blue buff first, no exceptions.\"}],\" She has zero mana, so the buff's mana refund is wasted, but the cooldown reduction lets her dash cycle reset faster. Clear blue with S1 → S2 → basic, then walk to your roam-side small camps.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Hit level 4 before showing your face.\"}],\" Joy at level 3 has S1 and S2 but no ultimate. Joy at level 4 has all three skills and the full Beat Energy loop. The one-level gap turns a failed gank into a 1-versus-1 you actually win, so do not invade or counter-gank the enemy jungle until you have ult.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"First gank goes mid, not side.\"}],\" Mid lane has the shortest distance from your blue buff to a squishy target, and most mids in the current pool (Pharsa, Kagura, Valentina) have one escape and zero burst tools to threaten you mid-combo. Drop S1 in their retreat path, dash through them once to slow, then chain three more dashes on rhythm. If they Flickered the first dash, the slow from the Crystal still makes the second dash land.\"]}],\"\\n\"]}]\n86:[\"$\",\"div\",\"blockquote-0\",{\"className\":\"my-5 p-4 flex gap-3\",\"style\":{\"background\":\"rgba(200,170,110,0.08)\",\"border\":\"1px solid rgba(200,170,110,0.35)\"},\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-lightbulb w-4 h-4 flex-shrink-0 mt-0.5\",\"aria-hidden\":\"true\",\"style\":{\"color\":\"#C8AA6E\"},\"children\":[[\"$\",\"path\",\"1gvzjb\",{\"d\":\"M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5\"}],[\"$\",\"path\",\"x1upvd\",{\"d\":\"M9 18h6\"}],[\"$\",\"path\",\"ceow96\",{\"d\":\"M10 22h4\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[11px] font-heading font-bold uppercase tracking-wider mb-1\",\"style\":{\"color\":\"#C8AA6E\"},\"children\":\"Tip\"}],[[\"$\",\"p\",\"0\",{\"className\":\"text-sm text-[#9BA0B4] leading-relaxed\",\"children\":[\"The Crystal counts as a \\\"beat target\\\" for S2 recasts. If the enemy moves out of range mid-combo, dash to the Crystal instead of to them. You keep the chain alive and reposition for free.\"]}]]]}]]}]\n87:[\"$\",\"h2\",\"h2-3\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The power spike you are farming toward\"]}]\n88:[\"$\",\"p\",\"p-9\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Arcane Boots plus Genius Wand. That is the spike. Around the 7-to-9 minute mark, depending on how clean your jungle pathing is, Joy gets the magic penetration she needs to make her per-pulse damage actually hurt squishies.\"}]\n89:[\"$\",\"p\",\"p-10\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Genius Wand is non-negotiable as her first item. The passive shreds 3 + (0.3 * hero level) magic defense per skill hit, stacking 3 times. Joy lands hits with every dash, so a single dash chain walks the target up to full stacks, which means every subsequent pulse, basic attack, and ult tick lands against a target with effectively negative magic defense for low-level squishies. Without Genius Wand, your dashes tickle. With it, they delete.\"}]\n8a:[\"$\",\"p\",\"p-11\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Concentrated Energy is the second item, finished by the 11-to-12 minute mark. It does two things: the stacking magic power passive caps at 12% bonus magic damage after six skill hits, which she reaches mid-combo on a single target, and the 400 HP turns her soft base line into one that survives a stray poke from a fed mage. Before this item lands, you cannot dive a fed mage. After it lands, you can.\"}]\n8b:[\"$\",\"p\",\"p-12\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Once those two are online, Joy stops being a hero who farms and becomes a hero who hunts. Pick a side lane, walk to the bush behind their tower, drop Crystal, full combo, leave with Spell Vamp from the ult cycle.\"}]\n8c:[\"$\",\"h2\",\"h2-4\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Teamfight positioning and target priority\"]}]\n8d:[\"$\",\"p\",\"p-13\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The reflex when you see a teamfight starting is to dash into the middle and start the rhythm. That reflex loses games. Joy's combo locks her in place for the entire rhythm cycle; if you start it mid-fight, every CC ability the enemy has is pointed at the moving target, which is you.\"}]\n8e:[\"$\",\"ol\",\"ol-1\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Wait until the first hard CC has been spent.\"}],\" Joy has no CC of her own, so your job is not initiation, it is execution. Let the tank engage, count the Khufra ball or the Atlas pull, then start your dash chain on the squishy who is now committed to staying in the fight.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Open from a flank, not from a head-on dash.\"}],\" Joy's S2 has a fixed direction, and four dashes in the same direction puts you in the enemy backline whether you want to be there or not. If you open head-on, the second dash pushes you past the marksman and into the enemy tank's CC range. Coming in from the side keeps the marksman in your dash path for the full chain.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Cast ultimate with exactly 3 Beat Energy, not 1 or 2.\"}],\" With 1 or 2 Beat Energy, the ultimate is just damage. With 3, it cleanses every debuff on you and grants slow immunity for the full pulse window. Inside that window, you can dash through Selena root, Aurora freeze, Khufra ball, anything that does not suppress. Saving the ult for the 3rd Beat Energy is the difference between dying to one CC chain and running the entire combo through it.\"]}],\"\\n\"]}]\n8f:[\"$\",\"p\",\"p-14\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"If your support is Estes or Mathilda, you can open earlier and from sloppier angles because the heal or the link will save the missed beat. If your support is Diggie or Floryn, you have no save tools and must time the engage perfectly, because their kits do not pull you out.\"}]\n90:[\"$\",\"$La7\",null,{\"slot\":\"7246933188\",\"variant\":\"in-article\",\"className\":\"my-8\"}]\n91:[[\"$\",\"h2\",\"h2-0\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Itemization: 3 locked slots plus 3 real conversations\"]}],\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Joy locks Arcane Boots, Genius Wand, and Concentrated Energy. Everything after that is a draft-dependent decision.\"}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[\"The fourth slot is the first real choice. \",[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Glowing Wand\"}],\" is the default: the burn passive deals 1.5% of the target's max HP per second for 3 seconds, which scales against the tanks who otherwise eat your magic damage, and the Lifebane passive cuts shield and HP regen by 50%, which is an enormous answer to Estes, Floryn, and Mathilda comps. \",[\"$\",\"strong\",\"strong-1\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Holy Crystal\"}],\" replaces Glowing Wand if the enemy has zero healing and zero high-HP tanks: the 21-35% bonus magic power scales harder against squishy comps where you do not need percent-HP damage.\"]}],\"\\n\",[\"$\",\"p\",\"p-2\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[\"The fifth slot is the anti-tank conversation. \",[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Divine Glaive\"}],\" is the answer when the enemy stacks two or more magic resistance items: the Spellbreaker passive scales 0.1% extra magic penetration per point of enemy magic defense up to 20%, which means it is wasted against squishies but mandatory against any tank who built Athena's Shield. If the enemy has no anti-magic items, skip Divine Glaive entirely and take Starlium Scythe instead, which converts your basic attack between dashes into 100 (+100% Total Magic Power) true damage, plus 10% CDR for faster cycle resets.\"]}],\"\\n\",[\"$\",\"p\",\"p-3\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[\"The sixth slot is whatever the late game needs. \",[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Ice Queen Wand\"}],\" layers a 30% slow over your dash chain, which makes you uncatchable in a chase but adds nothing to a 2-second teamfight. \",[\"$\",\"strong\",\"strong-1\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Clock of Destiny\"}],\" is the survival pick: stacking hybrid defense and the 50%-HP recovery proc let you live a second cycle in extended brawls. Both are correct in the right game.\"]}],\"\\n\",[\"$\",\"div\",\"blockquote-0\",{\"className\":\"my-5 p-4 flex gap-3\",\"style\":{\"background\":\"rgba(0,170,255,0.08)\",\"border\":\"1px solid rgba(0,170,255,0.35)\"},\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-info w-4 h-4 flex-shrink-0 mt-0.5\",\"aria-hidden\":\"true\",\"style\":{\"color\":\"#00AAFF\"},\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"1dtifu\",{\"d\":\"M12 16v-4\"}],[\"$\",\"path\",\"e9boi3\",{\"d\":\"M12 8h.01\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[11px] font-heading font-bold uppercase tracking-wider mb-1\",\"style\":{\"color\":\"#00AAFF\"},\"children\":\"Note\"}],[[\"$\",\"p\",\"0\",{\"className\":\"text-sm text-[#9BA0B4] leading-relaxed\",\"children\":[\"Joy does not need crit, attack speed, or pure physical items. Her basic attack converts to magic damage scaling on her passive (65% Total Magic Power), so every gold goes into magic power, magic penetration, or sustain.\"]}]]]}]]}],\"\\n\",\"$La8\",\"\\n\",\"$La9\",\"\\n\",\"$Laa\",\"\\n\",\"$Lab\",\"\\n\",\"$Lac\",\"\\n\",\"$Lad\",\"\\n\",\"$Lae\",\"\\n\",\"$Laf\",\"\\n\",\"$Lb0\",\"\\n\",\"$Lb1\",\"\\n\",\"$Lb2\",\"\\n\",\"$Lb3\",\"\\n\",\"$Lb4\"]\n92:[\"$\",\"$Lb5\",null,{\"heroName\":\"Joy\"}]\n"])</script><script>self.__next_f.push([1,"93:[\"$\",\"div\",null,{\"className\":\"relative bg-surface-4 border border-mlbb