orman Kingdom. Years of study and practice have given Eudora absolute mastery over electrical energy, allowing her to summon devastating bolts from clear skies. Her temper is as volatile as her magic, and those who cross her often find themselves on the receiving end of Thunder's Wrath. Eudora now serves as the guardian of her kingdom's eastern border.\",\"allies\":[{\"heroSlug\":\"aurora\",\"heroName\":\"Aurora\",\"relationship\":\"Fellow elemental mage and occasional rival\"},{\"heroSlug\":\"vale\",\"heroName\":\"Vale\",\"relationship\":\"Wind mage whose storms amplify her lightning\"}],\"rivals\":[{\"heroSlug\":\"gord\",\"heroName\":\"Gord\",\"relationship\":\"Rival mage who claims his mysticism surpasses her lightning\"},{\"heroSlug\":\"esmeralda\",\"heroName\":\"Esmeralda\",\"relationship\":\"Astrologer whose shields absorb her thunder\"}]},\"loreUrlName\":\"Eudora\",\"statsHistory\":[{\"date\":\"2026-09-07\",\"winRate\":52.47,\"pickRate\":1.91,\"banRate\":59.46},{\"date\":\"2026-09-10\",\"winRate\":52.51,\"pickRate\":1.89,\"banRate\":60.12},{\"date\":\"2026-09-16\",\"winRate\":52.52,\"pickRate\":1.86,\"banRate\":62.74},{\"date\":\"2026-09-28\",\"winRate\":51.28,\"pickRate\":2,\"banRate\":59.09},{\"date\":\"2026-10-02\",\"winRate\":51.25,\"pickRate\":1.95,\"banRate\":59.7},{\"date\":\"2026-10-09\",\"winRate\":51.3,\"pickRate\":1.97,\"banRate\":58.9},{\"date\":\"2026-10-17\",\"winRate\":51.22,\"pickRate\":1.94,\"banRate\":58.8}]},\"relatedHeroesSlot\":\"$L66\",\"statsSeoSlot\":\"$L67\",\"fieldManualSlot\":\"$L68\"}]\n61:[\"$\",\"$L69\",null,{\"heroName\":\"Eudora\",\"heroSlug\":\"eudora\",\"roles\":\"$60:props:hero:role\",\"lanes\":\"$60:props:hero:lane\",\"difficulty\":1,\"winRate\":51.22,\"pickRate\":1.94,\"banRate\":58.8,\"curatedBuilds\":\"$60:props:curatedBuilds\",\"topCounters\":\"$60:props:tabData:counterData:countersThisHero\",\"hasCounterPage\":true,\"hasRankStats\":true,\"locale\":\"en\",\"pageUrl\":\"https://mlbbhub.com/heroes/eudora\",\"year\":2026}]