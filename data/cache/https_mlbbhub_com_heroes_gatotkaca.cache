,\"rawTier\":\"Deluxe\",\"tag\":\"Epic\",\"tagSlug\":\"epic\",\"price\":\"899\",\"portraitFile\":\"Hero417-portrait.png\",\"portraitUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/gatotkaca/Hero417-portrait-20240114121812.webp\",\"splashUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/gatotkaca/Gatotkaca-Tide-Preserver-20240123101059.webp\",\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Gatotkaca/Cosmetics\"},{\"name\":\"Nutcracker Monarch\",\"tier\":\"Exceptional\",\"rawTier\":\"Exceptional\",\"tag\":\"Starlight\",\"tagSlug\":\"starlight\",\"price\":\"2024/08 StarLight Member\",\"portraitFile\":\"Hero418-portrait.png\",\"portraitUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/gatotkaca/Hero418-portrait-20240811092808.webp\",\"splashUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/gatotkaca/Gatotkaca-Nutcracker-Monarch-20240724133448.webp\",\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Gatotkaca/Cosmetics\"},{\"name\":\"Steeler\",\"tier\":\"Common\",\"rawTier\":\"Common\",\"tag\":\"Elite\",\"tagSlug\":\"elite\",\"price\":\"188\",\"portraitFile\":\"Hero413-portrait.png\",\"portraitUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/gatotkaca/Hero413-portrait-20220525165156.webp\",\"splashUrl\":null,\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Gatotkaca/Cosmetics\"},{\"name\":\"Nutcracker Earl\",\"tier\":\"Exceptional\",\"rawTier\":\"Exceptional\",\"tag\":\"Starlight\",\"tagSlug\":\"starlight\",\"price\":\"2024/08 StarLight Reward\",\"portraitFile\":null,\"portraitUrl\":null,\"splashUrl\":null,\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Gatotkaca/Cosmetics\"},{\"name\":\"Nutcracker Duke\",\"tier\":\"Exceptional\",\"rawTier\":\"Exceptional\",\"tag\":\"Starlight\",\"tagSlug\":\"starlight\",\"price\":\"Limited-time Event\",\"portraitFile\":null,\"portraitUrl\":null,\"splashUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/gatotkaca/Gatotkaca-Nutcracker-Duke-20250703151008.webp\",\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Gatotkaca/Cosmetics\"}],\"lore\":{\"backstory\":\"Gatotkaca is the Iron Warrior, a legendary hero of the Moniyan Empire whose body was forged from volcanic iron in a mystical ritual performed at his birth. His skin is impervious to conventional weapons, and when he leaps into the sky to deliver his Unbreakable slam, the impact crater can stun entire enemy formations. Gatotkaca's volcanic origin gives him a unique rage mechanic. The more damage he absorbs, the stronger his counterattacks become, his iron body glowing white-hot with stored energy. He serves as the Moniyan Empire's ultimate frontline weapon, a one-man fortress whose mere presence on the battlefield rallies allied troops and sends enemies into retreat.\",\"allies\":[{\"heroSlug\":\"silvanna\",\"heroName\":\"Silvanna\",\"relationship\":\"Moniyan princess and commander he is sworn to protect\"},{\"heroSlug\":\"tigreal\",\"heroName\":\"Tigreal\",\"relationship\":\"Captain of the Royal Guard and brother-in-arms\"}],\"rivals\":[{\"heroSlug\":\"martis\",\"heroName\":\"Martis\",\"relationship\":\"Ashura King whose unstoppable offense challenges his iron defense\"},{\"heroSlug\":\"thamuz\",\"heroName\":\"Thamuz\",\"relationship\":\"Lava demon whose infernal heat tests the limits of his iron body\"}]},\"loreUrlName\":\"$undefined\",\"statsHistory\":[{\"date\":\"2026-09-07\",\"winRate\":45.8,\"pickRate\":0.6,\"banRate\":0.46},{\"date\":\"2026-09-10\",\"winRate\":45.84,\"pickRate\":0.6,\"banRate\":0.45},{\"date\":\"2026-09-16\",\"winRate\":45.91,\"pickRate\":0.61,\"banRate\":0.42},{\"date\":\"2026-09-28\",\"winRate\":43.96,\"pickRate\":0.55,\"banRate\":0.26},{\"date\":\"2026-10-02\",\"winRate\":44.19,\"pickRate\":0.55,\"banRate\":0.26},{\"date\":\"2026-10-09\",\"winRate\":44.77,\"pickRate\":0.54,\"banRate\":0.28},{\"date\":\"2026-10-17\",\"winRate\":45.01,\"pickRate\":0.56,\"banRate\":0.29}]},\"relatedHeroesSlot\":\"$L66\",\"statsSeoSlot\":\"$L67\",\"fieldManualSlot\":\"$L68\"}]\n61:[\"$\",\"$L69\"