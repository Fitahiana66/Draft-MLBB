mlbb-gold-bright">+2900</span></p></div><div class="relative min-w-0 bg-surface-2/85 px-3 py-2 sm:px-4 sm:py-3" title="Thunder Belt, Brute Force Breastplate, Immortality"><p class="truncate font-heading text-[9.5px] font-bold uppercase tracking-[0.2em] text-mlbb-text-secondary/85">Physical Defense</p><p class="mt-1 font-heading text-[18px] font-bold leading-tight tracking-tight text-mlbb-text sm:text-[22px]"><span class="text-mlbb-gold-bright">+50</span></p></div></div></div><div class="relative mt-4 overflow-hidden border border-mlbb-gold/18 bg-gradient-to-br from-surface-3/75 to-surface-2/85 px-4 py-3.5"><div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-mlbb-gold/40 to-transparent" aria-hidden="true"></div><div class="mb-2.5 flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right-left h-3.5 w-3.5 text-text-accent" aria-hidden="true"><path d="m16 3 4 4-4 4"></path><path d="M20 7H4"></path><path d="m8 21-4-4 4-4"></path><path d="M4 17h16"></path></svg><p class="font-heading text-[10.5px] font-bold uppercase tracking-[0.22em] text-text-accent">Situational Swaps</p></div><ul class="space-y-2"><li class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-[12.5px] leading-relaxed text-mlbb-text-secondary"><a class="font-heading font-bold uppercase tracking-wide text-mlbb-text transition-colors hover:text-mlbb-gold-bright" href="/items/dominance-ice">Dominance Ice</a><span class="inline-flex items-baseline gap-1.5 text-[11px] uppercase tracking-wide text-mlbb-text-secondary/80"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right relative top-[1px] h-3 w-3 text-text-accent/65" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><span class="text-mlbb-text-secondary/65">over</span><a class="font-semibold text-text-accent transition-colors hover:text-mlbb-gold-bright" href="/items/glowing-wand">Glowing Wand</a></span><span class="basis-full text-[12.5px] text-mlbb-text-secondary/90 sm:basis-auto sm:before:mx-1 sm:before:text-mlbb-text-secondary/50 sm:before:content-[&#x27;•&#x27;]">Use when the enemy sustain comes from heroes near Gatotkaca rather than the target he is burning. Lifebane does not stack across the two, and Fortress Shield scales hybrid defense in grouped fights.</span></li><li class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-[12.5px] leading-relaxed text-mlbb-text-secondary"><a class="font-heading font-bold uppercase tracking-wide text-mlbb-text transition-colors hover:text-mlbb-gold-bright" href="/items/oracle">Oracle</a><span class="inline-flex items-baseline gap-1.5 text-[11px] uppercase tracking-wide text-mlbb-text-secondary/80"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right relative top-[1px] h-3 w-3 text-text-accent/65" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><span class="text-mlbb-text-secondary/65">over</span><a class="font-semibold text-text-accent transition-colors hover:text-mlbb-gold-bright" href="/items/brute-force-breastplate">Brute Force Breastplate</a></span><span class="basis-full text-[12.5px] text-mlbb-text-secondary/90 sm:basis-auto sm:before:mx-1 sm:before:text-mlbb-text-secondary/50 sm:before:content-[&#x27;•&#x27;]">Use when your team has healing or shielding that lets you stay in the second rotation.</span></li><li class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-[12.5px] leading-relaxed text-mlbb-text-secondary"><a class="font-heading font-bold uppercase t