,[\"$\",\"article\",\"legend\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #4dc9f6, #4dc9f633)\",\"boxShadow\":\"0 0 12px -2px #4dc9f680\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#4dc9f6\",\"background\":\"#4dc9f61a\",\"border\":\"1px solid #4dc9f640\"},\"children\":\"Legend\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Gatotkaca\",\"rank\":\"Legend\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=legend\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Legend\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Legend\",\"name\":\"Gatotkaca\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"44.87\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Gatotkaca\",\"delta\":\"-0.30%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.72\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.38\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Legend\"}}]]}]]}],[\"$\",\"article\",\"mythic\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[\"$La2\",\"$La3\",\"$La4\"]}],\"$La5\",\"$La6\"]}]\n7f:[\"$\",\"p\",\"p-4\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Do not lock him when your team is already pick-off heavy (Gusion, Ling, Natalia). Gatotkaca does not create picks. He creates teamfights.\"}]\n80:[\"$\",\"h2\",\"h2-1\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The one thing that makes Gatotkaca work\"]}]\n81:[\"$\",\"p\",\"p-5\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Gatotkaca is the only tank in the game who becomes mechanically correct to leave alive. His passive converts lost HP into physical defense, his enhanced basic attack heals him, and his taunt forces the enemy to keep feeding that loop. Every correct play with Gatotkaca ends with him at 15% HP, 200 bonus armor, and a full Rage bar swinging one enhanced basic that puts him back above 50%.\"}]\n82:[\"$\",\"p\",\"p-6\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"That is the bet. The kit is built to make enemies regret attacking him, and to make them regret ignoring him even more. His S1 plants a burning slow zone that punishes anyone standing near him, so melee heroes cannot just walk around him to reach the backline. His S2 taunt yanks a target into autoattacking him for the duration. His ultimate airborne pulls fringe enemies inward, so even the marksman who kited to the edge of the circle gets dragged into the center stun.\"}]\n83:[\"$\",\"p\",\"p-7\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Every part of the kit exists to make sure the fight happens on top of Gatotkaca. If you are playing him and the fight is happening 400 units away from you, you are playing him wrong.\"}]\n84:[\"$\",\"h2\",\"h2-2\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Roam: the first six minutes\"]}]\n85:[\"$\",\"p\",\"p-8\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Start at blue buff, give it to your jungler, and path straight to the midlane wave by second 20. Gatotkaca's level 2 is a threat zone. Take S1 first.\"}]\n86:[\"$\",\"ol\",\"ol-0\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Ward before you fight, not after.\"}],\" Gatotkaca has no escape. A single gank on him without vision is an auto-death because you cannot dash out of a Saber combo. Buy the trinket, ward the enemy jungle entrance by 1:00, and rotate from vision-secured bushes only.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Level 2 gank priority is the matchup your carry is losing.\"}],\" Walk into the lane from a warded bush, use S2 to close distance (not to taunt), then S1 to drop the slow zone on retreat angle. The kill comes from your carry; your job is the lockdown and the damage floor.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Do not burn Flicker to engage before level 4.\"}],\" You have S2 sprint distance scaling with channel time. A full-channel S2 covers more ground than most heroes realize. Flicker is your only real escape tool before Immortality, and burning it to chase a 40%-HP Layla at level 3 gets you solo-killed on the next gank attempt.\"]}],\"\\n\"]}]\n87:[\"$\",\"h2\",\"h2-3\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The power spike you are farming toward\"]}]\n88:[\"$\",\"p\",\"p-9\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The real turning point is Cursed Helmet plus Thunder Belt, usually online around the 9 to 11 minute mark if you are hitting your rotation gold. Before Cursed Helmet, Gatotkaca is a CC bot with one good ability. After Cursed Helmet, he is a damage aura: the item's Burning Soul passive ticks 1.2% Max HP magic damage per second to every nearby enemy, and because he already builds 1200 bonus HP on the item itself, that tick hurts. Thunder Belt then adds a true-damage proc that arms on a short timer and fires on his next basic attack, with the damage scaling off his Total Physical Defense and Total Magic Defense, which means every defensive stat he buys also raises his offensive ceiling.\"}]\n89:[\"$\",\"p\",\"p-10\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"That is the spike. After those two items, a full-duration taunt into a Cursed Helmet aura does meaningful damage on its own, his enhanced basic attack from Steel Bones drops a non-trivial health chunk with the Thunder Belt proc, and he gains the stat threshold where he can actually survive the channel on his S2 without being bursted out of it. Before those items, he is an initiator. After them, he is a frontline that the enemy physically has to deal with or lose the fight.\"}]\n8a:[\"$\",\"h2\",\"h2-4\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Teamfight positioning and target priority\"]}]\n8b:[\"$\",\"p\",\"p-11\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The reflex when you see a squishy marksman is to Flicker into her and taunt. That reflex is usually wrong on Gatotkaca. A taunted marksman deals autoattack damage to you, which feeds your passive, but the rest of her team is free to peel or reposition. The better target is almost always the enemy frontline or jungler, because taunting them stops their engage and leaves their backline exposed to your team.\"}]\n8c:[\"$\",\"ol\",\"ol-1\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Initiate with the ultimate, not the taunt.\"}],\" Your ultimate has the longest cooldown in your kit and the highest impact. Open fights with it while the enemy is clumped (chokepoints, objective pits, bush exits), then follow with S2 to lock whoever tried to flash out.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Position on the side of the fight, not in front of it.\"}],\" Gatotkaca's ultimate drags fringe enemies to the center, so you want to jump in from an angle the enemy did not expect. Jumping straight forward onto a prepared frontline means they just side-step the circle.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Stand on top of your carry when you are not engaging.\"}],\" His S2 taunt is a peel tool, not just an engage tool. If your Melissa is being dove by a Hayabusa, a half-channel S2 into the assassin shuts the dive down cold because he has to autoattack you while your carry walks away.\"]}],\"\\n\"]}]\n8d:[\"$\",\"p\",\"p-12\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"If your support is Estes or Rafaela, you are allowed to dive deeper. Their healing back-fills the exact loop Gatotkaca needs. If your support is a poke mage like Valir or Diggie, you do not get to dive; you get to peel.\"}]\n8e:[\"$\",\"$La7\",null,{\"slot\":\"7246933188\",\"variant\":\"in-article\",\"className\":\"my-8\"}]\n8f:[[\"$\",\"h2\",\"h2-0\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Itemization: four locked slots and two real conversations\"]}],\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Tough Boots, Cursed Helmet, Thunder Belt, and Dominance Ice are the core four. Everything after is situational.\"}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The fifth slot is the first real conversation. Against a heavy magic team (Pharsa, Kagura, Esmeralda), Athena's Shield is correct because its passive pre-applies 25% magic damage reduction before the damage hits. Against a heavy physical team (Yu Zhong, Fredrinn, Melissa), Antique Cuirass is correct because its Deter passive stacks up to three times against skill damage and drops incoming physical damage by 18% at full stacks. Against comps that heal (Estes, Alice, Uranus), skip both and go Dominance Ice earlier for the anti-heal.\"}],\"\\n\",[\"$\",\"p\",\"p-2\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The sixth slot is the second real conversation. Immortality is the default, but Queen's Wings is the better pick when your team already has a peel support and you are expected to front-line dive deep. Its Demonize passive triggers below 40% HP and reduces damage by 30% plus cuts 2 seconds off your skill cooldowns. That is the exact moment Gatotkaca wants to press S2 again.\"}],\"\\n\",[\"$\",\"p\",\"p-3\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The worst common build choice is Glowing Wand. Skip it. Wand gives 400 HP and no defensive stats, and Gatotkaca does not have enough magic power scaling in his kit to justify a magic damage item. If the narrative in your head is \\\"I want more damage,\\\" Thunder Belt and Cursed Helmet already do that, and they do it through items that also keep you alive.\"}],\"\\n\",[\"$\",\"p\",\"p-4\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Tough Boots over Warrior Boots is the default because his taunt duration and slow uptime matter more than a small armor bonus. Warrior Boots is correct only against a specifically autoattack-heavy comp like Karrie, Claude, or Wanwan, where the Valor stack actually sees uptime.\"}],\"\\n\",[\"$\",\"h2\",\"h2-1\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Mistakes that lose Gatotkaca games\"]}],\"\\n\",[\"$\",\"p\",\"p-5\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Full-channel S2 engages against any hero with a dash.\"}],\" The patch 2.1.40 nerf changed S2 taunt from a fixed duration to one that scales with channel time, so a rushed cast barely taunts at all. A lot of Gatotkaca mains did not update their engage pattern. You still have to full-channel for max taunt, which means you are standing still and visible for roughly a second before the sprint starts. Any competent Fanny, Ling, or Saber will dash out before the taunt connects. Against mobile heroes, use half-channel S2 as a gap-closer and commit the taunt only after you have vision on their dash cooldown.\"]}],\"\\n\",\"$La8\",\"\\n\",\"$La9\",\"\\n\",\"$Laa\",\"\\n\",\"$Lab\",\"\\n\",\"$Lac\",\"\\n\",\"$Lad\",\"\\n\",\"$Lae\",\"\\n\",\"$Laf\",\"\\n\",\"$Lb0\"]\n90:[\"$\",\"$Lb1\",null,{\"heroName\":\"Gatotkaca\"}]\n"])</script><script>self.__next_f.push([1,"91:[\"$\",\"$L6b\",\"lesley\",{\"href\":\"/heroes/lesley\",\"className\":\"group block\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative bg-surface-4 border border-mlbb-gold/20 overflow-hidden card-hover hover:border-mlbb-gold/50\",\"style\":{\"boxShadow\":\"0 2px 8px rgba(0,0,0,0.3)\"},\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 p-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative w-14 h-14 rounded-full overflow-hidden flex-shrink-0 bg-surface-3\",\"children\":[\"$\",\"$L6c\",null,{\"src\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_08770893183018333f54a98e63c41ee3.png\",\"alt\":\"Lesley - Deadly Sniper\",\"unoptimized\":false,\"priority\":\"$undefined\",\"fetchPriority\":\"$undefined\",\"fill\":true,\"className\":\"object-cover group-hover:scale-110 transition-transform duration-300\",\"sizes\":\"56px\",\"placeholder\":\"blur\",\"blurDataURL\":\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTAwIiBoZWlnaHQ9IjEwMCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48cmVjdCB3aWR0aD0iMTAwIiBoZWlnaHQ9IjEwMCIgZmlsbD0iIzBkMTIyNSIvPjwvc3ZnPg==\"}]}],[\"$\",\"div\",null,{\"className\":\"flex-1 min-w-0\",\"children\":[[\"$\",\"h4\",null,{\"className\":\"font-heading font-bold text-text-primary group-hover:text-text-accent-bright transition-colors truncate\",\"children\":\"Lesley\"}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mt-0.5\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-[10px] font-heading uppercase tracking-wider px-1.5 py-0.5\",\"style\":{\"backgroundColor\":\"#E74C3C20\",\"color\":\"#ee8277\",\"border\":\"1px solid #E74C3C40\"},\"children\":\"Marksman\"}],[\"$\",\"$L6d\",null,{\"tier\":\"B\",\"size\":\"sm\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-[10px] text-text-muted mt-1 truncate\",\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.relReasonCounter\",\"params\":{\"pp\":\"3.0\",\"name\":\"Gatotkaca\"}}]}]]}],[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-chevron-right w-4 h-4 text-text-muted group-hover:text-text-accent transition-colors flex-shrink-0\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"mthhwq\",{\"d\":\"m9 18 6-6-6-6\"}],\"$undefined\"]}]]}],[\"$\",\"div\",null,{\"className\":\"absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none\",\"style\":{\"background\":\"radial-gradient(ellipse at center, #E74C3C12 0%, transparent 70%)\"}}],[\"$\",\"div\",null,{\"className\":\"absolute top-0 left-0 w-3 h-3 border-t border-l border-mlbb-gold/0 group-hover:border-mlbb-gold/50 transition-all duration-300 pointer-events-none\"}],[\"$\",\"div\",null,{\"className\":\"absolute bottom-0 right-0 w-3 h-3 border-b border-r border-mlbb-gold/0 group-hover:border-mlbb-gold/50 transition-all duration-300 pointer-events-none\"}],[\"$\",\"div\",null,{\"className\":\"absolute bottom-0 left-0 right-0 h-[1px] opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none\",\"style\":{\"background\":\"linear-gradient(90deg, transparent, #E74C3C, transparent)\"}}]]}]}]\n92:[\"$\",\"$L6b\",\"angela\",{\"href\":\"/heroes/angela\",\"className\":\"group block\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative bg-surface-4 border border-mlbb-gold/20 overflow-hidden card-hover hover:border-mlbb-gold/50\",\"style\":{\"boxShadow\":\"0 2px 8px rgba(0,0,0,0.3)\"},\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 p-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative w-14 h-14 rounded-full overflow-hidden flex-shrink-0 bg-surface-3\",\"children\":[\"$\",\"$L6c\",null,{\"src\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_c7e0183956b2c2fd6d3fa0b18fe46917.png\",\"alt\":\"Angela - Bunnylove\",\"unoptimized\":false,\"priority\":\"$undefined\",\"fetchPriority\":\"$undefined\",\"fill\":true,\"className\":\"object-cover group-hover:scale-110 transition-transform duration-300\",\"sizes\":\"56px\",\"placeholder\":\"blur\",\"blurDataURL\":\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTAwIiBoZWlnaHQ9IjEwMCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48cmVjdCB3aWR0aD0iMTAwIiBoZWlnaHQ9IjEwMCIgZmlsbD0iIzBkMTIyNSIvPjwvc3ZnPg==\"}]}],[\"$\",\"div\",null,{\"className\":\"flex-1 min-w-0\",\"children\":[[\"$\",\"h4\