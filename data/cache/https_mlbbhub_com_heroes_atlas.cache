\"MLBBHub\",\"url\":\"https://mlbbhub.com\"}}5f:[\"$\",\"script\",\"2\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$64\"}}]\n60:[\"$\",\"$L65\",null,{\"hero\":{\"id\":93,\"name\":\"Atlas\",\"slug\":\"atlas\",\"title\":\"Ocean Gladiator\",\"role\":[\"Tank\"],\"specialty\":[\"Crowd Control\",\"Initiator\"],\"lane\":[\"Roam\"],\"tier\":\"A\",\"difficulty\":2,\"releaseYear\":2020,\"stats\":{\"durability\":80,\"offense\":10,\"controlEffect\":90,\"difficulty\":50},\"winRate\":52.2,\"pickRate\":0.94,\"banRate\":10.42,\"counters\":{\"strongAgainst\":[{\"heroSlug\":\"vexana\",\"heroName\":\"Vexana\",\"advantage\":\"strong\",\"tip\":\"Atlas counters squishy heroes without mobility skills like Vexana and Eudora because they cannot reliably escape his CC.\"},{\"heroSlug\":\"eudora\",\"heroName\":\"Eudora\",\"advantage\":\"strong\",\"tip\":\"Atlas counters squishy heroes without mobility skills like Vexana and Eudora because they cannot reliably escape his CC.\"}],\"weakAgainst\":[{\"heroSlug\":\"valir\",\"heroName\":\"Valir\",\"advantage\":\"weak\",\"tip\":\"Atlas is countered by heroes who can knock him away, such as Valir and Moskov, since they can easily stop his 2nd Skill which Atlas relies on to land his other skills.\"},{\"heroSlug\":\"moskov\",\"heroName\":\"Moskov\",\"advantage\":\"weak\",\"tip\":\"Atlas is countered by heroes who can knock him away, such as Valir and Moskov, since they can easily stop his 2nd Skill which Atlas relies on to land his other skills.\"}]},\"splashArt\":\"https://akmweb.youngjoygame.com/web/svnres/file/mlbb/homepage/100_9a217534db9b67c6db2c45d57a0d640c.jpg\",\"portrait\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_d974ac796678180ff8724b88e192898b.png\",\"officialMatchups\":[{\"kind\":\"best_ally\",\"heroId\":\"82\",\"heroName\":\"Terizla\",\"heroSlug\":\"terizla\",\"icon\":\"https://akmwebstatic.yuanzhanapp.com/web/madmin/image_45c908d0d59990c13d229ab22db05ebb.png\",\"tip\":\"Terizla, Tigreal, Vale\"},{\"kind\":\"counters\",\"heroId\":\"40\",\"heroName\":\"Karrie\",\"heroSlug\":\"karrie\",\"icon\":\"https://akmwebstatic.yuanzhanapp.com/web/madmin/image_2ae89c203ad1488fa1af6b7e51dae488.png\",\"tip\":\"Karrie, Bruno, Hanzo\"},{\"kind\":\"countered_by\",\"heroId\":\"73\",\"heroName\":\"Harith\",\"heroSlug\":\"harith\",\"icon\":\"https://akmwebstatic.yuanzhanapp.com/web/madmin/image_6df4352d8f0d6ce429ad308d323c6206.png\",\"tip\":\"Harith, Wanwan, Kadita\"}],\"skills\":{\"skills\":[{\"name\":\"Frigid Breath\",\"type\":\"Passive\",\"description\":\"Atlas generates Frigid Breath around him for 5s each time he casts a skill. Enemies affected by Frigid Breath will have their Movement Speed gradually reduced over 2s, after which they'll be frozen for 0.5s.\\n\\nAtlas gains 20 (+0.5% Extra Max HP) extra Hybrid Defense when Frigid Breath is present.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Atlas generates \"},{\"type\":\"text\",\"text\":\"Frigid Breath\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" around him for 5s each time he casts a skill. Enemies affected by \"},{\"type\":\"text\",\"text\":\"Frigid Breath\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" will have their Movement Speed gradually reduced over 2s, after which they'll be frozen for 0.5s.\\n\\nAtlas gains 20 (+0.5% Extra Max HP) extra Hybrid Defense when \"},{\"type\":\"text\",\"text\":\"Frigid Breath\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" is present.\"}],\"cooldown\":null,\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_d7bbba4e6ab968ce1f1d798f29960198.png\",\"tags\":[\"Buff\",\"Debuff\"]},{\"name\":\"Annihilate\",\"type\":\"Skill 1\",\"description\":\"Atlas smashes the ground and causes 3 explosions, dealing 400 (+100% Total Magic Power) Magic Damage to enemies.\\n\\nEjected State: If Atlas is ejected from his Mecha Sentry, both he and his Mecha will cast Annihilate.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Atlas smashes the ground and causes 3 explosions, dealing 400\"},{\"type\":\"text\",\"text\":\" (+100% Total Magic Power)\",\"color\":\"#62f8fe\"},{\"type\":\"text\",\"text\":\" Magic Damage to enemies.\\n\\n\"},{\"type\":\"text\",\"text\":\"Ejected State\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\": If Atlas is ejected from his Mecha Sentry, both he and his Mecha will cast Annihilate.\"}],\"cooldown\":\"7s\",\"manaCost\":\"60\",\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_e329fe04072558085096e8198d9e15c8.png\",\"tags\":[\"AOE\"]},{\"name\":\"Perfect Match\",\"type\":\"Skill 2\",\"description\":\"Atlas enters Ejected State, gaining 30% Movement Speed and immunity to Slowing Effects. In this state, the Mecha Sentry will follow the pilot at an increasing speed (can only be controlled by Suppression). Once they meet, Atlas will return to the Mecha, dealing 320 (+80% Total Magic Power) Magic Damage to enemies nearby and stunning them for 0.8s.\\nEjected State: Atlas and his Mecha share the same HP bar and reduce 50% of the damage taken in this state.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Atlas enters \"},{\"type\":\"text\",\"text\":\"Ejected State\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\", gaining 30% Movement Speed and immunity to Slowing Effects. In this state, the Mecha Sentry will follow the pilot at an increasing speed (can only be controlled by Suppression). Once they meet, Atlas will return to the Mecha, dealing 320\"},{\"type\":\"text\",\"text\":\" (+80% Total Magic Power)\",\"color\":\"#62f8fe\"},{\"type\":\"text\",\"text\":\" Magic Damage to enemies nearby and stunning them for 0.8s.\\n\"},{\"type\":\"text\",\"text\":\"Ejected State\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\": Atlas and his Mecha share the same HP bar and reduce 50% of the damage taken in this state.\"}],\"cooldown\":\"0s\",\"manaCost\":\"75\",\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_15c10ac17e273e24397333ae7900a72d.png\",\"tags\":[\"Mobility\",\"CC\"]},{\"name\":\"Fatal Links\",\"type\":\"Ultimate\",\"description\":\"Atlas hurls chains around and starts to channel (can only be interrupted by Suppression), dealing 225 (+75% Total Magic Power) Magic Damage to enemy heroes hit and slowing them by 40% for 3s.\\nRelease the skill while channeling: Atlas will drag the targets toward him and plunk them down on the designated location, dealing 360 (+180% Total Magic Power) Magic Damage.\\nUse this skill in Ejected State: The Mecha Sentry will return to Atlas immediately, but the stun effect will be replaced by 40% Slowing Effect.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Atlas hurls chains around and starts to channel (can only be interrupted by Suppression), dealing 225\"},{\"type\":\"text\",\"text\":\" (+75% Total Magic Power)\",\"color\":\"#62f8fe\"},{\"type\":\"text\",\"text\":\" Magic Damage to enemy heroes hit and slowing them by 40% for 3s.\\nRelease the skill while channeling: Atlas will drag the targets toward him and plunk them down on the designated location, dealing 360\"},{\"type\":\"text\",\"text\":\" (+180% Total Magic Power)\",\"color\":\"#62f8fe\"},{\"type\":\"text\",\"text\":\" Magic Damage.\\nUse this skill in \"},{\"type\":\"text\",\"text\":\"Ejected State\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\": The Mecha Sentry will return to Atlas immediately, but the stun effect will be replaced by 40% Slowing Effect.\"}],\"cooldown\":\"55s\",\"manaCost\":\"130\",\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_6b88d2df7f9a269a382e2cd256f9d816.png\",\"tags\":[\"CC\",\"AOE\"]}],\"skillUpgradePriority\":\"3-1-2\",\"skillPriorityTip\":\"Annihilate, Perfect Match, Fatal Links\",\"skillPriorityTipRich\":[{\"type\":\"text\",\"text\":\"Annihilate, Perfect Match, Fatal Links\"}]},\"synergies\":[{\"heroSlug\":\"vale\",\"heroName\":\"Vale\",\"synergyScore\":8,\"reason\":\"Atlas works well with heroes with high AOE damage like Vale and Ixia because Atlas can pull enemies together and keep them CC'd.\"},{\"heroSlug\":\"ixia\",\"heroName\":\"Ixia\",\"synergyScore\":8,\"reason\":\"Atlas works well with heroes with high AOE damage like Vale and Ixia because Atlas can pull enemies together and keep them CC'd.\"}],\"combos\":[{\"type\":\"teamfight\",\"title\":\"TEAMFIGHT COMBOS\",\"description\":\"In teamfights, use Atlas's 2nd Skill to approach the enemy and unleash his Ultimate when multiple enemies are in range. Aim while channeling and release to slam them down near your team, then continue to deal damage with his 1st Skill.\",\"skillSequence\":[{\"skillId\":9320,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_15c10ac17e273e24397333ae7900a72d.png\"},{\"skillId\":9330,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_6b88d2df7f9a269a382e2cd256f9d816.png\"},{\"skillId\":9310,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_e329fe04072558085096e8198d9e15c8.png\"}]},{\"type\":\"laning\",\"title\":\"LANING COMBOS\",\"description\":\"In the laning phase, use Atlas's 2nd Skill to eject and then get close to the enemy. Right before the Mecha Sentry reaches Atlas, use his 1st Skill to double the effect.\",\"skillSequence\":[{\"skillId\":9320,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_15c10ac17e273e24397333ae7900a72d.png\"},{\"skillId\":9310,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_e329fe04072558085096e8198d9e15c8.png\"}]}],\"metaDescription\":\"Atlas build, counter, and strategy guide for Mobile Legends. Master Fatal Links timing, roam item choices, emblem setup, and draft traps for MLBB ranked.\",\"builds\":[],\"overviewLede\":\"Atlas is a roamer for teams that can turn one clean grab into a fight win. Patch 2.1.95a ([patch notes](/patch-notes)) trimmed Perfect Match's speed bonus and stretched its cooldown, so his roam-to-gank window is slower and his chase is less free than before. The pick still collapses if the enemy draft has purify, suppression, or too many instant exits.\"},\"serverLocale\":\"en\",\"curatedBuilds\":{\"source\":\"curated\",\"hero\":\"atlas\",\"patch\":\"2.1.67\",\"lastReviewed\":\"2026-05-07\",\"stalePatch\":true,\"currentPatch\":\"2.2.16a\",\"builds\":[{\"slot\":1,\"id\":\"roam-conceal-pickoff\",\"name\":\"Roam Conceal Pickoff\",\"roleContext\":\"Roam\",\"items\":[{\"slug\":\"rapid-boots\",\"name\":\"Rapid Boots\",\"cost\":750,\"fixed\":false},{\"slug\":\"dominance-ice\",\"name\":\"Dominance Ice\",\"cost\":2010,\"fixed\":false},{\"slug\":\"fleeting-time\",\"name\":\"Fleeting Time\",\"cost\":2050,\"fixed\":false},{\"slug\":\"athenas-shield\",\"name\":\"Athena's Shield\",\"cost\":2150,\"fixed\":false},{\"slug\":\"antique-cuirass\",\"name\":\"Antique Cuirass\",\"cost\":2170,\"fixed\":false},{\"slug\":\"immortality\",\"name\":\"Immortality\",\"cost\":2120,\"fixed\":false}],\"coreItems\":[{\"slug\":\"dominance-ice\",\"name\":\"Dominance Ice\"},{\"slug\":\"fleeting-time\",\"name\":\"Fleeting Time\"},{\"slug\":\"athenas-shield\",\"name\":\"Athena's Shield\"}],\"emblem\":{\"slug\":\"support\",\"name\":\"Support Emblem\",\"talents\":[{\"slug\":\"agility\",\"name\":\"Agility\",\"iconUrl\":\"/images/talents/agility.png\",\"bucket\":\"standard\"},{\"slug\":\"pull-yourself-together\",\"name\":\"Pull Yourself Together\",\"iconUrl\":\"/images/talents/pull-yourself-together.png\",\"bucket\":\"standard\"},{\"slug\":\"focusing-mark\",\"name\":\"Focusing Mark\",\"iconUrl\":\"/images/talents/focusing-mark.png\",\"bucket\":\"core\"}]},\"spell\":{\"slug\":\"flicker\",\"name\":\"Flicker\"},\"blessing\":{\"slug\":\"conceal\",\"name\":\"Conceal\"},\"flexItems\":[{\"item\":{\"slug\":\"radiant-armor\",\"name\":\"Radiant Armor\"},\"replace\":{\"slug\":\"athenas-shield\",\"name\":\"Athena's Shield\"},\"trigger\":\"Use against repeated magic poke or burn damage that chips Atlas before Perfect Match starts.\"},{\"item\":{\"slug\":\"blade-armor\",\"name\":\"Blade Armor\"},\"replace\":{\"slug\":\"antique-cuirass\",\"name\":\"Antique Cuirass\"},\"trigger\":\"Use when a basic-attack marksman is forced to hit Atlas during the Fatal Links channel.\"},{\"item\":{\"slug\":\"guardian-helmet\",\"name\":\"Guardian Helmet\"},\"replace\":{\"slug\":\"fleeting-time\",\"name\":\"Fleeting Time\"},\"trigger\":\"Use when you are winning vision but entering every objective fight too low to start cleanly.\"}],\"notes\":\"Default ranked Atlas setup that pairs Conceal and Flicker with enough cooldown and defense to turn a two-hero pull into a reset.\",\"totalCost\":11250,\"statLines\":[{\"key\":\"adaptiveatk\",\"labelKey\":\"common.stats.adaptiveAttack\",\"unit\":\"flat\",\"group\":\"offensive\",\"value\":30,\"sources\":[\"Fleeting Time\"]},{\"key\":\"hp\",\"labelKey\":\"common.stats.hp\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":3220,\"sources\":[\"Fleeting Time\",\"Athena's Shield\",\"Antique Cuirass\",\"Immortality\"]},{\"key\":\"hpregen\",\"labelKey\":\"common.stats.hpRegen\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":6,\"sources\":[\"Athena's Shield\",\"Antique Cuirass\"]},{\"key\":\"physdefense\",\"labelKey\":\"common.stats.physicalDefense\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":95,\"sources\":[\"Dominance Ice\",\"Antique Cuirass\",\"Immortality\"]},{\"key\":\"magicdefense\",\"labelKey\":\"common.stats.magicDefense\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":88,\"sources\":[\"Dominance Ice\",\"Athena's Shield\"]},{\"key\":\"slowreduction\",\"labelKey\":\"common.stats.slowReduction\",\"unit\":\"percent\",\"group\":\"defensive\",\"value\":35,\"sources\":[\"Rapid Boots\"]},{\"key\":\"movespeed\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"flat\",\"group\":\"utility\",\"value\":55,\"sources\":[\"Rapid Boots\"]},{\"key\":\"movespeedPct\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"percent\",\"group\":\"utility\",\"value\":5,\"sources\":[\"Dominance Ice\"]},{\"key\":\"cdreduction\",\"labelKey\":\"common.stats.cooldownReduction\",\"unit\":\"percent\",\"group\":\"utility\",\"value\":15,\"sources\":[\"Fleeting Time\"]}],\"conflicts\":[],\"simulatorUrl\":\"/build-simulator?hero=atlas\u0026items=rapid-boots%2Cdominance-ice%2Cfleeting-time%2Cathenas-shield%2Cantique-cuirass%2Cimmortality\u0026blessing=conceal\u0026spell=flicker\u0026emblem=support\u0026talents=agility%2Cpull-yourself-together%2Cfocusing-mark\u0026flex=radiant-armor.athenas-shield%2Cblade-armor.antique-cuirass%2Cguardian-helmet.fleeting-time\"},{\"slot\":2,\"id\":\"roam-frontline-encourage\",\"name\":\"Roam Frontline Encourage\",\"roleContext\":\"Roam\",\"items\":[{\"slug\":\"tough-boots\",\"name\":\"Tough Boots\",\"cost\":700,\"fixed\":false},{\"slug\":\"dominance-ice\",\"name\":\"Dominance Ice\",\"cost\":2010,\"fixed\":false},{\"slug\":\"antique-cuirass\",\"name\":\"Antique Cuirass\",\"cost\":2170,\"fixed\":false},{\"slug\":\"radiant-armor\",\"name\":\"Radiant Armor\",\"cost\":1880,\"fixed\":false},{\"slug\":\"guardian-helmet\",\"name\":\"Guardian Helmet\",\"cost\":2500,\"fixed\":false},{\"slug\":\"immortality\",\"name\":\"Immortality\",\"cost\":2120,\"fixed\":false}],\"coreItems\":[{\"slug\":\"dominance-ice\",\"name\":\"Dominance Ice\"},{\"slug\":\"antique-cuirass\",\"name\":\"Antique Cuirass\"},{\"slug\":\"guardian-helmet\",\"name\":\"Guardian Helmet\"}],\"emblem\":{\"slug\":\"tank\",\"name\":\"Tank Emblem\",\"talents\":[{\"slug\":\"vitality\",\"name\":\"Vitality\",\"iconUrl\":\"/images/talents/vitality.png\",\"bucket\":\"standard\"},{\"slug\":\"tenacity\",\"name\":\"Tenacity\",\"iconUrl\":\"/images/talents/tenacity.png\",\"bucket\":\"standard\"},{\"slug\":\"concussive-blast\",\"name\":\"Concussive Blast\",\"iconUrl\":\"/image