ends.fandom.com/wiki/Atlas/Cosmetics\"},{\"name\":\"Sunken Curse\",\"tier\":\"Deluxe\",\"rawTier\":\"Deluxe\",\"tag\":\"Epic\",\"tagSlug\":\"epic\",\"price\":\"Limited-time Event\",\"portraitFile\":\"Hero937-portrait.png\",\"portraitUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/atlas/Hero937-portrait-20251211051746.webp\",\"splashUrl\":null,\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Atlas/Cosmetics\"},{\"name\":\"Battle Turbine\",\"tier\":\"Exceptional\",\"rawTier\":\"Exceptional\",\"tag\":\"Starlight\",\"tagSlug\":\"starlight\",\"price\":\"2022/03 StarLight Reward\",\"portraitFile\":\"Hero933-portrait.png\",\"portraitUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/atlas/Hero933-portrait-20220525170224.webp\",\"splashUrl\":null,\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Atlas/Cosmetics\"}],\"lore\":{\"backstory\":\"Atlas is a primordial ocean titan, an ancient being from the deepest abyss of the sea who was awakened by the same dark tremors that freed Khufra from his desert tomb. His massive body can compress into an inescapable sphere, dragging multiple enemies into a crushing vortex. Atlas views the surface world with alien curiosity, initially indifferent to the war between Light and Abyss. However, the Abyss's corruption of the ocean depths has turned his curiosity into cold fury, and he now allies with anyone who opposes the dark tide.\",\"allies\":[{\"heroSlug\":\"khufra\",\"heroName\":\"Khufra\",\"relationship\":\"Fellow ancient titan awakened from eternal slumber\"},{\"heroSlug\":\"hylos\",\"heroName\":\"Hylos\",\"relationship\":\"Nature guardian who shares his ancient origins\"}],\"rivals\":[{\"heroSlug\":\"franco\",\"heroName\":\"Franco\",\"relationship\":\"Northern chieftain who fishes in his domain\"},{\"heroSlug\":\"vale\",\"heroName\":\"Vale\",\"relationship\":\"Wind mage whose gales disturb the ocean surface\"}]},\"loreUrlName\":\"Atlas\",\"statsHistory\":[{\"date\":\"2026-09-07\",\"winRate\":51.44,\"pickRate\":1.06,\"banRate\":19.68},{\"date\":\"2026-09-10\",\"winRate\":51.51,\"pickRate\":1.08,\"banRate\":19.74},{\"date\":\"2026-09-16\",\"winRate\":51.79,\"pickRate\":1.1,\"banRate\":20.47},{\"date\":\"2026-09-28\",\"winRate\":52.16,\"pickRate\":1,\"banRate\":12.22},{\"date\":\"2026-10-02\",\"winRate\":51.99,\"pickRate\":0.99,\"banRate\":12.38},{\"date\":\"2026-10-09\",\"winRate\":51.83,\"pickRate\":0.96,\"banRate\":11.73},{\"date\":\"2026-10-17\",\"winRate\":52.2,\"pickRate\":0.94,\"banRate\":10.42}]},\"relatedHeroesSlot\":\"$L66\",\"statsSeoSlot\":\"$L67\",\"fieldManualSlot\":\"$L68\"}]\n61:[\"$\",\"$L69\",null,{\"heroName\":\"Atlas\",\"heroSlug\":\"atlas\",\"roles\":\"$60:props:hero:role\",\"lanes\":\"$60:props:hero:lane\",\"difficulty\":2,\"winRate\":52.2,\"pickRate\":0.94,\"banRate\":10.42,\"curatedBuilds\":\"$60:props:curatedBuilds\",\"topCounters\":\"$60:props:tabData:counterData:countersThisHero\",\"hasCounterPage\":true,\"hasRankStats\":true,\"locale\":\"en\",\"pageUrl\":\"https://mlbbhub.com/heroes/atlas\",\"year\":2026}]\n"])</script><script>self.__next_f.push([1,"6a:I[313915,[\"$7\",\"$8\",\"$9\",\"$a\",\"$b\",\"$2e\",\"$3e\",\"$3f\"],\"default\"]\n6b:I[114533,[\"$7\",\"$8\",\"$9\",\"$a\",\"$b\",\"$2e\",\"$3e\",\"$3f\"],\"Image\"]\n6c:I[842376,[\"$7\",\"$8\",\"$9\",\"$a\",\"$b\",\"$2e\",\"$3e\",\"$3f\"],\"default\"]\n7d:I[365750,[\"$7\",\"$8\",\"$9\",\"$a\",\"$b\",\"$2e\",\"$3e\",\"$3f\"],\"default\"]\n66:[\"$\",\"section\",null,{\"className\":\"content-lazy mt-8 pt-6 md:mt-12 md:pt-8 border-t border-border-subtle\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl md:text-2xl font-heading font-bold text-text-primary mb-4 md:mb-6\",\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.relHeading\"}]}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 md:gap-6\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mb-3\",\"children\":[[\"$\",\"svg\",null,{\"ref\"