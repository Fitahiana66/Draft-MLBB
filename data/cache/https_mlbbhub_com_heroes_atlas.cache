edPct\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"percent\",\"group\":\"utility\",\"value\":5,\"sources\":[\"Dominance Ice\"]}],\"conflicts\":[],\"simulatorUrl\":\"/build-simulator?hero=atlas\u0026items=tough-boots%2Cdominance-ice%2Cantique-cuirass%2Cradiant-armor%2Cguardian-helmet%2Cimmortality\u0026blessing=encourage\u0026spell=flicker\u0026emblem=tank\u0026talents=vitality%2Ctenacity%2Cconcussive-blast\u0026flex=rapid-boots.tough-boots%2Cathenas-shield.radiant-armor%2Cfleeting-time.guardian-helmet\"},{\"slot\":3,\"id\":\"roam-vengeance-anti-physical\",\"name\":\"Roam Vengeance Anti-Physical\",\"roleContext\":\"Roam\",\"items\":[{\"slug\":\"warrior-boots\",\"name\":\"Warrior Boots\",\"cost\":720,\"fixed\":false},{\"slug\":\"dominance-ice\",\"name\":\"Dominance Ice\",\"cost\":2010,\"fixed\":false},{\"slug\":\"blade-armor\",\"name\":\"Blade Armor\",\"cost\":1910,\"fixed\":false},{\"slug\":\"antique-cuirass\",\"name\":\"Antique Cuirass\",\"cost\":2170,\"fixed\":false},{\"slug\":\"athenas-shield\",\"name\":\"Athena's Shield\",\"cost\":2150,\"fixed\":false},{\"slug\":\"immortality\",\"name\":\"Immortality\",\"cost\":2120,\"fixed\":false}],\"coreItems\":[{\"slug\":\"dominance-ice\",\"name\":\"Dominance Ice\"},{\"slug\":\"blade-armor\",\"name\":\"Blade Armor\"},{\"slug\":\"antique-cuirass\",\"name\":\"Antique Cuirass\"}],\"emblem\":{\"slug\":\"tank\",\"name\":\"Tank Emblem\",\"talents\":[{\"slug\":\"vitality\",\"name\":\"Vitality\",\"iconUrl\":\"/images/talents/vitality.png\",\"bucket\":\"standard\"},{\"slug\":\"tenacity\",\"name\":\"Tenacity\",\"iconUrl\":\"/images/talents/tenacity.png\",\"bucket\":\"standard\"},{\"slug\":\"concussive-blast\",\"name\":\"Concussive Blast\",\"iconUrl\":\"/images/talents/concussive-blast.png\",\"bucket\":\"core\"}]},\"spell\":{\"slug\":\"vengeance\",\"name\":\"Vengeance\"},\"blessing\":{\"slug\":\"encourage\",\"name\":\"Encourage\"},\"flexItems\":[{\"item\":{\"slug\":\"tough-boots\",\"name\":\"Tough Boots\"},\"replace\":{\"slu