wrap items-center gap-x-5 gap-y-1.5 text-[11px] text-text-muted\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-1.5\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block h-3 w-5 rounded-sm bg-mlbb-gold/[0.07] ring-1 ring-inset ring-mlbb-gold/20\",\"aria-hidden\":\"true\"}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankColDelta\"}]]}],[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-1.5\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-trending-up h-3.5 w-3.5 text-text-muted\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"box55l\",{\"d\":\"M16 7h6v6\"}],[\"$\",\"path\",\"1t1m79\",{\"d\":\"m22 7-8.5 8.5-5-5L2 17\"}],\"$undefined\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankColTrend\",\"params\":{\"days\":7}}]]}]]}]\n7d:[\"$\",\"div\",null,{\"className\":\"mt-5 grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-3\",\"children\":[[\"$\",\"article\",\"epic\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #B07ECC, #B07ECC33)\",\"boxShadow\":\"0 0 12px -2px #B07ECC80\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#B07ECC\",\"background\":\"#B07ECC1a\",\"border\":\"1px solid #B07ECC40\"},\"children\":\"Epic\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Paquito\",\"rank\":\"Epic\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=epic\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Epic\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Epic\",\"name\":\"Paquito\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"50.02\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Paquito\",\"delta\":\"-0.26%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.89\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"14.90\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Epic\"}}]]}]]}],[\"$\",\"article\",\"legend\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #4dc9f6, #4dc9f633)\",\"boxShadow\":\"0 0 12px -2px #4dc9f680\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#4dc9f6\",\"background\":\"#4dc9f61a\",\"border\":\"1px solid #4dc9f640\"},\"children\":\"Legend\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Paquito\",\"rank\":\"Legend\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=legend\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Legend\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Legend\",\"name\":\"Paquito\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"50.39\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Paquito\",\"delta\":\"+0.11%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"1.23\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"32.74\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Legend\"}}]]}]]}],[\"$\",\"article\",\"mythic\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[\"$La1\",\"$La2\",\"$La3\"]}],\"$La4\",\"$La5\"]}]\n7f:[\"$\",\"p\",\"p-4\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Default to Assassin emblem when the lane is winnable and you want side-lane kills to snowball. Move to Fighter emblem when you need the lane to be playable first. The extra spell vamp plus Brave Smite style sustain gives you more useful stability than pretending every lane is a highlight reel.\"}]\n80:[\"$\",\"h2\",\"h2-1\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The Hero Works Only If You Pick The Right Enhanced Skill First\"]}]\n81:[\"$\",\"p\",\"p-5\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Most Paquito players lose games because they think the hero is about pressing buttons faster than the other guy. It is not. Paquito is about deciding which enhanced skill matters before the trade starts.\"}]\n82:[\"$\",\"p\",\"p-6\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Enhanced Jab is the punish button. You keep it when the target still has one dash left and the fight only works if you can follow that movement. Enhanced Heavy Left Punch is the permission button. You choose it when you know return damage is coming and you need to absorb the counter hit. The enhanced cast gives you shield value plus a brief damage reduction window on top of each other. Together they let you stay in the pocket for one more punch rather than bailing at the first chunk. Every enhanced skill triggers that damage reduction window, not just Heavy Left Punch, so even when Jab or Knockout Strike is the right choice, you get a small absorption phase on the cast. Sequence your combo to take the most dangerous hit inside that window. Enhanced Knockout Strike is the catch button. You use it when your team can convert displacement into a real kill, not when you are freelancing into three people with no follow-up.\"}]\n83:[\"$\",\"p\",\"p-7\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"That is the whole hero. Champ Stance is not a bonus tacked onto the kit. It is the kit. Jab gives him access, Heavy Left Punch lets him survive the answer, and Knockout Strike either peels space open or closes the door behind the target. If you enter a trade without already knowing which version you need, you are gambling with a hero that punishes indecision harder than most fighters do.\"}]\n84:[\"$\",\"p\",\"p-8\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The other key detail is that Jab stops on the first hero or creep it collides with. Paquito does not get to ignore minion geometry the way some dash fighters do. In lane and in river, half the difference between a clean combo and a dead Paquito is whether the path was open before you started. That single interaction decides more failed engages than raw damage ever does.\"}]\n85:[\"$\",\"h2\",\"h2-2\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Four Minutes To Earn The Map\"]}]\n86:[\"$\",\"ol\",\"ol-0\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Hold the first wave where you can threaten, not where you can show off.\"}],\" Let the wave settle slightly on your side, then trade when Heavy Left Punch can clip both the enemy hero and the minions you already wanted. If you hard shove from level 1, you remove your own brush angle and invite the first jungle touch for free.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Take Jab first, then unlock Heavy Left Punch at level 2 and start real trades there.\"}],\" Jab gets you into position and punishes sloppy last hits, but Enhanced Heavy Left Punch is what turns those short touches into winning exchanges. The enhanced cast gives you shield plus the damage reduction window, which means the opponent's counter punch lands for less than expected. Do not waste the early enhanced cast on empty space just because the passive lit up, and do not spend it before the trade commits: the absorption window is too brief to survive a counter hit that lands after it fades.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Save battle-spell tempo for level 4 or the first river fight.\"}],\" Flicker is the default because it fixes bad entry angles and lets you finish a target after they burn their last step. Execute is only worth the slot when the lane is truly killable and you can threaten level 4 all-ins on repeat. Either way, spending your spell on a cute level 2 chase usually trades your own next objective window for one chunk of lane damage.\"]}],\"\\n\"]}]\n87:[\"$\",\"p\",\"p-9\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"If the enemy EXP has stronger raw level 1 pressure, accept that and farm for the first clean stacked exchange instead of contesting every minion. Paquito wins by making the first real trade matter, not by posturing through every wave. Once you hit level 4, your goal is simple: clear, disappear for a moment, and force the enemy mid or roam to respect the possibility that you are already in river brush with stacks loaded.\"}]\n88:[\"$\",\"h2\",\"h2-3\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The Hunter Strike Plus Queen's Wings Window\"]}]\n89:[\"$\",\"p\",\"p-10\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The two-item spike worth farming toward is Hunter Strike plus Queen's Wings, usually around the 7 to 9 minute mark from an even EXP lane. That is the point where Paquito stops being a short-trade lane bully and becomes a fighter who can survive the answer to his first commit.\"}]\n8a:[\"$\",\"p\",\"p-11\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Hunter Strike matters because Paquito lands five hits in a real combo faster than most fighters do. Once the passive speed burst triggers, the fight changes shape. He can stay attached for one more punch, angle behind a carry, or bail out before the return crowd control reaches him. It turns his combo from a straight line into a curve, and that is the difference between forcing a Flicker and actually cashing the kill.\"}]\n8b:[\"$\",\"p\",\"p-12\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Queen's Wings is the part many Paquito players underestimate. When your HP drops low, it gives damage reduction and cuts skill cooldowns. On this hero that effect is not just survivability. It is tempo. The item lets you live through the first answer and still have a second cast window before the enemy expects it. That is exactly how Paquito steals skirmishes around Turtle, invades the second jungle rotation, and turns messy side-lane dives into trades your team can clean up.\"}]\n8c:[\"$\",\"p\",\"p-13\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Before this spike, play for wave control, vision pressure, and short trades that force recalls. After it, start treating every brush as a pick angle. You are not scaling into a classic late-game bruiser. You are farming for the point where one clean entry produces enough speed, shield, and cooldown compression to make the next decision yours.\"}]\n8d:[\"$\",\"$La6\",null,{\"slot\":\"7246933188\",\"variant\":\"in-article\",\"className\":\"my-8\"}]\n8e:[[\"$\",\"h2\",\"h2-0\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Teamfights Are Won Before The First Dash\"]}],\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The common wrong reflex is to flank too early and spend enhanced Jab on the first body in range. That is how Paquito enters a fight, lands damage, and then dies before the real target has committed anything. He does not want to start the whole fight by himself. He wants to arrive at the exact second someone important has already lost the right to reposition.\"}],\"\\n\",[\"$\",\"ol\",\"ol-0\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Stand one layer outside your front line, not three layers behind it.\"}],\" If you are too deep on the flank, your team cannot reach the target you displace. If you are hugging your marksman, you are playing a worse peel hero. Sit at the angle where one Jab reaches the fight and one sidestep returns you to cover.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Hit burned mobility, not full mobility.\"}],\" Paquito destroys heroes that already used dash, Flicker, or Purify. He is much less convincing against carries holding every answer. Wait for the panic button, then spend enhanced Jab or enhanced ult. If nobody has spent anything yet, keep threatening and do not donate your combo to a target with all cooldowns available.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Keep one movement decision for the end of the combo.\"}],\" A good Paquito sequence does not spend every tool on entry. If Jab gets you in, your ultimate or passive speed needs to get you out or deeper to the real kill. If ult is the entry, save Jab for the correction. Ending a combo with no exit plan is how this hero throws shutdown gold.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"If your support is Mathilda or Angela, you can take a greedier backline angle because the first layer of punishment is not yours to tank alone. If your team is running a slower support or no real follow-up, play shorter. Knock someone into your team, force the spell, then leave. Paquito does not need every fight to end with him standing on the corpse.\"}],\"\\n\",[\"$\",\"h2\",\"h2-1\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Items That Are Fixed And Items That Depend On The Lobby\"]}],\"\\n\",[\"$\",\"p\",\"p-2\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The core is simple: boots for the lane, Hunter Strike, and Queen's Wings. Everything after that should answer the specific way the enemy wants you to fail.\"}],\"\\n\",[\"$\",\"p\",\"p-3\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[\"$La7\",\" Warrior Boots are correct into physical side-lane trading and marksman-heavy damage because the passive Physical Defense stacks while you are getting hit. Tough Boots are better when the problem is chain control, magic poke, or one mage engage that must not pin you in place.\"]}],\"\\n\",\"$La8\",\"\\n\",\"$La9\",\"\\n\",\"$Laa\",\"\\n\",\"$Lab\",\"\\n\",\"$Lac\",\"\\n\",\"$Lad\",\"\\n\",\"$Lae\",\"\\n\",\"$Laf\",\"\\n\",\"$Lb0\",\"\\n\",\"$Lb1\",\"\\n\",\"$Lb2\",\"\\n\",\"$Lb3\",\"\\n\",\"$Lb4\",\"\\n\",\"$Lb5\",\"\\n\",\"$Lb6\",\"\\n\",\"$Lb7\",\"\\n\",\"$Lb8\"]\n8f:[\"$\",\"$Lb9\",null,{\"heroName\":\"Paquito\"}]\n"])</script><script>self.__next_f.push([1,"90:[\"$\",\"$L6b\",\"khufra\",{\"href\":\"/heroes/khufra\",\"className\":\"group block\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative bg-surface-4 border border-mlbb-gold/20 overflow-hidden card-hover hover:border-mlbb-gold/50\",\"style\":{\"boxShadow\":\"0 2px 8px rgba(0,0,0,0.3)\"},\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 p-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative w-14 h-14 rounded-full overflow-hidden flex-shrink-0 bg-surface-3\",\"children\":[\"$\",\"$L6c\",null,{\"src\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_2fe99f4001211d18b3d2b95d0d3dc395.png\",\"alt\":\"Khufra - Desert Tyrant\",\"unoptimized\":false,\"priority\":\"$undefined\",\"fetchPriority\":\"$undefined\",\"fill\":true,\"className\":\"object-cover group-hover:scale-110 transition-transform duration-300\",\"sizes\":\"56px\",\"placeholder\":\"blur\",\"blurDataURL\":\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTAwIiBoZWlnaHQ9IjEwMCIgeG1sbnM