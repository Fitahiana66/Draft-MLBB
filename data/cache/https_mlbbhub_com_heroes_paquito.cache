se}],\"coreItems\":[{\"slug\":\"hunter-strike\",\"name\":\"Hunter Strike\"},{\"slug\":\"war-axe\",\"name\":\"War Axe\"},{\"slug\":\"blade-of-the-heptaseas\",\"name\":\"Blade of the Heptaseas\"}],\"emblem\":{\"slug\":\"assassin\",\"name\":\"Assassin Emblem\",\"talents\":[{\"slug\":\"rupture\",\"name\":\"Rupture\",\"iconUrl\":\"/images/talents/rupture.png\",\"bucket\":\"standard\"},{\"slug\":\"seasoned-hunter\",\"name\":\"Seasoned Hunter\",\"iconUrl\":\"/images/talents/seasoned-hunter.png\",\"bucket\":\"standard\"},{\"slug\":\"lethal-ignition\",\"name\":\"Lethal Ignition\",\"iconUrl\":\"/images/talents/lethal-ignition.png\",\"bucket\":\"core\"}]},\"spell\":{\"slug\":\"retribution\",\"name\":\"Retribution\"},\"blessing\":{\"slug\":\"ice-retribution\",\"name\":\"Ice Retribution\"},\"flexItems\":[{\"item\":{\"slug\":\"immortality\",\"name\":\"Immortality\"},\"replace\":{\"slug\":\"queens-wings\",\"name\":\"Queen's Wings\"},\"trigger\":\"Use for the deciding Lord fight when one revive is worth more than mid-fight sustain.\"},{\"item\":{\"slug\":\"blade-of-despair\",\"name\":\"Blade of Despair\"},\"replace\":{\"slug\":\"queens-wings\",\"name\":\"Queen's Wings\"},\"trigger\":\"Use when your lanes are winning and Paquito can keep invading instead of absorbing the first counter-engage.\"},{\"item\":{\"slug\":\"brute-force-breastplate\",\"name\":\"Brute Force Breastplate\"},\"replace\":{\"slug\":\"blade-of-the-heptaseas\",\"name\":\"Blade of the Heptaseas\"},\"trigger\":\"Use when the enemy has enough control to stop your first jungle entry and you need stacking durability more than out-of-combat burst.\"},{\"item\":{\"slug\":\"sea-halberd\",\"name\":\"Sea Halberd\"},\"replace\":{\"slug\":\"malefic-roar\",\"name\":\"Malefic Roar\"},\"trigger\":\"Use when the enemy jungler or EXP laner relies on regen or shields during Turtle and Lord contests.\"}],\"notes\":\"Jungle setup for tempo drafts that want Paquito to fight early river skirmishes. Ice Retribution helps him stay attache