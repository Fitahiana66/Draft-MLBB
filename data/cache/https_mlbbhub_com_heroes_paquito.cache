5 flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right-left h-3.5 w-3.5 text-text-accent" aria-hidden="true"><path d="m16 3 4 4-4 4"></path><path d="M20 7H4"></path><path d="m8 21-4-4 4-4"></path><path d="M4 17h16"></path></svg><p class="font-heading text-[10.5px] font-bold uppercase tracking-[0.22em] text-text-accent">Situational Swaps</p></div><ul class="space-y-2"><li class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-[12.5px] leading-relaxed text-mlbb-text-secondary"><a class="font-heading font-bold uppercase tracking-wide text-mlbb-text transition-colors hover:text-mlbb-gold-bright" href="/items/immortality">Immortality</a><span class="inline-flex items-baseline gap-1.5 text-[11px] uppercase tracking-wide text-mlbb-text-secondary/80"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right relative top-[1px] h-3 w-3 text-text-accent/65" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><span class="text-mlbb-text-secondary/65">over</span><a class="font-semibold text-text-accent transition-colors hover:text-mlbb-gold-bright" href="/items/queens-wings">Queen&#x27;s Wings</a></span><span class="basis-full text-[12.5px] text-mlbb-text-secondary/90 sm:basis-auto sm:before:mx-1 sm:before:text-mlbb-text-secondary/50 sm:before:content-[&#x27;•&#x27;]">Use for the deciding Lord fight when one revive is worth more than mid-fight sustain.</span></li><li class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-[12.5px] leading-relaxed text-mlbb-text-secondary"><a class="font-heading font-bold uppercase tracking-wide text-mlbb-text transition-colors hover:text-mlbb-gold-bright" href="/items/blade-of-despair">Blade of Despair</a><span class="inline-flex items-baseline gap-1.5 text-[11px] uppercase tracking-wide text-mlbb-text-secondary/80"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right relative top-[1px] h-3 w-3 text-text-accent/65" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><span class="text-mlbb-text-secondary/65">over</span><a class="font-semibold text-text-accent transition-colors hover:text-mlbb-gold-bright" href="/items/queens-wings">Queen&#x27;s Wings</a></span><span class="basis-full text-[12.5px] text-mlbb-text-secondary/90 sm:basis-auto sm:before:mx-1 sm:before:text-mlbb-text-secondary/50 sm:before:content-[&#x27;•&#x27;]">Use when your lanes are winning and Paquito can keep invading instead of absorbing the first counter-engage.</span></li><li class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-[12.5px] leading-relaxed text-mlbb-text-secondary"><a class="font-heading font-bold uppercase tracking-wide text-mlbb-text transition-colors hover:text-mlbb-gold-bright" href="/items/brute-force-breastplate">Brute Force Breastplate</a><span class="inline-flex items-baseline gap-1.5 text-[11px] uppercase tracking-wide text-mlbb-text-secondary/80"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right relative top-[1px] h-3 w-3 text-text-accent/65" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><span class="text-mlbb-text-secondary/65">over</span><a class="font-semibold text-text-accent transition-colors hover:text-mlbb-gold-bright" href="/items/blade-of-the-heptaseas">Blade of the Heptaseas</a></span><span class="basis-full text-[12.5px] text-mlbb-text-secondary/90 sm:basis-auto sm:before:mx-1 sm:before:text-mlbb-text-secondary/50 sm:before:content-[&#x27;•&#x27;]">Use when the enemy has enough control to stop your first jungle entry and you need stacking durability more than out-of-combat burst.</span></li><li class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-[12.5px] leading-relaxed text-mlbb-text-secondary"><a class="font-heading font-bold uppercase tracking-wide text-mlbb-text transition-colors hover:text-mlbb-gold-bright" href="/items/sea-halberd">Sea Halberd</a><span class="inline-flex items-baseline gap-1.5 text-[11px] uppercase tracking-wide text-mlbb-text-secondary/80"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right relative top-[1px] h-3 w-3 text-text-accent/65" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><span class="text-mlbb-text-secondary/65">over</span><a class="font-semibold text-text-accent transition-colors hover:text-mlbb-gold-bright" href="/items/malefic-roar">Malefic Roar</a></span><span class="basis-full text-[12.5px] text-mlbb-text-secondary/90 sm:basis-auto sm:before:mx-1 sm:before:text-mlbb-text-secondary/50 sm:before:content-[&#x27;•&#x27;]">Use when the enemy jungler or EXP laner relies on regen or shields during Turtle and Lord contests.</span></li></ul></div></div></article></section></div><div id="tabpanel-skins" role="tabpanel" aria-labelledby="tab-skins" hidden=""></div><div id="tabpanel-lore" role="tabpanel" aria-labelledby="tab-lore" hidden=""></div><div id="tabpanel-stats" role="tabpanel" aria-labelledby="tab-stats" tabindex="0" hidden=""><div class="mt-6 md:mt-8"><section id="rank-stats" aria-labelledby="rank-stats-heading" class="relative bg-surface-2/85 backdrop-blur-sm border border-mlbb-gold/20 overflow-hidden" style="box-shadow:0 1px 0 rgba(255,255,255,0.03) inset, 0 18px 38