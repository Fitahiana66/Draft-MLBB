ne absolute -left-10 -bottom-10 h-32 w-32 rounded-full blur-3xl" aria-hidden="true" style="background-color:#00AAFF22"></div><div class="relative flex min-w-0 items-center gap-3"><div class="relative h-12 w-12 shrink-0 overflow-hidden rounded-full" style="border:2px solid #00AAFF80;box-shadow:0 0 18px #00AAFF55"><img alt="Flicker" loading="lazy" width="48" height="48" decoding="async" data-nimg="1" class="h-full w-full object-cover" style="color:transparent" src="/images/spells/flicker.png"/></div><div class="min-w-0 flex-1"><p class="flex items-center gap-1 font-heading text-[10px] font-bold uppercase tracking-[0.22em]" style="color:#00AAFF"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-zap h-2.5 w-2.5" aria-hidden="true"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"></path></svg>Battle Spell</p><p class="mt-0.5 truncate font-heading text-base font-bold uppercase tracking-wide text-mlbb-text sm:text-lg xl:text-base">Flicker</p></div></div></div></div><div class="relative grid grid-cols-2 gap-px overflow-hidden border border-mlbb-gold/18 bg-surface-1/45 sm:grid-cols-4 lg:col-start-1 lg:row-start-2 lg:self-start" style="box-shadow:inset 0 1px 0 rgba(240,208,96,0.08)"><div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-mlbb-gold-bright/50 to-transparent" aria-hidden="true"></div><div class="relative min-w-0 bg-surface-2/85 px-3 py-2 sm:px-4 sm:py-3" title="Hunter Strike, War Axe, Malefic Roar"><p class="truncate font-heading text-[9.5px] font-bold uppercase tracking-[0.2em] text-mlbb-text-secondary/85">Physical Attack</p><p class="mt-1 font-heading text-[18px] font-bold leading-tight tracking-tight text-mlbb-text sm:text-[22px]"><span class="text-mlbb-gold-bright">+175</span></p></div><div class="relative min-w-0 bg-surface-2/85 px-3 py-2 sm:px-4 sm:py-3" title="Queen&#x27;s Wings"><p class="truncate font-heading text-[9.5px] font-bold uppercase tracking-[0.2em] text-mlbb-text-secondary/85">Adaptive Attack</p><p class="mt-1 font-heading text-[18px] font-bold leading-tight tracking-tight text-mlbb-text sm:text-[22px]"><span class="text-mlbb-gold-bright">+40</span></p></div><div class="relative min-w-0 bg-surface-2/85 px-3 py-2 sm:px-4 sm:py-3" title="Hunter Strike"><p class="truncate font-heading text-[9.5px] font-bold uppercase tracking-[0.2em] text-mlbb-text-secondary/85">Physical Penetration</p><p class="mt-1 font-heading text-[18px] font-bold leading-tight tracking-tight text-mlbb-text sm:text-[22px]"><span class="text-mlbb-gold-bright">+15</span></p></div><div class="relative min-w-0 bg-surface-2/85 px-3 py-2 sm:px-4 sm:py-3" title="War Axe, Queen&#x27;s Wings"><p class="truncate font-heading text-[9.5px] font-bold uppercase tracking-[0.2em] text-mlbb-text-secondary/85">Spell Vamp</p><p class="mt-1 font-heading text-[18px] font-bold leading-tight tracking-tight text-mlbb-text sm:text-[22px]"><span class="text-mlbb-gold-bright">+18%</span></p></div></div></div><div class="relative mt-4 overflow-hidden border border-mlbb-gold/18 bg-gradient-to-br from-surface-3/75 to-surface-2/85 px-4 py-3.5"><div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-mlbb-gold/40 to-transparent" aria-hidden="true"></div><div class="mb-2.5 flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right-left h-3.5 w-3.5 text-text-accent" aria-hidden="true"><path d="m16 3 4 4-4 4"></path><path d="M20 7H4"></path><path d="m8 21-4-4 4-4"></path><path d="M4 17h16"></path></svg><p class="font-heading text-[10.5px] font-bold uppercase tracking-[0.22em] text-text-accent">Situational Swaps</p></div><ul class="space-y-2"><li class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-[12.5px] leading-relaxed text-mlbb-text-secondary"><a class="font-heading font-bold uppercase tracking-wide text-mlbb-text transition-colors hover:text-mlbb-gold-bright" href="/items/warrior-boots">Warrior Boots</a><span class="inline-flex items-baseline gap-1.5 text-[11px] uppercase tracking-wide text-mlbb-text-secondary/80"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right relative top-[1px] h-3 w-3 text-text-accent/65" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><span class="text-mlbb-text-secondary/65">over</span><a class="font-semibold text-text-accent transition-colors hover:text-mlbb-gold-bright" href="/items/tough-boots">Tough Boots</a></span><span class="basis-full text-[12.5px] text-mlbb-text-secondary/90 sm:basis-auto sm:before:mx-1 sm:before:text-mlbb-text-secondary/50 sm:before:content-[&#x27;•&#x27;]">Use against physical EXP lanes with light crowd control where Valor stacks decide the first two waves.</span></li><li class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-[12.5px] leading-relaxed text-mlbb-text-secondary"><a class="font-heading font-bold uppercase tracking-wide text-mlbb-text transition-colors hover:text-mlbb-gold-bright" href="/items/brute-force-breastplate">Brute Force Breastplate</a><span class="inline-flex items-baseline gap-1.5 text-[11px] uppercase tracking-wide text-mlbb-text-secondary/80"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right relative top-[1px] h-3 w-3 text-text-accent/65" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><span class="text-mlbb-text-secondary/65">over</span><a class="font-semibold text-text-accent transition-colors hover:text-mlbb-gold-bright" href="/items/malefic-roar">Malefic Roar</a></span><span class="basis-full text-[12.5px] text-mlbb-text-secondary/90 sm:basis-auto sm:before:mx-1 sm:before:text-mlbb-text-secondary/50 sm:before:content-[&#x27;•&#x27;]">Use when you are starting fights often and need stacking movement speed, control-duration reduction, and durability before armor penetration.</span></li><li class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-[12.5px] leading-relaxed text-mlbb-text-secondary"><a class="font-heading font-bold uppercase tracking-wide text-mlbb-text transition-colors hover:text-mlbb-gold-bright" href="/items/sea-halberd">Sea Halberd</a><span class="inline-flex items-baseline gap-1.5 text-[11px] uppercase tracking-wide text-mlbb-text-secondary/80"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right relative top-[1px] h-3 w-3 text-text-accent/65" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><span class="text-mlbb-text-secondary/65">over</span><a class="font-semibold text-text-accent transition-colors hover:text-mlbb-gold-bright" href="/items/malefic-roar">Malefic Roar</a></span><span class="basis-full text-[12.5px] text-mlbb-text-secondary/90 sm:basis-auto sm:before:mx-1 sm:before:text-mlbb-text-secondary/50 sm:before:content-[&#x27;•&#x27;]">Use against shield or regen-heavy front lines before they stack enough Physical Defense to make Malefic Roar mandatory.</span></li><li class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-[12.5px] leading-relaxed text-mlbb-text-secondary"><a class="font-heading font-bold uppercase tracking-wide text-mlbb-text transition-colors hover:text-mlbb-gold-bright" href="/items/oracle">Oracle</a><span class="inline-flex items-baseline gap-1.5 text-[11px] uppercase tracking-wide text-mlbb-text-secondary/80"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right relative top-[1px] h-3 w-3 text-text-accent/65" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><span class="text-mlbb-text-secondary/65">over</span><a class="font-semibold text-text-accent transition-colors hover:text-mlbb-gold-bright" href="/items/immortality">Immortality</a></span><span class="basis-full text-[12.5px] text-mlbb-text-secondary/90 sm:basis-auto sm:before:mx-1 sm:before:text-mlbb-text-secondary/50 sm:before:content-[&#x27;•&#x27;]">Use when repeated skirmishes matter more than one final revive and your stacked Heavy Left Punch shields decide the trade.</span></li></ul></div></div></article><article id="build-2" role="tabpanel" aria-labelledby="build-tab-2" hidden="" class="group/build relative overflow-hidden border border-mlbb-gold/22 bg-surface-2/92 scroll-mt-24" style="box-shadow:0 1px 0 rgba(255,255,255,0.04) inset, 0 30px 60px -36px rgba(0,0,0,0.95);opacity:0;transform:translateY(24px)"><div class="pointer-events-none absolute inset-0 opacity-[0.06] hex-pattern" aria-hidden="true"></div><div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-mlbb-gold-bright/80 to-transparent" aria-hidden="true"></div><div class="pointer-events-none absolute left-0 top-0 h-full w-[3px] bg-gradient-to-b from-mlbb-gold-bright/70 via-mlbb-gold/30 to-transparent" aria-hidden="true"></div><div class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full blur-3xl transition-opacity duration-500 group-hover/build:opacity-90" aria-hidden="true" style="background-color:#00AAFF1f"></div><span class="pointe