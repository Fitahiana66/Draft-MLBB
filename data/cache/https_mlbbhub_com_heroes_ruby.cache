sName\":\"absolute top-0 right-0 w-3 h-3 border-t border-r border-[#C8AA6E]/30\",\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"absolute bottom-0 left-0 w-3 h-3 border-b border-l border-[#C8AA6E]/30\",\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"absolute bottom-0 right-0 w-3 h-3 border-b border-r border-[#C8AA6E]/30\",\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"absolute -top-32 -right-24 w-72 h-72 rounded-full bg-[#C8AA6E]/[0.05] blur-3xl pointer-events-none\",\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"relative hero-article-body max-w-[860px] mx-auto\",\"children\":[[[[\"$\",\"h2\",\"h2-0\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"When Ruby actually fixes a draft\"]}],\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[\"Ruby is a rising EXP choice after patch 2.1.88 (\",[\"$\",\"$L40\",\"a-0\",{\"href\":\"/patch-notes\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"patch notes\"}],\"), which deliberately raised her damage threat while trimming the lifesteal she banks at full health. EXP lane still rewards the two things she has always done well, sustain and crowd control, but now she punishes the trades she wins instead of merely surviving them. What still does not suit her is being treated like a blind first-phase answer into every ranged poke lane on the board.\"]}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Pick Ruby when the enemy draft wants to walk into you. Melee-heavy fronts, dive junglers, and short-range carries give her the kind of fights she can control. She is also a clean answer when your team already has a real tank and needs a second engager who can peel after the first contact. In those games Ruby does two jobs at once: she slows the first entry with Be Good!, then punishes the second entry with the pull and stun chain from S2 into ult.\"}],\"\\n\",[\"$\",\"p\",\"p-2\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Pick her when your support or roamer can follow a grouped engage immediately. Pharsa, Cecilion, Estes, and Mathilda all turn her pull into something more than displacement. If your team has no follow-up damage and no one to stand in front of her, Ruby's control window becomes cosmetic and the pick loses half its value.\"}],\"\\n\",[\"$\",\"p\",\"p-3\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Avoid Ruby when the enemy can stop her approach before she reaches pull range. Valir is a problem because the lane becomes a patience test you do not control. Kaja turns every front-foot step into a suppression threat. Phoveus punishes the passive dash pattern that makes Ruby feel safe in normal matchups. Baxia and anti-heal heavy comps do not remove her from the game, but they do change it from a long-trade lane into a short-trade lane. If you still intend to brawl through that, you are picking the wrong hero.\"}],\"\\n\",\"$L7e\",\"\\n\",\"$L7f\",\"\\n\",\"$L80\",\"\\n\",\"$L81\",\"\\n\",\"$L82\",\"\\n\",\"$L83\",\"\\n\",\"$L84\",\"\\n\",\"$L85\",\"\\n\",\"$L86\",\"\\n\",\"$L87\",\"\\n\",\"$L88\",\"\\n\",\"$L89\",\"\\n\",\"$L8a\",\"\\n\",\"$L8b\",\"\\n\",\"$L8c\"],\"$L8d\",\"$L8e\"],\"$L8f\"]}]]}]]}]\n"])</script><script>self.__next_f.push([1,"a4:I[392015,[\"$7\",\"$8\",\"$9\",\"$a\",\"$b\",\"$2e\",\"$3e\",\"$3f\"],\"default\"]\nb5:I[131354,[\"$7\",\"$8\",\"$9\",\"$a\",\"$b\",\"$2e\",\"$3e\",\"$3f\"],\"default\"]\n6d:[\"$\",\"$L6a\",\"fredrinn