nres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_0bd96658e5b8ec578226ea1622bd7231.png&amp;w=3840&amp;output=webp&amp;q=75&amp;we 3840w" src="https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_0bd96658e5b8ec578226ea1622bd7231.png&amp;w=3840&amp;output=webp&amp;q=75&amp;we"/></div><div class="flex-1 min-w-0"><h4 class="font-heading font-bold text-text-primary group-hover:text-text-accent-bright transition-colors truncate">Argus</h4><div class="flex items-center gap-2 mt-0.5"><span class="text-[10px] font-heading uppercase tracking-wider px-1.5 py-0.5" style="background-color:#FF8C0020;color:#ffaf4d;border:1px solid #FF8C0040">Fighter</span><div class="inline-flex items-center justify-center font-heading font-bold bg-gradient-to-br from-[#FFD700] to-[#FFA500] text-[#1a1600] shadow-[0_0_12px_rgba(255,215,0,0.4)] w-6 h-6 text-xs animate-tier-pop">S</div></div><p class="text-[10px] text-text-muted mt-1 truncate">EXP Lane • 56.0% WR</p></div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right w-4 h-4 text-text-muted group-hover:text-text-accent transition-colors flex-shrink-0" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></div><div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none" style="background:radial-gradient(ellipse at center, #FF8C0012 0%, transparent 70%)"></div><div class="absolute top-0 left-0 w-3 h-3 border-t border-l border-mlbb-gold/0 group-hover:border-mlbb-gold/50 transition-all duration-300 pointer-events-none"></div><div class="absolute bottom-0 right-0 w-3 h-3 border-b border-r border-mlbb-gold/0 group-hover:border-mlbb-gold/50 transition-all duration-300 pointer-events-none"></div><div class="absolute bottom-0 left-0 right-0 h-[1px] opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none" style="background:linear-gradient(90deg, transparent, #FF8C00, transparent)"></div></div></a></div></div></div><div class="mt-6 text-center"><a class="inline-flex items-center gap-2 text-sm text-text-accent hover:text-text-accent-bright transition-colors font-heading uppercase tracking-wider" href="/heroes">Browse All Heroes<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right w-4 h-4" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></a></div></section></div></section></div><section class="content-lazy relative border-t border-border-subtle py-12 md:py-16" aria-labelledby="hero-faq-heading"><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","@id":"https://mlbbhub.com/heroes/ruby#faq","url":"https://mlbbhub.com/heroes/ruby","inLanguage":"en","mainEntity":[{"@type":"Question","name":"What is the best Ruby build in 2026?","acceptedAnswer":{"@type":"Answer","text":"Ruby's strongest build centers on War Axe, Queen's Wings and Oracle as core items, paired with the Fighter Emblem and the Flicker battle spell. The full six-item order, flex options for different matchups, and talent setup are in the build section on this page."}},{"@type":"Question","name":"What is the best emblem for Ruby?","acceptedAnswer":{"@type":"Answer","text":"The recommended emblem for Ruby is Fighter Emblem, set up with the Firmness, Festival of Blood and Brave Smite talents. The full emblem and talent breakdown, including alternatives for specific matchups, is in the build section."}},{"@type":"Question","name":"What lane and role is Ruby in Mobile Legends?","acceptedAnswer":{"@type":"Answer","text":"Ruby is a Fighter hero, usually played in the EXP Lane. Role and lane decide which builds, emblems, and counters matter most, all of which are covered on this page."}},{"@type":"Question","name":"Who counters Ruby?","acceptedAnswer":{"@type":"Answer","text":"Ruby is countered most by X.Borg, Phoveus and Terizla, the heroes with the biggest measured edge against Ruby in ranked play. The full counter list, the heroes Ruby beats, and game-phase tips are in the counters section."}},{"@type":"Question","name":"Is Ruby hard to play?","acceptedAnswer":{"@type":"Answer","text":"Ruby is rated Medium difficulty in Mobile Legends. Ruby rewards some practice with positioning and combos but stays approachable for most ranked players."}},{"@type":"Question","name":"What is Ruby's win rate this patch?","acceptedAnswer":{"@type":"Answer","text":"Ruby currently holds a 49.6% win rate, a 0.3% pick rate, and a 0.3% ban rate in ranked Mobile Legends, refreshed daily from match data. Win and pick rates broken down by rank, from Epic to Mythical Glory, are in the rank stats section."}}]}</script><div class="container-mlbb relative z-10"><div class="mb-6 flex items-center gap-3"><span class="flex h-9 w-9 items-center justify-center border border-mlbb-gold/30 bg-mlbb-gold/10 text-text-accent" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-question-mark h-4 w-4" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><path d="M12 17h.01"></path></svg></span><h2 id="hero-faq-heading" class="font-heading text-xl font-bold uppercase tracking-[0.04em] text-text-accent-bright md:text-2xl">Ruby FAQ</h2></div><p class="mb-6 max-w-[80ch] text-sm leading-relaxed text-text-muted md:text-[15px]">Ruby is a Fighter hero played in the EXP Lane.<!-- --> Its strongest build centers on War Axe, Queen&#x27;s Wings, Oracle; open the <a class="font-semibold text-text-accent underline decoration-text-accent/30 underline-offset-2 transition-colors hover:text-text-accent-bright" href="/build-simulator?hero=ruby&amp;items=tough-boots%2Cwar-axe%2Cqueens-wings%2Coracle%2Cdominance-ice%2Cimmortality&amp;spell=flicker&amp;emblem=fighter&amp;talents=firmness%2Cfestival-of-blood%2Cbrave-smite&amp;flex=warrior-boots.tough-boots%2Cathenas-shield.dominance-ice%2Cantique-cuirass.dominance-ice%2Cbrute-force-breastplate.dominance-ice">Ruby build simulator</a> for the full item order and final stats, or compare every available loadout on the <a class="font-semibold text-text-accent underline decoration-text-accent/30 underline-offset-2 transition-colors hover:text-text-accent-bright" href="/builds/ruby">Ruby builds page</a>. <!-- -->See every hero that beats it on the <a class="font-semibold text-text-accent underline decoration-text-accent/30 underline-offset-2 transition-colors hover:text-text-accent-bright" href="/counter/ruby">Ruby counter page</a>.</p><div class="space-y-3"><div class="glass-card overflow-hidden"><h3 class="text-sm md:text-base font-heading font-semibold"><button id="_R_falubsnnauivbH1_" type="button" aria-expanded="true" aria-controls="_R_falubsnnauivb_" class="w-full flex items-center justify-between gap-3 p-5 text-left cursor-pointer text-[#E8E6E3] hover:text-[#C8AA6E] transition-colors"><span>What is the best Ruby build in 2026?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down w-4 h-4 flex-shrink-0 transition-transform duration-200 rotate-180 text-[#C8AA6E]" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></h3><div id="_R_falubsnnauivb_" role="region" aria-labelledby="_R_falubsnnauivbH1_" class="grid transition-[grid-template-rows] duration-200 grid-rows-[1fr]"><div class="overflow-hidden"><div class="px-5 pb-5 -mt-1"><p class="text-sm text-[#9BA0B4] leading-relaxed">Ruby&#x27;s strongest build centers on War Axe, Queen&#x27;s Wings and Oracle as core items, paired with the Fighter Emblem and the Flicker battle spell. The full six-item order, flex options for different matchups, and talent setup are in the build section on this page.</p></div></div></div></div><div class="glass-card overflow-hidden"><h3 class="text-sm md:text-base font-heading font-semibold"><button id="_R_nalubsnnauivbH1_" type="button" aria-expanded="false" aria-controls="_R_nalubsnnauivb_" class="w-full flex items-center justify-between gap-3 p-5 text-left cursor-pointer text-[#E8E6E3] hover:text-[#C8AA6E] transition-colors"><span>What is the best emblem for Ruby?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down w-4 h-4 flex-shrink-0 transition-transform duration-200 text-[#9BA0B4]" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></h3><div id="_R_nalubsnnauivb_" role="region" aria-labelledby="_R_nalubsnnauivbH1_" inert="" class="grid transition-[grid-template-rows] duration-200 grid-rows-[0fr]"><div class="overflow-hidden"><div class="px-5 pb-5 -mt-1"><p class="text-sm text-[#9BA0B4] leading-relaxed">The recommended emblem for Ruby is Fighter Emblem, set up with the Firmness, Festival of Blood and Brave Smite talents. The full emblem and talent breakdown, including alternatives for specific matchups, is in the build section.</p></div></div></div></div><div class="glass-card overflow-hidden"><h3 class="text-sm md:text-base font-heading font-semibold"><button id="_R_valubsnnauivbH1_" type="button" aria-expanded="false" aria-controls="_R_valubsnnauivb_" class="w-full flex items-center justify-between gap-3 p-5 text-left cursor-pointer text-[#E8E6E3] hover:text-[#C8AA6E] transition-colors"><span>What lane and role is Ruby in Mobile Legends?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down w-4 h-4 flex-shrink-0 transition-transform duration-200 text-[#9BA0B4]" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></h3><div id="_R_valubsnnauivb_" role="region" aria-labelledby="_R_valubsnnauivbH1_" inert="" class="grid transition-[grid-template-rows] duration-200 grid-rows-[0fr]"><div class="overflow-hidden"><div class="px-5 pb-5 -mt-1"><p class="text-sm text-[#9BA0B4] leading-relaxed">Ruby is a Fighter hero, usually played in the EXP Lane. Role and lane decide which builds, emblems, and counters matter most, all of which are covered on this page.</p></div></div></div></div><div class="glass-card overflow-hidden"><h3 class="text-sm md:text-base font-heading font-semibold"><button id="_R_17alubsnnauivbH1_" type="button" aria-expanded="false" aria-controls="_R_17alubsnnauivb_" class="w-full flex items-center justify-between gap-3 p-5 text-left cursor-pointer text-[#E8E6E3] hover:text-[#C8AA6E] transition-colors"><span>Who counters Ruby?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down w-4 h-4 flex-shrink-0 transition-transform duration-200 text-[#9BA0B4]" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></h3><div id="_R_17alubsnnauivb_" role="region" aria-labelledby="_R_17alubsnnauivbH1_" inert="" class="grid transition-[grid-template-rows] duration-200 grid-rows-[0fr]"><div class="overflow-hidden"><div class="px-5 pb-5 -mt-1"><p class="text-sm text-[#9BA0B4] leading-relaxed">Ruby is countered most by X.Borg, Phoveus and Terizla, the heroes with the biggest measured edge against Ruby in ranked play. The full counter list, the heroes Ruby beats, and game-phase tips are in the counters section.</p></div></div></div></div><div class="glass-card overflow-hidden"><h3 class="text-sm md:text-base font-heading font-semibold"><button id="_R_1falubsnnauivbH1_" type="button" aria-expanded="false" aria-controls="_R_1falubsnnauivb_" class="w-full flex items-center justify-between gap-3 p-5 text-left cursor-pointer text-[#E8E6E3] hover:text-[#C8AA6E] transition-colors"><span>Is Ruby hard to play?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down w-4 h-4 flex-shrink-0 transition-transform duration-200 text-[#9BA0B4]" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></h3><div id="_R_1falubsnnauivb_" role="region" aria-labelledby="_R_1falubsnnauivbH1_" inert="" class="grid transition-[grid-template-rows] duration-200 grid-rows-[0fr]"><div class="overflow-hidden"><div class="px-5 pb-5 -mt-1"><p class="text-sm text-[#9BA0B4] leading-relaxed">Ruby is rated Medium difficulty in Mobile Legends. Ruby rewards some practice with positioning and combos but stays approachable for most ranked players.</p></div></div></div></div><div class="glass-card overflow-hidden"><h3 class="text-sm md:text-base font-heading font-semibold"><button id="_R_1nalubsnnauivbH1_" type="button" aria-expanded="false" aria-controls="_R_1nalubsnnauivb_" class="w-full flex items-center justify-between gap-3 p-5 text-left cursor-pointer text-[#E8E6E3] hover:text-[#C8AA6E] transition-colors"><span>What is Ruby&#x27;s win rate this patch?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down w-4 h-4 flex-shrink-0 transition-transform duration-200 text-[#9BA0B4]" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></h3><div id="_R_1nalubsnnauivb_" role="region" aria-labelledby="_R_1nalubsnnauivbH1_" inert="" class="grid transition-[grid-template-rows] duration-200 grid-rows-[0fr]"><div class="overflow-hidden"><div class="px-5 pb-5 -mt-1"><p class="text-sm text-[#9BA0B4] leading-relaxed">Ruby currently holds a 49.6% win rate, a 0.3% pick rate, and a 0.3% ban rate in ranked Mobile Legends, refreshed daily from match data. Win and pick rates broken down by rank, from Epic to Mythical Glory, are in the rank stats section.</p></div></div></div></div></div></div></section><!--$--><!--/$--></div></main><footer class="content-lazy relative bg-[#000000] border-t border-[#C8AA6E]/20 overflow-hidden"><div class="absolute inset-0 hex-pattern opacity-40 pointer-events-none"></div><div class="absolute inset-0 pointer-events-none" style="background:radial-gradient(ellipse 80% 60% at 50% 100%, rgba(200,170,110,0.03), transparent)"></div><div class="absolute top-0 left-0 right-0 h-[2px] z-10 overflow-hidden energy-line" aria-hidden="true"></div><div class="relative z-10 pt-4 pb-4"><div class="container-mlbb"><div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-x-12 gap-y-8"><div class="col-span-1 sm:col-span-2"><div class="flex items-center gap-2 mb-4"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield w-7 h-7 text-[#C8AA6E]" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path></svg><span class="font-heading text-xl font-bold tracking-wider text-gradient-gold">MLBB<span class="text-gradient-blue">Hub</span></span></div><p class="mb-6 max-w-sm border-l-2 border-mlbb-gold-bright/70 pl-3 font-heading text-base font-semibold uppercase leading-snug tracking-[0.1em] text-text-accent-bright">Win with data, not drama.</p><div cla