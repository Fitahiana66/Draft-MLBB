 inline-flex h-8 items-center justify-center gap-1.5 border border-mlbb-gold/20 bg-surface-2/45 px-2.5 font-heading text-[10px] font-bold uppercase tracking-wider text-text-accent transition-colors hover:border-mlbb-gold-bright/45 hover:text-text-accent-bright lg:col-start-4 lg:row-start-1" href="/counter/ruby"><span>View all</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a><div class="col-span-3 grid gap-2 text-center grid-cols-3 sm:flex sm:items-center sm:justify-around lg:col-span-1 lg:col-start-3 lg:row-start-1"><div><p class="text-lg font-heading font-bold text-mlbb-green">5</p><p class="text-[9px] text-text-muted uppercase tracking-wider">Counters</p></div><div><p class="text-lg font-heading font-bold text-text-accent">5</p><p class="text-[9px] text-text-muted uppercase tracking-wider">Weak To</p></div><div><p class="text-lg font-heading font-bold text-text-accent-bright truncate">Balanced</p><p class="text-[9px] text-text-muted uppercase tracking-wider">Peak Phase</p></div></div></div></div><div class="grid gap-6 lg:grid-cols-2 lg:items-start lg:gap-6"><section><div class="mb-4"><div class="flex items-center gap-3 mb-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield w-5 h-5 text-mlbb-green" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path></svg><h2 class="text-lg md:text-xl font-heading font-bold text-text-primary">How to Counter<!-- --> <span style="color:#ff4444">Ruby</span></h2></div><p class="text-xs text-text-muted max-w-2xl">These heroes have the biggest measured edge against Ruby in ranked matches. Pick any of them for a statistical advantage in draft.</p></div><div class="space-y-3"><div class="group relative bg-surface-3 border border-mlbb-gold/15 hover:border-mlbb-green/30 transition-all duration-300" style="opacity:0;transform:translateY(12px)"><div class="flex items-center gap-3 p-3 sm:gap-4 sm:p-4"><div class="flex-shrink-0 w-7 sm:w-8 text-center"><span class="text-base sm:text-lg font-heading font-bold text-text-accent">#<!-- -->1</span></div><a class="flex-shrink-0" href="/heroes/x-borg"><div class="relative overflow-hidden flex-shrink-0 rounded-full" style="width:48px;height:48px;min-width:48px;background-color:#FF8C0012"><img alt="X.Borg hero icon" loading="lazy" width="48" height="48" decoding="async" data-nimg="1" class="h-full w-full object-cover" style="color:transparent" srcSet="https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_efe9c7ed8d8f84f1bb0f88a3e08de5fc.png&amp;w=48&amp;output=webp&amp;q=75&amp;we 1x, https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_efe9c7ed8d8f84f1bb0f88a3e08de5fc.png&amp;w=96&amp;output=webp&amp;q=75&amp;we 2x" src="https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_efe9c7ed8d8f84f1bb0f88a3e08de5fc.png&amp;w=96&amp;output=webp&amp;q=75&amp;we"/></div></a><div class="min-w-0 flex-1"><div class="flex items-center gap-2 sm:gap-3 flex-wrap"><a class="min-w-0 max-w-full truncate font-heading font-bold text-base sm:text-lg text-text-primary hover:text-text-accent-bright transition-colors" href="/heroes/x-borg">X.Borg</a><div class="inline-flex items-center justify-center font-heading font-bold bg-gradient-to-br from-[#00AAFF] to-[#0077CC] text-[#00111a] shadow-[0_0_12px_rgba(0,170,255,0.3)] w-6 h-6 text-xs animate-tier-pop">B</div><div class="gap-1.5 hidden sm:flex"><span class="text-[10px] px-1.5 py-0.5" style="background-color:#FF8C0020;color:#ffaf4d">Fighter</span></div></div><p class="text-xs text-text-muted mt-1 line-clamp-2">X.Borg&#x27;s durability and kit give them a strong matchup advantage against Ruby throughout the game.</p></div><div class="flex-shrink-0 text-right"><p class="flex items-center justify-end gap-1 text-lg sm:text-xl font-heading font-bold" style="color:#44ff88"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trending-up w-3.5 h-3.5" aria-hidden="true"><path d="M16 7h6v6"></path><path d="m22 7-8.5 8.5-5-5L2 17"></path></svg>+<!-- -->3.0</p><p class="text-[9px] text-text-muted uppercase hidden sm:block">win rate delta</p></div></div><div class="absolute top-0 left-0 w-3 h-3 border-t border-l border-mlbb-gold/20 pointer-events-none"></div><div class="absolute bottom-0 right-0 w-3 h-3 border-b border-r border-mlbb-gold/20 pointer-events-none"></div></div><div class="group relative bg-surface-3 border border-mlbb-gold/15 hover:border-mlbb-green/30 transition-all duration-300" style="opacity:0;transform:translateY(12px)"><div class="flex items-center gap-3 p-3 sm:gap-4 sm:p-4"><div class="flex-shrink-0 w-7 sm:w-8 text-center"><span class="text-base sm:text-lg font-heading font-bold text-text-accent">#<!-- -->2</span></div><a class="flex-shrink-0" href="/heroes/phoveus"><div class="relative overflow-hidden flex-shrink-0 rounded-full" style="width:48px;height:48px;min-width:48px;background-color:#FF8C0012"><img alt="Phoveus hero icon" loading="lazy" width="48" height="48" decoding="async" data-nimg="1" class="h-full w-full object-cover" style="color:transparent" srcSet="https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%