\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Layla\",\"delta\":\"+1.30%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"3.28\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"3.70\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Epic\"}}]]}]]}],[\"$\",\"article\",\"legend\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #4dc9f6, #4dc9f633)\",\"boxShadow\":\"0 0 12px -2px #4dc9f680\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#4dc9f6\",\"background\":\"#4dc9f61a\",\"border\":\"1px solid #4dc9f640\"},\"children\":\"Legend\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Layla\",\"rank\":\"Legend\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=legend\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Legend\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Legend\",\"name\":\"Layla\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"50.14\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Layla\",\"delta\":\"+0.43%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"2.41\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"1.97\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Legend\"}}]]}]]}],[\"$\",\"article\",\"mythic\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #f59e0b, #f59e0b33)\",\"boxShadow\":\"0 0 12px -2px #f59e0b80\"}}],\"$La2\",\"$La3\"]}],\"$La4\",\"$La5\"]}]\n7e:[\"$\",\"h2\",\"h2-1\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The one thing that makes Layla work\"]}]\n7f:[\"$\",\"p\",\"p-5\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Layla is not a normal marksman. She is a distance tax.\"}]\n80:[\"$\",\"p\",\"p-6\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Her passive rewards range, so every good Layla trade starts with the enemy paying HP just to enter the conversation. Skill 1 is the button that makes that geometry possible. Once it lands, she gets extra basic-attack range and a short burst of movement speed, which means the next decision is almost always hers, not the other player's. Skill 2 matters because it punishes enemies who stayed in the line too long. The ultimate matters because every rank widens the part of the map where her basic attacks are legal.\"}]\n81:[\"$\",\"p\",\"p-7\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"That is the whole hero. The point is not flashy mechanics. The point is to start trades from a distance where the enemy has to spend movement just to answer once, then punish them while they are still walking.\"}]\n82:[\"$\",\"p\",\"p-8\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"This is why bad Layla games all look the same. The player opens with Skill 2 because it looks like the control spell, walks forward to make it count, and gives away the only advantage the hero actually owns. Good Layla games look calmer. Skill 1 lands first, the range appears, the enemy takes two or three bad steps, and suddenly the fight belongs to Layla's side of the screen.\"}]\n83:[\"$\",\"p\",\"p-9\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"If you remember one sentence, make it this: Layla does not win by chasing. She wins by making chasing her feel expensive.\"}]\n84:[\"$\",\"h2\",\"h2-2\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Laning: the first six minutes\"]}]\n85:[\"$\",\"p\",\"p-10\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Layla's lane is not about proving she can brawl. It is about reaching the first item window without giving the enemy jungle a clean angle.\"}]\n86:[\"$\",\"ol\",\"ol-0\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Take Skill 1 first and trade off its range, not its damage.\"}],\" Hit a front minion or the enemy hero, then use the temporary range to collect a basic-attack lead. If you walk up before Skill 1 connects, you are lane-checking yourself for no reason.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Keep the wave on your half unless both roam and jungle are shown.\"}],\" Layla wants extra ground behind her, not behind the enemy marksman. Thin the wave, last-hit cleanly, and only fast-push when you can account for the first rotation. A boring lane state is a winning lane state on this hero.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Save Flicker or Purify for the first forced collapse.\"}],\" Flicker is the default because Layla has no real escape. Purify only becomes better when the enemy draft is built around non-suppression crowd control you know will reach you. Either way, spending your spell for a greedy level-3 kill is how a playable lane turns into a repeated dive.\"]}],\"\\n\"]}]\n87:[\"$\",\"p\",\"p-11\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The lane sequence should stay disciplined. Skill 1 first, basics second, Skill 2 after the target is already stuck respecting your range. That order is the difference between kiting and volunteering.\"}]\n88:[\"$\",\"h2\",\"h2-3\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The crit window you are farming toward\"]}]\n89:[\"$\",\"p\",\"p-12\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[\"Layla's first real spike is \",[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Windtalker plus Berserker's Fury\"}],\", usually between minute 8 and minute 10 if the lane stayed even and you did not bleed early deaths.\"]}]\n8a:[\"$\",\"p\",\"p-13\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"That timing matters because the two items solve different problems at once. Windtalker smooths her movement, wave control, and attack rhythm. Berserker's Fury turns those longer-range hits into actual punishment instead of lane chip. One item makes her feel functional. Two items make the enemy think twice about every corridor, brush entrance, and turret defense.\"}]\n8b:[\"$\",\"p\",\"p-14\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"What changes after the spike is not just damage. It is her permission structure. Before it, Layla can poke and farm. After it, she can clear the wave, hold max spacing, and threaten turret pressure in the same sequence. Suddenly the enemy marksman has to choose between losing space and losing HP, and that is where Layla starts looking oppressive instead of fragile.\"}]\n8c:[\"$\",\"p\",\"p-15\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"This is also the most common throw point. Players feel the damage jump and start side-laning alone because the hero finally feels strong. That misses the point of the spike. Windtalker plus Berserker's Fury does not turn Layla into a duelist. It turns her into a siege problem. Group earlier, not later.\"}]\n8d:[\"$\",\"$La6\",null,{\"slot\":\"7246933188\",\"variant\":\"in-article\",\"className\":\"my-8\"}]\n8e:[[\"$\",\"h2\",\"h2-0\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Teamfight positioning and target priority\"]}],\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The wrong reflex on Layla is to think that more range means more freedom. It does not. It means more responsibility to hold the right line.\"}],\"\\n\",[\"$\",\"ol\",\"ol-0\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Stand one peel skill behind your frontline.\"}],\" If you are shoulder-to-shoulder with your tank, you eat the same engage. If you are a full screen behind, your damage starts after the fight is already lost. The sweet spot is close enough to punish entry and far enough that the first hard crowd control is not aimed at you.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Open the fight with Skill 1 whenever possible.\"}],\" That movement burst and extra range are what keep the first few autos safe. Skill 2 is stronger after somebody has already crossed into your lane of fire.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Hit the first reachable threat without walking forward.\"}],\" If an assassin or fighter has entered your side of the fight, that hero becomes the assignment. Layla loses when she tunnels on the backline fantasy and ignores the person already crossing her screen.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"There is one support-dependent exception. If your roamer is actually bodyguarding you through sieges, you can take one extra step to abuse choke points and turret angles. If your roamer is a hook or flank hero who keeps leaving your shoulder, back up earlier than the range indicator suggests.\"}],\"\\n\",[\"$\",\"p\",\"p-2\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Target priority is simple on paper and hard in live games: damage what is reachable, punish what crossed first, and never take the extra step that turns your range advantage into a coin flip.\"}],\"\\n\",[\"$\",\"h2\",\"h2-1\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Itemization: locked slots and the real flex calls\"]}],\"\\n\",[\"$\",\"p\",\"p-3\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Treat Layla's build as three locked slots and several conversations that depend on who is reaching her.\"}],\"\\n\",[\"$\",\"p\",\"p-4\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Swift Boots, Windtalker, and Berserker's Fury are the locked core.\"}],\" Swift Boots gives early attack speed and enough movement speed to keep her lane pattern from feeling anchored. Windtalker fixes her tempo and wave touch. Berserker's Fury is where the crit threat becomes real. If you delay that trio too long, Layla spends too much of the game pretending to be useful.\"]}],\"\\n\",\"$La7\",\"\\n\",\"$La8\",\"\\n\",\"$La9\",\"\\n\",\"$Laa\",\"\\n\",\"$Lab\",\"\\n\",\"$Lac\",\"\\n\",\"$Lad\",\"\\n\",\"$Lae\",\"\\n\",\"$Laf\",\"\\n\",\"$Lb0\",\"\\n\",\"$Lb1\",\"\\n\",\"$Lb2\",\"\\n\",\"$Lb3\",\"\\n\",\"$Lb4\",\"\\n\",\"$Lb5\",\"\\n\",\"$Lb6\",\"\\n\",\"$Lb7\",\"\\n\",\"$Lb8\",\"\\n\",\"$Lb9\"]\n8f:[\"$\",\"$Lba\",null,{\"heroName\":\"Layla\"}]\n"])</script><script>self.__next_f.push([1,"90:[\"$\",\"div\",null,{\"className\":\"relative bg-surface-4 border border-mlbb-gold/20 overflow-hidden card-hover hover:border-mlbb-gold/50\",\"style\":{\"boxShadow\":\"0 2px 8px rgba(0,0,0,0.3)\"},\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 p-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative w-14 h-14 rounded-full overflow-hidden flex-shrink-0 bg-surface-3\",\"children\":[\"$\",\"$L6b\",null,{\"src\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_117b5cdcc13232157075ce7b7f6177e9.png\",\"alt\":\"Sun - Monkey King\",\"unoptimized\":false,\"priority\":\"$undefined\",\"fetchPriority\":\"$undefined\",\"fill\":true,\"className\":\"object-cover group-hover:scale-110 transition-transform duration-300\",\"sizes\":\"56px\",\"placeholder\":\"blur\",\"blurDataURL\":\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTAwIiBoZWlnaHQ9IjEwMCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48cmVjdCB3aWR0aD0iMTAwIiBoZWlnaHQ9IjEwMCIgZmlsbD0iIzBkMTIyNSIvPjwvc3ZnPg==\"}]}],[\"$\",\"div\",null,{\"className\":\"flex-1 min-w-0\",\"children\":[[\"$\",\"h4\",null,{\"className\":\"font-heading font-bold text-text-primary group-hover:text-text-accent-bright transition-colors truncate\",\"children\":\"Sun\"}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mt-0.5\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-[10px] font-heading uppercase tracking-wider px-1.5 py-0.5\",\"style\":{\"backgroundColor\":\"#FF8C0020\",\"color\":\"#ffaf4d\",\"border\":\"1px solid #FF8C0040\"},\"children\":\"Fighter\"}],[\"$\",\"$L6c\",null,{\"tier\":\"A\",\"size\":\"sm\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-[10px] text-text-muted mt-1 truncate\",\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.relReasonCounter\",\"params\":{\"pp\":\"3.0\",\"name\":\"Layla\"}}]}]]}],[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-chevron-right w-4 h-4 text-text-muted group-hover:text-text-accent transition-colors flex-shrink-0\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"mthhwq\",{\"d\":\"m9 18 6-6-6-6\"}],\"$undefined\"]}]]}],[\"$\",\"div\",null,{\"className\":\"absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none\",\"style\":{\"background\":\"radial-gradient(ellipse at center, #FF8C0012 0%, transparent 70%)\"}}],[\"$\",\"div\",null,{\"className\":\"absolute top-0 left-0 w-3 h-3 border-t border-l border-mlbb-gold/0 group-hover:border-mlbb-gold/50 transition-all duration-300 pointer-events-none\"}],[\"$\",\"div\",null,{\"className\":\"absolute bottom-0 right-0 w-3 h-3 border-b border-r border-mlbb-gold/0 group-hover:border-mlbb-gold/50 transition-all duration-300 pointer-events-none\"}],[\"$\",\"div\",null,{\"className\":\"absolute bottom-0 left-0 right-0 h-[1px] opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none\",\"style\":{\"background\":\"linear-gradient(90deg, transparent, #FF8C00, transparent)\"}}]]}]\n91:[\"$\",\"$L6a\",\"johnson\",{\"href\":\"/heroes/johnson\",\"className\":\"group block\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative bg-surface-4 border border-mlbb-gold/20 overflow-hidden card-hover hover:border-mlbb-gold/50\",\"style\":{\"boxShadow\":\"0 2px 8px rgba(0,0,0,0.3)\"},\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 p-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative w-14 h-14 rounded-full overflow-hidden flex-shrink-0 bg-surface-3\",\"children\":[\"$\",\"$L6b\",null,{\"src\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_85ff988c6660b4d04f8dd3d40df988bb.png\",\"alt\":\"Johnson - Wild Engine\",\"unoptimized\":false,\"priority\":\"$undefined\",\"fetchPriority\":\"$undefined\",\"fill\":true,\"className\":\"object-cover group-hover:scale-110 transition-transform duration-300\",\"sizes\":\"56px\",\"placeholder\":\"blur\",\"blurDataURL\":\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTAwIiBoZWlnaHQ9IjEwMCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48cmVjdCB3aWR0aD0iMTAwIiBoZWlnaHQ9IjEwMCIgZmlsbD0iIzBkMTIyNSIvPjwvc3ZnPg==\"}]}],[\"$\",\"div\",null,{\"className\":\"flex-1 min-w-0\",\"children\":[[\"$\",\"h4\",null,{\"className\":\"font-heading font-bold text-text-primary group-hover:text-text-accent-bright transition-colors truncate\",\"children\":\"Johnson\"}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mt-0.5\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-[10px] font-heading uppercase tracking-wider px-1.5 py-0.5\",\"style\":{\"backgroundColor\":\"#3498DB20\",\"color\":\"#71b7e6\",\"border\":\"1px solid #3498DB40\"},\"children\":\"Tank\"}],[\"$\",\"$L6c\",null,{\"tier\":\"C\",\"size\":\"sm\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-[10px] text-text-muted mt-1 truncate\",\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.relReasonCounter\",\"params\":{\"pp\":\"2.7\",\"name\":\"Layla\"}}]}]]}],[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\"