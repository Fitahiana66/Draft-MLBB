-gold/20 pointer-events-none"></div></div><div class="group relative bg-surface-3 border border-mlbb-gold/15 hover:border-mlbb-green/30 transition-all duration-300" style="opacity:0;transform:translateY(12px)"><div class="flex items-center gap-3 p-3 sm:gap-4 sm:p-4"><div class="flex-shrink-0 w-7 sm:w-8 text-center"><span class="text-base sm:text-lg font-heading font-bold text-text-accent">#<!-- -->4</span></div><a class="flex-shrink-0" href="/heroes/lancelot"><div class="relative overflow-hidden flex-shrink-0 rounded-full" style="width:48px;height:48px;min-width:48px;background-color:#00AAFF12"><img alt="Lancelot hero icon" loading="lazy" width="48" height="48" decoding="async" data-nimg="1" class="h-full w-full object-cover" style="color:transparent" srcSet="https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_dc4b821e49b904715172136017798da3.png&amp;w=48&amp;output=webp&amp;q=75&amp;we 1x, https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_dc4b821e49b904715172136017798da3.png&amp;w=96&amp;output=webp&amp;q=75&amp;we 2x" src="https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_dc4b821e49b904715172136017798da3.png&amp;w=96&amp;output=webp&amp;q=75&amp;we"/></div></a><div class="min-w-0 flex-1"><div class="flex items-center gap-2 sm:gap-3 flex-wrap"><a class="min-w-0 max-w-full truncate font-heading font-bold text-base sm:text-lg text-text-primary hover:text-text-accent-bright transition-colors" href="/heroes/lancelot">Lancelot</a><div class="inline-flex items-center justify-center font-heading font-bold bg-gradient-to-br from-[#ff4444] to-[#cc2222] text-[#1a0707] w-6 h-6 text-xs animate-tier-pop">D</div><div class="gap-1.5 hidden sm:flex"><span class="text-[10px] px-1.5 py-0.5" style="background-color:#00AAFF20;color:#4dc4ff">Assassin</span></div></div><p class="text-xs text-text-muted mt-1 line-clamp-2">Alucard has a favourable matchup against Lancelot based on ranked data, so expect a win rate advantage in this matchup.</p></div><div class="flex-shrink-0 text-right"><p class="flex items-center justify-end gap-1 text-lg sm:text-xl font-heading font-bold" style="color:#C8AA6E"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trending-down w-3.5 h-3.5" aria-hidden="true"><path d="M16 17h6v-6"></path><path d="m22 17-8.5-8.5-5 5L2 7"></path></svg>+<!-- -->1.8</p><p class="text-[9px] text-text-muted uppercase hidden sm:block">win rate delta</p></div></div><div class="absolute top-0 left-0 w-3 h-3 border-t border-l border-mlbb-gold/20 pointer-events-none"></div><div class="absolute bottom-0 right-0 w-3 h-3 border-b border-r border-mlbb-gold/20 pointer-events-none"></div></div><div class="group relative bg-surface-3 border border-mlbb-gold/15 hover:border-mlbb-green/30 transition-all duration-300" style="opacity:0;transform:translateY(12px)"><div class="flex items-center gap-3 p-3 sm:gap-4 sm:p-4"><div class="flex-shrink-0 w-7 sm:w-8 text-center"><span class="text-base sm:text-lg font-heading font-bold text-text-accent">#<!-- -->5</span></div><a class="flex-shrink-0" href="/heroes/mathilda"><div class="relative overflow-hidden flex-shrink-0 rounded-full" style="width:48px;height:48px;min-width:48px;background-color:#2ECC7112"><img alt="Mathilda hero icon" loading="lazy" width="48" height="48" decoding="async" data-nimg="1" class="h-full w-full object-cover" style="color:transparent" srcSet="https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_24d08ed788a9f5984bcf3b732ddcaf04.png&amp;w=48&amp;output=webp&amp;q=75&amp;we 1x, https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_24d08ed788a9f5984bcf3b732ddcaf04.png&amp;w=96&amp;output=webp&amp;q=75&amp;we 2x" src="https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_24d08ed788a9f5984bcf3b732ddcaf04.png&amp;w=96&amp;output=webp&amp;q=75&amp;we"/></div></a><div class="min-w-0 flex-1"><div class="flex items-center gap-2 sm:gap-3 flex-wrap"><a class="min-w-0 max-w-full truncate font-heading font-bold text-base sm:text-lg text-text-primary hover:text-text-accent-bright transition-colors" href="/heroes/mathilda">Mathilda</a><div class="inline-flex items-center justify-center font-heading font-bold bg-gradient-to-br from-[#ff4444] to-[#cc2222] text-[#1a0707] w-6 h-6 text-xs animate-tier-pop">D</div><div class="gap-1.5 hidden sm:flex"><span class="text-[10px] px-1.5 py-0.5" style="background-color:#2ECC7120;color:#6ddb9c">Support</span><span class="text-[10px] px-1.5 py-0.5" style="background-color:#00AAFF20;color:#4dc4ff">Assassin</span></div></div><p class="text-xs text-text-muted mt-1 line-clamp-2">Alucard has a favourable matchup against Mathilda based on ranked data, so expect a win rate advantage in this matchup.</p></div><div class="flex-shrink-0 text-right"><p class="flex items-center justify-end gap-1 text-lg sm:text-xl font-heading font-bold" style="color:#C8AA6E"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trending-down w-3.5 h-3.5" aria-hidden="true"><path d="M16 17h6v-6"></path><path d="m22 17-8.5-8.5-5 5L2 7"></path></svg>+<!-- -->1.7</p><p class="text-[9px] text-text-muted uppercase hidden sm:block">win rate delta</p></div></div><div class="absolute top-0 left-0 w-3 h-3 border-t border-l border-mlbb-gold/20 pointer-events-none"></div><div class="absolute bottom-0 right-0 w-3 h-3 border-b border-r border-mlbb-gold/20 pointer-events-none"></div></div></div></section></div><section class="grid gap-3 md:grid-cols-3"><a class="block" href="/heroes/aurora"><div class="h-full border border-mlbb-gold/18 bg-surface-2/82 p-4 transition-colors hover:border-mlbb-gold-bright/35"><p class="mb-1 font-heading text-[10px] font-bold uppercase tracking-[0.16em] text-text-accent">Official Ally Note</p><h3 class="font-heading text-base font-bold text-text-primary">Aurora</h3><p class="mt-2 text-xs leading-relaxed text-text-muted">Mages like Kagura or Aurora are ideal partners, Having a good disable allows you to deal more damage to the enemy. Since Mages usually require someone to deal a decent amount of damage early game to farm faster.</p></div></a><a class="block" href="/heroes/layla"><div class="h-full border border-mlbb-gold/18 bg-surface-2/82 p-4 transition-colors hover:border-mlbb-gold-bright/35"><p class="mb-1 font-heading text-[10px] font-bold uppercase tracking-[0.16em] text-text-accent">Official Counter Note</p><h3 class="font-heading text-base font-bold text-text-primary">Layla</h3><p class="mt-2 text-xs leading-relaxed text-text-muted">Heroes with Low burst skills, Usually Tanks and Fighters, with his Lifesteal abilities, he can pretty much 1v1 and even 1v2 enemies with ease so long as he doesn’t encounter any Hard CCs *Making myself clear, Burst as in ONE HIT WONDERS LIKE EUDORA* Fighters generally has very consistent high damage throughout like Marksmans.</p></div></a><a class="block" href="/heroes/karina"><div class="h-full border border-mlbb-gold/18 bg-surface-2/82 p-4 transition-colors hover:border-mlbb-gold-bright/35"><p class="mb-1 font-heading text-[10px] font-bold uppercase tracking-[0.16em] text-text-accent">Official Threat Note</p><h3 class="font-heading text-base font-bold text-text-primary">Karina</h3><p class="mt-2 text-xs leading-relaxed text-text-muted">Karina, You won’t be able to hit her when she procs “1” so yeah basically you can only use your skills to pop her. Pretty much allows her to avoid about ⅓ of your full damage.</p></div></a></section><section><div class="mb-4"><div class="flex items-center gap-3 mb-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock w-5 h-5 text-text-accent-bright" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg><h2 class="text-lg md:text-xl font-heading font-bold text-text-primary">Game Phase Analysis for<!-- --> <span style="color:#F0D060">Alucard</span></h2></div><p class="text-xs text-text-muted max-w-2xl">Alucard scales into the late game: across the 10 matchups measured for them, Alucard does best once matches pass 16 minutes. Build your lead in the first 10 minutes before Alucard reaches full power.</p></div><div class="grid grid-cols-1 sm:grid-cols-3 gap-4"><div class="bg-surface-3 border border-mlbb-gold/15 p-4" style="opacity:0;transform:translateY(15px)"><div class="flex items-center justify-between mb-1"><span class="text-xs font-heading font-bold text-text-primary uppercase tracking-wider">Early Game</span><span class="text-[10px] text-text-muted">0-10 min</span></div><p class="text-base font-heading font-bold mb-2" style="color:#ff4444">Alucard dips here</p><div class="w-full h-2 bg-surface-4 overflow-hidden"><div class="h-full" style="background-color:#ff4444;width:0px"></div></div></div><div class="bg-surface-3 border border-mlbb-gold/15 p-4" style="opacity:0;transform:translateY(15px)"><div class="flex items-center justify-between mb-1"><span class="text-xs font-heading font-bold text-text-primary uppercase tracking-wider">Mid Game</span><span class="text-[10px] text-text-muted">10-16 min</span></div><p class="text-base font-heading font-bold mb-2" style="color:#F0D060">In between</p><div class="w-full h-2 bg-surface-4 overflow-hidden"><div class="h-full" style="background-color:#F0D060;width:0px"></div></div></div><div class="bg-surface-3 border border-mlbb-gold/15 p-4" style="opacity:0;transform:translateY(15px)"><div class="flex items-center justify-between mb-1"><span class="text-xs font-heading font-bold text-text-primary uppercase tracking-wider">Late Game</span><span class="text-[10px] text-text-muted">16+ min</span></div><p class="text-base font-heading font-bold mb-2" style="color:#44ff88">Alucard peaks here</p><div class="w-full h-2 bg-surface-4 overflow-hidden"><div class="h-full" style="background-color:#44ff88;width:0px"></div></div></div></div><p class="text-[10px] text-text-muted/80 mt-3 max-w-3xl">Shape only, from the 10 matchups measured for Alucard. The bars rank Alucard&#x27;s own phases against each other, not against other heroes, and are not win rates.</p></section></div></div><div id="tabpanel-builds" role="tabpanel" aria-labelledby="tab-builds" tabindex="0" hidden=""><section class="space-y-3 sm:space-y-4"><div class="flex flex-col gap-3 xl:flex-row xl:items-end xl:justify-between xl:gap-8"><header class="min-w-0"><h2 class="font-heading text-lg font-bold uppercase leading-tight tracking-[0.06em] text-mlbb-text sm:text-2xl"><span class="text-mlbb-gold-bright">Alucard</span> <span class="text-mlbb-text/85">Best Builds, Emblems</span> <span class="text-mlbb-text/60">&amp;</span> <span class="text-mlbb-text/85">Talents</span></h2><p class="mt-1 hidden max-w-3xl text-sm text-mlbb-text-secondary sm:block xl:hidden">Three battle-tested loadouts. Pick the one that fits the draft, not the one with the most flash.</p><div class="mt-1.5 flex flex-wrap items-center gap-x-2.5 gap-y-1"><span class="font-heading text-[10px] font-bold uppercase tracking-[0.2em] text-text-muted">Patch <!-- -->2.1.67</span><span title="These loadouts were last re-read on patch 2.1.67; the live patch is 2.2.16a. Item stats may have changed." class="inline-flex flex-shrink-0 items-center gap-1 border border-amber-400/25 bg-amber-400/10 px-1.5 py-0.5 font-heading text-[9px] font-bold uppercase leading-none tracking-[0.1em] text-amber-300/90"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-history h-2.5 w-2.5" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path><path d="M12 7v5l4 2"></path></svg>Older patch</span><span class="font-heading text-[10px] font-bold uppercase tracking-[0.2em] text-text-accent/70">Reviewed May 7, 2026</span></div></header><div role="tablist" aria-label="Builds" class="grid gap-1.5 sm:gap-2 xl:w-[620px] xl:shrink-0" style="grid-template-columns:repeat(3, minmax(0, 1fr))"><button type="button" role="tab" id="build-tab-1" aria-selected="true" aria-controls="build-1" class="relative flex min-h-[44px] min-w-0 cursor-pointer items-center gap-2 border px-2 py-1.5 text-left transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mlbb-gold sm:px-3 sm:py-2 border-mlbb-gold-bright/60 bg-mlbb-gold/10"><span class="font-heading text-[11px] font-bold tabular-nums sm:text-xs text-text-accent-bright" aria-hidden="true">01</span><span class="min-w-0 font-heading text-[10px] font-bold uppercase leading-tight tracking-wide line-clamp-3 sm:line-clamp-2 sm:text-xs text-mlbb-text">Jungle Sustain Default</span></button><button type="button" role="tab" id="build-tab-2" aria-selected="false" aria-controls="build-2" class="relative flex min-h-[44px] min-w-0 cursor-pointer items-center gap-2 border px-2 py-1.5 text-left transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mlbb-gold sm:px-3 sm:py-2 border-mlbb-gold/18 bg-surface-2/70 hover:border-mlbb-gold/40"><span class="font-heading text-[11px] font-bold tabular-nums sm:text-xs text-text-accent/70" aria-hidden="true">02</span><span class="min-w-0 font-heading text-[10px] font-bold uppercase leading-tight tracking-wide line-cla