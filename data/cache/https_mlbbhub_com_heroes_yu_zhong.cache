en\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankColDelta\"}],\" \"]}],\"+0.37%\"]}],[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-px whitespace-nowrap text-[10px] leading-none text-text-muted sm:gap-0.5 sm:text-xs\",\"children\":[[\"$\",\"span\",null,{\"className\":\"sr-only\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankColTrend\",\"params\":{\"days\":7}}],\" \"]}],[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-trending-up inline-block w-2.5 h-2.5 sm:w-3.5 sm:h-3.5 text-text-muted\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"box55l\",{\"d\":\"M16 7h6v6\"}],[\"$\",\"path\",\"1t1m79\",{\"d\":\"m22 7-8.5 8.5-5-5L2 17\"}],\"$undefined\"]}],\"+0.16%\"]}]]}]}],[\"$\",\"td\",\"mythic\",{\"className\":\"px-0.5 py-2.5 align-top sm:px-3\",\"style\":\"$undefined\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex flex-col items-center gap-1 tabular-nums lg:flex-row lg:justify-center lg:gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-[11.5px] sm:text-sm text-text-primary\",\"style\":\"$undefined\",\"children\":[\"0.63\",\"%\"]}],[\"$\",\"span\",null,{\"className\":\"inline-flex items-center rounded-sm bg-mlbb-gold/[0.07] px-1 py-0.5 text-[10px] leading-none text-text-muted sm:px-1.5 sm:text-xs\",\"children\":[[\"$\",\"span\",null,{\"className\":\"sr-only\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankColDelta\"}],\" \"]}],\"-0.10%\"]}],[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-px whitespace-nowrap text-[10px] leading-none text-text-muted sm:gap-0.5 sm:text-xs\",\"children\":[[\"$\",\"span\",null,{\"className\":\"sr-only\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankColTrend\",\"params\":{\"days\":7}}],\" \"]}],[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-trending-up inline-block w-2.5 h-2.5 sm:w-3.5 sm:h-3.5 text-text-muted\",\"aria-hidden\":\"true\",\"children\":[\"$L9f\",\"$La0\",\"$undefined\"]}],\"+0.10%\"]}]]}]}],\"$La1\",\"$La2\"]]}]\n7b:[\"$\",\"p\",null,{\"className\":\"mt-3 flex flex-wrap items-center gap-x-5 gap-y-1.5 text-[11px] text-text-muted\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-1.5\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block h-3 w-5 rounded-sm bg-mlbb-gold/[0.07] ring-1 ring-inset ring-mlbb-gold/20\",\"aria-hidden\":\"true\"}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankColDelta\"}]]}],[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-1.5\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-trending-up h-3.5 w-3.5 text-text-muted\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"box55l\",{\"d\":\"M16 7h6v6\"}],[\"$\",\"path\",\"1t1m79\",{\"d\":\"m22 7-8.5 8.5-5-5L2 17\"}],\"$undefined\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankColTrend\",\"params\":{\"days\":7}}]]}]]}]\n7c:[\"$\",\"div\",null,{\"className\":\"mt-5 grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-3\",\"children\":[[\"$\",\"article\",\"epic\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #B07ECC, #B07ECC33)\",\"boxShadow\":\"0 0 12px -2px #B07ECC80\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#B07ECC\",\"background\":\"#B07ECC1a\",\"border\":\"1px solid #B07ECC40\"},\"children\":\"Epic\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Yu Zhong\",\"rank\":\"Epic\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=epic\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Epic\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Epic\",\"name\":\"Yu Zhong\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"48.60\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Yu Zhong\",\"delta\":\"-0.36%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.33\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"1.47\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Epic\"}}]]}]]}],[\"$\",\"article\",\"legend\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #4dc9f6, #4dc9f633)\",\"boxShadow\":\"0 0 12px -2px #4dc9f680\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#4dc9f6\",\"background\":\"#4dc9f61a\",\"border\":\"1px solid #4dc9f640\"},\"children\":\"Legend\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Yu Zhong\",\"rank\":\"Legend\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=legend\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Legend\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Legend\",\"name\":\"Yu Zhong\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"48.98\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Yu Zhong\",\"delta\":\"+0.02%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.48\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"1.10\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Legend\"}}]]}]]}],[\"$\",\"article\",\"mythic\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[\"$La3\",\"$La4\",\"$La5\"]}],\"$La6\",\"$La7\"]}]\n7e:[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}]\n7f:[\"$\",\"p\",\"p-6\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Most players read Cursing Touch and think \\\"damage plus regen.\\\" The actual mechanic is a conditional burst: 5 stacks must accumulate on a single target before the eruption fires. Each tick of the eruption then deals physical damage based on the target's lost HP and restores 6% of Yu Zhong's own missing HP.\"}]\n80:[\"$\",\"p\",\"p-7\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Two consequences follow from this. One, the regen is proportional to his missing HP. A Yu Zhong at 30% health landing a full eruption restores far more absolute HP than one at 80% health. He becomes more dangerous the worse he looks. Two, spreading damage across multiple enemies in a teamfight splits stacks across all of them. A wide S1 through five enemies means stacks spread thin instead of erupting on one target. Find a single focus, stay on them until the eruption fires, then rotate.\"}]\n81:[\"$\",\"p\",\"p-8\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The Sha Essence bar fills with eruptions and extended damage and unlocks a burst of movement speed and Spell Vamp when full. This window is the signal to chase or rotate: move toward the next fight immediately when the speed buff activates.\"}]\n82:[\"$\",\"p\",\"p-9\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Following the passive damage reduction in patch 2.1.47, the base per-stack damage dropped, making early skirmishes less punishing for opponents. The solution is completing War Axe plus Oracle before the 11-minute mark rather than forcing fights in a window where the passive no longer carries on its own.\"}]\n83:[\"$\",\"h2\",\"h2-2\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Laning: the first four minutes\"]}]\n84:[\"$\",\"ol\",\"ol-0\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Take S1 at level 1, not S2.\"}],\" The outer edge of Dragon Tail deals dramatically more damage than the inner area. On wave 1, position so the enemy hero stands at the cloak's edge, not directly underneath you. You get stacks before they can retaliate without burning a skill.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"At level 2, combine S2 into S1.\"}],\" Soul Grip applies a 60% slow and enables one enhanced basic attack. When S2 hits multiple targets, the enhanced basic applies Sha Residue multiple times. Hit S2 through the minion wave at the angle where the wave and the enemy hero overlap, then land the enhanced auto before following with the outer ring of S1. That is the level 2 all-in window.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Don't push for kills before level 4.\"}],\" Before the ult, the only escape is spending S3's two dashes, and that costs you the engage and CC tool the trade needs. If the enemy jungler has a dash and arrives while you are overextended after a failed trade, you lose the fight and significant time. Stay at safe range, deny EXP, and avoid full commits until the ult is available.\"]}],\"\\n\"]}]\n85:[\"$\",\"h2\",\"h2-3\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The two items that change the fight\"]}]\n86:[\"$\",\"p\",\"p-10\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"War Axe alone is not the power spike. The real moment is War Axe plus Oracle, finished together around the 9-to-11 minute mark.\"}]\n87:[\"$\",\"p\",\"p-11\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"War Axe's Fighting Spirit passive stacks with every attack (up to 6 stacks, each adding Physical Attack for several seconds), and at full stacks converts a portion of Yu Zhong's damage into True Damage. His sustained melee pattern naturally keeps this passive near maximum during any extended duel. Oracle's Bless passive increases received shield and HP Regen effects by 25%. Every HP restoration tick from a Sha Residue eruption is a regen effect. Oracle turns each eruption from marginal healing into a meaningful HP swing.\"}]\n88:[\"$\",\"p\",\"p-12\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"With both complete, he can sustain through a 2v1 dive. Before both are complete, he cannot. The window between finishing War Axe and finishing Oracle is where most losses happen: players who feel strong from War Axe overcommit to fights they would win at full build but lose at that incomplete state.\"}]\n89:[\"$\",\"h2\",\"h2-4\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Positioning in teamfights\"]}]\n8a:[\"$\",\"p\",\"p-13\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The reflex when a fight starts is to sprint toward the enemy carry. That reflex is wrong for Yu Zhong.\"}]\n8b:[\"$\",\"p\",\"p-14\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"In a teamfight, chase the target closest to the eruption threshold: the hero who already has 3 or 4 stacks on them from an earlier skill hit. Erupting that target gives movement speed, Spell Vamp, and Sha Essence charge, all of which make the subsequent chase toward the carry much safer. Saving yourself for the carry while ignoring the easier eruption is how you end fights with low Sha Essence and no healing.\"}]\n8c:[\"$\",\"p\",\"p-15\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Three rules for the Dragonoid window after the ult:\"}]\n8d:[\"$\",\"ol\",\"ol-1\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":\"Recast S1 and S2 immediately after landing. The extended range catches enemies who stepped back to avoid your normal reach. Don't spend the first two seconds of Dragonoid running; spend them recasting.\"}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":\"Use S3 during Dragonoid to peel, not just to initiate. The knockup applies regardless of whether you are attacking or defending. If a dive hero is on top of you, S3 buys the gap to reset and re-engage on your terms.\"}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":\"Use the Dragonoid window for objectives if no kill is cleanly available. The extended range puts you closer to lord and turtle than the enemy team expects.\"}],\"\\n\"]}]\n8e:[\"$\",\"p\",\"p-16\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"If your support is Atlas, his Ejector field and CC immunity window during Black Dragon Form mean you can commit the ult and survive the burst that usually follows. If your support is Diggie, his invulnerability does not protect the sub-second channel before CC immunity kicks in. In that case, cast the ult only when the enemy's immediate burst spells are already used.\"}]\n8f:[\"$\",\"$La8\",null,{\"slot\":\"7246933188\",\"variant\":\"in-article\",\"className\":\"my-8\"}]\n90:[[\"$\",\"h2\",\"h2-0\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Items: what is locked and what is a conversation\"]}],\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Three items are locked in every game: Tough Boots (CC and slow duration reduced by 30%, which is relevant in every matchup), War Axe, and Oracle. The remaining three slots are genuine decisions.\"}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Penetration slot.\"}],\" Hunter Strike in most games: 80 Physical Attack, 10% CDR, and Retribution's movement burst proc from sustained hitting. Malefic Roar when the enemy frontline has stacked above 200 Physical Defense. Malefic Roar's Armor Buster passive scales with the enemy's own defense values, making each hit harder than flat penetration would on heavily armored targets.\"]}],\"\\n\",[\"$\",\"p\",\"p-2\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Second defense slot.\"}],\" Brute Force Breastplate in standard compositions. The Adaptive Attack stacks contribute to offense while the 15% Control Duration Reduction at full stacks means CC hits you for less time. Blade Armor when the enemy carry is Karrie, Claude, or Wanwan: the reflect and the slow it applies on being hit punish exactly the basic-attack rotation a kiting carry out-spaces you with.\"]}],\"\\n\",[\"$\",\"p\",\"p-3\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Close-out slot.\"}],\" Immortality as the default. Blade of Despair only when you are ahead by several kills, you can reliably catch enemies already below half HP, and the Despair passive triggers before your first hit. In a contested game where enemies are near full health when you engage, Blade of Despair's passive does nothing and you are paying 3010 gold for Physical Attack and movement speed when the defense would keep you alive longer.\"]}],\"\\n\",[\"$\",\"h2\",\"h2-1\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Mistakes that lose Yu Zhong games\"]}],\"\\n\",[\"$\",\"p\",\"p-4\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Committing S2 into Baxia.\"}],\" Baxia's passive marks targets and reduces all healing and regen received from those targets. Going all-in on a Baxia with S2 and expecting Sha Residue eruptions to restore your health returns almost nothing and wastes a long cooldown. Treat Baxia as a lane management problem: clear waves, deny EXP, and find fights elsewhere on the map. Trying to out-sustain a hero whose entire passive is designed to stop your sustain is losing the wrong kind of trade.\"]}],\"\\n\",[\"$\",\"p\",\"p-5\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[\"$La9\",\" The brief channel animation before CC immunity is visible to everyone. Most experienced players will use burst CC to interrupt it, or save their CC for immediately after the charge ends. Use Black Dragon Form to close terrain on separated targets, to contest an objective from an unexpected angle, or to siege a tower with control immunity. Using it as the opening engage into 4-5 grouped enemies with CC abilities available is how it ends before Dragonoid form even begins.\"]}],\"\\n\",\"$Laa\",\"\\n\",\"$Lab\",\"\\n\",\"$Lac\",\"\\n\",\"$Lad\",\"\\n\",\"$Lae\",\"\\n\",\"$Laf\",\"\\n\",\"$Lb0\",\"\\n\",\"$Lb1\"]\n91:[\"$\",\"$Lb2\",null,{\"heroName\":\"Yu Zhong\"}]\n"])</script><script>self.__next_f.push([1,"92:[\"$\",\"div\",null,{\"className\":\"relative bg-surface-4 border border-mlbb-gold/20 overflow-hidden card-hover hover:border-mlbb-gold/50\",\"style\":{\"boxShadow\":\"0 2px 8px rgba(0,0,0,0.3)\"},\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 p-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative w-14 h-14 rounded-full overflow-hidden flex-shrink-0 bg-surface-3\",\"children\":[\"$\",\"$L6b\",null,{\"src\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_