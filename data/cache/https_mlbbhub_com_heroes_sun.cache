4,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-trending-up h-3.5 w-3.5 text-text-muted\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"box55l\",{\"d\":\"M16 7h6v6\"}],[\"$\",\"path\",\"1t1m79\",{\"d\":\"m22 7-8.5 8.5-5-5L2 17\"}],\"$undefined\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankColTrend\",\"params\":{\"days\":7}}]]}]]}]\n7c:[\"$\",\"div\",null,{\"className\":\"mt-5 grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-3\",\"children\":[[\"$\",\"article\",\"epic\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #B07ECC, #B07ECC33)\",\"boxShadow\":\"0 0 12px -2px #B07ECC80\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#B07ECC\",\"background\":\"#B07ECC1a\",\"border\":\"1px solid #B07ECC40\"},\"children\":\"Epic\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Sun\",\"rank\":\"Epic\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=epic\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Epic\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Epic\",\"name\":\"Sun\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"55.78\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Sun\",\"delta\":\"+3.16%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"1.68\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"26.12\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Epic\"}}]]}]]}],[\"$\",\"article\",\"legend\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #4dc9f6, #4dc9f633)\",\"boxShadow\":\"0 0 12px -2px #4dc9f680\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#4dc9f6\",\"background\":\"#4dc9f61a\",\"border\":\"1px solid #4dc9f640\"},\"children\":\"Legend\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Sun\",\"rank\":\"Legend\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=legend\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Legend\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Legend\",\"name\":\"Sun\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"54.19\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Sun\",\"delta\":\"+1.57%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"1.84\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"27.61\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Legend\"}}]]}]]}],[\"$\",\"article\",\"mythic\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #f59e0b, #f59e0b33)\",\"boxShadow\":\"0 0 12px -2px #f59e0b80\"}}],\"$La3\",\"$La4\"]}],\"$La5\",\"$La6\"]}]\n7e:[\"$\",\"p\",\"p-3\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"If you cannot say exactly which lane Sun is supposed to break, do not lock him.\"}]\n7f:[\"$\",\"h2\",\"h2-1\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The one rule behind every good Sun game\"]}]\n80:[\"$\",\"p\",\"p-4\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Sun is not a duelist in the normal sense. He is a target-saturation test.\"}]\n81:[\"$\",\"p\",\"p-5\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Every good Sun trade starts by turning one body into two, then three, until the enemy either spends their answer on the wrong target or runs out of room to hit all of them at once. His passive makes long trades better by shaving physical defense on repeated contact. His first skill is not poke in the usual EXP-lane sense. It is body placement. His second skill is not an engage button. It is how you conceal, dodge a key answer, and move the real Sun to the part of the fight the enemy did not prepare for. His third skill only matters if the clones are already in position to collapse with you.\"}]\n82:[\"$\",\"p\",\"p-6\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"That is why impatient Sun players look useless. They see a fighter, dash forward with Swift Exchange, and start a fair 1v1. Sun is terrible at fair 1v1s against real EXP lane specialists. He wins unfair fights where one clone is already hitting, the second body arrives from another angle, and the enemy is forced to guess whether using crowd control now will catch the real hero or just delete temporary clutter.\"}]\n83:[\"$\",\"p\",\"p-7\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Once that clicks, your job becomes clearer. You are not trying to look flashy. You are trying to make every response one beat late. If the enemy has not already spent an important skill before you hard commit, you are too early.\"}]\n84:[\"$\",\"h2\",\"h2-2\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Laning: the first six minutes\"]}]\n85:[\"$\",\"p\",\"p-8\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Sun's early lane is about reaching level 4 without bleeding the turret, then using the first ultimate window to decide whether the lane is playable or whether the game needs to become a side-lane macro problem.\"}]\n86:[\"$\",\"ol\",\"ol-0\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Take Endless Variety first and throw it through the wave, not past it.\"}],\" Clip the enemy EXP laner if you can, but the real job is to spawn a clone in a useful spot and read how quickly the matchup deletes it. If the first clone dies instantly, you already know this is not a lane for honest trades.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Hold the wave closer to your side until level 4.\"}],\" Sun without ultimate is one body short and loses too many straight-up trades against better early EXP heroes. The 2.2.16 cooldown cut gets Endless Variety back faster, so you get more bodies to chip with, but a straight trade is still a losing deal. Last-hit, trim, and let the enemy walk farther than they want to if they insist on shoving. You are farming information as much as gold.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Do not spend battle-spell tempo for vanity kills.\"}],\" Vengeance is for surviving the body-pile all-in. Sprint is for escaping slow-heavy chases or turning a side lane into a map race. Flicker is for one decisive dodge or finish. Burning any of them for a low-value first blood usually costs more lane control than it buys.\"]}],\"\\n\"]}]\n87:[\"$\",\"p\",\"p-9\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"If the enemy roamer shows late, Sun can take a greedy wave because S1 gives you a free bush check and an escape anchor. If the enemy roamer shows early, stop pretending your plate matters more than your timing. Sun scales harder off uninterrupted side-lane tempo than off one risky wave under tower.\"}]\n88:[\"$\",\"p\",\"p-10\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The first real decision point is level 4. If your first ult trade forces the enemy EXP back and leaves the wave healthy, keep lane priority and start threatening plates. If the trade only proves they clear bodies too fast, stop chasing kills. Your next win condition is not lane dominance. It is wave control into rotation pressure.\"}]\n89:[\"$\",\"h2\",\"h2-3\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The two-item window that turns pressure into towers\"]}]\n8a:[\"$\",\"p\",\"p-11\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Sun's cleanest spike is Corrosion Scythe plus Demon Hunter Sword, usually online around the 7 to 10 minute mark if the lane stayed stable. That is the moment the hero stops feeling like a gimmick and starts feeling like a structural problem.\"}]\n8b:[\"$\",\"p\",\"p-12\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Corrosion Scythe matters first because it changes how targets leave the fight. The on-hit slow stacks fast, and every body attacking the same target makes retreat routes shorter than they look. Demon Hunter Sword then adds the part that actually turns those sticky trades into kills: current-HP damage on every basic attack plus built-in sustain. Together, the two items let Sun do three things at once. He sticks, he drains, and he threatens frontliners without needing to burst them from full.\"}]\n8c:[\"$\",\"p\",\"p-13\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"What changes mechanically once both items land is more important than the raw damage. Before the spike, S3 is mostly a gap-closer that helps you finish a soft target or escape through a creep. After the spike, S3 becomes the command to collapse a slowed target who is already losing armor and HP to multiple bodies. Turrets also stop being a secondary reward. With clone uptime and attack-speed pressure, towers become the main reason the enemy has to answer you at all.\"}]\n8d:[\"$\",\"p\",\"p-14\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"This is the part many Sun players misread. The spike does not mean \\\"group now.\\\" It means you finally have the right to force a bad answer on the side lane. If the enemy sends one hero, you can often kill them or at least burn key cooldowns. If they send two, your team should be taking something on the other side of the map.\"}]\n8e:[\"$\",\"p\",\"p-15\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Golden Staff is the usual third damage piece when the game lets you keep autoing. Endless Strike makes the attack after two non-critical basics trigger attack effects two extra times (with no crit in the build, effectively every third swing), which is exactly the kind of multiplication Sun wants once Corrosion Scythe and Demon Hunter Sword are already online. Delay it when surviving the first answer matters more than squeezing out more DPS.\"}]\n8f:[\"$\",\"$La7\",null,{\"slot\":\"7246933188\",\"variant\":\"in-article\",\"className\":\"my-8\"}]\n90:[[\"$\",\"h2\",\"h2-0\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Teamfights: do not pilot the fake body first\"]}],\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The wrong Sun reflex is to send every clone straight through the frontline and pretend chaos itself is good enough. Against disciplined teams, blind entry only feeds AoE and crowd control. Sun teamfights are won by timing and angle, not by pressing all three body buttons as soon as the screen lights up.\"}],\"\\n\",[\"$\",\"ol\",\"ol-0\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Enter after the first answer shows.\"}],\" If Ruby still has hook, if X.Borg still has full space to sweep the lane, or if the enemy mage has not shown their first zone skill, wait. Sun does not have the health bar to be first contact unless the draft is already broken in your favor.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Send the first clone sideways, not straight at the carry.\"}],\" A side angle matters because it forces the enemy to choose between facing the real hero, the clone angle, or your own front line. Straight-line body piles are easy to read and even easier to clear.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Press Instantaneous Move only when every body can actually reach the same target.\"}],\" If one clone is still hitting the wave or walking in from too far away, your collapse loses most of its point. Reset the angle instead of forcing a half-engage.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Target priority is simpler than many Sun players make it. You do not hit the tank first just because you technically can. You hit whoever is isolated enough that all bodies can stay attached through one full slow window. Sometimes that is the marksman. Sometimes it is the mid who stepped up to clear your clone. Sometimes it is the EXP laner who rotated late and now has no backup. The right target is the one who cannot walk out before Corrosion stacks bite.\"}],\"\\n\",[\"$\",\"p\",\"p-2\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"There is one support-dependent exception. If your team has Mathilda, Angela, or Estes, you can take a longer second entry because those heroes let you survive the moment after the first clone stack lands. If your roam is pure engage with no follow-through sustain, do not imitate assassin pathing. Hover the flank, wait for the first cooldown trade, and punish the player who oversteps to clear the fake body.\"}],\"\\n\",[\"$\",\"h2\",\"h2-1\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Itemization: locked slots, then real conversations\"]}],\"\\n\",\"$La8\",\"\\n\",\"$La9\",\"\\n\",\"$Laa\",\"\\n\",\"$Lab\",\"\\n\",\"$Lac\",\"\\n\",\"$Lad\",\"\\n\",\"$Lae\",\"\\n\",\"$Laf\",\"\\n\",\"$Lb0\",\"\\n\",\"$Lb1\",\"\\n\",\"$Lb2\",\"\\n\",\"$Lb3\",\"\\n\",\"$Lb4\",\"\\n\",\"$Lb5\",\"\\n\",\"$Lb6\"]\n91:[\"$\",\"$Lb7\",null,{\"heroName\":\"Sun\"}]\n"])</script><script>self.__next_f.push([1,"92:[\"$\",\"div\",null,{\"className\":\"relative bg-surface-4 border border-mlbb-gold/20 overflow-hidden card-hover hover:border-mlbb-gold/50\",\"style\":{\"boxShadow\":\"0 2px 8px rgba(0,0,0,0.3)\"},\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 p-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative w-14 h-14 rounded-full overflow-hidden flex-shrink-0 bg-surface-3\",\"children\":[\"$\",\"$L6b\",null,{\"src\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_d3a3a55c22000ae78732fed8cba2efef.png\",\"alt\":\"Joy - Pirate Fairy\",\"unoptimized\":false,\"priority\":\"$undefined\",\"fetchPriority\":\"$undefined\",\"fill\":true,\"className\":\"object-cover group-hover:scale-110 transition-transform duration-300\",\"sizes\":\"56px\",\"placeholder\":\"blur\",\"blurDataURL\":\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTAwIiBoZWlnaHQ9IjEwMCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48cmVjdCB3aWR0aD0iMTAwIiBoZWlnaHQ9IjEwMCIgZmlsbD0iIzBkMTIyNSIvPjwvc3ZnPg==\"}]}],[\"$\",\"div\",null,{\"className\":\"flex-1 min-w-0\",\"children\":[[\"$\",\"h4\",null,{\"className\":\"font-heading font-bold text-text-primary group-hover:text-text-accent-bright transition-colors truncate\",\"children\":\"Joy\"}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mt-0.5\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-[10px] font-heading uppercase tracking-wider px-1.5 py-0.5\",\"style\":{\"backgroundColor\":\"#00AAFF20\",\"color\":\"#4dc4ff\",\"border\":\"1px solid #00AAFF40\"},\"children\":\"Assassin\"}],[\"$\",\"$L6c\",null,{\"tier\":\"C\",\"size\":\"sm\