ng uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Mythic\"}}],\" →\"]}]]}]\na4:[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Mythic\",\"name\":\"Sun\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"52.23\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Sun\",\"delta\":\"-0.39%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"1.70\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"24.41\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Mythic\"}}]]}]\na5:[\"$\",\"article\",\"mythical_honor\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #C8AA6E, #C8AA6E33)\",\"boxShadow\":\"0 0 12px -2px #C8AA6E80\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#C8AA6E\",\"background\":\"#C8AA6E1a\",\"border\":\"1px solid #C8AA6E40\"},\"children\":\"Mythical Honor\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Sun\",\"rank\":\"Mythical Honor\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=mythical_honor\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Mythical Honor\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Mythical Honor\",\"name\":\"Sun\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"50.44\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Sun\",\"delta\":\"-2.18%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"1.50\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"16.86\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Mythical Honor\"}}]]}]]}]\na6:[\"$\",\"article\",\"mythical_glory\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #ff5d73, #ff5d7333)\",\"boxShadow\":\"0 0 12px -2px #ff5d7380\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#ff5d73\",\"background\":\"#ff5d731a\",\"border\":\"1px solid #ff5d7340\"},\"children\":\"Mythical Glory+\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Sun\",\"rank\":\"Mythical Glory+\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=mythical_glory\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Mythical Glory+\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Mythical Glory+\",\"name\":\"Sun\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"49.08\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Sun\",\"delta\":\"-3.54%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"1.22\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"8.79\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Mythical Glory+\"}}]]}]]}]\na8:[\"$\",\"p\",\"p-3\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Take Sun's build as two locked damage slots, one boot decision, and several live flex calls. Corrosion Scythe and Demon Hunter Sword are the locked pair. After that, read the lobby.\"}]\na9:[\"$\",\"p\",\"p-4\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The boot slot first. Swift Boots is for games where the enemy cannot reliably pin the real Sun and you are free to keep hitting. Tough Boots is the answer when chain crowd control is the reason you are losing your first body. Warrior Boots only makes sense when the lane is almost entirely physical chip and the enemy does not threaten real CC chains.\"}]\naa:[\"$\",\"p\",\"p-5\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Then the real conversations:\"}]\nab:[\"$\",\"ul\",\"ul-0\",{\"className\":\"list-disc list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Golden Staff\"}],\" when the enemy has to stand in your damage window. Endless Strike adds two extra attack-effect triggers on the attack after two non-critical basics, which multiplies the value of Corrosion Scythe and Demon Hunter Sword.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Malefic Roar\"}],\" when the side-lane answer is stacking armor early. If the enemy EXP or roam is already buying pure physical defense, Armor Buster keeps Sun from turning into a slow pusher who cannot finish the person matching him.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Sea Halberd\"}],\" when shield and sustain are the real obstacle. Lifebane cuts shield and HP regen effects to 60% of normal for 3 seconds, which matters against heal-heavy or shield-heavy answers that otherwise survive the first collapse and reset.\"]}],\"\\n\",[\"$\",\"li\",\"li-3\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Thunder Belt\"}],\" when sticking power and survivability matter more than one extra damage piece. The slow plus true-damage proc lets Sun keep contact after the first engage.\"]}],\"\\n\",[\"$\",\"li\",\"li-4\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Rose Gold Meteor\"}],\" when the problem is repeated magic poke or burst, and you still want attack speed in the slot. Sun is a fighter, so the Dragon Scale defense conversion is not halved on him, and the Lifeline shield can buy the extra second needed for clones to heal him back up.\"]}],\"\\n\"]}]\nac:[\"$\",\"p\",\"p-6\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"One more rule matters here: do not stack dead passives by accident. Corrosion Scythe's Impulse does not stack with Feather of Heaven's Impulse, so forcing both is wasted value. Sun wants each slot to solve a different problem, not to repeat the same label on the tooltip.\"}]\nad:[\"$\",\"h2\",\"h2-2\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Mistakes that lose Sun games\"]}]\nae:[\"$\",\"p\",\"p-7\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Picking Sun to win a fair EXP lane.\"}],\" This is the cleanest way to grief your own draft. If the enemy already showed X.Borg, Ruby, or another reliable clone clearer, your lane is not supposed to be pretty. The correct adjustment is to play for side pressure timing, not to force brute-strength trades the hero does not own.\"]}]\naf:[\"$\",\"p\",\"p-8\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Opening every fight with Swift Exchange.\"}],\" The conceal and reposition on S2 are one of the few ways Sun can dodge a key answer. If you spend that tool just to start contact, the enemy gets to throw their real crowd control at the body that matters. Make the clone appear first. Make them answer that. Then move the real Sun.\"]}]\nb0:[\"$\",\"p\",\"p-9\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Using Instantaneous Move when your clones are not ready.\"}],\" Sun's burst looks fake when only one body connects, and that is because it is fake. S3 is strongest when it turns three bodies into one target at the same time. If one clone is still on minions or out of leash range, wait half a second instead of donating your best collapse button.\"]}]\nb1:[\"$\",\"p\",\"p-10\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Staying in lane after the answer has already arrived.\"}],\" Once the enemy mid disappears and the roamer has been missing for five seconds, the side lane is no longer a duel. It is bait. Sun makes money by surviving long enough to pressure the next wave, not by dying for one extra plate because the tower is \\\"almost gone.\\\"\"]}]\nb2:[\"$\",\"p\",\"p-11\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Grouping for every neutral fight with no side setup.\"}],\" If Lord is spawning and your opposite side wave is dead, your split pressure is gone and Sun becomes a mediocre teamfighter. But the opposite mistake is even more common: players rotate into a neutral fight while a stacked side wave is already marching into enemy tower. If the wave is about to demand two defenders, do not abandon the only reason you were drafted.\"]}]\nb3:[\"$\",\"h2\",\"h2-3\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Key tips\"]}]\nb4:[\"$\",\"div\",\"blockquote-0\",{\"className\":\"my-5 p-4 flex gap-3\",\"style\":{\"background\":\"rgba(200,170,110,0.08)\",\"border\":\"1px solid rgba(200,170,110,0.35)\"},\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-lightbulb w-4 h-4 flex-shrink-0 mt-0.5\",\"aria-hidden\":\"true\",\"style\":{\"color\":\"#C8AA6E\"},\"children\":[[\"$\",\"path\",\"1gvzjb\",{\"d\":\"M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5\"}],[\"$\",\"path\",\"x1upvd\",{\"d\":\"M9 18h6\"}],[\"$\",\"path\",\"ceow96\",{\"d\":\"M10 22h4\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[11px] font-heading font-bold uppercase tracking-wider mb-1\",\"style\":{\"color\":\"#C8AA6E\"},\"children\":\"Tip\"}],[[\"$\",\"p\",\"0\",{\"className\":\"text-sm text-[#9BA0B4] leading-relaxed\",\"children\":[\"Throw S1 into the side bush before you walk up to a dangerous wave. The clone checks vision for free and gives you an instant S3 anchor if somebody is camping the lane.\"]}]]]}]]}]\nb5:[\"$\",\"div\",\"blockquote-1\",{\"className\":\"my-5 p-4 flex gap-3\",\"style\":{\"background\":\"rgba(200,170,110,0.08)\",\"border\":\"1px solid rgba(200,170,110,0.35)\"},\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-lightbulb w-4 h-4 flex-shrink-0 mt-0.5\",\"aria-hidden\":\"true\",\"style\":{\"color\":\"#C8AA6E\"},\"children\":[[\"$\",\"path\",\"1gvzjb\",{\"d\":\"M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5\"}],[\"$\",\"path\",\"x1upvd\",{\"d\":\"M9 18h6\"}],[\"$\",\"path\",\"ceow96\",{\"d\":\"M10 22h4\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[11px] font-heading font-bold uppercase tracking-wider mb-1\",\"style\":{\"color\":\"#C8AA6E\"},\"children\":\"Tip\"}],[[\"$\",\"p\",\"0\",{\"className\":\"text-sm text-[#9BA0B4] leading-relaxed\",\"children\":[\"If the enemy keeps matching you with a tank, stop trying to prove you can kill them. Shove the next wave, disappear into jungle fog, and force the mage or marksman to reveal instead. Sun wins by making the wrong person answer.\"]}]]]}]]}]\nb6:[\"$\",\"div\",\"blockquote-2\",{\"className\":\"my-5 p-4 flex gap-3\",\"style\":{\"background\":\"rgba(200,170,110,0.08)\",\"border\":\"1px solid rgba(200,170,110,0.35)\"},\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-lightbulb w-4 h-4 flex-shrink-0 mt-0.5\",\"aria-hidden\":\"true\",\"style\":{\"color\":\"#C8AA6E\"},\"children\":[[\"$\",\"path\",\"1gvzjb\",{\"d\":\"M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5\"}],[\"$\",\"path\",\"x1upvd\",{\"d\":\"M9 18h6\"}],[\"$\",\"path\",\"ceow96\",{\"d\":\"M10 22h4\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[11px] font-heading font-bold uppercase tracking-wider mb-1\",\"style\":{\"color\":\"#C8AA6E\"},\"children\":\"Tip\"}],[[\"$\",\"p\",\"0\",{\"className\":\"text-sm text-[#9BA0B4] leading-relaxed\",\"children\":[\"Vengeance is strongest when all three bodies are already hitting, not when you are still walking in. Press it too early and the enemy kites it out. Press it as contact starts and the return trade suddenly stops being favorable for them.\"]}]]]}]]}]\n"])</script></body></html>