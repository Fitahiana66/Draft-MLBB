ansition-all duration-300" style="opacity:0;transform:translateY(12px)"><div class="flex items-center gap-3 p-3 sm:gap-4 sm:p-4"><div class="flex-shrink-0 w-7 sm:w-8 text-center"><span class="text-base sm:text-lg font-heading font-bold text-text-accent">#<!-- -->5</span></div><a class="flex-shrink-0" href="/heroes/hilda"><div class="relative overflow-hidden flex-shrink-0 rounded-full" style="width:48px;height:48px;min-width:48px;background-color:#FF8C0012"><img alt="Hilda hero icon" loading="lazy" width="48" height="48" decoding="async" data-nimg="1" class="h-full w-full object-cover" style="color:transparent" srcSet="https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_acd700708dc515f5c63a08f8835a9941.png&amp;w=48&amp;output=webp&amp;q=75&amp;we 1x, https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_acd700708dc515f5c63a08f8835a9941.png&amp;w=96&amp;output=webp&amp;q=75&amp;we 2x" src="https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_acd700708dc515f5c63a08f8835a9941.png&amp;w=96&amp;output=webp&amp;q=75&amp;we"/></div></a><div class="min-w-0 flex-1"><div class="flex items-center gap-2 sm:gap-3 flex-wrap"><a class="min-w-0 max-w-full truncate font-heading font-bold text-base sm:text-lg text-text-primary hover:text-text-accent-bright transition-colors" href="/heroes/hilda">Hilda</a><div class="inline-flex items-center justify-center font-heading font-bold bg-gradient-to-br from-[#00AAFF] to-[#0077CC] text-[#00111a] shadow-[0_0_12px_rgba(0,170,255,0.3)] w-6 h-6 text-xs animate-tier-pop">B</div><div class="gap-1.5 hidden sm:flex"><span class="text-[10px] px-1.5 py-0.5" style="background-color:#FF8C0020;color:#ffaf4d">Fighter</span><span class="text-[10px] px-1.5 py-0.5" style="background-color:#3498DB20;color:#71b7e6">Tank</span></div></div><p class="text-xs text-text-muted mt-1 line-clamp-2">Aamon has a favourable matchup against Hilda based on ranked data, so expect a win rate advantage in this matchup.</p></div><div class="flex-shrink-0 text-right"><p class="flex items-center justify-end gap-1 text-lg sm:text-xl font-heading font-bold" style="color:#C8AA6E"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trending-down w-3.5 h-3.5" aria-hidden="true"><path d="M16 17h6v-6"></path><path d="m22 17-8.5-8.5-5 5L2 7"></path></svg>+<!-- -->2.1</p><p class="text-[9px] text-text-muted uppercase hidden sm:block">win rate delta</p></div></div><div class="absolute top-0 left-0 w-3 h-3 border-t border-l border-mlbb-gold/20 pointer-events-none"></div><div class="absolute bottom-0 right-0 w-3 h-3 border-b border-r border-mlbb-gold/20 pointer-events-none"></div></div><div class="group relative bg-surface-3 border border-mlbb-gold/15 hover:border-mlbb-green/30 transition-all duration-300" style="opacity:0;transform:translateY(12px)"><div class="flex items-center gap-3 p-3 sm:gap-4 sm:p-4"><div class="flex-shrink-0 w-7 sm:w-8 text-center"><span class="text-base sm:text-lg font-heading font-bold text-text-accent">#<!-- -->6</span></div><a class="flex-shrink-0" href="/heroes/suyou"><div class="relative overflow-hidden flex-shrink-0 rounded-full" style="width:48px;height:48px;min-width:48px;background-color:#00AAFF12"><img alt="Suyou hero icon" loading="lazy" width="48" height="48" decoding="async" data-nimg="1" class="h-full w-full object-cover" style="color:transparent" srcSet="https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_5e4ca70172332dde18bb1dc158ccc5c8.png&amp;w=48&amp;output=webp&amp;q=75&amp;we 1x, https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_5e4ca70172332dde18bb1dc158ccc5c8.png&amp;w=96&amp;output=webp&amp;q=75&amp;we 2x" src="https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_5e4ca70172332dde18bb1dc158ccc5c8.png&amp;w=96&amp;output=webp&amp;q=75&amp;we"/></div></a><div class="min-w-0 flex-1"><div class="flex items-center gap-2 sm:gap-3 flex-wrap"><a class="min-w-0 max-w-full truncate font-heading font-bold text-base sm:text-lg text-text-primary hover:text-text-accent-bright transition-colors" href="/heroes/suyou">Suyou</a><div class="inline-flex items-center justify-center font-heading font-bold bg-gradient-to-br from-[#00AAFF] to-[#0077CC] text-[#00111a] shadow-[0_0_12px_rgba(0,170,255,0.3)] w-6 h-6 text-xs animate-tier-pop">B</div><div class="gap-1.5 hidden sm:flex"><span class="text-[10px] px-1.5 py-0.5" style="background-color:#00AAFF20;color:#4dc4ff">Assassin</span><span class="text-[10px] px-1.5 py-0.5" style="background-color:#FF8C0020;color:#ffaf4d">Fighter</span></div></div><p class="text-xs text-text-muted mt-1 line-clamp-2">Aamon has a favourable matchup against Suyou based on ranked data, so expect a win rate advantage in this matchup.</p></div><div class="flex-shrink-0 text-right"><p class="flex items-center justify-end gap-1 text-lg sm:text-xl font-heading font-bold" style="color:#C8AA6E"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trending-down w-3.5 h-3.5" aria-hidden="true"><path d="M16 17h6v-6"></path><path d="m22 17-8.5-8.5-5 5L2 7"></path></svg>+<!-- -->1.4</p><p class="text-[9px] text-text-muted uppercase hidden sm:block">win rate delta</p></div></div><div class="absolute top-0 left-0 w-3 h-3 border-t border-l border-mlbb-gold/20 pointer-events-none"></div><div class="absolute bottom-0 right-0 w-3 h-3 border-b border-r border-mlbb-gold/20 pointer-events-none"></div></div></div></section></div><section><div class="mb-4"><div class="flex items-center gap-3 mb-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock w-5 h-5 text-text-accent-bright" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg><h2 class="text-lg md:text-xl font-heading font-bold text-text-primary">Game Phase Analysis for<!-- --> <span style="color:#F0D060">Aamon</span></h2></div><p class="text-xs text-text-muted max-w-2xl">Aamon&#x27;s 10 measured matchups do not separate by match length: no phase leads the others by more than that sample can resolve. There is no single window where Aamon drops off, so focus on consistent play and team coordination.</p></div><div class="grid grid-cols-1 sm:grid-cols-3 gap-4"><div class="bg-surface-3 border border-mlbb-gold/15 p-4" style="opacity:0;transform:translateY(15px)"><div class="flex items-center justify-between mb-1"><span class="text-xs font-heading font-bold text-text-primary uppercase tracking-wider">Early Game</span><span class="text-[10px] text-text-muted">0-10 min</span></div><p class="text-base font-heading font-bold mb-2" style="color:#9BA0B4">No measured separation</p><div class="w-full h-2 bg-surface-4 overflow-hidden"><div class="h-full" style="background-color:#9BA0B4;width:0px"></div></div></div><div class="bg-surface-3 border border-mlbb-gold/15 p-4" style="opacity:0;transform:translateY(15px)"><div class="flex items-center justify-between mb-1"><span class="text-xs font-heading font-bold text-text-primary uppercase tracking-wider">Mid Game</span><span class="text-[10px] text-text-muted">10-16 min</span></div><p class="text-base font-heading font-bold mb-2" style="color:#9BA0B4">No measured separation</p><div class="w-full h-2 bg-surface-4 overflow-hidden"><div class="h-full" style="background-color:#9BA0B4;width:0px"></div></div></div><div class="bg-surface-3 border border-mlbb-gold/15 p-4" style="opacity:0;transform:translateY(15px)"><div class="flex items-center justify-between mb-1"><span class="text-xs font-heading font-bold text-text-primary uppercase tracking-wider">Late Game</span><span class="text-[10px] text-text-muted">16+ min</span></div><p class="text-base font-heading font-bold mb-2" style="color:#9BA0B4">No measured separation</p><div class="w-full h-2 bg-surface-4 overflow-hidden"><div class="h-full" style="background-color:#9BA0B4;width:0px"></div></div></div></div><p class="text-[10px] text-text-muted/80 mt-3 max-w-3xl">Shape only, from the 10 matchups measured for Aamon. The bars rank Aamon&#x27;s own phases against each other, not against other heroes, and are not win rates.</p></section></div></div><div id="tabpanel-builds" role="tabpanel" aria-labelledby="tab-builds" tabindex="0" hidden=""><section class="space-y-3 sm:space-y-4"><div class="flex flex-col gap-3 xl:flex-row xl:items-end xl:justify-between xl:gap-8"><header class="min-w-0"><h2 class="font-heading text-lg font-bold uppercase leading-tight tracking-[0.06em] text-mlbb-text sm:text-2xl"><span class="text-mlbb-gold-bright">Aamon</span> <span class="text-mlbb-text/85">Best Builds, Emblems</span> <span class="text-mlbb-text/60">&amp;</span> <span class="text-mlbb-text/85">Talents</span></h2><p class="mt-1 hidden max-w-3xl text-sm text-mlbb-text-secondary sm:block xl:hidden">Three battle-tested loadouts. Pick the one that fits the draft, not the one with the most flash.</p><div class="mt-1.5 flex flex-wrap items-center gap-x-2.5 gap-y-1"><span class="font-heading text-[10px] font-bold uppercase tracking-[0.2em] text-text-muted">Patch <!-- -->2.1.67</span><span title="These loadouts were last re-read on patch 2.1.67; the live patch is 2.2.16a. Item stats may have changed." class="inline-flex flex-shrink-0 items-center gap-1 border border-amber-400/25 bg-amber-400/10 px-1.5 py-0.5 font-heading te