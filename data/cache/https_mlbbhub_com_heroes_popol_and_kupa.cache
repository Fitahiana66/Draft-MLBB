upa/Hero946-portrait-20240114142734.webp\",\"splashUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/popol-and-kupa/Popol-and-Kupa-Spirit-of-the-Brush-20231029204904.webp\",\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Popol_and_Kupa/Cosmetics\"},{\"name\":\"Proto Hunter\",\"tier\":\"Exceptional\",\"rawTier\":\"Exceptional\",\"tag\":\"AS 2025\",\"tagSlug\":\"as-2025\",\"price\":\"Limited-time Event\",\"portraitFile\":\"Hero947-portrait.png\",\"portraitUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/popol-and-kupa/Hero947-portrait-20250522142828.webp\",\"splashUrl\":null,\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Popol_and_Kupa/Cosmetics\"},{\"name\":\"Flamehide Thane\",\"tier\":\"Common\",\"rawTier\":\"Common\",\"tag\":null,\"tagSlug\":null,\"price\":\"Season 42\",\"portraitFile\":null,\"portraitUrl\":null,\"splashUrl\":null,\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Popol_and_Kupa/Cosmetics\"},{\"name\":\"Proto Stalker\",\"tier\":\"Exceptional\",\"rawTier\":\"Exceptional\",\"tag\":null,\"tagSlug\":null,\"price\":\"Limited-time Event\",\"portraitFile\":null,\"portraitUrl\":null,\"splashUrl\":null,\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Popol_and_Kupa/Cosmetics\"},{\"name\":\"Icefang Thane\",\"tier\":\"Common\",\"rawTier\":\"Common\",\"tag\":null,\"tagSlug\":null,\"price\":\"Season 42\",\"portraitFile\":null,\"portraitUrl\":null,\"splashUrl\":null,\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Popol_and_Kupa/Cosmetics\"}],\"lore\":{\"backstory\":\"Popol is a young hunter from the frozen Northern Vale, and Kupa is his fiercely loyal wolf companion. The two have been inseparable since Popol found Kupa as a wounded pup during a blizzard, nursing the wolf back to health. Together they developed a hunting style where Popol fires crossbow bolts to mark targets while Kupa charges in for the kill. Their traps and coordinated attacks make them masters of territorial control. When the Abyss threatened the Northern Vale, Popol and Kupa ventured south, their bond strong enough to face any darkness together.\",\"allies\":[{\"heroSlug\":\"barats\",\"heroName\":\"Barats\",\"relationship\":\"Fellow human-beast duo and kindred spirits\"},{\"heroSlug\":\"jawhead\",\"heroName\":\"Jawhead\",\"relationship\":\"Companion-type fighter who understands partnership\"}],\"rivals\":[{\"heroSlug\":\"helcurt\",\"heroName\":\"Helcurt\",\"relationship\":\"Shadow predator that hunts Kupa in the darkness\"},{\"heroSlug\":\"moskov\",\"heroName\":\"Moskov\",\"relationship\":\"Dark spearman who threatens the Northern Vale\"}]},\"loreUrlName\":\"Popol-and-Kupa\",\"statsHistory\":[{\"date\":\"2026-09-07\",\"winRate\":52.07,\"pickRate\":0.27,\"banRate\":0.26},{\"date\":\"2026-09-10\",\"winRate\":51.97,\"pickRate\":0.27,\"banRate\":0.25},{\"date\":\"2026-09-16\",\"winRate\":52.5,\"pickRate\":0.27,\"banRate\":0.22},{\"date\":\"2026-09-28\",\"winRate\":53.52,\"pickRate\":0.46,\"banRate\":0.24},{\"date\":\"2026-10-02\",\"winRate\":53.84,\"pickRate\":0.46,\"banRate\":0.26},{\"date\":\"2026-10-09\",\"winRate\":54.29,\"pickRate\":0.46,\"banRate\":0.3},{\"date\":\"2026-10-17\",\"winRate\":54.7,\"pickRate\":0.4,\"banRate\":0.3}]},\"relatedHeroesSlot\":\"$L67\",\"statsSeoSlot\":\"$L68\",\"fieldManualSlot\":\"$L69\"}]\n61:[\"$\",\"$L6a\",null,{\"heroName\":\"Popol and Kupa\",\"heroSlug\":\"popol-and-kupa\",\"roles\":\"$60:props:hero:role\",\"lanes\":\"$60:props:hero:lane\",\"difficulty\":2,\"winRate\":54.7,\"pickRate\":0.4,\"banRate\":0.3,\"curatedBuilds\":\"$60:props:curatedBuilds\",\"topCounters\":\"$60:props:tabData:counterData:countersThisHero\",\"hasCounterPage\":true,\"hasRankStats\":true,\"locale\":\"en\",\"pageUrl\":\"https://mlbbhub.com/heroes/popol-and-kupa\",\"year\":2026}]\n62:[\"$\",\"link\",\"38\",{\"rel\":\"apple-touch-icon\",\"href\":\"/apple-icon.png?apple-icon.1u_yy08wt5z0k.png\",\"sizes\":\"180x180\",\"type\":\"image/png\"}]\n63:[\"$\",\"$L6b\",\"39\",{}]\n"])</script><script>self.__next_f.push([1,