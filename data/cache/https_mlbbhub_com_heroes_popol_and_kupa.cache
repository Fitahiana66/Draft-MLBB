oes/popol-and-kupa#build-jungle-tempo-pickoff\"}],\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://mlbbhub.com/heroes/popol-and-kupa\"},\"datePublished\":\"2026-04-20T00:00:00.000Z\",\"dateModified\":\"2026-05-13T00:00:00.000Z\",\"author\":{\"@type\":\"Organization\",\"name\":\"MLBBHub\",\"url\":\"https://mlbbhub.com\"}}5f:[\"$\",\"script\",\"2\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$65\"}}]\n60:[\"$\",\"$L66\",null,{\"hero\":{\"id\":94,\"name\":\"Popol and Kupa\",\"slug\":\"popol-and-kupa\",\"title\":\"Icefield Companions\",\"role\":[\"Marksman\"],\"specialty\":[\"Push\",\"Burst\"],\"lane\":[\"Jungle\",\"Gold\"],\"tier\":\"S\",\"difficulty\":2,\"releaseYear\":2020,\"stats\":{\"durability\":30,\"offense\":70,\"controlEffect\":70,\"difficulty\":60},\"winRate\":54.7,\"pickRate\":0.4,\"banRate\":0.3,\"counters\":{\"strongAgainst\":[{\"heroSlug\":\"lesley\",\"heroName\":\"Lesley\",\"advantage\":\"strong\",\"tip\":\"Kupa is powerful in combat, especially against Marksmen with lower sustainability such as Lesley and Brody.\"},{\"heroSlug\":\"brody\",\"heroName\":\"Brody\",\"advantage\":\"strong\",\"tip\":\"Kupa is powerful in combat, especially against Marksmen with lower sustainability such as Lesley and Brody.\"}],\"weakAgainst\":[{\"heroSlug\":\"gusion\",\"heroName\":\"Gusion\",\"advantage\":\"weak\",\"tip\":\"But since Popol and Kupa don't have any Blink skills\\nand Popol is quite squishy, they are at the mercy of more agile Assassins like Gusion and Karina.\"},{\"heroSlug\":\"karina\",\"heroName\":\"Karina\",\"advantage\":\"weak\",\"tip\":\"But since Popol and Kupa don't have any Blink skills\\nand Popol is quite squishy, they are at the mercy of more agile Assassins like Gusion and Karina.\"}]},\"splashArt\":\"https://akmweb.youngjoygame.com/web/svnres/file/mlbb/homepage/100_555eb8df475f57d6f01a1f2a2675671c.jpg\",\"portrait\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_1acbb23b9a50f412104047a60eb18808.png\",\"officialMatchups\":[{\"kind\":\"best_ally\",\"heroId\":\"44\",\"heroName\":\"Grock\",\"heroSlug\":\"grock\",\"icon\":\"https://akmwebstatic.yuanzhanapp.com/web/madmin/image_47c9a9a373919fd9cc0c68ff7788b32a.png\",\"tip\":\"Grock, Diggie and Aurora\"},{\"kind\":\"counters\",\"heroId\":\"40\",\"heroName\":\"Karrie\",\"heroSlug\":\"karrie\",\"icon\":\"https://akmwebstatic.yuanzhanapp.com/web/madmin/image_2ae89c203ad1488fa1af6b7e51dae488.png\",\"tip\":\"Karrie, Masha and Franco\"},{\"kind\":\"countered_by\",\"heroId\":\"51\",\"heroName\":\"Helcurt\",\"heroSlug\":\"helcurt\",\"icon\":\"https://akmwebstatic.yuanzhanapp.com/web/madmin/image_2baf1efb2d414acedf4a89b6fa330ad2.png\",\"tip\":\"Helcurt, Hanzo and Gusion\"}],\"skills\":{\"skills\":[{\"name\":\"We Are Friends\",\"type\":\"Passive\",\"description\":\"Kupa recovers 10% Max HP per second after not taking damage for 5s. When Kupa is killed, Popol can Pray for 3s to bring Kupa back to the battlefield. Cooldown: 30s.\\nEvery 3 consecutive attacks from Kupa will enhance Popol's next Basic Attack to deal (+220% Total Physical Attack) Physical Damage. Kupa has 2500 (+1200% Total Physical Attack) Max HP and inherits 100% of Popol's other attributes and passive equipment effects (excluding Jungling and Roaming equipment effects).\\nKupa deals an additional 120% damage against creeps.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Kupa recovers 10% Max HP per second after not taking damage for 5s. When Kupa is killed, Popol can \"},{\"type\":\"text\",\"text\":\"Pray\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" for 3s to bring Kupa back to the battlefield. Cooldown: 30s.\\nEvery 3 consecutive attacks from Kupa will enhance Popol's next Basic Attack to deal \"},{\"type\":\"text\",\"text\":\" (+220% Total Physical Attack)\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Physical Damage\",\"color\":\"#fb1f1f\"},{\"type\":\"text\",\"text\":\". Kupa has 2500\"},{\"type\":\"text\",\"text\":\" (+1200% Total Physical Attack)\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" Max HP and inherits 100% of Popol's other attributes and passive equipment effects (excluding Jungling and Roaming equipment effects).\\nKupa deals an additional 120% damage against creeps.\"}],\"cooldown\":null,\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_ae294efaf8078fdb791495649aac563d.png\",\"tags\":[\"Buff\"]},{\"name\":\"Bite 'em, Kupa!\",\"type\":\"Skill 1\",\"description\":\"Popol throws a spear at the target enemy, dealing 80 (+100% Total Physical Attack) Physical Damage while simultaneously commanding Kupa to lunge at the target, dealing an additional 70 (+75% Total Physical Attack) Physical Damage. Kupa will continue to attack the target for 3s.\\nAlpha Wolf Form: Kupa stuns the enemy for 1s and bites them 3 times in quick succession.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Popol throws a spear at the target enemy, dealing 80\"},{\"type\":\"text\",\"text\":\" (+100% Total Physical Attack)\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Physical Damage\",\"color\":\"#fb1f1f\"},{\"type\":\"text\",\"text\":\" while simultaneously commanding Kupa to lunge at the target, dealing an additional 70\"},{\"type\":\"text\",\"text\":\" (+75% Total Physical Attack)\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Physical Damage\",\"color\":\"#fb1f1f\"},{\"type\":\"text\",\"text\":\". Kupa will continue to attack the target for 3s.\\n\"},{\"type\":\"text\",\"text\":\"Alpha Wolf Form\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\": Kupa stuns the enemy for 1s and bites them 3 times in quick succession.\"}],\"cooldown\":\"7s\",\"manaCost\":\"50\",\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_e643949b1a1f58f30614b08b446a3f85.png\",\"tags\":[\"Damage\",\"CC\"]},{\"name\":\"Kupa, Help!\",\"type\":\"Skill 2\",\"description\":\"Popol summons Kupa back to his side, gaining a 240 (+200% Extra Physical Attack) shield while dealing 240 (+50% Total Physical Attack) Physical Damage to nearby enemies and slowing them by 35% for 0.5s. Kupa will then assist Popol to attack nearby enemies for 3s.\\nAlpha Wolf Form: Kupa darts back to Popol, knocking nearby enemies airborne for 0.2s. The shield and damage are increased to 125%.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Popol summons Kupa back to his side, gaining a 240\"},{\"type\":\"text\",\"text\":\" (+200% Extra Physical Attack)\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" shield while dealing 240\"},{\"type\":\"text\",\"text\":\" (+50% Total Physical Attack)\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Physical Damage\",\"color\":\"#fb1f1f\"},{\"type\":\"text\",\"text\":\" to nearby enemies and slowing them by 35% for 0.5s. Kupa will then assist Popol to attack nearby enemies for 3s.\\n\"},{\"type\":\"text\",\"text\":\"Alpha Wolf Form\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\": Kupa darts back to Popol, knocking nearby enemies airborne for 0.2s. The shield and damage are increased to 125%.\"}],\"cooldown\":\"5.5s\",\"manaCost\":\"50\",\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_ccfd9569e5240ea46584ec0b1db669e8.png\",\"tags\":[\"CC\",\"AOE\"]},{\"name\":\"Popol's Surprise\",\"type\":\"Skill 3\",\"description\":\"Popol sets a trap at the target location that will detonate after a short delay once triggered, dealing 70 (+20% Total Magic Power) Magic Damage to the enemy that steps on it, immobilizing them for 1s, and creating a frost zone for 4s. Enemies in the frost zone will have their Movement Speed reduced by 20%.\\nPopol gains a trap charge every 22s (up to 3). Up to 3 traps can exist at the same time on the battlefield, each lasting up to 60s.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Popol sets a trap at the target location that will detonate after a short delay once triggered, dealing 70\"},{\"type\":\"text\",\"text\":\" (+20% Total Magic Power)\",\"color\":\"#62f8fe\"},{\"type\":\"text\",\"text\":\" Magic Damage to the enemy that steps on it, immobilizing them for 1s, and creating a frost zone for 4s. Enemies in the frost zone will have their Movement Speed reduced by 20%.\\nPopol gains a trap charge every 22s (up to 3). Up to 3 traps can exist at the same time on the battlefield, each lasting up to 60s.\"}],\"cooldown\":\"1.5s\",\"manaCost\":\"50\",\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_8e90afefec90b007f23efd1d8a89f0dd.png\",\"tags\":[\"Summon\",\"CC\"]},{\"name\":\"We Are Angry!\",\"type\":\"Ultimate\",\"description\":\"Popol and Kupa enter the Enraged state for 12s, gaining 15% extra Movement Speed and increasing their Attack Speed to 1.3 times.\\nKupa turns into Alpha Wolf Form, gaining 1500 Max HP, fully recovering its HP, while enhancing its other skills.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Popol and Kupa enter the \"},{\"type\":\"text\",\"text\":\"Enraged\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" state for 12s, gaining 15% extra Movement Speed and increasing their Attack Speed to 1.3 times.\\nKupa turns into \"},{\"type\":\"text\",\"text\":\"Alpha Wolf Form\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\", gaining 1500 Max HP, fully recovering its HP, while \"},{\"type\":\"text\",\"text\":\"enhancing\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" its other skills.\"}],\"cooldown\":\"38s\",\"manaCost\":\"100\",\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_247d588d97c1dffa73391a55002ed308.png\",\"tags\":[\"Buff\"]}],\"skillUpgradePriority\":\"4-1-2-3\",\"skillPriorityTip\":\"1st Skill-2nd SKill-4th Skill-3rd Skill\",\"skillPriorityTipRich\":[{\"type\":\"text\",\"text\":\"1st Skill-2nd SKill-4th Skill-3rd Skill\"}]},\"synergies\":[{\"heroSlug\":\"alpha\",\"heroName\":\"Alpha\",\"synergyScore\":8,\"reason\":\"Popol and Kupa are best with Fighters that can charge into enemies' midst and ensure the survival of Popol and Kupa after controlling and killing enemies. For example, Alpha and Khaleed.\"},{\"heroSlug\":\"khaleed\",\"heroName\":\"Khaleed\",\"synergyScore\":8,\"reason\":\"Popol and Kupa are best with Fighters that can charge into enemies' midst and ensure the survival of Popol and Kupa after controlling and killing enemies. For example, Alpha and Khaleed.\"}],\"combos\":[{\"type\":\"teamfight\",\"title\":\"TEAMFIGHT COMBOS\",\"description\":\"In teamfights, boost Attack Speed with their Ultimate\\r\\nand control enemies with the enhanced 1st Skill for heavy damage. When enemies are close, use the enhanced 2nd Skill for protection.\",\"skillSequence\":[{\"skillId\":9440,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_247d588d97c1dffa73391a55002ed308.png\"},{\"skillId\":9413,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_bdd55dca8cccb8db6059ed36a7bf4150.png\"},{\"skillId\":9400,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_f98d2e98eaebfb31c6c5101cf1c3201a.png\"},{\"skillId\":9423,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_041619eeff63fa6b8ec5bee9c3af5591.png\"}]},{\"type\":\"laning\",\"title\":\"LANING COMBOS\",\"description\":\"In the laning phase, poke enemies with the 1st Skill\\r\\nand get more Attack Speed with their Ultimate when enemies are low on HP. Then control and kill the enemies with the enhanced 1st Skill.\",\"skillSequence\":[{\"skillId\":9410,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_e643949b1a1f58f30614b08b446a3f85.png\"},{\"skillId\":9400,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_f98d2e98eaebfb31c6c5101cf1c3201a.png\"},{\"skillId\":9440,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_247d588d97c1dffa73391a55002ed308.png\"},{\"skillId\":9413,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_bdd55dca8cccb8db6059ed36a7bf4150.png\"},{\"skillId\":9400,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_f98d2e98eaebfb31c6c5101cf1c3201a.png\"}]}],\"metaDescription\":\"Popol and Kupa build, counter, and strategy guide for Mobile Legends. Gold lane and jungle draft rules, trap setups, teamfight timing, and flex items.\",\"builds\":[],\"overviewLede\":\"Popol and Kupa is a marksman for players who want to decide where the fight can happen before it starts. He wins by shrinking the map with traps, tagging the first target that steps wrong, and cashing that mistake into tower pressure. Pick him when your draft wants controlled corridors, not when you need a free-scaling backline gunner.\"},\"serverLocale\":\"en\",\"curatedBuilds\":{\"source\":\"curated\",\"hero\":\"popol-and-kupa\",\"patch\":\"2.1.67\",\"lastReviewed\":\"2026-05-13\",\"stalePatch\":true,\"currentPatch\":\"2.2.16a\",\"builds\":[{\"slot\":1,\"id\":\"gold-pickoff-default\",\"name\":\"Gold Lane Pickoff\",\"roleContext\":\"Gold\",\"items\":[{\"slug\":\"swift-boots\",\"name\":\"Swift Boots\",\"cost\":710,\"fixed\":false},{\"slug\":\"blade-of-despair\",\"name\":\"Blade of Despair\",\"cost\":3010,\"fixed\":false},{\"slug\":\"demon-hunter-sword\",\"name\":\"Demon Hunter Sword\",\"cost\":2180,\"fixed\":false},{\"slug\":\"great-dragon-spear\",\"name\":\"Great Dragon Spear\",\"cost\":2140,\"fixed\":false},{\"slug\":\"malefic-gun\",\"name\":\"Malefic Gun\",\"cost\":2120,\"fixed\":false},{\"slug\":\"wind-of-nature\",\"name\":\"Wind of Nature\",\"cost\":1910,\"fixed\":false}],\"coreItems\":[{\"slug\":\"blade-of-despair\",\"name\":\"Blade of Despair\"},{\"slug\":\"demon-hunter-sword\",\"name\":\"Demon Hunter Sword\"},{\"slug\":\"great-dragon-spear\",\"name\":\"Great Dragon Spear\"}],\"emblem\":{\"slug\":\"marksman\",\"name\":\"Marksman Emblem\",\"talents\":[{\"slug\":\"swift\",\"name\":\"Swift\",\"iconUrl\":\"/images/talents/swift.png\",\"bucket\":\"standard\"},{\"slug\":\"weapon-master\",\"name\":\"Weapon Master\",\"iconUrl\":\"/images/talents/weapon-master.png\",\"bucket\":\"standard\"},{\"slug\":\"quantum-charge\",\"name\":\"Quantum Charge\",\"iconUrl\":\"/images/talents/quantum-charge.png\",\"bucket\":\"core\"}]},\"spell\":{\"slug\":\"flicker\",\"name\":\"Flicker\"},\"blessing\":null,\"flexItems\":[{\"item\":{\"slug\":\"rose-gold-meteor\",\"name\":\"Rose Gold Meteor\"},\"replace\":{\"slug\":\"wind-of-nature\",\"name\":\"Wind of Nature\"},\"trigger\":\"Use against magic or mixed burst when physical immunity will not stop the first dive.\"},{\"item\":{\"slug\":\"sea-halberd\",\"name\":\"Sea Halberd\"},\"replace\":{\"slug\":\"malefic-gun\",\"name\":\"Malefic Gun\"},\"trigger\":\"Use when healing, shields, or high-extra-HP front liners keep the first trapped target alive.\"},{\"item\":{\"slug\":\"immortality\",\"name\":\"Immortality\"},\"replace\":{\"slug\":\"wind-of-nature\",\"name\":\"Wind of Nature\"},\"trigger\":\"Use when the game has reached one-death objective fights and the enemy cannot be answered by a single active immunity.\"}],\"notes\":\"Default gold lane setup that turns Popol's trap catch into a fast pick, then uses range or physical immunity to survive the answer.\",\"totalCost\":12070,\"statLines\":[{\"key\":\"physatk\",\"labelKey\":\"common.stats.physicalAttack\",\"unit\":\"flat\",\"group\":\"offensive\",\"value\":335,\"sources\":[\"Blade of Despair\",\"Demon Hunter Sword\",\"Great Dragon Spear\",\"Malefic Gun\",\"Wind of Nature\"]},{\"key\":\"critchance\",\"labelKey\":\"common.stats.criticalChance\",\"unit