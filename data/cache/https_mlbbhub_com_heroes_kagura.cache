-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path></svg><h2 class="text-lg md:text-xl font-heading font-bold text-text-primary">How to Counter<!-- --> <span style="color:#ff4444">Kagura</span></h2></div><p class="text-xs text-text-muted max-w-2xl">These heroes have the biggest measured edge against Kagura in ranked matches. Pick any of them for a statistical advantage in draft.</p></div><div class="space-y-3"><div class="group relative bg-surface-3 border border-mlbb-gold/15 hover:border-mlbb-green/30 transition-all duration-300" style="opacity:0;transform:translateY(12px)"><div class="flex items-center gap-3 p-3 sm:gap-4 sm:p-4"><div class="flex-shrink-0 w-7 sm:w-8 text-center"><span class="text-base sm:text-lg font-heading font-bold text-text-accent">#<!-- -->1</span></div><a class="flex-shrink-0" href="/heroes/harith"><div class="relative overflow-hidden flex-shrink-0 rounded-full" style="width:48px;height:48px;min-width:48px;background-color:#9B59B612"><img alt="Harith hero icon" loading="lazy" width="48" height="48" decoding="async" data-nimg="1" class="h-full w-full object-cover" style="color:transparent" srcSet="https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_d228a823b477fdf6c458c829c2e62bcf.png&amp;w=48&amp;output=webp&amp;q=75&amp;we 1x, https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_d228a823b477fdf6c458c829c2e62bcf.png&amp;w=96&amp;output=webp&amp;q=75&amp;we 2x" src="https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_d228a823b477fdf6c458c829c2e62bcf.png&amp;w=96&amp;output=webp&amp;q=75&amp;we"/></div></a><div class="min-w-0 flex-1"><div class="flex items-center gap-2 sm:gap-3 flex-wrap"><a class="min-w-0 max-w-full truncate font-heading font-bold text-base sm:text-lg text-text-primary hover:text-text-accent-bright transition-co