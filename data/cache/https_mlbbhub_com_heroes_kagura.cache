\"},\"replace\":{\"slug\":\"wishing-lantern\",\"name\":\"Wishing Lantern\"},\"trigger\":\"Use when enemy carries are the only targets that matter and your team already has tank damage.\"},{\"item\":{\"slug\":\"ice-queen-wand\",\"name\":\"Ice Queen Wand\"},\"replace\":{\"slug\":\"holy-crystal\",\"name\":\"Holy Crystal\"},\"trigger\":\"Use when your team needs repeated umbrella slows to keep durable enemies inside follow-up damage.\"}],\"notes\":\"Cooldown and burn setup for long objective fights where Kagura needs more umbrella cycles, anti-sustain pressure, and current-HP damage.\",\"totalCost\":12050,\"statLines\":[{\"key\":\"magicpower\",\"labelKey\":\"common.stats.magicPower\",\"unit\":\"flat\",\"group\":\"offensive\",\"value\":435,\"sources\":[\"Enchanted Talisman\",\"Glowing Wand\",\"Wishing Lantern\",\"Divine Glaive\",\"Holy Crystal\"]},{\"key\":\"magicpen\",\"labelKey\":\"common.stats.magicPenetration\",\"unit\":\"percent\",\"group\":\"offensive\",\"value\":40,\"sources\":[\"Divine Glaive\"]},{\"key\":\"hp\",\"labelKey\":\"common.stats.hp\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":600,\"sources\":[\"Enchanted Talisman\",\"Glowing Wand\"]},{\"key\":\"mp\",\"labelKey\":\"common.stats.mana\",\"unit\":\"flat\",\"group\":\"utility\",\"value\":400,\"sources\":[\"Wishing Lantern\"]},{\"key\":\"movespeed\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"flat\",\"group\":\"utility\",\"value\":40,\"sources\":[\"Magic Boots\"]},{\"key\":\"movespeedPct\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"percent\",\"group\":\"utility\",\"value\":5,\"sources\":[\"Glowing Wand\"]},{\"key\":\"cdreduction\",\"labelKey\":\"common.stats.cooldownReduction\",\"unit\":\"percent\",\"group\":\"utility\",\"value\":35,\"sources\":[\"Magic Boots\",\"Enchanted Talisman\",\"Wishing Lantern\"]}],\"conflicts\":[],\"simulatorUrl\":\"/build-simulator?hero=kagura\u0026items=magic-boots%2Cenchanted-talisman%2Cglowing-wand%2Cwishing-lantern%2Cdivine-glaive%2Choly-crystal\