lg:grid-cols-[minmax(0,1fr)_clamp(230px,24%,300px)] lg:gap-x-6 xl:gap-x-8 lg:items-start\",\"children\":[[\"$\",\"div\",null,{\"className\":\"lg:order-2 lg:sticky lg:self-start\",\"style\":{\"top\":128},\"children\":[\"$\",\"$L7d\",null,{\"target\":\"#hero-article\"}]}],[\"$\",\"section\",null,{\"id\":\"hero-article\",\"className\":\"relative lg:order-1 bg-[#0a0a0a]/85 backdrop-blur-sm border border-[#C8AA6E]/15 p-5 md:p-9 overflow-hidden\",\"style\":{\"boxShadow\":\"0 1px 0 rgba(255,255,255,0.03) inset, 0 18px 38px -24px rgba(0,0,0,0.8)\"},\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[#F0D060]/55 to-transparent\",\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"absolute top-0 left-0 w-3 h-3 border-t border-l border-[#F0D060]/40\",\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"absolute top-0 right-0 w-3 h-3 border-t border-r border-[#C8AA6E]/30\",\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"absolute bottom-0 left-0 w-3 h-3 border-b border-l border-[#C8AA6E]/30\",\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"absolute bottom-0 right-0 w-3 h-3 border-b border-r border-[#C8AA6E]/30\",\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"absolute -top-32 -right-24 w-72 h-72 rounded-full bg-[#C8AA6E]/[0.05] blur-3xl pointer-events-none\",\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"relative hero-article-body max-w-[860px] mx-auto\",\"children\":[[[[\"$\",\"h2\",\"h2-0\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Is this a Kagura draft?\"]}],\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Kagura is the right mid when three conditions are true at the same time: your team has at least one hard engage (Tigreal, Atlas, Khufra, or Franco as an ally who locks a 2-hero cluster), the enemy is stacking squishy backline with weak peel (Bruno plus Pharsa plus Estes type comps), and the enemy has nothing that suppresses or hard-CCs through her S2 cleanse.\"}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[\"Her current kit math rewards this read. S1 is cheap and strong at low ranks, so her lane bully phase is real. Patch 2.2.16 (\",[\"$\",\"$L40\",\"a-0\",{\"href\":\"/patch-notes\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"patch notes\"}],\") improved the umbrella itself: it now moves faster the farther it travels, so long-range pokes are harder to step out of and the reposition-then-teleport sequence sets up faster. The ultimate trades flat damage for a short cooldown and a small mana cost. The practical effect is more burst windows per fight and less penalty for missing one, which makes her more forgiving in the pocket-assassin role and less reliant on a single perfect one-shot.\"]}],\"\\n\",[\"$\",\"p\",\"p-2\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"She is a trap pick against Franco, Akai, Barats in his giant form, Khufra bounce-ult, and a competent Lancelot or Saber who can dive her mid. If your tank is Baxia (no hard lock) or Gatotkaca (telegraphed pull), she has no engage partner and her damage gets kited out. If your team has zero peel in the mid-late game, you become the cooldown-check every time S2 is down.\"}],\"\\n\",\"$L7e\",\"\\n\",\"$L7f\",\"\\n\",\"$L80\",\"\\n\",\"$L81\",\"\\n\",\"$L82\",\"\\n\",\"$L83\",\"\\n\",\"$L84\",\"\\n\",\"$L85\",\"\\n\",\"$L86\",\"\\n\",\"$L87\",\"\\n\",\"$L88\",\"\\n\",\"$L89\",\"\\n\",\"$L8a\"],\"$L8b\",\"$L8c\"],\"$L8d\"]}]]}]]}]\n"])</script><script>self.__next_f.push([1,"a2:I[392015,[\"$7\",\"$8\",\"$9\",\"$a\",\"$b\",\"$2e\",\"$3e\",\"$3f\"],\"default\"]\nb2:I[131354,[\"$7\",\"$8\",\"$9\",\"$a\",\"$b\",\"$2e\",\"$3e\",\"$3f\"],\"default\"]\n6d:[\"$\",\"$L6a\",\"zhask\",{\"href\":\"/heroes/zhask\",\"className\":\"group block\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative bg-surface-4 border border-mlbb-gold/20 overflow-hidden card-hover hover:border-mlbb-gold/50\",\"style\":{\"boxShadow\":\"0 2px 8px rgba(0,0,0,0.3)\"},\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 p-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative w-14 h-14 rounded-full overflow-hidden flex-shrink-0 bg-surface-3\",\"children\":[\"$\",\"$L6b\",null,{\"src\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_d8f170087cb2d5b71bb22a0a4664a927.png\",\"alt\":\"Zhask - The King of Swarms\",\"unoptimized\":false,\"priority\":\"$undefined\",\"fetchPriority\":\"$undefined\",\"fill\":true,\"className\":\"object-cover group-hover:scale-110 transition-transform duration-300\",\"sizes\":\"56px\",\"placeholder\":\"blur\",\"blurDataURL\":\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTAwIiBoZWlnaHQ9IjEwMCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48cmVjdCB3aWR0aD0iMTAwIiBoZWlnaHQ9IjEwMCIgZmlsbD0iIzBkMTIyNSIvPjwvc3ZnPg==\"}]}],[\"$\",\"div\",null,{\"className\":\"flex-1 min-w-0\",\"children\":[[\"$\",\"h4\",null,{\"className\":\"font-heading font-bold text-text-primary group-hover:text-text-accent-bright transition-colors truncate\",\"children\":\"Zhask\"}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mt-0.5\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-[10px] font-heading uppercase tracking-wider px-1.5 py-0.5\",\"style\":{\"backgroundColor\":\"#9B59B620\",\"color\":\"#b98bcc\",\"border\":\"1px solid #9B59B640\"},\"children\":\"Mage\"}],[\"$\",\"$L6c\",null,