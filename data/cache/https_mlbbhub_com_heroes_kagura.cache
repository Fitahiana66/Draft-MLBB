0.5" style="background-color:#FF8C0020;color:#ffaf4d">Fighter</span></div></div><p class="text-xs text-text-muted mt-1 line-clamp-2">Across Kagura&#x27;s measured matchups, Kagura is strongest in the early game. Control the tempo against Silvanna before the game opens up.</p></div><div class="flex-shrink-0 text-right"><p class="flex items-center justify-end gap-1 text-lg sm:text-xl font-heading font-bold" style="color:#C8AA6E"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trending-down w-3.5 h-3.5" aria-hidden="true"><path d="M16 17h6v-6"></path><path d="m22 17-8.5-8.5-5 5L2 7"></path></svg>+<!-- -->1.7</p><p class="text-[9px] text-text-muted uppercase hidden sm:block">win rate delta</p></div></div><div class="absolute top-0 left-0 w-3 h-3 border-t border-l border-mlbb-gold/20 pointer-events-none"></div><div class="absolute bottom-0 right-0 w-3 h-3 border-b border-r border-mlbb-gold/20 pointer-events-none"></div></div><div class="group relative bg-surface-3 border border-mlbb-gold/15 hover:border-mlbb-green/30 transition-all duration-300" style="opacity:0;transform:translateY(12px)"><div class="flex items-center gap-3 p-3 sm:gap-4 sm:p-4"><div class="flex-shrink-0 w-7 sm:w-8 text-center"><span class="text-base sm:text-lg font-heading font-bold text-text-accent">#<!-- -->5</span></div><a class="flex-shrink-0" href="/heroes/hanzo"><div class="relative overflow-hidden flex-shrink-0 rounded-full" style="width:48px;height:48px;min-width:48px;background-color:#00AAFF12"><img alt="Hanzo hero icon" loading="lazy" width="48" height="48" decoding="async" data-nimg="1" class="h-full w-full object-cover" style="color:transparent" srcSet="https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_d2d28d2fcb060726fa27553920ca1a33.png&amp;w=48&amp;output=webp&amp;q=75&amp;we 1x, https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_d2d28d2fcb060726fa27553920ca1a33.png&amp;w=96&amp;output=webp&amp;q=75&amp;we 2x" src="https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_d2d28d2fcb060726fa27553920ca1a33.png&amp;w=96&amp;output=webp&amp;q=75&amp;we"/></div></a><div class="min-w-0 flex-1"><div class="flex items-center gap-2 sm:gap-3 flex-wrap"><a class="min-w-0 max-w-full truncate font-heading font-bold text-base sm:text-lg text-text-primary hover:text-text-accent-bright transition-colors" href="/heroes/hanzo">Hanzo</a><div class="inline-flex items-center justify-center font-heading font-bold bg-gradient-to-br from-[#00AAFF] to-[#0077CC] text-[#00111a] shadow-[0_0_12px_rgba(0,170,255,0.3)] w-6 h-6 text-xs animate-tier-pop">B</div><div class="gap-1.5 hidden sm:flex"><span class="text-[10px] px-1.5 py-0.5" style="background-color:#00AAFF20;color:#4dc4ff">Assassin</span></div></div><p class="text-xs text-text-muted mt-1 line-clamp-2">Across Kagura&#x27;s measured matchups, Kagura is strongest in the early game. Control the tempo against Hanzo before the game opens up.</p></div><div class="flex-shrink-0 text-right"><p class="flex items-center justify-end gap-1 text-lg sm:text-xl font-heading font-bold" style="color:#C8AA6E"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trending-down w-3.5 h-3.5" aria-hidden="true"><path d="M16 17h6v-6"></path><path d="m22 17-8.5-8.5-5 5L2 7"></path></svg>+<!-- -->1.7</p><p class="text-[9px] text-text-muted uppercase hidden sm:block">win rate delta</p></div></div><div class="absolute top-0 left-0 w-3 h-3 border-t border-l border-mlbb-gold/20 pointer-events-none"></div><div class="absolute bottom-0 right-0 w-3 h-3 border-b border-r border-mlbb-gold/20 pointer-events-none"></div></div></div></section></div><section class="grid gap-3 md:grid-cols-3"><a class="block" href="/heroes/hayabusa"><div class="h-full border border-mlbb-gold/18 bg-surface-2/82 p-4 transition-colors hover:border-mlbb-gold-bright/35"><p class="mb-1 font-heading text-[10px] font-bold uppercase tracking-[0.16em] text-text-accent">Official Ally Note</p><h3 class="font-heading text-base font-bold text-text-primary">Hayabusa</h3><p class="mt-2 text-xs leading-relaxed text-text-muted">Hayabusa is Kagura&#x27;s childhood playmate, and they also make a good team. First attacker will be the assassin to slow the enemy down, then when Hayabusa casts his 3rd skill, Kagura can assist to deal damage to the enemy and end it.</p></div></a><a class="block" href="/heroes/layla"><div class="h-full border border-mlbb-gold/18 bg-surface-2/82 p-4 transition-colors hover:border-mlbb-gold-bright/35"><p class="mb-1 font-heading text-[10px] font-bold uppercase tracking-[0.16em] text-text-accent">Official Counter Note</p><h3 class="font-heading text-base font-bold text-text-primary">Layla</h3><p class="mt-2 text-xs leading-relaxed text-text-muted">Kagura can deal an amount of Killing damage to Layla as she has low defense, unless Layla has balanced offense and defense gear set. Kagura can fastly kill Layla when doing her combo. But if Layla survives, she will deal large damage to Kagura and lifesteal.</p></div></a><a class="block" href="/heroes/harley"><div class="h-full border border-mlbb-gold/18 bg-surface-2/82 p-4 transition-colors hover:border-mlbb-gold-bright/35"><p class="mb-1 font-heading text-[10px] font-bold uppercase tracking-[0.16em] text-text-accent">Official Threat Note</p><h3 class="font-heading text-base font-bold text-text-primary">Harley</h3><p class="mt-2 text-xs leading-relaxed text-text-muted">Basically, Harley can counter Kagura because he can teleport then teleport back in his positions. Unlike Kagura that can only teleport once to her umbrella (because of the cooldown). But that does not mean Kagura cannot stand a chance against Harley. If Harley made his move first before Kagura, she will stagger and get low health before she can attack Harley. There are also cases that when Kagura threw her umbrella, Harley then used his 3rd Skill to Kagura, slowing her down and making her very vulnerable. Kagura can&#x27;t use her 2nd Skill: Active 1 which is her jump that removes debuff when she doesn&#x27;t have her umbrella. That&#x27;s why be careful when fighting Harley.</p></div></a></section><section><div class="mb-4"><div class="flex items-center gap-3 mb-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock w-5 h-5 text-text-accent-bright" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg><h2 class="text-lg md:text-xl font-heading font-bold text-text-primary">Game Phase Analysis for<!-- --> <span style="color:#F0D060">Kagura</span></h2></div><p class="text-xs text-text-muted max-w-2xl">Kagura is strongest in the early game: across the 10 matchups measured for them, Kagura does best before the 10-minute mark and falls off as matches run long. Avoid early skirmishes and punish Kagura once the game opens up.</p></div><div class="grid grid-cols-1 sm:grid-cols-3 gap-4"><div class="bg-surface-3 border border-mlbb-gold/15 p-4" style="opacity:0;transform:translateY(15px)"><div class="flex items-center justify-between mb-1"><span class="text-xs font-heading font-bold text-text-primary uppercase tracking-wider">Early Game</span><span class="text-[10px] text-text-muted">0-10 min</span></div><p class="text-base font-heading font-bold mb-2" style="color:#44ff88">Kagura peaks here</p><div class="w-full h-2 bg-surface-4 overflow-hidden"><div class="h-full" style="background-color:#44ff88;width:0px"></div></div></div><div class="bg-surface-3 border border-mlbb-gold/15 p-4" style="opacity:0;transform:translateY(15px)"><div class="flex items-center justify-between mb-1"><span class="text-xs font-heading font-bold text-text-primary uppercase tracking-wider">Mid Game</span><span class="text-[10px] text-text-muted">10-16 min</span></div><p class="text-base font-heading font-bold mb-2" style="color:#F0D060">In between</p><div class="w-full h-2 bg-surface-4 overflow-hidden"><div class="h-full" style="background-color:#F0D060;width:0px"></div></div></div><div class="bg-surface-3 border border-mlbb-gold/15 p-4" style="opacity:0;transform:translateY(15px)"><div class="flex items-center justify-between mb-1"><span class="text-xs font-heading font-bold text-text-primary uppercase tracking-wider">Late Game</span><span class="text-[10px] text-text-muted">16+ min</span></div><p class="text-base font-heading font-bold mb-2" style="color:#ff4444">Kagura dips here</p><div class="w-full h-2 bg-surface-4 overflow-hidden"><div class="h-full" style="background-color:#ff4444;width:0px"></div></div></div></div><p class="text-[10px] text-text-muted/80 mt-3 max-w-3xl">Shape only, from the 10 matchups measured for Kagura. The bars rank Kagura&#x27;s own phases against each other, not against other heroes, and are not win rates.</p></section></div></div><div id="tabpanel-builds" role="tabpanel" aria-labelledby="tab-builds" tabindex="0" hidden=""><section class="space-y-3 sm:space-y-4"><div class="flex flex-col gap-3 xl:flex-row xl:items-end xl:justify-between xl:gap-8"><header class="min-w-0"><h2 class="font-heading text-lg font-bold uppercase leading-tight tracking-[0.06em] text-mlbb-text sm:text-2xl"><span class="text-mlbb-gold-bright">Kagura</span> <span class="text-mlbb-text/85">Best Builds, Emblems</span> <span class="text-mlbb-text/60">&amp;</span> <span class="text-mlbb-text/85">Talents</span></h2><p class="mt-1 hidden max-w-3xl text-sm text-mlbb-text-secondary sm:block xl:hidden">Three battle-tested loadouts. Pick the one that fits the draft, not the one with the most flash.</p><div class="mt-1.5 flex flex-wrap items-center gap-x-2.5 gap-y-1"><span class="font-heading text-[10px] font-bold uppercase tracking-[0.2em] text-text-muted">Patch <!-- -->2.1.67</span><span title="These loadouts were last re-read on patch 2.1.67; the live patch is 2.2.16a. Item stats may have changed." class="inline-flex flex-shrink-0 items-center gap-1 border border-amber-400/25 bg-amber-400/10 px-1.5 py-0.5 font-heading text-[9px] font-bold uppercase leading-none tracking-[0.1em] text-amber-300/90"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-history h-2.5 w-2.5" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path><path d="M12 7v5l4 2"></path></svg>Older patch</span><span class="font-heading text-[10px] font-bold uppercase tracking-[0.2em] text-text-accent/70">Reviewed May 13, 2026</span></div></header><div role="tablist" aria-label="Builds" class="grid gap-1.5 sm:gap-2 xl:w-[620px] xl:shrink-0" style="grid-template-columns:repeat(3, minmax(0, 1fr))"><button type="button" role="tab" id="build-tab-1" aria-selected="true" aria-controls="build-1" class="relative flex min-h-[44px] min-w-0 cursor-pointer items-center gap-2 border px-2 py-1.5 text-left transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mlbb-gold sm:px-3 sm:py-2 border-mlbb-gold-bright/60 bg-mlbb-gold/10"><span class="font-heading text-[11px] font-bold tabular-nums sm:text-xs text-text-accent-bright" aria-hidden="true">01</span><span class="min-w-0 font-heading text-[10px] font-bold uppercase leading-tight tracking-wide line-clamp-3 sm:line-clamp-2 sm:text-xs text-mlbb-text">Mid Clock Burst</span></button><button type="button" role="tab" id="build-tab-2" aria-selected="false" aria-controls="build-2" class="relative flex min-h-[44px] min-w-0 cursor-pointer items-center gap-2 border px-2 py-1.5 text-left transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mlbb-gold sm:px-3 sm:py-2 border-mlbb-gold/18 bg-surface-2/70 hover:border-mlbb-gold/40"><span class="font-heading text-[11px] font-bold tabular-nums sm:text-xs text-text-accent/70" aria-hidden="true">02</span><span class="min-w-0 font-heading text-[10px] font-bold uppercase leading-tight tracking-wide line-clamp-3 sm:line-clamp-2 sm:text-xs text-mlbb-text-secondary">Frontline CDR Burn</span></button><button type="button" role="tab" id="build-tab-3" aria-selected="false" aria-controls="build-3" class="relative flex min-h-[44px] min-w-0 cursor-pointer items-center gap-2 border px-2 py-1.5 text-left transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mlbb-gold sm:px-3 sm:py-2 border-mlbb-gold/18 bg-surface-2/70 hover:border-mlbb-gold/40"><span class="font-heading text-[11px] font-bold tabular-nums sm:text-xs text-text-accent/70" aria-hidden="true">03</span><span class="min-w-0 font-heading text-[10px] font-bold uppercase leading-tight tracking-wide line-clamp-3 sm:line-clamp-2 sm:text-xs text-mlbb-text-secondary">Anti-Dive Safety</span></button></div></div><article id="build-1" role="tabpanel" aria-labelledby="build-tab-1" class="group/build relative overflow-hidden border border-mlbb-gold/22 bg-surface-2/92 scroll-mt-24" style="box-shadow:0 1px 0 rgba(255,255,255,0.04) inset, 0 30px 60px -36px rgba(0,0,0,0.95);opacity:0;transform:translateY(24px)"><div class="pointer-events-none absolute inset-0 opacity-[0.06] hex-pattern" aria-hidden="true"></div><div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-mlbb-gold-bright/80 to-transparent" aria-hidden="true"></div><div class="pointer-events-none absolute left-0 top-0 h-full w-[3px] bg-gradient-to-b from-mlbb-gold-bright/