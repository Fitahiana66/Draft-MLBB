gic Boots\"},{\"@type\":\"HowToSupply\",\"name\":\"Enchanted Talisman\"},{\"@type\":\"HowToSupply\",\"name\":\"Glowing Wand\"},{\"@type\":\"HowToSupply\",\"name\":\"Wishing Lantern\"},{\"@type\":\"HowToSupply\",\"name\":\"Divine Glaive\"},{\"@type\":\"HowToSupply\",\"name\":\"Holy Crystal\"}],\"tool\":[{\"@type\":\"HowToTool\",\"name\":\"Mage Emblem\"},{\"@type\":\"HowToTool\",\"name\":\"Flameshot Battle Spell\"}],\"step\":[{\"@type\":\"HowToStep\",\"position\":1,\"name\":\"Buy Magic Boots\",\"text\":\"Purchase Magic Boots (710 gold) as item 1 in the Frontline CDR Burn build for Kagura.\",\"url\":\"https://mlbbhub.com/heroes/kagura#build-mid-frontline-cdr\"},{\"@type\":\"HowToStep\",\"position\":2,\"name\":\"Buy Enchanted Talisman\",\"text\":\"Purchase Enchanted Talisman (2,070 gold) as item 2 in the Frontline CDR Burn build for Kagura.\",\"url\":\"https://mlbbhub.com/heroes/kagura#build-mid-frontline-cdr\"},{\"@type\":\"HowToStep\",\"position\":3,\"name\":\"Buy Glowing Wand\",\"text\":\"Purchase Glowing Wand (2,050 gold) as item 3 in the Frontline CDR Burn build for Kagura.\",\"url\":\"https://mlbbhub.com/heroes/kagura#build-mid-frontline-cdr\"},{\"@type\":\"HowToStep\",\"position\":4,\"name\":\"Buy Wishing Lantern\",\"text\":\"Purchase Wishing Lantern (2,250 gold) as item 4 in the Frontline CDR Burn build for Kagura.\",\"url\":\"https://mlbbhub.com/heroes/kagura#build-mid-frontline-cdr\"},{\"@type\":\"HowToStep\",\"position\":5,\"name\":\"Buy Divine Glaive\",\"text\":\"Purchase Divine Glaive (1,970 gold) as item 5 in the Frontline CDR Burn build for Kagura.\",\"url\":\"https://mlbbhub.com/heroes/kagura#build-mid-frontline-cdr\"},{\"@type\":\"HowToStep\",\"position\":6,\"name\":\"Buy Holy Crystal\",\"text\":\"Purchase Holy Crystal (3,000 gold) as item 6 in the Frontline CDR Burn build for Kagura.\",\"url\":\"https://mlbbhub.com/heroes/kagura#build-mid-frontline-cdr\"}],\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://mlbbhub.com/heroes/kagura\"},\"datePublished\":\"2026-04-18T00:00:00.000Z\",\"dateModified\":\"2026-05-13T00:00:00.000Z\",\"author\":{\"@type\":\"Organization\",\"name\":\"MLBBHub\",\"url\":\"https://mlbbhub.com\"}}5e:[\"$\",\"script\",\"1\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$63\"}}]\n64:T8da,{\"@context\":\"https://schema.org\",\"@type\":\"HowTo\",\"name\":\"How to Build Kagura in Mobile Legends: Anti-Dive Safety\",\"description\":\"Defensive mid build for suppressive pick comps and assassin-heavy drafts where one saved combo matters more than maximum damage.\",\"totalTime\":\"PT15M\",\"supply\":[{\"@type\":\"HowToSupply\",\"name\":\"Tough Boots\"},{\"@type\":\"HowToSupply\",\"name\":\"Clock of Destiny\"},{\"@type\":\"HowToSupply\",\"name\":\"Lightning Truncheon\"},{\"@type\":\"HowToSupply\",\"name\":\"Winter Crown\"},{\"@type\":\"HowToSupply\",\"name\":\"Divine Glaive\"},{\"@type\":\"HowToSupply\",\"name\":\"Blood Wings\"}],\"tool\":[{\"@type\":\"HowToTool\",\"name\":\"Mage Emblem\"},{\"@type\":\"HowToTool\",\"name\":\"Flicker Battle Spell\"}],\"step\":[{\"@type\":\"HowToStep\",\"position\":1,\"name\":\"Buy Tough Boots\",\"text\":\"Purchase Tough Boots (700 gold) as item 1 in the Anti-Dive Safety build for Kagura.\",\"url\":\"https://mlbbhub.com/heroes/kagura#build-mid-anti-dive\"},{\"@type\":\"HowToStep\",\"position\":2,\"name\":\"Buy Clock of Destiny\",\"text\":\"Purchase Clock of Destiny (2,030 gold) as item 2 in the Anti-Dive Safety build for Kagura.\",\"url\":\"https://mlbbhub.com/heroes/kagura#build-mid-anti-dive\"},{\"@type\":\"HowToStep\",\"position\":3,\"name\":\"Buy Lightning Truncheon\",\"text\":\"Purchase Lightning Truncheon (2,250 gold) as item 3 in the Anti-Dive Safety build for Kagura.\",\"url\":\"https://mlbbhub.com/heroes/kagura#build-mid-anti-dive\"},{\"@type\":\"HowToStep\",\"position\":4,\"name\":\"Buy Winter Crown\",\"text\":\"Purchase Winter Crown (1,910 gold) as item 4 in the Anti-Dive Safety build for Kagura.\",\"url\":\"https://mlbbhub.com/heroes/kagura#build-mid-anti-dive\"},{\"@type\":\"HowToStep\",\"position\":5,\"name\":\"Buy Divine Glaive\",\"text\":\"Purchase Divine Glaive (1,970 gold) as item 5 in the Anti-Dive Safety build for Kagura.\",\"url\":\"https://mlbbhub.com/heroes/kagura#build-mid-anti-dive\"},{\"@type\":\"HowToStep\",\"position\":6,\"name\":\"Buy Blood Wings\",\"text\":\"Purchase Blood Wings (2,100 gold) as item 6 in the Anti-Dive Safety build for Kagura.\",\"url\":\"https://mlbbhub.com/heroes/kagura#build-mid-anti-dive\"}],\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://mlbbhub.com/heroes/kagura\"},\"datePublished\":\"2026-04-18T00:00:00.000Z\",\"dateModified\":\"2026-05-13T00:00:00.000Z\",\"author\":{\"@type\":\"Organization\",\"name\":\"MLBBHub\",\"url\":\"https://mlbbhub.com\"}}5f:[\"$\",\"script\",\"2\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$64\"}}]\n60:[\"$\",\"$L65\",null,{\"hero\":{\"id\":25,\"name\":\"Kagura\",\"slug\":\"kagura\",\"title\":\"Onmyouji Master\",\"role\":[\"Mage\"],\"specialty\":[\"Poke\",\"Finisher\"],\"lane\":[\"Mid\"],\"tier\":\"A\",\"difficulty\":3,\"releaseYear\":2016,\"stats\":{\"durability\":30,\"offense\":90,\"controlEffect\":40,\"difficulty\":90},\"winRate\":51.8,\"pickRate\":0.73,\"banRate\":1.13,\"counters\":{\"strongAgainst\":[{\"heroSlug\":\"layla\",\"heroName\":\"Layla\",\"advantage\":\"strong\",\"tip\":\"Kagura's Ultimate can deal high burst damage, making her strong against back-row heroes with no dash or blink, such as Layla and Eudora.\"},{\"heroSlug\":\"eudora\",\"heroName\":\"Eudora\",\"advantage\":\"strong\",\"tip\":\"Kagura's Ultimate can deal high burst damage, making her strong against back-row heroes with no dash or blink, such as Layla and Eudora.\"}],\"weakAgainst\":[{\"heroSlug\":\"joy\",\"heroName\":\"Joy\",\"advantage\":\"weak\",\"tip\":\"Kagura is countered by heroes with more than one control immunity abilities that allow them to escape her various CC skills, heroes like Joy and Martis are good examples.\"},{\"heroSlug\":\"martis\",\"heroName\":\"Martis\",\"advantage\":\"weak\",\"tip\":\"Kagura is countered by heroes with more than one control immunity abilities that allow them to escape her various CC skills, heroes like Joy and Martis are good examples.\"}]},\"splashArt\":\"https://akmweb.youngjoygame.com/web/svnres/file/mlbb/homepage/100_64bda78279297278301e236555a15404.jpg\",\"portrait\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_da424b020b8ac8235d64a1b8a09aa749.png\",\"officialMatchups\":[{\"kind\":\"best_ally\",\"heroId\":\"21\",\"heroName\":\"Hayabusa\",\"heroSlug\":\"hayabusa\",\"icon\":\"https://akmweb.youngjoygame.com/web/madmin/image/3de2f55e701a340a02f1828e79cdb9fa.png?w=150-150-1f1820\",\"tip\":\"Hayabusa is Kagura's childhood playmate, and they also make a good team. First attacker will be the assassin to slow the enemy down, then when Hayabusa casts his 3rd skill, Kagura can assist to deal damage to the enemy and end it.\"},{\"kind\":\"counters\",\"heroId\":\"18\",\"heroName\":\"Layla\",\"heroSlug\":\"layla\",\"icon\":\"https://akmwebstatic.yuanzhanapp.com/web/madmin/image_a05a03db633cc03ef3f733d2786073c4.jpg\",\"tip\":\"Kagura can deal an amount of Killing damage to Layla as she has low defense, unless Layla has balanced offense and defense gear set. Kagura can fastly kill Layla when doing her combo. But if Layla survives, she will deal large damage to Kagura and lifesteal.\"},{\"kind\":\"countered_by\",\"heroId\":\"42\",\"heroName\":\"Harley\",\"heroSlug\":\"harley\",\"icon\":\"https://akmwebstatic.yuanzhanapp.com/web/madmin/image_a2f1d7806d874283c83913f14a533bb0.png\",\"tip\":\"Basically, Harley can counter Kagura because he can teleport then teleport back in his positions. Unlike Kagura that can only teleport once to her umbrella (because of the cooldown). But that does not mean Kagura cannot stand a chance against Harley. If Harley made his move first before Kagura, she will stagger and get low health before she can attack Harley. There are also cases that when Kagura threw her umbrella, Harley then used his 3rd Skill to Kagura, slowing her down and making her very vulnerable. Kagura can't use her 2nd Skill: Active 1 which is her jump that removes debuff when she doesn't have her umbrella. That's why be careful when fighting Harley.\"}],\"skills\":{\"skills\":[{\"name\":\"Yin Yang Gathering \",\"type\":\"Passive\",\"description\":\"Upon retrieving the Seimei Umbrella, Kagura gains a 450 (+80% Total Magic Power) shield, stuns nearby enemies for 0.5s, and slows them by 60% for 1s. Cooldown: 4.5s.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Upon retrieving the \"},{\"type\":\"text\",\"text\":\"Seimei Umbrella\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\", Kagura gains a 450\"},{\"type\":\"text\",\"text\":\" (+80% Total Magic Power)\",\"color\":\"#62f8fe\"},{\"type\":\"text\",\"text\":\" shield, stuns nearby enemies for 0.5s, and slows them by 60% for 1s. Cooldown: 4.5s.\"}],\"cooldown\":null,\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_f022f5769cb87dee7944160a24f03b79.png\",\"tags\":[\"Shield\",\"CC\"]},{\"name\":\"Seimei Umbrella Open \",\"type\":\"Skill 1\",\"description\":\"Kagura sends the Seimei Umbrella to the target location, dealing 365 (+105% Total Magic Power) Magic Damage to enemies in its path and slowing them by 60% for 0.5s. The Umbrella will automatically return to Kagura when she's too far away.\\nThis skill deals 130% damage to non-hero enemies.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Kagura sends the \"},{\"type\":\"text\",\"text\":\"Seimei Umbrella\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" to the target location, dealing 365\"},{\"type\":\"text\",\"text\":\" (+105% Total Magic Power)\",\"color\":\"#62f8fe\"},{\"type\":\"text\",\"text\":\" Magic Damage to enemies in its path and slowing them by 60% for 0.5s. The Umbrella will automatically return to Kagura when she's too far away.\\nThis skill deals 130% damage to non-hero enemies.\"}],\"cooldown\":\"5s\",\"manaCost\":\"45\",\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_cc6ff81df0961e494e8c5f3e42f582fe.png\",\"tags\":[\"Damage\",\"Slow\"]},{\"name\":\"Rasho Umbrella Flee\",\"type\":\"Skill 2\",\"description\":\"Kagura removes all debuffs on her and leaps in the target direction, while leaving the Seimei Umbrella behind.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Kagura removes all debuffs on her and leaps in the target direction, while leaving the \"},{\"type\":\"text\",\"text\":\"Seimei Umbrella\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" behind.\"}],\"cooldown\":\"12s\",\"manaCost\":\"55\",\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_292caeb01278d75ba3e02457e9ddb603.png\",\"tags\":[\"Remove CC\",\"Mobility\"]},{\"name\":\"Yin Yang Overturn\",\"type\":\"Ultimate\",\"description\":\"Kagura invokes the power of the Seimei Umbrella, dealing 250 (+95% Total Magic Power) Magic Damage to nearby enemies, knocking them back, and slowing them by 60% for 0.5s.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Kagura invokes the power of the \"},{\"type\":\"text\",\"text\":\"Seimei Umbrella\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\", dealing 250\"},{\"type\":\"text\",\"text\":\" (+95% Total Magic Power)\",\"color\":\"#62f8fe\"},{\"type\":\"text\",\"text\":\" Magic Damage to nearby enemies, knocking them back, and slowing them by 60% for 0.5s.\"}],\"cooldown\":\"36s\",\"manaCost\":\"60\",\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_07f828b02ce64ae8ded3b3ede8893b53.png\",\"tags\":[\"CC\",\"Burst\"]}],\"skillUpgradePriority\":\"3-1-2\",\"skillPriorityTip\":\"Kagura's damage must be prioritized. Her second skill is only teleport and escape, which can be used now once or later or maybe even not when not being grappled in the whole game. Her second skill is used once. Prioritize Seimei Umbrella Open and Yin Yang Overturn in order to maximize the damage can be dealt.\\nFlicker is another way to instantly teleport to a specified direction. Kagura can use Flicker in case her second skill is still on cooldown. And she can use this in various other ways.\",\"skillPriorityTipRich\":[{\"type\":\"text\",\"text\":\"Kagura's damage must be prioritized. Her second skill is only teleport and escape, which can be used now once or later or maybe even not when not being grappled in the whole game. Her second skill is used once. Prioritize Seimei Umbrella Open and Yin Yang Overturn in order to maximize the damage can be dealt.\"},{\"type\":\"lineBreak\"},{\"type\":\"text\",\"text\":\"Flicker is another way to instantly teleport to a specified direction. Kagura can use Flicker in case her second skill is still on cooldown. And she can use this in various other ways.\"}]},\"synergies\":[{\"heroSlug\":\"atlas\",\"heroName\":\"Atlas\",\"synergyScore\":8,\"reason\":\"Kagura works well with tank heroes with strong CC skills that allow her to deal more damage with her Ultimate, such as Atlas and Tigreal.\"},{\"heroSlug\":\"tigreal\",\"heroName\":\"Tigreal\",\"synergyScore\":8,\"reason\":\"Kagura works well with tank heroes with strong CC skills that allow her to deal more damage with her Ultimate, such as Atlas and Tigreal.\"}],\"combos\":[{\"type\":\"teamfight\",\"title\":\"TEAMFIGHT COMBOS\",\"description\":\"Kagura should place her Umbrella between the enemies with her 1st Skill, then use her Ultimate to reset the cooldown for her 1st Skill to be able to adjust the Umbrella location before teleporting to the Umbrella location to stun nearby enemies. She should then use her Ultimate + 2nd Skill combo to escape from the fighting zone.\",\"skillSequence\":[{\"skillId\":2510,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_cc6ff81df0961e494e8c5f3e42f582fe.png\"},{\"skillId\":2531,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_0329949e3af570f3c65b46f1d12bf637.png\"},{\"skillId\":2511,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_8df435b74a7fcd429e89dd381e5ea452.png\"},{\"skillId\":2521,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_210c67437a6d0722052086bfcca1e20d.png\"},{\"skillId\":2530,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_07f828b02ce64ae8ded3b3ede8893b53.png\"},{\"skillId\":2520,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_292caeb01278d75ba3e02457e9ddb603.png\"}]},{\"type\":\"laning\",\"title\":\"LANING COMBOS\",\"description\":\"Kagura can use her 1st Skill to poke the enemy with her Umbrella, then her 2nd Skill to teleport to the Umbrella's location, dealing more damage to the enemies and dash back by casting her 2nd Skill again.\",\"skillSequence\":[{\"skillId\":2510,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_cc6ff81df0961e494e8c5f3e42f582fe.png\"},{\"skillId\":2521,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_210c67437a6d0722052086bfcca1e20d.png\"},{\"skillId\":2520,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_292caeb01278d75ba3e02457e9ddb603.png\"}]}],\"metaDescription\":\"Kagura build, counter, and strategy guide for Mobile Legends. Clock + Truncheon spike, Franco counter, combo order, and umbrella positioning for mid roams.\",\"builds\":[],\"overviewLede\":\"Kagura is a displacement mage who happens to deal damage. Every other mid is priced on the burst they throw; Kagura is priced on the ground she controls with the Seimei Umbrella. The pick is only correct when your team specifically needs a pocket assassin who does not require peel to land her combo.\"},\"serverLocale\":\"en\",\"curatedBuilds\":{\"source\":\"curated\",\"hero\":\"kagura\",\"patch\":\"2.1.67\",\"lastReviewed\":\"2026-05-13\",\"stalePatch\":true,\"currentPatch\":\"2.2.16a\",\"builds\":[{\"slot\":1,\"id\":\"mid-clock-burst\",\"name\":\"Mid Clock Burst\",\"roleContext\":\"Mid\",\"items\":[{\"slug\":\"arcane-boots\",\"name\":\"Arcane Boots\",\"cost\":690,\"fixed\":false},{\"slug\":\"clock-of-destiny\",\"name\":\"Clock of Destiny\",\"cost\":2030,\"fixed\":false},{\"slug\":\"lightning-truncheon\",\"name\":\"Lightning Truncheon\",\"cost\":2250,\"fixed\":false},{\"slug\":\"genius-wand\",\"name\":\"Genius Wand\",\"cost\":2000,\"fixed\":false},{\"slug\":\"divine-glaive\",\"name\":\"Divine Glaive\",\"cost\":1970,\"fixed\":false},{\"slug\":\"holy-crystal\",\"name\":\"Holy Crystal\",\"cost\":3000,\"fixed\":false}],\"coreItems\":[{\"slug\":\"clock-of-destiny\",\"name\":\"Clock of Destiny\"},{\"slug\":\"lightning-truncheon\",\"name\":\"Lightning Truncheon\"},{\"slug\":\"genius-wand\",\"name\":\"Genius Wand\"}],\"emblem\":{\"slug\":\"mage\",\"name\":\"Mage Emblem\",\"talents\":[{\"slug\":\"rupture\",\"name\":\"Rupture\",\"iconUrl\":\"/images/talents/rupture.png\",\"bucket\":\"standard\"},{\"slug\":\"weapon-master\",\"name\":\"Weapon Master\",\"iconUrl\":\"/images/talents/weapon-master.png\",\"bucket\":\"standard\"},{\"slug\":\"lethal-ignition\",\"name\":\"Lethal Ignition\",\"iconUrl\":\"/images/talents/lethal-ignition.png\",\"bucket\":\"core\"}]},\"spell\":{\"slug\":\"flicker\",\"name\":\"Flicker\"},\"blessing\":null,\"flexItems\":[{\"item\":{\"slug\":\"blood-wings\",\"name\":\"Blood Wings\"},\"replace\":{\"slug\":\"holy-crystal\",\"name\":\"Holy Crystal\"},\"trigger\":\"Use when late fights are decided by surviving the first dive after the umbrella combo lands.\"},{\"item\":{\"slug\":\"winter-crown\",\"name\":\"Winter Crown\"},\"replace\":{\"slug\":\"holy-crystal\",\"name\":\"Holy Crystal\"},\"trigger\":\"Use against Ling, Hayabusa, Saber, or any dive that can kill Kagura before she retrieves the umbrella.\"},{\"item\":{\"slug\":\"glowing-wand\",\"name\":\"Glowing Wand\"},\"replace\":{\"slug\":\"genius-wand\",\"name\":\"Genius Wand\"},\"trigger\":\"Use when your team lacks anti-heal into Estes, Floryn, Uranus, Ruby, or heavy shield drafts.\"}],\"notes\":\"Default ranked mid build that turns the Clock and Truncheon spike into reliable backline burst, then adds layered penetration for late magic defense.\",\"totalCost\":11940,\"statLines\":[{\"key\":\"magicpower\",\"labelKey\":\"common.stats.magicPower\",\"unit\":\"flat\",\"group\":\"offensive\",\"value\":420,\"sources\":[\"Clock of Destiny\",\"Lightning Truncheon\",\"Genius Wand\",\"Divine Glaive\",\"Holy Crystal\"]},{\"key\":\"magicpen\",\"labelKey\":\"common.stats.magicPenetration\",\"unit\":\"percent\",\"group\":\"offensive\",\"value\":40,\"sources\":[\"Divine Glaive\"]},{\"key\":\"magicpenFlat\",\"labelKey\":\"common.stats.magicPenetration\",\"unit\":\"flat\",\"group\":\"offensive\",\"value\":20,\"sources\":[\"Arcane Boots\",\"Genius Wand\"]},{\"key\":\"hp\",\"labelKey\":\"common.stats.hp\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":400,\"sources\":[\"Clock of Destiny\"]},{\"key\":\"mp\",\"labelKey\":\"common.stats.mana\",\"unit\":\"flat\",\"group\":\"utility\",\"value\":800,\"sources\":[\"Clock of Destiny\",\"Lightning Truncheon\"]},{\"key\":\"movespeed\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"flat\",\"group\":\"utility\",\"value\":40,\"sources\":[\"Arcane Boots\"]},{\"key\":\"movespeedPct\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"percent\",\"group\":\"utility\",\"value\":5,\"sources\":[\"Genius Wand\"]},{\"key\":\"cdreduction\",\"labelKey\":\"common.stats.cooldownReduction\",\"unit\":\"percent\",\"group\":\"utility\",\"value\":20,\"sources\":[\"Clock of Destiny\",\"Lightning Truncheon\"]}],\"conflicts\":[],\"simulatorUrl\":\"/build-simulato