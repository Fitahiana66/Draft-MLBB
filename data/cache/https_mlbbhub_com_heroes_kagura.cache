:\"text-text-primary\",\"children\":[\"1.19\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Mythic\"}}]]}]\na0:[\"$\",\"article\",\"mythical_honor\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #C8AA6E, #C8AA6E33)\",\"boxShadow\":\"0 0 12px -2px #C8AA6E80\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#C8AA6E\",\"background\":\"#C8AA6E1a\",\"border\":\"1px solid #C8AA6E40\"},\"children\":\"Mythical Honor\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Kagura\",\"rank\":\"Mythical Honor\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=mythical_honor\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Mythical Honor\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Mythical Honor\",\"name\":\"Kagura\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"51.80\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Kagura\",\"delta\":\"+0.08%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.83\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"1.17\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Mythical Honor\"}}]]}]]}]\na1:[\"$\",\"article\",\"mythical_glory\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #ff5d73, #ff5d7333)\",\"boxShadow\":\"0 0 12px -2px #ff5d7380\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#ff5d73\",\"background\":\"#ff5d731a\",\"border\":\"1px solid #ff5d7340\"},\"children\":\"Mythical Glory+\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Kagura\",\"rank\":\"Mythical Glory+\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=mythical_glory\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Mythical Glory+\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Mythical Glory+\",\"name\":\"Kagura\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"51.17\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Kagura\",\"delta\":\"-0.55%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"1.12\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.92\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Mythical Glory+\"}}]]}]]}]\na3:[\"$\",\"p\",\"p-3\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Slot 5 is the penetration question. Divine Glaive when any frontliner builds Athena's Shield, Oracle, or Radiant Armor; its Spellbreaker passive scales off the enemy's magic defense and caps at 20% penetration per target. Genius Wand when the enemy stacks multiple moderate-magic-defense targets (two junglers plus a support); the stacking magic defense debuff from Genius applies to every target you hit, not just the first. Default is Divine Glaive unless the loading screen shows two Radiant Armors.\"}]\na4:[\"$\",\"p\",\"p-4\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Slot 6 is the survival question. Winter Crown when the enemy has a single high-burst threat (Eudora ult, Gusion, Aamon) that you need to bait out. Activate Frozen the instant their screen animation tells you the burst skill is coming. Immortality when the enemy team is a wipe comp and you expect to die in every fight (Chou plus Selena plus Yin style). Concentrated Energy when your team is snowballing and you want the Recharge passive to stack magic power off your constant poking, then cash the full-stack magic damage bonus in the next fight.\"}]\na5:[\"$\",\"p\",\"p-5\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Ice Queen Wand is a trap at MLBB's rank brackets. The movement speed is nice, the slow barely matters because S1 already slows heavily, and the spell vamp does not save you from the ways Kagura actually dies, which are one Franco hook, one Eudora stun, or one Gusion combo. Buy one of the three slot-6 options above instead.\"}]\na6:[\"$\",\"p\",\"p-6\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Sky Piercer is the weakest common default. It looks great on paper (execute threshold, stacking bonus on kills) but it replaces a multiplier item with a flat damage item, and Kagura's problem at two items is not \\\"I cannot finish\\\" but \\\"I cannot start the fight safely\\\". Take it only in the burst-build swap when you are already 4-0 and want to close the match before minute 18.\"}]\na7:[\"$\",\"h2\",\"h2-2\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Mistakes that lose Kagura games\"]}]\na8:[\"$\",\"p\",\"p-7\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Teleporting to the umbrella the moment it lands.\"}],\" The S2 teleport is a commit button, not a mobility tool. Pressing it the instant the umbrella reaches its destination tells the enemy assassin exactly where you will be a third of a second from now. Throw the umbrella, step sideways, watch the enemy's reaction, and only teleport when you have confirmed the follow-up kill or the clean escape. The umbrella on the ground is a threat by itself; you do not always have to cash it in.\"]}]\na9:[\"$\",\"p\",\"p-8\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Using S2 to dodge Franco's hook.\"}],\" S2 cleanses debuffs but does not cleanse suppression. Bloody Hunt locks you in place regardless of whether you press S2 mid-pull. If you see Franco positioned in a bush angle, walk forward with the umbrella in hand, not with the umbrella on the ground. At least then you have the cleanse-dash available the moment his Iron Hook lands.\"]}]\naa:[\"$\",\"p\",\"p-9\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Throwing the umbrella away before the fight starts.\"}],\" Some players cast S1 across the map the second a teamfight begins, thinking it opens the combo. It does not. It hands the enemy assassin a free window: your only mobility is a fixed teleport back to the umbrella, your S3 is the delayed pull instead of the instant knockback, and the passive shield stays locked until you retrieve it. Hold the umbrella through the first engage, let your tank eat the CC, and cast once the target is locked and facing your team.\"]}]\nab:[\"$\",\"p\",\"p-10\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Ulting into three enemies without vision of the jungler.\"}],\" The with-umbrella S3 knockback shoves enemies away from you. If the enemy jungler (Lancelot, Fanny, Aamon) was hiding in the fog on your flank, knocking the tank back isolates you from your own team and puts you exactly where their jungler wanted you. Scout with S1 first. The umbrella reveals a small area when thrown, which is usually enough to check a bush.\"]}]\nac:[\"$\",\"p\",\"p-11\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Playing mid the entire game.\"}],\" Kagura's wave-clear lets her rotate every 90 seconds once Lightning Truncheon is online. If you are not leaving mid to help a sidelane or contest Turtle and Lord, you are playing 20% of the map. The mid laner most likely to win from a scoreline deficit is the one who is not in mid for half the game.\"]}]\nad:[\"$\",\"h2\",\"h2-3\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Key tips\"]}]\nae:[\"$\",\"div\",\"blockquote-0\",{\"className\":\"my-5 p-4 flex gap-3\",\"style\":{\"background\":\"rgba(200,170,110,0.08)\",\"border\":\"1px solid rgba(200,170,110,0.35)\"},\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-lightbulb w-4 h-4 flex-shrink-0 mt-0.5\",\"aria-hidden\":\"true\",\"style\":{\"color\":\"#C8AA6E\"},\"children\":[[\"$\",\"path\",\"1gvzjb\",{\"d\":\"M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5\"}],[\"$\",\"path\",\"x1upvd\",{\"d\":\"M9 18h6\"}],[\"$\",\"path\",\"ceow96\",{\"d\":\"M10 22h4\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[11px] font-heading font-bold uppercase tracking-wider mb-1\",\"style\":{\"color\":\"#C8AA6E\"},\"children\":\"Tip\"}],[[\"$\",\"p\",\"0\",{\"className\":\"text-sm text-[#9BA0B4] leading-relaxed\",\"children\":[\"The S3 reset on S1 only triggers when you cast the \\\"no umbrella\\\" version of the ultimate. If the umbrella is still in your hand when you ult, you do not get the S1 reset. This is why pro players throw the umbrella first, then ult: the reset lets them chain a second S1 displacement immediately after the pull lands.\"]}]]]}]]}]\naf:[\"$\",\"div\",\"blockquote-1\",{\"className\":\"my-5 p-4 flex gap-3\",\"style\":{\"background\":\"rgba(0,170,255,0.08)\",\"border\":\"1px solid rgba(0,170,255,0.35)\"},\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-info w-4 h-4 flex-shrink-0 mt-0.5\",\"aria-hidden\":\"true\",\"style\":{\"color\":\"#00AAFF\"},\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"1dtifu\",{\"d\":\"M12 16v-4\"}],[\"$\",\"path\",\"e9boi3\",{\"d\":\"M12 8h.01\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[11px] font-heading font-bold uppercase tracking-wider mb-1\",\"style\":{\"color\":\"#00AAFF\"},\"children\":\"Note\"}],[[\"$\",\"p\",\"0\",{\"className\":\"text-sm text-[#9BA0B4] leading-relaxed\",\"children\":[\"Kagura's S2 only passes through thin walls if the umbrella is already on the opposite side. This is how you escape jungle gank attempts at Turtle: throw the umbrella over the river wall first, then S2 to teleport through. Do not try to press S2 into terrain the umbrella did not land on; you will dash a short distance and die.\"]}]]]}]]}]\nb0:[\"$\",\"div\",\"blockquote-2\",{\"className\":\"my-5 p-4 flex gap-3\",\"style\":{\"background\":\"rgba(200,170,110,0.08)\",\"border\":\"1px solid rgba(200,170,110,0.35)\"},\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-lightbulb w-4 h-4 flex-shrink-0 mt-0.5\",\"aria-hidden\":\"true\",\"style\":{\"color\":\"#C8AA6E\"},\"children\":[[\"$\",\"path\",\"1gvzjb\",{\"d\":\"M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5\"}],[\"$\",\"path\",\"x1upvd\",{\"d\":\"M9 18h6\"}],[\"$\",\"path\",\"ceow96\",{\"d\":\"M10 22h4\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[11px] font-heading font-bold uppercase tracking-wider mb-1\",\"style\":{\"color\":\"#C8AA6E\"},\"children\":\"Tip\"}],[[\"$\",\"p\",\"0\",{\"className\":\"text-sm text-[#9BA0B4] leading-relaxed\",\"children\":[\"Buy Enchanted Talisman as a temporary third item if you are running out of mana inside the first fights. It is not part of the final build, but its mana-regen passive keeps you casting during the 12-to-18 minute window when Clock and Truncheon are not yet stacked enough. Sell it around minute 22 for Holy Crystal.\"]}]]]}]]}]\nb1:[\"$\",\"div\",\"blockquote-3\",{\"className\":\"my-5 p-4 flex gap-3\",\"style\":{\"background\":\"rgba(0,170,255,0.08)\",\"border\":\"1px solid rgba(0,170,255,0.35)\"},\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-info w-4 h-4 flex-shrink-0 mt-0.5\",\"aria-hidden\":\"true\",\"style\":{\"color\":\"#00AAFF\"},\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"1dtifu\",{\"d\":\"M12 16v-4\"}],[\"$\",\"path\",\"e9boi3\",{\"d\":\"M12 8h.01\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[11px] font-heading font-bold uppercase tracking-wider mb-1\",\"style\":{\"color\":\"#00AAFF\"},\"children\":\"Note\"}],[[\"$\",\"p\",\"0\",{\"className\":\"text-sm text-[#9BA0B4] leading-relaxed\",\"children\":[\"Lethal Ignition is the correct Core talent pick for the Mage Emblem loadout on Kagura. Her kit naturally clears the \\\"damage greater than 7% Max HP, three times within 5 seconds\\\" trigger inside a single rotation: S1, S3 pull, S2 teleport, and the passive stun all tag the same target in under four seconds. The scorch is free adaptive damage on top.\"]}]]]}]]}]\n"])</script></body></html>