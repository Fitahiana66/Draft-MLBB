:2021,\"stats\":{\"durability\":30,\"offense\":80,\"controlEffect\":10,\"difficulty\":70},\"winRate\":51.24,\"pickRate\":0.61,\"banRate\":0.4,\"counters\":{\"strongAgainst\":[{\"heroSlug\":\"hylos\",\"heroName\":\"Hylos\",\"advantage\":\"strong\",\"tip\":\"Beatrix is strong against heroes without movement abilities, as they can be easily hit by her skills, such as Hylos and Belerick.\"},{\"heroSlug\":\"belerick\",\"heroName\":\"Belerick\",\"advantage\":\"strong\",\"tip\":\"Beatrix is strong against heroes without movement abilities, as they can be easily hit by her skills, such as Hylos and Belerick.\"}],\"weakAgainst\":[{\"heroSlug\":\"eudora\",\"heroName\":\"Eudora\",\"advantage\":\"weak\",\"tip\":\"Beatrix is countered by high burst damage heroes with strong single-target CC, as they can catch her with a CC and burst her down. Such as Eudora and Ling.\"},{\"heroSlug\":\"ling\",\"heroName\":\"Ling\",\"advantage\":\"weak\",\"tip\":\"Beatrix is countered by high burst damage heroes with strong single-target CC, as they can catch her with a CC and burst her down. Such as Eudora and Ling.\"}]},\"splashArt\":\"https://akmweb.youngjoygame.com/web/svnres/file/mlbb/homepage/100_2f25a8ef9bbb2d52eaaea8d6eee85d22.jpg\",\"portrait\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_4687eca874feec9017b448a0b9110d65.png\",\"skills\":{\"skills\":[{\"name\":\"Mechanical Genius\",\"type\":\"Passive\",\"description\":\"Beatrix's talent for mechanics allowed her to produce 4 weapons of truly awe-inspiring firepower.\\n\\nRenner Basic Attack - Longshot: Fires a powerful shot in the target's direction, dealing (+365% Total Physical Attack) - (+400% Total Physical Attack) Physical Damage to the first target hit (75% damage against creeps). This shot can be dodged or blocked by others.\\n\\nBeatrix cannot Crit. She converts every 1% Crit Chance into 2 Physical Attack.\\nShe gains Spell Vamp equal to 100% of her Lifesteal.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Beatrix's talent for mechanics allowed her to produce 4 weapons of truly awe-inspiring firepower.\\n\\n\"},{\"type\":\"text\",\"text\":\"Renner\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" Basic Attack - Longshot: Fires a powerful shot in the target's direction, dealing \"},{\"type\":\"text\",\"text\":\" (+365% Total Physical Attack)\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" -\"},{\"type\":\"text\",\"text\":\" (+400% Total Physical Attack)\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Physical Damage\",\"color\":\"#fb1f1f\"},{\"type\":\"text\",\"text\":\" to the first target hit (75% damage against creeps). This shot can be dodged or blocked by others.\\n\\nBeatrix cannot Crit. She converts every 1% Crit Chance into 2 \"},{\"type\":\"text\",\"text\":\"Physical Attack\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\".\\nShe gains Spell Vamp equal to 100% of her Lifesteal.\"}],\"cooldown\":null,\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_a9d8911fcabb7aa02f885dac6cb376dc.png\",\"tags\":[\"Buff\"]},{\"name\":\"Masterful Gunner\",\"type\":\"Skill 1\",\"description\":\"Passive: Beatrix can carry 2 weapons at once, increasing her Physical Attack by 5.\\nActive: Beatrix takes 0.5s to swap her primary weapon with the secondary weapon, gaining a new Basic Attack and Ultimate.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Passive\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\": Beatrix can carry 2 weapons at once, increasing her \"},{\"type\":\"text\",\"text\":\"Physical Attack\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" by 5.\\n\"},{\"type\":\"text\",\"text\":\"Active\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\": Beatrix takes 0.5s to swap her primary weapon with the secondary weapon, gaining a new Basic Attack and Ultimate.\"}],\"cooldown\":\"12s\",\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_c59bfdb82953c1b910fda97509962795.png\",\"tags\":[\"Morph\",\"Buff\"]},{\"name\":\"Tactical Reposition\",\"type\":\"Skill 2\",\"description\":\"Beatrix rolls forward while fully reloading her current weapon.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Beatrix rolls forward while fully reloading her current weapon.\"}],\"cooldown\":null,\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_bb64cd50d3e37c9d8343716b796fb2cb.png\",\"tags\":[\"Mobility\",\"Buff\"]},{\"name\":\"Renner's Apathy\",\"type\":\"Skill 3\",\"description\":\"Beatrix calmly sets up Renner on the battlefield and takes aim. When releasing the skill, she deals 700 (+280% Total Physical Attack) Physical Damage to the first enemy hit.\\n\\nBeatrix can aim for up to 8s, and she can cancel it early to reduce the cooldown by 50%.\\n\\nThis shot can penetrate Minions and only deals 75% damage to non-hero units.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Beatrix calmly sets up \"},{\"type\":\"text\",\"text\":\"Renner\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" on the battlefield and takes aim. When releasing the skill, she deals 700\"},{\"type\":\"text\",\"text\":\" (+280% Total Physical Attack)\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Physical Damage\",\"color\":\"#fb1f1f\"},{\"type\":\"text\",\"text\":\" to the first enemy hit.\\n\\nBeatrix can aim for up to 8s, and she can cancel it early to reduce the cooldown by 50%.\\n\\nThis shot can penetrate Minions and only deals 75% damage to non-hero units.\"}],\"cooldown\":null,\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_5e6d76b308e486186c5e68846cdf4782.png\",\"tags\":[\"Burst\"]},{\"name\":\"Need Backup\",\"type\":\"Ultimate\",\"description\":\"Having escaped battle for 3s, Beatrix can call for her butler Morgan to provide her with a backup weapons crate.\\nBeatrix must then choose two from the crate to serve as her primary and secondary weapons.\\nHer weapon selection is interrupted if she commits any action or is controlled during this period.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Having escaped battle for 3s, Beatrix can call for her butler Morgan to provide her with a backup weapons crate.\\nBeatrix must then choose two from the crate to serve as her primary and secondary weapons.\\nHer weapon selection is interrupted if she commits any action or is controlled during this period.\"}],\"cooldown\":null,\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_10504a1a930e1e7c7de2f4f80dfdb0bd.png\",\"tags\":[\"Morph\"]}],\"skillUpgradePriority\":\"3-1-2\"},\"synergies\":[{\"heroSlug\":\"khufra\",\"heroName\":\"Khufra\",\"synergyScore\":8,\"reason\":\"Beatrix works best with tank heroes with good CC abilities, as they can help improve the accuracy of Beatrix's skills. Like Khufra and Atlas.\"},{\"heroSlug\":\"atlas\",\"heroName\":\"Atlas\",\"synergyScore\":8,\"reason\":\"Beatrix works best with tank heroes with good CC abilities, as they can help improve the accuracy of Beatrix's skills. Like Khufra and Atlas.\"}],\"combos\":[{\"type\":\"teamfight\",\"title\":\"TEAMFIGHT COMBOS\",\"description\":\"For teamfights, we recommend using Bennett as Beatrix's primary weapon and Nibiru as her secondary weapon. During a teamfight, Beatrix can use Bennett's Ultimate to strike the enemy team. Then she can use her 1st Skill to switch to Nibiru, and cast Nibiru's Ultimate to attack the enemy. She can finish off the enemy heroes with her Basic Attacks and her 2nd Skill.\",\"skillSequence\":[{\"skillId\":2010550,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_0cafa22d656d6a2c14cf5259d91762fa.png\"},{\"skillId\":2010510,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_c59bfdb82953c1b910fda97509962795.png\"},{\"skillId\":2010570,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_c3b4d741305b9662e5295a0425b2a1a7.png\"},{\"skillId\":10500,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_76a73f7fe9348d2717af6900969accf3.png\"},{\"skillId\":2010520,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_bb64cd50d3e37c9d8343716b796fb2cb.png\"},{\"skillId\":10500,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_76a73f7fe9348d2717af6900969accf3.png\"}]},{\"type\":\"laning\",\"title\":\"LANING COMBOS\",\"description\":\"In the laning phase, we recommend using Renner as Beatrix's primary weapon and Wesker as her secondary weapon. She can use Renner's ranged Basic Attack to poke the enemy, and her 2nd Skill to reload and fire again. She can then switch to Wesker to finish off the target enemy.\",\"skillSequence\":[{\"skillId\":10500,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_76a73f7fe9348d2717af6900969accf3.png\"},{\"skillId\":2010520,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_bb64cd50d3e37c9d8343716b796fb2cb.png\"},{\"skillId\":10500,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_76a73f7fe9348d2717af6900969accf3.png\"},{\"skillId\":2010510,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_c59bfdb82953c1b910fda97509962795.png\"},{\"skillId\":10500,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_76a73f7fe9348d2717af6900969accf3.png\"}]}],\"metaDescription\":\"Beatrix build, counter, and strategy guide for Mobile Legends. Weapon priority, the spell-vamp passive, and the peel supports she must draft behind to carry.\",\"builds\":[],\"overviewLede\":\"Beatrix is four marksmen stuffed into one hero, and most of her losses come from players bringing the wrong one to a fight. Her passive ties Spell Vamp directly to her Lifesteal, which turned her ultimate into a sustain tool. That changes the build, it does not change the draft rules: she still folds the moment the enemy has a hard answer to backline play.\"},\"serverLocale\":\"en\",\"curatedBuilds\":{\"source\":\"curated\",\"hero\":\"beatrix\",\"patch\":\"2.1.67\",\"lastReviewed\":\"2026-05-06\",\"stalePatch\":true,\"currentPatch\":\"2.2.16a\",\"builds\":[{\"slot\":1,\"id\":\"gold-range-burst\",\"name\":\"Gold Lane Range Burst\",\"roleContext\":\"Gold\",\"items\":[{\"slug\":\"swift-boots\",\"name\":\"Swift Boots\",\"cost\":710,\"fixed\":false},{\"slug\":\"blade-of-despair\",\"name\":\"Blade of Despair\",\"cost\":3010,\"fixed\":false},{\"slug\":\"hunter-strike\",\"name\":\"Hunter Strike\",\"cost\":2010,\"fixed\":false},{\"slug\":\"haass-claws\",\"name\":\"Haas's Claws\",\"cost\":2020,\"fixed\":false},{\"slug\":\"sea-halberd\",\"name\":\"Sea Halberd\",\"cost\":2050,\"fixed\":false},{\"slug\":\"malefic-gun\",\"name\":\"Malefic Gun\",\"cost\":2120,\"fixed\":false}],\"coreItems\":[{\"slug\":\"blade-of-despair\",\"name\":\"Blade of Despair\"},{\"slug\":\"hunter-strike\",\"name\":\"Hunter Strike\"},{\"slug\":\"malefic-gun\",\"name\":\"Malefic Gun\"}],\"emblem\":{\"slug\":\"assassin\",\"name\":\"Assassin Emblem\",\"talents\":[{\"slug\":\"rupture\",\"name\":\"Rupture\",\"iconUrl\":\"/images/talents/rupture.png\",\"bucket\":\"standard\"},{\"slug\":\"weapon-master\",\"name\":\"Weapon Master\",\"iconUrl\":\"/images/talents/weapon-master.png\",\"bucket\":\"standard\"},{\"slug\":\"quantum-charge\",\"name\":\"Quantum Charge\",\"iconUrl\":\"/images/talents/quantum-charge.png\",\"bucket\":\"core\"}]},\"spell\":{\"slug\":\"flicker\",\"name\":\"Flicker\"},\"blessing\":null,\"flexItems\":[{\"item\":{\"slug\":\"wind-of-nature\",\"name\":\"Wind of Nature\"},\"replace\":{\"slug\":\"sea-halberd\",\"name\":\"Sea Halberd\"},\"trigger\":\"Use when the main threat is physical burst and the enemy does not rely on heavy healing or shields.\"},{\"item\":{\"slug\":\"rose-gold-meteor\",\"name\":\"Rose Gold Meteor\"},\"replace\":{\"slug\":\"sea-halberd\",\"name\":\"Sea Halberd\"},\"trigger\":\"Use against mixed dive or magic burst where Wind of Nature does not stop the first engage.\"},{\"item\":{\"slug\":\"immortality\",\"name\":\"Immortality\"},\"replace\":{\"slug\":\"haass-claws\",\"name\":\"Haas's Claws\"},\"trigger\":\"Use in the final Lord fight when one death decides the game and your team can protect the revive.\"}],\"notes\":\"Default gold lane setup for Renner and Bennett pressure, rushing raw Physical Attack and penetration before Malefic Gun extends Beatrix's safe damage range.\",\"totalCost\":11920,\"statLines\":[{\"key\":\"physatk\",\"labelKey\":\"common.stats.physicalAttack\",\"unit\":\"flat\",\"group\":\"offensive\",\"value\":400,\"sources\":[\"Blade of Despair\",\"Hunter Strike\",\"Haas's Claws\",\"Sea Halberd\",\"Malefic Gun\"]},{\"key\":\"critchance\",\"labelKey\":\"common.stats.criticalChance\",\"unit\":\"percent\",\"group\":\"offensive\",\"value\":20,\"sources\":[\"Haas's Claws\"]},{\"key\":\"attackspeed\",\"labelKey\":\"common.stats.attackSpeed\",\"unit\":\"percent\",\"group\":\"offensive\",\"value\":70,\"sources\":[\"Swift Boots\",\"Haas's Claws\",\"Sea Halberd\",\"Malefic Gun\"]},{\"key\":\"physpenFlat\",\"labelKey\":\"common.stats.physicalPenetration\",\"unit\":\"flat\",\"group\":\"offensive\",\"value\":15,\"sources\":[\"Hunter Strike\"]},{\"key\":\"lifesteal\",\"labelKey\":\"common.stats.lifesteal\",\"unit\":\"percent\",\"group\":\"offensive\",\"value\":20,\"sources\":[\"Haas's Claws\"]},{\"key\":\"movespeed\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"flat\",\"group\":\"utility\",\"value\":40,\"sources\":[\"Swift Boots\"]},{\"key\":\"movespeedPct\"