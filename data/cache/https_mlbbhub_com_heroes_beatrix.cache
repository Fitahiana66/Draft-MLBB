acity-100 transition-opacity duration-300 pointer-events-none" style="background:linear-gradient(90deg, transparent, #E74C3C, transparent)"></div></div></a></div></div></div><div class="mt-6 text-center"><a class="inline-flex items-center gap-2 text-sm text-text-accent hover:text-text-accent-bright transition-colors font-heading uppercase tracking-wider" href="/heroes">Browse All Heroes<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right w-4 h-4" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></a></div></section></div></section></div><section class="content-lazy relative border-t border-border-subtle py-12 md:py-16" aria-labelledby="hero-faq-heading"><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","@id":"https://mlbbhub.com/heroes/beatrix#faq","url":"https://mlbbhub.com/heroes/beatrix","inLanguage":"en","mainEntity":[{"@type":"Question","name":"What is the best Beatrix build in 2026?","acceptedAnswer":{"@type":"Answer","text":"Beatrix's strongest build centers on Blade of Despair, Hunter Strike and Malefic Gun as core items, paired with the Assassin Emblem and the Flicker battle spell. The full six-item order, flex options for different matchups, and talent setup are in the build section on this page."}},{"@type":"Question","name":"What is the best emblem for Beatrix?","acceptedAnswer":{"@type":"Answer","text":"The recommended emblem for Beatrix is Assassin Emblem, set up with the Rupture, Weapon Master and Quantum Charge talents. The full emblem and talent breakdown, including alternatives for specific matchups, is in the build section."}},{"@type":"Question","name":"What lane and role is Beatrix in Mobile Legends?","acceptedAnswer":{"@type":"Answer","text":"Beatrix is a Marksman hero, usually played in the Gold Lane. Role and lane decide which builds, emblems, and counters matter most, all of which are covered on this page."}},{"@type":"Question","name":"Who counters Beatrix?","acceptedAnswer":{"@type":"Answer","text":"Beatrix is countered most by Natalia, Granger and Kaja, the heroes with the biggest measured edge against Beatrix in ranked play. The full counter list, the heroes Beatrix beats, and game-phase tips are in the counters section."}},{"@type":"Question","name":"Is Beatrix hard to play?","acceptedAnswer":{"@type":"Answer","text":"Beatrix is rated Hard difficulty in Mobile Legends. Beatrix has a higher skill floor, so expect a learning curve on combos and positioning before the hero pays off."}},{"@type":"Question","name":"What is Beatrix's win rate this patch?","acceptedAnswer":{"@type":"Answer","text":"Beatrix currently holds a 51.2% win rate, a 0.6% pick rate, and a 0.4% ban rate in ranked Mobile Legends, refreshed daily from match data. Win and pick rates broken down by rank, from Epic to Mythical Glory, are in the rank stats section."}}]}</script><div class="container-mlbb relative z-10"><div class="mb-6 flex items-center gap-3"><span class="flex h-9 w-9 items-center justify-center border border-mlbb-gold/30 bg-mlbb-gold/10 text-text-accent" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-question-mark h-4 w-4" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><path d="M12 17h.01"></path></svg></span><h2 id="hero-faq-heading" class="font-heading text-xl font-bold uppercase tracking-[0.04em] text-text-accent-bright md:text-2xl">Beatrix FAQ</h2></div><p class="mb-6 max-w-[80ch] text-sm leading-relaxed text-text-muted md:text-[15px]">Beatrix is a Marksman hero played in the Gold Lane.<!-- --> Its strongest build centers on Blade of Despair, Hunter Strike, Malefic Gun; open the <a class="font-semibold text-text-accent underline decoration-text-accent/30 underline-offset-2 transition-colors hover:text-text-accent-bright" href="/build-simulator?hero=beatrix&amp;items=swift-boots%2Cblade-of-despair%2Chunter-strike%2Chaass-claws%2Csea-halberd%2Cmalefic-gun&amp;spell=flicker&amp;emblem=assassin&amp;talents=rupture%2Cweapon-master%2Cquantum-charge&amp;flex=wind-of-nature.sea-halberd%2Crose-gold-meteor.sea-halberd%2Cimmortality.haass-claws">Beatrix build simulator</a> for the full item order and final stats, or compare every available loadout on the <a class="font-semibold text-text-accent underline decoration-text-accent/30 underline-offset-2 transition-colors hover:text-text-accent-bright" href="/builds/beatrix">Beatrix builds page</a>. <!-- -->See every hero that beats it on the <a class="font-semibold text-text-accent underline decoration-text-accent/30 underline-offset-2 transition-colors hover:text-text-accent-bright" href="/counter/beatrix">Beatrix counter page</a>.</p><div class="space-y-3"><div class="glass-card overflow-hidden"><h3 class="text-sm md:text-base font-heading font-semibold"><button id="_R_falubsnnauivbH1_" type="button" aria-expanded="true" aria-controls="_R_falubsnnauivb_" class="w-full flex items-center justify-between gap-3 p-5 text-left cursor-pointer text-[#E8E6E3] hover:text-[#C8AA6E] transition-colors"><span>What is the best Beatrix build in 2026?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down w-4 h-4 flex-shrink-0 transition-transform duration-200 rotate-180 text-[#C8AA6E]" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></h3><div id="_R_falubsnnauivb_" role="region" aria-labelledby="_R_falubsnnauivbH1_" class="grid transition-[grid-template-rows] duration-200 grid-rows-[1fr]"><div class="overflow-hidden"><div class="px-5 pb-5 -mt-1"><p class="text-sm text-[#9BA0B4] leading-relaxed">Beatrix&#x27;s strongest build centers on Blade of Despair, Hunter Strike and Malefic Gun as core items, paired with the Assassin Emblem and the Flicker battle spell. The full six-item order, flex options for different matchups, and talent setup are in the build section on this page.</p></div></div></div></div><div class="glass-card overflow-hidden"><h3 class="text-sm md:text-base font-heading font-semibold"><button id="_R_nalubsnnauivbH1_" type="button" aria-expanded="false" aria-controls="_R_nalubsnnauivb_" class="w-full flex items-center justify-between gap-3 p-5 text-left cursor-pointer text-[#E8E6E3] hover:text-[#C8AA6E] transition-colors"><span>What is the best emblem for Beatrix?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down w-4 h-4 flex-shrink-0 transition-transform duration-200 text-[#9BA0B4]" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></h3><div id="_R_nalubsnnauivb_" role="region" aria-labelledby="_R_nalubsnnauivbH1_" inert="" class="grid transition-[grid-template-rows] duration-200 grid-rows-[0fr]"><div class="overflow-hidden"><div class="px-5 pb-5 -mt-1"><p class="text-sm text-[#9BA0B4] leading-relaxed">The recommended emblem for Beatrix is Assassin Emblem, set up with the Rupture, Weapon Master and Quantum Charge talents. The full emblem and talent breakdown, including alternatives for specific matchups, is in the build section.</p></div></div></div></div><div class="glass-card overflow-hidden"><h3 class="text-sm md:text-base font-heading font-semibold"><button id="_R_valubsnnauivbH1_" type="button" aria-expanded="false" aria-controls="_R_valubsnnauivb_" class="w-full flex items-center justify-between gap-3 p-5 text-left cursor-pointer text-[#E8E6E3] hover:text-[#C8AA6E] transition-colors"><span>What lane and role is Beatrix in Mobile Legends?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down w-4 h-4 flex-shrink-0 transition-transform duration-200 text-[#9BA0B4]" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></h3><div id="_R_valubsnnauivb_" role="region" aria-labelledby="_R_valubsnnauivbH1_" inert="" class="grid transition-[grid-template-rows] duration-200 grid-rows-[0fr]"><div class="overflow-hidden"><div class="px-5 pb-5 -mt-1"><p class="text-sm text-[#9BA0B4] leading-relaxed">Beatrix is a Marksman hero, usually played in the Gold Lane. Role and lane decide which builds, emblems, and counters matter most, all of which are covered on this page.</p></div></div></div></div><div class="glass-card overflow-hidden"><h3 class="text-sm md:text-base font-heading font-semibold"><button id="_R_17alubsnnauivbH1_" type="button" aria-expanded="false" aria-controls="_R_17alubsnnauivb_" class="w-full flex items-center justify-between gap-3 p-5 text-left cursor-pointer text-[#E8E6E3] hover:text-[#C8AA6E] transition-colors"><span>Who counters Beatrix?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down w-4 h-4 flex-shrink-0 transition-transform duration-200 text-[#9BA0B4]" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></h3><div id="_R_17alubsnnauivb_" role="region" aria-labelledby="_R_17alubsnnauivbH1_" inert="" class="grid transition-[grid-template-rows] duration-200 grid-rows-[0fr]"><div class="overflow-hidden"><div class="px-5 pb-5 -mt-1"><p class="text-sm text-[#9BA0B4] leading-relaxed">Beatrix is countered most by Natalia, Granger and Kaja, the heroes with the biggest measured edge against Beatrix in ranked play. The full counter list, the heroes Beatrix beats, and game-phase tips are in the counters section.</p></div></div></div></div><div class="glass-card overflow-hidden"><h3 class="text-sm md:text-base font-heading font-semibold"><button id="_R_1falubsnnauivbH1_" type="button" aria-expanded="false" aria-controls="_R_1falubsnnauivb_" class="w-full flex items-center justify-between gap-3 p-5 text-left cursor-pointer text-[#E8E6E3] hover:text-[#C8AA6E] transition-colors"><span>Is Beatrix hard to play?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down w-4 h-4 flex-shrink-0 transition-transform duration-200 text-[#9BA0B4]" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></h3><div id="_R_1falubsnnauivb_" role="region" aria-labelledby="_R_1falubsnnauivbH1_" inert="" class="grid transition-[grid-template-rows] duration-200 grid-rows-[0fr]"><div class="overflow-hidden"><div class="px-5 pb-5 -mt-1"><p class="text-sm text-[#9BA0B4] leading-relaxed">Beatrix is rated Hard difficulty in Mobile Legends. Beatrix has a higher skill floor, so expect a learning curve on combos and positioning before the hero pays off.</p></div></div></div></div><div class="glass-card overflow-hidden"><h3 class="text-sm md:text-base font-heading font-semibold"><button id="_R_1nalubsnnauivbH1_" type="button" aria-expanded="false" aria-controls="_R_1nalubsnnauivb_" class="w-full flex items-center justify-between gap-3 p-5 text-left cursor-pointer text-[#E8E6E3] hover:text-[#C8AA6E] transition-colors"><span>What is Beatrix&#x27;s win rate this patch?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down w-4 h-4 flex-shrink-0 transition-transform duration-200 text-[#9BA0B4]" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></h3><div id="_R_1nalubsnnauivb_" role="region" aria-labelledby="_R_1nalubsnnauivbH1_" inert="" class="grid transition-[grid-template-rows] duration-200 grid-rows-[0fr]"><div class="overflow-hidden"><div class="px-5 pb-5 -mt-1"><p class="text-sm text-[#9BA0B4] leading-relaxed">Beatrix currently holds a 51.2% win rate, a 0.6% pick rate, and a 0.4% ban rate in ranked Mobile Legends, refreshed daily from match data. Win and pick rates broken down by rank, from Epic to Mythical Glory, are in the rank stats section.</p></div></div></div></div></div></div></section><!--$--><!--/$--></div></main><footer class="content-lazy relative bg-[#000000] border-t border-[#C8AA6E]/20 overflow-hidden"><div class="absolute inset-0 hex-pattern opacity-40 pointer-events-none"></div><div class="absolute inset-0 pointer-events-none" style="background:radial-gradient(ellipse 80% 60% at 50% 100%, rgba(200,170,110,0.03), transparent)"></div><div class="absolute top-0 left-0 right-0 h-[2px] z-10 overflow-hidden energy-line" aria-hidden="true"></div><div class="relative z-10 pt-4 pb-4"><div class="container-mlbb"><div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-x-12 gap-y-8"><div class="col-span-1 sm:col-span-2"><div class="flex items-center gap-2 mb-4"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield w-7 h-7 text-[#C8AA6E]" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path></svg><span class="font-heading text-xl font-bold tracking-wider text-gradient-gold">MLBB<span class="text-gradient-blue">Hub</span></span></div><p class="mb-6 max-w-sm border-l-2 border-mlbb-gold-bright/70 pl-3 font-hea