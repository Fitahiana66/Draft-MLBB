[\"$\",\"section\",null,{\"id\":\"hero-article\",\"className\":\"relative lg:order-1 bg-[#0a0a0a]/85 backdrop-blur-sm border border-[#C8AA6E]/15 p-5 md:p-9 overflow-hidden\",\"style\":{\"boxShadow\":\"0 1px 0 rgba(255,255,255,0.03) inset, 0 18px 38px -24px rgba(0,0,0,0.8)\"},\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[#F0D060]/55 to-transparent\",\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"absolute top-0 left-0 w-3 h-3 border-t border-l border-[#F0D060]/40\",\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"absolute top-0 right-0 w-3 h-3 border-t border-r border-[#C8AA6E]/30\",\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"absolute bottom-0 left-0 w-3 h-3 border-b border-l border-[#C8AA6E]/30\",\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"absolute bottom-0 right-0 w-3 h-3 border-b border-r border-[#C8AA6E]/30\",\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"absolute -top-32 -right-24 w-72 h-72 rounded-full bg-[#C8AA6E]/[0.05] blur-3xl pointer-events-none\",\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"relative hero-article-body max-w-[860px] mx-auto\",\"children\":[[[[\"$\",\"h2\",\"h2-0\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Pick Uranus for map tempo, not for hard engage\"]}],\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Uranus keeps getting treated like a comfort blind pick because he is hard to kill and simple to pilot. That reading is half right. He is safe in the sense that a bad lane rarely kills him, but a safe lane is not the same thing as a useful draft. Uranus only earns his slot when the game lets him convert sustain into tempo.\"}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Pick him when the enemy EXP or roam wants long, repeated trades instead of one clean burst window. Pick him when the opposing draft has low-threat frontliners you can walk through, soak, and ignore while you cut the next wave. Pick him when your jungler and mid actually use the space you create, because Uranus wins more games by dragging rotations than by solo-killing his lane.\"}],\"\\n\",[\"$\",\"p\",\"p-2\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"He is especially good when the enemy team is short on hard lockdown and their backline damage needs time to ramp. That is the version of the game where Uranus gets to cut early, show first at river, and walk into vision without instantly losing half his life bar. Current tier-list coverage still treats him as a dependable EXP option for that reason, and the official hero page still frames him as an EXP or jungle flex rather than a true roamer.\"}],\"\\n\",[\"$\",\"p\",\"p-3\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Do not pick him when your team needs the roam or EXP slot to start fights. Uranus has no reliable catch, no real peel button, and no threat that forces Flicker out on contact. Do not pick him into Baxia, heavy anti-heal stacking, or ranged damage dealers that can keep hitting while kiting backward. Community consensus is still consistent on that part: if the enemy can reduce healing and keep distance at the same time, Uranus stops being annoying and starts being decorative.\"}],\"\\n\",\"$L7e\",\"\\n\",\"$L7f\",\"\\n\",\"$L80\",\"\\n\",\"$L81\",\"\\n\",\"$L82\",\"\\n\",\"$L83\",\"\\n\",\"$L84\",\"\\n\",\"$L85\",\"\\n\",\"$L86\",\"\\n\",\"$L87\",\"\\n\",\"$L88\",\"\\n\",\"$L89\",\"\\n\",\"$L8a\",\"\\n\",\"$L8b\",\"\\n\",\"$L8c\"],\"$L8d\",\"$L8e\"],\"$L8f\"]}]]}]]}]\n"])</script><script>self.__next_f.push([1,"a6:I[392015,[\"$7\",\"$8\",\"$9\",\"$a\",\"$b\",\"$2e\",\"$3e\",\"$3f\"],\"default\"]\nb7:I[131354,[\"$7\",\"$8\",\"$9\",\"$a\",\"$b\",\"$2e\",\"$3e\",\"$3f\"],\"default\"]\n6d:[\"$\",\"$L6a\",\"johnson\",{\"href\":\"/heroes/johnson\",\"className\":\"group block\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative bg-surface-4 border border-mlbb-gold/20 overflow-hidden card-hover hover:border-mlbb-gold/50\",\"style\":{\"boxShadow\":\"0 2px 8px rgba(0,0,0,0.3)\"},\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 p-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative w-14 h-14 rounded-full overflow-hidden flex-shrink-0 bg-surface-3\",\"children\":[\"$\",\"$L6b\",null,{\"src\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_85ff988c6660b4d04f8dd3d40df988bb.png\",\"alt\":\"Johnson - Wild Engine\",\"unoptimized\":false,\"priority\":\"$undefined\",\"fetchPriority\":\"$undefined\",\"fill\":true,\"className\":\"object-cover group-hover:scale-110 transition-transform duration-300\",\"sizes\":\"56px\",\"placeholder\":\"blur\",\"blurDataURL\":\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTAwIiBoZWlnaHQ9IjEwMCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48cmVjdCB3aWR0aD0iMTAwIiBoZWlnaHQ9IjEwMCIgZmlsbD0iIzBkMTIyNSIvPjwvc3ZnPg==\"}]}],[\"$\",\"div\",null,{\"className\":\"flex-1 min-w-0\",\"children\":[[\"$\",\"h4\",null,{\"className\":\"font-heading font-bold text-text-primary group-hover:text-text-accent-bright transition-colors truncate\",\"children\":\"Johnson\"}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mt-0.5\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-[10px] font-heading uppercase tracking-wider px-1.5 py-0.5\",\"style\":{\"backgroundColor\":\"#3498DB20\",\"color\":\"#71b7e6\",\"border\":\"1px solid #3498DB40\"},\"children\":\"Tank\"}],[\"$\",\"$L6c\",null,{\"tier\":\"C