solute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #ff5d73, #ff5d7333)\",\"boxShadow\":\"0 0 12px -2px #ff5d7380\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#ff5d73\",\"background\":\"#ff5d731a\",\"border\":\"1px solid #ff5d7340\"},\"children\":\"Mythical Glory+\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Uranus\",\"rank\":\"Mythical Glory+\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=mythical_glory\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Mythical Glory+\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Mythical Glory+\",\"name\":\"Uranus\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"48.16\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Uranus\",\"delta\":\"-1.29%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.33\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.09\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Mythical Glory+\"}}]]}]]}]\na7:[\"$\",\"p\",\"p-3\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Boots first.\"}],\" \",[\"$\",\"$L40\",\"a-0\",{\"href\":\"/items/tough-boots\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Tough Boots\"}],\" is the default because crowd control and chained slows are what actually kill Uranus. \",[\"$\",\"$L40\",\"a-1\",{\"href\":\"/items/warrior-boots\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Warrior Boots\"}],\" only wins when the enemy damage is overwhelmingly physical and their lockdown is light.\"]}]\na8:[\"$\",\"p\",\"p-4\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"The stable core.\"}],\" \",[\"$\",\"$L40\",\"a-0\",{\"href\":\"/items/enchanted-talisman\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Enchanted Talisman\"}],\" and \",[\"$\",\"$L40\",\"a-1\",{\"href\":\"/items/oracle\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Oracle\"}],\" are the reliable base because they solve uptime instead of pretending Uranus needs raw damage. If the game is normal, these are the first two completed items that make the hero feel like himself.\"]}]\na9:[\"$\",\"p\",\"p-5\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"After that, buy for triggers:\"}]\naa:[\"$\",\"ul\",\"ul-0\",{\"className\":\"list-disc list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":[\"$\",\"$L40\",\"a-0\",{\"href\":\"/items/dominance-ice\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Dominance Ice\"}]}],\" when the enemy draft relies on sustain: lifesteal marksmen, healers, or frontliners that need repeated contact. Lifebane cuts the shield and HP regen of every enemy within 5 units of you to 60% of normal, and Fortress Shield stacks Hybrid Defense for each of them, so the enemies who commit to you get weaker the longer they stay.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":[\"$\",\"$L40\",\"a-0\",{\"href\":\"/items/thunder-belt\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Thunder Belt\"}]}],\" when you are getting repeated basic attacks off in lane skirmishes or front-to-back fights. Uranus procs it naturally because he keeps touching the fight, and the permanent Hybrid Defense stacks are real value on a hero who wants long games.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":[\"$\",\"$L40\",\"a-0\",{\"href\":\"/items/brute-force-breastplate\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Brute Force Breastplate\"}]}],\" when the fight pattern is chase-heavy. Dealing damage every second quickly stacks movement speed, and the control-duration reduction at full stacks helps Uranus keep moving through messy brawls.\"]}],\"\\n\",[\"$\",\"li\",\"li-3\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":[\"$\",\"$L40\",\"a-0\",{\"href\":\"/items/radiant-armor\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Radiant Armor\"}]}],\" against repeated magic hits instead of one clean burst. If the enemy mage wins by staying on you for several seconds, this is usually better than a generic defense slot.\"]}],\"\\n\",[\"$\",\"li\",\"li-4\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":[\"$\",\"$L40\",\"a-0\",{\"href\":\"/items/antique-cuirass\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Antique Cuirass\"}]}],\" against skill-based physical burst like fighters and assassins who open with buttons instead of autos. Deter lowers their follow-up damage the moment they start the combo.\"]}],\"\\n\",[\"$\",\"li\",\"li-5\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":[\"$\",\"$L40\",\"a-0\",{\"href\":\"/items/blade-armor\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Blade Armor\"}]}],\" when the problem is one fed marksman who refuses to hit anyone else. It is not a general tank slot. It is a punishment button for basic-attack lobbies.\"]}],\"\\n\",[\"$\",\"li\",\"li-6\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"$Lb8\"}],\" as the sixth-item reset when one more body on the objective is worth more than any small stat edge. Buy it late, not early.\"]}],\"\\n\"]}]\nab:[\"$\",\"p\",\"p-6\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The trap build is full-defense-with-no-mana or full-magic-for-highlight clips. The first one leaves you dry after two waves. The second turns Uranus into a worse Esmeralda. Build for uptime, then adapt.\"}]\nac:[\"$\",\"h2\",\"h2-2\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The mistakes that make Uranus look useless\"]}]\nad:[\"$\",\"p\",\"p-7\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Picking him like a roamer instead of an EXP tempo pick.\"}],\" Uranus can walk into vision, but he cannot force a clean engage for teammates. If your draft needs the fourth or fifth slot to start fights, Uranus is the wrong answer before the match even begins.\"]}]\nae:[\"$\",\"p\",\"p-8\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Dashing in before Skill 1 has started the trade.\"}],\" This is the basic mechanical error. If \",[\"$\",\"$L40\",\"a-0\",{\"href\":\"/heroes/uranus\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Transcendent Ward\"}],\" is your opener every time, you are spending the shield and your best angle tool before the enemy shows how they want to kite. Start with contact, then dash to maintain it.\"]}]\naf:[\"$\",\"p\",\"p-9\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Holding the wave in lane because you think winning lane means fighting lane.\"}],\" Uranus wins more from bad wave positions than from direct kills. If the matchup is neutral and you are just standing there trading autos, you are wasting the hero's best advantage. Cut, crash, leave, repeat.\"]}]\nb0:[\"$\",\"p\",\"p-10\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Trying to out-sustain Baxia, Ixia, or stacked anti-heal.\"}],\" This is the matchup mistake that keeps showing up across guides and community discussion because people keep making it. Uranus does not \\\"eventually win\\\" into every lobby. Baxia cuts the healing logic at the source, and ranged DPS that keeps firing through anti-heal turns your sustain into fake durability.\"]}]\nb1:[\"$\",\"p\",\"p-11\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Pressing ultimate after the enemy already pinned you down.\"}],\" The ult is strongest when it breaks the slow field, restores momentum, and lets you choose the exit. If you wait until the whole chain has already landed, you are using it as a delayed obituary.\"]}]\nb2:[\"$\",\"h2\",\"h2-3\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Key tips\"]}]\nb3:[\"$\",\"div\",\"blockquote-0\",{\"className\":\"my-5 p-4 flex gap-3\",\"style\":{\"background\":\"rgba(200,170,110,0.08)\",\"border\":\"1px solid rgba(200,170,110,0.35)\"},\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-lightbulb w-4 h-4 flex-shrink-0 mt-0.5\",\"aria-hidden\":\"true\",\"style\":{\"color\":\"#C8AA6E\"},\"children\":[[\"$\",\"path\",\"1gvzjb\",{\"d\":\"M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5\"}],[\"$\",\"path\",\"x1upvd\",{\"d\":\"M9 18h6\"}],[\"$\",\"path\",\"ceow96\",{\"d\":\"M10 22h4\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[11px] font-heading font-bold uppercase tracking-wider mb-1\",\"style\":{\"color\":\"#C8AA6E\"},\"children\":\"Tip\"}],[[\"$\",\"p\",\"0\",{\"className\":\"text-sm text-[#9BA0B4] leading-relaxed\",\"children\":[\"If you plan to rotate after a cut wave, take one hit from a nearby creep or crab before leaving lane. Carrying passive stacks into river is often the difference between arriving as a nuisance and arriving as a real front line.\"]}]]]}]]}]\nb4:[\"$\",\"div\",\"blockquote-1\",{\"className\":\"my-5 p-4 flex gap-3\",\"style\":{\"background\":\"rgba(200,170,110,0.08)\",\"border\":\"1px solid rgba(200,170,110,0.35)\"},\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-lightbulb w-4 h-4 flex-shrink-0 mt-0.5\",\"aria-hidden\":\"true\",\"style\":{\"color\":\"#C8AA6E\"},\"children\":[[\"$\",\"path\",\"1gvzjb\",{\"d\":\"M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5\"}],[\"$\",\"path\",\"x1upvd\",{\"d\":\"M9 18h6\"}],[\"$\",\"path\",\"ceow96\",{\"d\":\"M10 22h4\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[11px] font-heading font-bold uppercase tracking-wider mb-1\",\"style\":{\"color\":\"#C8AA6E\"},\"children\":\"Tip\"}],[[\"$\",\"p\",\"0\",{\"className\":\"text-sm text-[#9BA0B4] leading-relaxed\",\"children\":[[\"$\",\"$L40\",\".$a-0\",{\"href\":\"/items/thunder-belt\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Thunder Belt\"}],\" is not a rush item unless lane is already free. It becomes efficient once Talisman and Oracle let you stay in contact long enough to trigger it repeatedly. Before that, it delays the part of Uranus that actually matters.\"]}]]]}]]}]\nb5:[\"$\",\"div\",\"blockquote-2\",{\"className\":\"my-5 p-4 flex gap-3\",\"style\":{\"background\":\"rgba(0,170,255,0.08)\",\"border\":\"1px solid rgba(0,170,255,0.35)\"},\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-info w-4 h-4 flex-shrink-0 mt-0.5\",\"aria-hidden\":\"true\",\"style\":{\"color\":\"#00AAFF\"},\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"1dtifu\",{\"d\":\"M12 16v-4\"}],[\"$\",\"path\",\"e9boi3\",{\"d\":\"M12 8h.01\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[11px] font-heading font-bold uppercase tracking-wider mb-1\",\"style\":{\"color\":\"#00AAFF\"},\"children\":\"Note\"}],[[\"$\",\"p\",\"0\",{\"className\":\"text-sm text-[#9BA0B4] leading-relaxed\",\"children\":[[\"$\",\"$L40\",\".$a-0\",{\"href\":\"/items/dominance-ice\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Dominance Ice\"}],\" and enemy anti-heal do not mean you stop side-laning. They mean you side-lane with shorter windows. Cut, show, leave. The answer to anti-heal is tighter tempo, not pretending the debuff is not there.\"]}]]]}]]}]\nb6:[\"$\",\"div\",\"blockquote-3\",{\"className\":\"my-5 p-4 flex gap-3\",\"style\":{\"background\":\"rgba(200,170,110,0.08)\",\"border\":\"1px solid rgba(200,170,110,0.35)\"},\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-lightbulb w-4 h-4 flex-shrink-0 mt-0.5\",\"aria-hidden\":\"true\",\"style\":{\"color\":\"#C8AA6E\"},\"children\":[[\"$\",\"path\",\"1gvzjb\",{\"d\":\"M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5\"}],[\"$\",\"path\",\"x1upvd\",{\"d\":\"M9 18h6\"}],[\"$\",\"path\",\"ceow96\",{\"d\":\"M10 22h4\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[11px] font-heading font-bold uppercase tracking-wider mb-1\",\"style\":{\"color\":\"#C8AA6E\"},\"children\":\"Tip\"}],[[\"$\",\"p\",\"0\",{\"className\":\"text-sm text-[#9BA0B4] leading-relaxed\",\"children\":[\"When the enemy marksman is the only real damage source, do not sprint past the whole fight trying to tag them once. Stay on the doorway they must cross. Uranus wastes more late-game DPS by blocking approach angles than by chasing fantasy kills.\"]}]]]}]]}]\n"])</script><script>self.__next_f.push([1,"b8:[\"$\",\"$L40\",\"a-0\",{\"href\":\"/items/immortality\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Immortality\"}]\n"])</script></body></html>