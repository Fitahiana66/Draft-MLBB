rl\":\"https://mobile-legends.fandom.com/wiki/Vexana/Cosmetics\"},{\"name\":\"Cursed Shackle\",\"tier\":\"Common\",\"rawTier\":\"Common\",\"tag\":\"S12\",\"tagSlug\":\"s12\",\"price\":\"Season 12\",\"portraitFile\":\"Hero384-portrait.png\",\"portraitUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/vexana/Hero384-portrait-20220604034152.webp\",\"splashUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/vexana/Vexana-Cursed-Shackle-20220914143925.webp\",\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Vexana/Cosmetics\"},{\"name\":\"Circus Magician\",\"tier\":\"Exceptional\",\"rawTier\":\"Exceptional\",\"tag\":\"Starlight\",\"tagSlug\":\"starlight\",\"price\":\"2022/12 StarLight Member\",\"portraitFile\":\"Hero385-portrait.png\",\"portraitUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/vexana/Hero385-portrait-20221103134615.webp\",\"splashUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/vexana/Vexana-Circus-Magician-20221202125325.webp\",\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Vexana/Cosmetics\"},{\"name\":\"The Sun Empress\",\"tier\":\"Exquisite\",\"rawTier\":\"Exquisite\",\"tag\":\"Collector\",\"tagSlug\":\"collector\",\"price\":\"Limited-time Event\",\"portraitFile\":\"Hero386-portrait.png\",\"portraitUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/vexana/Hero386-portrait-20230917045309.webp\",\"splashUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/vexana/Vexana-The-Sun-Empress-20230914134518.webp\",\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Vexana/Cosmetics\"},{\"name\":\"Twisted Fairytale\",\"tier\":\"Grand\",\"rawTier\":\"Grand\",\"tag\":\"Zenith\",\"tagSlug\":\"zenith\",\"price\":\"Limited-time Event\",\"portraitFile\":\"Hero387-portrait.png\",\"portraitUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/vexana/Hero387-portrait-20240326141745.webp\",\"splashUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/vexana/Vexana-Twisted-Fairytale-20240326141548.webp\",\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Vexana/Cosmetics\"},{\"name\":\"Twilight Star\",\"tier\":\"Grand\",\"rawTier\":\"Grand\",\"tag\":\"The Aspirants\",\"tagSlug\":\"the-aspirants\",\"price\":\"Limited-time Event\",\"portraitFile\":\"Hero388-portrait.png\",\"portraitUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/vexana/Hero388-portrait-20260602040611.webp\",\"splashUrl\":null,\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Vexana/Cosmetics\"},{\"name\":\"Eternal Vow\",\"tier\":\"Deluxe\",\"rawTier\":\"Deluxe\",\"tag\":\"Epic\",\"tagSlug\":\"epic\",\"price\":\"899\",\"portraitFile\":\"Hero103810-portrait.png\",\"portraitUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/vexana/Hero103810-portrait-20260603051022.webp\",\"splashUrl\":null,\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Vexana/Cosmetics\"}],\"lore\":{\"backstory\":\"Vexana is the Necromancer Queen, a once-beautiful ruler who sold her soul to the Abyss in exchange for power over death itself. Her curse transforms enemies she kills into undead puppets that fight on her behalf. The terrifying spectral hand she summons causes enemies to flee in panic, and her Eternal Guard summons a massive undead knight. Vexana's true tragedy is that she was driven to necromancy by the loss of her beloved, whom she still seeks to resurrect at any cost.\",\"allies\":[{\"heroSlug\":\"faramis\",\"heroName\":\"Faramis\",\"relationship\":\"Soul binder who shares her necromantic interests\"},{\"heroSlug\":\"leomord\",\"heroName\":\"Leomord\",\"relationship\":\"Undead knight she accidentally freed\"}],\"rivals\":[{\"heroSlug\":\"rafaela\",\"heroName\":\"Rafaela\",\"relationship\":\"Angel whose holy power burns her undead\"},{\"heroSlug\":\"lunox\",\"heroName\":\"Lunox\",\"relationship\":\"Cosmic being whose light dispels her dark magic\"}]},\"loreUrlName\":\"Vexana\",\"statsHistory\":[{\"date\":\"2026-09-07\",\"winRate\":50.24,\"pickRate\":1.81,\"banRate\":1.9},{\"date\":\"2026-09-10\",\"winRate\":50.29,\"pickRate\":1.81,\"banRate\":1.91},{\