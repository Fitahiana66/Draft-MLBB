n\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"absolute bottom-0 right-0 w-3 h-3 border-b border-r border-[#C8AA6E]/30\",\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"absolute -top-32 -right-24 w-72 h-72 rounded-full bg-[#C8AA6E]/[0.05] blur-3xl pointer-events-none\",\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"relative hero-article-body max-w-[860px] mx-auto\",\"children\":[[[[\"$\",\"h2\",\"h2-0\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"When the enemy team deserves a Minotaur\"]}],\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Minotaur belongs in a draft where the enemy team clusters naturally and your backline has enough burst to convert a clean airborne into kills. His roam pattern is slow: no dash, no blink beyond Flicker, and a cooldown-heavy engage sequence that punishes him hard if it misses. The 2.1.88 buff raised his S1 damage, so a landed engage bites harder than it used to, but it does not buy him a new approach tool. Draft him when:\"}],\"\\n\",[\"$\",\"ul\",\"ul-0\",{\"className\":\"list-disc list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":\"The enemy team is melee-heavy and groups in narrow chokepoints. His ult's 3-hit sequence, two heavy slows followed by a true damage airborne, lands best when enemies cannot spread across a wide corridor.\"}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":\"Your marksman can follow up immediately on a knock-up. Bruno, Moskov, and Claude all convert a clean airborne into near-certain kills. Claude in particular gets a free-fire window that extends further because enraged S1 after the ult adds another knock-up before the target lands.\"}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":\"The enemy team relies on sustain or shields. Dominance Ice's Lifebane passive reduces shield and HP regen effects of all nearby enemies within range to 60% of normal, and its Fortress Shield passive stacks hybrid defense for each enemy hero nearby. Against sustain fighters like Thamuz or teams built around Esmeralda's magic-to-shield conversion, these passives alone justify the pick.\"}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Three conditions that make Minotaur the wrong pick:\"}],\"\\n\",\"$L7f\",\"\\n\",\"$L80\",\"\\n\",\"$L81\",\"\\n\",\"$L82\",\"\\n\",\"$L83\",\"\\n\",\"$L84\",\"\\n\",\"$L85\",\"\\n\",\"$L86\",\"\\n\",\"$L87\",\"\\n\",\"$L88\",\"\\n\",\"$L89\",\"\\n\",\"$L8a\",\"\\n\",\"$L8b\",\"\\n\",\"$L8c\",\"\\n\",\"$L8d\",\"\\n\",\"$L8e\"],\"$L8f\",\"$L90\"],\"$L91\"]}]]}]]}]\n"])</script><script>self.__next_f.push([1,"a8:I[392015,[\"$7\",\"$8\",\"$9\",\"$a\",\"$b\",\"$2e\",\"$3e\",\"$3f\"],\"default\"]\nbb:I[131354,[\"$7\",\"$8\",\"$9\",\"$a\",\"$b\",\"$2e\",\"$3e\",\"$3f\"],\"default\"]\n6e:[\"$\",\"$L6b\",\"marcel\",{\"href\":\"/heroes/marcel\",\"className\":\"group block\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative bg-surface-4 border border-mlbb-gold/20 overflow-hidden card-hover hover:border-mlbb-gold/50\",\"style\":{\"boxShadow\":\"0 2px 8px rgba(0,0,0,0.3)\"},\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 p-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative w-14 h-14 rounded-full overflow-hidden flex-shrink-0 bg-surface-3\",\"children\":[\"$\",\"$L6c\",null,{\"src\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_df7603c292198bf4aa7b551d401ea5c1.png\",\"alt\":\"Marcel - Split-Sou