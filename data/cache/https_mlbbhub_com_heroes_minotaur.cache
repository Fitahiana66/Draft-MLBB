inst\":[{\"heroSlug\":\"layla\",\"heroName\":\"Layla\",\"advantage\":\"weak\",\"tip\":\"Minotaur is countered by long-range Marksmen like Layla and Lesley since his lack of speed makes him an easy target.\"},{\"heroSlug\":\"lesley\",\"heroName\":\"Lesley\",\"advantage\":\"weak\",\"tip\":\"Minotaur is countered by long-range Marksmen like Layla and Lesley since his lack of speed makes him an easy target.\"}]},\"splashArt\":\"https://akmweb.youngjoygame.com/web/svnres/file/mlbb/homepage/100_db4fda77f902f3dde09d247498da23cc.jpg\",\"portrait\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_3ecd2c0843df7ec85044dafff6bf4553.png\",\"officialMatchups\":[{\"kind\":\"best_ally\",\"heroId\":\"1\",\"heroName\":\"Miya\",\"heroSlug\":\"miya\",\"icon\":\"https://indoch.s3.ml.moonlian.com/web/madmin/image_a844f9aa51baefa6878801edd85fec5e.png\",\"tip\":\"He can protect marksman or mage will with his CS.\"},{\"kind\":\"counters\",\"heroId\":\"46\",\"heroName\":\"Odette\",\"heroSlug\":\"odette\",\"icon\":\"https://akmweb.youngjoygame.com/web/madmin/image/071fd5539ac4ba53b1dc27195cd6d4bd.png?w=150-150-fff8da\",\"tip\":\"His Ultimate can interrupt Odette's Ultimate.\"},{\"kind\":\"countered_by\",\"heroId\":\"23\",\"heroName\":\"Gord\",\"heroSlug\":\"gord\",\"icon\":\"https://akmwebstatic.yuanzhanapp.com/web/madmin/image_24b9fa9519483b3d2168261b0fb6c0cf.png\",\"tip\":\"Go for hero that do good poke and kiting such as Gord, Miya, Clint, Bruno, Layla, Nana and for his biggest counter\"}],\"skills\":{\"skills\":[{\"name\":\"Rage Incarnate\",\"type\":\"Passive\",\"description\":\"After casting a skill, Minotaur gains Motivation, recovering HP equal to 5 (+1*Hero Level)% of damage taken from enemy heroes for 3s.\\n\\nEnraged State: Motivation HP recovery is increased to 200%.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"After casting a skill, Minotaur gains \"},{\"type\":\"text\",\"text\":\"Motivation\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\", recovering HP equal to 5 (+1*Hero Level)% of damage taken from enemy heroes for 3s.\\n\\n\"},{\"type\":\"text\",\"text\":\"Enraged State\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\": \"},{\"type\":\"text\",\"text\":\"Motivation\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" HP recovery is increased to 200%.\"}],\"cooldown\":null,\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_4296561c81f79f3960c72c6d707a2f86.png\",\"tags\":[\"Buff\"]},{\"name\":\"Despair Stomp\",\"type\":\"Skill 1\",\"description\":\"Minotaur jumps to the target location, dealing 325 (+60% Total Physical Attack) Physical Damage to enemies in the area and briefly knocking them airborne. Enemies hit will also be slowed by 40% while Minotaur enhances his Basic Attacks to deal 25 (+5% Max HP) extra Physical Damage for 2s.\\n\\nEnraged: Increases the AOE range and the damage dealt by 25 (+5% Max HP) Physical Damage.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Minotaur jumps to the target location, dealing 325\"},{\"type\":\"text\",\"text\":\" (+60% Total Physical Attack)\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Physical Damage\",\"color\":\"#fb1f1f\"},{\"type\":\"text\",\"text\":\" to enemies in the area and briefly knocking them airborne. Enemies hit will also be slowed by 40% while Minotaur enhances his Basic Attacks to deal 25 (+5% Max HP) extra \"},{\"type\":\"text\",\"text\":\"Physical Damage\",\"color\":\"#fb1f1f\"},{\"type\":\"text\",\"text\":\" for 2s.\\n\\n\"},{\"type\":\"text\",\"text\":\"Enraged\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\": Increases the AOE range and the damage dealt by 25 (+5% Max HP) \"},{\"type\":\"text\",\"text\":\"Physical Damage\",\"color\":\"#fb1f1f\"},{\"type\":\"text\",\"text\":\".\"}],\"cooldown\":\"12s\",\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_a902b3f75e08b180503d02796804baae.png\",\"tags\":[\"CC\",\"AOE\"]},{\"name\":\"Motivation Roar\",\"type\":\"Skill 2\",\"description\":\"Minotaur heals himself and the nearby ally with the lowest HP, recovering 220 (+60% Total Magic Power) HP for both. He also recovers an additional 8% of his lost HP.\\n\\nEnraged: Minotaur heals himself and all nearby allied heroes.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Minotaur heals himself and the nearby ally with the lowest HP, recovering 220\"},{\"type\":\"text\",\"text\":\" (+60% Total Magic Power)\",\"color\":\"#62f8fe\"},{\"type\":\"text\",\"text\":\" HP for both. He also recovers an additional 8% of his lost HP.\\n\\n\"},{\"type\":\"text\",\"text\":\"Enraged\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\": Minotaur heals himself and all nearby allied heroes.\"}],\"cooldown\":\"10s\",\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_72ead6458b2fd5fa001d4cc594ee37a8.png\",\"tags\":[\"Heal\",\"Buff\"]},{\"name\":\"Minoan Fury\",\"type\":\"Ultimate\",\"description\":\"Minotaur enters Enraged state and smashes the ground 3 times. The first 2 hits deal 180 (+85% Total Physical Attack) Physical Damage to nearby enemies and slow them by 60%, while the final hit deals 200 (+85% Total Physical Attack) True Damage and knocks targets airborne for 0.8s. Minotaur is immune to control effects during this attack.\\n\\nThe Enraged state lasts 12s and enhances Minotaur's skills for the duration.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Minotaur enters \"},{\"type\":\"text\",\"text\":\"Enraged\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" state and smashes the ground 3 times. The first 2 hits deal 180\"},{\"type\":\"text\",\"text\":\" (+85% Total Physical Attack)\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Physical Damage\",\"color\":\"#fb1f1f\"},{\"type\":\"text\",\"text\":\" to nearby enemies and slow them by 60%, while the final hit deals 200 (+85% Total Physical Attack) True Damage and knocks targets airborne for 0.8s. Minotaur is immune to control effects during this attack.\\n\\nThe \"},{\"type\":\"text\",\"text\":\"Enraged\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" state lasts 12s and enhances Minotaur's skills for the duration.\"}],\"cooldown\":\"60s\",\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_8b1d72b921c47c7dcb68a25c4289412a.png\",\"tags\":[\"CC\"]}],\"skillUpgradePriority\":\"3-1-2\",\"skillPriorityTip\":\"Main skill 1, level up the Ult when unlocked\\nPetrify can help you better control the enemy.\",\"skillPriorityTipRich\":[{\"type\":\"text\",\"text\":\"Main skill 1, level up the Ult when unlocked\"},{\"type\":\"lineBreak\"},{\"type\":\"text\",\"text\":\"Petrify can help you better control the enemy.\"}]},\"synergies\":[{\"heroSlug\":\"granger\",\"heroName\":\"Granger\",\"synergyScore\":8,\"reason\":\"Minotaur works best with burst damage Marksmen, such as Granger and Melissa, since his CC's give them more opportunities to deal damage.\"},{\"heroSlug\":\"melissa\",\"heroName\":\"Melissa\",\"synergyScore\":8,\"reason\":\"Minotaur works best with burst damage Marksmen, such as Granger and Melissa, since his CC's give them more opportunities to deal damage.\"}],\"combos\":[{\"type\":\"teamfight\",\"title\":\"TEAMFIGHT COMBOS\",\"description\":\"In teamfights, use Minotaur's 1st Skill to jump in and knock enemies airborne, then use his Ultimate to keep them CC'd and enter Enraged state. Use his 1st Skill to knock enemies airborne again and continue with Basic Attacks. Use his 2nd Skill when he or his team needs healing.\",\"skillSequence\":[{\"skillId\":1910,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_a902b3f75e08b180503d02796804baae.png\"},{\"skillId\":1930,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_8b1d72b921c47c7dcb68a25c4289412a.png\"},{\"skillId\":1910,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_a902b3f75e08b180503d02796804baae.png\"},{\"skillId\":1900,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_f98d2e98eaebfb31c6c5101cf1c3201a.png\"},{\"skillId\":1920,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_72ead6458b2fd5fa001d4cc594ee37a8.png\"}]},{\"type\":\"laning\",\"title\":\"LANING COMBOS\",\"description\":\"In the laning phase, use Minotaur's 1st Skill to knock the enemy airborne and reduce their Defense, then deal damage with his enhanced Basic Attacks. Use his 2nd Skill to heal him and his teammate to come out ahead in the trade.\",\"skillSequence\":[{\"skillId\":1910,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_a902b3f75e08b180503d02796804baae.png\"},{\"skillId\":1900,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_f98d2e98eaebfb31c6c5101cf1c3201a.png\"},{\"skillId\":1920,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_72ead6458b2fd5fa001d4cc594ee37a8.png\"}]}],\"metaDescription\":\"Minotaur MLBB build, counter, and strategy guide. Oracle plus Dominance Ice power spike, rage mechanics, teamfight positioning, and when NOT to pick him.\",\"builds\":[],\"overviewLede\":\"Minotaur is the only roamer in MLBB whose kit gets more dangerous the harder the enemy team hits him. Once Minoan Fury activates his enraged state, his stomp covers more ground, his Motivation Roar heals every nearby teammate simultaneously, and the passive's damage-taken HP recovery runs at double rate. The gap between his normal and enraged state is the whole game.\"},\"serverLocale\":\"en\",\"curatedBuilds\":{\"source\":\"curated\",\"hero\":\"minotaur\",\"patch\":\"2.1.67\",\"lastReviewed\":\"2026-05-13\",\"stalePatch\":true,\"currentPatch\":\"2.2.16a\",\"builds\":[{\"slot\":1,\"id\":\"roam-favor-sustain-initiate\",\"name\":\"Roam Favor Sustain Initiate\",\"roleContext\":\"Roam\",\"items\":[{\"slug\":\"tough-boots\",\"name\":\"Tough Boots\",\"cost\":700,\"fixed\":false},{\"slug\":\"dominance-ice\",\"name\":\"Dominance Ice\",\"cost\":2010,\"fixed\":false},{\"slug\":\"flask-of-the-oasis\",\"name\":\"Flask of the Oasis\",\"cost\":1850,\"fixed\":false},{\"slug\":\"oracle\",\"name\":\"Oracle\",\"cost\":1860,\"fixed\":false},{\"slug\":\"antique-cuirass\",\"name\":\"Antique Cuirass\",\"cost\":2170,\"fixed\":false},{\"slug\":\"immortality\",\"name\":\"Immortality\",\"cost\":2120,\"fixed\":false}],\"coreItems\":[{\"slug\":\"dominance-ice\",\"name\":\"Dominance Ice\"},{\"slug\":\"flask-of-the-oasis\",\"name\":\"Flask of the Oasis\"},{\"slug\":\"oracle\",\"name\":\"Oracle\"}],\"emblem\":{\"slug\":\"support\",\"name\":\"Support Emblem\",\"talents\":[{\"slug\":\"agility\",\"name\":\"Agility\",\"iconUrl\":\"/images/talents/agility.png\",\"bucket\":\"standard\"},{\"slug\":\"pull-yourself-together\",\"name\":\"Pull Yourself Together\",\"iconUrl\":\"/images/talents/pull-yourself-together.png\",\"bucket\":\"standard\"},{\"slug\":\"brave-smite\",\"name\":\"Brave Smite\",\"iconUrl\":\"/images/talents/brave-smite.png\",\"bucket\":\"core\"}]},\"spell\":{\"slug\":\"flicker\",\"name\":\"Flicker\"},\"blessing\":{\"slug\":\"favor\",\"name\":\"Favor\"},\"flexItems\":[{\"item\":{\"slug\":\"athenas-shield\",\"name\":\"Athena's Shield\"},\"replace\":{\"slug\":\"oracle\",\"name\":\"Oracle\"},\"trigger\":\"Use when one magic burst combo can remove Minotaur before Motivation Roar or Minoan Fury changes the fight.\"},{\"item\":{\"slug\":\"radiant-armor\",\"name\":\"Radiant Armor\"},\"replace\":{\"slug\":\"oracle\",\"name\":\"Oracle\"},\"trigger\":\"Use against repeated magic poke or burn that keeps stacking damage before objective fights.\"},{\"item\":{\"slug\":\"blade-armor\",\"name\":\"Blade Armor\"},\"replace\":{\"slug\":\"antique-cuirass\",\"name\":\"Antique Cuirass\"},\"trigger\":\"Use when a basic-attack marksman is the main source of damage and must hit Minotaur through the frontline.\"}],\"notes\":\"Default ranked roam setup that pairs Favor, Flask, Oracle, and Flicker for sustained front-to-back fights around Minotaur's enraged engage.\",\"totalCost\":10710,\"statLines\":[{\"key\":\"magicpower\",\"labelKey\":\"common.stats.magicPower\",\"unit\":\"flat\",\"group\":\"offensive\",\"value\":60,\"sources\":[\"Flask of the Oasis\"]},{\"key\":\"hp\",\"labelKey\":\"common.stats.hp\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":2870,\"sources\":[\"Flask of the Oasis\",\"Oracle\",\"Antique Cuirass\",\"Immortality\"]},{\"key\":\"hpregen\",\"labelKey\":\"common.stats.hpRegen\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":4,\"sources\":[\"Antique Cuirass\"]},{\"key\":\"physdefense\",\"labelKey\":\"common.stats.physicalDefense\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":115,\"sources\":[\"Dominance Ice\",\"Oracle\",\"Antique Cuirass\",\"Immortality\"]},{\"key\":\"magicdefense\",\"labelKey\":\"common.stats.magicDefense\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":78,\"sources\":[\"Tough Boots\",\"Dominance Ice\",\"Oracle\"]},{\"key\":\"movespeed\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"flat\",\"group\":\"utility\",\"value\":40,\"sources\":[\"Tough Boots\"]},{\"key\":\"movespeedPct\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"percent\",\"group\":\"utility\",\"value\":5,\"sources\":[\"Dominance Ice\"]},{\"key\":\"cdreduction\",\"labelKey\":\"common.stats.cooldownReduction\",\"unit\":\"percent\",\"group\":\"utility\",\"value\":20,\"sources\":[\"Flask of the Oasis\",\"Oracle\"]},{\"key\":\"healingEffect\",\"labelKey\":\"common.stats.healingEffect\",\"unit\":\"percent\",\"group\":\"utility\",\"value\":12,\"sources\":[\"Flask of the Oasis\"]}],\"conflicts\":[],\"simulatorUrl\":\"