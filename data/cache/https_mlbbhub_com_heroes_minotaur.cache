,\"style\":\"$undefined\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex flex-col items-center gap-1 tabular-nums lg:flex-row lg:justify-center lg:gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-[11.5px] sm:text-sm text-text-primary\",\"style\":\"$undefined\",\"children\":[\"5.20\",\"%\"]}],[\"$\",\"span\",null,{\"className\":\"inline-flex items-center rounded-sm bg-mlbb-gold/[0.07] px-1 py-0.5 text-[10px] leading-none text-text-muted sm:px-1.5 sm:text-xs\",\"children\":[[\"$\",\"span\",null,{\"className\":\"sr-only\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankColDelta\"}],\" \"]}],\"-3.01%\"]}],[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-px whitespace-nowrap text-[10px] leading-none text-text-muted sm:gap-0.5 sm:text-xs\",\"children\":[[\"$\",\"span\",null,{\"className\":\"sr-only\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankColTrend\",\"params\":{\"days\":7}}],\" \"]}],[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-trending-down inline-block w-2.5 h-2.5 sm:w-3.5 sm:h-3.5 text-text-muted\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"t6n2it\",{\"d\":\"M16 17h6v-6\"}],[\"$\",\"path\",\"x473p\",{\"d\":\"m22 17-8.5-8.5-5 5L2 7\"}],\"$undefined\"]}],\"-0.07%\"]}]]}]}],[\"$\",\"td\",\"mythic\",{\"className\":\"px-0.5 py-2.5 align-top sm:px-3\",\"style\":\"$undefined\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex flex-col items-center gap-1 tabular-nums lg:flex-row lg:justify-center lg:gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-[11.5px] sm:text-sm text-text-primary\",\"style\":\"$undefined\",\"children\":[\"7.77\",\"%\"]}],[\"$\",\"span\",null,{\"className\":\"inline-flex items-center rounded-sm bg-mlbb-gold/[0.07] px-1 py-0.5 text-[10px] leading-none text-text-muted sm:px-1.5 sm:text-xs\",\"children\":[[\"$\",\"span\",null,{\"className\":\"sr-only\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankColDelta\"}],\" \"]}],\"-0.44%\"]}],[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-px whitespace-nowrap text-[10px] leading-none text-text-muted sm:gap-0.5 sm:text-xs\",\"children\":[[\"$\",\"span\",null,{\"className\":\"sr-only\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankColTrend\",\"params\":{\"days\":7}}],\" \"]}],[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-trending-down inline-block w-2.5 h-2.5 sm:w-3.5 sm:h-3.5 text-text-muted\",\"aria-hidden\":\"true\",\"children\":[\"$L9f\",\"$La0\",\"$undefined\"]}],\"-0.04%\"]}]]}]}],\"$La1\",\"$La2\"]]}]\n7c:[\"$\",\"p\",null,{\"className\":\"mt-3 flex flex-wrap items-center gap-x-5 gap-y-1.5 text-[11px] text-text-muted\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-1.5\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block h-3 w-5 rounded-sm bg-mlbb-gold/[0.07] ring-1 ring-inset ring-mlbb-gold/20\",\"aria-hidden\":\"true\"}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankColDelta\"}]]}],[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-1.5\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-trending-up h-3.5 w-3.5 text-text-muted\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"box55l\",{\"d\":\"M16 7h6v6\"}],[\"$\",\"path\",\"1t1m79\",{\"d\":\"m22 7-8.5 8.5-5-5L2 17\"}],\"$undefined\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankColTrend\",\"params\":{\"days\":7}}]]}]]}]\n7d:[\"$\",\"div\",null,{\"className\":\"mt-5 grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-3\",\"children\":[[\"$\",\"article\",\"epic\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #B07ECC, #B07ECC33)\",\"boxShadow\":\"0 0 12px -2px #B07ECC80\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#B07ECC\",\"background\":\"#B07ECC1a\",\"border\":\"1px solid #B07ECC40\"},\"children\":\"Epic\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Minotaur\",\"rank\":\"Epic\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=epic\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Epic\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Epic\",\"name\":\"Minotaur\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"55.31\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Minotaur\",\"delta\":\"+0.51%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.36\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"3.70\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Epic\"}}]]}]]}],[\"$\",\"article\",\"legend\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #4dc9f6, #4dc9f633)\",\"boxShadow\":\"0 0 12px -2px #4dc9f680\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#4dc9f6\",\"background\":\"#4dc9f61a\",\"border\":\"1px solid #4dc9f640\"},\"children\":\"Legend\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Minotaur\",\"rank\":\"Legend\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=legend\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Legend\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Legend\",\"name\":\"Minotaur\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"55.98\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Minotaur\",\"delta\":\"+1.18%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.67\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"5.20\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Legend\"}}]]}]]}],[\"$\",\"article\",\"mythic\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[\"$La3\",\"$La4\",\"$La5\"]}],\"$La6\",\"$La7\"]}]\n7f:[\"$\",\"ul\",\"ul-1\",{\"className\":\"list-disc list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":\"Multiple long-range poke threats. Pharsa, Yve, and Kimmy can keep Minotaur from building rage through normal combat. He has no approach tool that beats their range, so the early game becomes a waiting match at his own turret.\"}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":\"Enemy team brings anti-heal stacking. Sea Halberd on even one physical DPS already cuts S2's output significantly. If the enemy comp also runs Baxia, whose passive halves all healing, Minotaur's primary teamfight contribution disappears. Run Floryn or Estes in those drafts instead.\"}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":\"Two or more heroes who can interrupt his ult windup. Khufra's Tyrant's Revenge ball, Franco's hook follow-up, and Chou's roundkick can all hit Minotaur between pressing Minoan Fury and the first smash and throw him backwards before the sequence completes. One of these is manageable; two makes his ult nearly unusable without extensive setup.\"}],\"\\n\"]}]\n80:[\"$\",\"p\",\"p-2\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"If you cannot identify which favorable condition applies to your current draft, Minotaur is not the pick.\"}]\n81:[\"$\",\"h2\",\"h2-1\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"What makes Minotaur actually work\"]}]\n82:[\"$\",\"p\",\"p-3\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Minotaur is a rage-bar management problem disguised as a tank.\"}]\n83:[\"$\",\"p\",\"p-4\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"His kit has two states. Outside enraged: a slow frontliner who can knock one target airborne on a long cooldown, heal one nearby teammate per S2 cast, and sustain himself through the passive's damage-taken recovery. Inside enraged: the stomp covers more ground and deals HP-scaled damage on enhanced basics, S2 heals all nearby teammates simultaneously, and the passive's recovery runs at double rate.\"}]\n84:[\"$\",\"p\",\"p-5\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The rage bar fills passively as Minotaur takes hits in combat. When it fills naturally, he enters enraged state automatically without burning the ult. Minoan Fury can be activated immediately for the 3-hit smash sequence, or held down to charge the rage bar faster, triggering enraged state at the end of the charge rather than going through the smash animation. The distinction matters: if the fight is already live and you need the airborne now, tap the ult immediately. If a fight is 2 to 3 seconds away and the rage bar is already high, hold the ult to enter enraged before the engagement starts and save the smash for after S1 lands.\"}]\n85:[\"$\",\"p\",\"p-6\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The 2.1.30 rework addressed the imbalance between Minotaur's healing output and his own durability. S2 in normal state now heals only the single lowest-HP ally nearby; the all-ally heal is the enraged payoff. Self-sustain moved into the passive, which recovers HP based on damage taken from enemy heroes and doubles in enraged state. Every game now has a clear internal structure: reach enraged state with S1, S2, and ult available, then use them in sequence.\"}]\n86:[\"$\",\"h2\",\"h2-2\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The first four minutes\"]}]\n87:[\"$\",\"p\",\"p-7\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Minotaur's early game is about positioning and patience, not winning fights.\"}]\n88:[\"$\",\"ol\",\"ol-0\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Level 1: Take S2 and donate the first buff.\"}],\" Roam to your jungler's opening buff and use S2 when their HP dips. The heal keeps them healthy through the clear and starts charging the rage bar passively as camp hits land on Minotaur.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Level 2: Take S1 and only gank at high rage.\"}],\" Below roughly 80% rage bar, burning Flicker to land S1 now trades a real chunk of damage for your only approach tool, leaving you in retreat with no way to re-engage until it comes back. The gank needs to threaten a kill or it costs two minutes of positioning.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Level 4-5: Your first real window.\"}],\" You have enough HP and enough levels in S1 and S2 to survive a fight long enough for the rage bar to charge from damage taken. This is when contesting the first turtle becomes realistic if your team is ahead.\"]}],\"\\n\"]}]\n89:[\"$\",\"p\",\"p-8\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Do not use S1 to retreat. It is your only gap-closer before Flicker. Walk backwards instead and take the hits; the rage bar filling is progress toward the next enraged state.\"}]\n8a:[\"$\",\"h2\",\"h2-3\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The power spike you're farming toward\"]}]\n8b:[\"$\",\"p\",\"p-9\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The two-item combination that changes Minotaur's teamfight presence is Oracle plus Dominance Ice, usually complete between the 10 and 13-minute mark depending on assist gold and roam bounty.\"}]\n8c:[\"$\",\"p\",\"p-10\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Oracle's Bless passive increases all received shield and HP regen effects by 25%. Every S2 heal tick, the Immortality revive shield, and Minotaur's own passive self-recovery from damage taken all scale with this item. At this point a single enraged S2 can swing enough HP across multiple teammates to flip a health trade mid-fight.\"}]\n8d:[\"$\",\"p\",\"p-11\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Dominance Ice turns Minotaur's body into a debuff zone. Its Lifebane passive reduces shield and HP regen effects of all nearby enemies within range to 60% of normal, and Fortress Shield stacks hybrid defense for each enemy hero close to him. Against a Beatrix or Karrie who depends on sustained damage and lifesteal, that constant suppression is more impactful than buying another layer of armor.\"}]\n8e:[\"$\",\"p\",\"p-12\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Once both items are complete, find the next turtle spawn and commit. Flicker into the enemy cluster, land S1, let the ult's first two hits stop their retreat, then land the airborne. Do not wait for a perfect 5-man ult; two or three targets in the airborne window is enough to win the objective.\"}]\n8f:[\"$\",\"$La8\",null,{\"slot\":\"7246933188\",\"variant\":\"in-article\",\"className\":\"my-8\"}]\n90:[[\"$\",\"h2\",\"h2-0\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Teamfight positioning and target priority\"]}],\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The reflex when your team is losing ground is to press S2. Resist it. In normal state, S2 heals only the single lowest-HP ally in range. Staying inside the fight, absorbing hits to charge the rage bar, and entering enraged state so S2 heals everyone is almost always the better play.\"}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Three rules that hold across most teamfight conditions:\"}],\"\\n\",[\"$\",\"ol\",\"ol-0\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Pair Flicker with S1, not S1 alone.\"}],\" S1 has a visible jump windup that experienced players will dash out of the moment they see it. Flicker into a tight cluster and land immediately; the instant blink plus landing gives enemies under half a second to react rather than the full jump duration.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Force the ult in chokepoints.\"}],\" The final airborne of Minoan Fury requires enemies to still be in range when the third hit lands. Wide open areas let enemies step away from the second hit's position before the third arrives. Narrow jungle corridors and tower gaps remove that angle entirely.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Use S2 in enraged state, not before.\"}],\" The one exception: if an assassin is collapsing on your carry with no teammates nearby and the carry dies in the next two seconds, use S2 immediately. That single-target save is worth more than waiting for the full-team version.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",\"p-2\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"If your support is Estes, you can initiate earlier and push further because his chain heal compensates for your HP loss during the engage. If your support is Diggie, that safety net does not exist and you should not commit until the rage bar is near full and the ult is ready.\"}],\"\\n\",[\"$\",\"h2\",\"h2-1\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Itemization: locked slots and real choices\"]}],\"\\n\",[\"$\",\"p\",\"p-3\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Oracle, Dominance Ice, and Immortality are locked every game. Oracle amplifies healing output, Dominance Ice suppresses nearby enemy sustain and stacks hybrid defense in teamfights, and Immortality is the safety valve for the aggressive initiations this hero requires. Build these three first, then fill the remaining three slots based on threat:\"}],\"\\n\",[\"$\",\"ul\",\"ul-0\",{\"className\":\"list-disc list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",\"$La9\",\"\\n\",\"$Laa\",\"\\n\",\"$Lab\",\"\\n\",\"$Lac\",\"\\n\",\"$Lad\",\"\\n\"]}],\"\\n\",\"$Lae\",\"\\n\",\"$Laf\",\"\\n\",\"$Lb0\",\"\\n\",\"$Lb1\",\"\\n\",\"$Lb2\",\"\\n\",\"$Lb3\",\"\\n\",\"$Lb4\",\"\\n\",\"$Lb5\",\"\\n\",\"$Lb6\",\"\\n\",\"$Lb7\",\"\\n\",\"$Lb8\",\"\\n\",\"$Lb9\",\"\\n\",\"$Lba\"]\n91:[\"$\",\"$Lbb\",null,{\"heroName\":\"Minotaur\"}]\n"])</script><script>self.__next_f.push([1,"92:[\"$\",\"div\",null,{\"className\":\"relative bg-surface-4 border border-mlbb-gold/20 overflow-hidden card-hover hover:border-mlbb-gold/50\",\"style\":{\"boxShadow\":\"0 2px 8px rgba(0,0,0,0.3)\"},\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 p-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative w-14 h-14 rounded-full overflow-hidden flex-shrink-0 