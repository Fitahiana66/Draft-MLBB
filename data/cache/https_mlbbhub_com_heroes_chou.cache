ipt><script>self.__next_f.push([1,"65:I[867777,[\"$7\",\"$8\",\"$9\",\"$a\",\"$b\",\"$2e\",\"$3e\",\"$3f\"],\"default\"]\n69:I[385664,[\"$7\",\"$8\",\"$9\",\"$a\",\"$b\",\"$2e\",\"$3e\",\"$3f\"],\"default\"]\n63:T9a2,{\"@context\":\"https://schema.org\",\"@type\":\"HowTo\",\"name\":\"How to Build Chou in Mobile Legends: Tank Roam\",\"description\":\"Competitive and high-rank setup where Chou plays as a pick-focused roamer. Conceal is the income engine (Thriving replaces the minion gold and EXP he gives up) and its invisibility plus movement speed walks the whole team into kick range before the target can react. He still kicks to deliver, but the tank items let him survive the approach and kick twice per extended fight. Concussive Blast adds HP-scaling AOE damage on the passive auto.\",\"totalTime\":\"PT15M\",\"supply\":[{\"@type\":\"HowToSupply\",\"name\":\"Tough Boots\"},{\"@type\":\"HowToSupply\",\"name\":\"Dominance Ice\"},{\"@type\":\"HowToSupply\",\"name\":\"Athena's Shield\"},{\"@type\":\"HowToSupply\",\"name\":\"Antique Cuirass\"},{\"@type\":\"HowToSupply\",\"name\":\"Queen's Wings\"},{\"@type\":\"HowToSupply\",\"name\":\"Immortality\"}],\"tool\":[{\"@type\":\"HowToTool\",\"name\":\"Tank Emblem\"},{\"@type\":\"HowToTool\",\"name\":\"Flicker Battle Spell\"}],\"step\":[{\"@type\":\"HowToStep\",\"position\":1,\"name\":\"Buy Tough Boots\",\"text\":\"Purchase Tough Boots (700 gold) as item 1 in the Tank Roam build for Chou.\",\"url\":\"https://mlbbhub.com/heroes/chou#build-tank-roam\"},{\"@type\":\"HowToStep\",\"position\":2,\"name\":\"Buy Dominance Ice\",\"text\":\"Purchase Dominance Ice (2,010 gold) as item 2 in the Tank Roam build for Chou.\",\"url\":\"https://mlbbhub.com/heroes/chou#build-tank-roam\"},{\"@type\":\"HowToStep\",\"position\":3,\"name\":\"Buy Athena's Shield\",\"text\":\"Purchase Athena's Shield (2,150 gold) as item 3 in the Tank Roam build for Chou.\",\"url\":\"https://mlbbhub.com/heroes/chou#build-tank-roam\"},{\"@type\":\"HowToStep\",\"position\":4,\"name\":\"Buy Antique Cuirass\",\"text\":\"Purchase Antique Cuirass (2,170 gold) as item 4 in the Tank Roam build for Chou.\",\"url\":\"https://mlbbhub.com/heroes/chou#build-tank-roam\"},{\"@type\":\"HowToStep\",\"position\":5,\"name\":\"Buy Queen's Wings\",\"text\":\"Purchase Queen's Wings (2,250 gold) as item 5 in the Tank Roam build for Chou.\",\"url\":\"https://mlbbhub.com/heroes/chou#build-tank-roam\"},{\"@type\":\"HowToStep\",\"position\":6,\"name\":\"Buy Immortality\",\"text\":\"Purchase Immortality (2,120 gold) as item 6 in the Tank Roam build for Chou.\",\"url\":\"https://mlbbhub.com/heroes/chou#build-tank-roam\"}],\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://mlbbhub.com/heroes/chou\"},\"datePublished\":\"2026-04-12T00:00:00.000Z\",\"dateModified\":\"2026-09-29T00:00:00.000Z\",\"author\":{\"@type\":\"Organization\",\"name\":\"MLBBHub\",\"url\":\"https://mlbbhub.com\"}}5e:[\"$\",\"script\",\"1\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$63\"}}]\n64:T9b4,{\"@context\":\"https://schema.org\",\"@type\":\"HowTo\",\"name\":\"How to Build Chou in Mobile Legends: Hybrid EXP Bruiser\",\"description\":\"Balanced setup for drafts where the enemy has one priority kick target but enough dive threat to punish full-damage Chou. Brute Force Breastplate adds stacking CC reduction, adaptive attack, and movement speed per second of combat, which stacks with Tough Boots to make Chou nearly CC-immune during extended fights.\",\"totalTime\":\"PT15M\",\"supply\":[{\"@type\":\"HowToSupply\",\"name\":\"Tough Boots\"},{\"@type\":\"HowToSupply\",\"name\":\"Blade of the Heptaseas\"},{\"@type\":\"HowToSupply\",\"name\":\"War Axe\"},{\"@type\":\"HowToSupply\",\"name\":\"Brute Force Breastplate\"},{\"@type\":\"HowToSupply\",\"name\":\"Malefic Roar\"},{\"@type\":\"HowToSupply\",\"name\":\"Immortality\"}],\"tool\":[{\"@type\":\"HowToTool\",\"name\":\"Fighter Emblem\"},{\"@type\":\"HowToTool\",\"name\":\"Flicker Battle Spell\"}],\"step\":[{\"@type\":\"HowToStep\",\"position\":1,\"name\":\"Buy Tough Boots\",\"text\":\"Purchase Tough Boots (700 gold) as item 1 in the Hybrid EXP Bruiser build for Chou.\",\"url\":\"https://mlbbhub.com/heroes/chou#build-hybrid-exp-bruiser\"},{\"@type\":\"HowToStep\",\"position\":2,\"name\":\"Buy Blade of the Heptaseas\",\"text\":\"Purchase Blade of the Heptaseas (1,950 gold) as item 2 in the Hybrid EXP Bruiser build for Chou.\",\"url\":\"https://mlbbhub.com/heroes/chou#build-hybrid-exp-bruiser\"},{\"@type\":\"HowToStep\",\"position\":3,\"name\":\"Buy War Axe\",\"text\":\"Purchase War Axe (2,100 gold) as item 3 in the Hybrid EXP Bruiser build for Chou.\",\"url\":\"https://mlbbhub.com/heroes/chou#build-hybrid-exp-bruiser\"},{\"@type\":\"HowToStep\",\"position\":4,\"name\":\"Buy Brute Force Breastplate\",\"text\":\"Purchase Brute Force Breastplate (1,870 gold) as item 4 in the Hybrid EXP Bruiser build for Chou.\",\"url\":\"https://mlbbhub.com/heroes/chou#build-hybrid-exp-bruiser\"},{\"@type\":\"HowToStep\",\"position\":5,\"name\":\"Buy Malefic Roar\",\"text\":\"Purchase Malefic Roar (2,060 gold) as item 5 in the Hybrid EXP Bruiser build for Chou.\",\"url\":\"https://mlbbhub.com/heroes/chou#build-hybrid-exp-bruiser\"},{\"@type\":\"HowToStep\",\"position\":6,\"name\":\"Buy Immortality\",\"text\":\"Purchase Immortality (2,120 gold) as item 6 in the Hybrid EXP Bruiser build for Chou.\",\"url\":\"https://mlbbhub.com/heroes/chou#build-hybrid-exp-bruiser\"}],\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://mlbbhub.com/heroes/chou\"},\"datePublished\":\"2026-04-12T00:00:00.000Z\",\"dateModified\":\"2026-09-29T00:00:00.000Z\",\"author\":{\"@type\":\"Organization\",\"name\":\"MLBBHub\",\"url\":\"https://mlbbhub.com\"}}5f:[\"$\",\"script\",\"2\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$64\"}}]\n60:[\"$\",\"$L65\",null,{\"hero\":{\"id\":26,\"name\":\"Chou\",\"slug\":\"chou\",\"title\":\"Kung Fu Boy\",\"role\":[\"Fighter\"],\"specialty\":[\"Chase\",\"Control\"],\"lane\":[\"EXP\",\"Roam\"],\"tier\":\"D\",\"difficulty\":2,\"releaseYear\":2016,\"stats\":{\"durability\":50,\"offense\":30,\"controlEffect\":80,\"difficulty\":60},\"winRate\":45.1,\"pickRate\":1.11,\"banRate\":3.06,\"counters\":{\"strongAgainst\":[{\"heroSlug\":\"terizla\",\"heroName\":\"Terizla\",\"advantage\":\"strong\",\"tip\":\"Chou counters slower Fighters like Terizla and Alpha that have a hard time dealing with his quick hit and run tactics.\"},{\"heroSlug\":\"alpha\",\"heroName\":\"Alpha\",\"advantage\":\"strong\",\"tip\":\"Chou counters slower Fighters like Terizla and Alpha that have a hard time dealing with his quick hit and run tactics.\"}],\"weakAgainst\":[{\"heroSlug\":\"lesley\",\"heroName\":\"Lesley\",\"advantage\":\"weak\",\"tip\":\"Chou is countered by heroes with very long-range like Lesley and Pharsa that can take out a chunk of his HP before he can get close.\"},{\"heroSlug\":\"pharsa\",\"heroName\":\"Pharsa\",\"advantage\":\"weak\",\"tip\":\"Chou is countered by heroes with very long-range like Lesley and Pharsa that can take out a chunk of his HP before he can get close.\"}]},\"splashArt\":\"https://akmweb.youngjoygame.com/web/svnres/file/mlbb/homepage/100_011409dfe1a2cf4cf5f879ea07fb3a8e.jpg\",\"portrait\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_158209b180032c4564b8f3bde8c48888.png\",\"officialMatchups\":[{\"kind\":\"best_ally\",\"heroId\":\"36\",\"heroName\":\"Aurora\",\"heroSlug\":\"aurora\",\"icon\":\"https://akmweb.youngjoygame.com/web/madmin/image/737f20a2934bbae1c5fd1b129dcbe066.jpg?w=200-200-fefefe\",\"tip\":\"Passive and Slow effects of Aurora makes it easier for Chou to reach an opponent or help to give a continuous Crowd Control effects after Chou kicks an enemy towards a teammate.\"},{\"kind\":\"counters\",\"heroId\":\"23\",\"heroName\":\"Gord\",\"heroSlug\":\"gord\",\"icon\":\"https://akmwebstatic.yuanzhanapp.com/web/madmin/image_24b9fa9519483b3d2168261b0fb6c0cf.png\",\"tip\":\"Gord lacked mobility and was unable to move when using his Ultimate. Chou can freely Cancels Gord’s Ultimate.\"},{\"kind\":\"countered_by\",\"heroId\":\"5\",\"heroName\":\"Nana\",\"heroSlug\":\"nana\",\"icon\":\"https://akmwebstatic.yuanzhanapp.com/web/madmin/image_08d0332be76ff7bdd894f7c7227be56c.png\",\"tip\":\"Nana’s Skill can easily stop Chou's movement, while preventing Chou from approaching you or your teammates.\"}],\"skills\":{\"skills\":[{\"name\":\"Only Fast\",\"type\":\"Passive\",\"description\":\"After traveling 5 units, Chou deals 180% damage on his next Basic Attack (cannot Crit), briefly slows the target by 90%, and reduces their Physical Defense by 10 (+1*Hero Level) for 3s (up to 2 stacks).\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"After traveling 5 units, Chou deals 180% damage on his next Basic Attack (cannot Crit), briefly slows the target by 90%, and reduces their \"},{\"type\":\"text\",\"text\":\"Physical Defense\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" by 10 (+1*Hero Level) for 3s (up to 2 stacks).\"}],\"cooldown\":null,\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_aca76a3a3dda44b6a0c3a72ff9bbcb94.png\",\"tags\":[\"Buff\"]},{\"name\":\"Jeet Kune Do\",\"type\":\"Skill 1\",\"description\":\"Chou strikes in the target direction, dealing 180 (+70% Total Physical Attack) Physical Damage to enemies hit. This skill can be cast 3 times before it goes on cooldown. On the 3rd cast, Chou also knocks enemies hit airborne.\\n\\nHitting an enemy hero with the 3rd cast resets the cooldown of Shunpo.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Chou strikes in the target direction, dealing 180\"},{\"type\":\"text\",\"text\":\" (+70% Total Physical Attack)\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Physical Damage\",\"color\":\"#fb1f1f\"},{\"type\":\"text\",\"text\":\" to enemies hit. This skill can be cast 3 times before it goes on cooldown. On the 3rd cast, Chou also knocks enemies hit airborne.\\n\\nHitting an enemy hero with the 3rd cast resets the cooldown of \"},{\"type\":\"text\",\"text\":\"Shunpo\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\".\"}],\"cooldown\":\"9.5s\",\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_70b2990486b562415dac32dac01bdb16.png\",\"tags\":[\"AOE\",\"Mobility\"]},{\"name\":\"Shunpo\",\"type\":\"Skill 2\",\"description\":\"Chou charges in the target direction, gaining Control Immunity and a 200 (+200% Extra Physical Attack) shield.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Chou charges in the target direction, gaining Control Immunity and a 200\"},{\"type\":\"text\",\"text\":\" (+200% Extra Physical Attack)\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" shield.\"}],\"cooldown\":\"5s\",\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_d784b75324318b23edb29b1fdd06bea0.png\",\"tags\":[\"Mobility\"]},{\"name\":\"The Way of Dragon\",\"type\":\"Ultimate\",\"description\":\"Chou strikes a roundhouse kick at the target enemy hero, dealing them 400 (+200% Extra Physical Attack) Physical Damage and knocking them back.\\n\\nCast the skill again to chase up the target, dealing a total of 480 (+240% Extra Physical Attack) Physical Damage.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Chou strikes a roundhouse kick at the target enemy hero, dealing them 400\"},{\"type\":\"text\",\"text\":\" (+200% Extra Physical Attack)\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Physical Damage\",\"color\":\"#fb1f1f\"},{\"type\":\"text\",\"text\":\" and knocking them back.\\n\\nCast the skill again to chase up the target, dealing a total of 480\"},{\"type\":\"text\",\"text\":\" (+240% Extra Physical Attack)\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Physical Damage\",\"color\":\"#fb1f1f\"},{\"type\":\"text\",\"text\":\".\"}],\"cooldown\":\"36s\",\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_05083715344213a996ab3ebf04381e93.png\",\"tags\":[\"CC\",\"Burst\"]}],\"skillUpgradePriority\":\"3-1-2\",\"skillPriorityTip\":\"Maximize the 1st Skill first, then upgrade the 2nd Skill, take the Ultimate Skill if it’s available.\\nFlicker is very useful both for chasing and throwing opponents with the 1st skill at the time of the third hit or also to escape if the 2nd skill is in Cooldown.\\nWhile Purification is very useful if there are many Crowd Control effects on the opposing team.\",\"skillPriorityTipRich\":[{\"type\":\"text\",\"text\":\"Maximize the 1st Skill first, then upgrade the 2nd Skill, take the Ultimate Skill if it’s available.\"},{\"type\":\"lineBreak\"},{\"type\":\"text\",\"text\":\"Flicker is very useful both for chasing and throwing opponents with the 1st skill at the time of the third hit or also to escape if the 2nd skill is in Cooldown.\"},{\"type\":\"lineBreak\"},{\"type\":\"text\",\"text\":\"While Purification is very useful if there are many Crowd Control effects on the opposing team.\"}]},\"synergies\":[{\"heroSlug\":\"angela\",\"heroName\":\"Angela\",\"synergyScore\":8,\"reason\":\"Chou works best with Healers that can boost his survivability and speed, such as Angela and Rafaela.\"},{\"heroSlug\":\"rafaela\",\"heroName\":\"Rafaela\",\"synergyScore\":8,\"reason\":\"Chou works best with Healers that can boost his survivability and speed, such as Angela and Rafaela.\"}],\"combos\":[{\"type\":\"teamfight\",\"title\":\"TEAMFIGHT COMBOS\",\"description\":\"In teamfights, use Chou's 2nd and 1st Skill to get next to a key target, then use his Ultimate to knock them out of position and secure the kill with his team.\",\"skillSequence\":[{\"skillId\":2620,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_d784b75324318b23edb29b1fdd06bea0.png\"},{\"skillId\":2610,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_70b2990486b562415dac32dac01bdb16.png\"},{\"skillId\":2630,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_05083715344213a996ab3ebf04381e93.png\"}]},{\"type\":\"laning\",\"title\":\"LANING COMBOS\",\"description\":\"In the laning phase, use Chou's 2nd Skill to get close to the enemy and follow up with his 1st Skill for multiple strikes. After landing the 3rd strike of his 1st Skill, use the refreshed 2nd Skill to stay on the target and finish them with his Ultimate.\",\"skillSequence\":[{\"skillId\":2620,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_d784b75324318b23edb29b1fdd06bea0.png\"},{\"skillId\":2610,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_70b2990486b562415dac32dac01bdb16.png\"},{\"skillId\":2620,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_d784b75324318b23edb29b1fdd06bea0.png\"},{\"skillId\":2630,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_05083715344213a996ab3ebf04381e93.png\"}]}],\"metaDescription\":\"Chou build, counter, and strategy guide for Mobile Legends. Learn the Flicker kick combo, EXP lane matchups, tank vs damage builds, and when NOT to pick him.\",\"builds\":[],\"overviewLede\":\"Chou is not a fighter in the traditional sense. He is a delivery service whose entire kit exists to grab one person and hand them to his team, dead. He works when the enemy has a specific target worth catching, and disappears when they do not.\"},\"serverLocale\":\"en\",\"curatedBuilds\":{\"source\":\"curated\",\"hero\":\"chou\",\"patch\":\"2.1.67\",\"lastReviewed\":\"2026-09-29\",\"stalePatch\":true,\"currentPatch\":\"2.2.16a\",\"builds\":[{\"slot\":1,\"id\":\"exp-damage-dealer\",\"name\":\"EXP Damage Dealer\",\"roleContext\":\"EXP\",\"items\":[{\"slug\":\"tough-boots\",\"name\":\"Tough Boots\",\"cost\":700,\"fixed\":false},{\"slug\":\"blade-of-the-heptaseas\",\"name\":\"Blade of the Heptaseas\",\"cost\":1950,\"fixed\":false},{\"slug\":\"war-axe\",\"name\":\"War Axe\",\"cost\":2100,\"fixed\":false},{\"slug\":\"endless-battle\",\"name\":\"Endless Battle\",\"cost\":2330,\"fixed\":false},{\"slug\":\"malefic-roar\",\"name\":\"Malefic Roar\",\"cost\":2060,\"fixed\":false},{\"slug\":\"immortality\",\"name\":\"Immortality\",\"cost\":2120,\"fixed\":false}],\"coreItems\":[{\"slug\":\"blade-of-the-heptaseas\",\"name\":\"Blade of the Heptaseas\"},{\"slug\":\"war-axe\",\"name\":\"War Axe\"},{\"slug\":\"endless-battle\",\"name\":\"Endless Battle\"}],\"emblem\":{\"slug\":\"fighter\",\"name\":\"Fighter Emblem\",\"talents\":[{\"slug\":\"firmness\",\"name\":\"Firmness\",\"iconUrl\":\"/images/talents/firmness.png\",\"bucket\":\"standard\"},{\"slug\":\"festival-of-blood\",\"name\":\"Festival of Blood\",\"iconUrl\":\"/images/talents/festival-of-blood.png\",\"bucket\":\"standard\"},{\"slug\":\"brave-smite\",\"name\":\"Brave Smite\",\"iconUrl\":\"/images/talents/brave-smite.png\",\"bucket\":\"core\"}]},\"spell\":{\"slug\":\"flicker\",\"name\":\"Flicker\"},\"blessing\":null,\"flexItems\":[{\"item\":{\"slug\":\"warrior-boots\",\"name\":\"Warrior Boots\"},\"replace\":{\"slug\":\"tough-boots\",\"name\":\"Tough Boots\"},\"trigger\":\"Use against full-physical lineups with no hard crowd control where armor value matters more than CC reduction.\"},{\"item\":{\"slug\":\"sea-halberd\",\"name\":\"Sea Halberd\"},\"replace\":{\"slug\":\"malefic-roar\",\"name\":\"Malefic Roar\"},\"trigger\":\"Use when the enemy has a healer, shield support, or high-HP fighter keeping the kick target alive through the burst.\"},{\"item\":{\"slug\":\"oracle\",\"name\":\"Oracle\"},\"replace\":{\"slug\":\"immortality\",\"name\":\"Immortality\"},\"trigger\":\"Use when fights are frequent and Oracle's Bless passive, which raises the shields and HP regen you receive by 25%, keeps you in the fight longer than a revive.\"},{\"item\":{\"slug\":\"radiant-armor\",\"name\":\"Radiant Armor\"},\"replace\":{\"slug\":\"malefic-roar\",\"name\":\"Malefic Roar\"},\"trigger\":\"Use against triple-magic-damage comps where stacked Magic Defense from Radiant Armor stacks prevents you from being burst before the combo lands.\"}],\"notes\":\"Default EXP setup for solo queue. Heptaseas rush into War Axe gives enough burst to kill a squishy from fog. Endless Battle's Divine Justice true damage fires off every skill cast during the combo chain.\",\"totalCost\":11260,\"statLines\":[{\"key\":\"physatk\",\"labelKey\":\"common.stats.physicalAttack\",\"unit\":\"flat\",\"group\":\"offensive\",\"value\":225,\"sources\":[\"Blade of the Heptaseas\",\"War Axe\",\"Endless Battle\",\"Malefic Roar\"]},{\"key\":\"physpenFlat\",\"labelKey\":\"common.stats.physicalPenetration\",\"unit\":\"flat\",\"group\":\"offensive\",\"value\":15,\"sources\":[\"Blade of the Heptaseas\"]},{\"key\":\"spellvamp\",\"labelKey\":\"common.stats.spellVamp\",\"unit\":\"percent\",\"group\":\"offensive\",\"value\":8,\"sources\":[\"War Axe\"]},{\"key\":\"hybridsteal\",\"labelKey\":\"common.stats.hybridLifesteal\",\"unit\":\"percent\",\"group\":\"offensive\",\"value\":8,\"sources\":[\"Endless Battle\"]},{\"key\":\"hp\",\"labelKey\":\"common.stats.hp\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":1700,\"sources\":[\"Blade of the Heptaseas\",\"War Axe\",\"Endless Battle\",\"Immortality\"]},{\"key\":\"physdefense\",\"labelKey\":\"common.stats.physicalDefense\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":15,\"sources\":[\"Immortality\"]},{\"key\":\"magicdefense\",\"labelKey\":\"common.stats.magicDefense\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":18,\"sources\":[\"Tough Boots\"]},{\"key\":\"mpregen\",\"labelKey\":\"common.stats.manaRegen\",\"unit\":\"flat\",\"group\":\"utility\",\"value\":5,\"sources\":[\"Endless Battle\"]},{\"key\":\"movespeed\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"flat\",\"group\":\"utility\",\"value\":40,\"sources\":[\"Tough Boots\"]},{\"key\":\"movespeedPct\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"percent\",\"group\":\"utility\",\"value\":5,\"sources\":[\"Endless Battle\"]},{\"key\":\"cdreduction\",\"labelKey\":\"common.stats.cooldownReduction\",\"unit\":\"percent\",\"group\":\"utility\",\"value\":20,\"sources\":[\"War Axe\",\"Endless Battle\"]}],\"conflicts\":[],\"simulatorUrl\":\"/build-simulator?hero=chou\u0026items=tough-boots%2Cblade-of-the-heptaseas%2Cwar-axe%2Cendless-battle%2Cmalefic-roar%2Cimmortality\u0026spell=flicker\u0026emblem=fighter\u0026talents=firmness%2Cfestival-of-blood%2Cbrave-smite\u0026flex=warrior-boots.tough-boots%2Csea-halberd.malefic-roar%2Coracle.immortality%2Cradiant-armor.malefic-roar\"},{\"slot\":2,\"id\":\"tank-roam\",\"name\":\"Tank Roam\",\"roleContext\":\"Roam\",\"items\":[{\"slug\":\"tough-boots\",\"name\":\"Tough Boots\",\"cost\":700,\"fixed\":false},{\"slug\":\"dominance-ice\",\"name\":\"Dominance Ice\",\"cost\":2010,\"fixed\":false},{\"slug\":\"athenas-shield\",\"name\":\"Athena's Shield\",\"cost\":2150,\"fixed\":false},{\"slug\":\"antique-cuirass\",\"name\":\"Antique Cuirass\",\"cost\":2170,\"fixed\":false},{\"slug\":\"queens-wings\",\"name\":\"Queen's Wings\",\"cost\":2250,\"fixed\":false},{\"slug\":\"immortality\",\"name\":\"Immortality\",\"cost\":2120,\"fixed\":false}],\"coreItems\":[{\"slug\":\"dominance-ice\",\"name\":\"Dominance Ice\"},{\"slug\":\"athenas-shield\",\"name\":\"Athena's Shield\"},{\"slug\":\"antique-cuirass\",\"name\":\"Antique Cuirass\"}],\"emblem\":{\"slug\":\"tank\",\"name\":\"Tank Emblem\",\"talents\":[{\"slug\":\"vitality\",\"name\":\"Vitality\",\"iconUrl\":\"/images/talents/vitality.png\",\"bucket\":\"standard\"},{\"slug\":\"tenacity\",\"name\":\"Tenacity\",\"iconUrl\":\"/images/talents/tenacity.png\",\"bucket\":\"standard\"},{\"slug\":\"concussive-blast\",\"name\":\"Concussive Blast\",\"iconUrl\":\"/images/talents/concussive-blast.png\",\"bucket\":\"core\"}]},\"spell\":{\"slug\":\"flicker\",\"name\":\"Flicker\"},\"blessing\":{\"slug\":\"conceal\",\"name\":\"Conceal\"},\"flexItems\":[{\"item\":{\"slug\":\"brute-force-breastplate\",\"name\":\"Brute Force Breastplate\"},\"replace\":{\"slug\":\"antique-cuirass\",\"name\":\"Antique Cuirass\"},\"trigger\":\"Use when the enemy physical threat is split across multiple sources and you need the stacking CC reduction and adaptive attack rather than single-source Deter debuff.\"},{\"item\":{\"slug\":\"oracle\",\"name\":\"Oracle\"},\"replace\":{\"slug\":\"athenas-shield\",\"name\":\"Athena's Shield\"},\"trigger\":\"Use when magic damage is sustained poke rather than one-shot burst, and you have a healer support whose shields and heals on you are raised by 25% through Oracle's Bless passive.\"},{\"item\":{\"slug\":\"radiant-armor\",\"name\":\"Radiant Armor\"},\"replace\":{\"slug\":\"queens-wings\",\"name\":\"Queen's Wings\"},\"trigger\":\"Use against repeated magic damage from mages like Chang'e or Gord where Radiant Armor stacks outvalue Queen's Wings burst protection.\"}],\"notes\":\"Competitive and high-rank setup where Chou plays as a pick-focused roamer. Conceal is the income engine (Thriving replaces the minion gold and EXP he gives up) and its invisibility plus movement speed walks the whole team into kick range before the target can react. He still kicks to deliver, but the tank items let him survive the approach and kick twice per extended fight. Concussive Blast adds HP-scaling AOE damage on the passive auto.\",\"totalCost\":11400,\"statLines\":[{\"key\":\"adaptiveatk\",\"labelKey\":\"common.stats.adaptiveAttack\",\"unit\":\"flat\",\"group\":\"offensive\",\"value\":40,\"sources\":[\"Queen's Wings\"]},{\"key\":\"spellvamp\",\"labelKey\":\"common.stats.spellVamp\",\"unit\":\"percent\",\"group\":\"offensive\",\"value\":10,\"sources\":[\"Queen's Wings\"]},{\"key\":\"hp\",\"labelKey\":\"common.stats.hp\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":3220,\"sources\":[\"Athena's Shield\",\"Antique Cuirass\",\"Queen's Wings\",\"Immortality\"]},{\"key\":\"hpregen\",\"labelKey\":\"common.stats.hpRegen\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":6,\"sources\":[\"Athena's Shield\",\"Antique Cuirass\"]},{\"key\":\"physdefense\",\"labelKey\":\"common.stats.physicalDefense\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":95,\"sources\":[\"Dominance Ice\",\"Antique Cuirass\",\"Immortality\"]},{\"key\":\"magicdefense\",\"labelKey\":\"common.stats.magicDefense\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":106,\"sources\":[\"Tough Boots\",\"Dominance Ice\",\"Athena's Shield\"]},{\"key\":\"movespeed\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"flat\",\"group\":\"utility\",\"value\":40,\"sources\":[\"Tough Boots\"]},{\"key\":\"movespeedPct\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"percent\",\"group\":\"utility\",\"value\":5,\"sources\":[\"Dominance Ice\"]},{\"key\":\"cdreduction\",\"labelKey\":\"common.stats.cooldownReduction\",\"unit\":\"percent\",\"group\":\"utility\",\"value\":10,\"sources\":[\"Queen's Wings\"]}],\"conflicts\":[],\"simulatorUrl\":\"/build-simulator?hero=chou\u0026items=tough-boots%2Cdominance-ice%2Cathenas-shield%2Cantique-cuirass%2Cqueens-wings%2Cimmortality\u0026blessing=conceal\u0026spell=flicker\u0026emblem=tank\u0026talents=vitality%2Ctenacity%2Cconcussive-blast\u0026flex=brute-force-breastplate.antique-cuirass%2Coracle.athenas-shield%2Cradiant-armor.queens-wings\"},{\"slot\":3,\"id\":\"hybrid-exp-bruiser\",\"name\":\"Hybrid EXP Bruiser\",\"roleContext\":\"EXP\",\"items\":[{\"slug\":\"tough-boots\",\"name\":\"Tough Boots\",\"cost\":700,\"fixed\":false},{\"slug\":\"blade-of-the-heptaseas\",\"name\":\"Blade of the Heptaseas\",\"cost\":1950,\"fixed\":false},{\"slug\":\"war-axe\",\"name\":\"War Axe\",\"cost\":2100,\"fixed\":false},{\"slug\":\"brute-force-breastplate\",\"name\":\"Brute Force Breastplate\",\"cost\":1870,\"fixed\":false},{\"slug\":\"malefic-roar\",\"name\":\"Malefic Roar\",\"cost\":2060,\"fixed\":false},{\"slug\":\"immortality\",\"name\":\"Immortality\",\"cost\":2120,\"fixed\":false}],\"coreItems\":[{\"slug\":\"blade-of-the-heptaseas\",\"name\":\"Blade of the Heptaseas\"},{\"slug\":\"war-axe\",\"name\":\"War Axe\"},{\"slug\":\"brute-force-breastplate\",\"name\":\"Brute Force Breastplate\"}],\"emblem\":{\"slug\":\"fighter\",\"name\":\"Fighter Emblem\",\"talents\":[{\"slug\":\"firmness\",\"name\":\"Firmness\",\"iconUrl\":\"/images/talents/firmness.png\",\"bucket\":\"standard\"},{\"slug\":\"festival-of-blood\",\"name\":\"Festival of Blood\",\"iconUrl\":\"/images/talents/festival-of-blood.png\",\"bucket\":\"standard\"},{\"slug\":\"brave-smite\",\"name\":\"Brave Smite\",\"iconUrl\":\"/images/talents/brave-smite.png\",\"bucket\":\"core\"}]},\"spell\":{\"slug\":\"flicker\",\"name\":\"Flicker\"},\"blessing\":null,\"flexItems\":[{\"item\":{\"slug\":\"endless-battle\",\"name\":\"Endless Battle\"},\"replace\":{\"slug\":\"brute-force-breastplate\",\"name\":\"Brute Force Breastplate\"},\"trigger\":\"Use when your team already has a tanky frontliner and you can commit to the full damage combo without needing the extra durability.\"},{\"item\":{\"slug\":\"dominance-ice\",\"name\":\"Dominance Ice\"},\"replace\":{\"slug\":\"malefic-roar\",\"name\":\"Malefic Roar\"},\"trigger\":\"Use when the enemy jungler or marksman relies on attack speed and lifesteal to win fights, and your kick plus the anti-heal aura shuts them down.\"},{\"item\":{\"slug\":\"sea-halberd\",\"name\":\"Sea Halberd\"},\"replace\":{\"slug\":\"malefic-roar\",\"name\":\"Malefic Roar\"},\"trigger\":\"Use when anti-heal is mandatory on your physical slot and the enemy front line has not yet stacked enough armor to justify penetration.\"},{\"item\":{\"slug\":\"radiant-armor\",\"name\":\"Radiant Armor\"},\"replace\":{\"slug\":\"malefic-roar\",\"name\":\"Malefic Roar\"},\"trigger\":\"Use against teams with multiple magic-damage threats where you need to survive the approach before the kick connects.\"}],\"notes\":\"Balanced setup for drafts where the enemy has one priority kick target but enough dive threat to punish full-damage Chou. Brute Force Breastplate adds stacking CC reduction, adaptive attack, and movement speed per second of combat, which stacks with Tough Boots to make Chou nearly CC-immune during extended fights.\",\"totalCost\":10800,\"statLines\":[{\"key\":\"physatk\",\"labelKey\":\"common.stats.physicalAttack\",\"unit\":\"flat\",\"group\":\"offensive\",\"value\":165,\"sources\":[\"Blade of the Heptaseas\",\"War Axe\",\"Malefic Roar\"]},{\"key\":\"physpenFlat\",\"labelKey\":\"common.stats.physicalPenetration\",\"unit\":\"flat\",\"group\":\"offensive\",\"value\":15,\"sources\":[\"Blade of the Heptaseas\"]},{\"key\":\"spellvamp\",\"labelKey\":\"common.stats.spellVamp\",\"unit\":\"percent\",\"group\":\"offensive\",\"value\":8,\"sources\":[\"War Axe\"]},{\"key\":\"hp\",\"labelKey\":\"common.stats.hp\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":2050,\"sources\":[\"Blade of the Heptaseas\",\"War Axe\",\"Brute Force Breastplate\",\"Immortality\"]},{\"key\":\"physdefense\",\"labelKey\":\"common.stats.physicalDefense\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":35,\"sources\":[\"Brute Force Breastplate\",\"Immortality\"]},{\"key\":\"magicdefense\",\"labelKey\":\"common.stats.magicDefense\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":18,\"sources\":[\"Tough Boots\"]},{\"key\":\"movespeed\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"flat\",\"group\":\"utility\",\"value\":40,\"sources\":[\"Tough Boots\"]},{\"key\":\"cdreduction\",\"labelKey\":\"common.stats.cooldownReduction\",\"unit\":\"percent\",\"group\":\"utility\",\"value\":20,\"sources\":[\"War Axe\",\"Brute Force Breastplate\"]}],\"conflicts\":[],\"simulatorUrl\":\"/build-simulator?hero=chou\u0