/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_2fe99f4001211d18b3d2b95d0d3dc395.png&amp;w=48&amp;output=webp&amp;q=75&amp;we 1x, https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_2fe99f4001211d18b3d2b95d0d3dc395.png&amp;w=96&amp;output=webp&amp;q=75&amp;we 2x" src="https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_2fe99f4001211d18b3d2b95d0d3dc395.png&amp;w=96&amp;output=webp&amp;q=75&amp;we"/></div></a><div class="min-w-0 flex-1"><div class="flex items-center gap-2 sm:gap-3 flex-wrap"><a class="min-w-0 max-w-full truncate font-heading font-bold text-base sm:text-lg text-text-primary hover:text-text-accent-bright transition-colors" href="/heroes/khufra">Khufra</a><div class="inline-flex items-center justify-center font-heading font-bold bg-gradient-to-br from-[#FFD700] to-[#FFA500] text-[#1a1600] shadow-[0_0_12px_rgba(255,215,0,0.4)] w-6 h-6 text-xs animate-tier-pop">S</div><div class="gap-1.5 hidden sm:flex"><span class="text-[10px] px-1.5 py-0.5" style="background-color:#3498DB20;color:#71b7e6">Tank</span></div></div><p class="text-xs text-text-muted mt-1 line-clamp-2">Khufra&#x27;s CC abilities disrupt Chou&#x27;s aggressive playstyle, preventing clean dives and resets.</p></div><div class="flex-shrink-0 text-right"><p class="flex items-center justify-end gap-1 text-lg sm:text-xl font-heading font-bold" style="color:#44ff88"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trending-up w-3.5 h-3.5" aria-hidden="true"><path d="M16 7h6v6"></path><path d="m22 7-8.5 8.5-5-5L2 17"></path></svg>+<!-- -->2.2</p><p class="text-[9px] text-text-muted uppercase hidden sm:block">win rate delta</p></div></div><div class="absolute top-0 lef