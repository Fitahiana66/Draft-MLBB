le\":{\"background\":\"linear-gradient(to bottom, #ff5d73, #ff5d7333)\",\"boxShadow\":\"0 0 12px -2px #ff5d7380\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#ff5d73\",\"background\":\"#ff5d731a\",\"border\":\"1px solid #ff5d7340\"},\"children\":\"Mythical Glory+\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Chou\",\"rank\":\"Mythical Glory+\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=mythical_glory\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Mythical Glory+\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Mythical Glory+\",\"name\":\"Chou\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"44.28\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Chou\",\"delta\":\"-0.82%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.87\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"1.13\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Mythical Glory+\"}}]]}]]}]\nab:[\"$\",\"h2\",\"h2-1\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Mistakes that lose Chou games\"]}]\nac:[\"$\",\"ol\",\"ol-0\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Opening S2 into Benedetta during her parry window.\"}],\" An Eye for An Eye blocks all damage with Control Immunity while it is up, and if she fends off any control effect her follow-up stab stuns you. Chou dashing in on S2 while her parry is active feeds it directly. The correct sequence is to bait her S2 with the first S1 cast, wait it out, then commit the real combo during her vulnerability window.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Ulting inside Diggie's Time Journey radius.\"}],\" The ult grants allies Control Immunity and a shield, which cleanses your knockback and eats most of the kick damage. Track when Diggie uses it or dies into egg form. The window after his ult expires is the only reliable window where your delivery works.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Fighting inside Minsitthar's King's Calling.\"}],\" The field disables every movement skill for enemies standing in it, which means your three S1 dashes, your S2 dash, and the chase cast on the ult all stop working. S2's Control Immunity is irrelevant here because the restriction is on movement skills themselves, not on a debuff you can cleanse. Walk out of the zone and wait it out; do not commit inside.\"]}],\"\\n\",[\"$\",\"li\",\"li-3\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Dashing near Phoveus without tracking his passive.\"}],\" Astaros Eye fires a homing projectile at any enemy who uses a dash or blink within range, dealing damage, slowing, and granting Phoveus a shield. Chou's three S1 dashes plus S2 equals four passive procs before you even press ult. If Phoveus is on the enemy team, either he is the kick target and you burst him before the passive stacks, or you do not dash near him at all.\"]}],\"\\n\",[\"$\",\"li\",\"li-4\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Burning Flicker on lane harassment before level 4.\"}],\" Flicker is not your escape. It is the second half of the combo, and spending it on a level-3 trade means you do nothing of value for the next 120 seconds. If you die in lane without Flicker, you still had the S2 Control Immunity and wall angles to escape. Using Flicker early was the mistake the death merely confirmed.\"]}],\"\\n\"]}]\nad:[\"$\",\"h2\",\"h2-2\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Key tips\"]}]\nae:[\"$\",\"div\",\"blockquote-0\",{\"className\":\"my-5 p-4 flex gap-3\",\"style\":{\"background\":\"rgba(200,170,110,0.08)\",\"border\":\"1px solid rgba(200,170,110,0.35)\"},\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-lightbulb w-4 h-4 flex-shrink-0 mt-0.5\",\"aria-hidden\":\"true\",\"style\":{\"color\":\"#C8AA6E\"},\"children\":[[\"$\",\"path\",\"1gvzjb\",{\"d\":\"M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5\"}],[\"$\",\"path\",\"x1upvd\",{\"d\":\"M9 18h6\"}],[\"$\",\"path\",\"ceow96\",{\"d\":\"M10 22h4\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[11px] font-heading font-bold uppercase tracking-wider mb-1\",\"style\":{\"color\":\"#C8AA6E\"},\"children\":\"Tip\"}],[[\"$\",\"p\",\"0\",{\"className\":\"text-sm text-[#9BA0B4] leading-relaxed\",\"children\":[\"The full Flicker-kick combo: S1 three times to close and knockup, S2 for Control Immunity to cover any remaining distance, ult the target for the first kick, then Flicker backward to drag them into your team before the second ult cast chases up. The entire sequence must fit under 1.5 seconds. Any slower and Purify or Flicker comes off the target before the chase lands.\"]}]]]}]]}]\naf:[\"$\",\"div\",\"blockquote-1\",{\"className\":\"my-5 p-4 flex gap-3\",\"style\":{\"background\":\"rgba(200,170,110,0.08)\",\"border\":\"1px solid rgba(200,170,110,0.35)\"},\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-lightbulb w-4 h-4 flex-shrink-0 mt-0.5\",\"aria-hidden\":\"true\",\"style\":{\"color\":\"#C8AA6E\"},\"children\":[[\"$\",\"path\",\"1gvzjb\",{\"d\":\"M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5\"}],[\"$\",\"path\",\"x1upvd\",{\"d\":\"M9 18h6\"}],[\"$\",\"path\",\"ceow96\",{\"d\":\"M10 22h4\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[11px] font-heading font-bold uppercase tracking-wider mb-1\",\"style\":{\"color\":\"#C8AA6E\"},\"children\":\"Tip\"}],[[\"$\",\"p\",\"0\",{\"className\":\"text-sm text-[#9BA0B4] leading-relaxed\",\"children\":[\"Jeet Kune Do's third cast hitting an enemy hero resets Shunpo's cooldown immediately. After every completed knockup-into-kick, a fresh S2 is available as an escape. Never skip the third cast: without it you lose the knockup guarantee and the S2 reset in the same mistake.\"]}]]]}]]}]\nb0:[\"$\",\"div\",\"blockquote-2\",{\"className\":\"my-5 p-4 flex gap-3\",\"style\":{\"background\":\"rgba(0,170,255,0.08)\",\"border\":\"1px solid rgba(0,170,255,0.35)\"},\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-info w-4 h-4 flex-shrink-0 mt-0.5\",\"aria-hidden\":\"true\",\"style\":{\"color\":\"#00AAFF\"},\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"1dtifu\",{\"d\":\"M12 16v-4\"}],[\"$\",\"path\",\"e9boi3\",{\"d\":\"M12 8h.01\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[11px] font-heading font-bold uppercase tracking-wider mb-1\",\"style\":{\"color\":\"#00AAFF\"},\"children\":\"Note\"}],[[\"$\",\"p\",\"0\",{\"className\":\"text-sm text-[#9BA0B4] leading-relaxed\",\"children\":[\"Chou's passive auto cannot critically strike. This is a design choice that keeps him a combo-burst hero, not an auto-attacker. If a build guide recommends Berserker's Fury or any crit chance item on Chou, close that guide. The damage is in the fixed scaling on S1 and ult base numbers, not in auto-attack DPS.\"]}]]]}]]}]\nb1:[\"$\",\"div\",\"blockquote-3\",{\"className\":\"my-5 p-4 flex gap-3\",\"style\":{\"background\":\"rgba(200,170,110,0.08)\",\"border\":\"1px solid rgba(200,170,110,0.35)\"},\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-lightbulb w-4 h-4 flex-shrink-0 mt-0.5\",\"aria-hidden\":\"true\",\"style\":{\"color\":\"#C8AA6E\"},\"children\":[[\"$\",\"path\",\"1gvzjb\",{\"d\":\"M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5\"}],[\"$\",\"path\",\"x1upvd\",{\"d\":\"M9 18h6\"}],[\"$\",\"path\",\"ceow96\",{\"d\":\"M10 22h4\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[11px] font-heading font-bold uppercase tracking-wider mb-1\",\"style\":{\"color\":\"#C8AA6E\"},\"children\":\"Tip\"}],[[\"$\",\"p\",\"0\",{\"className\":\"text-sm text-[#9BA0B4] leading-relaxed\",\"children\":[\"Check enemy battle spells during the loading screen. Purify gives 1.2 seconds of Control Immunity on a 90-second cooldown, which cleanses the kick on contact. Either switch targets to someone without Purify, or bait the Purify with a fake S1 approach before committing the real combo.\"]}]]]}]]}]\nb2:[\"$\",\"div\",\"blockquote-4\",{\"className\":\"my-5 p-4 flex gap-3\",\"style\":{\"background\":\"rgba(0,170,255,0.08)\",\"border\":\"1px solid rgba(0,170,255,0.35)\"},\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-info w-4 h-4 flex-shrink-0 mt-0.5\",\"aria-hidden\":\"true\",\"style\":{\"color\":\"#00AAFF\"},\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"1dtifu\",{\"d\":\"M12 16v-4\"}],[\"$\",\"path\",\"e9boi3\",{\"d\":\"M12 8h.01\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[11px] font-heading font-bold uppercase tracking-wider mb-1\",\"style\":{\"color\":\"#00AAFF\"},\"children\":\"Note\"}],[[\"$\",\"p\",\"0\",{\"className\":\"text-sm text-[#9BA0B4] leading-relaxed\",\"children\":[\"The passive defense shred stacks on repeat hits, so the same target gets meaningfully lighter in armor the longer you stay on them. That amplifies every physical attacker on your team, not just Chou. Weaving passive autos between S1 casts in an extended skirmish is a meaningful team-damage buff, not just a personal combo tool.\"]}]]]}]]}]\n"])</script></body></html>