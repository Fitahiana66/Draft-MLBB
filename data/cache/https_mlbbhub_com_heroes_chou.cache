\"round\",\"className\":\"lucide lucide-trending-up inline-block w-2.5 h-2.5 sm:w-3.5 sm:h-3.5 text-text-muted\",\"aria-hidden\":\"true\",\"children\":[\"$La2\",\"$La3\",\"$undefined\"]}],\"+0.30%\"]}]]}]}],\"$La4\",\"$La5\"]]}]\n7b:[\"$\",\"p\",null,{\"className\":\"mt-3 flex flex-wrap items-center gap-x-5 gap-y-1.5 text-[11px] text-text-muted\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-1.5\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block h-3 w-5 rounded-sm bg-mlbb-gold/[0.07] ring-1 ring-inset ring-mlbb-gold/20\",\"aria-hidden\":\"true\"}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankColDelta\"}]]}],[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-1.5\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-trending-up h-3.5 w-3.5 text-text-muted\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"box55l\",{\"d\":\"M16 7h6v6\"}],[\"$\",\"path\",\"1t1m79\",{\"d\":\"m22 7-8.5 8.5-5-5L2 17\"}],\"$undefined\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankColTrend\",\"params\":{\"days\":7}}]]}]]}]\n7c:[\"$\",\"div\",null,{\"className\":\"mt-5 grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-3\",\"children\":[[\"$\",\"article\",\"epic\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #B07ECC, #B07ECC33)\",\"boxShadow\":\"0 0 12px -2px #B07ECC80\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#B07ECC\",\"background\":\"#B07ECC1a\",\"border\":\"1px solid #B07ECC40\"},\"children\":\"Epic\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Chou\",\"rank\":\"Epic\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=epic\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Epic\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Epic\",\"name\":\"Chou\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"45.24\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Chou\",\"delta\":\"+0.14%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"1.23\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"4.98\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Epic\"}}]]}]]}],[\"$\",\"article\",\"legend\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #4dc9f6, #4dc9f633)\",\"boxShadow\":\"0 0 12px -2px #4dc9f680\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#4dc9f6\",\"background\":\"#4dc9f61a\",\"border\":\"1px solid #4dc9f640\"},\"children\":\"Legend\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Chou\",\"rank\":\"Legend\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=legend\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Legend\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Legend\",\"name\":\"Chou\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"45.35\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Chou\",\"delta\":\"+0.25%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"1.20\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"3.49\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Legend\"}}]]}]]}],[\"$\",\"article\",\"mythic\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #f59e0b, #f59e0b33)\",\"boxShadow\":\"0 0 12px -2px #f59e0b80\"}}],\"$La6\",\"$La7\"]}],\"$La8\",\"$La9\"]}]\n7e:[\"$\",\"p\",\"p-3\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"If you cannot name who you plan to kick, Chou is not the right pick.\"}]\n7f:[\"$\",\"h2\",\"h2-1\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The one thing that makes Chou work\"]}]\n80:[\"$\",\"p\",\"p-4\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Chou is a displacement machine disguised as a fighter.\"}]\n81:[\"$\",\"p\",\"p-5\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Every skill in his kit serves the same purpose: reach one person and move them somewhere they do not want to be. Jeet Kune Do is not a damage tool. It is three chained dashes that knock airborne on the third cast, and that knockup guarantees the follow-up ult lands. Shunpo is not a shield-and-run button. It is a Control-Immune gap closer that resets the moment the third-cast knockup connects, so every completed combo refunds its own escape. The Way of Dragon is not a finisher. It is a two-stage forced relocation that, combined with Flicker, delivers any hero on the map into the middle of your team.\"}]\n82:[\"$\",\"p\",\"p-6\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The passive, Only Fast, reinforces the identity. After moving a short distance, Chou's next basic attack hits far harder, cannot crit, heavily slows the target, and shreds a chunk of their physical defense for a few seconds, stacking on repeat hits. That is not a laning passive. That is an after-kick passive: the target is airborne, slowed to a crawl, and noticeably lighter in armor while your carry stands on top of them.\"}]\n83:[\"$\",\"p\",\"p-7\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Once that reframing lands, everything about how you play him changes. You stop looking for extended trades and start looking for the one kick that ends the fight.\"}]\n84:[\"$\",\"h2\",\"h2-2\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Laning: the first four minutes\"]}]\n85:[\"$\",\"p\",\"p-8\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Chou's EXP lane is about chip damage and survival, not domination. You are not trying to kill your lane opponent. You are trying to hit level 4 with enough HP to rotate for the first objective fight.\"}]\n86:[\"$\",\"ol\",\"ol-0\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Level 1, take Jeet Kune Do and trade off the third cast.\"}],\" Walk up, S1 first cast through the minion wave, S1 second cast to reposition, S1 third cast through the enemy hero for the knockup. Walk away. Do not commit further. The knockup plus the empowered passive auto with defense shred is the whole trade pattern and it costs no battle spell.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"At level 2, take Shunpo and use it defensively.\"}],\" Control Immunity on Shunpo is your answer to ganks and to EXP laners who try to all-in you at 2. Do not burn it as an engage tool until the ult is online.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"At level 4, take The Way of Dragon and look at the map.\"}],\" Chou with ult and Flicker up can rotate to mid or a jungle entrance and deliver a kill. The moment the ult unlocks, lane phase is optional. Push the wave, then disappear.\"]}],\"\\n\"]}]\n87:[\"$\",\"p\",\"p-9\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Do not burn Flicker for a lane trade before level 4 under any circumstances. Flicker is not your escape. It is the second half of the kick combo, and wasting it in lane means you cannot execute your purpose for the next 120 seconds.\"}]\n88:[\"$\",\"h2\",\"h2-3\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The power spike you are farming toward\"]}]\n89:[\"$\",\"p\",\"p-10\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[\"Chou is one of the least item-dependent heroes in the game. His spike is not an item. His spike is \",[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"level 4 with Flicker off cooldown\"}],\". That is the moment he goes from a mediocre EXP laner to a hero who can delete any squishy on the map.\"]}]\n8a:[\"$\",\"p\",\"p-11\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The first item that matters is Tough Boots, not for the magic defense but for the 30% CC duration reduction, because the one thing that stops a Chou combo is being stunned or rooted during the approach. The second item is Blade of the Heptaseas, usually completed somewhere in the 6-to-8-minute window depending on lane state. The Heptaseas Ambush proc (160 plus 40% Physical Attack as bonus damage after 5 seconds out of combat) combined with the passive-enhanced auto and the first ult kick is enough to kill a 70%-HP squishy without any help from the team.\"}]\n8b:[\"$\",\"p\",\"p-12\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The moment Tough Boots plus Heptaseas come online, a Chou with Flicker up can walk into fog, S1 three times to knockup, S2 to close the final gap under Control Immunity, ult the target for the first kick, then Flicker backward to drag them behind your frontline before the second ult cast chases up. This is the combo that defines Chou at every rank from Legend to Mythical Glory. Practice it until the full sequence takes under 1.5 seconds. Any longer and Purify or Flicker comes off the target before the second cast lands.\"}]\n8c:[\"$\",\"p\",\"p-13\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"After Heptaseas the build diverges on whether your team needs damage or a tank. That conversation is the next section.\"}]\n8d:[\"$\",\"h2\",\"h2-4\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Teamfight positioning and target priority\"]}]\n8e:[\"$\",\"p\",\"p-14\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The reflex with Chou is to look for the biggest ongoing teamfight and S1 into the middle of it. That reflex is wrong.\"}]\n8f:[\"$\",\"p\",\"p-15\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Chou is not a teamfight hero. He is a pre-fight hero. His job happens in the 3 seconds before the fight starts, not during it. You identify the target, you deliver the kick, your team kills them, and then you play the resulting 5v4.\"}]\n90:[\"$\",\"p\",\"p-16\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Three positioning rules:\"}]\n91:[\"$\",\"ol\",\"ol-1\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Stand in fog, not on the frontline.\"}],\" If the enemy can see you, they know the kick is coming and they position around it. Chou's threat radius is infinite when he is invisible and zero when he is visible. Hide in bushes, behind walls, in the jungle. The kick comes from the angle they do not expect.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Flicker backward, not forward.\"}],\" The classic mistake is Flickering toward the enemy for the engage. The correct play is almost always to land the first ult cast, then Flicker backward to drag the knocked-back target into your team before the second cast chases up. The delivery ends with the target inside your backline and Chou safely behind his own.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"If you miss the third-cast S1 knockup, do not commit.\"}],\" The knockup is what guarantees the ult connects. Without it, the target can dash or Flicker out of ult range during your cast animation. Walk away and wait out the cooldown for the next cycle.\"]}],\"\\n\"]}]\n92:[\"$\",\"p\",\"p-17\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"If your team has no follow-up damage available, do not kick. A Chou who delivers a marksman into four half-health teammates who are retreating has just donated a free kill to the enemy. The kick only works when your team is healthy enough to finish the delivery.\"}]\n93:[\"$\",\"$Laa\",null,{\"slot\":\"7246933188\",\"variant\":\"in-article\",\"className\":\"my-8\"}]\n94:[[\"$\",\"h2\",\"h2-0\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Itemization: defaults vs flex slots\"]}],\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Chou has one locked slot and five flex positions, which is the opposite of most fighters.\"}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"The one lock is Tough Boots.\"}],\" Everything else depends on what the game wants from you. The 30% CC reduction on Tough Boots is non-negotiable because CC during the approach is what kills Chou. Warrior Boots only against full-physical lineups with no CC, which is rare. Never Swift Boots. You are not an auto-attacker.\"]}],\"\\n\",[\"$\",\"p\",\"p-2\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"If you are the primary damage threat\"}],\" (no assassin in the jungle, team needs you to deal damage): Blade of the Heptaseas second for the Ambush burst, War Axe third for the 10% CDR plus stacking physical attack and 10% true damage conversion at full Fighting Spirit stacks, Endless Battle fourth for the 60% physical attack as true damage on every post-skill auto, Malefic Roar fifth if the enemy stacks armor, Immortality sixth. Endless Battle is the quiet power pick because Chou casts a skill roughly every second during a combo and Divine Justice fires off each one.\"]}],\"\\n\",[\"$\",\"p\",\"p-3\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"If your team has enough damage and needs a tank\"}],\" (common in higher ranks where Chou plays roam): skip Heptaseas entirely. Build Dominance Ice for the Fortress Shield hybrid defense aura and Lifebane anti-heal aura, Athena's Shield against magic burst for the 25% magic damage reduction, Antique Cuirass for the stacking physical attack debuff on attackers, Queen's Wings for the 30% damage reduction below 40% HP, and Immortality. Tank Chou still kicks to deliver, but he survives long enough to kick twice per fight.\"]}],\"\\n\",[\"$\",\"p\",\"p-4\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"If you need a balanced bruiser\"}],\" (enemy has one priority target but also enough dive to punish full-damage Chou): Heptaseas into War Axe into Brute Force Breastplate. Brute Force gives 10% CDR, stacking adaptive attack and movement speed per second of combat, and 15% extra CC reduction at full stacks on top of Tough Boots, bringing you near-immune to CC during extended fights. Fill out with Malefic Roar and Immortality.\"]}],\"\\n\",[\"$\",\"p\",\"p-5\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"The weakest common buy is Blade of Despair.\"}],\" Chou's burst combo scales off fixed base damage on the passive auto, the S1 strikes, and the two ult casts. Despair's +25% attack trigger only activates below 50% HP, which is the point the target should already be dead. CDR from War Axe or penetration from Malefic Roar produces more effective damage per kick than a raw attack stat.\"]}],\"\\n\",\"$Lab\",\"\\n\",\"$Lac\",\"\\n\",\"$Lad\",\"\\n\",\"$Lae\",\"\\n\",\"$Laf\",\"\\n\",\"$Lb0\",\"\\n\",\"$Lb1\",\"\\n\",\"$Lb2\"]\n95:[\"$\",\"$Lb3\",null,{\"heroName\":\"Chou\"}]\n"])</script><script>self.__next_f.push([1,"96:[\"$\",\"div\",null,{\"className\":\"relative bg-surface-4 border border-mlbb-gold/20 overflow-hidden card-hover hover:border-mlbb-gold/50\",\"style\":{\"boxShadow\":\"0 2px 8px rgba(0,0,0,0.3)\"},\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 p-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative w-14 h-14 rounded-full overflow-hidden flex-shrink-0 bg-surface-3\",\"children\":[\"$\",\"$L6b\",null,{\"src\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_4661a64a2c6b724e7b67032fcbface27.png\",\"alt\":\"Esmeralda - Astrologer\",\"unoptimized\":false,\"priority\":\"$undefined\",\"fetchPriority\":\"$undefined\",\"fill\":true,\"className\":\"object-cover group-hover:scale-110 transition-transform duration-300\",\"sizes\":\"56px\",\"placeholder\":\"blur\",\"blurDataURL\":\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTAwIiBoZWlnaHQ9IjEwMCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48cmVjdCB3aWR0aD0iMTAwIiBoZWlnaHQ9IjEwMCIgZmlsbD0iIzBkMTIyNSIvPjwvc3ZnPg==\"}]}],[\"$\",\"div\",null,{\"className\":\"flex-1 min-w-0\",\"children\":[[\"$\",\"h4\",null,{\"className\":\"font-heading font-bold text-text-primary group-hover:text-