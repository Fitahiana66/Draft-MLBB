="/images/spells/flicker.png"/></div><div class="min-w-0 flex-1"><p class="flex items-center gap-1 font-heading text-[10px] font-bold uppercase tracking-[0.22em]" style="color:#00AAFF"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-zap h-2.5 w-2.5" aria-hidden="true"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"></path></svg>Battle Spell</p><p class="mt-0.5 truncate font-heading text-base font-bold uppercase tracking-wide text-mlbb-text sm:text-lg xl:text-base">Flicker</p></div></div></div></div><div class="relative grid grid-cols-2 gap-px overflow-hidden border border-mlbb-gold/18 bg-surface-1/45 sm:grid-cols-4 lg:col-start-1 lg:row-start-2 lg:self-start" style="box-shadow:inset 0 1px 0 rgba(240,208,96,0.08)"><div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-mlbb-gold-bright/50 to-transparent" aria-hidden="true"></div><div class="relative min-w-0 bg-surface-2/85 px-3 py-2 sm:px-4 sm:py-3" title="Blade of the Heptaseas, War Axe, Malefic Roar"><p class="truncate font-heading text-[9.5px] font-bold uppercase tracking-[0.2em] text-mlbb-text-secondary/85">Physical Attack</p><p class="mt-1 font-heading text-[18px] font-bold leading-tight tracking-tight text-mlbb-text sm:text-[22px]"><span class="text-mlbb-gold-bright">+165</span></p></div><div class="relative min-w-0 bg-surface-2/85 px-3 py-2 sm:px-4 sm:py-3" title="Blade of the Heptaseas"><p class="truncate font-heading text-[9.5px] font-bold uppercase tracking-[0.2em] text-mlbb-text-secondary/85">Physical Penetration</p><p class="mt-1 font-heading text-[18px] font-bold leading-tight tracking-tight text-mlbb-text sm:text-[22px]"><span class="text-mlbb-gold-bright">+15</span></p></div><div class="relative min-w-0 bg-surface-2/85 px-3 py-2 sm:px-4 sm:py-3" title="War Axe"><p class="truncate font-heading text-[9.5px] font-bold uppercase tracking-[0.2em] text-mlbb-text-secondary/85">Spell Vamp</p><p class="mt-1 font-heading text-[18px] font-bold leading-tight tracking-tight text-mlbb-text sm:text-[22px]"><span class="text-mlbb-gold-bright">+8%</span></p></div><div class="relative min-w-0 bg-surface-2/85 px-3 py-2 sm:px-4 sm:py-3" title="Blade of the Heptaseas, War Axe, Brute Force Breastplate, Immortality"><p class="truncate font-heading text-[9.5px] font-bold uppercase tracking-[0.2em] text-mlbb-text-secondary/85">HP</p><p class="mt-1 font-heading text-[18px] font-bold leading-tight tracking-tight text-mlbb-text sm:text-[22px]"><span class="text-mlbb-gold-bright">+2050</span></p></div></div></div><div class="relative mt-4 overflow-hidden border border-mlbb-gold/18 bg-gradient-to-br from-surface-3/75 to-surface-2/85 px-4 py-3.5"><div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-mlbb-gold/40 to-transparent" aria-hidden="true"></div><div class="mb-2.5 flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right-left h-3.5 w-3.5 text-text-accent" aria-hidden="true"><path d="m16 3 4 4-4 4"></path><path d="M20 7H4"></path><path d="m8 21-4-4 4-4"></path><path d="M4 17h16"></path></svg><p class="font-heading text-[10.5px] font-bold uppercase tracking-[0.22em] text-text-accent">Situational Swaps</p></div><ul class="space-y-2"><li class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-[12.5px] leading-relaxed text-mlbb-text-secondary"><a class="font-heading font-bold uppercase tracking-wide text-mlbb-text transition-colors hover:text-mlbb-gold-bright" href="/items/endless-battle">Endless Battle</a><span class="inline-flex items-baseline gap-1.5 text-[11px] uppercase tracking-wide text-mlbb-text-secondary/80"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right relative top-[1px] h-3 w-3 text-text-accent/65" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><span class="text-mlbb-text-secondary/65">over</span><a class="font-semibold text-text-accent transition-colors hover:text-mlbb-gold-bright" href="/items/brute-force-breastplate">Brute Force Breastplate</a></span><span class="basis-full text-[12.5px] text-mlbb-text-secondary/90 sm:basis-auto sm:before:mx-1 sm:before:text-mlbb-text-secondary/50 sm:before:content-[&#x27;•&#x27;]">Use when your team already has a tanky frontliner and you can commit to the full damage combo without needing the extra durability.</span></li><li class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-[12.5px] leading-relaxed text-mlbb-text-secondary"><a class="font-heading font-bold uppercase tracking-wide text-mlbb-text transition-colors hover:text-mlbb-gold-bright" href="/items/dominance-ice">Dominance Ice</a><span class="inline-flex items-baseline gap-1.5 text-[11px] uppercase tracking-wide text-mlbb-text-secondary/80"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right relative top-[1px] h-3 w-3 text-text-accent/65" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><span class="text-mlbb-text-secondary/65">over</span><a class="font-semibold text-text-accent transition-colors hover:text-mlbb-gold-bright" href="/items/malefic-roar">Malefic Roar</a></span><span class="basis-full text-[12.5px] text-mlbb-text-secondary/90 sm:basis-auto sm:before:mx-1 sm:before:text-mlbb-text-secondary/50 sm:before:content-[&#x27;•&#x27;]">Use when the enemy jungler or marksman relies on attack speed and lifesteal to win fights, and your kick plus the anti-heal aura shuts them down.</span></li><li class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-[12.5px] leading-relaxed text-mlbb-text-secondary"><a class="font-heading font-bold uppercase tracking-wide text-mlbb-text transition-colors hover:text-mlbb-gold-bright" href="/items/sea-halberd">Sea Halberd</a><span class="inline-flex items-baseline gap-1.5 text-[11px] uppercase tracking-wide text-mlbb-text-secondary/80"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right relative top-[1px] h-3 w-3 text-text-accent/65" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><span class="text-mlbb-text-secondary/65">over</span><a class="font-semibold text-text-accent transition-colors hover:text-mlbb-gold-bright" href="/items/malefic-roar">Malefic Roar</a></span><span class="basis-full text-[12.5px] text-mlbb-text-secondary/90 sm:basis-auto sm:before:mx-1 sm:before:text-mlbb-text-secondary/50 sm:before:content-[&#x27;•&#x27;]">Use when anti-heal is mandatory on your physical slot and the enemy front line has not yet stacked enough armor to justify penetration.</span></li><li class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-[12.5px] leading-relaxed text-mlbb-text-secondary"><a class="font-heading font-bold uppercase tracking-wide text-mlbb-text transition-colors hover:text-mlbb-gold-bright" href="/items/radiant-armor">Radiant Armor</a><span class="inline-flex items-baseline gap-1.5 text-[11px] uppercase tracking-wide text-mlbb-text-secondary/80"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right relative top-[1px] h-3 w-3 text-text-accent/65" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><span class="text-mlbb-text-secondary/65">over</span><a class="font-semibold text-text-accent transition-colors hover:text-mlbb-gold-bright" href="/items/malefic-roar">Malefic Roar</a></span><span class="basis-full text-[12.5px] text-mlbb-text-secondary/90 sm:basis-auto sm:before:mx-1 sm:before:text-mlbb-text-secondary/50 sm:before:content-[&#x27;•&#x27;]">Use against teams with multiple magic-damage threats where you need to survive the approach before the kick connects.</span></li></ul></div></div></article></section></div><div id="tabpanel-skins" role="tabpanel" aria-labelledby="tab-skins" hidden=""></div><div id="tabpanel-lore" role="tabpanel" aria-labelledby="tab-lore" hidden=""></div><div id="tabpanel-stats" role="tabpanel" aria-labelledby="tab-stats" tabindex="0" hidden=""><div class="mt-6 md:mt-8"><section id="rank-stats" aria-labelledby="rank-stats-heading" class="relative bg-surface-2/85 backdrop-blur-sm border border-mlbb-gold/20 overflow-hidden" style="box-shadow:0 1px 0 rgba(255,255,255,0.03) inset, 0 18px 38px -24px rgba(0,0,0,0.8)"><div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-mlbb-gold-bright/55 to-transparent" aria-hidden="true"></div><div class="absolute top-0 left-0 w-3 h-3 border-t border-l border-mlbb-gold-bright/40" aria-hidden="true"></div><div class="absolute top-0 right-0 w-3 h-3 border-t border-r border-mlbb-gold/30" aria-hidden="true"></div><div class="absolute bottom-0 left-0 w-3 h-3 border-b border-l border-mlbb-gold/30" aria-hidden="true"></div><div class="absolute bottom-0 right-0 w-3 h-3 border-b border-r border-mlbb-gold/30" aria-hidden="true"></div><div class="relative p-3 sm:p-4 md:p-6"><header class="mb-4 md:mb-5"><h2 id="rank-stats-heading" class="text-xl md:text-2xl font-heading font-bold text-text-accent-bright uppercase tracking-[0.04em] lea