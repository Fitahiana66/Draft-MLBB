ition":2,"name":"Heroes","item":"https://mlbbhub.com/heroes"},{"@type":"ListItem","position":3,"name":"Chou"}]}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"HowTo","name":"How to Build Chou in Mobile Legends: EXP Damage Dealer","description":"Default EXP setup for solo queue. Heptaseas rush into War Axe gives enough burst to kill a squishy from fog. Endless Battle's Divine Justice true damage fires off every skill cast during the combo chain.","totalTime":"PT15M","supply":[{"@type":"HowToSupply","name":"Tough Boots"},{"@type":"HowToSupply","name":"Blade of the Heptaseas"},{"@type":"HowToSupply","name":"War Axe"},{"@type":"HowToSupply","name":"Endless Battle"},{"@type":"HowToSupply","name":"Malefic Roar"},{"@type":"HowToSupply","name":"Immortality"}],"tool":[{"@type":"HowToTool","name":"Fighter Emblem"},{"@type":"HowToTool","name":"Flicker Battle Spell"}],"step":[{"@type":"HowToStep","position":1,"name":"Buy Tough Boots","text":"Purchase Tough Boots (700 gold) as item 1 in the EXP Damage Dealer build for Chou.","url":"https://mlbbhub.com/heroes/chou#build-exp-damage-dealer"},{"@type":"HowToStep","position":2,"name":"Buy Blade of the Heptaseas","text":"Purchase Blade of the Heptaseas (1,950 gold) as item 2 in the EXP Damage Dealer build for Chou.","url":"https://mlbbhub.com/heroes/chou#build-exp-damage-dealer"},{"@type":"HowToStep","position":3,"name":"Buy War Axe","text":"Purchase War Axe (2,100 gold) as item 3 in the EXP Damage Dealer build for Chou.","url":"https://mlbbhub.com/heroes/chou#build-exp-damage-dealer"},{"@type":"HowToStep","position":4,"name":"Buy Endless Battle","text":"Purchase Endless Battle (2,330 gold) as item 4 in the EXP Damage Dealer build for Chou.","url":"https://mlbbhub.com/heroes/chou#build-exp-damage-dealer"},{"@type":"HowToStep","position":5,"name":"Buy Malefic Roar","text":"Purchase Malefic Roar (2,060 gold) as item 5 in the EXP Damage Dealer build for Chou.","url":"https://mlbbhub.com/heroes/chou#build-exp-damage-dealer"},{"@type":"HowToStep","position":6,"name":"Buy Immortality","text":"Purchase Immortality (2,120 gold) as item 6 in the EXP Damage Dealer build for Chou.","url":"https://mlbbhub.com/heroes/chou#build-exp-damage-dealer"}],"mainEntityOfPage":{"@type":"WebPage","@id":"https://mlbbhub.com/heroes/chou"},"datePublished":"2026-04-12T00:00:00.000Z","dateModified":"2026-09-29T00:00:00.000Z","author":{"@type":"Organization","name":"MLBBHub","url":"https://mlbbhub.com"}}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"HowTo","name":"How to Build Chou in Mobile Legends: Tank Roam","description":"Competitive and high-rank setup where Chou plays as a pick-focused roamer. Conceal is the income engine (Thriving replaces the minion gold and EXP he gives up) and its invisibility plus movement speed walks the whole team into kick range before the target can react. He still kicks to deliver, but the tank items let him survive the approach and kick twice per extended fight. Concussive Blast adds HP-scaling AOE damage on the passive auto.","totalTime":"PT15M","supply":[{"@type":"HowToSupply","name":"Tough Boots"},{"@type":"HowToSupply","name":"Dominance Ice"},{"@type":"HowToSupply","name":"Athena's Shield"},{"@type":"HowToSupply","name":"Antique Cuirass"},{"@type":"HowToSupply","name":"Queen's Wings"},{"@type":"HowToSupply","name":"Immortality"}],"tool":[{"@type":"HowToTool","name":"Tank Emblem"},{"@type":"HowToTool","name":"Flicker Battle Spell"}],"step":[{"@type":"HowToStep","position":1,"name":"Buy Tough Boots","text":"Purchase Tough Boots (700 gold) as item 1 in the Tank Roam build for Chou.","url":"https://mlbbhub.com/heroes/chou#build-tank-roam"},{"@type":"HowToStep","position":2,"name":"Buy Dominance Ice","text":"Purchase Dominance Ice (2,010 gold) as item 2 in the Tank Roam build for Chou.","url":"https://mlbbhub.com/heroes/chou#build-tank-roam"},{"@type":"HowToStep","position":3,"name":"Buy Athena's Shield","text":"Purchase Athena's Shield (2,150 gold) as item 3 in the Tank Roam build for Chou.","url":"https://mlbbhub.com/heroes/chou#build-tank-roam"},{"@type":"HowToStep","position":4,"name":"Buy Antique Cuirass","text":"Purchase Antique Cuirass (2,170 gold) as item 4 in the Tank Roam build for Chou.","url":"https://mlbbhub.com/heroes/chou#build-tank-roam"},{"@type":"HowToStep","position":5,"name":"Buy Queen's Wings","text":"Purchase Queen's Wings (2,250 gold) as item 5 in the Tank Roam build for Chou.","url":"https://mlbbhub.com/heroes/chou#build-tank-roam"},{"@type":"HowToStep","position":6,"name":"Buy Immortality","text":"Purchase Immortality (2,120 gold) as item 6 in the Tank Roam build for Chou.","url":"https://mlbbhub.com/heroes/chou#build-tank-roam"}],"mainEntityOfPage":{"@type":"WebPage","@id":"https://mlbbhub.com/heroes/chou"},"datePublished":"2026-04-12T00:00:00.000Z","dateModified":"2026-09-29T00:00:00.000Z","author":{"@type":"Organization","name":"MLBBHub","url":"https://mlbbhub.com"}}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"HowTo","name":"How to Build Chou in Mobile Legends: Hybrid EXP Bruiser","description":"Balanced setup for drafts where the enemy has one priority kick target but enough dive threat to punish full-damage Chou. Brute Force Breastplate adds stacking CC reduction, adaptive attack, and movement speed per second of combat, which stacks with Tough Boots to make Chou nearly CC-immune during extended fights.","totalTime":"PT15M","supply":[{"@type":"HowToSupply","name":"Tough Boots"},{"@type":"HowToSupply","name":"Blade of the Heptaseas"},{"@type":"HowToSupply","name":"War Axe"},{"@type":"HowToSupply","name":"Brute Force Breastplate"},{"@type":"HowToSupply","name":"Malefic Roar"},{"@type":"HowToSupply","name":"Immortality"}],"tool":[{"@type":"HowToTool","name":"Fighter Emblem"},{"@type":"HowToTool","name":"Flicker Battle Spell"}],"step":[{"@type":"HowToStep","position":1,"name":"Buy Tough Boots","text":"Purchase Tough Boots (700 gold) as item 1 in the Hybrid EXP Bruiser build for Chou.","url":"https://mlbbhub.com/heroes/chou#build-hybrid-exp-bruiser"},{"@type":"HowToStep","position":2,"name":"Buy Blade of the Heptaseas","text":"Purchase Blade of the Heptaseas (1,950 gold) as item 2 in the Hybrid EXP Bruiser build for Chou.","url":"https://mlbbhub.com/heroes/chou#build-hybrid-exp-bruiser"},{"@type":"HowToStep","position":3,"name":"Buy War Axe","text":"Purchase War Axe (2,100 gold) as item 3 in the Hybrid EXP Bruiser build for Chou.","url":"https://mlbbhub.com/heroes/chou#build-hybrid-exp-bruiser"},{"@type":"HowToStep","position":4,"name":"Buy Brute Force Breastplate","text":"Purchase Brute Force Breastplate (1,870 gold) as item 4 in the Hybrid EXP Bruiser build for Chou.","url":"https://mlbbhub.com/heroes/chou#build-hybrid-exp-bruiser"},{"@type":"HowToStep","position":5,"name":"Buy Malefic Roar","text":"Purchase Malefic Roar (2,060 gold) as item 5 in the Hybrid EXP Bruiser build for Chou.","url":"https://mlbbhub.com/heroes/chou#build-hybrid-exp-bruiser"},{"@type":"HowToStep","position":6,"name":"Buy Immortality","text":"Purchase Immortality (2,120 gold) as item 6 in the Hybrid EXP Bruiser build for Chou.","url":"https://mlbbhub.com/heroes/chou#build-hybrid-exp-bruiser"}],"mainEntityOfPage":{"@type":"WebPage","@id":"https://mlbbhub.com/heroes/chou"},"datePublished":"2026-04-12T00:00:00.000Z","dateModified":"2026-09-29T00:00:00.000Z","author":{"@type":"Organization","name":"MLBBHub","url":"https://mlbbhub.com"}}</script><div class="relative min-h-screen"><div class="absolute inset-0 pointer-events-none hex-pattern " aria-hidden="true"></div><h1 class="sr-only">Chou Build, Counter &amp; Emblem Guide for Mobile Legends</h1><section class="relative overflow-hidden"><div class="absolute inset-0 z-0"><img alt="" aria-hidden="true" fetchPriority="high" decoding="async" data-nimg="fill" class="object-cover scale-105" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0