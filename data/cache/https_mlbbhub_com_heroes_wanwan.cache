ssName\":\"text-text-primary\",\"children\":[\"0.21\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Epic\"}}]]}]]}],[\"$\",\"article\",\"legend\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #4dc9f6, #4dc9f633)\",\"boxShadow\":\"0 0 12px -2px #4dc9f680\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#4dc9f6\",\"background\":\"#4dc9f61a\",\"border\":\"1px solid #4dc9f640\"},\"children\":\"Legend\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Wanwan\",\"rank\":\"Legend\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=legend\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Legend\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Legend\",\"name\":\"Wanwan\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"49.36\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Wanwan\",\"delta\":\"+1.00%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.11\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.16\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Legend\"}}]]}]]}],[\"$\",\"article\",\"mythic\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[\"$La9\",\"$Laa\",\"$Lab\"]}],\"$Lac\",\"$Lad\"]}]\n7e:[\"$\",\"$L40\",\"a-3\",{\"href\":\"/heroes/khufra\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Khufra\"}]\n7f:[\"$\",\"$L40\",\"a-4\",{\"href\":\"/heroes/akai\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Akai\"}]\n80:[\"$\",\"$L40\",\"a-5\",{\"href\":\"/heroes/saber\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Saber\"}]\n81:[\"$\",\"$L40\",\"a-6\",{\"href\":\"/heroes/natalia\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Natalia\"}]\n82:[\"$\",\"$L40\",\"a-7\",{\"href\":\"/heroes/selena\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Selena\"}]\n83:[\"$\",\"$L40\",\"a-8\",{\"href\":\"/heroes/granger\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Granger\"}]\n84:[\"$\",\"$L40\",\"a-9\",{\"href\":\"/heroes/estes\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Estes\"}]\n85:[\"$\",\"$L40\",\"a-10\",{\"href\":\"/heroes/diggie\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Diggie\"}]\n86:[\"$\",\"$L40\",\"a-11\",{\"href\":\"/heroes/atlas\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Atlas\"}]\n87:[\"$\",\"$L40\",\"a-12\",{\"href\":\"/heroes/grock\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Grock\"}]\n88:[\"$\",\"$L40\",\"a-13\",{\"href\":\"/heroes/mathilda\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Mathilda\"}]\n89:[\"$\",\"h2\",\"h2-1\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"What her kit is actually doing\"]}]\n8a:[\"$\",\"p\",\"p-3\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Wanwan's entire kit is one sentence: hit four different spots on a target, then delete them. The passive paints the four weaknesses on every enemy after the first basic attack, and the ultimate is physically ungated until all four are cleared. Every other ability exists to close the angle gap: S1 throws daggers through a line and catches any weakness pointed that direction, S2 fans needles in a circle and hits all four on a trapped target, and the dash after each auto is how you physically walk around the hero to line up the last side.\"}]\n8b:[\"$\",\"p\",\"p-4\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"That design is why she scales with attack speed and on-hit effects rather than raw physical attack. Every basic attack is a passive trigger, a weakness check, a dash, and a ticking clock on the first weakness expiring. The hero who gets off 6 autos in 3 seconds plays a completely different game from the one who gets off 3, and the gap is almost entirely about positioning discipline rather than raw gold.\"}]\n8c:[\"$\",\"h2\",\"h2-2\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Laning: the first 8 minutes\"]}]\n8d:[\"$\",\"ol\",\"ol-0\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Take S1 at level 1, not S2.\"}],\" The 2.1.67 rework made base dagger damage 120 at rank 1 instead of 60, which is enough to contest the second-wave trade against most gold laners. Open the wave with an auto, throw S1 across the wave, and the returning daggers clear the back line while also painting a weakness on the enemy carry for the follow-up.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Save S2 mana for actual CC, not poke.\"}],\" The same patch flattened S2 mana cost to 125 at every level. Using it to fan-poke in lane is now a pure mana burn. Only press it when an enemy skill is mid-cast or already on you. Missing that window is the single most common reason a Wanwan hits 7 minutes with no gold and no mana.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Bait the first gank into your S2, then reset.\"}],\" Junglers who pathed top-side check gold lane around the 2:30 and 5:00 marks. If your tank did not ping, pull wave to your tower, stand near the tri-bush, and play for the over-extension. The S2 cleanse plus dash-chain is enough to survive most level-4 ganks and punish the jungler for the pathing cost.\"]}],\"\\n\"]}]\n8e:[\"$\",\"p\",\"p-5\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"You should hit level 4 with Swift Boots and the start of Demon Hunter Sword around 4:30 to 5:30 on a clean lane. If you are two levels behind at 6:00, the lane is lost and you need to rotate under turret rather than keep trading.\"}]\n8f:[\"$\",\"h2\",\"h2-3\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The power spike you are farming toward\"]}]\n90:[\"$\",\"p\",\"p-6\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Demon Hunter Sword plus Corrosion Scythe is the unlock. Both items are on-hit multipliers rather than raw damage, and together they convert her auto-attack engine from poke into an execution window. DHS adds a percent-of-current-HP tick to every auto and heals you per hit, which is what lets her survive the second skirmish instead of needing to back after the first one. Corrosion Scythe stacks a flat damage-per-hit buff up to 5 times and layers an attack-speed ramp on top, which is what lets the ult chain into a second target instead of timing out on the first.\"}]\n91:[\"$\",\"p\",\"p-7\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The window is between the 9 and 11 minute mark, assuming a clean lane and one solo kill or assist. Before that window, a Wanwan playing aggressive is a Wanwan feeding. After that window, the ult is genuinely a three-kill reset, because the on-hit layer scales every shot the ult fires and the chain-condition triggers before the enemy team can rotate peel. The moment both items finalize, your team should call a fight, not farm a camp.\"}]\n92:[\"$\",\"h2\",\"h2-4\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Teamfight positioning and target priority\"]}]\n93:[\"$\",\"p\",\"p-8\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The reflex is to stand behind the tank and auto. That reflex is wrong on Wanwan, and it is why most solo-queue Wanwans look average even at high MMR. Her passive needs four different angles on a target, which the backline simply cannot give her. Standing on the tank's shoulder means every weakness is on the same side.\"}]\n94:[\"$\",\"ol\",\"ol-1\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Flank wide, not through.\"}],\" Take the side lane bush, wait for your tank to engage, and enter the fight from 90 degrees off the engage axis. That single angle gives you the first two weaknesses for free on whichever enemy steps up to fight your tank.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Pick the second-squishiest target, not the carry.\"}],\" Going directly for the enemy marksman means their support, roam, and fighter all have skills pointed the direction you have to enter. Go for the mid laner or the sidelane fighter first. Their positioning is looser and their peel is worse, and clearing them opens the ult chain to the real carry anyway.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Hold S2 until the lock lands, not before.\"}],\" The mistake is pressing S2 the moment a fight starts because it feels safe. The cleanse is only valuable against the CC that actually kills you: Franco hook, Kaja suppression, Khufra cannonball. Every other CC you dash out of. Saving S2 for the real lock turns one pick attempt into a failed pick.\"]}],\"\\n\"]}]\n95:[\"$\",\"p\",\"p-9\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[\"Support-conditional edge case: if your roam is \",[\"$\",\"$L40\",\"a-0\",{\"href\":\"/heroes/estes\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Estes\"}],\" or \",[\"$\",\"$L40\",\"a-1\",{\"href\":\"/heroes/mathilda\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Mathilda\"}],\", you can flank a half-second earlier and trust the pull or heal to cover the repositioning. If your roam is \",[\"$\",\"$L40\",\"a-2\",{\"href\":\"/heroes/johnson\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Johnson\"}],\" or \",[\"$\",\"$L40\",\"a-3\",{\"href\":\"/heroes/franco\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Franco\"}],\", wait for the lock before you enter, because they do not have the follow-up to rescue a flank that goes sideways.\"]}]\n96:[\"$\",\"$Lae\",null,{\"slot\":\"7246933188\",\"variant\":\"in-article\",\"className\":\"my-8\"}]\n97:[[\"$\",\"h2\",\"h2-0\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Itemization: 3 locked slots plus 3 real conversations\"]}],\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Swift Boots, Demon Hunter Sword, and Corrosion Scythe are locked. Do not deviate. The attack-speed floor from boots plus DHS plus CS is what makes every later item actually contribute. Skipping boots for Magic Boots because the enemy has two mages is a trap: Wanwan needs the attack-speed stat more than she needs the CDR, and her S2 cleanse already covers most magic burst.\"}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[\"Slot 4 is the first real choice. Windtalker is the default because Typhoon adds a third on-hit layer and the movement speed helps the flank setup. Golden Staff is the pick when you need to burn a thick frontline fast, because Endless Strike raises the attack-speed cap and makes every third basic attack trigger her on-hit effects two extra times, which is exactly what the ult scales on. It stacks cleanly with Corrosion Scythe: the two share no passive, so nothing overwrites. Sea Halberd slides in here if the enemy has \",[\"$\",\"$L40\",\"a-0\",{\"href\":\"/heroes/estes\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Estes\"}],\", \",[\"$\",\"$L40\",\"a-1\",{\"href\":\"/heroes/uranus\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Uranus\"}],\", or \",[\"$\",\"$L40\",\"a-2\",{\"href\":\"/heroes/alice\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Alice\"}],\" whose heal or shield output needs cutting, since the Lifebane passive cuts both by 40% for 3 seconds per hit.\"]}],\"\\n\",[\"$\",\"p\",\"p-2\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Slot 5 is the defense or burst flex. Wind of Nature is the answer to burst assassins and hyper-fighters: the 2-second physical immunity on an active is exactly one Lancelot combo or one Paquito full rotation. Immortality comes in when the enemy has multi-source pick potential rather than single-target burst, because the second chance is worth more than the immunity window. Blade of Despair is the fallback, not the default: 160 physical attack is technically the highest raw stat on the shelf, but it does not scale with her on-hit layer, so it only out-damages the alternatives in a full late-game slug fest that a Wanwan usually does not survive anyway.\"}],\"\\n\",[\"$\",\"p\",\"p-3\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[\"Slot 6 is Malefic Roar if the enemy stacked armor (two of \",[\"$\",\"$L40\",\"a-0\",{\"href\":\"/heroes/khufra\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Khufra\"}],\", \",[\"$\",\"$L40\",\"a-1\",{\"href\":\"/heroes/gatotkaca\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Gatotkaca\"}],\", \",\"$Laf\",\", \",\"$Lb0\",\"). Otherwise, a second defensive slot over a second offensive slot. Dying in the first 3 seconds of a fight as Wanwan is worth zero damage on paper.\"]}],\"\\n\",\"$Lb1\",\"\\n\",\"$Lb2\",\"\\n\",\"$Lb3\",\"\\n\",\"$Lb4\",\"\\n\",\"$Lb5\",\"\\n\",\"$Lb6\",\"\\n\",\"$Lb7\",\"\\n\",\"$Lb8\",\"\\n\",\"$Lb9\",\"\\n\",\"$Lba\",\"\\n\",\"$Lbb\",\"\\n\",\"$Lbc\"]\n98:[\"$\",\"$Lbd\",null,{\"heroName\":\"Wanwan\"}]\n"])</script><script>self.__next_f.push([1,"99:[\"$\",\"div\",null,{\"className\":\"relative bg-surface-4 border border-mlbb-gold/20 overflow-hidden card-hover hover:border-mlbb-gold/50\",\"style\":{\"boxShadow\":\"0 2px 8px rgba(0,0,0,0.3)\"},\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 p-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative w-14 h-14 rounded-full overflow-hidden flex-shrink-0 bg-surface-3\",\"children\":[\"$\",\"$L6b\",null,{\"src\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_2a733ac5b7d1f97093e82940af6f5008.png\",\"alt\":\"Bruno - The Protector\",\"unoptimized\":false,\"priority\":\"$undefined\",\"fetchPriority\":\"$undefined\",\"fill\":true,\"className\":\"object-cover group-hover:scale-110 transition-transform duration-300\",\"sizes\":\"56px\",\"placeholder\":\"blur\",\"blurDataURL\":\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTAwIiBoZWlnaHQ9IjEwMCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48cmVjdCB3aWR0aD0iMTAwIiBoZWlnaHQ9IjEwMCIgZm