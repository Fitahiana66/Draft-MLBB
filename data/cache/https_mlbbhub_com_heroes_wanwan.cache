ic Roar\"},\"trigger\":\"Use if a physical diver can bypass your front line before you finish opening the first target.\"},{\"item\":{\"slug\":\"windtalker\",\"name\":\"Windtalker\"},\"replace\":{\"slug\":\"sea-halberd\",\"name\":\"Sea Halberd\"},\"trigger\":\"Use when the enemy front line is durable but not protected by healing, shields, or high-extra-HP sustain.\"}],\"notes\":\"Tank-breaking setup for grouped fights where Wanwan can work through the nearest durable target before chasing resets.\",\"totalCost\":11050,\"statLines\":[{\"key\":\"physatk\",\"labelKey\":\"common.stats.physicalAttack\",\"unit\":\"flat\",\"group\":\"offensive\",\"value\":260,\"sources\":[\"Corrosion Scythe\",\"Demon Hunter Sword\",\"Golden Staff\",\"Sea Halberd\",\"Malefic Roar\"]},{\"key\":\"attackspeed\",\"labelKey\":\"common.stats.attackSpeed\",\"unit\":\"percent\",\"group\":\"offensive\",\"value\":100,\"sources\":[\"Swift Boots\",\"Corrosion Scythe\",\"Demon Hunter Sword\",\"Golden Staff\",\"Sea Halberd\"]},{\"key\":\"movespeed\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"flat\",\"group\":\"utility\",\"value\":40,\"sources\":[\"Swift Boots\"]},{\"key\":\"movespeedPct\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"percent\",\"group\":\"utility\",\"value\":5,\"sources\":[\"Corrosion Scythe\"]}],\"conflicts\":[],\"simulatorUrl\":\"/build-simulator?hero=wanwan\u0026items=swift-boots%2Ccorrosion-scythe%2Cdemon-hunter-sword%2Cgolden-staff%2Csea-halberd%2Cmalefic-roar\u0026spell=inspire\u0026emblem=marksman\u0026talents=swift%2Cweapon-master%2Cweakness-finder\u0026flex=malefic-gun.malefic-roar%2Cwind-of-nature.malefic-roar%2Cwindtalker.sea-halberd\"},{\"slot\":3,\"id\":\"burst-insurance\",\"name\":\"Burst Insurance\",\"roleContext\":\"Gold\",\"items\":[{\"slug\":\"tough-boots\",\"name\":\"Tough Boots\",\"cost\":700,\"fixed\":false},{\"slug\":\"corrosion-scythe\",\"name\":\"Corrosion Scythe\",\"cost\":2050,\"fixed\":false},{\"slug\":\"demon-hunter-sword\",\"name\":\"Demo