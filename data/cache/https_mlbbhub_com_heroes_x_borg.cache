:11230,\"statLines\":[{\"key\":\"physatk\",\"labelKey\":\"common.stats.physicalAttack\",\"unit\":\"flat\",\"group\":\"offensive\",\"value\":35,\"sources\":[\"War Axe\"]},{\"key\":\"adaptiveatk\",\"labelKey\":\"common.stats.adaptiveAttack\",\"unit\":\"flat\",\"group\":\"offensive\",\"value\":40,\"sources\":[\"Queen's Wings\"]},{\"key\":\"spellvamp\",\"labelKey\":\"common.stats.spellVamp\",\"unit\":\"percent\",\"group\":\"offensive\",\"value\":18,\"sources\":[\"War Axe\",\"Queen's Wings\"]},{\"key\":\"hp\",\"labelKey\":\"common.stats.hp\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":3320,\"sources\":[\"War Axe\",\"Brute Force Breastplate\",\"Queen's Wings\",\"Antique Cuirass\",\"Immortality\"]},{\"key\":\"hpregen\",\"labelKey\":\"common.stats.hpRegen\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":4,\"sources\":[\"Antique Cuirass\"]},{\"key\":\"physdefense\",\"labelKey\":\"common.stats.physicalDefense\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":93,\"sources\":[\"Warrior Boots\",\"Brute Force Breastplate\",\"Antique Cuirass\",\"Immortality\"]},{\"key\":\"movespeed\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"flat\",\"group\":\"utility\",\"value\":40,\"sources\":[\"Warrior Boots\"]},{\"key\":\"cdreduction\",\"labelKey\":\"common.stats.cooldownReduction\",\"unit\":\"percent\",\"group\":\"utility\",\"value\":30,\"sources\":[\"War Axe\",\"Brute Force Breastplate\",\"Queen's Wings\"]}],\"conflicts\":[],\"simulatorUrl\":\"/build-simulator?hero=x-borg\u0026items=warrior-boots%2Cwar-axe%2Cbrute-force-breastplate%2Cqueens-wings%2Cantique-cuirass%2Cimmortality\u0026spell=vengeance\u0026emblem=fighter\u0026talents=firmness%2Cfestival-of-blood%2Cbrave-smite\u0026flex=tough-boots.warrior-boots%2Cdominance-ice.antique-cuirass%2Cradiant-armor.antique-cuirass%2Coracle.antique-cuirass\"},{\"slot\":3,\"id\":\"jungle-tempo-burn\",\"name\":\"Jungle Tempo Burn\",\"roleContext\":\"Jungle\",\"items\":[{\"slug\":\"tough-boots\",\"name\":\"Tough Boots\",\"cos