":\"Grand\",\"tag\":\"Transformers\",\"tagSlug\":\"transformers\",\"price\":\"Limited-time Event\",\"portraitFile\":\"Hero836-portrait.png\",\"portraitUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/x-borg/Hero836-portrait-20220525170001.webp\",\"splashUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/x-borg/X-Borg-Bumblebee-20211215015544.webp\",\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/X.Borg/Cosmetics\"},{\"name\":\"Pecados Rioter\",\"tier\":\"Common\",\"rawTier\":\"Common\",\"tag\":\"MCGG\",\"tagSlug\":\"mcgg\",\"price\":\"599\",\"portraitFile\":\"Hero837-portrait.png\",\"portraitUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/x-borg/Hero837-portrait-20220526053624.webp\",\"splashUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/x-borg/X-Borg-Pecados-Rioter-20250406075957.webp\",\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/X.Borg/Cosmetics\"},{\"name\":\"Invoker's Flame\",\"tier\":\"Grand\",\"rawTier\":\"Grand\",\"tag\":null,\"tagSlug\":null,\"price\":\"Limited-time Event\",\"portraitFile\":null,\"portraitUrl\":null,\"splashUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/x-borg/X-Borg-Invoker-s-Flame-20250823105140.webp\",\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/X.Borg/Cosmetics\"}],\"lore\":{\"backstory\":\"X.Borg is a deranged inventor from Eruditio who was caught in a catastrophic laboratory explosion that destroyed most of his body. Rather than accept defeat, he rebuilt himself as a walking flamethrower, fusing his charred flesh with a fire-spewing mechanical suit powered by an experimental fuel source. The explosion fractured his mind, leaving him with a pyromantic obsession and an unpredictable temperament. X.Borg now roams the Land of Dawn leaving scorched earth in his wake, searching for the colleague who sabotaged his experiment.\",\"allies\":[{\"heroSlug\":\"jawhead\",\"heroName\":\"Jawhead\",\"relationship\":\"Fellow rogue Eruditio creation\"},{\"heroSlug\":\"barats\",\"heroName\":\"Barats\",\"relationship\":\"Chaotic creature that thrives in the fires he sets\"}],\"rivals\":[{\"heroSlug\":\"johnson\",\"heroName\":\"Johnson\",\"relationship\":\"Eruditio enforcer trying to bring him to justice\"},{\"heroSlug\":\"paquito\",\"heroName\":\"Paquito\",\"relationship\":\"Boxer he scarred in a fiery ambush\"}]},\"loreUrlName\":\"XBorg\",\"statsHistory\":[{\"date\":\"2026-09-07\",\"winRate\":49.83,\"pickRate\":0.64,\"banRate\":3.07},{\"date\":\"2026-09-10\",\"winRate\":49.9,\"pickRate\":0.63,\"banRate\":2.99},{\"date\":\"2026-09-16\",\"winRate\":49.85,\"pickRate\":0.62,\"banRate\":2.77},{\"date\":\"2026-09-28\",\"winRate\":49.59,\"pickRate\":0.58,\"banRate\":1.58},{\"date\":\"2026-10-02\",\"winRate\":49.73,\"pickRate\":0.58,\"banRate\":1.61},{\"date\":\"2026-10-09\",\"winRate\":49.85,\"pickRate\":0.57,\"banRate\":1.69},{\"date\":\"2026-10-17\",\"winRate\":49.9,\"pickRate\":0.59,\"banRate\":1.78}]},\"relatedHeroesSlot\":\"$L66\",\"statsSeoSlot\":\"$L67\",\"fieldManualSlot\":\"$L68\"}]\n61:[\"$\",\"$L69\",null,{\"heroName\":\"X.Borg\",\"heroSlug\":\"x-borg\",\"roles\":\"$60:props:hero:role\",\"lanes\":\"$60:props:hero:lane\",\"difficulty\":2,\"winRate\":49.9,\"pickRate\":0.59,\"banRate\":1.78,\"curatedBuilds\":\"$60:props:curatedBuilds\",\"topCounters\":\"$60:props:tabData:counterData:countersThisHero\",\"hasCounterPage\":true,\"hasRankStats\":true,\"locale\":\"en\",\"pageUrl\":\"https://mlbbhub.com/heroes/x-borg\",\"year\":2026}]\n"])</script><script>self.__next_f.push([1,"6a:I[313915,[\"$7\",\"$8\",\"$9\",\"$a\",\"$b\",\"$2e\",\"$3e\",\"$3f\"],\"default\"]\n6b:I[279344,[\"$7\",\"$8\",\"$9\",\"$a\",\"$b\",\"$2e\",\"$3e\",\"$3f\"],\"Image\"]\n6c:I[842376,[\"$7\",\"$8\",\"$9\",\"$a\",\"$b\",\"$2e\",\"$3e\",\"$3f\"],\"default\"]\n7d:I[365750,[\"$7\",\"$8\",\"$9\",\"$a\",\"$b\",\"$2e\",\"$3e\",\"$3f\"],\"default\"]\n66:[\"$\",\"section\",null,{\"className\":\"content-lazy mt-8 pt-6 md:mt-12 md:pt-8 border-t border-border-subtle\",\"children\":[[\"$\",\"h2\",null,{\"classNam