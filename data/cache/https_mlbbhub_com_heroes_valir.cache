0" style="background-image:linear-gradient(105deg, transparent 40%, rgba(255,255,255,0.22) 50%, transparent 60%);mix-blend-mode:overlay" aria-hidden="true"></div></div><div class="absolute inset-0 pointer-events-none" style="background:repeating-linear-gradient(to right, transparent 0, transparent calc(10% - 1px), rgba(0,0,0,0.85) calc(10% - 1px), rgba(0,0,0,0.85) 10%)" aria-hidden="true"></div></div><span class="text-[12px] md:text-[13px] font-heading font-bold tabular-nums w-6 text-right leading-none" style="color:#E74C3C;text-shadow:0 0 8px #E74C3C50">70</span></div><div class="flex items-center gap-3"><span class="text-[10px] md:text-[11px] text-text-muted font-heading uppercase tracking-[0.14em] w-[72px] md:w-20 flex-shrink-0 font-semibold">Control</span><div class="relative flex-1 h-2.5 overflow-hidden" style="background:#060913;box-shadow:inset 0 0 0 1px rgba(200,170,110,0.12), inset 0 2px 4px rgba(0,0,0,0.45)"><div class="h-full relative" style="width:70%;background:linear-gradient(90deg, #F0D06080 0%, #F0D060 55%, #F0D060 100%);box-shadow:0 0 8px #F0D060aa, inset 0 0 8px #F0D06040"><div class="absolute inset-0" style="background-image:linear-gradient(105deg, transparent 40%, rgba(255,255,255,0.22) 50%, transparent 60%);mix-blend-mode:overlay" aria-hidden="true"></div></div><div class="absolute inset-0 pointer-events-none" style="background:repeating-linear-gradient(to right, transparent 0, transparent calc(10% - 1px), rgba(0,0,0,0.85) calc(10% - 1px), rgba(0,0,0,0.85) 10%)" aria-hidden="true"></div></div><span class="text-[12px] md:text-[13px] font-heading font-bold tabular-nums w-6 text-right leading-none" style="color:#F0D060;text-shadow:0 0 8px #F0D06050">70</span></div><div class="flex items-center gap-3"><span class="text-[10px] md:text-[11px] text-text-muted font-heading uppercase tracking-[0.14em] w-[72px] md:w-20 flex-shrink-0 font-semibold">Difficulty</span><div class="relative flex-1 h-2.5 overflow-hidden" style="background:#060913;box-shadow:inset 0 0 0 1px rgba(200,170,110,0.12), inset 0 2px 4px rgba(0,0,0,0.45)"><div class="h-full relative" style="width:20%;background:linear-gradient(90deg, #9B59B680 0%, #9B59B6 55%, #9B59B6 100%);box-shadow:0 0 8px #9B59B6aa, inset 0 0 8px #9B59B640"><div class="absolute inset-0" style="background-image:linear-gradient(105deg, transparent 40%, rgba(255,255,255,0.22) 50%, transparent 60%);mix-blend-mode:overlay" aria-hidden="true"></div></div><div class="absolute inset-0 pointer-events-none" style="background:repeating-linear-gradient(to right, transparent 0, transparent calc(10% - 1px), rgba(0,0,0,0.85) calc(10% - 1px), rgba(0,0,0,0.85) 10%)" aria-hidden="true"></div></div><span class="text-[12px] md:text-[13px] font-heading font-bold tabular-nums w-6 text-right leading-none" style="color:#9B59B6;text-shadow:0 0 8px #9B59B650">20</span></div></div><a class="mt-4 inline-flex items-center gap-1.5 text-[11px] font-heading font-bold uppercase tracking-[0.14em] text-text-accent hover:text-text-accent-bright transition-colors" href="/tier-list">See Valir in full tier list<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right w-3 h-3" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></div></section></div><div id="ad-4865714798" class="my-6" style="width:100%"><style>#ad-4865714798{min-height:280px}@media(min-width:768px){#ad-4865714798{min-height:280px}}</style><p class="text-[10px] font-heading uppercase tracking-[0.2em] text-[#9BA0B4]/40 text-center mb-2">Advertisement</p><ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-3465999061396690" data-ad-slot="4865714798" data-ad-format="auto" data-full-width-responsive="true"></ins></div><div class="relative content-lazy lg:grid lg:grid-cols-[minmax(0,1fr)_clamp(230px,24%,300px)] lg:gap-x-6 xl:gap-x-8 lg:items-start"><div class="lg:order-2 lg:sticky lg:self-start" style="top:128px"></div><section id="hero-article" class="relative lg:order-1 bg-[#0a0a0a]/85 backdrop-blur-sm border border-[#C8AA6E]/15 p-5 md:p-9 overflow-hidden" style="box-shadow:0 1px 0 rgba(255,255,255,0.03) inset, 0 18px 38px -24px rgba(0,0,0,0.8)"><div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[#F0D060]/55 to-transparent" aria-hidden="true"></div><div class="absolute top-0 left-0 w-3 h-3 border-t border-l border-[#F0D060]/40" aria-hidden="true"></div><div class="absolute top-0 right-0 w-3 h-3 border-t border-r border-[#C8AA6E]/30" aria-hidden="true"></div><div class="absolute bottom-0 left-0 w-3 h-3 border-b border-l border-[#C8AA6E]/30" aria-hidden="true"></div><div class="absolute bottom-0 right-0 w-3 h-3 border-b border-r border-[#C8AA6E]/30" aria-hidden="true"></div><div class="absolute -top-32 -right-24 w-72 h-72 rounded-full bg-[#C8AA6E]/[0.05] blur-3xl pointer-events-none" aria-hidden="true"></div><div class="relative hero-article-body max-w-[860px] mx-auto"><h2 class="text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative"><span aria-hidden="true" class="block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3"></span>Pick Valir when the enemy has to walk through fire</h2>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">Valir gets overpicked by players who see a strong lane and assume that means a safe blind pick. It does not. Patch 2.1.61 (<a class="text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors" href="/patch-notes">patch notes</a>) made his lane smoother by lowering mana costs and improving the later recharge on Burst Fireball, but the buff did not change the real draft rule: Valir is good when the enemy engage is honest and front-to-back.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">Pick him into teams that need to enter fights on foot. <a class="text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors" href="/heroes/fredrinn">Fredrinn</a>, <a class="text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors" href="/heroes/barats">Barats</a>, <a class="text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors" href="/heroes/thamuz">Thamuz</a>, <a class="text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors" href="/heroes/balmond">Balmond</a>, <a class="text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors" href="/heroes/alice">Alice</a>, and <a class="text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors" href="/heroes/hylos">Hylos</a> all hate walking through repeated slows, burn ticks, and a knockback that resets their first step. Pick him when Turtle and Lord fights will happen in ramps, bushes, and pit mouths where one enhanced Searing Torrent can cut the entrance in half. Pick him when your own roam or EXP gives you a real front line so you can play the second line instead of facechecking first.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">Do not blind-pick him into suppression or layered flank pressure. <a class="text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors" href="/heroes/franco">Franco</a> suppresses and that is the one CC Valir&#x27;s cleanse cannot remove. The revamped <a class="text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors" href="/heroes/kaja">Kaja</a> is still a counter, just not through suppression: his Divine Binding locks a whole area and drags everyone inside, and Valir has no dash to escape the circle once it lands. <a class="text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors" href="/heroes/hayabusa">Hayabusa</a>, <a class="text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors" href="/heroes/natalia">Natalia</a>, and <a class="text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors" href="/heroes/helcurt">Helcurt</a> do not care that the front door is on fire because they do not use the front door. <a class="text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors" href="/heroes/lolita">Lolita</a> is also miserable because she changes your fireball lane into dead time and forces you to hold skills instead of shaping space.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">The clean way to think about the pick is simple: if the enemy must run at your team, Valir is one of the best punish mages in the role. If the enemy can jump past your zone or lock you with suppression, you are drafting a lane bully into the wrong game.</p>
<h2 class="text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative"><span aria-hidden="true" class="block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3"></span>The one thing that actually makes Valir work</h2>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">Valir is not scary because of one combo. He is scary because he decides where the fight starts.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">Every part of the kit points at that job. Burst Fireball is not there to fish for highlight kills. It is there to keep one charge cycling while the other threatens the third passive stack. Searing Torrent is not a damage spell first. It is the line that tells divers, tanks, and bruisers to start over from farther away than they wanted. Vengeance Flame is not an &quot;I got caught&quot; panic button. It is the permission slip that lets Valir keep controlling space even after the enemy finally reaches him.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">Once that clicks, the hero stops looking like a poke mage and starts looking like a traffic controller. You are not trying to delete the first target you see. You are trying to force the enemy team to enter the fight in the order you want. Tanks go first, then fighters hesitate, then the backline has no clean angle because the first two bodies already lost tempo. That is how Valir wins fights that look slow on the scoreboard and impossible in real time.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">The practical corollary is brutal: if you throw both fireball charges into empty space, or spend Torrent for chip damage, you have deleted the threat that makes the enemy respect you. Valir without zone pressure is just a mage with no blink.</p>
<h2 class="text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative"><span aria-hidden="true" class="block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3"></span>Mid lane: the first four minutes</h2>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">Valir&#x27;s lane is about owning the first move, not about solo-killing the opposing mid. Hit level 4 with wave control, one side bush warded by your body position, and your defensive tool still available.</p>
<ol class="list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2">
<li class="text-[#9BA0B4]"><strong class="text-[#E8E6E3] font-semibold">Start S1 and win the first shove from range.</strong> Use the first fireball on the caster line or the enemy mid if they step too high, then hold the second charge as a threat instead of instantly dumping it. The goal is to make the opponent respect the stun setup while you clear first and move first.</li>
<li class="text-[#9BA0B4]"><strong class="text-[#E8E6E3] font-semibold">Treat S2 as anti-gank insurance, not lane poke.</strong> If the enemy roam is off-map and river vision is dark, do not cast Searing Torrent just to chunk the lane opponent. The spell matters more as the button that denies the first jungle step than as one extra trade spell.</li>
<li class="text-[#9BA0B4]"><strong class="text-[#E8E6E3] font-semibold">Save battle-spell tempo for the first real rotation.</strong> If you took Flicker, keep it for the first Turtle fight or the first dive that actually reaches you. If you took Flameshot into a slow lobby, spend it only on a guaranteed kill or to finish a fight around river. Burning spell tempo for a cute lane clip is how Valir arrives to minute three with priority but no safety.</li>
</ol>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">Your early roam pattern should be short and disciplined. Shove, show to the river entrance, threaten a fireball angle, then return if the side lane is not already committed. Valir is strong when he arrives second with wave done, not when he abandons mid first and gets collapsed in the jungle.</p>
<h2 class="text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative"><span aria-hidden="true" class="block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3"></span>The power spike you are farming toward</h2>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">Valir&#x27;s real two-item spike is <strong class="text-[#E8E6E3] font-semibold">Glowing Wand plus Ice Queen Wand</strong>, usually around the 7 to 9 minute window in a normal mid lane. That is the point where his damage-over-time control stops being annoying and starts being structurally unfair.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">Glowing Wand gives every repeated touch real health pressure and anti-heal. Ice Queen Wand makes every skill hit slow harder the longer the enemy stays in contact. Put those together with Valir&#x27;s natural multi-hit pattern and something specific changes: one fireball is no longer just poke, and one enhanced Torrent is no longer just peel. They become a trap state. Anyone who keeps walking through the burn is getting slower, taking more chip, and healing less while your team repositions around them.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">This is why Valir feels oppressive around second Turtle and the first Lord setup when he is on curve. Before those two items, he is mostly buying time. After those two items, he is deciding whether tanks can cross a choke without arriving half-spent. That is the moment you start forcing objective fights instead of merely answering them.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">Do not mistake raw AP items for the first spike. Holy Crystal hits harder later, but it does not change the geometry of the fight. Glowing plus Ice Queen changes geometry. That is the point of the hero.</p><div id="ad-7246933188" class="my-8" style="width:100%"><style>#ad-7246933188{min-height:280px}@media(min-width:768px){#ad-7246933188{min-height:320px}}</style><p class="text-[10px] font-heading uppercase tracking-[0.2em] text-[#9BA0B4]/40 text-center mb-2">Advertisement</p><ins class="adsbygoogle" style="display:block;text-align:center" data-ad-client="ca-pub-3465999061396690" data-ad-slot="7246933188" data-ad-format="fluid" data-ad-layout="in-article"></ins></div><h2 class="text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative"><span aria-hidden="true" class="block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3"></span>Teamfight positioning and target priority</h2>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">The common Valir mistake is trying to play him like a long-range finisher who always looks for the enemy backline first. That reflex loses fights. Your first job is to break the enemy entry, not to prove that you can reach their marksman.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">Three positioning rules matter every game:</p>
<ol class="list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2">
<li class="text-[#9BA0B4]"><strong class="text-[#E8E6E3] font-semibold">Stand one layer behind your real frontliner, never at the mouth of the choke.</strong> If you stand on the doorway yourself, you become the target that eats the engage. Stand behind the doorway so Searing Torrent throws the diver back through the space they just spent resources to cross.</li>
<li class="text-[#9BA0B4]"><strong class="text-[#E8E6E3] font-semibold">Hold one fireball charge for contact.</strong> Spending both S1 charges for poke removes the stun threat that keeps assassins and fighters honest. Valir with one charge loaded is a deterrent. Valir with zero is permission.</li>
<li class="text-[#9BA0B4]"><strong class="text-[#E8E6E3] font-semibold">Peel the first body that commits, then turn forward.</strong> If <a class="text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors" href="/heroes/lapu-lapu">Lapu-Lapu</a>, <a class="text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors" href="/heroes/khaleed">Khaleed</a>, or <a class="text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors" href="/heroes/fredrinn">Fredrinn</a> steps in, hit that body first, stack passive, and make the engage fail. If you skip the diver to throw spells at the enemy marksman, you usually die with damage still available.</li>
</ol>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">Target priority changes only after the line is secure. Once the diver or tank has been pushed off, then you can walk up and keep fireballs on whoever got stranded behind them.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">If your support is <a class="text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors" href="/heroes/diggie">Diggie</a> or <a class="text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors" href="/heroes/mathilda">Mathilda</a>, you can take a higher angle because they either deny the first commit or give you a reset path after it. If your support is <a class="text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors" href="/heroes/estes">Estes</a> or <a class="text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors" href="/heroes/floryn">Floryn</a>, play tighter. Healing does not fix bad spacing against a hard flank.</p>
<h2 class="text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative"><span aria-hidden="true" class="block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3"></span>Itemization: defaults vs flex slots</h2>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">Valir does not want six damage items. He wants two locked control items, the correct boots, and then enough flex to survive the way the enemy is actually trying to kill him.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]"><strong class="text-[#E8E6E3] font-semibold">The locked pair is Glowing Wand and Ice Queen Wand.</strong> Glowing is mandatory because it turns every touch into real attrition and already gives you anti-heal through Lifebane. Ice Queen is mandatory because Valir&#x27;s whole job improves when each repeat hit makes escape and re-entry slower. Do not reach for a second anti-heal item on top of Glowing Wand: Lifebane does not stack, so the extra slot buys nothing.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]"><strong class="text-[#E8E6E3] font-semibold">Boots are a game-state decision, not autopilot.</strong> Demon Boots is the default because Valir still wins games by spamming waves into rotations, and running dry before an objective is a throw. Tough Boots is the answer when the enemy draft layers slows and CC hard enough that surviving the first touch matters more than mana comfort. Magic Boots is the greedy snowball pick only when you already know the fights will be short and your team controls the map.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">Then the real flex conversation starts:</p>
<ul class="list-disc list-inside text-[#9BA0B4] my-3 space-y-2 ml-2">
<li class="text-[#9BA0B4]"><strong class="text-[#E8E6E3] font-semibold">Genius Wand</strong> when the enemy front line is still light on magic defense and you want the midgame spike to hurt immediately.</li>
<li class="text-[#9BA0B4]"><strong class="text-[#E8E6E3] font-semibold">Divine Glaive</strong> when two or more enemy cores have already moved into magic resistance and your poke is starting to feel decorative.</li>
<li class="text-[#9BA0B4]"><strong class="text-[#E8E6E3] font-semibold">Holy Crystal</strong> when your team already controls space and you need the follow-up damage to turn zoning into kills.</li>
<li class="text-[#9BA0B4]"><strong class="text-[#E8E6E3] font-semibold">Winter Crown</strong> when the actual problem is one committed dive from <a class="text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors" href="/heroes/hayabusa">Hayabusa</a>, <a class="text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors" href="/heroes/ling">Ling</a>, <a class="text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors" href="/heroes/natalia">Natalia</a>, or <a class="text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors" href="/heroes/saber">Saber</a>. If the assassin is saving everything for you, this is often stronger than one more damage item.</li>
<li class="text-[#9BA0B4]"><strong class="text-[#E8E6E3] font-semibold">Immortality</strong> or <strong class="text-[#E8E6E3] font-semibold">Blood Wings</strong> for the last slot, depending on what the game is asking. Immortality is for one-fight insurance when you are the obvious pick target. Blood Wings is for games where you are already spacing well and want the shield plus movement to keep control without giving up offense.</li>
</ul>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">Valir itemization should read like a conversation with the enemy draft, not a fixed shopping list.</p>
<h2 class="text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative"><span aria-hidden="true" class="block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3"></span>Mistakes that lose Valir games</h2>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]"><strong class="text-[#E8E6E3] font-semibold">Dumping both fireball charges before the fight starts.</strong> This is the classic impatience throw. The third passive stack and stun matter more than the first two poke hits. Hold one charge so the enemy has to respect the contact window instead of sprinting through it.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]"><strong class="text-[#E8E6E3] font-semibold">Using Searing Torrent as damage instead of as a gate.</strong> If you cast S2 just because someone is visible, you often spend your best anti-dive tool on a target who was not actually threatening you. Save it for the body that matters, or for the angle that must be closed.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]"><strong class="text-[#E8E6E3] font-semibold">Pressing Vengeance Flame too early into lockdown drafts.</strong> Valir can cleanse slows, stuns, and the usual engage clutter. He cannot cleanse <a class="text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors" href="/heroes/franco">Franco</a> suppression, and the revamped <a class="text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors" href="/heroes/kaja">Kaja</a> restraint is not something his cleanse escapes either. If you use your ult the moment you are brushed by minor CC, the real lockdown arrives five seconds later and you die with no answer.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]"><strong class="text-[#E8E6E3] font-semibold">Blind-picking him into the wrong flank pattern.</strong> <a class="text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors" href="/heroes/hayabusa">Hayabusa</a>, <a class="text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors" href="/heroes/natalia">Natalia</a>, and <a class="text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors" href="/heroes/helcurt">Helcurt</a> do not need to honor your front-facing zone. If two of those threats are already visible and your own team has no peel, stop trying to outplay draft phase.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]"><strong class="text-[#E8E6E3] font-semibold">Rotating before the wave is solved.</strong> Valir looks like a hero who should constantly move first because his first two levels are strong. The problem is that his real value comes from arriving to river with spell charges, mana, and map shape in his favor. If you leave mid half-cleared and force a low-percentage side play, you lose plate pressure, lose first move on the reset, and often walk into fog with no Torrent available.</p>
<h2 class="text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative"><span aria-hidden="true" class="block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3"></span>Key tips</h2>
<div class="my-5 p-4 flex gap-3" style="background:rgba(200,170,110,0.08);border:1px solid rgba(200,170,110,0.35)"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lightbulb w-4 h-4 flex-shrink-0 mt-0.5" aria-hidden="true" style="color:#C8AA6E"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"></path><path d="M9 18h6"></path><path d="M10 22h4"></path></svg><div class="min-w-0 flex-1"><p class="text-[11px] font-heading font-bold uppercase tracking-wider mb-1" style="color:#C8AA6E">Tip</p><p class="text-sm text-[#9BA0B4] leading-relaxed">After level 4, try to enter every real fight with one Burst Fireball charge loaded, not zero. One loaded charge is what lets the second hit threaten the stun instead of just more poke.</p></div></div>
<div class="my-5 p-4 flex gap-3" style="background:rgba(0,170,255,0.08);border:1px solid rgba(0,170,255,0.35)"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info w-4 h-4 flex-shrink-0 mt-0.5" aria-hidden="true" style="color:#00AAFF"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg><div class="min-w-0 flex-1"><p class="text-[11px] font-heading font-bold uppercase tracking-wider mb-1" style="color:#00AAFF">Note</p><p class="text-sm text-[#9BA0B4] leading-relaxed">Enhanced Searing Torrent is strongest when you cast it across the route the enemy wants to use next, not directly on the spot they are standing on now. Think exit path, not current location.</p></div></div>
<div class="my-5 p-4 flex gap-3" style="background:rgba(200,170,110,0.08);border:1px solid rgba(200,170,110,0.35)"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lightbulb w-4 h-4 flex-shrink-0 mt-0.5" aria-hidden="true" style="color:#C8AA6E"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"></path><path d="M9 18h6"></path><path d="M10 22h4"></path></svg><div class="min-w-0 flex-1"><p class="text-[11px] font-heading font-bold uppercase tracking-wider mb-1" style="color:#C8AA6E">Tip</p><p class="text-sm text-[#9BA0B4] leading-relaxed">Glowing Wand already applies Lifebane. In standard mid Valir games, that means your anti-heal slot is already solved and you can spend later gold on penetration, defense, or stasis instead of duplicating the job.</p></div></div>
<div class="my-5 p-4 flex gap-3" style="background:rgba(0,170,255,0.08);border:1px solid rgba(0,170,255,0.35)"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info w-4 h-4 flex-shrink-0 mt-0.5" aria-hidden="true" style="color:#00AAFF"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg><div class="min-w-0 flex-1"><p class="text-[11px] font-heading font-bold uppercase tracking-wider mb-1" style="color:#00AAFF">Note</p><p class="text-sm text-[#9BA0B4] leading-relaxed">Against Franco, position as if your ultimate does not exist. It cleanses almost everything, but not suppression, and bad Valir players die because they forget that one exception. The revamped Kaja no longer suppresses, but his Divine Binding locks the area you are standing in, so the restraint is still not a &quot;cleanse and walk away&quot; situation.</p></div></div><aside class="not-prose mt-10 border border-mlbb-gold/25 bg-mlbb-bg-accent/30 p-5 sm:p-6" aria-label="About the author of this Valir guide"><div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:gap-5"><a class="shrink-0" aria-label="About Slendertaker" href="/authors/slendertaker"><img alt="Slendertaker" loading="lazy" width="72" height="72" decoding="async" data-nimg="1" class="h-[72px] w-[72px] rounded-full border border-mlbb-gold/50 object-cover" style="color:transparent" src="/authors/slendertaker.webp"/></a><div class="min-w-0 flex-1"><div class="text-xs uppercase tracking-wider text-mlbb-text-secondary">Written by</div><a class="font-heading text-lg text-mlbb-gold hover:text-mlbb-gold-bright" rel="author" href="/authors/slendertaker">Slendertaker</a><div class="text-sm text-mlbb-text-secondary">Mythic Immortal, Founder &amp; Editor of MLBBHub</div><p class="mt-3 text-sm leading-relaxed text-mlbb-text">Slendertaker climbed to Mythic Immortal in Mobile Legends, the apex of the ranked ladder, before sitting down to build the tool he wished existed while he was getting there. MLBBHub is that tool. He writes every hero guide on the site personally, picks the curated builds, and owns the data pipeline that keeps patch notes, items, and emblems in sync.</p><div class="mt-4 flex flex-wrap gap-2"><a href="https://github.com/slendertaker" target="_blank" rel="nofollow noopener noreferrer me" class="inline-flex items-center gap-1.5 border border-mlbb-gold/30 bg-mlbb-bg-accent/40 px-3 py-1 text-xs text-mlbb-text-secondary transition hover:border-mlbb-gold hover:text-mlbb-gold-bright" aria-label="GitHub profile"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-github" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg><span>GitHub</span></a><a href="https://x.com/slendertaker7" target="_blank" rel="nofollow noopener noreferrer me" class="inline-flex items-center gap-1.5 border border-mlbb-gold/30 bg-mlbb-bg-accent/40 px-3 py-1 text-xs text-mlbb-text-secondary transition hover:border-mlbb-gold hover:text-mlbb-gold-bright" aria-label="X profile"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-twitter" aria-hidden="true"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg><span>X</span></a><a href="https://slendertaker.com" target="_blank" rel="nofollow noopener noreferrer me" class="inline-flex items-center gap-1.5 border border-mlbb-gold/30 bg-mlbb-bg-accent/40 px-3 py-1 text-xs text-mlbb-text-secondary transition hover:border-mlbb-gold hover:text-mlbb-gold-bright" aria-label="slendertaker.com profile"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-external-link" aria-hidden="true"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg><span>slendertaker.com</span></a></div></div></div></aside></div></section></div></div><div id="tabpanel-skills" role="tabpanel" aria-labelledby="tab-skills" hidden=""></div><div id="tabpanel-matchups" role="tabpanel" aria-labelledby="tab-matchups" tabindex="0" hidden=""><div class="space-y-6 lg:space-y-8"><div class="glass-card border-mlbb-gold/15 p-4 sm:p-5" style="opacity:0;transform:translateY(-8px)"><div class="grid grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-x-3 gap-y-4 lg:grid-cols-[auto_auto_minmax(0,1fr)_auto] lg:gap-x-5"><div class="w-10 h-10 bg-mlbb-red/10 border border-mlbb-red/30 flex items-center justify-center"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield w-5 h-5 text-mlbb-red" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path></svg></div><div class="min-w-0"><p class="text-xs font-heading font-bold text-text-primary uppercase tracking-wider">Top Counter</p><p class="flex min-w-0 flex-wrap items-baseline gap-x-1.5 text-sm text-text-accent-bright font-heading font-bold"><span class="min-w-0 truncate">Helcurt</span><span class="shrink-0 text-mlbb-green text-xs">+<!-- -->3.3<!-- --> pp</span></p></div><a aria-label="Open full counter page for Valir" class="group inline-flex h-8 items-center justify-center gap-1.5 border border-mlbb-gold/20 bg-surface-2/45 px-2.5 font-heading text-[10px] font-bold uppercase tracking-wider text-text-accent transition-colors hover:border-mlbb-gold-bright/45 hover:text-text-accent-bright lg:col-start-4 lg:row-start-1" href="/counter/valir"><span>View all</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a><div class="col-span-3 grid gap-2 text-center grid-cols-3 sm:flex sm:items-center sm:justify-around lg:col-span-1 lg:col-start-3 lg:row-start-1"><div><p class="text-lg font-heading font-bold text-mlbb-green">12</p><p class="text-[9px] text-text-muted uppercase tracking-wider">Counters</p></div><div><p class="text-lg font-heading font-bold text-text-accent">9</p><p class="text-[9px] text-text-muted uppercase tracking-wider">Weak To</p></div><div><p class="text-lg font-heading font-bold text-text-accent-bright truncate">Balanced</p><p class="text-[9px] text-text-muted uppercase tracking-wider">Peak Phase</p></div></div></div></div><div class="grid gap-6 lg:grid-cols-2 lg:items-start lg:gap-6"><section><div class="mb-4"><div class="flex items-center gap-3 mb-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield w-5 h-5 text-mlbb-green" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path></svg><h2 class="text-lg md:text-xl font-heading font-bold text-text-primary">How to Counter<!-- --> <span style="color:#ff4444">Valir</span></h2></div><p class="text-xs text-text-muted max-w-2xl">These heroes have the biggest measured edge against Valir in ranked matches. Pick any of them for a statistical advantage in draft.</p></div><div class="space-y-3"><div class="group relative bg-surface-3 border border-mlbb-gold/15 hover:border-mlbb-green/30 transition-all duration-300" style="opacity:0;transform:translateY(12px)"><div class="flex items-center gap-3 p-3 sm:gap-4 sm:p-4"><div class="flex-shrink-0 w-7 sm:w-8 text-center"><span class="text-base sm:text-lg font-heading font-bold text-text-accent">#<!-- -->1</span></div><a class="flex-shrink-0" href="/heroes/helcurt"><div class="relative overflow-hidden flex-shrink-0 rounded-full" style="width:48px;height:48px;min-width:48px;background-color:#00AAFF12"><img alt="Helcurt hero icon" loading="lazy" width="48" height="48" decoding="async" data-nimg="1" class="h-full w-full object-cover" style="color:transparent" srcSet="https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_6abf0c552b59b8ca4cbc1af3662ef176.png&amp;w=48&amp;output=webp&amp;q=75&amp;we 1x, https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_6abf0c552b59b8ca4cbc1af3662ef176.png&amp;w=96&amp;output=webp&amp;q=75&amp;we 2x" src="https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_6abf0c552b59b8ca4cbc1af3662ef176.png&amp;w=96&amp;output=webp&amp;q=75&amp;we"/></div></a><div class="min-w-0 flex-1"><div class="flex items-center gap-2 sm:gap-3 flex-wrap"><a class="min-w-0 max-w-full truncate font-heading font-bold text-base sm:text-lg text-text-primary hover:text-text-accent-bright transition-colors" href="/heroes/helcurt">Helcurt</a><div class="inline-flex items-center justify-center font-heading font-bold bg-gradient-to-br from-[#9BA0B4] to-[#606478] text-[#101012] w-6 h-6 text-xs animate-tier-pop">C</div><div class="gap-1.5 hidden sm:flex"><span class="text-[10px] px-1.5 py-0.5" style="background-color:#00AAFF20;color:#4dc4ff">Assassin</span></div></div><p class="text-xs text-text-muted mt-1 line-clamp-2">Helcurt has a statistical edge over Valir based on ranked matchup data. Pick Helcurt to gain an advantage in draft.</p></div><div class="flex-shrink-0 text-right"><p class="flex items-center justify-end gap-1 text-lg sm:text-xl font-heading font-bold" style="color:#44ff88"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trending-up w-3.5 h-3.5" aria-hidden="true"><path d="M16 7h6v6"></path><path d="m22 7-8.5 8.5-5-5L2 17"></path></svg>+<!-- -->3.3</p><p class="text-[9px] text-text-muted uppercase hidden sm:block">win rate delta</p></div></div><div class="absolute top-0 left-0 w-3 h-3 border-t border-l border-mlbb-gold/20 pointer-events-none"></div><div class="absolute bottom-0 right-0 w-3 h-3 border-b border-r border-mlbb-gold/20 pointer-events-none"></div></div><div class="group relative bg-surface-3 border border-mlbb-gold/15 hover:border-mlbb-green/30 transition-all duration-300" style="opacity:0;transform:translateY(12px)"><div class="flex items-center gap-3 p-3 sm:gap-4 sm:p-4"><div class="flex-shrink-0 w-7 sm:w-8 text-center"><span class="text-base sm:text-lg font-heading font-bold text-text-accent">#<!-- -->2</span></div><a class="flex-shrink-0" href="/heroes/rafaela"><div class="relative overflow-hidden flex-shrink-0 rounded-full" style="width:48px;height:48px;min-width:48px;background-color:#2ECC7112"><img alt="Rafaela hero icon" loading="lazy" width="48" height="48" decoding="async" data-nimg="1" class="h-full w-full object-cover" style="color:transparent" srcSet="https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_68277dce415742c4a98883151c693a07.png&amp;w=48&amp;output=webp&amp;q=75&amp;we 1x, https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_68277dce415742c4a98883151c693a07.png&amp;w=96&amp;output=webp&amp;q=75&amp;we 2x" src="https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_68277dce415742c4a98883151c693a07.png&amp;w=96&amp;output=webp&amp;q=75&amp;we"/></div></a><div class="min-w-0 flex-1"><div class="flex items-center gap-2 sm:gap-3 flex-wrap"><a class="min-w-0 max-w-full truncate font-heading font-bold text-base sm:text-lg text-text-primary hover:text-text-accent-bright transition-colors" href="/heroes/rafaela">Rafaela</a><div class="inline-flex items-center justify-center font-heading font-bold bg-gradient-to-br from-[#FFD700] to-[#FFA500] text-[#1a1600] shadow-[0_0_12px_rgba(255,215,0,0.4)] w-6 h-6 text-xs animate-tier-pop">S</div><div class="gap-1.5 hidden sm:flex"><span class="text-[10px] px-1.5 py-0.5" style="background-color:#2ECC7120;color:#6ddb9c">Support</span></div></div><p class="text-xs text-text-muted mt-1 line-clamp-2">Rafaela has a statistical edge over Valir based on ranked matchup data. Pick Rafaela to gain an advantage in draft.</p></div><div class="flex-shrink-0 text-right"><p class="flex items-center justify-end gap-1 text-lg sm:text-xl font-heading font-bold" style="color:#44ff88"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trending-up w-3.5 h-3.5" aria-hidden="true"><path d="M16 7h6v6"></path><path d="m22 7-8.5 8.5-5-5L2 17"></path></svg>+<!-- -->3.3</p><p class="text-[9px