ontrol Default build for Valir.\",\"url\":\"https://mlbbhub.com/heroes/valir#build-mid-control-default\"},{\"@type\":\"HowToStep\",\"position\":3,\"name\":\"Buy Ice Queen Wand\",\"text\":\"Purchase Ice Queen Wand (2,040 gold) as item 3 in the Mid Control Default build for Valir.\",\"url\":\"https://mlbbhub.com/heroes/valir#build-mid-control-default\"},{\"@type\":\"HowToStep\",\"position\":4,\"name\":\"Buy Genius Wand\",\"text\":\"Purchase Genius Wand (2,000 gold) as item 4 in the Mid Control Default build for Valir.\",\"url\":\"https://mlbbhub.com/heroes/valir#build-mid-control-default\"},{\"@type\":\"HowToStep\",\"position\":5,\"name\":\"Buy Divine Glaive\",\"text\":\"Purchase Divine Glaive (1,970 gold) as item 5 in the Mid Control Default build for Valir.\",\"url\":\"https://mlbbhub.com/heroes/valir#build-mid-control-default\"},{\"@type\":\"HowToStep\",\"position\":6,\"name\":\"Buy Immortality\",\"text\":\"Purchase Immortality (2,120 gold) as item 6 in the Mid Control Default build for Valir.\",\"url\":\"https://mlbbhub.com/heroes/valir#build-mid-control-default\"}],\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://mlbbhub.com/heroes/valir\"},\"datePublished\":\"2026-04-20T00:00:00.000Z\",\"dateModified\":\"2026-05-13T00:00:00.000Z\",\"author\":{\"@type\":\"Organization\",\"name\":\"MLBBHub\",\"url\":\"https://mlbbhub.com\"}}31:[[[\"$\",\"script\",\"0\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$5d\"}}]],[[\"$\",\"script\",\"0\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"BreadcrumbList\\\",\\\"itemListElement\\\":[{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":1,\\\"name\\\":\\\"Home\\\",\\\"item\\\":\\\"https://mlbbhub.com\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":2,\\\"name\\\":\\\"Heroes\\\",\\\"item\\\":\\\"https://mlbbhub.com/heroes\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":3,\\\"name\\\":\\\"V