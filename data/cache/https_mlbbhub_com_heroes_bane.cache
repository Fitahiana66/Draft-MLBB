\",\"url\":\"https://mlbbhub.com\"}}5f:[\"$\",\"script\",\"1\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$63\"}}]\n64:T8eb,{\"@context\":\"https://schema.org\",\"@type\":\"HowTo\",\"name\":\"How to Build Bane in Mobile Legends: Magic Sustain Flex\",\"description\":\"Magic flex setup for drafts that already have physical turret damage and need Bane to punish armor stacking with Sea Ink and Deadly Catch.\",\"totalTime\":\"PT15M\",\"supply\":[{\"@type\":\"HowToSupply\",\"name\":\"Arcane Boots\"},{\"@type\":\"HowToSupply\",\"name\":\"Concentrated Energy\"},{\"@type\":\"HowToSupply\",\"name\":\"Holy Crystal\"},{\"@type\":\"HowToSupply\",\"name\":\"Divine Glaive\"},{\"@type\":\"HowToSupply\",\"name\":\"Blood Wings\"},{\"@type\":\"HowToSupply\",\"name\":\"Winter Crown\"}],\"tool\":[{\"@type\":\"HowToTool\",\"name\":\"Mage Emblem\"},{\"@type\":\"HowToTool\",\"name\":\"Flicker Battle Spell\"}],\"step\":[{\"@type\":\"HowToStep\",\"position\":1,\"name\":\"Buy Arcane Boots\",\"text\":\"Purchase Arcane Boots (690 gold) as item 1 in the Magic Sustain Flex build for Bane.\",\"url\":\"https://mlbbhub.com/heroes/bane#build-magic-sustain-flex\"},{\"@type\":\"HowToStep\",\"position\":2,\"name\":\"Buy Concentrated Energy\",\"text\":\"Purchase Concentrated Energy (2,020 gold) as item 2 in the Magic Sustain Flex build for Bane.\",\"url\":\"https://mlbbhub.com/heroes/bane#build-magic-sustain-flex\"},{\"@type\":\"HowToStep\",\"position\":3,\"name\":\"Buy Holy Crystal\",\"text\":\"Purchase Holy Crystal (3,000 gold) as item 3 in the Magic Sustain Flex build for Bane.\",\"url\":\"https://mlbbhub.com/heroes/bane#build-magic-sustain-flex\"},{\"@type\":\"HowToStep\",\"position\":4,\"name\":\"Buy Divine Glaive\",\"text\":\"Purchase Divine Glaive (1,970 gold) as item 4 in the Magic Sustain Flex build for Bane.\",\"url\":\"https://mlbbhub.com/heroes/bane#build-magic-sustain-flex\"},{\"@type\":\"HowToStep\",\"position\":5,\"name\":\"Buy Blood Wings\",\"text\":\"Purchase Blood Wings (2,100 gold) as item 5 in the Magic Sustain Flex build for Bane.\",\"url\":\"https://mlbbhub.com/heroes/bane#build-magic-sustain-flex\"},{\"@type\":\"HowToStep\",\"position\":6,\"name\":\"Buy Winter Crown\",\"text\":\"Purchase Winter Crown (1,910 gold) as item 6 in the Magic Sustain Flex build for Bane.\",\"url\":\"https://mlbbhub.com/heroes/bane#build-magic-sustain-flex\"}],\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://mlbbhub.com/heroes/bane\"},\"datePublished\":\"2026-04-13T00:00:00.000Z\",\"dateModified\":\"2026-05-07T00:00:00.000Z\",\"author\":{\"@type\":\"Organization\",\"name\":\"MLBBHub\",\"url\":\"https://mlbbhub.com\"}}60:[\"$\",\"script\",\"2\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$64\"}}]\n61:[\"$\",\"$L65\",null,{\"hero\":{\"id\":11,\"name\":\"Bane\",\"slug\":\"bane\",\"title\":\"Frozen King\",\"role\":[\"Fighter\",\"Mage\"],\"specialty\":[\"Push\",\"Burst\"],\"lane\":[\"Jungle\",\"EXP\"],\"tier\":\"B\",\"difficulty\":2,\"releaseYear\":2016,\"stats\":{\"durability\":50,\"offense\":60,\"controlEffect\":40,\"difficulty\":40},\"winRate\":51.47,\"pickRate\":0.36,\"banRate\":0.19,\"counters\":{\"strongAgainst\":[{\"heroSlug\":\"hylos\",\"heroName\":\"Hylos\",\"advantage\":\"strong\",\"tip\":\"Bane counters Tanks with high HP but low damage, such as Hylos and Belerick, because he can out-sustain them and deals HP percentage-based damage.\"},{\"heroSlug\":\"belerick\",\"heroName\":\"Belerick\",\"advantage\":\"strong\",\"tip\":\"Bane counters Tanks with high HP but low damage, such as Hylos and Belerick, because he can out-sustain them and deals HP percentage-based damage.\"}],\"weakAgainst\":[{\"heroSlug\":\"vale\",\"heroName\":\"Vale\",\"advantage\":\"weak\",\"tip\":\"Bane is countered by Mages that deal heavy damage from afar, such as Vale and Xavier who can deal significant damage to him before he can get in range.\"},{\"heroSlug\":\"xavier\",\"heroName\":\"Xavier\",\"advantage\":\"weak\",\"tip\":\"Bane is countered by Mages that deal heavy damage from afar, such as Vale and Xavier who can deal significant damage to him before he can get in range.\"}]},\"splashArt\":\"https://akmweb.youngjoygame.com/web/svnres/file/mlbb/homepage/100_7060e1c063474bb8ff9472d61f7ce4c3.jpg\",\"portrait\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_7e4e74bb161da0f477cc0d1819fa39e6.png\",\"officialMatchups\":[{\"kind\":\"best_ally\",\"heroId\":\"50\",\"heroName\":\"Zhask\",\"heroSlug\":\"zhask\",\"icon\":\"https://akmwebstatic.yuanzhanapp.com/web/madmin/image_ca13970038ce4d7590d2f271b6c6f7f5.png\",\"tip\":\"Bane is best suited in the lane with the hero Zhask for taking turrets, dominating early game and ending the match at a very quick pace.\"},{\"kind\":\"counters\",\"heroId\":\"24\",\"heroName\":\"Natalia\",\"heroSlug\":\"natalia\",\"icon\":\"https://akmwebstatic.yuanzhanapp.com/web/madmin/image_50b8723a3ca11dd18d34d26948aef12b.png\",\"tip\":\"In early game, it is good to go up against natalia or other assasins as his passive ability spams nicely and his tanky nature discourages direct attack.\"},{\"kind\":\"countered_by\",\"heroId\":\"16\",\"heroName\":\"Zilong\",\"heroSlug\":\"zilong\",\"icon\":\"https://akmwebstatic.yuanzhanapp.com/web/madmin/image_3bbb2c2b8a78d0d63ecd62d74048fcf4.jpg\",\"tip\":\"Fighters, especially Zilong can easily but down bane as bane does not deal much physical damage via auto attacks and his 3rd skill can be easily dodged if enemy heroes are not disabled.\"}],\"skills\":{\"skills\":[{\"name\":\"Shark Bite\",\"type\":\"Passive\",\"description\":\"Bane infuses his weapon with a stack of Power of Tide each time he uses a skill (up to 2 stacks). Each of his subsequent Basic Attacks consumes a stack to deal (+95% Total Physical Attack) (+ 4 (+0.4*Hero Level)% target's Max HP) Physical Damage to nearby enemies.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Bane infuses his weapon with a stack of \"},{\"type\":\"text\",\"text\":\"Power of Tide\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" each time he uses a skill (up to 2 stacks). Each of his subsequent Basic Attacks consumes a stack to deal \"},{\"type\":\"text\",\"text\":\" (+95% Total Physical Attack)\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" (+ 4 (+0.4*Hero Level)% target's Max HP) \"},{\"type\":\"text\",\"text\":\"Physical Damage\",\"color\":\"#fb1f1f\"},{\"type\":\"text\",\"text\":\" to nearby enemies.\"}],\"cooldown\":null,\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_6458e01eb437665b82e4cd27c10a4344.png\",\"tags\":[\"Burst\"]},{\"name\":\"Crab Claw Cannon\",\"type\":\"Skill 1\",\"description\":\"Bane fires his Crab Claw Cannon in the target direction, dealing 150 (+160% Total Physical Attack) Physical Damage to the first enemy hit and then 150% damage to a random enemy behind them (prioritizes enemy heroes). Enemies hit are slowed by 10 (+10% Total Magic Power)% for 1s.\\nEvery 100 Physical Attack Bane possesses reduces this skill's cooldown by an additional 8%.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Bane fires his Crab Claw Cannon in the target direction, dealing 150\"},{\"type\":\"text\",\"text\":\" (+160% Total Physical Attack)\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Physical Damage\",\"color\":\"#fb1f1f\"},{\"type\":\"text\",\"text\":\" to the first enemy hit and then 150% damage to a random enemy behind them (prioritizes enemy heroes). Enemies hit are slowed by 10\"},{\"type\":\"text\",\"text\":\" (+10% Total Magic Power)\",\"color\":\"#62f8fe\"},{\"type\":\"text\",\"text\":\"% for 1s.\\nEvery 100 \"},{\"type\":\"text\",\"text\":\"Physical Attack\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" Bane possesses reduces this skill's cooldown by an additional 8%.\"}],\"cooldown\":\"8s\",\"manaCost\":\"30\",\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_c0b05da138f56fff0f5876884c8a2036.png\",\"tags\":[\"Damage\"]},{\"name\":\"Sea Ink\",\"type\":\"Skill 2\",\"description\":\"Bane swallows a cup of sea ink, recovering HP equal to 200 (+150% Total Magic Power) + 5 (+1.5% Total Magic Power)% of his lost HP, and gaining 50% Movement Speed that decays over 2.5s.\\n\\nUse Again: Bane spits corrosive ink in a fan-shaped area, dealing 140 (+130% Total Magic Power) Magic Damage (up to 200% with charging time).\\nEvery 100 Magic Power Bane possesses reduces this skill's cooldown by an additional 7%.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Bane swallows a cup of sea ink, recovering HP equal to 200\"},{\"type\":\"text\",\"text\":\" (+150% Total Magic Power)\",\"color\":\"#62f8fe\"},{\"type\":\"text\",\"text\":\" + 5\"},{\"type\":\"text\",\"text\":\" (+1.5% Total Magic Power)\",\"color\":\"#62f8fe\"},{\"type\":\"text\",\"text\":\"% of his lost HP, and gaining 50% Movement Speed that decays over 2.5s.\\n\\n\"},{\"type\":\"text\",\"text\":\"Use Again\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\": Bane spits corrosive ink in a fan-shaped area, dealing 140\"},{\"type\":\"text\",\"text\":\" (+130% Total Magic Power)\",\"color\":\"#62f8fe\"},{\"type\":\"text\",\"text\":\" Magic Damage (up to 200% with charging time).\\nEvery 100 \"},{\"type\":\"text\",\"text\":\"Magic Power\",\"color\":\"#62f8fe\"},{\"type\":\"text\",\"text\":\" Bane possesses reduces this skill's cooldown by an additional 7%.\"}],\"cooldown\":\"7.5s\",\"manaCost\":\"50\",\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_c202bb567a0c80d5707288e75fdacfb8.png\",\"tags\":[\"Heal\",\"AOE\"]},{\"name\":\"Deadly Catch\",\"type\":\"Ultimate\",\"description\":\"Bane summons a school of sharks to charge in the target direction, dealing 700 (+80% Total Physical Attack) (+150% Total Magic Power) Magic Damage to enemies hit, knocking them airborne for 0.6s, and slowing them by 75% (decays over 3s).\\nThis skill deals 40% damage to turrets.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Bane summons a school of sharks to charge in the target direction, dealing 700\"},{\"type\":\"text\",\"text\":\" (+80% Total Physical Attack)\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"(+150% Total Magic Power)\",\"color\":\"#62f8fe\"},{\"type\":\"text\",\"text\":\" Magic Damage to enemies hit, knocking them airborne for 0.6s, and slowing them by 75% (decays over 3s).\\nThis skill deals 40% damage to turrets.\"}],\"cooldown\":\"40s\",\"manaCost\":\"120\",\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_fe8c4a45d27cc7d56b893a31138b8a4d.png\",\"tags\":[\"Burst\",\"CC\"]}],\"skillUpgradePriority\":\"3-1-2\",\"skillPriorityTip\":\"1= Skill 1\\n2= Skill 2\\nU= Skill Ultimate\\n\\n1 - 2 - 1 - U - 1 - 2 - 1 - U - 1 - 2 - 1 - U - 2 - 2 - 2\",\"skillPriorityTipRich\":[{\"type\":\"text\",\"text\":\"1= Skill 1\"},{\"type\":\"lineBreak\"},{\"type\":\"text\",\"text\":\"2= Skill 2\"},{\"type\":\"lineBreak\"},{\"type\":\"text\",\"text\":\"U= Skill Ultimate\"},{\"type\":\"lineBreak\"},{\"type\":\"lineBreak\"},{\"type\":\"text\",\"text\":\"1 - 2 - 1 - U - 1 - 2 - 1 - U - 1 - 2 - 1 - U - 2 - 2 - 2\"}]},\"synergies\":[{\"heroSlug\":\"tigreal\",\"heroName\":\"Tigreal\",\"synergyScore\":8,\"reason\":\"Bane works best with heroes like as Tigreal and Luo Yi who can pull enemies together so he can do even more damage with his AOE.\"},{\"heroSlug\":\"luo-yi\",\"heroName\":\"Luo Yi\",\"synergyScore\":8,\"reason\":\"Bane works best with heroes like as Tigreal and Luo Yi who can pull enemies together so he can do even more damage with his AOE.\"}],\"combos\":[{\"type\":\"teamfight\",\"title\":\"TEAMFIGHT COMBOS\",\"description\":\"In teamfights, use Bane's 2nd Skill to close in and catch multiple enemies with his Ultimate. Use an enhanced Basic Attack when the enemies are knocked airborne, then use his 2nd Skill and another enhanced Basic Attack. Finally, use his 1st Skill and enhanced Basic Attack to chase and finish off the enemy.\",\"skillSequence\":[{\"skillId\":1120,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_c202bb567a0c80d5707288e75fdacfb8.png\"},{\"skillId\":1130,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_fe8c4a45d27cc7d56b893a31138b8a4d.png\"},{\"skillId\":1100,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_f98d2e98eaebfb31c6c5101cf1c3201a.png\"},{\"skillId\":1120,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_c202bb567a0c80d5707288e75fdacfb8.png\"},{\"skillId\":1100,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_f98d2e98eaebfb31c6c5101cf1c3201a.png\"},{\"skillId\":1110,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_c0b05da138f56fff0f5876884c8a2036.png\"},{\"skillId\":1100,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_f98d2e98eaebfb31c6c5101cf1c3201a.png\"}]},{\"type\":\"laning\",\"title\":\"LANING COMBOS\",\"description\":\"In the laning phase, use Bane's 2nd Skill to get close to the enemy and hit them with an enhanced Basic Attack. Then use his 1st Skill to slow the enemy followed by another enhanced Basic Attack. And end with his 2nd Skill again with another enhanced Basic Attack.\",\"skillSequence\":[{\"skillId\":1120,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_c202bb567a0c80d5707288e75fdacfb8.png\"},{\"skillId\":1100,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_f98d2e98eaebfb31c6c5101cf1c3201a.png\"},{\"skillId\":1110,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_c0b05da138f56fff0f5876884c8a2036.png\"},{\"skillId\":1100,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_f98d2e98eaebfb31c6c5101cf1c3201a.png\"},{\"skillId\":1120,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_c202bb567a0c80d5707288e75fdacfb8.png\"},{\"skillId\":1100,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_f98d2e98eaebfb31c6c5101cf1c3201a.png\"}]}],\"metaDescription\":\"Bane build, counter, and strategy guide for MLBB. Learn physical EXP or jungle paths, Sea Ink timing, turret pressure, emblem picks, and flex item calls.\",\"builds\":[],\"overviewLede\":\"Bane is a side-lane pressure pick that turns skill casts into turret damage, then uses Sea Ink to stay on the map after trades other fighters would have to recall from. Pick him when your team can start fights without him and needs a lane that forces defenders away from Turtle, Lord, or mid pressure.\"},\"serverLocale\":\"en\",\"curatedBuilds\":{\"source\":\"curated\",\"hero\":\"bane\",\"patch\":\"2.1.67\",\"lastReviewed\":\"2026-05-07\",\"stalePatch\":true,\"currentPatch\":\"2.2.16a\",\"builds\":[{\"slot\":1,\"id\":\"exp-physical-pressure\",\"name\":\"EXP Physical Pressure\",\"roleContext\":\"EXP\",\"items\":[{\"slug\":\"tough-boots\",\"name\":\"Tough Boots\",\"cost\":700,\"fixed\":false},{\"slug\":\"endless-battle\",\"name\":\"Endless Battle\",\"cost\":2330,\"fixed\":false},{\"slug\":\"hunter-strike\",\"name\":\"Hunter Strike\",\"cost\":2010,\"fixed\":false},{\"slug\":\"blade-of-the-heptaseas\",\"name\":\"Blade of the Heptaseas\",\"cost\":1950,\"fixed\":false},{\"slug\":\"malefic-roar\",\"name\":\"Malefic Roar\",\"cost\":2060,\"fixed\":false},{\"slug\":\"immortality\",\"name\":\"Immortality\",\"cost\":2120,\"fixed\":false}],\"coreItems\":[{\"slug\":\"endless-battle\",\"name\":\"Endless Battle\"},{\"slug\":\"hunter-strike\",\"name\":\"Hunter Strike\"},{\"slug\":\"blade-of-the-heptaseas\",\"name\":\"Blade of the Heptaseas\"}],\"emblem\":{\"slug\":\"assassin\",\"name\":\"Assassin Emblem\",\"talents\":[{\"slug\":\"rupture\",\"name\":\"Rupture\",\"iconUrl\":\"/images/talents/rupture.png\",\"bucket\":\"standard\"},{\"slug\":\"master-assassin\",\"name\":\"Master Assassin\",\"iconUrl\":\"/images/talents/master-assassin.png\",\"bucket\":\"standard\"},{\"slug\":\"killing-spree\",\"name\":\"Killing Spree\",\"iconUrl\":\"/images/talents/killing-spree.png\",\"bucket\":\"core\"}]},\"spell\":{\"slug\":\"flicker\",\"name\":\"Flicker\"},\"blessing\":null,\"flexItems\":[{\"item\":{\"slug\":\"warrior-boots\",\"name\":\"Warrior Boots\"},\"replace\":{\"slug\":\"tough-boots\",\"name\":\"Tough Boots\"},\"trigger\":\"Use into physical EXP lanes when crowd control is light enough to skip Fortitude.\"},{\"item\":{\"slug\":\"sea-halberd\",\"name\":\"Sea Halberd\"},\"replace\":{\"slug\":\"blade-of-the-heptaseas\",\"name\":\"Blade of the Heptaseas\"},\"trigger\":\"Use when healing, shielding, or high-extra-HP fighters are surviving the first cannon and Shark Bite cycle.\"},{\"item\":{\"slug\":\"blade-of-despair\",\"name\":\"Blade of Despair\"},\"replace\":{\"slug\":\"immortality\",\"name\":\"Immortality\"},\"trigger\":\"Use when ahead and one more damage slot will end side-lane towers before the enemy can group.\"},{\"item\":{\"slug\":\"rose-gold-meteor\",\"name\":\"Rose Gold Meteor\"},\"replace\":{\"slug\":\"immortality\",\"name\":\"Immortality\"},\"trigger\":\"Use against mixed burst or magic pickoff attempts that hit before Sea Ink can recover the trade.\"}],\"notes\":\"Default EXP setup for side-lane turret pressure, cannon bounce poke, and short trades built around Endless Battle plus Shark Bite.\",\"totalCost\":11170,\"statLines\":[{\"key\":\"physatk\",\"labelKey\":\"common.stats.physicalAttack\",\"unit\":\"flat\",\"group\":\"offensive\",\"value\":270,\"sources\":[\"Endless Battle\",\"Hunter Strike\",\"Blade of the Heptaseas\",\"Malefi