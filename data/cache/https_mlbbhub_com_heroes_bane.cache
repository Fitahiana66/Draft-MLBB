,[\"$\",\"section\",null,{\"id\":\"hero-article\",\"className\":\"relative lg:order-1 bg-[#0a0a0a]/85 backdrop-blur-sm border border-[#C8AA6E]/15 p-5 md:p-9 overflow-hidden\",\"style\":{\"boxShadow\":\"0 1px 0 rgba(255,255,255,0.03) inset, 0 18px 38px -24px rgba(0,0,0,0.8)\"},\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[#F0D060]/55 to-transparent\",\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"absolute top-0 left-0 w-3 h-3 border-t border-l border-[#F0D060]/40\",\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"absolute top-0 right-0 w-3 h-3 border-t border-r border-[#C8AA6E]/30\",\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"absolute bottom-0 left-0 w-3 h-3 border-b border-l border-[#C8AA6E]/30\",\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"absolute bottom-0 right-0 w-3 h-3 border-b border-r border-[#C8AA6E]/30\",\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"absolute -top-32 -right-24 w-72 h-72 rounded-full bg-[#C8AA6E]/[0.05] blur-3xl pointer-events-none\",\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"relative hero-article-body max-w-[860px] mx-auto\",\"children\":[[[[\"$\",\"h2\",\"h2-0\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Bane Is A Map Bet, Not A Frontline Answer\"]}],\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Bane is correct when your draft already has the first engage covered. If the roam is Tigreal, Atlas, Minotaur, Khufra, or another reliable starter, Bane can play the side lane, break towers, and arrive after the enemy has spent their movement. If the roam is a healer or poke support and the jungler also wants someone else to start, Bane becomes a trap: he can cast Deadly Catch first, but he cannot stand in the middle of the fight after it lands.\"}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[\"Patch 2.1.67 (\",[\"$\",\"$L40\",\"a-0\",{\"href\":\"/patch-notes\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"patch notes\"}],\") matters only as a naming and visual update for Sea Ink. The strategic profile is still the same: physical Bane uses Crab Claw Cannon, empowered basics, and turret pressure as the reliable plan, while magic Bane is a conditional burst build that asks for more setup and cleaner spacing.\"]}],\"\\n\",[\"$\",\"p\",\"p-2\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Draft him into EXP lanes that must walk through the wave to trade. Terizla, Fredrinn, Minsitthar, and other grounded melee heroes give him easy cannon bounce angles and enough time to cash in empowered basics. Be more careful into mobile duelists and long-range mages. If Lancelot, Ling, Hayabusa, Xavier, or Vale can reach him before he stacks and exits, the pick needs peel or a gold lead before it feels playable.\"}],\"\\n\",[\"$\",\"h2\",\"h2-1\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[\"$L7e\",\"The Passive Is A Turret Clock\"]}],\"\\n\",\"$L7f\",\"\\n\",\"$L80\",\"\\n\",\"$L81\",\"\\n\",\"$L82\",\"\\n\",\"$L83\",\"\\n\",\"$L84\",\"\\n\",\"$L85\",\"\\n\",\"$L86\",\"\\n\",\"$L87\",\"\\n\",\"$L88\"],\"$L89\",\"$L8a\"],\"$L8b\"]}]]}]]}]\n"])</script><script>self.__next_f.push([1,"a1:I[392015,[\"$7\",\"$8\",\"$9\",\"$a\",\"$b\",\"$2e\",\"$3e\",\"$3f\"],\"