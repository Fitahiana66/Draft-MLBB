ength. His crew of undead sailors follows him without question as he plunders coastal cities and sinks naval fleets. Bane seeks the legendary Trident of the Deep, believing it will give him dominion over all the oceans and allow him to challenge the gods themselves.\",\"allies\":[{\"heroSlug\":\"franco\",\"heroName\":\"Franco\",\"relationship\":\"Former rival turned reluctant ally against sea threats\"},{\"heroSlug\":\"atlas\",\"heroName\":\"Atlas\",\"relationship\":\"Ocean titan whose power he covets\"}],\"rivals\":[{\"heroSlug\":\"yi-sun-shin\",\"heroName\":\"Yi Sun-shin\",\"relationship\":\"Admiral who hunts pirates like him\"},{\"heroSlug\":\"kadita\",\"heroName\":\"Kadita\",\"relationship\":\"Ocean goddess who opposes his plundering\"}]},\"loreUrlName\":\"Bane\",\"statsHistory\":[{\"date\":\"2026-09-07\",\"winRate\":51.45,\"pickRate\":0.33,\"banRate\":0.22},{\"date\":\"2026-09-10\",\"winRate\":51.48,\"pickRate\":0.32,\"banRate\":0.22},{\"date\":\"2026-09-16\",\"winRate\":51.79,\"pickRate\":0.32,\"banRate\":0.21},{\"date\":\"2026-09-28\",\"winRate\":50.97,\"pickRate\":0.25,\"banRate\":0.14},{\"date\":\"2026-10-02\",\"winRate\":50.92,\"pickRate\":0.26,\"banRate\":0.14},{\"date\":\"2026-10-09\",\"winRate\":50.93,\"pickRate\":0.27,\"banRate\":0.16},{\"date\":\"2026-10-17\",\"winRate\":51.47,\"pickRate\":0.36,\"banRate\":0.19}]},\"relatedHeroesSlot\":\"$L66\",\"statsSeoSlot\":\"$L67\",\"fieldManualSlot\":\"$L68\"}]\n62:[\"$\",\"$L69\",null,{\"heroName\":\"Bane\",\"heroSlug\":\"bane\",\"roles\":\"$61:props:hero:role\",\"lanes\":\"$61:props:hero:lane\",\"difficulty\":2,\"winRate\":51.47,\"pickRate\":0.36,\"banRate\":0.19,\"curatedBuilds\":\"$61:props:curatedBuilds\",\"topCounters\":\"$61:props:tabData:counterData:countersThisHero\",\"hasCounterPage\":true,\"hasRankStats\":true,\"locale\":\"en\",\"pageUrl\":\"https://mlbbhub.com/heroes/bane\",\"year\":2026}]\n"])</script><script>self.__next_f.push([1,"6a:I[313915,[\"$7\",\"$8\",\"$9\",\"$a\",\"$b\",\"$2e\",\"$3e\",\"$3