 bush pickoffs and the enemy has not started real Physical Defense.\"},{\"item\":{\"slug\":\"sea-halberd\",\"name\":\"Sea Halberd\"},\"replace\":{\"slug\":\"malefic-roar\",\"name\":\"Malefic Roar\"},\"trigger\":\"Use when the lane matchup or backline target survives through regen, shields, or high extra HP.\"},{\"item\":{\"slug\":\"antique-cuirass\",\"name\":\"Antique Cuirass\"},\"replace\":{\"slug\":\"immortality\",\"name\":\"Immortality\"},\"trigger\":\"Use against physical skill fighters who can punish Yin before My Turn is available again.\"}],\"notes\":\"EXP lane setup for side-lane punish games where Execute finishes the domain target and Master Assassin rewards clean isolation.\",\"totalCost\":12020,\"statLines\":[{\"key\":\"physatk\",\"labelKey\":\"common.stats.physicalAttack\",\"unit\":\"flat\",\"group\":\"offensive\",\"value\":335,\"sources\":[\"War Axe\",\"Hunter Strike\",\"Blade of Despair\",\"Malefic Roar\"]},{\"key\":\"physpenFlat\",\"labelKey\":\"common.stats.physicalPenetration\",\"unit\":\"flat\",\"group\":\"offensive\",\"value\":15,\"sources\":[\"Hunter Strike\"]},{\"key\":\"spellvamp\",\"labelKey\":\"common.stats.spellVamp\",\"unit\":\"percent\",\"group\":\"offensive\",\"value\":8,\"sources\":[\"War Axe\"]},{\"key\":\"hp\",\"labelKey\":\"common.stats.hp\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":1200,\"sources\":[\"War Axe\",\"Immortality\"]},{\"key\":\"physdefense\",\"labelKey\":\"common.stats.physicalDefense\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":33,\"sources\":[\"Warrior Boots\",\"Immortality\"]},{\"key\":\"movespeed\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"flat\",\"group\":\"utility\",\"value\":40,\"sources\":[\"Warrior Boots\"]},{\"key\":\"movespeedPct\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"percent\",\"group\":\"utility\",\"value\":5,\"sources\":[\"Blade of Despair\"]},{\"key\":\"cdreduction\",\"labelKey\":\"common.stats.cooldownReduction\",\"unit\":\"percent\",\"group\":\"utility\",