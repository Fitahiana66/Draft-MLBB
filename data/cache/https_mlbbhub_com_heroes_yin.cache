ribution&amp;emblem=assassin&amp;talents=rupture%2Cseasoned-hunter%2Ckilling-spree&amp;flex=warrior-boots.tough-boots%2Csea-halberd.malefic-roar%2Crose-gold-meteor.immortality%2Cqueens-wings.immortality">Simulator<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-external-link h-3 w-3" aria-hidden="true"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg></a></div></header><div class="lg:grid lg:grid-cols-[minmax(0,1.45fr)_minmax(0,1fr)] lg:gap-x-5 lg:gap-y-4 xl:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)]"><div class="mb-4 lg:col-start-1 lg:row-start-1 lg:mb-0"><div class="relative"><div class="pointer-events-none absolute left-[8%] right-[8%] top-[22px] h-px sm:top-[30px]" aria-hidden="true" style="background:linear-gradient(90deg, transparent, rgba(200,170,110,0.45) 12%, rgba(240,208,96,0.55) 50%, rgba(200,170,110,0.45) 88%, transparent)"></div><div class="relative grid grid-cols-6 gap-1.5 sm:gap-3.5"><div class="min-w-0" style="opacity:0;transform:translateY(8px)"><a class="group/item block min-w-0 focus-visible:outline-none" title="Tough Boots" href="/items/tough-boots"><div class="flex min-w-0 flex-col items-center gap-1.5 sm:gap-2"><div class="relative w-11 overflow-hidden rounded-full bg-surface-1 transition-all duration-200 group-hover/item:-translate-y-1 group-focus-visible/item:-translate-y-1 sm:w-[60px]" style="box-shadow:0 10px 24px -14px rgba(0,0,0,0.95), inset 0 0 0 1.5px rgba(240,208,96,0.32), 0 0 0 1px rgba(0,0,0,0.6)"><div class="flex-shrink-0 relative overflow-hidden " style="width:100%;aspect-ratio:1 / 1;border-radius:9999px;clip-path:circle(50% at 50% 50%)"><img alt="Tough Boots" loading="lazy" width="64" height="64" decoding="async" data-nimg="1" class="object-cover" style="color:transparent;width:100%;height:100%" 