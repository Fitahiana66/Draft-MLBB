wiki/Yin/Cosmetics\"},{\"name\":\"Eternal Guardian\",\"tier\":\"Exceptional\",\"rawTier\":\"Exceptional\",\"tag\":\"Starlight\",\"tagSlug\":\"starlight\",\"price\":\"2023/08 StarLight Member\",\"portraitFile\":\"Hero1135-portrait.png\",\"portraitUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/yin/Hero1135-portrait-20230623125844.webp\",\"splashUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/yin/Yin-Eternal-Guardian-20250420133003.webp\",\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Yin/Cosmetics\"},{\"name\":\"Eren\",\"tier\":\"Grand\",\"rawTier\":\"Grand\",\"tag\":\"Attack on Titan\",\"tagSlug\":\"attack-on-titan\",\"price\":\"Obtained via the MLBB × Attack on Titan event\",\"portraitFile\":\"Hero1136-portrait.png\",\"portraitUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/yin/Hero1136-portrait-20240129101521.webp\",\"splashUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/yin/Yin-Eren-20240122041247.webp\",\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Yin/Cosmetics\"},{\"name\":\"Immortal Guardian\",\"tier\":\"Exceptional\",\"rawTier\":\"Exceptional\",\"tag\":\"Starlight\",\"tagSlug\":\"starlight\",\"price\":\"2023/08 StarLight Reward\",\"portraitFile\":null,\"portraitUrl\":null,\"splashUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/yin/Yin-Immortal-Guardian-20250920032036.webp\",\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Yin/Cosmetics\"}],\"lore\":{\"backstory\":\"Yin is a street fighter from the back alleys of the Cadia Riverlands who harbors a powerful demon named Lieh within his body. By day, Yin is an energetic young brawler who fights with his fists. When he activates his ultimate, My Turn, he drags a single enemy into a separate domain where he transforms into the fearsome Lieh and battles them one-on-one. The duality of Yin's gentle nature and Lieh's ferocity creates an unpredictable fighter that no enemy wants to face alone.\",\"allies\":[{\"heroSlug\":\"wanwan\",\"heroName\":\"Wanwan\",\"relationship\":\"Eastern martial artist and childhood friend\"},{\"heroSlug\":\"chou\",\"heroName\":\"Chou\",\"relationship\":\"Martial arts master who recognizes his potential\"}],\"rivals\":[{\"heroSlug\":\"yu-zhong\",\"heroName\":\"Yu Zhong\",\"relationship\":\"Dragon lord who seeks to control Lieh\"},{\"heroSlug\":\"valentina\",\"heroName\":\"Valentina\",\"relationship\":\"Mimic who could potentially copy his domain power\"}]},\"loreUrlName\":\"Yin\",\"statsHistory\":[{\"date\":\"2026-09-07\",\"winRate\":49.02,\"pickRate\":0.59,\"banRate\":2.5},{\"date\":\"2026-09-10\",\"winRate\":49.1,\"pickRate\":0.58,\"banRate\":2.48},{\"date\":\"2026-09-16\",\"winRate\":48.99,\"pickRate\":0.58,\"banRate\":2.39},{\"date\":\"2026-09-28\",\"winRate\":48.18,\"pickRate\":0.49,\"banRate\":1.56},{\"date\":\"2026-10-02\",\"winRate\":48.3,\"pickRate\":0.49,\"banRate\":1.59},{\"date\":\"2026-10-09\",\"winRate\":48.64,\"pickRate\":0.48,\"banRate\":1.62},{\"date\":\"2026-10-17\",\"winRate\":48.92,\"pickRate\":0.46,\"banRate\":1.62}]},\"relatedHeroesSlot\":\"$L66\",\"statsSeoSlot\":\"$L67\",\"fieldManualSlot\":\"$L68\"}]\n61:[\"$\",\"$L69\",null,{\"heroName\":\"Yin\",\"heroSlug\":\"yin\",\"roles\":\"$60:props:hero:role\",\"lanes\":\"$60:props:hero:lane\",\"difficulty\":2,\"winRate\":48.92,\"pickRate\":0.46,\"banRate\":1.62,\"curatedBuilds\":\"$60:props:curatedBuilds\",\"topCounters\":\"$60:props:tabData:counterData:countersThisHero\",\"hasCounterPage\":true,\"hasRankStats\":true,\"locale\":\"en\",\"pageUrl\":\"https://mlbbhub.com/heroes/yin\",\"year\":2026}]\n"])</script><script>self.__next_f.push([1,"6a:I[313915,[\"$7\",\"$8\",\"$9\",\"$a\",\"$b\",\"$2e\",\"$3e\",\"$3f\"],\"default\"]\n6b:I[114533,[\"$7\",\"$8\",\"$9\",\"$a\",\"$b\",\"$2e\",\"$3e\",\"$3f\"],\"Image\"]\n6c:I[842376,[\"$7\",\"$8\",\"$9\",\"$a\",\"$b\",\"$2e\",\"$3e\",\"$3f\"],\"default\"]\n7d:I[365750,[\"$7\",\"$8\",\"$9\",\"$a\",\"$b\",\"$2e\",\"$3e\",\"$3f\"],\"default\"]\n66:[\"$\",\"section\",null,{\"className\":\"content-lazy mt-8 pt-