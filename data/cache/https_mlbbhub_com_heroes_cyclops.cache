-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #B07ECC, #B07ECC33)\",\"boxShadow\":\"0 0 12px -2px #B07ECC80\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#B07ECC\",\"background\":\"#B07ECC1a\",\"border\":\"1px solid #B07ECC40\"},\"children\":\"Epic\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Cyclops\",\"rank\":\"Epic\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=epic\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Epic\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Epic\",\"name\":\"Cyclops\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"51.94\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Cyclops\",\"delta\":\"+0.44%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.69\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.77\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Epic\"}}]]}]]}],[\"$\",\"article\",\"legend\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #4dc9f6, #4dc9f633)\",\"boxShadow\":\"0 0 12px -2px #4dc9f680\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#4dc9f6\",\"background\":\"#4dc9f61a\",\"border\":\"1px solid #4dc9f640\"},\"children\":\"Legend\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Cyclops\",\"rank\":\"Legend\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=legend\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Legend\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Legend\",\"name\":\"Cyclops\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"51.95\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Cyclops\",\"delta\":\"+0.45%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.73\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.34\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Legend\"}}]]}]]}],[\"$\",\"article\",\"mythic\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[\"$L9f\",\"$La0\",\"$La1\"]}],\"$La2\",\"$La3\"]}]\n7e:[\"$\",\"p\",\"p-3\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Cyclops is not a burst mage who dumps a rotation and waits. He is a cooldown engine whose damage is distributed across a higher volume of casts than any other mage in the game. Starlit Hourglass shortens every skill cooldown every time any skill connects. Stardust Shock fires two disks, so a clean two-disk hit on a hero pulls every cooldown down twice as fast. Planets Attack spawns homing spheres, and each sphere that lands drags the loop down further. A full cast rotation that lands both disks and multiple spheres can bring the ultimate back in a fraction of the time the tooltip promises.\"}]\n7f:[\"$\",\"p\",\"p-4\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The practical outcome is that Cyclops's tooltip cooldowns tell half the story. Stardust Shock runs far shorter in active combat when skills are landing, and Star Power Lockdown regularly recharges well ahead of its listed cooldown if the passive is fed between casts. That tempo difference is what separates him from the burst mages who dump a rotation and wait: nobody else in the mid roster poke-rotates at this frequency.\"}]\n80:[\"$\",\"p\",\"p-5\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The catch is that the loop is all-or-nothing. Every whiffed S1 disk, every S2 sphere that chases a minion instead of a hero, every ult that gets dashed out of is a cooldown tax on everything else. Cyclops pays his damage budget one skill hit at a time, and missed hits are lost income.\"}]\n81:[\"$\",\"h2\",\"h2-2\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Laning: the first 5 minutes\"]}]\n82:[\"$\",\"ol\",\"ol-0\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Take Stardust Shock at level 1 and land both disks on the wave plus the enemy mid.\"}],\" Each disk that clips the caster minion pack is a passive trigger, so a clean two-disk line through the wave and into the enemy hero feeds the loop several times on the first cast, and your next S1 is nearly ready before the wave finishes walking. Put level 2 into Planets Attack and spend level 3 on a second point in S1 for base damage scaling.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Hoarding mana is hoarding damage.\"}],\" Cyclops's skills are not cheap and his base mana regen cannot sustain casting on cooldown before Enchanted Talisman. Until that item completes around the 5-6 minute mark, restrict S1 casts to trades where both disks hit a hero, not the wave. Let minions push naturally and last-hit with basics. If you burn S1 on three consecutive waves, you enter minute four with an empty mana bar and zero lane presence.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Do not cast Planets Attack defensively.\"}],\" The decaying movement speed looks like an escape tool. It is not. The spheres auto-home onto the nearest enemy hero, which means running S2 through a jungle gank redirects your damage back toward the ganker and leaves you barely faster and pointed at the wrong target. If the enemy jungler is on your screen, Flicker is the only button that saves you. S2 is for trades and kills, never for escapes.\"]}],\"\\n\"]}],\"\\n\"]}]\n83:[\"$\",\"h2\",\"h2-3\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The Enchanted Talisman inflection point\"]}]\n84:[\"$\",\"p\",\"p-6\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Cyclops does not have a traditional level power spike. He has an item spike, and it lands the moment Enchanted Talisman completes at roughly the 5-6 minute mark. This single item does three things at once that flip him from a passive farmer into a fight threat. It provides 20% CDR (30% with Magic Boots), which slashes his rotation time nearly in half. It adds the Magic Mastery passive that raises the CDR cap by 5%, letting him exceed the normal 40% ceiling. And Mana Spring regenerates 15% of max mana every 10 seconds, permanently removing the mana constraint that forced conservative play in the first five minutes.\"}]\n85:[\"$\",\"p\",\"p-7\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The minute Enchanted Talisman hits your inventory, the playstyle changes. Before, you conserved S1 for hero trades only. After, you throw it on cooldown into every wave and every enemy in range. Before, you avoided committing Planets Attack unless a kill was certain. After, you lead every trade with S2 into S1 because the spheres trigger 2-3 passive procs before Stardust Shock even lands, shortening everything mid-cast. The Talisman transforms a poke mage into a rotation-committed damage dealer who stays topped up on mana through an entire teamfight.\"}]\n86:[\"$\",\"p\",\"p-8\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The second item is where the build branches. Genius Wand is the default continuation: it adds 75 Magic Power, 5% movement speed, and a stacking magic defense reduction passive that Cyclops triggers faster than any other mage because his passive feeds multiple Magic stacks per rotation. Against an enemy who has already built Athena's Shield by minute 8, skip Genius Wand and go straight to Divine Glaive for percent-based penetration.\"}]\n87:[\"$\",\"h2\",\"h2-4\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Teamfight geometry: range is damage\"]}]\n88:[\"$\",\"p\",\"p-9\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The reflex when a teamfight opens is to cast Star Power Lockdown on the first enemy in sight. That reflex is a wasted ultimate.\"}]\n89:[\"$\",\"ol\",\"ol-1\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Ult from maximum range or do not ult at all.\"}],\" Star Power Lockdown's immobilize scales with travel distance: a close-range cast locks for barely a moment, a full-travel cast locks long enough for a full S2 plus S1 follow-up. A short lock is not enough time before most heroes walk away or their team peels. Step back before you cast. Losing one step of positioning to earn a longer lock is always the right trade.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Hold ult until after the enemy dash is committed.\"}],\" Cyclops's ultimate is a targeted projectile, not an instant CC. Against Lancelot, Fanny, Ling, and Benedetta, casting before their mobility skill is spent guarantees the sphere either phases through an invincibility window or lands on a target who dashes to safety the moment immobilize ends. Wait for the cable snap, the dash end-point, or the Thorned Rose finish, then cast.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Spread S2 spheres, do not funnel them into one hero.\"}],\" Enemies hit by multiple Planets Attack spheres take reduced damage on every sphere after the first. Stacking all spheres onto a single tank wastes the damage on the second and third hit. Angle S2 so the spheres scatter across at least two targets: you deal more total damage and you trigger the passive cooldown reduction on every sphere that connects to a different enemy, compounding the loop across the whole fight.\"]}],\"\\n\"]}],\"\\n\"]}]\n8a:[\"$\",\"p\",\"p-10\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"If your support is Franco or Khufra, the ult timing calculus flips. Khufra's Bouncing Ball blocks dash escapes, which means the enemy cannot blink out of the lock. Franco's Iron Hook pulls a target into your maximum-range cast sweet spot. In either draft, you ult the carry the moment the support lands their CC, and you do not wait for a dash you know they cannot press.\"}]\n8b:[\"$\",\"$La4\",null,{\"slot\":\"7246933188\",\"variant\":\"in-article\",\"className\":\"my-8\"}]\n8c:[[\"$\",\"h2\",\"h2-0\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Itemization: two locked slots, four real conversations\"]}],\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Two items are not up for debate on Cyclops. Magic Boots provides 10% CDR that feeds the passive loop from minute one. Enchanted Talisman provides the mana engine and an additional 20% CDR plus the 5% cap extension from Magic Mastery. Together they push Cyclops to 30% CDR baseline before emblem bonuses, which is the threshold where his rotation cadence shifts from \\\"occasional poke\\\" to \\\"constant pressure.\\\" If you change either of those first two purchases, you are playing a different hero.\"}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Everything else is a conversation with the enemy draft. Here are the four slots ranked by how often you should be thinking about them.\"}],\"\\n\",[\"$\",\"p\",\"p-2\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"The penetration slot.\"}],\" Genius Wand is the default. Its Magic passive shreds 3 (+0.3 per hero level) magic defense per hit, stacks up to 3 times, and Cyclops's multi-hit passive stacks it faster than any other mage. A S1 plus S2 rotation lands enough hits to cap the debuff before the first sphere even finishes its homing path. Divine Glaive is the pivot when an enemy tank or bruiser has already completed Athena's Shield or Radiant Armor. Its Spellbreaker passive converts each point of enemy magic defense into 0.1% extra penetration, capping at 20%. Rule of thumb: Genius Wand if you can kill them before they finish a magic defense item, Divine Glaive if they already have it.\"]}],\"\\n\",[\"$\",\"p\",\"p-3\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"The damage slot.\"}],\" Holy Crystal is the highest raw Magic Power purchase in the slot at 165 Magic Power plus the Mystery passive that multiplies total Magic Power by 21-35% based on level. It is correct when the enemy backline is squishy and you can afford to build a pure burst item without sacrificing defense. Concentrated Energy is the alternative: 400 HP, 70 Magic Power, and the Recharge passive that stacks up to 30 extra Magic Power across 6 hits, converting into a 12% Magic Damage amp at full stacks for 3 seconds. Concentrated Energy is better in extended fights where you are rotating multiple cast cycles and trading with a bruiser, not one-rotation a squishy.\"]}],\"\\n\",[\"$\",\"p\",\"p-4\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"The utility slot.\"}],\" Glowing Wand adds 400 HP and two passives that solve specific problems. Scorch burns 1.5% of the target's max HP per second for 3 seconds on skill hit, which is the correct answer against HP-stacking tanks where flat Magic Power loses efficiency. Lifebane reduces shield and HP regen by 50% for 3 seconds, which shuts down Estes, Rafaela, and Mathilda comps. Lightning Truncheon is the wave-clear alternative: its Resonate passive fires a 120% Magic Power bounce to up to 3 enemies every 6 seconds, which turns Cyclops into a map-clear engine in siege situations.\"]}],\"\\n\",\"$La5\",\"\\n\",\"$La6\",\"\\n\",\"$La7\",\"\\n\",\"$La8\",\"\\n\",\"$La9\",\"\\n\",\"$Laa\",\"\\n\",\"$Lab\",\"\\n\",\"$Lac\",\"\\n\",\"$Lad\",\"\\n\",\"$Lae\",\"\\n\",\"$Laf\",\"\\n\",\"$Lb0\",\"\\n\",\"$Lb1\",\"\\n\",\"$Lb2\",\"\\n\",\"$Lb3\"]\n8d:[\"$\",\"$Lb4\",null,{\"heroName\":\"Cyclops\"}]\n"])</script><script>self.__next_f.push([1,"8e:[\"$\",\"div\",null,{\"className\":\"relative bg-surface-4 border border-mlbb-gold/20 overflow-hidden card-hover hover:border-mlbb-gold/50\",\"style\":{\"boxShadow\":\"0 2px 8px rgba(0,0,0,0.3)\"},\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 p-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative w-14 h-14 rounded-full overflow-hidden flex-shrink-0 bg-surface-3\",\"children\":[\"$\",\"$L6b\",null,{\"src\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_ff4de3b0aabd1d2f6e184db1c831f6a9.png\",\"alt\":\"Estes - Moon Elf King\",\"unoptimized\":false,\"priority\":\"$undefined\",\"fetchPriority\":\"$undefined\",\"fill\":true,\"className\":\"object-cover group-hover:scale-110 transition-transform duration-300\",\"sizes\":\"56px\",\"placeholder\":\"blur\",\"blurDataURL\":\"data:ima