g?apple-icon.1u_yy08wt5z0k.png\",\"sizes\":\"180x180\",\"type\":\"image/png\"}],[\"$\",\"$L62\",\"39\",{}]]\n33:null\n"])</script><script>self.__next_f.push([1,"65:I[867777,[\"$7\",\"$8\",\"$9\",\"$a\",\"$b\",\"$2e\",\"$3e\",\"$3f\"],\"default\"]\n69:I[385664,[\"$7\",\"$8\",\"$9\",\"$a\",\"$b\",\"$2e\",\"$3e\",\"$3f\"],\"default\"]\n63:T8ec,{\"@context\":\"https://schema.org\",\"@type\":\"HowTo\",\"name\":\"How to Build Cyclops in Mobile Legends: Jungle Tempo\",\"description\":\"Jungle setup for games where Cyclops is allowed to farm quickly, contest objectives with Retribution, and chase with Ice Retribution plus S2 speed.\",\"totalTime\":\"PT15M\",\"supply\":[{\"@type\":\"HowToSupply\",\"name\":\"Magic Boots\"},{\"@type\":\"HowToSupply\",\"name\":\"Enchanted Talisman\"},{\"@type\":\"HowToSupply\",\"name\":\"Concentrated Energy\"},{\"@type\":\"HowToSupply\",\"name\":\"Wishing Lantern\"},{\"@type\":\"HowToSupply\",\"name\":\"Divine Glaive\"},{\"@type\":\"HowToSupply\",\"name\":\"Blood Wings\"}],\"tool\":[{\"@type\":\"HowToTool\",\"name\":\"Mage Emblem\"},{\"@type\":\"HowToTool\",\"name\":\"Retribution Battle Spell\"}],\"step\":[{\"@type\":\"HowToStep\",\"position\":1,\"name\":\"Buy Magic Boots\",\"text\":\"Purchase Magic Boots (710 gold) as item 1 in the Jungle Tempo build for Cyclops.\",\"url\":\"https://mlbbhub.com/heroes/cyclops#build-jungle-tempo\"},{\"@type\":\"HowToStep\",\"position\":2,\"name\":\"Buy Enchanted Talisman\",\"text\":\"Purchase Enchanted Talisman (2,070 gold) as item 2 in the Jungle Tempo build for Cyclops.\",\"url\":\"https://mlbbhub.com/heroes/cyclops#build-jungle-tempo\"},{\"@type\":\"HowToStep\",\"position\":3,\"name\":\"Buy Concentrated Energy\",\"text\":\"Purchase Concentrated Energy (2,020 gold) as item 3 in the Jungle Tempo build for Cyclops.\",\"url\":\"https://mlbbhub.com/heroes/cyclops#build-jungle-tempo\"},{\"@type\":\"HowToStep\",\"position\":4,\"name\":\"Buy Wishing Lantern\",\"text\":\"Purchase Wishing Lantern (2,250 gold) as item 4 in the Jungle Tempo build for Cyclops.\",\"url\":\"https://mlbbhub.com/heroes/cyclops#build-jungle-tempo\"},{\"@type\":\"HowToStep\",\"position\":5,\"name\":\"Buy Divine Glaive\",\"text\":\"Purchase Divine Glaive (1,970 gold) as item 5 in the Jungle Tempo build for Cyclops.\",\"url\":\"https://mlbbhub.com/heroes/cyclops#build-jungle-tempo\"},{\"@type\":\"HowToStep\",\"position\":6,\"name\":\"Buy Blood Wings\",\"text\":\"Purchase Blood Wings (2,100 gold) as item 6 in the Jungle Tempo build for Cyclops.\",\"url\":\"https://mlbbhub.com/heroes/cyclops#build-jungle-tempo\"}],\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://mlbbhub.com/heroes/cyclops\"},\"datePublished\":\"2026-04-15T00:00:00.000Z\",\"dateModified\":\"2026-05-13T00:00:00.000Z\",\"author\":{\"@type\":\"Organization\",\"name\":\"MLBBHub\",\"url\":\"https://mlbbhub.com\"}}5e:[\"$\",\"script\",\"1\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$63\"}}]\n64:T919,{\"@context\":\"https://schema.org\",\"@type\":\"HowTo\",\"name\":\"How to Build Cyclops in Mobile Legends: Anti-Dive Control\",\"description\":\"Defensive mid setup for CC-heavy or dive-heavy drafts where Cyclops must survive the first lockout before his cooldown loop can take over.\",\"totalTime\":\"PT15M\",\"supply\":[{\"@type\":\"HowToSupply\",\"name\":\"Tough Boots\"},{\"@type\":\"HowToSupply\",\"name\":\"Enchanted Talisman\"},{\"@type\":\"HowToSupply\",\"name\":\"Concentrated Energy\"},{\"@type\":\"HowToSupply\",\"name\":\"Glowing Wand\"},{\"@type\":\"HowToSupply\",\"name\":\"Divine Glaive\"},{\"@type\":\"HowToSupply\",\"name\":\"Winter Crown\"}],\"tool\":[{\"@type\":\"HowToTool\",\"name\":\"Mage Emblem\"},{\"@type\":\"HowToTool\",\"name\":\"Purify Battle Spell\"}],\"step\":[{\"@type\":\"HowToStep\",\"position\":1,\"name\":\"Buy Tough Boots\",\"text\":\"Purchase Tough Boots (700 gold) as item 1 in the Anti-Dive Control build for Cyclops.\",\"url\":\"https://mlbbhub.com/heroes/cyclops#build-anti-dive-control\"},{\"@type\":\"HowToStep\",\"position\":2,\"name\":\"Buy Enchanted Talisman\",\"text\":\"Purchase Enchanted Talisman (2,070 gold) as item 2 in the Anti-Dive Control build for Cyclops.\",\"url\":\"https://mlbbhub.com/heroes/cyclops#build-anti-dive-control\"},{\"@type\":\"HowToStep\",\"position\":3,\"name\":\"Buy Concentrated Energy\",\"text\":\"Purchase Concentrated Energy (2,020 gold) as item 3 in the Anti-Dive Control build for Cyclops.\",\"url\":\"https://mlbbhub.com/heroes/cyclops#build-anti-dive-control\"},{\"@type\":\"HowToStep\",\"position\":4,\"name\":\"Buy Glowing Wand\",\"text\":\"Purchase Glowing Wand (2,050 gold) as item 4 in the Anti-Dive Control build for Cyclops.\",\"url\":\"https://mlbbhub.com/heroes/cyclops#build-anti-dive-control\"},{\"@type\":\"HowToStep\",\"position\":5,\"name\":\"Buy Divine Glaive\",\"text\":\"Purchase Divine Glaive (1,970 gold) as item 5 in the Anti-Dive Control build for Cyclops.\",\"url\":\"https://mlbbhub.com/heroes/cyclops#build-anti-dive-control\"},{\"@type\":\"HowToStep\",\"position\":6,\"name\":\"Buy Winter Crown\",\"text\":\"Purchase Winter Crown (1,910 gold) as item 6 in the Anti-Dive Control build for Cyclops.\",\"url\":\"https://mlbbhub.com/heroes/cyclops#build-anti-dive-control\"}],\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://mlbbhub.com/heroes/cyclops\"},\"datePublished\":\"2026-04-15T00:00:00.000Z\",\"dateModified\":\"2026-05-13T00:00:00.000Z\",\"author\":{\"@type\":\"Organization\",\"name\":\"MLBBHub\",\"url\":\"https://mlbbhub.com\"}}5f:[\"$\",\"script\",\"2\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$64\"}}]\n60:[\"$\",\"$L65\",null,{\"hero\":{\"id\":33,\"name\":\"Cyclops\",\"slug\":\"cyclops\",\"title\":\"Starsoul Magician\",\"role\":[\"Mage\"],\"specialty\":[\"Damage\",\"Control\"],\"lane\":[\"Mid\"],\"tier\":\"B\",\"difficulty\":2,\"releaseYear\":2017,\"stats\":{\"durability\":30,\"offense\":100,\"controlEffect\":70,\"difficulty\":40},\"winRate\":51.46,\"pickRate\":0.63,\"banRate\":0.27,\"counters\":{\"strongAgainst\":[{\"heroSlug\":\"terizla\",\"heroName\":\"Terizla\",\"advantage\":\"strong\",\"tip\":\"Cyclops' short skill cooldown makes him strong against mid-ranged heroes with poor Mobility, such as Terizla and Alpha.\"},{\"heroSlug\":\"alpha\",\"heroName\":\"Alpha\",\"advantage\":\"strong\",\"tip\":\"Cyclops' short skill cooldown makes him strong against mid-ranged heroes with poor Mobility, such as Terizla and Alpha.\"}],\"weakAgainst\":[{\"heroSlug\":\"lancelot\",\"heroName\":\"Lancelot\",\"advantage\":\"weak\",\"tip\":\"Cyclops lacks Dash or Blink skills, making him the preferred target for heroes with gap closers and CC skills. Such as Lancelot, Alucard and Kagura.\"},{\"heroSlug\":\"alucard\",\"heroName\":\"Alucard\",\"advantage\":\"weak\",\"tip\":\"Cyclops lacks Dash or Blink skills, making him the preferred target for heroes with gap closers and CC skills. Such as Lancelot, Alucard and Kagura.\"},{\"heroSlug\":\"kagura\",\"heroName\":\"Kagura\",\"advantage\":\"weak\",\"tip\":\"Cyclops lacks Dash or Blink skills, making him the preferred target for heroes with gap closers and CC skills. Such as Lancelot, Alucard and Kagura.\"}]},\"splashArt\":\"https://akmweb.youngjoygame.com/web/svnres/file/mlbb/homepage/100_b506976dcb608de1f369ab8f6b3cb055.jpg\",\"portrait\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_68da456f9c01b2f88d29ee320db181ed.png\",\"officialMatchups\":[{\"kind\":\"best_ally\",\"heroId\":\"10\",\"heroName\":\"Franco\",\"heroSlug\":\"franco\",\"icon\":\"https://akmwebstatic.yuanzhanapp.com/web/madmin/image_07605801972ede9147e9769ac7991aa0.png\",\"tip\":\"Franco is a tank, Franco can take all the damage for you or even hook the enemy for you to kill. Not that many reasons but you should go Franco for a better win rate.\"},{\"kind\":\"counters\",\"heroId\":\"8\",\"heroName\":\"Karina\",\"heroSlug\":\"karina\",\"icon\":\"https://akmweb.youngjoygame.com/web/madmin/image/1691dbbde8237768590768a90510d5a6.jpg?w=100-100-f7fcc4\",\"tip\":\"Karina has a really high burst damage but your damage is better. Attacking Karina with a good combo will be really good for you.\\nKarina is also fragile in the early game without defensive items.\"},{\"kind\":\"countered_by\",\"heroId\":\"42\",\"heroName\":\"Harley\",\"heroSlug\":\"harley\",\"icon\":\"https://akmwebstatic.yuanzhanapp.com/web/madmin/image_a2f1d7806d874283c83913f14a533bb0.png\",\"tip\":\"Harley can use his skill to probably escape and go back to his hat. Although Harley can be very fragile sometimes, but can really hurt with the appropriate build.\\nTry to use the combos I gave smartly and not using it randomly and understand all the situations deeply.\"}],\"skills\":{\"skills\":[{\"name\":\"Starlit Hourglass\",\"type\":\"Passive\",\"description\":\"Each time Cyclops hits an enemy with his skills, all his skill cooldowns are reduced by 0.5s.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Each time Cyclops hits an enemy with his skills, all his skill cooldowns are reduced by 0.5s.\"}],\"cooldown\":null,\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_f7b43d6e79d4116016d639302e00ebc4.png\",\"tags\":[\"Buff\"]},{\"name\":\"Stardust Shock\",\"type\":\"Skill 1\",\"description\":\"Cyclops casts two Stardust Disks in the target direction, each dealing 240 (+60% Total Magic Power) Magic Damage to enemies in its path.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Cyclops casts two Stardust Disks in the target direction, each dealing 240\"},{\"type\":\"text\",\"text\":\" (+60% Total Magic Power)\",\"color\":\"#62f8fe\"},{\"type\":\"text\",\"text\":\" Magic Damage to enemies in its path.\"}],\"cooldown\":\"7.5s\",\"manaCost\":\"50\",\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_c79390698655479c4999a82b9d84a932.png\",\"tags\":[\"AOE\"]},{\"name\":\"Planets Attack\",\"type\":\"Skill 2\",\"description\":\"Cyclops conjures Starlit Spheres around himself, gaining 50% Movement Speed that decays over 2s.\\n\\nThe Starlit Spheres automatically seek and attack nearby enemies (prioritizing enemy heroes), and explode on contact to deal 200 (+65% Total Magic Power) Magic Damage.\\nSubsequent hits on the same target deal reduced damage.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Cyclops conjures \"},{\"type\":\"text\",\"text\":\"Starlit Spheres\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" around himself, gaining 50% Movement Speed that decays over 2s.\\n\\nThe \"},{\"type\":\"text\",\"text\":\"Starlit Spheres\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" automatically seek and attack nearby enemies (prioritizing enemy heroes), and explode on contact to deal 200\"},{\"type\":\"text\",\"text\":\" (+65% Total Magic Power)\",\"color\":\"#62f8fe\"},{\"type\":\"text\",\"text\":\" Magic Damage.\\nSubsequent hits on the same target deal reduced damage.\"}],\"cooldown\":\"14s\",\"manaCost\":\"60\",\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_8702dc193a729d21627b4c37d21dd671.png\",\"tags\":[\"Burst\"]},{\"name\":\"Star Power Lockdown\",\"type\":\"Ultimate\",\"description\":\"Cyclops creates a Planetary Sphere that tracks the target enemy hero or creep, dealing 500 (+120% Total Magic Power) Magic Damage and immobilizing them for 0.75-1.5s (scales with Planetary Sphere's travel distance).\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Cyclops creates a \"},{\"type\":\"text\",\"text\":\"Planetary Sphere\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" that tracks the target enemy hero or creep, dealing 500\"},{\"type\":\"text\",\"text\":\" (+120% Total Magic Power)\",\"color\":\"#62f8fe\"},{\"type\":\"text\",\"text\":\" Magic Damage and immobilizing them for 0.75-1.5s (scales with \"},{\"type\":\"text\",\"text\":\"Planetary Sphere\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\"'s travel distance).\"}],\"cooldown\":\"26s\",\"manaCost\":\"60\",\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_9e7801c3fa4c06fdcc7383f3b9eb8b44.png\",\"tags\":[\"CC\",\"Damage\"]}],\"skillUpgradePriority\":\"3-2-1\",\"skillPriorityTip\":\"Max your second skill (Planets Attack) first, then your first skill, upgrade your ultimate when possible.\\nYou should max your second skill first as this is Cyclops most powerful skill.\\nYou can easily kill your enemies/finish them off with the appropriate build with his 2nd. So max his second first.\\nThis is essential when you have low health, you can easily escape from the enemy when you use this.\\nThis is also essential when you are chasing enemies. You should use this because Cyclops can be very fragile without the 3rd Item.\",\"skillPriorityTipRich\":[{\"type\":\"text\",\"text\":\"Max your second skill (Planets Attack) first, then your first skill, upgrade your ultimate when possible. \"},{\"type\":\"lineBreak\"},{\"type\":\"text\",\"text\":\"You should max your second skill first as this is Cyclops most powerful skill. \"},{\"type\":\"lineBreak\"},{\"type\":\"text\",\"text\":\"You can easily kill your enemies/finish them off with the appropriate build with his 2nd. So max his second first. \"},{\"type\":\"lineBreak\"},{\"type\":\"text\",\"text\":\"This is essential when you have low health, you can easily escape from the enemy when you use this. \"},{\"type\":\"lineBreak\"},{\"type\":\"text\",\"text\":\"This is also essential when you are chasing enemies. You should use this because Cyclops can be very fragile without the 3rd Item.\"},{\"type\":\"lineBreak\"}]},\"synergies\":[{\"heroSlug\":\"belerick\",\"heroName\":\"Belerick\",\"synergyScore\":8,\"reason\":\"Cyclops is best with tanky heroes with strong CC skills, like Belerick and Minsitthar.\"},{\"heroSlug\":\"minsitthar\",\"heroName\":\"Minsitthar\",\"synergyScore\":8,\"reason\":\"Cyclops is best with tanky heroes with strong CC skills, like Belerick and Minsitthar.\"}],\"combos\":[{\"type\":\"teamfight\",\"title\":\"TEAMFIGHT COMBOS\",\"description\":\"In teamfights, Cyclops should control the target enemy with his Ultimate, close in with his 2nd Skill, then finish off the target with his 1st Skill.\",\"skillSequence\":[{\"skillId\":3330,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_9e7801c3fa4c06fdcc7383f3b9eb8b44.png\"},{\"skillId\":3320,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_8702dc193a729d21627b4c37d21dd671.png\"},{\"skillId\":3310,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_c79390698655479c4999a82b9d84a932.png\"}]},{\"type\":\"laning\",\"title\":\"LANING COMBOS\",\"description\":\"Cyclops can use his 2nd Skill to close in on enemy heroes then hit them with both his 1st Skill and the spheres summoned by his 2nd Skill. This combo is very effective against enemy heroes.\",\"skillSequence\":[{\"skillId\":3320,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_8702dc193a729d21627b4c37d21dd671.png\"},{\"skillId\":3310,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_c79390698655479c4999a82b9d84a932.png\"}]}],\"metaDescription\":\"Cyclops build, counter, and strategy guide for Mobile Legends. Enchanted Talisman CDR loop, max-range ult timing, and the dash heroes that shut him down.\",\"builds\":[],\"overviewLede\":\"Cyclops is a mid laner whose damage ceiling is not a stat but a cooldown equation. Every skill hit shortens every other cooldown, so a Cyclops who lands everything casts twice as often as one who whiffs. Played to that loop he is a relentless poke engine; without it he is a short-range immobile mage with only Flicker to escape.\"},\"serverLocale\":\"en\",\"curatedBuilds\":{\"source\":\"curated\",\"hero\":\"cyclops\",\"patch\":\"2.1.67\",\"lastReviewed\":\"2026-05-13\",\"stalePatch\":true,\"currentPatch\":\"2.2.16a\",\"builds\":[{\"slot\":1,\"id\":\"mid-cooldown-default\",\"name\":\"Mid Cooldown Default\",\"roleContext\":\"Mid\",\"items\":[{\"slug\":\"magic-boots\",\"name\":\"Magic Boots\",\"cost\":710,\"fixed\":false},{\"slug\":\"enchanted-talisman\",\"name\":\"Enchanted Talisman\",\"cost\":2070,\"fixed\":false},{\"slug\":\"concentrated-energy\",\"name\":\"Concentrated Energy\",\"cost\":2020,\"fixed\":false},{\"slug\":\"genius-wand\",\"name\":\"Genius Wand\",\"cost\":2000,\"fixed\":false},{\"slug\":\"divine-glaive\",\"name\":\"Divine Glaive\",\"cost\":1970,\"fixed\":false},{\"slug\":\"glowing-wand\",\"name\":\"Glowing Wand\",\"cost\":2050,\"fixed\":false}],\"coreItems\":[{\"slug\":\"enchanted-talisman\",\"name\":\"Enchanted Talisman\"},{\"slug\":\"concentrated-energy\",\"name\":\"Concentrated Energy\"},{\"slug\":\"genius-wand\",\"name\":\"Genius Wand\"}],\"emblem\":{\"slug\":\"mage\",\"name\":\"Mage Emblem\",\"talents\":[{\"slug\":\"inspire\",\"name\":\"Inspire\",\"iconUrl\":\"/images/talents/inspire.png\",\"bucket\":\"standard\"},{\"slug\":\"bargain-hunter\",\"name\":\"Bargain Hunter\",\"iconUrl\":\"/images/talents/bargain-hunter.png\",\"bucket\":\"standard\"},{\"slug\":\"lethal-ignition\",\"name\":\"Lethal Ignition\",\"iconUrl\":\"/images/talents/lethal-ignition.png\",\"bucket\":\"core\"}]},\"spell\":{\"slug\":\"flicker\",\"name\":\"Flicker\"},\"blessing\":null,\"flexItems\":[{\"item\":{\"slug\":\"wishing-lantern\",\"name\":\"Wishing Lantern\"},\"replace\":{\"slug\":\"glowing-wand\",\"name\":\"Glowing Wand\"},\"trigger\":\"Use when the enemy front line has high HP but little healing or shielding to punish.\"},{\"item\":{\"slug\":\"blood-wings\",\"name\":\"Blood Wings\"},\"replace\":{\"slug\":\"glowing-wand\",\"name\":\"Glowing Wand\"},\"trigger\":\"Use when you are ahead and need the shield plus movement speed to keep cycling spells safely.\"},{\"item\":{\"slug\":\"winter-crown\",\"name\":\"Winter Crown\"},\"replace\":{\"slug\":\"glowing-wand\",\"name\":\"Glowing Wand\"},\"trigger\":\"Use when one assassin or hard-engage combo can reach you before Flicker creates enough space.\"},{\"item\":{\"slug\":\"arcane-boots\",\"name\":\"Arcane Boots\"},\"replace\":{\"slug\":\"magic-boots\",\"name\":\"Magic Boots\"},\"trigger\":\"Use only against low-Magic-Defense drafts where early flat penetration matters more than cooldown tempo.\"}],\"notes\":\"Default mid setup that turns Cyclops into a cooldown loop after Enchanted Talisman, then adds sustain and penetration for repeated skirmishes.\",\"totalCost\":10820,\"statLines\":[{\"key\":\"magicpower\",\"labelKey\":\"common.stats.magicPower\",\"unit\":\"flat\",\"group\":\"offensive\",\"value\":345,\"sources\":[\"Enchanted Talisman\",\"Concentrated Energy\",\"Genius Wand\",\"Divine Glaive\",\"Glowing Wand\"]},{\"key\":\"magicpen\",\"labelKey\":\"common.stats.magicPenetration\",\"unit\":\"percent\",\"group\":\"offensive\",\"value\":40,\"sources\":[\"Divine Glaive\"]},{\"key\":\"magicpenFlat\",\"labelKey\":\"common.stats.magicPenetration\",\"unit\":\"flat\",\"group\":\"offensive\",\"value\":10,\"sources\":[\"Genius Wand\"]},{\"key\":\"hybridsteal\",\"labelKey\":\"common.stats.hybridLifesteal\",\"unit\":\"percent\",\"group\":\"offensive\",\"value\":20,\"sources\":[\"Concentrated Energy\"]},{\"key\":\"hp\",\"labelKey\":\"common.stats.hp\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":1000,\"sources\":[\"Enchanted Talisman\",\"Concentrated Energy\",\"Glowing Wand\"]},{\"key\":\"movespeed\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"flat\",\"group\":\"utility\",\"value\":40,\"sources\":[\"Magic Boots\"]},{\"key\":\"movespeedPct\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"percent\",\"group\":\"utility\",\"value\":10,\"sources\":[\"Genius Wand\",\"Glowing Wand\"]},{\"key\":\"cdreduction\",\"labelKey\":\"common.stats.cooldownReduction\",\"unit\":\"percent\",\"group\":\"utility\",\"v