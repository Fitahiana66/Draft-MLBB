-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#B07ECC\",\"background\":\"#B07ECC1a\",\"border\":\"1px solid #B07ECC40\"},\"children\":\"Epic\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Lancelot\",\"rank\":\"Epic\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=epic\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Epic\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Epic\",\"name\":\"Lancelot\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"45.08\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Lancelot\",\"delta\":\"+1.94%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.47\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"1.28\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Epic\"}}]]}]]}],[\"$\",\"article\",\"legend\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #4dc9f6, #4dc9f633)\",\"boxShadow\":\"0 0 12px -2px #4dc9f680\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#4dc9f6\",\"background\":\"#4dc9f61a\",\"border\":\"1px solid #4dc9f640\"},\"children\":\"Legend\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Lancelot\",\"rank\":\"Legend\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=legend\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Legend\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Legend\",\"name\":\"Lancelot\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"43.67\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Lancelot\",\"delta\":\"+0.53%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.59\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.61\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Legend\"}}]]}]]}],[\"$\",\"article\",\"mythic\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[\"$La3\",\"$La4\",\"$La5\"]}],\"$La6\",\"$La7\"]}]\n7f:[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}]\n80:[\"$\",\"p\",\"p-4\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Lancelot is an invincibility-frame assassin. Every skill in his kit either gives him I-frames or enables the next I-frame window, and his passive rewards chaining them together.\"}]\n81:[\"$\",\"p\",\"p-5\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Soul Cutter stacks bonus damage on every dash or charge, capping out across roughly one full combo. That means by the time you finish your S1-S2-ult rotation, every hit in the sequence is dealing meaningfully more than its tooltip. The passive rewards fluid execution: the more abilities you chain without pausing, the harder each one hits.\"}]\n82:[\"$\",\"p\",\"p-6\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Puncture applies a Sword Mark to the first unmarked enemy it touches, and if it lands, the cooldown resets. This is not just a gap closer. It is a mark-chain tool. In a teamfight with three enemies clustered, a clean Lancelot dashes through all of them in sequence, applying marks, resetting S1, and building passive stacks before his S2 ever comes out.\"}]\n83:[\"$\",\"p\",\"p-7\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Thorned Rose is a multi-strike in a forward cone that makes Lancelot untargetable and invincible for its entire duration. Enemies standing in the center eat every strike. This is the primary damage tool and the primary survival tool at the same time. Every fight you take is a timing decision: when do you spend the invincibility window.\"}]\n84:[\"$\",\"p\",\"p-8\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Phantom Execution is the second I-frame, with an executioner's strike at the end of the charge. Invincible during the dash, finishing blow on any squishy who survived your S2 with a sliver of HP.\"}]\n85:[\"$\",\"p\",\"p-9\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The entire hero is a rhythm game. S1 to close and mark, S2 for damage plus I-frames, ult for the finishing strike plus I-frames. Get the rhythm right and you kill without taking a single point of damage. Get it wrong and you die in the gap between S2 ending and ult starting.\"}]\n86:[\"$\",\"h2\",\"h2-2\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Laning: the first few minutes\"]}]\n87:[\"$\",\"p\",\"p-10\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Lancelot jungles. His clear speed is average compared to Ling or Hayabusa, but his gank setup is stronger than both because of how Puncture's mark reset works.\"}]\n88:[\"$\",\"ol\",\"ol-0\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Start blue buff, clear toward red.\"}],\" Lancelot uses mana, not energy, and the CDR from blue matters for your S2 rotation speed. Full clear through both buffs by roughly the two-minute mark.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"At level 4, look for the lane with a pushed-up enemy.\"}],\" Your gank pattern is S1 through the minion wave (marking the minion, resetting S1), then S1 again through the enemy hero (marking them, resetting S1 again), then a third S1 for the gap close, S2 on top of them, ult for the finishing strike. This three-S1 chain is Lancelot's signature and it only works if there is a minion or creep between you and the target to chain marks through.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Never force a gank without the mark-chain setup.\"}],\" Walking up to a hero and using S1 directly gives you one dash on its full cooldown. Walking through a creep first gives you three dashes in a couple of seconds. The difference between these two approaches is the difference between a clean kill and a wasted rotation.\"]}],\"\\n\"]}]\n89:[\"$\",\"p\",\"p-11\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Mana is tight at level 4. A full S1-S2-ult combo eats most of your bar, so you get one real gank attempt before needing to recall or take blue again. Do not spam S2 on jungle camps to clear faster.\"}]\n8a:[\"$\",\"h2\",\"h2-3\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The power spike you are farming toward\"]}]\n8b:[\"$\",\"p\",\"p-12\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Lancelot's first core is Blade of the Heptaseas. Its Ambush passive fires after not dealing or taking damage for a brief stretch, which describes every gank approach because you are traveling between camps without auto-attacking anything. Before Heptaseas, your S1-S2 combo chunks a squishy to around half health. After Heptaseas, the Ambush basic plus ult finishes the job in one pass.\"}]\n8c:[\"$\",\"p\",\"p-13\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The real two-item spike is Heptaseas plus War Axe. Heptaseas supplies the opening burst; War Axe stacks physical attack on every attack and converts a portion of your damage into true damage once it reaches full stacks, which matters because Thorned Rose's multiple strikes each bank another stack of Fighting Spirit. The CDR is the other half of the spike: it brings S2 back up fast enough that you have I-frames ready for the disengage, not just the engage. This is the window where Lancelot flips from farming to hunting.\"}]\n8d:[\"$\",\"p\",\"p-14\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Endless Battle goes third. Divine Justice makes your post-skill basic attack deal extra true damage, which triggers naturally off the auto you sneak in between S1 and S2. Chase Fate's movement-speed bump on the same proc covers the rotation to your next target. After three items, Lancelot one-rotations any non-tank hero in the game. The rest of the build is about surviving long enough to start the combo.\"}]\n8e:[\"$\",\"$La8\",null,{\"slot\":\"7246933188\",\"variant\":\"in-article\",\"className\":\"my-8\"}]\n8f:[[\"$\",\"h2\",\"h2-0\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Teamfight positioning and target priority\"]}],\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The reflex when a teamfight breaks out is to S1 through the enemy frontline and S2 onto the marksman. That reflex is correct about three games in ten.\"}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The reason it fails the other seven is that the S1 chain through the frontline builds your passive stacks but also announces your position the instant you leave fog. By the time you reach the backline, the enemy support has already repositioned and the marksman has popped Flicker or Wind of Nature.\"}],\"\\n\",[\"$\",\"p\",\"p-2\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Three positioning rules:\"}],\"\\n\",[\"$\",\"ol\",\"ol-0\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Enter from the side, not through the front.\"}],\" Use fog and jungle entrances to reach an angle where your S1 only needs to pass through one creep or minion before hitting the target. The shorter the S1 chain, the less time the enemy has to react.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Use S2 to dodge the one ability that kills you, not as your opening damage.\"}],\" If you open with S2, you have no I-frames when the enemy Chou kicks you or Aurora freezes you mid-animation. Wait until you see the threatening ability fire, then S2 through it. The damage is the bonus. The I-frames are the point.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Hold ult until the target is low enough to die in one strike.\"}],\" Phantom Execution's base plus your stacked passive is enough to finish any squishy from that point. Using it at the start of the combo wastes the finisher and leaves you with no second I-frame for the disengage.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",\"p-3\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"If your target builds Winter Crown, they will usually pop it the moment your S2 damage lands. Do not panic-ult during the freeze. Wait for the freeze to end, then ult immediately. The timing window is tight but predictable.\"}],\"\\n\",[\"$\",\"h2\",\"h2-1\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Itemization: defaults vs flex slots\"]}],\"\\n\",[\"$\",\"p\",\"p-4\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Three locked slots and three real conversations.\"}],\"\\n\",[\"$\",\"p\",\"p-5\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"The three locks are Blade of the Heptaseas, War Axe, and Endless Battle.\"}],\" Ambush burst plus stacking true damage plus Divine Justice true damage. This sequence covers every phase of the combo: the approach, the S2 stack-up, and the post-skill auto.\"]}],\"\\n\",\"$La9\",\"\\n\",\"$Laa\",\"\\n\",\"$Lab\",\"\\n\",\"$Lac\",\"\\n\",\"$Lad\",\"\\n\",\"$Lae\",\"\\n\",\"$Laf\",\"\\n\",\"$Lb0\",\"\\n\",\"$Lb1\",\"\\n\",\"$Lb2\",\"\\n\",\"$Lb3\",\"\\n\",\"$Lb4\",\"\\n\",\"$Lb5\",\"\\n\",\"$Lb6\",\"\\n\",\"$Lb7\"]\n90:[\"$\",\"$Lb8\",null,{\"heroName\":\"Lancelot\"}]\n"])</script><script>self.__next_f.push([1,"91:[\"$\",\"div\",null,{\"className\":\"relative bg-surface-4 border 