g:items-start\",\"children\":[[\"$\",\"div\",null,{\"className\":\"lg:order-2 lg:sticky lg:self-start\",\"style\":{\"top\":128},\"children\":[\"$\",\"$L7d\",null,{\"target\":\"#hero-article\"}]}],[\"$\",\"section\",null,{\"id\":\"hero-article\",\"className\":\"relative lg:order-1 bg-[#0a0a0a]/85 backdrop-blur-sm border border-[#C8AA6E]/15 p-5 md:p-9 overflow-hidden\",\"style\":{\"boxShadow\":\"0 1px 0 rgba(255,255,255,0.03) inset, 0 18px 38px -24px rgba(0,0,0,0.8)\"},\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[#F0D060]/55 to-transparent\",\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"absolute top-0 left-0 w-3 h-3 border-t border-l border-[#F0D060]/40\",\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"absolute top-0 right-0 w-3 h-3 border-t border-r border-[#C8AA6E]/30\",\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"absolute bottom-0 left-0 w-3 h-3 border-b border-l border-[#C8AA6E]/30\",\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"absolute bottom-0 right-0 w-3 h-3 border-b border-r border-[#C8AA6E]/30\",\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"absolute -top-32 -right-24 w-72 h-72 rounded-full bg-[#C8AA6E]/[0.05] blur-3xl pointer-events-none\",\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"relative hero-article-body max-w-[860px] mx-auto\",\"children\":[[[[\"$\",\"h2\",\"h2-0\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Pick Baxia when sustain is the enemy win condition\"]}],\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Baxia is correct when the enemy composition has at least two heroes who expect shields, healing, or repeated regeneration to carry a fight. Estes, Angela pocket comps, Ruby, Esmeralda, Uranus, Yu Zhong, Hilda, Alpha, Alice, and Hylos all become worse when Baxia is allowed to keep touching the fight. If the enemy plan is \\\"survive the first burst, heal, and re-enter,\\\" Baxia attacks the plan itself.\"}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"He is a trap when the enemy draft does not care about sustain. A lineup built around Lesley poke, Karrie true damage, X.Borg armor burn, Valir disengage, Saber pickoffs, or long-range mages can punish Baxia before his mark changes the fight. In those games you are not countering a win condition. You are just rolling a large body into damage that was already built to kill tanks.\"}],\"\\n\",[\"$\",\"p\",\"p-2\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The role choice should follow your team's damage map. Roam Baxia fits teams with a real jungler, a burst mid, and side lanes that can finish the target he marks. Jungle Baxia fits teams that already drafted a front-line EXP laner and need early anti-heal pressure around Turtle. Do not pick either version if your team has no one ready to cash in the debuff during the first two objective fights.\"}],\"\\n\",[\"$\",\"h2\",\"h2-1\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Baxia works because he changes healing math\"]}],\"\\n\",\"$L7e\",\"\\n\",\"$L7f\",\"\\n\",\"$L80\",\"\\n\",\"$L81\",\"\\n\",\"$L82\",\"\\n\",\"$L83\",\"\\n\",\"$L84\",\"\\n\",\"$L85\",\"\\n\",\"$L86\",\"\\n\",\"$L87\"],\"$L88\",\"$L89\"],\"$L8a\"]}]]}]]}