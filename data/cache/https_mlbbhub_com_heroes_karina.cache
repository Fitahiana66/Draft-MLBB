l-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #4dc9f6, #4dc9f633)\",\"boxShadow\":\"0 0 12px -2px #4dc9f680\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#4dc9f6\",\"background\":\"#4dc9f61a\",\"border\":\"1px solid #4dc9f640\"},\"children\":\"Legend\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Karina\",\"rank\":\"Legend\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=legend\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Legend\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Legend\",\"name\":\"Karina\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"48.27\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Karina\",\"delta\":\"+0.47%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.93\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"4.11\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Legend\"}}]]}]]}],[\"$\",\"article\",\"mythic\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[\"$La4\",\"$La5\",\"$La6\"]}],\"$La7\",\"$La8\"]}]\n7e:[\"$\",\"p\",\"p-4\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Disqualifying test: if you cannot name the specific enemy hero whose death starts your kill chain, you are on the wrong hero.\"}]\n7f:[\"$\",\"h2\",\"h2-1\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The one thing that makes Karina work\"]}]\n80:[\"$\",\"p\",\"p-5\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[\"Karina is a countdown timer, not a hero. Her whole kit exists to reward the first kill by making the second one almost free. The ultimate resets when the marked target dies. The passive refunds cooldown on both other skills on the third consecutive hit. The third-hit true damage is a \",[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"finisher mechanic\"}],\" that scales with how much HP the target has already lost, which is the game explicitly telling you to let someone else do the chunking before you arrive.\"]}]\n81:[\"$\",\"p\",\"p-6\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"This is why Karina games look binary. When she gets a level-4 gank that sticks, the next teamfight has her arriving with full ult, half-cooldown S1, and half-cooldown S2, and she deletes a second target before the first body is gray. When the level-4 gank fails, she is a sub-optimal jungler with no wave-clear priority and a sub-optimal burst mage with no range. Nothing in her kit generates value in the middle lane of that outcome spectrum. There is no \\\"laning phase Karina\\\". There is \\\"Karina who already has a head\\\" and \\\"Karina who does not\\\".\"}]\n82:[\"$\",\"p\",\"p-7\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[\"Everything else in the kit serves the reset loop. \",[\"$\",\"$L40\",\"a-0\",{\"href\":\"/spells\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Dance of Blades\"}],\" gives her a movement-speed burst, a window that blocks all basic attacks, and an enhanced basic that slows, always crits, and ends the state. The block is still a one-matchup tool for diving basic-attack carries, but 2.2.16 put real damage on the enhanced hit, so the button now earns its place in any dive, not only against marksmen. \",[\"$\",\"$L40\",\"a-1\",{\"href\":\"/spells\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Dance of Death\"}],\" is a single-button AOE spin that clears jungle camps in one press and collapses squishy clusters in teamfights. Shadow Assault is a point-click blink with a leash point behind the target so she can escape back to where she came from. Read the kit in that order (reset, dive, clean, escape) and every decision point becomes obvious.\"]}]\n83:[\"$\",\"h2\",\"h2-2\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The first four minutes in the jungle\"]}]\n84:[\"$\",\"ol\",\"ol-0\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Take S2 first, clear Litho then the buff.\"}],\" S2 is a single-cast AOE that hits the whole creep pack, which is the fastest jungle clear she has. Start blue side Litho to Turtle buff or red side Crab to Lord buff depending on your team's ult timers. Do not start at the buff. The buff camp has the lowest creep count and you waste the S2 cast.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"By level 4, look at the enemy solo lanes.\"}],\" Not mid. Mid usually has a dash or a minion wave. The EXP laner and the gold laner are where Karina's first reset happens. If either is pushed past river without vision, you ult in, auto three times for the passive true-damage proc, and leave through your shadowform. A successful gank at 2:30 to 3:30 minutes is worth more than any objective on the map.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Do not burn Flicker to engage.\"}],\" Flicker is your second out. Her ultimate's back-dash is the first out, and it only works if the shadowform is between you and your team. Flicker covers the case where you landed the kill but the shadowform is now behind the enemy tower. Save it. If you use Flicker to get in and then need to get out, you die.\"]}],\"\\n\"]}]\n85:[\"$\",\"h2\",\"h2-3\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The power spike you are farming toward\"]}]\n86:[\"$\",\"p\",\"p-8\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"$L40\",\"a-0\",{\"href\":\"/items/genius-wand\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Genius Wand\"}],\" plus \",[\"$\",\"$L40\",\"a-1\",{\"href\":\"/items/lightning-truncheon\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Lightning Truncheon\"}],\", finished somewhere between the 8 and 10-minute mark depending on how much you farmed. This is not a soft spike, it is the single moment her kit stops chipping and starts deleting.\"]}]\n87:[\"$\",\"p\",\"p-9\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Genius Wand applies a stacking magic-defense reduction on every instance of damage, up to three stacks. Karina's S1 enhanced basic plus her S2 plus her ultimate put three instances on the target in under two seconds, which means by the third damage tick she is hitting through roughly 20 points of magic defense that was there a moment ago. Lightning Truncheon converts her next skill cast into a 120% Total Magic Power resonate proc every six seconds, which on her ultimate's impact frame is essentially a second ult stapled to the first.\"}]\n88:[\"$\",\"p\",\"p-10\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Before these two items, she kills a 2500-HP target in three skills and two autos. After, she kills the same target in two skills and one auto. That difference is the entire reason the hero is picked: the shorter the rotation, the less time the target's team has to answer the dive.\"}]\n89:[\"$\",\"p\",\"p-11\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Do not force fights at the 5 or 6-minute mark if you are not two-cored. Invading enemy jungle, counter-ganking lanes, taking the first Turtle contest: all of these lose you tempo unless your team can win the fight without your damage. Your damage is not online yet.\"}]\n8a:[\"$\",\"h2\",\"h2-4\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Teamfight positioning and target priority\"]}]\n8b:[\"$\",\"p\",\"p-12\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The reflex when you see a Khufra or a Franco is to spin your S2 into the frontline because it is an AOE and there is a human in front of you. That reflex gets you suppressed. Karina's job in a teamfight is not to kill the tank and it is not to participate in the first exchange. It is to stand at the edge of the fight, wait until one of the enemy carries drops below the passive true-damage threshold (roughly 60% HP is when the math starts favoring the dive), and then remove that carry from the game with one rotation.\"}]\n8c:[\"$\",\"p\",\"p-13\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Three rules:\"}]\n8d:[\"$\",\"ol\",\"ol-1\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"You are the third wave, not the first.\"}],\" Your tank walks in, your mage or marksman poke, then you enter. Entering with the tank means you eat their opener and have nothing left for the second target.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Ult the lowest-HP enemy carry, not the closest.\"}],\" Shadow Assault is a point-click. Distance is irrelevant, HP threshold is everything. If you ult the tank to \\\"reach\\\" the marksman, you are now next to the tank and the marksman is already repositioning.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Cast S1 before you press ult, not after.\"}],\" The movement-speed burst plus the basic-attack block is a pre-dive tool, not a reaction. Pressing S1 while mid-dash wastes most of its window. If the target is already in basic-attack range, spend the enhanced hit before you dash: Shadow Assault ends the Dance early, and after 2.2.16 that hit is too much damage to throw away.\"]}],\"\\n\"]}]\n8e:[\"$\",\"p\",\"p-14\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[\"Support conditional: if your support is \",[\"$\",\"$L40\",\"a-0\",{\"href\":\"/heroes/mathilda\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Mathilda\"}],\", her ult is your engage signal and you follow her directly onto the back line. If your support is \",[\"$\",\"$L40\",\"a-1\",{\"href\":\"/heroes/estes\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Estes\"}],\" or \",[\"$\",\"$L40\",\"a-2\",{\"href\":\"/heroes/angela\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Angela\"}],\", you play one step further forward because their healing covers your S1 expiration. If your support is \",[\"$\",\"$L40\",\"a-3\",{\"href\":\"/heroes/franco\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Franco\"}],\", you wait for the hook to land and then ult the hooked target. Do not ult before the hook connects. You will be the one who gets blamed when it misses.\"]}]\n8f:[\"$\",\"$La9\",null,{\"slot\":\"7246933188\",\"variant\":\"in-article\",\"className\":\"my-8\"}]\n90:[[\"$\",\"h2\",\"h2-0\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Itemization: defaults vs flex slots\"]}],\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Three locked slots plus three real conversations.\"}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[\"Locked: Jungler \",[\"$\",\"$L40\",\"a-0\",{\"href\":\"/items/arcane-boots\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Arcane Boots\"}],\" upgrading into Ice or Bloody Retribution, \",[\"$\",\"$L40\",\"a-1\",{\"href\":\"/items/genius-wand\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Genius Wand\"}],\", \",[\"$\",\"$L40\",\"a-2\",{\"href\":\"/items/lightning-truncheon\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Lightning Truncheon\"}],\". These are non-negotiable and they always come in that order. Skipping Genius Wand for a flat magic power item is a common mistake; you lose the penetration stacking that makes your two-skill rotation delete a full-HP target.\"]}],\"\\n\",[\"$\",\"p\",\"p-2\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The three flex slots are where you actually show up as a player:\"}],\"\\n\",[\"$\",\"ul\",\"ul-0\",{\"className\":\"list-disc list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":[\"$\",\"$L40\",\"a-0\",{\"href\":\"/items/glowing-wand\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Glowing Wand\"}]}],\" against any enemy team running two or more tanks or bruisers. The passive burns 1.5% Max HP per second, which on a 4000-HP Ruby is real damage you could not otherwise produce. Also applies Lifebane, which cuts their sustain by 50% during your dive window.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":[\"$\",\"$L40\",\"a-0\",{\"href\":\"/items/divine-glaive\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Divine Glaive\"}]}],\" when the enemy is stacking magic defense. A single Athena's Shield or Radiant Armor on their carry is not enough to justify it. Two of those items, or an Oracle, is.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":[\"$\",\"$L40\",\"a-0\",{\"href\":\"/items/ice-queen-wand\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Ice Queen Wand\"}]}],\" against mobile squishies you keep failing to finish: Fanny, Ling, Lancelot. The stacking 10% slow from your skill damage locks them in place for your passive third hit.\"]}],\"\\n\",[\"$\",\"li\",\"li-3\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":[\"$\",\"$L40\",\"a-0\",{\"href\":\"/items/holy-crystal\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Holy Crystal\"}]}],\" as a pure scaling pick in long games past 20 minutes where you need the flat magic power for the burst to keep up with enemy health pools.\"]}],\"\\n\",\"$Laa\",\"\\n\"]}],\"\\n\",\"$Lab\",\"\\n\",\"$Lac\",\"\\n\",\"$Lad\",\"\\n\",\"$Lae\",\"\\n\",\"$Laf\",\"\\n\",\"$Lb0\",\"\\n\",\"$Lb1\",\"\\n\",\"$Lb2\",\"\\n\",\"$Lb3\",\"\\n\",\"$Lb4\",\"\\n\",\"$Lb5\",\"\\n\",\"$Lb6\",\"\\n\",\"$Lb7\"]\n91:[\"$\",\"$Lb8\",null,{\"heroName\":\"Karina\"}]\n"])</script><script>self.__next_f.push([1,"92:[\"$\",\"$L6a\",\"brody\",{\"href\":\"/heroes/brody\",\"className\":\"group block\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative bg-surface-4 border border-mlbb-gold/20 overflow-hidden card-hover hover:border-mlbb-gold/50\",\"style\":{\"boxShadow\":\"0 2px 8px rgba(0,0,0,0.3)\"},\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 p-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative w-14 h-14 rounded-full overflow-hidden flex-shrink-0 bg-surface-3\",\"children\":[\"$\",\"$L6b\",null,{\"src\":\"https://akmweb.youngjoygame.com/web