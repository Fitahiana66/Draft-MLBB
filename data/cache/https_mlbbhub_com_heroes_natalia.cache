\"value\":370,\"sources\":[\"Blade of the Heptaseas\",\"Hunter Strike\",\"Malefic Roar\",\"Blade of Despair\"]},{\"key\":\"adaptiveatk\",\"labelKey\":\"common.stats.adaptiveAttack\",\"unit\":\"flat\",\"group\":\"offensive\",\"value\":60,\"sources\":[\"Sky Piercer\"]},{\"key\":\"physpenFlat\",\"labelKey\":\"common.stats.physicalPenetration\",\"unit\":\"flat\",\"group\":\"offensive\",\"value\":30,\"sources\":[\"Blade of the Heptaseas\",\"Hunter Strike\"]},{\"key\":\"hp\",\"labelKey\":\"common.stats.hp\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":250,\"sources\":[\"Blade of the Heptaseas\"]},{\"key\":\"slowreduction\",\"labelKey\":\"common.stats.slowReduction\",\"unit\":\"percent\",\"group\":\"defensive\",\"value\":35,\"sources\":[\"Rapid Boots\"]},{\"key\":\"movespeed\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"flat\",\"group\":\"utility\",\"value\":70,\"sources\":[\"Rapid Boots\",\"Sky Piercer\"]},{\"key\":\"movespeedPct\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"percent\",\"group\":\"utility\",\"value\":5,\"sources\":[\"Blade of Despair\"]},{\"key\":\"cdreduction\",\"labelKey\":\"common.stats.cooldownReduction\",\"unit\":\"percent\",\"group\":\"utility\",\"value\":10,\"sources\":[\"Hunter Strike\"]}],\"conflicts\":[],\"simulatorUrl\":\"/build-simulator?hero=natalia\u0026items=rapid-boots%2Cblade-of-the-heptaseas%2Csky-piercer%2Chunter-strike%2Cmalefic-roar%2Cblade-of-despair\u0026blessing=dire-hit\u0026spell=execute\u0026emblem=assassin\u0026talents=rupture%2Cmaster-assassin%2Clethal-ignition\u0026flex=tough-boots.rapid-boots%2Cimmortality.blade-of-despair%2Csea-halberd.blade-of-despair\"},{\"slot\":3,\"id\":\"anti-sustain-armor-crack\",\"name\":\"Anti-Sustain Armor Crack\",\"roleContext\":\"Jungle\",\"items\":[{\"slug\":\"swift-boots\",\"name\":\"Swift Boots\",\"cost\":710,\"fixed\":false},{\"slug\":\"blade-of-the-heptaseas\",\"name\":\"Blade of the Heptaseas\",\"cost\":1950,\"fixed\":false},{\"slug\":\"demon-hunter-sword\",\"name\":\"Demon Hunter Sword\",\"cost\":2180,\"fixed\":false},{\"slug\":\"sea-halberd\",\"name\":\"Sea Halberd\",\"cost\":2050,\"fixed\":false},{\"slug\":\"malefic-roar\",\"name\":\"Malefic Roar\",\"cost\":2060,\"fixed\":false},{\"slug\":\"immortality\",\"name\":\"Immortality\",\"cost\":2120,\"fixed\":false}],\"coreItems\":[{\"slug\":\"blade-of-the-heptaseas\",\"name\":\"Blade of the Heptaseas\"},{\"slug\":\"demon-hunter-sword\",\"name\":\"Demon Hunter Sword\"},{\"slug\":\"malefic-roar\",\"name\":\"Malefic Roar\"}],\"emblem\":{\"slug\":\"assassin\",\"name\":\"Assassin Emblem\",\"talents\":[{\"slug\":\"rupture\",\"name\":\"Rupture\",\"iconUrl\":\"/images/talents/rupture.png\",\"bucket\":\"standard\"},{\"slug\":\"seasoned-hunter\",\"name\":\"Seasoned Hunter\",\"iconUrl\":\"/images/talents/seasoned-hunter.png\",\"bucket\":\"standard\"},{\"slug\":\"killing-spree\",\"name\":\"Killing Spree\",\"iconUrl\":\"/images/talents/killing-spree.png\",\"bucket\":\"core\"}]},\"spell\":{\"slug\":\"retribution\",\"name\":\"Retribution\"},\"blessing\":{\"slug\":\"ice-retribution\",\"name\":\"Ice Retribution\"},\"flexItems\":[{\"item\":{\"slug\":\"endless-battle\",\"name\":\"Endless Battle\"},\"replace\":{\"slug\":\"demon-hunter-sword\",\"name\":\"Demon Hunter Sword\"},\"trigger\":\"Use when the enemy backline is still reachable and one empowered basic attack matters more than front-to-back DPS.\"},{\"item\":{\"slug\":\"blade-of-despair\",\"name\":\"Blade of Despair\"},\"replace\":{\"slug\":\"immortality\",\"name\":\"Immortality\"},\"trigger\":\"Use when armor is already cracked and Natalia can convert one more raw damage slot into a backline kill.\"},{\"item\":{\"slug\":\"rose-gold-meteor\",\"name\":\"Rose Gold Meteor\"},\"replace\":{\"slug\":\"immortality\",\"name\":\"Immortality\"},\"trigger\":\"Use against magic burst when the shield and movement burst protect the first exit better than a revive.\"}],\"notes\":\"Anti-sustain jungle setup for drafts where Natalia cannot ignore high-HP fi