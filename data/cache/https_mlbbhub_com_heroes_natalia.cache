oStep\",\"position\":2,\"name\":\"Buy Blade of the Heptaseas\",\"text\":\"Purchase Blade of the Heptaseas (1,950 gold) as item 2 in the Roam Dire Hit Ambush build for Natalia.\",\"url\":\"https://mlbbhub.com/heroes/natalia#build-roam-dire-hit-execution\"},{\"@type\":\"HowToStep\",\"position\":3,\"name\":\"Buy Sky Piercer\",\"text\":\"Purchase Sky Piercer (1,500 gold) as item 3 in the Roam Dire Hit Ambush build for Natalia.\",\"url\":\"https://mlbbhub.com/heroes/natalia#build-roam-dire-hit-execution\"},{\"@type\":\"HowToStep\",\"position\":4,\"name\":\"Buy Hunter Strike\",\"text\":\"Purchase Hunter Strike (2,010 gold) as item 4 in the Roam Dire Hit Ambush build for Natalia.\",\"url\":\"https://mlbbhub.com/heroes/natalia#build-roam-dire-hit-execution\"},{\"@type\":\"HowToStep\",\"position\":5,\"name\":\"Buy Malefic Roar\",\"text\":\"Purchase Malefic Roar (2,060 gold) as item 5 in the Roam Dire Hit Ambush build for Natalia.\",\"url\":\"https://mlbbhub.com/heroes/natalia#build-roam-dire-hit-execution\"},{\"@type\":\"HowToStep\",\"position\":6,\"name\":\"Buy Blade of Despair\",\"text\":\"Purchase Blade of Despair (3,010 gold) as item 6 in the Roam Dire Hit Ambush build for Natalia.\",\"url\":\"https://mlbbhub.com/heroes/natalia#build-roam-dire-hit-execution\"}],\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://mlbbhub.com/heroes/natalia\"},\"datePublished\":\"2026-04-19T00:00:00.000Z\",\"dateModified\":\"2026-08-18T00:00:00.000Z\",\"author\":{\"@type\":\"Organization\",\"name\":\"MLBBHub\",\"url\":\"https://mlbbhub.com\"}}5e:[\"$\",\"script\",\"1\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$63\"}}]\n64:T990,{\"@context\":\"https://schema.org\",\"@type\":\"HowTo\",\"name\":\"How to Build Natalia in Mobile Legends: Anti-Sustain Armor Crack\",\"description\":\"Anti-sustain jungle setup for drafts where Natalia cannot ignore high-HP fighters and must cut healing, armor, and current-HP pools before hunting the carry.\",\"totalTime\":\"PT15M\",\"supply\":[{\"@type\":\"HowToSupply\",\"name\":\"Swift Boots\"},{\"@type\":\"HowToSupply\",\"name\":\"Blade of the Heptaseas\"},{\"@type\":\"HowToSupply\",\"name\":\"Demon Hunter Sword\"},{\"@type\":\"HowToSupply\",\"name\":\"Sea Halberd\"},{\"@type\":\"HowToSupply\",\"name\":\"Malefic Roar\"},{\"@type\":\"HowToSupply\",\"name\":\"Immortality\"}],\"tool\":[{\"@type\":\"HowToTool\",\"name\":\"Assassin Emblem\"},{\"@type\":\"HowToTool\",\"name\":\"Retribution Battle Spell\"}],\"step\":[{\"@type\":\"HowToStep\",\"position\":1,\"name\":\"Buy Swift Boots\",\"text\":\"Purchase Swift Boots (710 gold) as item 1 in the Anti-Sustain Armor Crack build for Natalia.\",\"url\":\"https://mlbbhub.com/heroes/natalia#build-anti-sustain-armor-crack\"},{\"@type\":\"HowToStep\",\"position\":2,\"name\":\"Buy Blade of the Heptaseas\",\"text\":\"Purchase Blade of the Heptaseas (1,950 gold) as item 2 in the Anti-Sustain Armor Crack build for Natalia.\",\"url\":\"https://mlbbhub.com/heroes/natalia#build-anti-sustain-armor-crack\"},{\"@type\":\"HowToStep\",\"position\":3,\"name\":\"Buy Demon Hunter Sword\",\"text\":\"Purchase Demon Hunter Sword (2,180 gold) as item 3 in the Anti-Sustain Armor Crack build for Natalia.\",\"url\":\"https://mlbbhub.com/heroes/natalia#build-anti-sustain-armor-crack\"},{\"@type\":\"HowToStep\",\"position\":4,\"name\":\"Buy Sea Halberd\",\"text\":\"Purchase Sea Halberd (2,050 gold) as item 4 in the Anti-Sustain Armor Crack build for Natalia.\",\"url\":\"https://mlbbhub.com/heroes/natalia#build-anti-sustain-armor-crack\"},{\"@type\":\"HowToStep\",\"position\":5,\"name\":\"Buy Malefic Roar\",\"text\":\"Purchase Malefic Roar (2,060 gold) as item 5 in the Anti-Sustain Armor Crack build for Natalia.\",\"url\":\"https://mlbbhub.com/heroes/natalia#build-anti-sustain-armor-crack\"},{\"@type\":\"HowToStep\",\"position\":6,\"name\":\"Buy Immortality\",\"text\":\"Purchase Immortality (2,120 gold) as item 6 in the Anti-Sustain Armor Crack build for Natalia.\",\"url\":\"https://mlbbhub.com/heroes/natalia#build-anti-sustain-armor-crack\"}],\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://mlbbhub.com/heroes/natalia\"},\"datePublished\":\"2026-04-19T00:00:00.000Z\",\"dateModified\":\"2026-08-18T00:00:00.000Z\",\"author\":{\"@type\":\"Organization\",\"name\":\"MLBBHub\",\"url\":\"https://mlbbhub.com\"}}5f:[\"$\",\"script\",\"2\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$64\"}}]\n60:[\"$\",\"$L65\",null,{\"hero\":{\"id\":24,\"name\":\"Natalia\",\"slug\":\"natalia\",\"title\":\"Bright Claw\",\"role\":[\"Assassin\"],\"specialty\":[\"Chase\",\"Finisher\"],\"lane\":[\"Jungle\",\"Roam\"],\"tier\":\"B\",\"difficulty\":3,\"releaseYear\":2016,\"stats\":{\"durability\":10,\"offense\":60,\"controlEffect\":60,\"difficulty\":90},\"winRate\":51.08,\"pickRate\":0.25,\"banRate\":1.29,\"counters\":{\"strongAgainst\":[{\"heroSlug\":\"novaria\",\"heroName\":\"Novaria\",\"advantage\":\"strong\",\"tip\":\"Natalia counters squishy heroes who lack CC and burst like as Novaria and Irithel since they can't stop Natalia's burst damage.\"},{\"heroSlug\":\"irithel\",\"heroName\":\"Irithel\",\"advantage\":\"strong\",\"tip\":\"Natalia counters squishy heroes who lack CC and burst like as Novaria and Irithel since they can't stop Natalia's burst damage.\"}],\"weakAgainst\":[{\"heroSlug\":\"minsitthar\",\"heroName\":\"Minsitthar\",\"advantage\":\"weak\",\"tip\":\"Natalia is countered by heroes who can restrict her mobility like Minsitthar and Kaja since they can easily shutdown her main advantage.\"},{\"heroSlug\":\"kaja\",\"heroName\":\"Kaja\",\"advantage\":\"weak\",\"tip\":\"Natalia is countered by heroes who can restrict her mobility like Minsitthar and Kaja since they can easily shutdown her main advantage.\"}]},\"splashArt\":\"https://akmweb.youngjoygame.com/web/svnres/file/mlbb/homepage/100_79e90c124d786bbfdae31f3a28827e7d.jpg\",\"portrait\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_fbb5065b6ff174d1a20ccf5b7f523514.png\",\"officialMatchups\":[{\"kind\":\"best_ally\",\"heroId\":\"3\",\"heroName\":\"Saber\",\"heroSlug\":\"saber\",\"icon\":\"https://akmweb.youngjoygame.com/web/madmin/image/35a5d68d1704e2c4c6323abd4859a622.jpg?w=100-100-4b3f67\",\"tip\":\"Saber and Chou can cause a Stun effect on the target or Cyclops which can lock the target to stay in position, then continue with Silencing for 2 seconds from Natalia, resulting in a deadly combo to hunt down opponents who don't suspect our presence.\"},{\"kind\":\"counters\",\"heroId\":\"13\",\"heroName\":\"Clint\",\"heroSlug\":\"clint\",\"icon\":\"https://akmwebstatic.yuanzhanapp.com/web/madmin/image_324e2b04393700944b2b54f2f6c939b5.jpg\",\"tip\":\"Generally, Marksman is Natalia's main food, except for Miya who has the Ultimate Skill which works like Purify to neutralize the effects of Silence from Natalia. Likewise with Irithel who has an AoE Skill and a Basic Attack that will become AoE when the Ultimate Skill is active, this will easily show where Natalia is hiding.\"},{\"kind\":\"countered_by\",\"heroId\":\"30\",\"heroName\":\"Yi Sun-shin\",\"heroSlug\":\"yi-sun-shin\",\"icon\":\"https://akmwebstatic.yuanzhanapp.com/web/madmin/image_1b5d6197b9e0e82e606b3cf962804fa5.jpg\",\"tip\":\"Yi Sun-Shin's Ultimate Skill can notify Natalia’s whereabouts, not only eliminating her Invisibility at crucial times in Team Fight, but also continuously informing her teammates about Natalia's presence, so that the entire team gets information about the paths that are passed by Natalia.\"}],\"skills\":{\"skills\":[{\"name\":\"Assassin Instinct\",\"type\":\"Passive\",\"description\":\"If Natalia stays in a bush without taking damage for 1s, she will enter Camouflage state and gain 15% Movement Speed. In this state, Natalia's next Basic Attack will teleport her behind her target and deal 200 (+110% Total Physical Attack) Physical Damage while silencing the target for 0.25s.\\n\\nDealing damage, taking damage or using skills will immediately end the Camouflage state, but her next Basic Attack will remain enhanced for another 1s.\\n\\nNatalia's base Crit Damage is reduced to 150%, but her damage to Creeps is increased to 150%.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"If Natalia stays in a bush without taking damage for 1s, she will enter \"},{\"type\":\"text\",\"text\":\"Camouflage\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" state and gain 15% Movement Speed. In this state, Natalia's next Basic Attack will teleport her behind her target and deal 200\"},{\"type\":\"text\",\"text\":\" (+110% Total Physical Attack)\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Physical Damage\",\"color\":\"#fb1f1f\"},{\"type\":\"text\",\"text\":\" while silencing the target for 0.25s.\\n\\nDealing damage, taking damage or using skills will immediately end the \"},{\"type\":\"text\",\"text\":\"Camouflage\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" state, but her next Basic Attack will remain enhanced for another 1s.\\n\\nNatalia's base Crit Damage is reduced to 150%, but her damage to Creeps is increased to 150%.\"}],\"cooldown\":null,\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_70c63dbf8a6c5f7c13e000e50cb45048.png\",\"tags\":[\"Buff\"]},{\"name\":\"Claw Dash\",\"type\":\"Skill 1\",\"description\":\"Natalia dashes in the target direction, dealing 250 (+50% Total Physical Attack) Physical Damage to enemies in her path.\\n\\nAfter hitting an enemy, she can cast this skill again within 5s.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Natalia dashes in the target direction, dealing 250\"},{\"type\":\"text\",\"text\":\" (+50% Total Physical Attack)\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Physical Damage\",\"color\":\"#fb1f1f\"},{\"type\":\"text\",\"text\":\" to enemies in her path.\\n\\nAfter hitting an enemy, she can cast this skill again within 5s.\"}],\"cooldown\":\"10s\",\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_9fe9f13f142891ef055c36a9c5fe8e56.png\",\"tags\":[\"Mobility\",\"AOE\"]},{\"name\":\"Smoke Bomb\",\"type\":\"Skill 2\",\"description\":\"Natalia releases a Smoke Bomb at her location, slowing enemies within by 25% while Natalia becomes immune to enemy Basic Attacks for 4s.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Natalia releases a \"},{\"type\":\"text\",\"text\":\"Smoke Bomb\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" at her location, slowing enemies within by 25% while Natalia becomes immune to enemy Basic Attacks for 4s.\"}],\"cooldown\":\"12s\",\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_b2dc19263463a18f2a7706ff9ceb90d9.png\",\"tags\":[\"Buff\",\"Slow\"]},{\"name\":\"The Hunt\",\"type\":\"Ultimate\",\"description\":\"Passive: Natalia gains 15% Crit Chance.\\n\\nActive: Natalia immediately enters the Assassin Instinct state. She can store up to 2 Ultimate charges, and each charge has a recharge time of 30s. Killing creeps reduces the remaining recharge time by 50% of the full recharge time.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Passive\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\": Natalia gains 15% Crit Chance.\\n\\n\"},{\"type\":\"text\",\"text\":\"Active\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\": Natalia immediately enters the \"},{\"type\":\"text\",\"text\":\"Assassin Instinct\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" state. She can store up to 2 Ultimate charges, and each charge has a recharge time of 30s. Killing creeps reduces the remaining recharge time by 50% of the full recharge time.\"}],\"cooldown\":\"3s\",\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_a505102cf3c9127d94b3fa4ae5de6734.png\",\"tags\":[\"Buff\"]}],\"skillUpgradePriority\":\"3-1-2\",\"skillPriorityTip\":\"Although Claw Dash and Natalia's Ultimate Skill did not give a massive damage as much as the other Assassins (because Natalia relies more on Basic Attack), don't underestimate the Damage of these 2 Skills, because these two Skills are very good at securing opponents who want to escape.\\nTo make it easier for Jungling and also taking the opponent's Jungle Monster, to prevent opponents from Jungling. Using Retribution when Stealth will not eliminate your Invisibility, which is why this is a very good way to get a Jungle Monster.\",\"skillPriorityTipRich\":[{\"type\":\"text\",\"text\":\"Although Claw Dash and Natalia's Ultimate Skill did not give a massive damage as much as the other Assassins (because Natalia relies more on Basic Attack), don't underestimate the Damage of these 2 Skills, because these two Skills are very good at securing opponents who want to escape.\"},{\"type\":\"lineBreak\"},{\"type\":\"text\",\"text\":\"To make it easier for Jungling and also taking the opponent's Jungle Monster, to prevent opponents from Jungling. Using Retribution when Stealth will not eliminate your Invisibility, which is why this is a very good way to get a Jungle Monster.\"}]},\"synergies\":[{\"heroSlug\":\"yi-sun-shin\",\"heroName\":\"Yi Sun-shin\",\"synergyScore\":8,\"reason\":\"Natalia works best with heroes with high AOE damage such as Yi Sun-shin and Vexana. She can stay hidden while they poke the enemy, then pounce on targets that get low on HP.\"},{\"heroSlug\":\"vexana\",\"heroName\":\"Vexana\",\"synergyScore\":8,\"reason\":\"Natalia works best with heroes with high AOE damage such as Yi Sun-shin and Vexana. She can stay hidden while they poke the enemy, then pounce on targets that get low on HP.\"}],\"combos\":[{\"type\":\"teamfight\",\"title\":\"TEAMFIGHT COMBOS\",\"description\":\"In teamfights, use Natalia's Passive and enhanced Basic Attacks to approach enemies, then use her 2nd Skill to improve her survivability. Follow up with her 1st Skill then Ultimate and end with a Basic Attack to finish off the enemy.\",\"skillSequence\":[{\"skillId\":2400,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_f98d2e98eaebfb31c6c5101cf1c3201a.png\"},{\"skillId\":2420,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_b2dc19263463a18f2a7706ff9ceb90d9.png\"},{\"skillId\":2410,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_9fe9f13f142891ef055c36a9c5fe8e56.png\"},{\"skillId\":2430,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_a505102cf3c9127d94b3fa4ae5de6734.png\"},{\"skillId\":2400,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_f98d2e98eaebfb31c6c5101cf1c3201a.png\"},{\"skillId\":2410,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_9fe9f13f142891ef055c36a9c5fe8e56.png\"},{\"skillId\":2430,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_a505102cf3c9127d94b3fa4ae5de6734.png\"}]},{\"type\":\"laning\",\"title\":\"LANING COMBOS\",\"description\":\"When ganking, hide in a bush to activate Natalia's Passive, then approach the enemy from behind and blink to them with the enhanced Basic Attack. Follow up with her 2nd Skill to slow the enemy and chase after them using her 1st Skill.\",\"skillSequence\":[{\"skillId\":2400,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_f98d2e98eaebfb31c6c5101cf1c3201a.png\"},{\"skillId\":2420,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_b2dc19263463a18f2a7706ff9ceb90d9.png\"},{\"skillId\":2410,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_9fe9f13f142891ef055c36a9c5fe8e56.png\"},{\"skillId\":2410,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_9fe9f13f142891ef055c36a9c5fe8e56.png\"}]}],\"metaDescription\":\"Natalia MLBB build, counter, and strategy guide. Blade of the Heptaseas power spike, stealth approach, and when not to pick her against CC-heavy drafts.\",\"builds\":[],\"overviewLede\":\"Natalia is not a jungler you draft for raw damage output. She is a pressure system: enemies who ordinarily walk the map alone now need escorts, and carries who stand at the edge of vision start hugging their tower instead. That psychological weight disappears the moment a Franco hook or a Saber spin enters the picture.\"},\"serverLocale\":\"en\",\"curatedBuilds\":{\"source\":\"curated\",\"hero\":\"natalia\",\"patch\":\"2.1.67\",\"lastReviewed\":\"2026-08-18\",\"stalePatch\":true,\"currentPatch\":\"2.2.16a\",\"builds\":[{\"slot\":1,\"id\":\"jungle-pickoff-default\",\"name\":\"Jungle Pickoff Default\",\"roleContext\":\"Jungle\",\"items\":[{\"slug\":\"swift-boots\",\"name\":\"Swift Boots\",\"cost\":710,\"fixed\":false},{\"slug\":\"blade-of-the-heptaseas\",\"name\":\"Blade of the Heptaseas\",\"cost\":1950,\"fixed\":false},{\"slug\":\"endless-battle\",\"name\":\"Endless Battle\",\"cost\":2330,\"fixed\":false},{\"slug\":\"hunter-strike\",\"name\":\"Hunter Strike\",\"cost\":2010,\"fixed\":false},{\"slug\":\"malefic-roar\",\"name\":\"Malefic Roar\",\"cost\":2060,\"fixed\":false},{\"slug\":\"immortality\",\"name\":\"Immortality\",\"cost\":2120,\"fixed\":false}],\"coreItems\":[{\"slug\":\"blade-of-the-heptaseas\",\"name\":\"Blade of the Heptaseas\"},{\"slug\":\"endless-battle\",\"name\":\"Endless Battle\"},{\"slug\":\"hunter-strike\",\"name\":\"Hunter Strike\"}],\"emblem\":{\"slug\":\"assassin\",\"name\":\"Assassin Emblem\",\"talents\":[{\"slug\":\"rupture\",\"name\":\"Rupture\",\"iconUrl\":\"/images/talents/rupture.png\",\"bucket\":\"standard\"},{\"slug\":\"seasoned-hunter\",\"name\":\"Seasoned Hunter\",\"iconUrl\":\"/images/talents/seasoned-hunter.png\",\"bucket\":\"standard\"},{\"slug\":\"killing-spree\",\"name\":\"Killing Spree\",\"iconUrl\":\"/images/talents/killing-spree.png\",\"bucket\":\"core\"}]},\"spell\":{\"slug\":\"retribution\",\"name\":\"Retribution\"},\"blessing\":{\"slug\":\"ice-retribution\",\"name\":\"Ice Retribution\"},\"flexItems\":[{\"item\":{\"slug\":\"tough-boots\",\"name\":\"Tough Boots\"},\"replace\":{\"slug\":\"swift-boots\",\"name\":\"Swift Boots\"},\"trigger\":\"Use when chain crowd control is the main reason Natalia cannot leave after the stealth auto.\"},{\"item\":{\"slug\":\"blade-of-despair\",\"name\":\"Blade of Despair\"},\"replace\":{\"slug\":\"immortality\",\"name\":\"Immortality\"},\"trigger\":\"Use while ahead against low-control drafts where the next backline kill ends the fight.\"},{\"item\":{\"slug\":\"sea-halberd\",\"name\":\"Sea Halberd\"},\"replace\":{\"slug\":\"immortality\",\"name\":\"Immortality\"},\"trigger\":\"Use when healing, shields, or high-extra-HP fighters keep the marked target above kill range.\"}],\"notes\":\"Default jungle setup for farming a clean Heptaseas and Endless Battle ambush window, then using Ice Retribution and Hunter Strike movement to keep one carry trapped.\",\"totalCost\":11180,\"statLines\":[{\"key\":\"physatk\",\"labelKey\":\"common.stats.physicalAttack\",\"unit\":\"flat\",\"group\":\"offensive\",\"value\":270,\"sources\":[\"Blade of the Heptaseas\",\"Endless Battle\",\"Hunter Strike\",\"Malefic Roar\"]},{\"key\":\"attackspeed\",\"labelKey\":\"common.stats.attackSpeed\",\"unit\":\"percent\",\"group\":\"offensive\",\"value\":15,\"sources\":[\"Swift Boots\"]},{\"key\":\"physpenFlat\",\"labelKey\":\"common.stats.physicalPenetration\",\"unit\":\"flat\",\"group\":\"offensive\",\"value\":30,\"sources\":[\"Blade of the Heptaseas\",\"Hunter Strike\"]},{\"key\":\"hybridsteal\",\"labelKey\":\"common.stats.hybridLifesteal\",\"unit\":\"percent\",\"group\":\"offensive\",\"value\":8,\"so