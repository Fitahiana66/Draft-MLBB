roes/gusion#build-mid-execute-burst\"},{\"@type\":\"HowToStep\",\"position\":6,\"name\":\"Buy Blood Wings\",\"text\":\"Purchase Blood Wings (2,100 gold) as item 6 in the Mid Execute Burst build for Gusion.\",\"url\":\"https://mlbbhub.com/heroes/gusion#build-mid-execute-burst\"}],\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://mlbbhub.com/heroes/gusion\"},\"datePublished\":\"2026-04-12T00:00:00.000Z\",\"dateModified\":\"2026-05-13T00:00:00.000Z\",\"author\":{\"@type\":\"Organization\",\"name\":\"MLBBHub\",\"url\":\"https://mlbbhub.com\"}}5f:[\"$\",\"script\",\"1\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$63\"}}]\n64:T927,{\"@context\":\"https://schema.org\",\"@type\":\"HowTo\",\"name\":\"How to Build Gusion in Mobile Legends: Jungle Snowball Execute\",\"description\":\"High-risk jungle setup for games where Gusion wins the first rotation and can convert early kills into Sky Piercer pressure.\",\"totalTime\":\"PT15M\",\"supply\":[{\"@type\":\"HowToSupply\",\"name\":\"Arcane Boots\"},{\"@type\":\"HowToSupply\",\"name\":\"Genius Wand\"},{\"@type\":\"HowToSupply\",\"name\":\"Sky Piercer\"},{\"@type\":\"HowToSupply\",\"name\":\"Holy Crystal\"},{\"@type\":\"HowToSupply\",\"name\":\"Divine Glaive\"},{\"@type\":\"HowToSupply\",\"name\":\"Blood Wings\"}],\"tool\":[{\"@type\":\"HowToTool\",\"name\":\"Assassin Emblem\"},{\"@type\":\"HowToTool\",\"name\":\"Retribution Battle Spell\"}],\"step\":[{\"@type\":\"HowToStep\",\"position\":1,\"name\":\"Buy Arcane Boots\",\"text\":\"Purchase Arcane Boots (690 gold) as item 1 in the Jungle Snowball Execute build for Gusion.\",\"url\":\"https://mlbbhub.com/heroes/gusion#build-jungle-snowball-execute\"},{\"@type\":\"HowToStep\",\"position\":2,\"name\":\"Buy Genius Wand\",\"text\":\"Purchase Genius Wand (2,000 gold) as item 2 in the Jungle Snowball Execute build for Gusion.\",\"url\":\"https://mlbbhub.com/heroes/gusion#build-jungle-snowball-execute\"},{\"@type\":\"HowToStep\",\"position\":3,\"name\":\"Buy Sky Piercer\",\"text\":\"Purchase Sky Piercer (1,500 gold) as item 3 in the Jungle Snowball Execute build for Gusion.\",\"url\":\"https://mlbbhub.com/heroes/gusion#build-jungle-snowball-execute\"},{\"@type\":\"HowToStep\",\"position\":4,\"name\":\"Buy Holy Crystal\",\"text\":\"Purchase Holy Crystal (3,000 gold) as item 4 in the Jungle Snowball Execute build for Gusion.\",\"url\":\"https://mlbbhub.com/heroes/gusion#build-jungle-snowball-execute\"},{\"@type\":\"HowToStep\",\"position\":5,\"name\":\"Buy Divine Glaive\",\"text\":\"Purchase Divine Glaive (1,970 gold) as item 5 in the Jungle Snowball Execute build for Gusion.\",\"url\":\"https://mlbbhub.com/heroes/gusion#build-jungle-snowball-execute\"},{\"@type\":\"HowToStep\",\"position\":6,\"name\":\"Buy Blood Wings\",\"text\":\"Purchase Blood Wings (2,100 gold) as item 6 in the Jungle Snowball Execute build for Gusion.\",\"url\":\"https://mlbbhub.com/heroes/gusion#build-jungle-snowball-execute\"}],\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://mlbbhub.com/heroes/gusion\"},\"datePublished\":\"2026-04-12T00:00:00.000Z\",\"dateModified\":\"2026-05-13T00:00:00.000Z\",\"author\":{\"@type\":\"Organization\",\"name\":\"MLBBHub\",\"url\":\"https://mlbbhub.com\"}}60:[\"$\",\"script\",\"2\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$64\"}}]\n61:[\"$\",\"$L65\",null,{\"hero\":{\"id\":56,\"name\":\"Gusion\",\"slug\":\"gusion\",\"title\":\"Holy Blade\",\"role\":[\"Assassin\"],\"specialty\":[\"Burst\",\"Magic Damage\"],\"lane\":[\"Jungle\"],\"tier\":\"C\",\"difficulty\":3,\"releaseYear\":2018,\"stats\":{\"durability\":30,\"offense\":90,\"controlEffect\":10,\"difficulty\":80},\"winRate\":48.02,\"pickRate\":1.42,\"banRate\":4.16,\"counters\":{\"strongAgainst\":[{\"heroSlug\":\"layla\",\"heroName\":\"Layla\",\"advantage\":\"strong\",\"tip\":\"Gusion is strong against squishy heroes who lack movement abilities, so that Gusion can easily chase them down. Like Layla and Hanabi.\"},{\"heroSlug\":\"hanabi\",\"heroName\":\"Hanabi\",\"advantage\":\"strong\",\"tip\":\"Gusion is strong against squishy heroes who lack movement abilities, so that Gusion can easily chase them down. Like Layla and Hanabi.\"}],\"weakAgainst\":[{\"heroSlug\":\"franco\",\"heroName\":\"Franco\",\"advantage\":\"weak\",\"tip\":\"Gusion is countered by tank heroes with good single-target CC. Once controlled by them, Gusion will have a hard time escaping. Such as Franco and Kaja.\"},{\"heroSlug\":\"kaja\",\"heroName\":\"Kaja\",\"advantage\":\"weak\",\"tip\":\"Gusion is countered by tank heroes with good single-target CC. Once controlled by them, Gusion will have a hard time escaping. Such as Franco and Kaja.\"}]},\"splashArt\":\"https://akmweb.youngjoygame.com/web/gms/image/a888de3fe448be8f29b50a62d0193aaf.jpg\",\"portrait\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_c6cd232de60da5372a7101a203e56554.png\",\"officialMatchups\":[{\"kind\":\"best_ally\",\"heroId\":\"55\",\"heroName\":\"Angela\",\"heroSlug\":\"angela\",\"icon\":\"https://akmwebstatic.yuanzhanapp.com/web/madmin/image_feffcc9c39731586e645dbef2ce70afd.png\",\"tip\":\"Angela’s “Heartguard” can improve the Durability of Gusion. This will help Gusion to deal damage to enemies after he dash into the battle.\"},{\"kind\":\"counters\",\"heroId\":\"52\",\"heroName\":\"Pharsa\",\"heroSlug\":\"pharsa\",\"icon\":\"https://akmwebstatic.yuanzhanapp.com/web/madmin/image_212e59ee7c8490397278ba68c8063a19.png\",\"tip\":\"It is hard for Pharsa to escape from Gusion. Even though Pharsa use “Wings by Wings”, Gusion can catch and execute Pharsa by using “Sword Spike” and “Incandescence”.\"},{\"kind\":\"countered_by\",\"heroId\":\"20\",\"heroName\":\"Lolita\",\"heroSlug\":\"lolita\",\"icon\":\"https://akmwebstatic.yuanzhanapp.com/web/madmin/image_007ce553513122fdab39684dbbe215e3.png\",\"tip\":\"Gusion’s daggers of “Sword Spike”and “Shadowblade Slaughter” will be counteracted by the shield provided by Lolita’s “Guardian's Bulwark”. This will largely lower the damage Gusion deal to his enemies.\"}],\"skills\":{\"skills\":[{\"name\":\"Dagger Specialist\",\"type\":\"Passive\",\"description\":\"Each skill cast adds a rune to Gusion's dagger (stacks up to 4 times). Each stack enhances Gusion's next Basic Attack to deal additional damage equal to 3% of the target's Max HP and recover 50 (+25% Total Magic Power) HP for himself.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Each skill cast adds a rune to Gusion's dagger (stacks up to 4 times). Each stack enhances Gusion's next Basic Attack to deal additional damage equal to 3% of the target's Max HP and recover 50\"},{\"type\":\"text\",\"text\":\" (+25% Total Magic Power)\",\"color\":\"#62f8fe\"},{\"type\":\"text\",\"text\":\" HP for himself.\"}],\"cooldown\":null,\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_dd599ad04fa456a864ea1e34e14d7739.png\",\"tags\":[\"Buff\",\"Heal\"]},{\"name\":\"Sword Spike\",\"type\":\"Skill 1\",\"description\":\"Gusion throws a dagger in the target direction, dealing 200 (+50% Total Magic Power) Magic Damage to the first enemy hit and marking them.\\n\\nUse Again: Gusion moves behind the marked enemy, dealing 200 (+100% Total Magic Power) Magic Damage to them. This skill cannot be interrupted while Gusion is moving behind the marked enemy.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Gusion throws a dagger in the target direction, dealing 200\"},{\"type\":\"text\",\"text\":\" (+50% Total Magic Power)\",\"color\":\"#62f8fe\"},{\"type\":\"text\",\"text\":\" Magic Damage to the first enemy hit and marking them.\\n\\n\"},{\"type\":\"text\",\"text\":\"Use Again\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\": Gusion moves behind the marked enemy, dealing 200\"},{\"type\":\"text\",\"text\":\" (+100% Total Magic Power)\",\"color\":\"#62f8fe\"},{\"type\":\"text\",\"text\":\" Magic Damage to them. This skill cannot be interrupted while Gusion is moving behind the marked enemy.\"}],\"cooldown\":\"9s\",\"manaCost\":\"50\",\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_3c2d474c18f5d10925a4c732992df352.png\",\"tags\":[\"Damage\",\"Mobility\"]},{\"name\":\"Shadowblade Slaughter\",\"type\":\"Skill 2\",\"description\":\"Gusion throws a volley of daggers in the target direction, each dealing 100 (+40% Total Magic Power) Magic Damage to enemies hit and slowing them by 6% for 2s (when hit by multiple daggers, the slow effect can stack up to 30%).\\n\\nUse Again: Gusion recalls the daggers, each dealing 65 (+40% Total Magic Power) Magic Damage to enemies in its path.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Gusion throws a volley of daggers in the target direction, each dealing 100\"},{\"type\":\"text\",\"text\":\" (+40% Total Magic Power)\",\"color\":\"#62f8fe\"},{\"type\":\"text\",\"text\":\" Magic Damage to enemies hit and slowing them by 6% for 2s (when hit by multiple daggers, the slow effect can stack up to 30%).\\n\\n\"},{\"type\":\"text\",\"text\":\"Use Again\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\": Gusion recalls the daggers, each dealing 65\"},{\"type\":\"text\",\"text\":\" (+40% Total Magic Power)\",\"color\":\"#62f8fe\"},{\"type\":\"text\",\"text\":\" Magic Damage to enemies in its path.\"}],\"cooldown\":\"9s\",\"manaCost\":\"60\",\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_40bc6e5205c84fb8cd337031ca8480d0.png\",\"tags\":[\"AOE\",\"Slow\"]},{\"name\":\"Incandescence\",\"type\":\"Ultimate\",\"description\":\"Gusion dashes to the target location, resetting the cooldowns of Sword Spike and Shadowblade Slaughter. If Shadowblade Slaughter was cast once before the reset, Gusion can throw another five daggers on his next Shadowblade Slaughter cast, and recall a total of ten daggers afterward.\\n\\nUse Again: Gusion dashes a short distance in the target direction.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Gusion dashes to the target location, resetting the cooldowns of \"},{\"type\":\"text\",\"text\":\"Sword Spike\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" and \"},{\"type\":\"text\",\"text\":\"Shadowblade Slaughter\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\". If \"},{\"type\":\"text\",\"text\":\"Shadowblade Slaughter\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" was cast once before the reset, Gusion can throw another five daggers on his next \"},{\"type\":\"text\",\"text\":\"Shadowblade Slaughter\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" cast, and recall a total of ten daggers afterward.\\n\\n\"},{\"type\":\"text\",\"text\":\"Use Again\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\": Gusion dashes a short distance in the target direction.\"}],\"cooldown\":\"24s\",\"manaCost\":\"100\",\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_6ffa279a397359b614e8acecde38c0bb.png\",\"tags\":[\"Mobility\",\"Buff\"]}],\"skillUpgradePriority\":\"3-2-1\",\"skillPriorityTip\":\"Max 2nd Skill.\\nRetribution - This is an essential spell for smooth jungling.\",\"skillPriorityTipRich\":[{\"type\":\"text\",\"text\":\"Max 2nd Skill.\"},{\"type\":\"lineBreak\"},{\"type\":\"text\",\"text\":\"Retribution - This is an essential spell for smooth jungling.\"}]},\"synergies\":[{\"heroSlug\":\"vexana\",\"heroName\":\"Vexana\",\"synergyScore\":8,\"reason\":\"Gusion works well with heroes with strong opening CC, which will allow him to hit the target more easily with his 1st Skill, such as Vexana and Pharsa.\"},{\"heroSlug\":\"pharsa\",\"heroName\":\"Pharsa\",\"synergyScore\":8,\"reason\":\"Gusion works well with heroes with strong opening CC, which will allow him to hit the target more easily with his 1st Skill, such as Vexana and Pharsa.\"}],\"combos\":[{\"type\":\"teamfight\",\"title\":\"TEAMFIGHT COMBOS\",\"description\":\"In teamfights, Gusion should first use his 2nd Skill for damage, then his Ultimate to reset the cooldown for his 2nd Skill. Follow up with his 2nd and 1st Skill combo for more damage. And use his 2nd Skill again to recall all 10 daggers right after moving behind a target with his 1st Skill for massive damage. He can then finish off any remaining low-HP heroes and escape with his Ultimate.\",\"skillSequence\":[{\"skillId\":5620,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_40bc6e5205c84fb8cd337031ca8480d0.png\"},{\"skillId\":5630,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_6ffa279a397359b614e8acecde38c0bb.png\"},{\"skillId\":5620,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_40bc6e5205c84fb8cd337031ca8480d0.png\"},{\"skillId\":5610,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_3c2d474c18f5d10925a4c732992df352.png\"},{\"skillId\":5610,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_3c2d474c18f5d10925a4c732992df352.png\"},{\"skillId\":5620,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_40bc6e5205c84fb8cd337031ca8480d0.png\"},{\"skillId\":5600,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_f98d2e98eaebfb31c6c5101cf1c3201a.png\"}]},{\"type\":\"laning\",\"title\":\"LANING COMBOS\",\"description\":\"In the laning phase, Gusion can use his 1st Skill to mark the enemies, then use his 2nd Skill to slow them down. Next, he can use his 1st Skill again to move behind a target enemy and use his 2nd Skill again to deal massive damage. And finally, use his Basic Attacks to finish off the target.\",\"skillSequence\":[{\"skillId\":5610,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_3c2d474c18f5d10925a4c732992df352.png\"},{\"skillId\":5620,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_40bc6e5205c84fb8cd337031ca8480d0.png\"},{\"skillId\":5610,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_3c2d474c18f5d10925a4c732992df352.png\"},{\"skillId\":5620,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_40bc6e5205c84fb8cd337031ca8480d0.png\"},{\"skillId\":5600,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_f98d2e98eaebfb31c6c5101cf1c3201a.png\"}]}],\"metaDescription\":\"Gusion build and counter guide for Mobile Legends. One-second combo execution, the magic-pen spike timing, and the drafts and mistakes that decide games.\",\"builds\":[],\"overviewLede\":\"Gusion is a one-second assassin. The window between \\\"target alive\\\" and \\\"target dead\\\" is shorter on Gusion than on any other hero in the game, and that speed is the entire point. Outside the combo window, he is a magic-damage assassin with one slow and one single-target blink.\"},\"serverLocale\":\"en\",\"curatedBuilds\":{\"source\":\"curated\",\"hero\":\"gusion\",\"patch\":\"2.1.67\",\"lastReviewed\":\"2026-05-13\",\"stalePatch\":true,\"currentPatch\":\"2.2.16a\",\"builds\":[{\"slot\":1,\"id\":\"jungle-burst-default\",\"name\":\"Jungle Burst Default\",\"roleContext\":\"Jungle\",\"items\":[{\"slug\":\"arcane-boots\",\"name\":\"Arcane Boots\",\"cost\":690,\"fixed\":false},{\"slug\":\"genius-wand\",\"name\":\"Genius Wand\",\"cost\":2000,\"fixed\":false},{\"slug\":\"holy-crystal\",\"name\":\"Holy Crystal\",\"cost\":3000,\"fixed\":false},{\"slug\":\"divine-glaive\",\"name\":\"Divine Glaive\",\"cost\":1970,\"fixed\":false},{\"slug\":\"blood-wings\",\"name\":\"Blood Wings\",\"cost\":2100,\"fixed\":false},{\"slug\":\"winter-crown\",\"name\":\"Winter Crown\",\"cost\":1910,\"fixed\":false}],\"coreItems\":[{\"slug\":\"genius-wand\",\"name\":\"Genius Wand\"}