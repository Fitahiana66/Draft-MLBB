assName\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#B07ECC\",\"background\":\"#B07ECC1a\",\"border\":\"1px solid #B07ECC40\"},\"children\":\"Epic\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Gusion\",\"rank\":\"Epic\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=epic\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Epic\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Epic\",\"name\":\"Gusion\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"48.77\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Gusion\",\"delta\":\"+0.44%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"1.19\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"6.38\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Epic\"}}]]}]]}],[\"$\",\"article\",\"legend\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #4dc9f6, #4dc9f633)\",\"boxShadow\":\"0 0 12px -2px #4dc9f680\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#4dc9f6\",\"background\":\"#4dc9f61a\",\"border\":\"1px solid #4dc9f640\"},\"children\":\"Legend\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Gusion\",\"rank\":\"Legend\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=legend\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Legend\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Legend\",\"name\":\"Gusion\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"48.23\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Gusion\",\"delta\":\"-0.10%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"1.55\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"5.51\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Legend\"}}]]}]]}],[\"$\",\"article\",\"mythic\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[\"$La5\",\"$La6\",\"$La7\"]}],\"$La8\",\"$La9\"]}]\n7e:[\"$\",\"h2\",\"h2-1\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The one thing that makes Gusion work\"]}]\n7f:[\"$\",\"p\",\"p-4\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Gusion is a cooldown-reset assassin. His ult, Incandescence, deals zero damage. It resets the cooldowns of S1 and S2, and that reset is the entire hero.\"}]\n80:[\"$\",\"p\",\"p-5\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The combo works like this: S1 throws a dagger that marks the first enemy hit. S2 throws a fan of daggers that each deal magic damage and slow. Then Incandescence resets both, and now S1 is available again. You throw the second dagger to mark, recast S1 to teleport behind the target, and recast S2 in the same beat to recall every dagger back through their position. Each dagger hits twice (throw plus recall), the S1 teleport carries its own damage on top, and the passive Dagger Specialist adds bonus max-HP damage to a basic attack you weave between casts.\"}]\n81:[\"$\",\"p\",\"p-6\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Executed clean, the entire sequence resolves in under 1.5 seconds. The target reads \\\"Gusion appeared\\\" and \\\"I am dead\\\" as the same event. The passive heal on the woven basic attack is the only sustain in the kit, and it is what lets a Gusion who lands the combo immediately rotate to the next fight instead of recalling.\"}]\n82:[\"$\",\"p\",\"p-7\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Every part of the kit serves the combo. Nothing in the kit is useful outside of it. If the combo does not kill, Gusion is standing next to a furious enemy with every ability on cooldown and no way out.\"}]\n83:[\"$\",\"h2\",\"h2-2\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Laning: the first four minutes\"]}]\n84:[\"$\",\"p\",\"p-8\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Gusion can be played mid lane or jungle. Both paths converge on the same goal: hit level 4 fast, because Incandescence is the entire hero.\"}]\n85:[\"$\",\"ol\",\"ol-0\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"If jungling, start blue and full clear toward red.\"}],\" Gusion's S2 fan clears camps reasonably fast but he is mana-hungry, and blue solves both problems at once. Aim for level 4 by roughly the 1:40 mark. Your first gank should land on a lane with a pushed-up squishy below 80% HP. Burn the full S1, S2, ult, S1, S2 rotation; do not save ult for \\\"later.\\\"\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"If playing mid, take S2 first and clear the wave with the dagger fan.\"}],\" Position so the daggers hit the entire wave in one cast. Take S1 at level 2 for the mark and teleport, but do not use it aggressively before level 4. Without ult, you only get one S1 cycle and the cooldown leaves you helpless if it misses.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Never pick extended trades before level 4.\"}],\" Gusion without ult is functionally a mage with one slow and one blink. He loses sustained trades to every fighter and most marksmen. Farm, dodge skillshots, and wait for the ult unlock. Your first kill attempt is at level 4 with ult available, never before.\"]}],\"\\n\"]}]\n86:[\"$\",\"p\",\"p-9\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Retribution is the spell for jungle, Execute for mid. Execute earns its slot on this hero specifically because the combo frequently leaves squishies at single-digit HP before the first magic penetration item, and the true-damage finisher closes those kills cleanly.\"}]\n87:[\"$\",\"h2\",\"h2-3\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The power spike you are farming toward\"]}]\n88:[\"$\",\"p\",\"p-10\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Arcane Boots first for the flat magic penetration. Genius Wand second, usually completed around the 5-to-7 minute mark. Together they stack flat magic penetration plus Genius Wand's passive that reduces the target's magic defense per damage instance and stacks three times. Because the combo lands roughly ten dagger hits in rapid succession, Genius Wand reaches full stacks on the first volley, which means the back half of the combo is hitting through reduced magic defense without you doing anything extra.\"}]\n89:[\"$\",\"p\",\"p-11\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[\"The real spike is \",[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Genius Wand plus Holy Crystal\"}],\", usually around the 9-to-11 minute mark. Holy Crystal's Mystery passive multiplies your total magic power by a percentage that scales with hero level, which means every dagger throw, every dagger recall, and the S1 teleport damage all scale together off the same item. The jump from one offensive item to two roughly doubles the combo's effective damage, and that is the window where Gusion goes from \\\"pokes the carry\\\" to \\\"deletes the carry.\\\"\"]}]\n8a:[\"$\",\"p\",\"p-12\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The window lasts from roughly minute 9 to minute 18. After that, enemy magic resist items and HP scaling outpace your damage curve and the combo stops one-shotting. You either snowballed during this window or you become a 12-minute irrelevance who farms jungle while the team tries to fight 4v5.\"}]\n8b:[\"$\",\"h2\",\"h2-4\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Teamfight positioning and target priority\"]}]\n8c:[\"$\",\"p\",\"p-13\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The reflex when a fight breaks out is to S1 the nearest enemy and start the combo. That reflex is wrong about half the time, because the nearest enemy is usually the tank and a full combo on a tank does roughly a third of their HP and burns your only damage rotation.\"}]\n8d:[\"$\",\"p\",\"p-14\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Gusion is not a teamfight hero. Like Chou, he is a pre-fight hero. His job is to delete one person before the actual fight starts, and then play the resulting 5v4.\"}]\n8e:[\"$\",\"ol\",\"ol-1\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Wait in fog until you identify your target.\"}],\" Gusion's threat comes from the speed of the combo, not from his presence on the map. If the enemy can see you, they cluster around the carry and you cannot reach the back without eating CC. If they cannot see you, the carry steps forward and you delete them before the team reacts. Showing up early is the most common Gusion mistake.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"S1 is your range check, not your engage.\"}],\" Throw the first dagger from fog. If it lands on the right target, immediately follow with S2, ult, S1, S2 recall. If it hits a tank or whiffs, walk away. The S1 cooldown is short enough that you get another chance at a clean angle before the fight moves. Committing the full combo on the wrong target wastes your entire rotation and usually gets you killed.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Never ult into more than two enemies.\"}],\" Incandescence dashes you forward into the cluster. Two enemies is the absolute maximum your combo can resolve before the third lands CC. One target is ideal, two is acceptable when ahead, three is suicide regardless of how fed you are.\"]}],\"\\n\"]}]\n8f:[\"$\",\"p\",\"p-15\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"If the enemy groups tight and your target stays inside the ball, do not engage. Push a side wave, take a jungle camp, ping for vision, and wait. Gusion's combo requires an isolated or edge-positioned target. Patience here is not passive play; it is the correct play.\"}]\n90:[\"$\",\"$Laa\",null,{\"slot\":\"7246933188\",\"variant\":\"in-article\",\"className\":\"my-8\"}]\n91:[[\"$\",\"h2\",\"h2-0\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Itemization: defaults vs flex slots\"]}],\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Three locked slots and three real conversations.\"}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"The locks are Arcane Boots, Genius Wand, and Holy Crystal.\"}],\" Magic penetration plus the magic-defense shred plus the magic power multiplier. Without these three, the combo does not delete a squishy from full HP.\"]}],\"\\n\",[\"$\",\"p\",\"p-2\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"The fourth slot is the penetration conversation:\"}]}],\"\\n\",[\"$\",\"ul\",\"ul-0\",{\"className\":\"list-disc list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Divine Glaive\"}],\" when two or more enemies have stacked magic defense items. The percentage magic penetration stacks multiplicatively with Genius Wand's flat shred, and your combo target dies through 80+ magic defense.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Concentrated Energy\"}],\" when you are snowballing and want to stay on the map after the first kill. The 400 HP absorbs the return trade, and Recharge stacks magic power on every damage instance, which the multi-dagger combo feeds fast enough that the bonus magic damage window is up for the follow-up rotation.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",\"p-3\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"The fifth slot:\"}]}],\"\\n\",[\"$\",\"ul\",\"ul-1\",{\"className\":\"list-disc list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Blood Wings\"}],\" for raw magic power and the Guard shield. The shield is an extra 800 plus a percentage of magic power, which gives you a real defensive layer when the combo target is gone and you have to walk out through the rest of the enemy team.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Winter Crown\"}],\" when the enemy carries delayed burst that fires after your combo ends. Saber ult, Karina ult, Aldous ult: all of them resolve after Incandescence's window closes, and the 2-second freeze buys you the cooldown reset on S1 to reposition.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Immortality\"}],\" when behind. The resurrection often coincides with S1 cooldown coming back, which is a free escape if you read the situation in the second between dying and respawning.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",\"p-4\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"The weakest common buy is Blade of Despair.\"}],\" Gusion deals magic damage. Physical attack items do nothing for the combo. Build guides that suggest BoD on Gusion were generated by a script that does not check damage type, and you should ignore them.\"]}],\"\\n\",\"$Lab\",\"\\n\",\"$Lac\",\"\\n\",\"$Lad\",\"\\n\",\"$Lae\",\"\\n\",\"$Laf\",\"\\n\",\"$Lb0\",\"\\n\",\"$Lb1\",\"\\n\",\"$Lb2\",\"\\n\",\"$Lb3\",\"\\n\",\"$Lb4\",\"\\n\",\"$Lb5\",\"\\n\",\"$Lb6\",\"\\n\",\"$Lb7\"]\n92:[\"$\",\"$Lb8\",null,{\"heroName\":\"Gusion\"}]\n"])</script><script>self.__next_f.push([1,"93:[\"$\",\"div\",null,{\"className\":\"relative bg-surface-4 border border-mlbb-gold/20 overflow-hidden card-hover hover:border-mlbb-gold/50\",\"style\":{\"boxShadow\":\"0 2px 8px rgba(0,0,0,0.3)\"},\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 p-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative w-14 h-14 rounded-full overflow-hidden flex-shrink-0 bg-surface-3\",\"children\":[\"$\",\"$L6b\",null,{\"src\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_b40e578f13465b3ae99d0a9baac7ecc9.png\",\"alt\":\"Roger - Dire Wolf Hunter\",\"unoptimized\":false,\"priority\":\"$undefined\",\"fetchPriority\":\"$undefined\",\"fill\":true,\"className\":\"object-cover group-hover:scale-110 transition-transform duration-300\",\"sizes\":\"56px\",\"placeholder\":\"blur\",\"blurDataURL\":\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTAwIiBoZWlnaHQ9IjEwMCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDA