nres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_c6294839bbadfa6f203cd57bdc15efe2.png&amp;w=96&amp;output=webp&amp;q=75&amp;we 2x" src="https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_c6294839bbadfa6f203cd57bdc15efe2.png&amp;w=96&amp;output=webp&amp;q=75&amp;we"/></div></span><span class="contents"><span class="inline-flex items-center justify-center w-4 md:w-5 xl:w-3.5 text-base font-heading font-bold leading-none select-none" style="color:#F0D060;text-shadow:0 0 6px #F0D06080" aria-hidden="true">➔</span><div class="relative w-11 h-11 md:w-12 md:h-12 xl:w-10 xl:h-10 flex-shrink-0 overflow-hidden rounded-full flex items-center justify-center" style="background-color:rgba(240,208,96,0.08);border:1.5px solid rgba(240,208,96,0.40);box-shadow:0 0 12px #F0D06025, inset 0 0 0 1px #F0D06030"><img alt="Step 2" loading="lazy" width="48" height="48" decoding="async" data-nimg="1" class="w-full h-full object-cover" style="color:transparent" srcSet="https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_8607d91bbdff281d5bba7618f3ed4c98.png&amp;w=48&amp;output=webp&amp;q=75&amp;we 1x, https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_8607d91bbdff281d5bba7618f3ed4c98.png&amp;w=96&amp;output=webp&amp;q=75&amp;we 2x" src="https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_8607d91bbdff281d5bba7618f3ed4c98.png&amp;w=96&amp;output=webp&amp;q=75&amp;we"/></div></span><span class="contents"><span class="inline-flex items-center justify-center w-4 md:w-5 xl:w-3.5 text-base font-heading font-bold leading-none select-none" style="color:#F0D060;text-shadow:0 0 6px #F0D06080" aria-hidden="true">➔</span><div class="relative w-11 h-11 md:w-12 md:h-12 xl:w-10 xl:h-10 flex-shrink-0 overflow-hidden rounded-full flex items-center justify-center" style="background-color:rgba(240,208,96,0.08);border:1.5px solid rgba(240,208,96,0.40);box-shadow:0 0 12px #F0D06025, inset 0 0 0 1px #F0D06030"><img alt="Step 3" loading="lazy" width="48" height="48" decoding="async" data-nimg="1" class="w-full h-full object-cover" style="color:transparent" srcSet="https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_fc47930fd50e062bf6e8c8c0398e237c.png&amp;w=48&amp;output=webp&amp;q=75&amp;we 1x, https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_fc47930fd50e062bf6e8c8c0398e237c.png&amp;w=96&amp;output=webp&amp;q=75&amp;we 2x" src="https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_fc47930fd50e062bf6e8c8c0398e237c.png&amp;w=96&amp;output=webp&amp;q=75&amp;we"/></div></span></div><p class="text-xs md:text-sm text-text-muted leading-relaxed md:flex-1">Saber can use his 1st Skill to poke and weaken the enemy, follow with his 2nd Skill to close in, then use his Ultimate to finish them off.</p></div></div></section></div></div><div class="grid gap-4 md:gap-5 lg:grid-cols-2 items-start mb-4 md:mb-6"><div class="hero-overview relative lg:pl-4 lg:border-l lg:border-[#C8AA6E]/30"><span class="hidden lg:block absolute left-0 top-0 w-1 h-12 bg-gradient-to-b from-[#F0D060] via-[#C8AA6E] to-transparent" aria-hidden="true"></span><p class="text-[#9BA0B4] leading-relaxed text-sm lg:text-[15px]">Saber is not a jungler you blind because you want a clean 5v5. He is a draft weapon for deleting one hero on command, then making every objective fight feel unsafe for the enemy backline. If the draft gives him no clean target and no exit lane, pick someone else.</p></div><section class="dossier-card relative bg-surface-2/85 backdrop-blur-sm border border-border-default overflow-hidden" style="box-shadow:0 1px 0 rgba(255,255,255,0.03) inset, 0 18px 38px -22px rgba(0,0,0,0.85)" aria-label="Hero at-a-glance stats and attributes"><div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-mlbb-gold/0 via-mlbb-gold-bright/60 to-mlbb-gold/0" aria-hidden="true"></div><div class="absolute top-0 left-0 w-3 h-3 border-t border-l border-mlbb-gold-bright/55" aria-hidden="true"></div><div class="absolute top-0 right-0 w-3 h-3 border-t border-r border-mlbb-gold-bright/55" aria-hidden="true"></div><div class="absolute bottom-0 left-0 w-3 h-3 border-b border-l border-mlbb-gold/30" aria-hidden="true"></div><div class="absolute bottom-0 right-0 w-3 h-3 border-b border-r border-mlbb-gold/30" aria-hidden="true"></div><div class="relative p-4 md:p-5"><div class="flex items-center gap-2 mb-4"><span class="inline-flex items-center justify-center w-5 h-5 bg-mlbb-green/10 border border-mlbb-green/40" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-activity w-3 h-3 text-mlbb-green" aria-hidden="true"><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"></path></svg></span><p class="text-[11px] font-heading font-bold text-text-accent uppercase tracking-[0.32em]">At a Glance</p></div><div class="grid gap-2.5 sm:grid-cols-2 sm:gap-x-8 sm:gap-y-3"><div class="flex items-center gap-3"><span class="text-[10px] md:text-[11px] text-text-muted font-heading uppercase tracking-[0.14em] w-[72px] md:w-20 flex-shrink-0 font-semibold">Durability</span><div class="relative flex-1 h-2.5 overflow-hidden" style="background:#060913;box-shadow:inset 0 0 0 1px rgba(200,170,110,0.12), inset 0 2px 4px rgba(0,0,0,0.45)"><div class="h-full relative" style="width:20%;background:linear-gradient(90deg, #3498DB80 0%, #3498DB 55%, #3498DB 100%);box-shadow:0 0 8px #3498DBaa, inset 0 0 8px #3498DB40"><div class="absolute inset-0" style="background-image:linear-gradient(105deg, transparent 40%, rgba(255,255,255,0.22) 50%, transparent 60%);mix-blend-mode:overlay" aria-hidden="true"></div></div><div class="absolute inset-0 pointer-events-none" style="background:repeating-linear-gradient(to right, transparent 0, transparent calc(10% - 1px), rgba(0,0,0,0.85) calc(10% - 1px), rgba(0,0,0,0.85) 10%)" aria-hidden="true"></div></div><span class="text-[12px] md:text-[13px] font-heading font-bold tabular-nums w-6 text-right leading-none" style="color:#3498DB;text-shadow:0 0 8px #3498DB50">20</span></div><div class="flex items-center gap-3"><span class="text-[10px] md:text-[11px] text-text-muted font-heading uppercase tracking-[0.14em] w-[72px] md:w-20 flex-shrink-0 font-semibold">Offense</span><div class="relative flex-1 h-2.5 overflow-hidden" style="background:#060913;box-shadow:inset 0 0 0 1px rgba(200,170,110,0.12), inset 0 2px 4px rgba(0,0,0,0.45)"><div class="h-full relative" style="width:60%;background:linear-gradient(90deg, #E74C3C80 0%, #E74C3C 55%, #E74C3C 100%);box-shadow:0 0 8px #E74C3Caa, inset 0 0 8px #E74C3C40"><div class="absolute inset-0" style="background-image:linear-gradient(105deg, transparent 40%, rgba(255,255,255,0.22) 50%, transparent 60%);mix-blend-mode:overlay" aria-hidden="true"></div></div><div class="absolute inset-0 pointer-events-none" style="background:repeating-linear-gradient(to right, transparent 0, transparent calc(10% - 1px), rgba(0,0,0,0.85) calc(10% - 1px), rgba(0,0,0,0.85) 10%)" aria-hidden="true"></div></div><span class="text-[12px] md:text-[13px] font-heading font-bold tabular-nums w-6 text-right leading-none" style="color:#E74C3C;text-shadow:0 0 8px #E74C3C50">60</span></div><div class="flex items-center gap-3"><span class="text-[10px] md:text-[11px] text-text-muted font-heading uppercase tracking-[0.14em] w-[72px] md:w-20 flex-shrink-0 font-semibold">Control</span><div class="relative flex-1 h-2.5 overflow-hidden" style="background:#060913;box-shadow:inset 0 0 0 1px rgba(200,170,110,0.12), inset 0 2px 4px rgba(0,0,0,0.45)"><div class="h-full relative" style="width:60%;background:linear-gradient(90deg, #F0D06080 0%, #F0D060 55%, #F0D060 100%);box-shadow:0 0 8px #F0D060aa, inset 0 0 8px #F0D06040"><div class="absolute inset-0" style="background-image:linear-gradient(105deg, transparent 40%, rgba(255,255,255,0.22) 50%, transparent 60%);mix-blend-mode:overlay" aria-hidden="true"></div></div><div class="absolute inset-0 pointer-events-none" style="background:repeating-linear-gradient(to right, transparent 0, transparent calc(10% - 1px), rgba(0,0,0,0.85) calc(10% - 1px), rgba(0,0,0,0.85) 10%)" aria-hidden="true"></div></div><span class="text-[12px] md:text-[13px] font-heading font-bold tabular-nums w-6 text-right leading-none" style="color:#F0D060;text-shadow:0 0 8px #F0D06050">60</span></div><div class="flex items-center gap-3"><span class="text-[10px] md:text-[11px] text-text-muted font-heading uppercase tracking-[0.14em] w-[72px] md:w-20 flex-shrink-0 font-semibold">Difficulty</span><div class="relative flex-1 h-2.5 overflow-hidden" style="background:#060913;box-shadow:inset 0 0 0 1px rgba(200,170,110,0.12), inset 0 2px 4px rgba(0,0,0,0.45)"><div class="h-full relative" style="width:30%;background:linear-gradient(90deg, #9B59B680 0%, #9B59B6 55%, #9B59B6 100%);box-shadow:0 0 8px #9B59B6aa, inset 0 0 8px #9B59B640"><div class="absolute inset-0" style="background-image:linear-gradient(105deg, transparent 40%, rgba(255,255,255,0.22) 50%, transparent 60%);mix-blend-mode:overlay" aria-hidden="true"></div></div><div class="absolute inset-0 pointer-events-none" style="background:repeating-linear-gradient(to right, transparent 0, transparent calc(10% - 1px), rgba(0,0,0,0.85) calc(10% - 1px), rgba(0,0,0,0.85) 10%)" aria-hidden="true"></div></div><span class="text-[12px] md:text-[13px] font-heading font-bold tabular-nums w-6 text-right leading-none" style="color:#9B59B6;text-shadow:0 0 8px #9B59B650">30</span></div></div><a class="mt-4 inline-flex items-center gap-1.5 text-[11px] font-heading font-bold uppercase tracking-[0.14em] text-text-accent hover:text-text-accent-bright transition-colors" href="/tier-list">See Saber in full tier list<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right w-3 h-3" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></div></section></div><div id="ad-4865714798" class="my-6" style="width:100%"><style>#ad-4865714798{min-height:280px}@media(min-width:768px){#ad-4865714798{min-height:280px}}</style><p class="text-[10px] font-heading uppercase tracking-[0.2em] text-[#9BA0B4]/40 text-center mb-2">Advertisement</p><ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-3465999061396690" data-ad-slot="4865714798" data-ad-format="auto" data-full-width-responsive="true"></ins></div><div class="relative content-lazy lg:grid lg:grid-cols-[minmax(0,1fr)_clamp(230px,24%,300px)] lg:gap-x-6 xl:gap-x-8 lg:items-start"><div class="lg:order-2 lg:sticky lg:self-start" style="top:128px"></div><section id="hero-article" class="relative lg:order-1 bg-[#0a0a0a]/85 backdrop-blur-sm border border-[#C8AA6E]/15 p-5 md:p-9 overflow-hidden" style="box-shadow:0 1px 0 rgba(255,255,255,0.03) inset, 0 18px 38px -24px rgba(0,0,0,0.8)"><div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[#F0D060]/55 to-transparent" aria-hidden="true"></div><div class="absolute top-0 left-0 w-3 h-3 border-t border-l border-[#F0D060]/40" aria-hidden="true"></div><div class="absolute top-0 right-0 w-3 h-3 border-t border-r border-[#C8AA6E]/30" aria-hidden="true"></div><div class="absolute bottom-0 left-0 w-3 h-3 border-b border-l border-[#C8AA6E]/30" aria-hidden="true"></div><div class="absolute bottom-0 right-0 w-3 h-3 border-b border-r border-[#C8AA6E]/30" aria-hidden="true"></div><div class="absolute -top-32 -right-24 w-72 h-72 rounded-full bg-[#C8AA6E]/[0.05] blur-3xl pointer-events-none" aria-hidden="true"></div><div class="relative hero-article-body max-w-[860px] mx-auto"><h2 class="text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative"><span aria-hidden="true" class="block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3"></span>Draft Saber to remove one player</h2>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">Patch 2.1.88 (<a class="text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors" href="/patch-notes">patch notes</a>) reshaped him on purpose. Moonton raised his base durability and added sustained damage around Triple Sweep, specifically so he can run Fighter equipment instead of pure glass burst. That opens a second, slower build (covered in the itemization section), but it does not change the real draft test. Saber is still a pick tool first and a sustained bruiser second.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">Pick Saber when the enemy comp has one hero whose game falls apart if they die first every fight. That can be an immobile gold laner, a mage with no instant self-peel, or a mobility assassin that thinks movement alone is enough protection. He is especially useful when the enemy win condition is concentrated in one body and your own draft has enough frontline to occupy everyone else while you take the side door.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">He is a strong answer into teams that lean too hard on one slippery damage dealer. A Hayabusa, Harley, or Fanny player wants messy fights and loose spacing. Saber turns that into a point-and-click appointment. He is also fine into ordinary backline drafts where the gold laner is protected mostly by positioning rather than by cleanse, immunity, or hard peel.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">Do not blind him into double-frontline drafts with a real peel roamer behind them. Khufra, Akai, Kaja, Franco, Chou, and Yu Zhong are all bad news for the same reason: even if you reach the target, the exit is rarely clean. Saber also gets worse when the enemy can split threat across two carries instead of one. If you cannot say before the loading screen which exact hero you are ulting first in every important fight, Saber is the wrong jungle pick.</p>
<h2 class="text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative"><span aria-hidden="true" class="block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3"></span>The defense-shred window is the whole hero</h2>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">Saber is not a flashy combo assassin. He is a timing window.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">Everything in his kit is there to make Triple Sweep hit a target that has already been softened, slowed, and cornered. Enemy&#x27;s Bane strips physical defense over repeated contact. Orbiting Swords gives you the repeated contact. Charge gives you the angle fix and the slow that keeps the victim in front of you. Triple Sweep is just the part everyone notices because it lifts the target into the air.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">This is why strong Saber players do not open fights by panic-ulting the first low-HP bar they see. They want Orbiting Swords active before the commit, because the swords give the engage real weight and every follow-up basic attack sends another blade into the target. Those extra contacts matter twice: they raise your burst and they shorten the wait for the second Charge, which is often the only reason you live after the kill.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">Think of Saber less like a diver and more like a receipt printer. Once the target is tagged, the rest of the combo is mostly paperwork. If you skip the setup and press Triple Sweep raw, you are cashing out the crowd control before the hero has earned his damage.</p>
<h2 class="text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative"><span aria-hidden="true" class="block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3"></span>Jungle: the first four minutes</h2>
<ol class="list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2">
<li class="text-[#9BA0B4]"><strong class="text-[#E8E6E3] font-semibold">Take Orbiting Swords first and max it before Charge.</strong> Saber&#x27;s first skill is clear speed, passive setup, and post-engage mobility all in one button. Start with S1, let it do the camp work, and keep your early path tidy instead of burning Charge for style points.</li>
<li class="text-[#9BA0B4]"><strong class="text-[#E8E6E3] font-semibold">Your first real gank starts at level 4, not earlier.</strong> Before Triple Sweep, Saber is mostly chip damage plus a dash. After level 4, he becomes a guaranteed pick threat on any lane that is pushed too far or missing instant peel. Approach from the side bush, activate S1 before vision, and hold Charge until you know which direction the target wants to leave.</li>
<li class="text-[#9BA0B4]"><strong class="text-[#E8E6E3] font-semibold">Save Retribution for tempo that matters.</strong> Spending it to clear one camp half a second faster is lazy. Save it for a contested buff, the first Turtle setup, or a lane gank where the slow secures a kill your normal combo would not. Saber snowballs through clean sequences, not through rushed clears.</li>
</ol>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">The first four minutes are not about farming faster than a utility jungler. They are about arriving on time to one side lane with level 4 and punishing the first disrespectful wave state. If you leave the opening with one kill, one objective, and no unnecessary death, Saber is on schedule.</p>
<h2 class="text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative"><span aria-hidden="true" class="block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3"></span>Hunter Strike plus Heptaseas is the first real kill window</h2>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">Sabers that feel useless usually have not hit the right item pair yet. The first real spike is <strong class="text-[#E8E6E3] font-semibold">Hunter Strike plus Blade of the Heptaseas</strong>, usually around the 7 to 9 minute mark in a stable game.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">Blade of the Heptaseas changes the opening touch. If you enter from fog after staying out of damage, your first basic attack hits harder and slows the target. That matters because Saber does not want to spend Charge just to begin the fight. He wants the opener to come from the brush, force the enemy to panic, then use Charge only after the target has committed to the wrong escape line.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">Hunter Strike changes the exit. Saber strings together enough consecutive hits to trigger its movement burst in real fights, which means your one-target pick suddenly includes a way out. Before this two-item window, a kill often feels like a trade. After it, you can delete a carry and still slide back toward the wall before the peel arrives.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">This spike does not turn Saber into a tank killer. It turns him into a reliable first-contact assassin. Once you have both items, you stop asking whether the combo can kill a normal squishy and start asking whether the enemy has the tools to stop you from reaching them in the first place. That is a much better problem to have.</p><div id="ad-7246933188" class="my-8" style="width:100%"><style>#ad-7246933188{min-height:280px}@media(min-width:768px){#ad-7246933188{min-height:320px}}</style><p class="text-[10px] font-heading uppercase tracking-[0.2em] text-[#9BA0B4]/40 text-center mb-2">Advertisement</p><ins class="adsbygoogle" style="display:block;text-align:center" data-ad-client="ca-pub-3465999061396690" data-ad-slot="7246933188" data-ad-format="fluid" data-ad-layout="in-article"></ins></div><h2 class="text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative"><span aria-hidden="true" class="block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3"></span>Teamfights: flank, lock, leave</h2>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">The wrong Saber reflex is to press Triple Sweep on the first enemy who steps into range. If that enemy is the tank, you just traded your entire hero for a crowd-control animation.</p>
<ol class="list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2">
<li class="text-[#9BA0B4]"><strong class="text-[#E8E6E3] font-semibold">Wait until peel shows itself.</strong> Do not be the first body in. Let Khufra bounce, let Franco reveal the hook angle, let Chou spend Shunpo, let Akai commit the spin. Saber gets cleaner kills when the anti-dive tools are already pointed somewhere else.</li>
<li class="text-[#9BA0B4]"><strong class="text-[#E8E6E3] font-semibold">Approach from the side, not through the front.</strong> You are not trying to prove you can cross a tank line. You are trying to make the enemy carry turn their camera too late. If your path starts by touching the enemy frontliner, the flank is already bad.</li>
<li class="text-[#9BA0B4]"><strong class="text-[#E8E6E3] font-semibold">Hero-lock before you Charge.</strong> Saber is one of the most target-sensitive assassins in the game. Wrong target means no second chance. Set the lock first, then commit, then leave the moment the job is done.</li>
</ol>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">One support edge case changes the rule: if your roamer is Mathilda, you can take deeper entries than normal because the exit is more forgiving. Without that kind of rescue, play Saber like a rented car. Use him hard for one turn, then hand him back immediately.</p>
<h2 class="text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative"><span aria-hidden="true" class="block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3"></span>Itemization is three locked burst pieces plus real flex slots</h2>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">Treat Saber as three locked burst pieces and several actual conversations.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">The locked burst pieces are <strong class="text-[#E8E6E3] font-semibold">jungle boots, Hunter Strike, and Blade of the Heptaseas</strong>. Those are the items that make the hero feel like Saber instead of a weaker physical assassin. Hunter Strike gives the damage and post-combo movement. Heptaseas gives the real fog-of-war opener. Without both, too many picks turn into half-kills.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">The boot conversation is simple. <strong class="text-[#E8E6E3] font-semibold">Warrior Boots</strong> are for heavy physical burst where surviving the counter-hit matters more than squeezing damage. <strong class="text-[#E8E6E3] font-semibold">Tough Boots</strong> are for drafts loaded with control where one shorter stun is the difference between leaving and feeding.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">After that, read the lobby instead of copying one fixed six-slot list:</p>
<ul class="list-disc list-inside text-[#9BA0B4] my-3 space-y-2 ml-2">
<li class="text-[#9BA0B4]"><strong class="text-[#E8E6E3] font-semibold">Malefic Roar</strong> when the enemy frontliner, roamer, or even your intended carry has started stacking physical defense. If Antique Cuirass or similar armor shows up, this stops your combo from suddenly feeling fake.</li>
<li class="text-[#9BA0B4]"><strong class="text-[#E8E6E3] font-semibold">Blade of Despair</strong> when you are ahead and the enemy backline is still building like you do not exist. This is the greedy punish item. Buy it when you are ending the game, not when you are trying to solve a problem.</li>
<li class="text-[#9BA0B4]"><strong class="text-[#E8E6E3] font-semibold">Endless Battle</strong> when fights are lasting one beat longer and you need the extra true-damage basic attack after a skill cast instead of only front-loaded burst. It also gives enough movement and sustain to make messy skirmishes less punishing.</li>
<li class="text-[#9BA0B4]"><strong class="text-[#E8E6E3] font-semibold">War Axe</strong> when the draft pushes you into the EXP lane or a comp that forces drawn-out brawls instead of clean pickoffs. The 2.1.88 durability buff is what makes this sustained-fighter pivot real: War Axe stacks attack and true damage the longer you stay swinging, trading the one-and-done flank for a body that can actually fight twice.</li>
<li class="text-[#9BA0B4]"><strong class="text-[#E8E6E3] font-semibold">Sea Halberd</strong> into Estes, Rafaela, Esmeralda, Yu Zhong, Freya, or any draft where your first target keeps surviving through heal or shield support. Saber is useless if the carry lives your opener at 10% and gets reset back to half.</li>
<li class="text-[#9BA0B4]"><strong class="text-[#E8E6E3] font-semibold">Immortality</strong> when shutdown gold is on your head or every deep pick is becoming a one-for-one. If the only way the enemy can come back is by cashing your death, the revive is often worth more than another damage slot.</li>
</ul>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">Pick the build from the role, not from habit. Jungle Saber still buys for entry, kill certainty, and escape: that pickoff fantasy is the default, and the assassin emblem feeds it. The sustained Fighter line that 2.1.88 enabled is the exception, not the new normal. Reach for it only when the draft denies you a clean target and forces you to fight through bodies. The moment you can still delete one carry and leave, build for the pickoff and stop theory-crafting a brawler.</p>
<h2 class="text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative"><span aria-hidden="true" class="block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3"></span>Mistakes that turn Saber into a trade</h2>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]"><strong class="text-[#E8E6E3] font-semibold">Pressing Triple Sweep before Orbiting Swords.</strong> This is the cleanest way to remove half your own threat. S1 is not optional decoration. It is the layer that makes the target easier to kill and your exit easier to find.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]"><strong class="text-[#E8E6E3] font-semibold">Picking Saber to solve a tank problem.</strong> He is not the answer to a thick front line. He is the answer to one vulnerable backline piece. If your real issue is that the enemy has too much beef and too much peel, Saber is not fixing the draft.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]"><strong class="text-[#E8E6E3] font-semibold">Using Charge as pure engage instead of as angle correction.</strong> Charge looks like a start button, so weaker players spend it too early. Then the enemy flashes sideways, cleanses, or kites out, and Saber has no way to adjust. Walk first. Let Heptaseas or brush angle begin the play. Save Charge for the line that actually kills.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]"><strong class="text-[#E8E6E3] font-semibold">Showing on the map before the objective fight.</strong> Saber without fog is a warning sign, not a threat. The moment the enemy carry sees you on a wave, they stop farming alone and stand inside their tank&#x27;s hitbox. Good Sabers disappear before Turtle, Lord, or the outer-tower siege, then show up exactly once.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]"><strong class="text-[#E8E6E3] font-semibold">Forcing the combo into immunity or layered peel.</strong> Miya, Wanwan, Wind of Nature marksmen, and supports with instant save buttons all punish impatient Sabers. Bait the defensive button first or choose a different target. Your hero is built around guaranteed access, not guaranteed immunity to bad decisions.</p>
<h2 class="text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative"><span aria-hidden="true" class="block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3"></span>Key tips</h2>
<div class="my-5 p-4 flex gap-3" style="background:rgba(200,170,110,0.08);border:1px solid rgba(200,170,110,0.35)"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lightbulb w-4 h-4 flex-shrink-0 mt-0.5" aria-hidden="true" style="color:#C8AA6E"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"></path><path d="M9 18h6"></path><path d="M10 22h4"></path></svg><div class="min-w-0 flex-1"><p class="text-[11px] font-heading font-bold uppercase tracking-wider mb-1" style="color:#C8AA6E">Tip</p><p class="text-sm text-[#9BA0B4] leading-relaxed">If Orbiting Swords is already active, every follow-up basic attack throws another sword and shortens Charge&#x27;s cooldown. One extra auto after the lift is often what gives you the dash to leave.</p></div></div>
<div class="my-5 p-4 flex gap-3" style="background:rgba(0,170,255,0.08);border:1px solid rgba(0,170,255,0.35)"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info w-4 h-4 flex-shrink-0 mt-0.5" aria-hidden="true" style="color:#00AAFF"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg><div class="min-w-0 flex-1"><p class="text-[11px] font-heading font-bold uppercase tracking-wider mb-1" style="color:#00AAFF">Note</p><p class="text-sm text-[#9BA0B4] leading-relaxed">Blade of the Heptaseas only arms after five seconds without dealing or taking damage. If you clip a jungle creep, a minion, or a tank on the way to a flank, you removed your own best opener.</p></div></div>
<div class="my-5 p-4 flex gap-3" style="background:rgba(200,170,110,0.08);border:1px solid rgba(200,170,110,0.35)"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lightbulb w-4 h-4 flex-shrink-0 mt-0.5" aria-hidden="true" style="color:#C8AA6E"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"></path><path d="M9 18h6"></path><path d="M10 22h4"></path></svg><div class="min-w-0 flex-1"><p class="text-[11px] font-heading font-bold uppercase tracking-wider mb-1" style="color:#C8AA6E">Tip</p><p class="text-sm text-[#9BA0B4] leading-relaxed">Triple Sweep still deals its damage even if the airborne portion gets cleansed. The real question against Purify-type answers is whether you can survive the counter-hit after landing, not whether the skill connects at all.</p></div></div>
<div class="my-5 p-4 flex gap-3" style="background:rgba(0,170,255,0.08);border:1px solid rgba(0,170,255,0.35)"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info w-4 h-4 flex-shrink-0 mt-0.5" aria-hidden="true" style="color:#00AAFF"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg><div class="min-w-0 flex-1"><p class="text-[11px] font-heading font-bold uppercase tracking-wider mb-1" style="color:#00AAFF">Note</p><p class="text-sm text-[#9BA0B4] leading-relaxed">Hero Lock Mode matters more on Saber than on almost any other assassin. Wrong target does not cost a little damage. It costs the entire fight.</p></div></div><aside class="not-prose mt-10 border border-mlbb-gold/25 bg-mlbb-bg-accent/30 p-5 sm:p-6" aria-label="About the author of this Saber guide"><div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:gap-5"><a class="shrink-0" aria-label="About Slendertaker" href="/authors/slendertaker"><img alt="Slendertaker" loading="lazy" width="72" height="72" decoding="async" data-nimg="1" class="h-[72px] w-[72px] rounded-full border border-mlbb-gold/50 object-cover" style="color:transparent" src="/authors/slendertaker.webp"/></a><div class="min-w-0 flex-1"><div class="text-xs uppercase tracking-wider text-mlbb-text-secondary">Written by</div><a class="font-heading text-lg text-mlbb-gold hover:text-mlbb-gold-bright" rel="author" href="/authors/slendertaker">Slendertaker</a><div class="text-sm text-mlbb-text-secondary">Mythic Immortal, Founder &amp; Editor of MLBBHub</div><p class="mt-3 text-sm leading-relaxed text-mlbb-text">Slendertaker climbed to Mythic Immortal in Mobile Legends, the apex of the ranked ladder, before sitting down to build the tool he wished existed while he was getting there. MLBBHub is that tool. He writes every hero guide on the site personally, picks the curated builds, and owns the data pipeline that keeps patch notes, items, and emblems in sync.</p><div class="mt-4 flex flex-wrap gap-2"><a href="https://github.com/slendertaker" target="_blank" rel="nofollow noopener noreferrer me" class="inline-flex items-center gap-1.5 border border-mlbb-gold/30 bg-mlbb-bg-accent/40 px-3 py-1 text-xs text-mlbb-text-secondary transition hover:border-mlbb-gold hover:text-mlbb-gold-bright" aria-label="GitHub profile"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-github" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg><span>GitHub</span></a><a href="https://x.com/slendertaker7" target="_blank" rel="nofollow noopener noreferrer me" class="inline-flex items-center gap-1.5 border border-mlbb-gold/30 bg-mlbb-bg-accent/40 px-3 py-1 text-xs text-mlbb-text-secondary transition hover:border-mlbb-gold hover:text-mlbb-gold-bright" aria-label="X profile"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-twitter" aria-hidden="true"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg><span>X</span></a><a href="https://slendertaker.com" target="_blank" rel="nofollow noopener noreferrer me" class="inline-flex items-center gap-1.5 border border-mlbb-gold/30 bg-mlbb-bg-accent/40 px-3 py-1 text-xs text-mlbb-text-secondary transition hover:border-mlbb-gold hover:text-mlbb-gold-bright" aria-label="slendertaker.com profile"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-external-link" aria-hidden="true"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg><span>slendertaker.com</span></a></div></div></div></aside></div></section></div></div><div id="tabpanel-skills" role="tabpanel" aria-labelledby="tab-skills" hidden=""></div><div id="tabpanel-matchups" role="tabpanel" aria-labelledby="tab-matchups" tabindex="0" hidden=""><div class="space-y-6 lg:space-y-8"><div class="glass-card border-mlbb-gold/15 p-4 sm:p-5" style="opacity:0;transform:translateY(-8px)"><div class="grid grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-x-3 gap-y-4 lg:grid-cols-[auto_auto_minmax(0,1fr)_auto] lg:gap-x-5"><div class="w-10 h-10 bg-mlbb-red/10 border border-mlbb-red/30 flex items-center justify-center"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield w-5 h-5 text-mlbb-red" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path></svg></div><div class="min-w-0"><p class="text-xs font-heading font-bold text-text-primary uppercase tracking-wider">Top Counter</p><p class="flex min-w-0 flex-wrap items-baseline gap-x-1.5 text-sm text-text-accent-bright font-heading font-bold"><span class="min-w-0 truncate">Leomord</span><span class="shrink-0 text-mlbb-green text-xs">+<!-- -->3.3<!-- --> pp</span></p></div><a aria-label="Open full counter page for Saber" class="group inline-flex h-8 items-center justify-center gap-1.5 border border-mlbb-gold/20 bg-surface-2/45 px-2.5 font-heading text-[10px] font-bold uppercase tracking-wider text-text-accent transition-colors hover:border-mlbb-gold-bright/45 hover:text-text-accent-bright lg:col-start-4 lg:row-start-1" href="/counter/saber"><span>View all</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a><div class="col-span-3 grid gap-2 text-center grid-cols-3 sm:flex sm:items-center sm:justify-around lg:col-span-1 lg:col-start-3 lg:row-start-1"><div><p class="text-lg font-heading font-bold text-mlbb-green">15</p><p class="text-[9px] text-text-muted uppercase tracking-wider">Counters</p></div><div><p class="text-lg font-heading font-bold text-text-accent">14</p><p class="text-[9px] text-text-muted uppercase tracking-wider">Weak To</p></div><div><p class="text-lg font-heading font-bold text-text-accent-bright truncate">Balanced</p><p class="text-[9px] text-text-muted uppercase tracking-wider">Peak Phase</p></div></div></div></div><div class="grid gap-6 lg:grid-cols-2 lg:items-start lg:gap-6"><section><div class="mb-4"><div class="flex items-center gap-3 mb-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield w-5 h-5 text-mlbb-green" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path></svg><h2 class="text-lg md:text-xl font-heading font-bold text-text-primary">How to Counter<!-- --> <span style="color:#ff4444">Saber</span