xt-lg sm:text-xl font-heading font-bold" style="color:#C8AA6E"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trending-down w-3.5 h-3.5" aria-hidden="true"><path d="M16 17h6v-6"></path><path d="m22 17-8.5-8.5-5 5L2 7"></path></svg>+<!-- -->2.0</p><p class="text-[9px] text-text-muted uppercase hidden sm:block">win rate delta</p></div></div><div class="absolute top-0 left-0 w-3 h-3 border-t border-l border-mlbb-gold/20 pointer-events-none"></div><div class="absolute bottom-0 right-0 w-3 h-3 border-b border-r border-mlbb-gold/20 pointer-events-none"></div></div><div class="group relative bg-surface-3 border border-mlbb-gold/15 hover:border-mlbb-green/30 transition-all duration-300" style="opacity:0;transform:translateY(12px)"><div class="flex items-center gap-3 p-3 sm:gap-4 sm:p-4"><div class="flex-shrink-0 w-7 sm:w-8 text-center"><span class="text-base sm:text-lg font-heading font-bold text-text-accent">#<!-- -->13</span></div><a class="flex-shrink-0" href="/heroes/moskov"><div class="relative overflow-hidden flex-shrink-0 rounded-full" style="width:48px;height:48px;min-width:48px;background-color:#E74C3C12"><img alt="Moskov hero icon" loading="lazy" width="48" height="48" decoding="async" data-nimg="1" class="h-full w-full object-cover" style="color:transparent" srcSet="https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_a60a866ab6752a7f66766e720da987ea.png&amp;w=48&amp;output=webp&amp;q=75&amp;we 1x, https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_a60a866ab6752a7f66766e720da987ea.png&amp;w=96&amp;output=webp&amp;q=75&amp;we 2x" src="https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_a60a866ab6752a7f66766e720da987ea.png&amp;w=96&amp;output=webp&amp;q=75&amp;we"/></div></a><div class="min-w-0 flex-1"><div class="flex items-center gap-2 sm:gap-3 flex-wrap"><a class="min-w-0 max-w-full truncate font-heading font-bold text-base sm:text-lg text-text-primary hover:text-text-accent-bright transition-colors" href="/heroes/moskov">Moskov</a><div class="inline-flex items-center justify-center font-heading font-bold bg-gradient-to-br from-[#00AAFF] to-[#0077CC] text-[#00111a] shadow-[0_0_12px_rgba(0,170,255,0.3)] w-6 h-6 text-xs animate-tier-pop">B</div><div class="gap-1.5 hidden sm:flex"><span class="text-[10px] px-1.5 py-0.5" style="background-color:#E74C3C20;color:#ee8277">Marksman</span></div></div><p class="text-xs text-text-muted mt-1 line-clamp-2">Saber&#x27;s mobility and burst allow them to quickly eliminate Moskov before they can retaliate.</p></div><div class="flex-shrink-0 text-right"><p class="flex items-center justify-end gap-1 text-lg sm:text-xl font-heading font-bold" style="color:#C8AA6E"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trending-down w-3.5 h-3.5" aria-hidden="true"><path d="M16 17h6v-6"></path><path d="m22 17-8.5-8.5-5 5L2 7"></path></svg>+<!-- -->1.8</p><p class="text-[9px] text-text-muted uppercase hidden sm:block">win rate delta</p></div></div><div class="absolute top-0 left-0 w-3 h-3 border-t border-l border-mlbb-gold/20 pointer-events-none"></div><div class="absolute bottom-0 right-0 w-3 h-3 border-b border-r border-mlbb-gold/20 pointer-events-none"></div></div><div class="group relative bg-surface-3 border border-mlbb-gold/15 hover:border-mlbb-green/30 transition-all duration-300" style="opacity:0;transform:translateY(12px)"><div class="flex items-center gap-3 p-3 sm:gap-4 sm:p-4"><div class="flex-shrink-0 w-7 sm:w-8 text-center"><span class="text-base sm:text-lg font-heading font-bold text-text-accent">#<!-- -->14</span></div><a class="flex-shrink-0" href="/heroes/clint"><div class="relative overflow-hidden flex-shrink-0 rounded-full" style="width:48px;height:48px;min-width:48px;background-color:#E74C3C12"><img alt="Clint hero icon" loading="lazy" width="48" height="48" decoding="async" data-nimg="1" class="h-full w-full object-cover" style="color:transparent" srcSet="https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_fd120c3e9261a233442ee88a1d7c9f58.png&amp;w=48&amp;output=webp&amp;q=75&amp;we 1x, https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_fd120c3e9261a233442ee88a1d7c9f58.png&amp;w=96&amp;output=webp&amp;q=75&amp;we 2x" src="https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_fd120c3e9261a233442ee88a1d7c9f58.png&amp;w=96&amp;output=webp&amp;q=75&amp;we"/></div></a><div class="min-w-0 flex-1"><div class="flex items-center gap-2 sm:gap-3 flex-wrap"><a class="min-w-0 max-w-full truncate font-heading font-bold text-base sm:text-lg text-text-primary hover:text-text-accent-bright transition-colors" href="/heroes/clint">Clint</a><div class="inline-flex items-center justify-center font-heading font-bold bg-gradient-to-br from-[#00AAFF] to-[#0077CC] text-[#00111a] shadow-[0_0_12px_rgba(0,170,255,0.3)] w-6 h-6 text-xs animate-tier-pop">B</div><div class="gap-1.5 hidden sm:flex"><span class="text-[10px] px-1.5 py-0.5" style="background-color:#E74C3C20;color:#ee8277">Marksman</span></div></div><p class="text-xs text-text-muted mt-1 line-clamp-2">Saber&#x27;s mobility and burst allow them to quickly eliminate Clint before they can retaliate.</p></div><div class="flex-shrink-0 text-right"><p class="flex items-center justify-end gap-1 text-lg sm:text-xl font-heading font-bold" style="color:#C8AA6E"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trending-down w-3.5 h-3.5" aria-hidden="true"><path d="M16 17h6v-6"></path><path d="m22 17-8.5-8.5-5 5L2 7"></path></svg>+<!-- -->1.3</p><p class="text-[9px] text-text-muted uppercase hidden sm:block">win rate delta</p></div></div><div class="absolute top-0 left-0 w-3 h-3 border-t border-l border-mlbb-gold/20 pointer-events-none"></div><div class="absolute bottom-0 right-0 w-3 h-3 border-b border-r border-mlbb-gold/20 pointer-events-none"></div></div></div></section></div><section class="grid gap-3 md:grid-cols-3"><a class="block" href="/heroes/harley"><div class="h-full border border-mlbb-gold/18 bg-surface-2/82 p-4 transition-colors hover:border-mlbb-gold-bright/35"><p class="mb-1 font-heading text-[10px] font-bold uppercase tracking-[0.16em] text-text-accent">Official Ally Note</p><h3 class="font-heading text-base font-bold text-text-primary">Harley</h3><p class="mt-2 text-xs leading-relaxed text-text-muted">Saber’s control skill can help Harley to achieve maximum damage output. Their excellent mobility can generate great momentum in the early game.</p></div></a><a class="block" href="/heroes/odette"><div class="h-full border border-mlbb-gold/18 bg-surface-2/82 p-4 transition-colors hover:border-mlbb-gold-bright/35"><p class="mb-1 font-heading text-[10px] font-bold uppercase tracking-[0.16em] text-text-accent">Official Counter Note</p><h3 class="font-heading text-base font-bold text-text-primary">Odette</h3><p class="mt-2 text-xs leading-relaxed text-text-muted">Layla, Odette -- Heroes without displacement skills are very vulnerable to Saber’s sudden charge.</p></div></a><a class="block" href="/heroes/diggie"><div class="h-full border border-mlbb-gold/18 bg-surface-2/82 p-4 transition-colors hover:border-mlbb-gold-bright/35"><p class="mb-1 font-heading text-[10px] font-bold uppercase tracking-[0.16em] text-text-accent">Official Threat Note</p><h3 class="font-heading text-base font-bold text-text-primary">Diggie</h3><p class="mt-2 text-xs leading-relaxed text-text-muted">Diggie’s ultimate skill can cancel the control effect of Saber’s control skill.</p></div></a></section><section><div class="mb-4"><div class="flex items-center gap-3 mb-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock w-5 h-5 text-text-accent-bright" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg><h2 class="text-lg md:text-xl font-heading font-bold text-text-primary">Game Phase Analysis for<!-- --> <span style="color:#F0D060">Saber</span></h2></div><p class="text-xs text-text-muted max-w-2xl">Saber&#x27;s 10 measured matchups do not separate by match length: no phase leads the others by more than that sample can resolve. There is no single window where Saber drops off, so focus on consistent play and team coordination.</p></div><div class="grid grid-cols-1 sm:grid-cols-3 gap-4"><div class="bg-surface-3 border border-mlbb-gold/15 p-4" style="opacity:0;transform:translateY(15px)"><div class="flex items-center justify-between mb-1"><span class="text-xs font-heading font-bold text-text-primary uppercase tracking-wider">Early Game</span><span class="text-[10px] text-text-muted">0-10 min</span></div><p class="text-base font-heading font-bold mb-2" style="color:#9BA0B4">No measured separation</p><div class="w-full h-2 bg-surface-4 overflow-hidden"><div class="h-full" style="background-color:#9BA0B4;width:0px"></div></div></div><div class="bg-surface-3 border border-mlbb-gold/15 p-4" style="opacity:0;transform:translateY(15px)"><div class="flex items-center justify-between mb-1"><span class="text-xs font-heading font-bold text-text-primary uppercase tracking-wider">Mid Game</span><span class="text-[10px] text-text-muted">10-16 min</span></div><p class="text-base font-heading font-bold mb-2" style="color:#9BA0B4">No measured separation</p><div class="w-full h-2 bg-surface-4 overflow-hidden"><div class="h-full" style="background-color:#9BA0B4;width:0px"></div></div></div><div class="bg-surface-3 border border-mlbb-gold/15 p-4" style="opacity:0;transform:translateY(15px)"><div class="flex items-center justify-between mb-1"><span class="text-xs font-heading font-bold text-text-primary uppercase tracking-wider">Late Game</span><span class="text-[10px] text-text-muted">16+ min</span></div><p class="text-base font-heading font-bold mb-2" style="color:#9BA0B4">No measured separation</p><div class="w-full h-2 bg-surface-4 overflow-hidden"><div class="h-full" style="background-color:#9BA0B4;width:0px"></div></div></div></div><p class="text-[10px] text-text-muted/80 mt-3 max-w-3xl">Shape only, from the 10 matchups measured for Saber. The bars rank Saber&#x27;s own phases against each other, not against other heroes, and are not win rates.</p></section></div></div><div id="tabpanel-builds" role="tabpanel" aria-labelledby="tab-builds" tabindex="0" hidden=""><section class="space-y-3 sm:space-y-4"><div class="flex flex-col gap-3 xl:flex-row xl:items-end xl:justify-between xl:gap-8"><header class="min-w-0"><h2 class="font-heading text-lg font-bold uppercase leading-tight tracking-[0.06em] text-mlbb-text sm:text-2xl"><span class="text-mlbb-gold-bright">Saber</span> <span class="text-mlbb-text/85">Best Builds, Emblems</span> <span class="text-mlbb-text/60">&amp;</span> <span class="text-mlbb-text/85">Talents</span></h2><p class="mt-1 hidden max-w-3xl text-sm text-mlbb-text-secondary sm:block xl:hidden">Three battle-tested loadouts. Pick the one that fits the draft, not the one with the most flash.</p><div class="mt-1.5 flex flex-wrap items-center gap-x-2.5 gap-y-1"><span class="font-heading text-[10px] font-bold uppercase tracking-[0.2em] text-text-muted">Patch <!-- -->2.1.67</span><span title="These loadou