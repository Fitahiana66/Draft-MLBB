between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#C8AA6E\",\"background\":\"#C8AA6E1a\",\"border\":\"1px solid #C8AA6E40\"},\"children\":\"Mythical Honor\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Cecilion\",\"rank\":\"Mythical Honor\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=mythical_honor\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Mythical Honor\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Mythical Honor\",\"name\":\"Cecilion\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"52.09\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Cecilion\",\"delta\":\"+0.99%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.73\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.11\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Mythical Honor\"}}]]}]]}]\na6:[\"$\",\"article\",\"mythical_glory\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #ff5d73, #ff5d7333)\",\"boxShadow\":\"0 0 12px -2px #ff5d7380\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#ff5d73\",\"background\":\"#ff5d731a\",\"border\":\"1px solid #ff5d7340\"},\"children\":\"Mythical Glory+\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Cecilion\",\"rank\":\"Mythical Glory+\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=mythical_glory\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Mythical Glory+\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Mythical Glory+\",\"name\":\"Cecilion\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"51.59\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Cecilion\",\"delta\":\"+0.49%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.83\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.07\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Mythical Glory+\"}}]]}]]}]\na8:[\"$\",\"p\",\"p-4\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Winter Crown replaces Blood Wings when the enemy has multiple untouchable assassins; its Frozen active is a panic button for Natalia or Ling lockdown attempts. Wishing Lantern is the greed option that replaces Holy Crystal against teams with three or more HP-stacking frontliners; its Butterfly Goddess passive summons a 10% current HP nuke every 800 damage, and Cecilion's constant casting triggers it on schedule.\"}]\na9:[\"$\",\"p\",\"p-5\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Battle spell is Flicker in every matchup except against CC-chain comps. If the enemy has Khufra plus Tigreal stacked, Purify is the correct pick because you only need one CC break to survive the opening engage, and Flicker's range is too short to exit the combo chain once you are already pulled. Do not take Purify specifically for Franco or Kaja: their ultimate suppression is not a debuff, so Purify will not remove it, and Flicker remains the better answer to their lockdown. Emblem is Mage with Impure Rage as the core talent: it restores mana on hit, feeding Overflowing and shortening the path to max stacks every fight.\"}]\naa:[\"$\",\"h2\",\"h2-1\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Mistakes that lose Cecilion games\"]}]\nab:[\"$\",\"p\",\"p-6\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Opening Bats Feast into a team that is not already CC'd.\"}],\" The volley fires in a cone, and enemies hit by the first bolt almost always sprint out before the remaining bolts land. Without Sanguine Claws locking the cluster first, most of the volley connects with nothing. S2 first, wait for the immobilize to trigger, then S3. Reversing that order is the single largest damage loss on this hero.\"]}]\nac:[\"$\",\"p\",\"p-7\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Spamming S1 faster than its cost allows.\"}],\" Overflowing pays out on its own internal cooldown, so casting S1 faster than that rhythm wastes passive procs and runs straight into the cost escalation, burning through the expensive stacks in seconds. The pacing that wastes zero mana is one cast per wave crash, timed to S1's cooldown instead of overclocked by high cooldown reduction.\"]}]\nad:[\"$\",\"p\",\"p-8\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Walking into max range to land the near hit instead of pre-stacking.\"}],\" New Cecilion players push forward for the landing-point damage because the number is bigger. Against any team with a single initiator, that step forward is the step that gets you killed. Path damage from range is plenty for poke work. The near-landing hit is a finisher, not an opener, and only lands reliably when the target is already rooted by Sanguine Claws.\"]}]\nae:[\"$\",\"p\",\"p-9\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Burning Flicker to chase a kill.\"}],\" Cecilion's base Movement Speed of 250 and Physical Defense of 17 turn every post-Flicker disengage into a death window. If you Flicker into a stacked S1 against a low-HP target and the kill is not secured by the cast, you die for the attempt. Flicker is the only exit button on a hero with no dash, no blink, and no defensive steroid.\"]}]\naf:[\"$\",\"p\",\"p-10\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Picking Cecilion into a premade Gusion without a peel support.\"}],\" Gusion's full recall combo executes before Cecilion can react. Cecilion's only survival tool is Flicker, which is too short to exit that range. Tigreal Attack Order pointed at Gusion on his approach is the only realistic counter, and you must draft it on your side. Without it, Gusion ends your game before you reach Lightning Truncheon.\"]}]\nb0:[\"$\",\"h2\",\"h2-2\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Key tips\"]}]\nb1:[\"$\",\"div\",\"blockquote-0\",{\"className\":\"my-5 p-4 flex gap-3\",\"style\":{\"background\":\"rgba(200,170,110,0.08)\",\"border\":\"1px solid rgba(200,170,110,0.35)\"},\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-lightbulb w-4 h-4 flex-shrink-0 mt-0.5\",\"aria-hidden\":\"true\",\"style\":{\"color\":\"#C8AA6E\"},\"children\":[[\"$\",\"path\",\"1gvzjb\",{\"d\":\"M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5\"}],[\"$\",\"path\",\"x1upvd\",{\"d\":\"M9 18h6\"}],[\"$\",\"path\",\"ceow96\",{\"d\":\"M10 22h4\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[11px] font-heading font-bold uppercase tracking-wider mb-1\",\"style\":{\"color\":\"#C8AA6E\"},\"children\":\"Tip\"}],[[\"$\",\"p\",\"0\",{\"className\":\"text-sm text-[#9BA0B4] leading-relaxed\",\"children\":[\"Pre-stack S1 on a jungle camp just before every Dragon or Lord spawn. You want to enter the objective fight already at max S1 stack with Lightning Truncheon Resonate off cooldown. Entering cold means the first fight rotation is half-damage, and Cecilion's half-damage is not good enough.\"]}]]]}]]}]\nb2:[\"$\",\"div\",\"blockquote-1\",{\"className\":\"my-5 p-4 flex gap-3\",\"style\":{\"background\":\"rgba(0,170,255,0.08)\",\"border\":\"1px solid rgba(0,170,255,0.35)\"},\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-info w-4 h-4 flex-shrink-0 mt-0.5\",\"aria-hidden\":\"true\",\"style\":{\"color\":\"#00AAFF\"},\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"1dtifu\",{\"d\":\"M12 16v-4\"}],[\"$\",\"path\",\"e9boi3\",{\"d\":\"M12 8h.01\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[11px] font-heading font-bold uppercase tracking-wider mb-1\",\"style\":{\"color\":\"#00AAFF\"},\"children\":\"Note\"}],[[\"$\",\"p\",\"0\",{\"className\":\"text-sm text-[#9BA0B4] leading-relaxed\",\"children\":[\"Sanguine Claws gives you brief vision at the cast location before the claws clasp. This lets you scout bushes near river, check positioning before Lord pit, and confirm whether the enemy jungler is rotating, at no mana waste. Treat it as a second ward on top of its stun function.\"]}]]]}]]}]\nb3:[\"$\",\"div\",\"blockquote-2\",{\"className\":\"my-5 p-4 flex gap-3\",\"style\":{\"background\":\"rgba(200,170,110,0.08)\",\"border\":\"1px solid rgba(200,170,110,0.35)\"},\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-lightbulb w-4 h-4 flex-shrink-0 mt-0.5\",\"aria-hidden\":\"true\",\"style\":{\"color\":\"#C8AA6E\"},\"children\":[[\"$\",\"path\",\"1gvzjb\",{\"d\":\"M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5\"}],[\"$\",\"path\",\"x1upvd\",{\"d\":\"M9 18h6\"}],[\"$\",\"path\",\"ceow96\",{\"d\":\"M10 22h4\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[11px] font-heading font-bold uppercase tracking-wider mb-1\",\"style\":{\"color\":\"#C8AA6E\"},\"children\":\"Tip\"}],[[\"$\",\"p\",\"0\",{\"className\":\"text-sm text-[#9BA0B4] leading-relaxed\",\"children\":[\"Against Belerick, Gloo, or Barats, swap Holy Crystal for Genius Wand in the fourth slot. The Magic Defense shred stacks on every S1 bat, and Cecilion's constant casting keeps it stacked through the fight. You will shred their natural defenses before Divine Glaive even comes online.\"]}]]]}]]}]\nb4:[\"$\",\"div\",\"blockquote-3\",{\"className\":\"my-5 p-4 flex gap-3\",\"style\":{\"background\":\"rgba(0,170,255,0.08)\",\"border\":\"1px solid rgba(0,170,255,0.35)\"},\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-info w-4 h-4 flex-shrink-0 mt-0.5\",\"aria-hidden\":\"true\",\"style\":{\"color\":\"#00AAFF\"},\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"1dtifu\",{\"d\":\"M12 16v-4\"}],[\"$\",\"path\",\"e9boi3\",{\"d\":\"M12 8h.01\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[11px] font-heading font-bold uppercase tracking-wider mb-1\",\"style\":{\"color\":\"#00AAFF\"},\"children\":\"Note\"}],[[\"$\",\"p\",\"0\",{\"className\":\"text-sm text-[#9BA0B4] leading-relaxed\",\"children\":[\"The S1 cost reset matters more than most players realize. If you stop casting for a few seconds, the next S1 drops back to base cost. Use this deliberately in laning: three bats into the wave, walk back to top up mana, then enter the next minion line at base cost. The rhythm saves enough mana across laning for an entire extra combo window.\"]}]]]}]]}]\n"])</script></body></html>