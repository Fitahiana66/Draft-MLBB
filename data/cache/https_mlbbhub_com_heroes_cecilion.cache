ier\":\"Exceptional\",\"rawTier\":\"Exceptional\",\"tag\":\"Starlight\",\"tagSlug\":\"starlight\",\"price\":\"2022/02 StarLight Member\",\"portraitFile\":\"Hero915-portrait.png\",\"portraitUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/cecilion/Hero915-portrait-20220525170202.webp\",\"splashUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/cecilion/Cecilion-Stargazer-20220202133459.webp\",\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Cecilion/Cosmetics\"},{\"name\":\"Crimson Wings\",\"tier\":\"Exquisite\",\"rawTier\":\"Exquisite\",\"tag\":\"Collector\",\"tagSlug\":\"collector\",\"price\":\"Limited-time Event\",\"portraitFile\":\"Hero916-portrait.png\",\"portraitUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/cecilion/Hero916-portrait-20220915122137.webp\",\"splashUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/cecilion/Cecilion-Crimson-Wings-20220915133531.webp\",\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Cecilion/Cosmetics\"},{\"name\":\"Hisoka\",\"tier\":\"Grand\",\"rawTier\":\"Grand\",\"tag\":\"HUNTER×HUNTER\",\"tagSlug\":\"hunter-hunter\",\"price\":\"Limited-time Event\",\"portraitFile\":\"Hero917-portrait.png\",\"portraitUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/cecilion/Hero917-portrait-20241207073219.webp\",\"splashUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/cecilion/Cecilion-Hisoka-20241208031730.webp\",\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Cecilion/Cosmetics\"}],\"lore\":{\"backstory\":\"Cecilion is a centuries-old vampire aristocrat, the Lord of Castle Aberleen, whose mastery over blood magic and sonic screams makes him one of the most dangerous beings in the Land of Dawn. For ages he slumbered in his castle, indifferent to mortal affairs, until the night a human woman named Carmilla broke into his domain seeking eternal life. Instead of consuming her, Cecilion fell hopelessly in love, and their bond now transcends death itself. Together they form an inseparable duo, his bat-like screams complementing her crimson chains.\",\"allies\":[{\"heroSlug\":\"carmilla\",\"heroName\":\"Carmilla\",\"relationship\":\"Eternal lover and blood-bonded soulmate\"},{\"heroSlug\":\"pharsa\",\"heroName\":\"Pharsa\",\"relationship\":\"Fellow ancient mage who respects his arcane knowledge\"}],\"rivals\":[{\"heroSlug\":\"granger\",\"heroName\":\"Granger\",\"relationship\":\"Death Chanter whose bullets pierce vampiric defense\"},{\"heroSlug\":\"aldous\",\"heroName\":\"Aldous\",\"relationship\":\"Soul contractor who hunts creatures of the night\"}]},\"loreUrlName\":\"Cecilion\",\"statsHistory\":[{\"date\":\"2026-09-07\",\"winRate\":49.96,\"pickRate\":0.61,\"banRate\":0.22},{\"date\":\"2026-09-10\",\"winRate\":50,\"pickRate\":0.61,\"banRate\":0.21},{\"date\":\"2026-09-16\",\"winRate\":50.23,\"pickRate\":0.62,\"banRate\":0.22},{\"date\":\"2026-09-28\",\"winRate\":50.81,\"pickRate\":0.64,\"banRate\":0.12},{\"date\":\"2026-10-02\",\"winRate\":50.92,\"pickRate\":0.62,\"banRate\":0.12},{\"date\":\"2026-10-09\",\"winRate\":50.97,\"pickRate\":0.64,\"banRate\":0.13},{\"date\":\"2026-10-17\",\"winRate\":51,\"pickRate\":0.64,\"banRate\":0.14}]},\"relatedHeroesSlot\":\"$L66\",\"statsSeoSlot\":\"$L67\",\"fieldManualSlot\":\"$L68\"}]\n61:[\"$\",\"$L69\",null,{\"heroName\":\"Cecilion\",\"heroSlug\":\"cecilion\",\"roles\":\"$60:props:hero:role\",\"lanes\":\"$60:props:hero:lane\",\"difficulty\":2,\"winRate\":51,\"pickRate\":0.64,\"banRate\":0.14,\"curatedBuilds\":\"$60:props:curatedBuilds\",\"topCounters\":\"$60:props:tabData:counterData:countersThisHero\",\"hasCounterPage\":true,\"hasRankStats\":true,\"locale\":\"en\",\"pageUrl\":\"https://mlbbhub.com/heroes/cecilion\",\"year\":2026}]\n"])</script><script>self.__next_f.push([1,"6a:I[313915,[\"$7\",\"$8\",\"$9\",\"$a\",\"$b\",\"$2e\",\"$3e\",\"$3f\"],\"default\"]\n6b:I[279344,[\"$7\",\"$8\",\"$9\",\"$a\",\"$b\",\"$2e\",\"$3e\",\"$3f\"],\"Image\"]\n6c:I[842376,[\"$7\",\"$8\",\"$9\",\"$a\",\"$b\",\"$2e\",\"$3e\",\"$3f\"],\"default\"]\n7d:I[