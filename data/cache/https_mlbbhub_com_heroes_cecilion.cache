wToStep\",\"position\":4,\"name\":\"Buy Genius Wand\",\"text\":\"Purchase Genius Wand (2,000 gold) as item 4 in the Anti-Tank Shred build for Cecilion.\",\"url\":\"https://mlbbhub.com/heroes/cecilion#build-mid-antitank\"},{\"@type\":\"HowToStep\",\"position\":5,\"name\":\"Buy Divine Glaive\",\"text\":\"Purchase Divine Glaive (1,970 gold) as item 5 in the Anti-Tank Shred build for Cecilion.\",\"url\":\"https://mlbbhub.com/heroes/cecilion#build-mid-antitank\"},{\"@type\":\"HowToStep\",\"position\":6,\"name\":\"Buy Glowing Wand\",\"text\":\"Purchase Glowing Wand (2,050 gold) as item 6 in the Anti-Tank Shred build for Cecilion.\",\"url\":\"https://mlbbhub.com/heroes/cecilion#build-mid-antitank\"}],\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://mlbbhub.com/heroes/cecilion\"},\"datePublished\":\"2026-04-14T00:00:00.000Z\",\"dateModified\":\"2026-05-08T00:00:00.000Z\",\"author\":{\"@type\":\"Organization\",\"name\":\"MLBBHub\",\"url\":\"https://mlbbhub.com\"}}5e:[\"$\",\"script\",\"1\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$63\"}}]\n64:T98b,{\"@context\":\"https://schema.org\",\"@type\":\"HowTo\",\"name\":\"How to Build Cecilion in Mobile Legends: Carmilla Duo Gold Lane\",\"description\":\"Gold lane build for the Carmilla pair. Carmilla's frontline presence covers Divine Glaive slot; Holy Crystal plus Genius Wand front-loads damage for Moonlit Waltz engages. Blood Wings shield resets between waves when Carmilla soaks pressure.\",\"totalTime\":\"PT15M\",\"supply\":[{\"@type\":\"HowToSupply\",\"name\":\"Demon Boots\"},{\"@type\":\"HowToSupply\",\"name\":\"Clock of Destiny\"},{\"@type\":\"HowToSupply\",\"name\":\"Lightning Truncheon\"},{\"@type\":\"HowToSupply\",\"name\":\"Holy Crystal\"},{\"@type\":\"HowToSupply\",\"name\":\"Genius Wand\"},{\"@type\":\"HowToSupply\",\"name\":\"Blood Wings\"}],\"tool\":[{\"@type\":\"HowToTool\",\"name\":\"Mage Emblem\"},{\"@type\":\"HowToTool\",\"name\":\"Flicker Battle Spell\"}],\"step\":[{\"@type\":\"HowToStep\",\"position\":1,\"name\":\"Buy Demon Boots\",\"text\":\"Purchase Demon Boots (720 gold) as item 1 in the Carmilla Duo Gold Lane build for Cecilion.\",\"url\":\"https://mlbbhub.com/heroes/cecilion#build-gold-carmilla\"},{\"@type\":\"HowToStep\",\"position\":2,\"name\":\"Buy Clock of Destiny\",\"text\":\"Purchase Clock of Destiny (2,030 gold) as item 2 in the Carmilla Duo Gold Lane build for Cecilion.\",\"url\":\"https://mlbbhub.com/heroes/cecilion#build-gold-carmilla\"},{\"@type\":\"HowToStep\",\"position\":3,\"name\":\"Buy Lightning Truncheon\",\"text\":\"Purchase Lightning Truncheon (2,250 gold) as item 3 in the Carmilla Duo Gold Lane build for Cecilion.\",\"url\":\"https://mlbbhub.com/heroes/cecilion#build-gold-carmilla\"},{\"@type\":\"HowToStep\",\"position\":4,\"name\":\"Buy Holy Crystal\",\"text\":\"Purchase Holy Crystal (3,000 gold) as item 4 in the Carmilla Duo Gold Lane build for Cecilion.\",\"url\":\"https://mlbbhub.com/heroes/cecilion#build-gold-carmilla\"},{\"@type\":\"HowToStep\",\"position\":5,\"name\":\"Buy Genius Wand\",\"text\":\"Purchase Genius Wand (2,000 gold) as item 5 in the Carmilla Duo Gold Lane build for Cecilion.\",\"url\":\"https://mlbbhub.com/heroes/cecilion#build-gold-carmilla\"},{\"@type\":\"HowToStep\",\"position\":6,\"name\":\"Buy Blood Wings\",\"text\":\"Purchase Blood Wings (2,100 gold) as item 6 in the Carmilla Duo Gold Lane build for Cecilion.\",\"url\":\"https://mlbbhub.com/heroes/cecilion#build-gold-carmilla\"}],\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://mlbbhub.com/heroes/cecilion\"},\"datePublished\":\"2026-04-14T00:00:00.000Z\",\"dateModified\":\"2026-05-08T00:00:00.000Z\",\"author\":{\"@type\":\"Organization\",\"name\":\"MLBBHub\",\"url\":\"https://mlbbhub.com\"}}5f:[\"$\",\"script\",\"2\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$64\"}}]\n60:[\"$\",\"$L65\",null,{\"hero\":{\"id\":91,\"name\":\"Cecilion\",\"slug\":\"cecilion\",\"title\":\"Embrace of Night\",\"role\":[\"Mage\"],\"specialty\":[\"Poke\",\"Burst\"],\"lane\":[\"Mid\"],\"tier\":\"B\",\"difficulty\":2,\"releaseYear\":2020,\"stats\":{\"durability\":40,\"offense\":100,\"controlEffect\":50,\"difficulty\":40},\"winRate\":51,\"pickRate\":0.64,\"banRate\":0.14,\"counters\":{\"strongAgainst\":[{\"heroSlug\":\"balmond\",\"heroName\":\"Balmond\",\"advantage\":\"strong\",\"tip\":\"Cecilion counters less mobile Fighters like Balmond and Terizla because these heroes have a hard time getting close to Cecilion while Cecilion can more easily hit them with his skills.\"},{\"heroSlug\":\"terizla\",\"heroName\":\"Terizla\",\"advantage\":\"strong\",\"tip\":\"Cecilion counters less mobile Fighters like Balmond and Terizla because these heroes have a hard time getting close to Cecilion while Cecilion can more easily hit them with his skills.\"}],\"weakAgainst\":[{\"heroSlug\":\"ling\",\"heroName\":\"Ling\",\"advantage\":\"weak\",\"tip\":\"Cecilion is countered by Assassins who can quickly close the gap like Ling and Fanny because Cecilion lacks defensive tools and his normal skills cannot hit enemies in melee range.\"},{\"heroSlug\":\"fanny\",\"heroName\":\"Fanny\",\"advantage\":\"weak\",\"tip\":\"Cecilion is countered by Assassins who can quickly close the gap like Ling and Fanny because Cecilion lacks defensive tools and his normal skills cannot hit enemies in melee range.\"}]},\"splashArt\":\"https://akmweb.youngjoygame.com/web/svnres/file/mlbb/homepage/100_71d6b7fc8cfe8fd9b0c20ad3be1af4e8.jpg\",\"portrait\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_045399c265021d47da6512e6de20b64f.png\",\"officialMatchups\":[{\"kind\":\"best_ally\",\"heroId\":\"91\",\"heroName\":\"Cecilion\",\"heroSlug\":\"cecilion\",\"icon\":\"https://akmwebstatic.yuanzhanapp.com/web/madmin/image_a66ec3b1b8036839538cc0ade8aff50c.jpg\",\"tip\":\"Carmilla；Diggie\"},{\"kind\":\"counters\",\"heroId\":\"83\",\"heroName\":\"X.Borg\",\"heroSlug\":\"x-borg\",\"icon\":\"https://akmwebstatic.yuanzhanapp.com/web/madmin/image_1d4d7dfe38cb5e0fcfcf06b8af6b2103.png\",\"tip\":\"X.Borg；Eudora；Kimmy\"},{\"kind\":\"countered_by\",\"heroId\":\"56\",\"heroName\":\"Gusion\",\"heroSlug\":\"gusion\",\"icon\":\"https://akmweb.youngjoygame.com/web/madmin/image/0226b7cc6015fb50aa8ff4e1c9cf8c62.png?w=150-150-242539\",\"tip\":\"Gusion；Wanwan；Silvanna\"}],\"skills\":{\"skills\":[{\"name\":\"Overflowing\",\"type\":\"Passive\",\"description\":\"Cecilion gains 10 extra Max Mana and recovers 10 Mana each time his skill hits an enemy. Cooldown: 1s.\\n\\nCecilion has higher Max Mana and Mana Regen, and his skill damage scales with his Max Mana.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Cecilion gains 10 extra Max Mana and recovers 10 Mana each time his skill hits an enemy. Cooldown: 1s.\\n\\nCecilion has higher Max Mana and Mana Regen, and his skill damage scales with his Max Mana.\"}],\"cooldown\":null,\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_3d927bf75488e56e28187ea65cafcfa5.png\",\"tags\":[\"Buff\"]},{\"name\":\"Bat Impact\",\"type\":\"Skill 1\",\"description\":\"Cecilion commands a giant bat to dive at the target location, gaining 30% extra Movement Speed for 1s, dealing 85 (+70% Total Magic Power) (+7% Total Mana) Magic Damage to enemies in its path. The bat also deals 170 (+140% Total Magic Power) (+14% Total Mana) extra Magic Damage to those near the landing point, and applies Overflowing effect once.\\n\\nEach subsequent cast within 6s increases this skill's Mana cost by 1.5 times (up to 4 stacks).\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Cecilion commands a giant bat to dive at the target location, gaining 30% extra Movement Speed for 1s, dealing 85\"},{\"type\":\"text\",\"text\":\" (+70% Total Magic Power)\",\"color\":\"#62f8fe\"},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"(+7% Total Mana)\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" Magic Damage to enemies in its path. The bat also deals 170\"},{\"type\":\"text\",\"text\":\" (+140% Total Magic Power)\",\"color\":\"#62f8fe\"},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"(+14% Total Mana)\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" extra Magic Damage to those near the landing point, and applies \"},{\"type\":\"text\",\"text\":\"Overflowing\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" effect once.\\n\\nEach subsequent cast within 6s increases this skill's Mana cost by 1.5 times (up to 4 stacks).\"}],\"cooldown\":\"1.5s\",\"manaCost\":\"75\",\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_e3e1041a481d1f37d892f6489879a794.png\",\"tags\":[\"AOE\",\"Speed Up\"]},{\"name\":\"Sanguine Claws\",\"type\":\"Skill 2\",\"description\":\"Cecilion summons a pair of opposing claws at the target location that will clasp together after a short delay, pulling enemies in their paths to the center while dealing them 200 (+45% Total Magic Power) (+1.2% Total Mana) Magic Damage and immobilizing them for 1s.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Cecilion summons a pair of opposing claws at the target location that will clasp together after a short delay, pulling enemies in their paths to the center while dealing them 200\"},{\"type\":\"text\",\"text\":\" (+45% Total Magic Power)\",\"color\":\"#62f8fe\"},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"(+1.2% Total Mana)\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" Magic Damage and immobilizing them for 1s.\"}],\"cooldown\":\"12s\",\"manaCost\":\"95\",\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_c03dcb05c090b95763374caea670a966.png\",\"tags\":[\"CC\",\"AOE\"]},{\"name\":\"Bats Feast\",\"type\":\"Skill 3\",\"description\":\"Cecilion unleashes his Blood Demon power, gaining 60% Movement Speed (decays over the duration) and Slow Immunity for 1.5s.\\n\\nMeanwhile, he fires 36 bolts of blood energy at nearby enemies, each dealing 35 (+8% Total Magic Power) (+0.3% Total Mana) Magic Damage and slowing enemies hit by 3% for 1s (up to 30%total).\\nEach bolt that hits restores HP equal to 10 plus 1% of Cecilion's lost HP.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Cecilion unleashes his Blood Demon power, gaining 60% Movement Speed (decays over the duration) and Slow Immunity for 1.5s.\\n\\nMeanwhile, he fires 36 bolts of blood energy at nearby enemies, each dealing 35\"},{\"type\":\"text\",\"text\":\" (+8% Total Magic Power)\",\"color\":\"#62f8fe\"},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"(+0.3% Total Mana)\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" Magic Damage and slowing enemies hit by 3% for 1s (up to 30%total).\\nEach bolt that hits restores HP equal to 10 plus 1% of Cecilion's lost HP.\"}],\"cooldown\":\"44s\",\"manaCost\":\"150\",\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_dc9c4f09f975249b8587a6fdf61c8af3.png\",\"tags\":[\"Burst\",\"Speed Up\"]},{\"name\":\"Moonlit Waltz\",\"type\":\"Ultimate\",\"description\":\"When Carmilla is nearby, Cecilion can summon her to become a Vermil Shadow around him, granting him a 520-800 shield (scales with Carmilla's level).\\nCarmilla can choose to leave Cecilion and charge at the target location, gaining an equal shield while dealing 520-800 Magic Damage (scales with level) to nearby enemies and slowing them by 30% for 1s.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"When Carmilla is nearby, Cecilion can summon her to become a Vermil Shadow around him, granting him a 520-800 shield (scales with Carmilla's level).\\nCarmilla can choose to leave Cecilion and charge at the target location, gaining an equal shield while dealing 520-800 Magic Damage (scales with level) to nearby enemies and slowing them by 30% for 1s.\"}],\"cooldown\":\"45s\",\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_44c27e7071734bb9f074bfa9c60c17b6.png\",\"tags\":[\"Shield\",\"Slow\"]}],\"skillUpgradePriority\":\"3-1-2\",\"skillPriorityTip\":\"1st Skill，2ND Skill，Ultimate Skill\",\"skillPriorityTipRich\":[{\"type\":\"text\",\"text\":\"1st Skill，2ND Skill，Ultimate Skill\"}]},\"synergies\":[{\"heroSlug\":\"carmilla\",\"heroName\":\"Carmilla\",\"synergyScore\":8,\"reason\":\"Cecilion works well with Tanks with sustained CC abilities, such as Carmilla and Minotaur, since their CC can help Cecilion land his skills.\"},{\"heroSlug\":\"minotaur\",\"heroName\":\"Minotaur\",\"synergyScore\":8,\"reason\":\"Cecilion works well with Tanks with sustained CC abilities, such as Carmilla and Minotaur, since their CC can help Cecilion land his skills.\"}],\"combos\":[{\"type\":\"teamfight\",\"title\":\"TEAMFIGHT COMBOS\",\"description\":\"In teamfights, initiate with Cecilion's Ultimate to slow the enemy, then hit them with his 1st Skill. When the time is right, pull the enemies together using his 2nd Skill and spam his 1st Skill for damage.\",\"skillSequence\":[{\"skillId\":9130,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_dc9c4f09f975249b8587a6fdf61c8af3.png\"},{\"skillId\":9110,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_e3e1041a481d1f37d892f6489879a794.png\"},{\"skillId\":9120,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_c03dcb05c090b95763374caea670a966.png\"},{\"skillId\":9110,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_e3e1041a481d1f37d892f6489879a794.png\"}]},{\"type\":\"laning\",\"title\":\"LANING COMBOS\",\"description\":\"In the laning phase, use Cecilion's 2nd Skill to pull enemies together, then repeatedly hit them with his 1st Skill.\",\"skillSequence\":[{\"skillId\":9120,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_c03dcb05c090b95763374caea670a966.png\"},{\"skillId\":9110,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_e3e1041a481d1f37d892f6489879a794.png\"}]}],\"metaDescription\":\"Cecilion build, counter, and strategy guide for MLBB. Clock of Destiny + Lightning Truncheon spike, Carmilla duo draft, mana stacking, when NOT to pick him.\",\"builds\":[],\"overviewLede\":\"Cecilion is not a mage in the burst sense. He is a mana-stacking countdown wrapped in a robe, a hero whose damage grows every time he casts a skill and whose usefulness is measured in how long the game goes. Draft him into the right shell and he wins fights at minute 20 that no other mage can win; draft him into the wrong one and he never reaches minute 20.\"},\"serverLocale\":\"en\",\"curatedBuilds\":{\"source\":\"curated\",\"hero\":\"cecilion\",\"patch\":\"2.1.67\",\"lastReviewed\":\"2026-05-08\",\"stalePatch\":true,\"currentPatch\":\"2.2.16a\",\"builds\":[{\"slot\":1,\"id\":\"mid-default\",\"name\":\"Mid Lane Standard\",\"roleContext\":\"Mid\",\"items\":[{\"slug\":\"demon-boots\",\"name\":\"Demon Boots\",\"cost\":720,\"fixed\":false},{\"slug\":\"clock-of-destiny\",\"name\":\"Clock of Destiny\",\"cost\":2030,\"fixed\":false},{\"slug\":\"lightning-truncheon\",\"name\":\"Lightning Truncheon\",\"cost\":2250,\"fixed\":false},{\"slug\":\"holy-crystal\",\"name\":\"Holy Crystal\",\"cost\":3000,\"fixed\":false},{\"slug\":\"divine-glaive\",\"name\":\"Divine Glaive\",\"cost\":1970,\"fixed\":false},{\"slug\":\"blood-wings\",\"name\":\"Blood Wings\",\"cost\":2100,\"fixed\":false}],\"coreItems\":[{\"slug\":\"clock-of-destiny\",\"name\":\"Clock of Destiny\"},{\"slug\":\"lightning-truncheon\",\"name\":\"Lightning Truncheon\"},{\"slug\":\"divine-glaive\",\"name\":\"Divine Glaive\"}],\"emblem\":{\"slug\":\"mage\",\"name\":\"Mage Emblem\",\"talents\":[{\"slug\":\"rupture\",\"name\":\"Rupture\",\"iconUrl\":\"/images/talents/rupture.png\",\"bucket\":\"standard\"},{\"slug\":\"weapon-master\",\"name\":\"Weapon Master\",\"iconUrl\":\"/images/talents/weapon-master.png\",\"bucket\":\"standard\"},{\"slug\":\"impure-rage\",\"name\":\"Impure Rage\",\"iconUrl\":\"/images/talents/impure-rage.png\",\"bucket\":\"core\"}]},\"spell\":{\"slug\":\"flicker\",\"name\":\"Flicker\"},\"blessing\":null,\"flexItems\":[{\"item\":{\"slug\":\"genius-wand\",\"name\":\"Genius Wand\"},\"replace\":{\"slug\":\"holy-crystal\",\"name\":\"Holy Crystal\"},\"trigger\":\"Enemy has stacked magic defense early (Belerick, Gloo, Barats, Esmeralda). Genius Wand shreds MDEF faster than Holy Crystal multiplies raw damage.\"},{\"item\":{\"slug\":\"winter-crown\",\"name\":\"Winter Crown\"},\"replace\":{\"slug\":\"blood-wings\",\"name\":\"Blood Wings\"},\"trigger\":\"Enemy has two or more untargetable assassins (Ling, Natalia, Fanny). Frozen active buys 2 seconds for your team to collapse.\"},{\"item\":{\"slug\":\"glowing-wand\",\"name\":\"Glowing Wand\"},\"replace\":{\"slug\":\"holy-crystal\",\"name\":\"Holy Crystal\"},\"trigger\":\"Your lane phase is forcing you below 50% HP often or the enemy has heavy sustain (Uranus, Esmeralda, Rafaela support). Scorch burn plus Lifebane anti-heal cut.\"}],\"notes\":\"Standard ranked build for squishy matchups. Holy Crystal converts early lead into faster spike timings, Blood Wings closes with a defensive layer Cecilion's kit cannot provide.\",\"totalCost\":12070,\"statLines\":[{\"key\":\"magicpower\",\"labelKey\":\"common.stats.magicPower\",\"unit\":\"flat\",\"group\":\"offensive\",\"value\":435,\"sources\":[\"Clock of Destiny\",\"Lightning Truncheon\",\"Holy Crystal\",\"Divine Glaive\",\"Blood Wings\"]},{\"key\":\"magicpen\",\"labelKey\":\"common.stats.magicPenetration\",\"unit\":\"percent\",\"group\":\"offensive\",\"value\":40,\"sources\":[\"Divine Glaive\"]},{\"key\":\"hp\",\"labelKey\":\"common.stats.hp\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":400,\"sources\":[\"Clock of Destiny\"]},{\"key\":\"mp\",\"labelKey\":\"common.stats.mana\",\"unit\":\"flat\",\"group\":\"utility\",\"value\":800,\"sources\":[\"Clock of Destiny\",\"Lightning Truncheon\"]},{\"key\":\"mpregen\",\"labelKey\":\"common.stats.manaRegen\",\"unit\":\"flat\",\"group\":\"utility\",\"value\":10,\"sources\":[\"Demon Boots\"]},{\"key\":\"movespeed\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"flat\",\"group\":\"utility\",\"value\":40,\"sources\":[\"Demon Boots\"]},{\"key\":\"cdreduction\",\"labelKey\":\"common.stats.cooldownReduction\",\"unit\":\"percent\",\"group\":\"utility\",\"value\":20,\"sources\":[\"Clock of Destiny\",\"Lightning Truncheon\"]}],\"conflicts\":[],\"simulatorUrl\":\"/build-simulator?hero=cecilion\u0026items=demon-boots%2Cclock-of-destiny%2Clightning-truncheon%2Choly-crystal%2Cdivine-glaive%2Cblood-wings\u0026spell=flicker\u0026emblem=mage\u0026talents=rupture%2Cweapon-master%2Cimpure-rage\u0026flex=genius-wand.holy-crystal%2Cwinter-crown.blood-wings%2Cglowing-wand.holy-crystal\"},{\"slot\":2,\"id\":\"mid-antitank\",\"name\":\"Anti-Tank Shred\",\"roleContext\":\"Mid\",\"items\":[{\"slug\":\"demon-boots\",\"name\":\"Demon Boots\",\"cost\":720,\"fixed\":false},{\"slug\":\"clock-of-destiny\",\"name\":\"Clock of Destiny\",\"cost\":2030,\"fixed\":false},{\"slug\":\"lightning-truncheon\",\"name\":\"Lightning Truncheon\",\"cost\":2250,\"fixed\":false},{\"slug\":\"genius-wand\",\"name\":\"Genius Wand\",\"cost\":2000,\"fixed\":false},{\"slug\":\"divine-glaive\",\"name\":\"Divine Glaive\",\"cost\":1970,\"fixed\":false},{\"slug\":\"glowing-wand\",\"name\":\"Glowing Wand\",\"cost\":2050,\"fixed\":false}],\"coreItems\":[{\"slug\":\"clock-of-destiny\",\"name\":\"Clock of Destiny\"},{\"slug\":\"lightning-truncheon\",\"name\":\"Lightning Truncheon\"},{\"slug\":\"genius-wand\",\"name\":\"Genius Wand\"}],\"emblem\":{\"slug\":\"mage\",\"name\":\"Mage Emblem\",\"talents\":[{\"slug\":\"rupture\",\"name\":\"Rupture\",\"iconUrl\":\"/images/talents/rupture.png\",\"bucket\":\"standard\"},{\"slug\":\"weapon-master\",\"name\":\"Weapon Master\",\"iconUrl\":\"/images/talents/weapon-master.png\",\"bucket\":\"standard\"},{\"slug\":\"impure-rage\",\"name\":\"Impure Rage\",\"iconUrl\":\"/images/talents/impure-rage.png\",\"bucket\":\"core\"}]},\"spell\":{\"slug\":\"flicker\",\"name\":\"Flicker\"},\"blessing\":null,\"flexItems\":[{\"item\":{\"slug\":\"holy-crystal\",\"name\":\"Holy Crystal\"},\"replace\":{\"slug\":\"glowing-wand\",\"name\":\"Glowing Wand\"},\"trigger\":\"Enemy tanks are the only HP stackers and have minimal sustain. Raw magic power scales harder vs single high-HP targets.\"},{\"item\":{\"slug\":\"wishing-lantern\",\"name\":\"Wishing Lantern\"},\"replace\":{\"slug\":\"glowing-wand\",\"name\":\"Glowing Wand\"},\"trigger\":\"Enemy runs three or more HP-stacking frontliners without healing. Butterfly Goddess 10% current HP nuke triggers constantly from Cecilion's multi-hit kit.\"},{\"item\":{\"slug\":\"winter-crown\",\"name\":\"Winter Crown\"},\"replace\":{\"slug\":\"glowing-wand\",\"name\":\"Glowing Wand\"},\"trigger\":\"Enemy dives through the frontline to reach you. Sacrifice the HP% burn slot for the survival button.\"}],\"notes\":\"When enemy has two or more high-HP frontliners. Genius Wand stacks MDEF shred on every S1 cast, Glowing Wand burns HP% and cuts sustain. Divine Glaive multiplies the shred for true tank-killing output.\",\"totalCost\":11020,\"statLines\":[{\"key\":\"magicpower\",\"labelKey\":\"common.stats.magicPower\",\"unit\":\"flat\",\"group\":\"offensive\",\"value\":315,\"sources\":[\"Clock of Destiny\",\"Lightning Truncheon\",\"Genius Wand\",\"Divine Glaive\",\"Glowing Wand\"]},{\"key\":\"magicpen\",\"labelKey\":\"common.stats.magicPenetration\",\"unit\":\"percent\",\"group\":\"offensive\",\"value\":40,\"sources\":[\"Divine Glaive\"]},{\"key\":\"magicpenFlat\",\"labelKey\":\"common.stats.magicPenetration\",\"unit\":\"flat\",\"group\":\"offensive\",\"value\":10,\"sources\":[\"Genius Wand\"]},{\"key\":\"hp\",\"labelKey\":\"common.stats.hp\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":700,\"sources\":[\"Clock of Destiny\",\"Glowing Wand\"]},{\"key\":\"mp\",\"labelKey\":\"common.stats.mana\",\"unit\":\"flat\",\"group\":\"utility\",\"value\":800,\"sources\":[\"Clock of Destiny\",\"Lightning Truncheon\"]},{\"key\":\"mpregen\",\"labelKey\":\"common.stats.manaRegen\",\"unit\":\"flat\",\"group\":\"utility\",\"value\":10,\"sources\":[\"Demon Boots\"]},{\"key\":\"movespeed\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"flat\",\"group\":\"utility\",\"value\":40,\"sources\":[\"Demon Boots\"]},{\"key\":\"movespeedPct\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"percent\",\"group\":\"utility\",\"value\":10,\"sources\":[\"Genius Wand\",\"Glowing Wand\"]},{\"key\":\"cdreduction\",\"labelKey\":\"common.stats.cooldownReduction\",\"unit\":\"percent\",\"group\":\"utility\",\"value\":20,\"sources\":[\"Clock of Destiny\",\"Lightning Truncheon\"]}],\"conflicts\":[],\"simulatorUrl\":\"/build-simulator?hero=cecilion\u0026items=demon-boots%2Cclock-of-destiny%2Clightning-truncheon%2Cgenius-wand%2Cdivine-glaive%2Cglowing-wand\u0026spell=flicker\u0026emblem=mage\u0026talents=rupture%2Cweapon-master%2Cimpure-rage\u0026flex=holy-crystal.glowing-wand%2Cwishing-lantern.glowing-wand%2Cwinter-crown.glowing-wand\"},{\"slot\":3,\"id\":\"gold-carmilla\",\"name\":\"Carmilla Duo Gold Lane\",\"roleContext\":\"Gold\",\"items\":[{\"slug\":\"demon-boots\",\"name\":\"Demon Boots\",\"cost\":720,\"fixed\":false},{\"slug\":\"clock-of-destiny\",\"name\":\"Clock of Destiny\",\"cost\":2030,\"fixed\":false},{\"slug\":\"lightning-truncheon\",\"name\":\"Lightning Truncheon\",\"cost\":2250,\"fixed\":false},{\"slug\":\"holy-crystal\",\"name\":\"Holy Crystal\",\"cost\":3000,\"fixed\":false},{\"slug\":\"genius-wand\",\"name\":\"Genius Wand\",\"cost\":2000,\"fixed\":false},{\"slug\":\"blood-wings\",\"name\":\"Blood Wings\",\"cost\":2100,\"fixed\":false}],\"coreItems\":[{\"slug\":\"clock-of-destiny\",\"name\":\"Clock of Destiny\"},{\"slug\":\"lightning-truncheon\",\"name\":\"Lightning Truncheon\"},{\"slug\":\"holy-crystal\",\"name\":\"Holy Crystal\"}],\"emblem\":{\"slug\":\"mage\",\"name\":\"Mage Emblem\",\"talents\":[{\"slug\":\"rupture\",\"name\":\"Rupture\",\"iconUrl\":\"/images/talents/rupture.png\",\"bucket\":\"standard\"},{\"slug\":\"weapon-master\",\"name\":\"Weapon Master\",\"iconUrl\":\"/images/talents/weapon-master.png\",\"bucket\":\"standard\"},{\"slug\":\"impure-rage\",\"name\":\"Impure Rage\",\"iconUrl\":\"/images/talents/impure-rage.png\",\"bucket\":\"core\"}]},\"spell\":{\"slug\":\"flicker\",\"name\":\"Flicker\"},\"blessing\":null,\"flexItems\":[{\"item\":{\"slug\":\"divine-glaive\",\"name\":\"Divine Glaive\"},\"replace\":{\"slug\":\"genius-wand\",\"name\":\"Genius Wand\"},\"trigger\":\"Enemy runs standard frontline without stacked magic defense. Penetration scales better than shred in even matchups.\"},{\"item\":{\"slug\":\"winter-crown\",\"name\":\"Winter Crown\"},\"replace\":{\"slug\":\"blood-wings\",\"name\":\"Blood Wings\"},\"trigger\":\"Enemy coordinates multiple divers onto your lane. Carmilla's shield plus Frozen buys two survival layers.\"},{\"item\":{\"slug\":\"glowing-wand\",\"name\":\"Glowing Wand\"},\"replace\":{\"slug\":\"genius-wand\",\"name\":\"Genius Wand\"},\"trigger\":\"Extended sustain fights where Carmilla is tanking and you need the HP burn from range.\"}],\"notes\":\"Gold lane build for the Carmilla pair. Carmilla's frontline presence covers Divine Glaive slot; Holy Crystal plus Genius Wand front-loads damage for Moonlit Waltz engages. Blood Wings shield resets between waves when Carmilla soaks pressure.\",\"totalCost\":12100,\"statLines\":[{\"key\":\"magicpower\",\"labelKey\":\"common.stats.magicPower\",\"unit\":\"flat\",\"group\":\"offensive\",\"value\":450,\"sources\":[\"Clock of Destiny\",\"Lightning Truncheon\",\"Holy Crystal\",\"Genius Wand\",\"Blood Wings\"]},{\"key\":\"magicpenFlat\",\"labelKey\":\"common.stats.magicPe