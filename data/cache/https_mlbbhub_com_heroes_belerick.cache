"children\":[\"1.81\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"32.18\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Epic\"}}]]}]]}],[\"$\",\"article\",\"legend\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #4dc9f6, #4dc9f633)\",\"boxShadow\":\"0 0 12px -2px #4dc9f680\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#4dc9f6\",\"background\":\"#4dc9f61a\",\"border\":\"1px solid #4dc9f640\"},\"children\":\"Legend\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Belerick\",\"rank\":\"Legend\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=legend\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Legend\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Legend\",\"name\":\"Belerick\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"53.63\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Belerick\",\"delta\":\"+1.50%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"1.66\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"55.05\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Legend\"}}]]}]]}],[\"$\",\"article\",\"mythic\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[\"$L9e\",\"$L9f\",\"$La0\"]}],\"$La1\",\"$La2\"]}]\n7e:[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}]\n7f:[\"$\",\"p\",\"p-4\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Belerick works because every enemy attack against him creates a second problem for the attacker. Deadly Thorns turns incoming damage into return fire, and his passive makes HP from equipment and emblems more valuable than it looks on the item card. He wants enemies to choose between ignoring him while he blocks space or hitting him and paying for the privilege.\"}]\n80:[\"$\",\"p\",\"p-5\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"That identity explains the rest of the kit. Ancient Seed is not a sniper skill. It is a delayed line of denial that punishes the path an enemy wants to take. Nature's Strike is the glue: it speeds Belerick up, gives him a slowed enhanced hit, heals him, and comes back faster when thorns keep triggering. Wrath of Dryad is the punishment button once multiple enemies have already stepped inside his body range.\"}]\n81:[\"$\",\"p\",\"p-6\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The mistake is treating Belerick like a hard engage hero. He is stronger as a contact tax. Walk into the route the enemy carry needs, force them to spend attacks into you, then use the taunt after their dash, battle spell, or cleanse has already been pressured.\"}]\n82:[\"$\",\"h2\",\"h2-2\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Laning: the first eight minutes\"]}]\n83:[\"$\",\"ol\",\"ol-0\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Guard the first jungle entrance, not a side lane.\"}],\" Take Ancient Seed first and stand where your jungler can punish anyone who walks into the river or buff choke. Plant the seed on the exit path, because the taunt matters only if the enemy is forced to keep moving through it.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Unlock Nature's Strike before forcing a real fight.\"}],\" Belerick needs the speed-up and enhanced slow before his delayed taunt becomes reliable. At level 2, play around river vision and crab contests rather than standing in lane soaking minions your core should collect.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Spend spell tempo only when it creates a kill or objective.\"}],\" Vengeance is for the moment the enemy carry has committed to attacking you. Flicker is for crossing the last gap before S1 or ultimate. Revitalize is for a Turtle or tower fight where your team will stay inside the healing field.\"]}],\"\\n\"]}]\n84:[\"$\",\"p\",\"p-7\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Your first eight minutes should create information. Check bushes with your body only when your damage dealer can hit the revealed target. Rotate before the Turtle timer, sit between your jungler and the enemy mid, and do not chase a marksman across lane if it leaves your own jungle entrance uncovered.\"}]\n85:[\"$\",\"h2\",\"h2-3\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The spike is when burn and anti-sustain overlap\"]}]\n86:[\"$\",\"p\",\"p-8\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Belerick farms toward a two-item defensive identity, not a burst combo. Cursed Helmet plus Dominance Ice around the 9 to 12 minute window changes him from a bodyguard into a walking fight tax. Cursed Helmet gives him HP, nearby burn, and extra wave pressure. Dominance Ice taxes whoever stays close enough to fight you: nearby enemies' healing and shields weaken to 60% of normal while Fortress Shield stacks Hybrid Defense on you, which lines up exactly with a taunt.\"}]\n87:[\"$\",\"p\",\"p-9\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Once both pieces are online, his job changes. Before the spike, you are buying space and avoiding pointless solo deaths. After the spike, you can stand at the mouth of Lord pit, under a contested outer turret, or in front of a siege wave and ask the enemy marksman to make the first mistake. If they hit you, they lose tempo to thorns, burn, Lifebane pressure, and your returning Nature's Strike.\"}]\n88:[\"$\",\"p\",\"p-10\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Do not confuse the spike with permission to 1v5. Belerick still needs allies close enough to convert the taunt. The item pair buys time and punishes sustained damage, but it does not replace burst follow-up from your mage, jungler, or gold laner.\"}]\n89:[\"$\",\"$La3\",null,{\"slot\":\"7246933188\",\"variant\":\"in-article\",\"className\":\"my-8\"}]\n8a:[[\"$\",\"h2\",\"h2-0\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Teamfight positioning and target priority\"]}],\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The common wrong reflex is turning around to chase every assassin who appears behind you. Belerick's peel is delayed, and delayed peel loses to fast burst. Your better answer is to control the lane the enemy carry or fighter must use before the dive starts.\"}],\"\\n\",[\"$\",\"ol\",\"ol-0\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Stand one body length in front of your damage line.\"}],\" If you stand too far ahead, the enemy kites you. If you stand behind your marksman, you are asking Ancient Seed to solve a problem after the damage has already landed.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Hold S1 until the movement decision is forced.\"}],\" Cast it on the retreat line after Nature's Strike slows, after a wall or jungle choke limits the path, or after your teammate has already started a CC chain. Raw S1 into open ground is a warning, not a catch.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Use ultimate for clusters, not ego duels.\"}],\" Wrath of Dryad wins when two or more enemies are grouped around Lord, Turtle, a turret dive, or a choke entrance. Spending it on one mobile assassin usually trades your best fight button for a target your team still cannot reach.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"There is one support-dependent edge case. With Estes, Rafaela, or Angela behind him, Belerick can take the first contact earlier because extra healing extends the thorns window. Without that support layer, he must be stricter: show first, absorb the first rotation, then re-engage only when his damage dealers are in range.\"}],\"\\n\",[\"$\",\"h2\",\"h2-1\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Itemization: locked jobs and real flex slots\"]}],\"\\n\",[\"$\",\"p\",\"p-2\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Belerick's item logic starts with jobs, not a fixed six-item chant. Roam boots are mandatory when he is the roamer. Tough Boots are the default because crowd control duration matters more than a small armor bump, while the blessing depends on the fight plan. Encourage is the default when your damage line wants attack speed and extra damage. Conceal is the engage version when your team lacks a clean fog entry. Favor is weaker on him because his self-only healing does not trigger the blessing for allies.\"}],\"\\n\",[\"$\",\"p\",\"p-3\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Cursed Helmet is the usual HP and burn piece when the enemy has to fight near you. Dominance Ice is the anti-sustain answer when the enemy carry, fighter, or healer relies on healing or shields. Those two items are the core conversation in most ranked Belerick games.\"}],\"\\n\",\"$La4\",\"\\n\",\"$La5\",\"\\n\",\"$La6\",\"\\n\",\"$La7\",\"\\n\",\"$La8\",\"\\n\",\"$La9\",\"\\n\",\"$Laa\",\"\\n\",\"$Lab\",\"\\n\",\"$Lac\",\"\\n\",\"$Lad\",\"\\n\",\"$Lae\",\"\\n\",\"$Laf\",\"\\n\",\"$Lb0\"]\n8b:[\"$\",\"$Lb1\",null,{\"heroName\":\"Belerick\"}]\n"])</script><script>self.__next_f.push([1,"8c:[\"$\",\"$L6a\",\"brody\",{\"href\":\"/heroes/brody\",\"className\":\"group block\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative bg-surface-4 border border-mlbb-gold/20 overflow-hidden card-hover hover:border-mlbb-gold/50\",\"style\":{\"boxShadow\":\"0 2px 8px rgba(0,0,0,0.3)\"},\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 p-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative w-14 h-14 rounded-full overflow-hidden flex-shrink-0 bg-surface-3\",\"children\":[\"$\",\"$L6b\",null,{\"src\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_cbb309b63cdf838fce79bd9cb95d4ed7.png\",\"alt\":\"Brody - The Lone Star\",\"unoptimized\":false,\"priority\":\"$undefined\",\"fetchPriority\":\"$undefined\",\"fill\":true,\"className\":\"object-cover group-hover:scale-110 transition-transform duration-300\",\"sizes\":\"56px\",\"placeholder\":\"blur\",\"blurDataURL\":\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTAwIiBoZWlnaHQ9IjEwMCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48cmVj