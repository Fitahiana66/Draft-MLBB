6E"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trending-down w-3.5 h-3.5" aria-hidden="true"><path d="M16 17h6v-6"></path><path d="m22 17-8.5-8.5-5 5L2 7"></path></svg>+<!-- -->2.0</p><p class="text-[9px] text-text-muted uppercase hidden sm:block">win rate delta</p></div></div><div class="absolute top-0 left-0 w-3 h-3 border-t border-l border-mlbb-gold/20 pointer-events-none"></div><div class="absolute bottom-0 right-0 w-3 h-3 border-b border-r border-mlbb-gold/20 pointer-events-none"></div></div><div class="group relative bg-surface-3 border border-mlbb-gold/15 hover:border-mlbb-green/30 transition-all duration-300" style="opacity:0;transform:translateY(12px)"><div class="flex items-center gap-3 p-3 sm:gap-4 sm:p-4"><div class="flex-shrink-0 w-7 sm:w-8 text-center"><span class="text-base sm:text-lg font-heading font-bold text-text-accent">#<!-- -->8</span></div><a class="flex-shrink-0" href="/heroes/aurora"><div class="relative overflow-hidden flex-shrink-0 rounded-full" style="width:48px;height:48px;min-width:48px;background-color:#9B59B612"><img alt="Aurora hero icon" loading="lazy" width="48" height="48" decoding="async" data-nimg="1" class="h-full w-full object-cover" style="color:transparent" srcSet="https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_f9b2be0150361018bb98f941b9667c42.png&amp;w=48&amp;output=webp&amp;q=75&amp;we 1x, https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_f9b2be0150361018bb98f941b9667c42.png&amp;w=96&amp;output=webp&amp;q=75&amp;we 2x" src="https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_f9b2be0150361018bb98f941b9667c42.png&amp;w=96&amp;output=webp&amp;q=75&amp;we"/></div></a><div class="min-w-0 flex-1"><div class="flex items-center gap-2 sm:gap-3 flex-wrap"><a class="min-w-0 max-w-full truncate font-heading font-bold text-base sm:text-lg text-text-primary hover:text-text-accent-bright transition-colors" href="/heroes/aurora">Aurora</a><div class="inline-flex items-center justify-center font-heading font-bold bg-gradient-to-br from-[#9BA0B4] to-[#606478] text-[#101012] w-6 h-6 text-xs animate-tier-pop">C</div><div class="gap-1.5 hidden sm:flex"><span class="text-[10px] px-1.5 py-0.5" style="background-color:#9B59B620;color:#b98bcc">Mage</span></div></div><p class="text-xs text-text-muted mt-1 line-clamp-2">Belerick has a favourable matchup against Aurora based on ranked data, so expect a win rate advantage in this matchup.</p></div><div class="flex-shrink-0 text-right"><p class="flex items-center justify-end gap-1 text-lg sm:text-xl font-heading font-bold" style="color:#C8AA6E"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trending-down w-3.5 h-3.5" aria-hidden="true"><path d="M16 17h6v-6"></path><path d="m22 17-8.5-8.5-5 5L2 7"></path></svg>+<!-- -->1.6</p><p class="text-[9px] text-text-muted uppercase hidden sm:block">win rate delta</p></div></div><div class="absolute top-0 left-0 w-3 h-3 border-t border-l border-mlbb-gold/20 pointer-events-none"></div><div class="absolute bottom-0 right-0 w-3 h-3 border-b border-r border-mlbb-gold/20 pointer-events-none"></div></div></div></section></div><section class="grid gap-3 md:grid-cols-3"><a class="block" href="/heroes/rafaela"><div class="h-full border border-mlbb-gold/18 bg-surface-2/82 p-4 transition-colors hover:border-mlbb-gold-bright/35"><p class="mb-1 font-heading text-[10px] font-bold uppercase tracking-[0.16em] text-text-accent">Official Ally Note</p><h3 class="font-heading text-base font-bold text-text-primary">Rafaela</h3><p class="mt-2 text-xs leading-relaxed text-text-muted">DPS heroes with recovery ability are the perfect matches with Belerick, since they add to Belerick&#x27;s durability, so he can deal more damage.</p></div></a><a class="block" href="/heroes/miya"><div class="h-full border border-mlbb-gold/18 bg-surface-2/82 p-4 transition-colors hover:border-mlbb-gold-bright/35"><p class="mb-1 font-heading text-[10px] font-bold uppercase tracking-[0.16em] text-text-accent">Official Counter Note</p><h3 class="font-heading text-base font-bold text-text-primary">Miya</h3><p class="mt-2 text-xs leading-relaxed text-text-muted">Belerick is a squishy killer. Do not retreat when using Belerick and just rush to the enemy suqishy heroes face.If those heroes run away, then you&#x27;re half way to victory.</p></div></a><a class="block" href="/heroes/gusion"><div class="h-full border border-mlbb-gold/18 bg-surface-2/82 p-4 transition-colors hover:border-mlbb-gold-bright/35"><p class="mb-1 font-heading text-[10px] font-bold uppercase tracking-[0.16em] text-text-accent">Official Threat Note</p><h3 class="font-heading text-base font-bold text-text-primary">Gusion</h3><p class="mt-2 text-xs leading-relaxed text-text-muted">Belerick is vulnerable against the heroes that could deal a high amount of damage. His passive won&#x27;t help that much when facing these kinds of heroes, for he won&#x27;t have the time to convert his passive into damage.</p></div></a></section><section><div class="mb-4"><div class="flex items-center gap-3 mb-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock w-5 h-5 text-text-accent-bright" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg><h2 class="text-lg md:text-xl font-heading font-bold text-text-primary">Game Phase Analysis for<!-- --> <span style="color:#F0D060">Belerick</span></h2></div><p class="text-xs text-text-muted max-w-2xl">Belerick&#x27;s 10 measured matchups do not separate by match length: no phase leads the others by more than that sample can resolve. There is no single window where Belerick drops off, so focus on consistent play and team coordination.</p></div><div class="grid grid-cols-1 sm:grid-cols-3 gap-4"><div class="bg-surface-3 border border-mlbb-gold/15 p-4" style="opacity:0;transform:translateY(15px)"><div class="flex items-center justify-between mb-1"><span class="text-xs font-heading font-bold text-text-primary uppercase tracking-wider">Early Game</span><span class="text-[10px] text-text-muted">0-10 min</span></div><p class="text-base font-heading font-bold mb-2" style="color:#9BA0B4">No measured separation</p><div class="w-full h-2 bg-surface-4 overflow-hidden"><div class="h-full" style="background-color:#9BA0B4;width:0px"></div></div></div><div class="bg-surface-3 border border-mlbb-gold/15 p-4" style="opacity:0;transform:translateY(15px)"><div class="flex items-center justify-between mb-1"><span class="text-xs font-heading font-bold text-text-primary uppercase tracking-wider">Mid Game</span><span class="text-[10px] text-text-muted">10-16 min</span></div><p class="text-base font-heading font-bold mb-2" style="color:#9BA0B4">No measured separation</p><div class="w-full h-2 bg-surface-4 overflow-hidden"><div class="h-full" style="background-color:#9BA0B4;width:0px"></div></div></div><div class="bg-surface-3 border border-mlbb-gold/15 p-4" style="opacity:0;transform:translateY(15px)"><div class="flex items-center justify-between mb-1"><span class="text-xs font-heading font-bold text-text-primary uppercase tracking-wider">Late Game</span><span class="text-[10px] text-text-muted">16+ min</span></div><p class="text-base font-heading font-bold mb-2" style="color:#9BA0B4">No measured separation</p><div class="w-full h-2 bg-surface-4 overflow-hidden"><div class="h-full" style="background-color:#9BA0B4;width:0px"></div></div></div></div><p class="text-[10px] text-text-muted/80 mt-3 max-w-3xl">Shape only, from the 10 matchups measured for Belerick. The bars rank Belerick&#x27;s own phases against each other, not against other heroes, and are not win rates.</p></section></div></div><div id="tabpanel-builds" role="tabpanel" aria-labelledby="tab-builds" tabindex="0" hidden=""><section class="space-y-3 sm:space-y-4"><div class="flex flex-col gap-3 xl:flex-row xl:items-end xl:justify-between xl:gap-8"><header class="min-w-0"><h2 class="font-heading text-lg font-bold uppercase leading-tight tracking-[0.06em] text-mlbb-text sm:text-2xl"><span class="text-mlbb-gold-bright">Belerick</span> <span class="text-mlbb-text/85">Best Builds, Emblems</span> <span class="text-mlbb-text/60">&amp;</span> <span class="text-mlbb-text/85">Talents</span></h2><p class="mt-1 hidden max-w-3xl text-sm text-mlbb-text-secondary sm:block xl:hidden">Three battle-tested loadouts. Pick the one that fits the draft, not the one with the most flash.</p><div class="mt-1.5 flex flex-wrap items-center gap-x-2.5 gap-y-1"><span class="font-heading text-[10px] font-bold uppercase tracking-[0.2em] text-text-muted">Patch <!-- -->2.1.67</span><span title="These loadouts were last re-read on patch 2.1.67; the live patch is 2.2.16a. Item stats may have changed." class="inline-flex flex-shrink-0 items-center gap-1 border border-amber-400/25 bg-amber-400/10 px-1.5 py-0.5 font-heading text-[9px] font-bold uppercase leading-none tracking-[0.1em] text-amber-300/90"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-history h-2.5 w-2.5" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path><path d="M12 7v5l4 2"></path></svg>Older patch</span><span class="font-heading text-[10px] font-bold uppercase tracking-[0.2em] text-text-accent/70">Reviewed May 7, 2026</span></div></header><div role="tablist" aria-label="Builds" class="grid gap-1.5 sm:gap-2 xl:w-[620px] xl:shrink-0" style="grid-template-columns:repeat(3, minmax(0, 1fr))"><button type="button" role="tab" id="build-tab-1" aria-selected="true" aria-controls="build-1" class="relative flex min-h-[44px] min-w-0 cursor-pointer items-center gap-2 border px-2 py-1.5 text-left transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mlbb-gold sm:px-3 sm:py-2 border-mlbb-gold-bright/60 bg-mlbb-gold/10"><span class="font-heading text-[11px] font-bold tabular-nums sm:text-xs text-text-accent-bright" aria-hidden="true">01</span><span class="min-w-0 font-heading text-[10px] font-bold uppercase leading-tight tracking-wide line-clamp-3 sm:line-clamp-2 sm:text-xs text-mlbb-text">Roam Punishment</span></button><button type="button" role="tab" id="build-tab-2" aria-selected="false" aria-controls="build-2" class="relative flex min-h-[44px] min-w-0 cursor-pointer items-center gap-2 border px-2 py-1.5 text-left transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mlbb-gold sm:px-3 sm:py-2 border-mlbb-gold/18 bg-surface-2/70 hover:border-mlbb-gold/40"><span class="font-heading text-[11px] font-bold tabular-nums sm:text-xs text-text-accent/70" aria-hidden="true">02</span><span class="min-w-0 font-heading text-[10px] font-bold uppercase leading-tight tracking-wide line-clamp-3 sm:line-clamp-2 sm:text-xs text-mlbb-text-secondary">Fog Engage</span></button><button type="button" role="tab" id="build-tab-3" aria-selected="false" aria-controls="build-3" class="relative flex min-h-[44px] min-w-0 cursor-pointer items-center gap-2 border px-2 py-1.5 text-left transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mlbb-gold sm:px-3 sm:py-2 border-mlbb-gold/18 bg-surface-2/70 hover:border-mlbb-gold/40"><span class="font-heading text-[11px] font-bold tabular-nums sm:text-xs text-text-accent/70" aria-hidden="true">03</span><span class="min-w-0 font-heading text-[10px] font-bold uppercase leading-tight tracking-wide line-clamp-3 sm:line-clamp-2 sm:text-xs text-mlbb-text-secondary">Anti-Basic Wall</span></button></div></div><article id="build-1" role="tabpanel" aria-labelledby="build-tab-1" class="group/build relative overflow-hidden border border-mlbb-gold/22 bg-surface-2/92 scroll-mt-24" style="box-shadow:0 1px 0 rgba(255,255,255,0.04) inset, 0 30px 60px -36px rgba(0,0,0,0.95);opacity:0;transform:translateY(24px)"><div class="pointer-events-none absolute inset-0 opacity-[0.06] hex-pattern" aria-hidden="true"></div><div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-mlbb-gold-bright/80 to-transparent" aria-hidden="true"></div><div class="pointer-events-none absolute left-0 top-0 h-full w-[3px] bg-gradient-to-b from-mlbb-gold-bright/70 via-mlbb-gold/30 to-transparent" aria-hidden="true"></div><div class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full blur-3xl transition-opacity duration-500 group-hover/build:opacity-90" aria-hidden="true" style="background-color:#3498DB1f"></div><span class="pointer-events-none absolute -right-4 top-2 font-heading text-[140px] font-black leading-none text-text-accent-bright/[0.04] sm:-right-2 sm:top-0 sm:text-[180px]" aria-hidden="true">01</span><div class="relative p-4 sm:p-5"><header class="mb-4 flex flex-col gap-2.5 sm:flex-row sm:flex-wrap sm:items-start sm:justify-between"><div class="min-w-0 flex-1"><h3 class="font-heading text-xl font-bold uppercase leading-tight tracking-[0.04em] text-mlbb-text sm:text-2xl">Roam Punishment</h3><p class="mt-1.5 max-w-2xl text-[13px] leading-relaxed text-mlbb-text-secondary sm:text-sm xl:max-w-none">Default roam setup for punishing attack-speed carries that keep hitting your frontline.</p></div><div class="flex flex-wrap items-center gap-2 sm:shrink-0"><div class="flex items-center gap-1.5 border border-mlbb-gold-bright/35 bg-gradient-to-br from-mlbb-gold-bright/12 to-mlbb-gold-bright/2 px-3 py-1.5"><span class="font-heading text-[9px] font-bold uppercase tracking-[0.2em] text-text-accent/85">Cost</span><span class="font-heading text-[13px] font-bold tracking-wide text-text-accent-bright">11,100<!-- -->g</span></div><a target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 border border-mlbb-blue/35 bg-gradient-to-br from-mlbb-blue/14 to-mlbb-blue/3 px-3 py-1.5 font-heading text-[11px] font-bold uppercase tracking-[0.16em] text-mlbb-blue-light transition-all duration-200 hover:border-mlbb-blue-light/60 hover:bg-mlbb-blue/20 hover:text-[#9fdcff]" href="/build-simulator?hero=belerick&amp;items=tough-boots%2Ccursed-helmet%2Cdominance-ice%2Coracle%2Cimmortality%2Cguardian-helmet&amp;blessing=encourage&amp;spell=vengeance&amp;emblem=tank&amp;talents=vitality%2Ctenacity%2Cbrave-smite&amp;flex=athenas-shield.oracle%2Cradiant-armor.oracle">Simulator<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-external-link h-3 w-3" aria-hidden="true"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg></a></div></header><div class="lg:grid lg:grid-cols-[minmax(0,1.45fr)_minmax(0,1fr)] lg:gap-x-5 lg:gap-y-4 xl:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)]"><div class="mb-4 lg:col-start-1 lg:row-start-1 lg:mb-0"><div class="relative"><div class="pointer-events-none absolute left-[8%] right-[8%] top-[22px] h-px sm:top-[30px]" aria-hidden="true" style="background:linear-gradient(90deg, transparent, rgba(200,170,110,0.45) 12%, rgba(240,208,96,0.55) 50%, rgba(200,170,110,0.45) 88%, transparent)"></div><div class="relative grid grid-cols-6 gap-1.5 sm:gap-3.5"><div class="min-w-0" style="opacity:0;transform:translateY(8px)"><a class="grou