e-2/70 hover:border-mlbb-gold/40"><span class="font-heading text-[11px] font-bold tabular-nums sm:text-xs text-text-accent/70" aria-hidden="true">02</span><span class="min-w-0 font-heading text-[10px] font-bold uppercase leading-tight tracking-wide line-clamp-3 sm:line-clamp-2 sm:text-xs text-mlbb-text-secondary">Roam Anti-Sustain Defense</span></button><button type="button" role="tab" id="build-tab-3" aria-selected="false" aria-controls="build-3" class="relative flex min-h-[44px] min-w-0 cursor-pointer items-center gap-2 border px-2 py-1.5 text-left transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-mlbb-gold sm:px-3 sm:py-2 border-mlbb-gold/18 bg-surface-2/70 hover:border-mlbb-gold/40"><span class="font-heading text-[11px] font-bold tabular-nums sm:text-xs text-text-accent/70" aria-hidden="true">03</span><span class="min-w-0 font-heading text-[10px] font-bold uppercase leading-tight tracking-wide line-clamp-3 sm:line-clamp-2 sm:text-xs text-mlbb-text-secondary">Roam Dire Hit Burst</span></button></div></div><article id="build-1" role="tabpanel" aria-labelledby="build-tab-1" class="group/build relative overflow-hidden border border-mlbb-gold/22 bg-surface-2/92 scroll-mt-24" style="box-shadow:0 1px 0 rgba(255,255,255,0.04) inset, 0 30px 60px -36px rgba(0,0,0,0.95);opacity:0;transform:translateY(24px)"><div class="pointer-events-none absolute inset-0 opacity-[0.06] hex-pattern" aria-hidden="true"></div><div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-mlbb-gold-bright/80 to-transparent" aria-hidden="true"></div><div class="pointer-events-none absolute left-0 top-0 h-full w-[3px] bg-gradient-to-b from-mlbb-gold-bright/70 via-mlbb-gold/30 to-transparent" aria-hidden="true"></div><div class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full blur-3xl transition-opacity duration-500 group-hover/build:opacity-90" aria-hidden="true" style="background-color:#2ECC711f"></di