ceptional\",\"rawTier\":\"Exceptional\",\"tag\":\"Special\",\"tagSlug\":\"special\",\"price\":null,\"portraitFile\":\"Hero1025-portrait.png\",\"portraitUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/mathilda/Hero1025-portrait-20260923043715.webp\",\"splashUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/mathilda/Mathilda-Arcane-Verdict-20260924034158.webp\",\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Mathilda/Cosmetics\"},{\"name\":\"Dreambound Pixie\",\"tier\":\"Deluxe\",\"rawTier\":\"Deluxe\",\"tag\":\"Epic\",\"tagSlug\":\"epic\",\"price\":\"Limited-time Event\",\"portraitFile\":\"Hero1026-portrait.png\",\"portraitUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/mathilda/Hero1026-portrait-20250109154335.webp\",\"splashUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/mathilda/Mathilda-Dreambound-Pixie-20250109163214.webp\",\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Mathilda/Cosmetics\"}],\"lore\":{\"backstory\":\"Mathilda is a wandering guardian from the outskirts of the Moniyan Empire, gifted with the rare ability to channel wind magic into protective wisps that orbit her allies. She was once a handmaiden in a noble house until her latent powers awakened during an Abyssal raid, saving her entire household. Recognizing her duty, Mathilda left the comfort of nobility to roam the Land of Dawn, offering her protection to those in need. Her wind wisps can carry allies to safety or launch devastating synchronized attacks.\",\"allies\":[{\"heroSlug\":\"arlott\",\"heroName\":\"Arlott\",\"relationship\":\"Half-demon knight she helped escape execution\"},{\"heroSlug\":\"angela\",\"heroName\":\"Angela\",\"relationship\":\"Fellow support who shares her protective calling\"}],\"rivals\":[{\"heroSlug\":\"helcurt\",\"heroName\":\"Helcurt\",\"relationship\":\"Shadow predator that stalks those she guards\"},{\"heroSlug\":\"nolan\",\"heroName\":\"Nolan\",\"relationship\":\"Dimensional assassin whose rifts scatter her wisps\"}]},\"loreUrlName\":\