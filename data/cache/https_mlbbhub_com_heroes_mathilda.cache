":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-trending-up inline-block w-2.5 h-2.5 sm:w-3.5 sm:h-3.5 text-text-muted\",\"aria-hidden\":\"true\",\"children\":[\"$L9e\",\"$L9f\",\"$undefined\"]}],\"+0.01%\"]}]]}]}],\"$La0\",\"$La1\"]]}]\n7c:[\"$\",\"p\",null,{\"className\":\"mt-3 flex flex-wrap items-center gap-x-5 gap-y-1.5 text-[11px] text-text-muted\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-1.5\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block h-3 w-5 rounded-sm bg-mlbb-gold/[0.07] ring-1 ring-inset ring-mlbb-gold/20\",\"aria-hidden\":\"true\"}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankColDelta\"}]]}],[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-1.5\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-trending-up h-3.5 w-3.5 text-text-muted\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"box55l\",{\"d\":\"M16 7h6v6\"}],[\"$\",\"path\",\"1t1m79\",{\"d\":\"m22 7-8.5 8.5-5-5L2 17\"}],\"$undefined\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankColTrend\",\"params\":{\"days\":7}}]]}]]}]\n7d:[\"$\",\"div\",null,{\"className\":\"mt-5 grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-3\",\"children\":[[\"$\",\"article\",\"epic\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #B07ECC, #B07ECC33)\",\"boxShadow\":\"0 0 12px -2px #B07ECC80\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#B07ECC\",\"background\":\"#B07ECC1a\",\"border\":\"1px solid #B07ECC40\"},\"children\":\"Epic\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Mathilda\",\"rank\":\"Epic\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=epic\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Epic\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Epic\",\"name\":\"Mathilda\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"45.90\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Mathilda\",\"delta\":\"+1.29%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.04\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.08\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Epic\"}}]]}]]}],[\"$\",\"article\",\"legend\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #4dc9f6, #4dc9f633)\",\"boxShadow\":\"0 0 12px -2px #4dc9f680\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#4dc9f6\",\"background\":\"#4dc9f61a\",\"border\":\"1px solid #4dc9f640\"},\"children\":\"Legend\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Mathilda\",\"rank\":\"Legend\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=legend\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Legend\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Legend\",\"name\":\"Mathilda\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"45.24\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Mathilda\",\"delta\":\"+0.63%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.09\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.13\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Legend\"}}]]}]]}],[\"$\",\"article\",\"mythic\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[\"$La2\",\"$La3\",\"$La4\"]}],\"$La5\",\"$La6\"]}]\n7f:[\"$\",\"h2\",\"h2-1\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Everything runs through Guiding Wind\"]}]\n80:[\"$\",\"p\",\"p-4\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Soul Bloom deals real burst damage and Circling Eagle's knockup is a genuine teamfight disruptor. But neither of those matters unless Guiding Wind is doing its job, because Guiding Wind is what separates Mathilda from every other support: it lets her hand one ally a free Flicker on a short cooldown.\"}]\n81:[\"$\",\"p\",\"p-5\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The mechanic is positional, not targeted. Mathilda leaps to a spot, a circular field forms around her, and the first ally who walks into the field gets pulled to her position and shares her speed boost. This means two things. First, Mathilda has to telegraph the jump to the ally who needs it, either through voice comms or by placing the field directly in front of them. Second, the window is brief: the buff expires moments after the ally leaves the field, so the decision to commit has to happen immediately.\"}]\n82:[\"$\",\"p\",\"p-6\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The failure mode is Mathilda jumping in alone, nobody following, and eating three people's attention while her ally stands outside the field wondering what to do. This is not a kit problem. It is a coordination problem, and it is the entire reason Mathilda underperforms in solo queue relative to her five-stack ceiling.\"}]\n83:[\"$\",\"h2\",\"h2-2\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The first eight minutes\"]}]\n84:[\"$\",\"p\",\"p-7\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Mathilda's opening eight minutes are about information and timing, not kills.\"}]\n85:[\"$\",\"ol\",\"ol-0\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Start near the bottom buff, then rotate toward mid.\"}],\" Accompany your jungler to their first clear for vision, then position in the river between mid and jungle to threaten both lanes. Do not camp in one spot. Your passive charges while you move, so every rotation generates passive procs.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Use Soul Bloom as a threat, not a burst.\"}],\" Walking for the full charge window generates up to 6 wisps. Most players release too early at 2-3 wisps. Instead, S1 in the river, walk until the cast refreshes, then release only when at least 4 wisps are charged. A full-stack Soul Bloom on an out-of-position mid laner forces a Flash or scores a kill.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Save Guiding Wind for the commit, not the approach.\"}],\" Using S2 to close distance in the early game burns the cooldown you need for the actual gank. Walk to position, then S2 into the gank window so your assassin jumps with you.\"]}],\"\\n\"]}]\n86:[\"$\",\"h2\",\"h2-3\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Fleeting Time is the hinge item\"]}]\n87:[\"$\",\"p\",\"p-8\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Before Fleeting Time, Mathilda has one Circling Eagle per teamfight. After it, she can get it back mid-fight. Every kill or assist while the ult is on cooldown reduces it by 30%, which in a drawn-out skirmish means a second use before the fight resolves.\"}]\n88:[\"$\",\"p\",\"p-9\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Build it first after boots. Around the 12 to 14 minute mark you should have Arcane Boots with the Favor enchant and Fleeting Time completed. That is when Mathilda stops being a roam tax and starts being a fight engine. Favor tops up the lowest-HP ally every time she lands a shield, so the sustain rides on skills she is casting anyway; Fleeting Time handles the rest.\"}]\n89:[\"$\",\"p\",\"p-10\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Oracle is the second required item. Its Bless passive raises the shields and HP regen Mathilda receives by 25%, which makes the shield she keeps for herself on every Guiding Wind meaningfully larger. On a hero whose mid-game identity is built around that shield, the boost is not marginal.\"}]\n8a:[\"$\",\"h2\",\"h2-4\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Circling Eagle: mark the carry, not the tank\"]}]\n8b:[\"$\",\"p\",\"p-11\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The wrong reflex in a teamfight is targeting whoever is closest. Circling Eagle's value comes from what happens when it lands, not just the damage it deals. The knockup at the end creates a brief lock for your team to pile onto. Mark the enemy carry with that window, not the tank.\"}]\n8c:[\"$\",\"p\",\"p-12\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Two rules for positioning during the orbit:\"}]\n8d:[\"$\",\"ol\",\"ol-1\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Do not orbit toward your own team.\"}],\" The final dash path is toward the Soul Mark. If enemies are standing between you and the marked target when you dash, the knockup hits them and the mark transfers. A knocked tank means the carry escapes untouched.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Cast Guiding Wind during the orbit.\"}],\" Mathilda can use S2 while circling without breaking the orbit. This is how she calls in a cleanup assassin to the marked target's position while she is still locked in the ult animation. Used correctly, it synchronizes the assassin's arrival with her knockup.\"]}],\"\\n\"]}]\n8e:[\"$\",\"p\",\"p-13\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"After the knockup: immediately trigger Soul Bloom if you have wisps built up. The mark still exists on the knocked enemy for a moment, and Soul Bloom prioritizes marked targets, so the burst follows the CC naturally.\"}]\n8f:[\"$\",\"$La7\",null,{\"slot\":\"7246933188\",\"variant\":\"in-article\",\"className\":\"my-8\"}]\n90:[[\"$\",\"h2\",\"h2-0\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Itemization: three locks and two real conversations\"]}],\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Arcane Boots with Favor, Fleeting Time, and Oracle are fixed. They cover the three things Mathilda needs: rotation sustain, ult frequency, and shield amplification.\"}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The remaining three slots are situational:\"}],\"\\n\",[\"$\",\"ul\",\"ul-0\",{\"className\":\"list-disc list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Dominance Ice\"}],\" is the default fourth item against drafts that win through healing, and it now answers magic damage as much as physical. Both of its passives work off the enemies standing near Mathilda: Fortress Shield adds Hybrid Defense for each hero within 5 units, and Lifebane cuts their shields and HP regen to 60% of normal, which is exactly what breaks a sustain-heavy enemy trying to grind through her.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Antique Cuirass\"}],\" over Dominance Ice when the physical threat is skill-based and the enemy has no healing worth cutting. Deter stacks to three charges and reduces physical damage per charge, which is negligible against a Karrie but significant against a Paquito or Zilong landing repeated skillsets.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Athena's Shield\"}],\" when the enemy mage or magic jungler is fed and you need the magic damage reduction window. The 25% reduction triggers on the first hit after returning from combat, which lines up well with Mathilda's approach pattern before every ult.\"]}],\"\\n\",[\"$\",\"li\",\"li-3\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Immortality\"}],\" belongs in the sixth slot, not bought mid-game as a panic purchase. The second life lets you complete an orbit and knockup even if you enter a fight at low HP.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",\"p-2\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The boot enchant is always Favor. Encourage has value on passive supports who stay glued to the carry all game; Mathilda rotates too frequently for its damage buff to sit on the right people.\"}],\"\\n\",[\"$\",\"h2\",\"h2-1\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Mistakes that lose Mathilda games\"]}],\"\\n\",[\"$\",\"p\",\"p-3\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Releasing Soul Bloom at two or three wisps.\"}],\" Two wisps is light poke. Six wisps can kill a squishy target. The charge window feels long when you are in a fight, so most players panic-release early. Hold the skill until the wisp count is near maximum, then trigger. The damage difference is large enough to change outcomes.\"]}],\"\\n\",\"$La8\",\"\\n\",\"$La9\",\"\\n\",\"$Laa\",\"\\n\",\"$Lab\",\"\\n\",\"$Lac\",\"\\n\",\"$Lad\",\"\\n\",\"$Lae\",\"\\n\",\"$Laf\",\"\\n\",\"$Lb0\"]\n91:[\"$\",\"$Lb1\",null,{\"heroName\":\"Mathilda\"}]\n"])</script><script>self.__next_f.push([1,"92:[\"$\",\"$L6b\",\"odette\",{\"href\":\"/heroes/odette\",\"className\":\"group block\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative bg-surface-4 border border-mlbb-gold/20 overflow-hidden card-hover hover:border-mlbb-gold/50\",\"style\":{\"boxShadow\":\"0 2px 8px rgba(0,0,0,0.3)\"},\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 p-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative w-14 h-14 rounded-full overflow-hidden flex-shrink-0 bg-surface-3\",\"children\":[\"$\",\"$L6c\",null,{\"src\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_d9251718a8894546ba04cfa9ca68dedc.png\",\"alt\":\"Odette - Swan Princess\",\"unoptimized\":false,\"priority\":\"$undefined\",\"fetchPriority\":\"$undefined\",\"fill\":true,\"className\":\"object-cover group-hover:scale-110 transition-transform duration-300\",\"sizes\":\"56px\",\"placeholder\":\"blur\",\"blurDataURL\":\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTAwIiBoZWlnaHQ9IjEwMCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48cmVjdCB3aWR0aD0iMTAwIiBoZWlnaHQ9IjEwMCIgZmlsbD0iIzBkMTIyNSIvPjwvc3ZnPg==\"}]}],[\"$\",\"div\",null,{\"className\":\"flex-1 min-w-0\",\"children\":[[\"$\",\"h4\",null,{\"className\":\"font-heading fon