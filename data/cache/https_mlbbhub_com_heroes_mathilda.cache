32_1%2F100_9c364f42f896209e76c50e9460a9395e.png&amp;w=48&amp;output=webp&amp;q=75&amp;we 1x, https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_9c364f42f896209e76c50e9460a9395e.png&amp;w=96&amp;output=webp&amp;q=75&amp;we 2x" src="https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_9c364f42f896209e76c50e9460a9395e.png&amp;w=96&amp;output=webp&amp;q=75&amp;we"/></div></span><span class="contents"><span class="inline-flex items-center justify-center w-4 md:w-5 xl:w-3.5 text-base font-heading font-bold leading-none select-none" style="color:#F0D060;text-shadow:0 0 6px #F0D06080" aria-hidden="true">➔</span><div class="relative w-11 h-11 md:w-12 md:h-12 xl:w-10 xl:h-10 flex-shrink-0 overflow-hidden rounded-full flex items-center justify-center" style="background-color:rgba(240,208,96,0.08);border:1.5px solid rgba(240,208,96,0.40);box-shadow:0 0 12px #F0D06025, inset 0 0 0 1px #F0D06030"><img alt="Step 3" loading="lazy" width="48" height="48" decoding="async" data-nimg="1" class="w-full h-full object-cover" style="color:transparent" srcSet="https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_9dade03c4d55cf327e9f1cb279e99f29.png&amp;w=48&amp;output=webp&amp;q=75&amp;we 1x, https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_9dade03c4d55cf327e9f1cb279e99f29.png&amp;w=96&amp;output=webp&amp;q=75&amp;we 2x" src="https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_9dade03c4d55cf327e9f1cb279e99f29.png&amp;w=96&amp;output=webp&amp;q=75&amp;we"/></div></span></div><p class="text-xs md:text-sm text-text-muted leading-relaxed md:flex-1">In teamfights, first activate Mathilda&#x27;s 1st skill,
then immediately use her 2nd Skill to get to a good position to initiate from
and unleash her Ultimate on the primary target. This combo allows Mathilda to quickly CC a key enemy hero, and lets an ally follow up by using Guiding Wind from her 2nd Skill.</p></div></div></section></div></div><div class="grid gap-4 md:gap-5 lg:grid-cols-2 items-start mb-4 md:mb-6"><div class="hero-overview relative lg:pl-4 lg:border-l lg:border-[#C8AA6E]/30"><span class="hidden lg:block absolute left-0 top-0 w-1 h-12 bg-gradient-to-b from-[#F0D060] via-[#C8AA6E] to-transparent" aria-hidden="true"></span><p class="text-[#9BA0B4] leading-relaxed text-sm lg:text-[15px]">Mathilda is not a fighter who happens to support. She is a delivery system dressed as a hero, built to move other people where they need to be and then punish whoever they land on. Get the order of operations right and she is one of the most disruptive roamers in the game; get it wrong and she is a very fast hero with nothing useful to do.</p></div><section class="dossier-card relative bg-surface-2/85 backdrop-blur-sm border border-border-default overflow-hidden" style="box-shadow:0 1px 0 rgba(255,255,255,0.03) inset, 0 18px 38px -22px rgba(0,0,0,0.85)" aria-label="Hero at-a-glance stats and attributes"><div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-mlbb-gold/0 via-mlbb-gold-bright/60 to-mlbb-gold/0" aria-hidden="true"></div><div class="absolute top-0 left-0 w-3 h-3 border-t border-l border-mlbb-gold-bright/55" aria-hidden="true"></div><div class="absolute top-0 right-0 w-3 h-3 border-t border-r border-mlbb-gold-bright/55" aria-hidden="true"></div><div class="absolute bottom-0 left-0 w-3 h-3 border-b border-l border-mlbb-gold/30" aria-hidden="true"></div><div class="absolute bottom-0 right-0 w-3 h-3 border-b border-r border-mlbb-gold/30" aria-hidden="true"></div><div class="relative p-4 md:p-5"><div class="flex items-center gap-2 mb-4"><span class="inline-flex items-center justify-center w-5 h-5 bg-mlbb-green/10 border border-mlbb-green/40" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-activity w-3 h-3 text-mlbb-green" aria-hidden="true"><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"></path></svg></span><p class="text-[11px] font-heading font-bold text-text-accent uppercase tracking-[0.32em]">At a Glance</p></div><div class="grid gap-2.5 sm:grid-cols-2 sm:gap-x-8 sm:gap-y-3"><div class="flex items-center gap-3"><span class="text-[10px] md:text-[11px] text-text-muted font-heading uppercase tracking-[0.14em] w-[72px] md:w-20 flex-shrink-0 font-semibold">Durability</span><div class="relative flex-1 h-2.5 overflow-hidden" style="background:#060913;box-shadow:inset 0 0 0 1px rgba(200,170,110,0.12), inset 0 2px 4px rgba(0,0,0,0.45)"><div class="h-full relative" style="width:80%;background:linear-gradient(90deg, #3498DB80 0%, #3498DB 55%, #3498DB 100%);box-shadow:0 0 8px #3498DBaa, inset 0 0 8px #3498DB40"><div class="absolute inset-0" style="background-image:linear-gradient(105deg, transparent 40%, rgba(255,255,255,0.22) 50%, transparent 60%);mix-blend-mode:overlay" aria-hidden="true"></div></div><div class="absolute inset-0 pointer-events-none" style="background:repeating-linear-gradient(to right, transparent 0, transparent calc(10% - 1px), rgba(0,0,0,0.85) calc(10% - 1px), rgba(0,0,0,0.85) 10%)" aria-hidden="true"></div></div><span class="text-[12px] md:text-[13px] font-heading font-bold tabular-nums w-6 text-right leading-none" style="color:#3498DB;text-shadow:0 0 8px #3498DB50">80</span></div><div class="flex items-center gap-3"><span class="text-[10px] md:text-[11px] text-text-muted font-heading uppercase tracking-[0.14em] w-[72px] md:w-20 flex-shrink-0 font-semibold">Offense</span><div class="relative flex-1 h-2.5 overflow-hidden" style="background:#060913;box-shadow:inset 0 0 0 1px rgba(200,170,110,0.12), inset 0 2px 4px rgba(0,0,0,0.45)"><div class="h-full relative" style="width:20%;background:linear-gradient(90deg, #E74C3C80 0%, #E74C3C 55%, #E74C3C 100%);box-shadow:0 0 8px #E74C3Caa, inset 0 0 8px #E74C3C40"><div class="absolute inset-0" style="background-image:linear-gradient(105deg, transparent 40%, rgba(255,255,255,0.22) 50%, transparent 60%);mix-blend-mode:overlay" aria-hidden="true"></div></div><div class="absolute inset-0 pointer-events-none" style="background:repeating-linear-gradient(to right, transparent 0, transparent calc(10% - 1px), rgba(0,0,0,0.85) calc(10% - 1px), rgba(0,0,0,0.85) 10%)" aria-hidden="true"></div></div><span class="text-[12px] md:text-[13px] font-heading font-bold tabular-nums w-6 text-right leading-none" style="color:#E74C3C;text-shadow:0 0 8px #E74C3C50">20</span></div><div class="flex items-center gap-3"><span class="text-[10px] md:text-[11px] text-text-muted font-heading uppercase tracking-[0.14em] w-[72px] md:w-20 flex-shrink-0 font-semibold">Control</span><div class="relative flex-1 h-2.5 overflow-hidden" style="background:#060913;box-shadow:inset 0 0 0 1px rgba(200,170,110,0.12), inset 0 2px 4px rgba(0,0,0,0.45)"><div class="h-full relative" style="width:40%;background:linear-gradient(90deg, #F0D06080 0%, #F0D060 55%, #F0D060 100%);box-shadow:0 0 8px #F0D060aa, inset 0 0 8px #F0D06040"><div class="absolute inset-0" style="background-image:linear-gradient(105deg, transparent 40%, rgba(255,255,255,0.22) 50%, transparent 60%);mix-blend-mode:overlay" aria-hidden="true"></div></div><div class="absolute inset-0 pointer-events-none" style="background:repeating-linear-gradient(to right, transparent 0, transparent calc(10% - 1px), rgba(0,0,0,0.85) calc(10% - 1px), rgba(0,0,0,0.85) 10%)" aria-hidden="true"></div></div><span class="text-[12px] md:text-[13px] font-heading font-bold tabular-nums w-6 text-right leading-none" style="color:#F0D060;text-shadow:0 0 8px #F0D06050">40</span></div><div class="flex items-center gap-3"><span class="text-[10px] md:text-[11px] text-text-muted font-heading uppercase tracking-[0.14em] w-[72px] md:w-20 flex-shrink-0 font-semibold">Difficulty</span><div class="relative flex-1 h-2.5 overflow-hidden" style="background:#060913;box-shadow:inset 0 0 0 1px rgba(200,170,110,0.12), inset 0 2px 4px rgba(0,0,0,0.45)"><div class="h-full relative" style="width:70%;background:linear-gradient(90deg, #9B59B680 0%, #9B59B6 55%, #9B59B6 100%);box-shadow:0 0 8px #9B59B6aa, inset 0 0 8px #9B59B640"><div class="absolute inset-0" style="background-image:linear-gradient(105deg, transparent 40%, rgba(255,255,255,0.22) 50%, transparent 60%);mix-blend-mode:overlay" aria-hidden="true"></div></div><div class="absolute inset-0 pointer-events-none" style="background:repeating-linear-gradient(to right, transparent 0, transparent calc(10% - 1px), rgba(0,0,0,0.85) calc(10% - 1px), rgba(0,0,0,0.85) 10%)" aria-hidden="true"></div></div><span class="text-[12px] md:text-[13px] font-heading font-bold tabular-nums w-6 text-right leading-none" style="color:#9B59B6;text-shadow:0 0 8px #9B59B650">70</span></div></div><a class="mt-4 inline-flex items-center gap-1.5 text-[11px] font-heading font-bold uppercase tracking-[0.14em] text-text-accent hover:text-text-accent-bright transition-colors" href="/tier-list">See Mathilda in full tier list<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right w-3 h-3" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></div></section></div><div id="ad-4865714798" class="my-6" style="width:100%"><style>#ad-4865714798{min-height:280px}@media(min-width:768px){#ad-4865714798{min-height:280px}}</style><p class="text-[10px] font-heading uppercase tracking-[0.2em] text-[#9BA0B4]/40 text-center mb-2">Advertisement</p><ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-3465999061396690" data-ad-slot="4865714798" data-ad-format="auto" data-full-width-responsive="true"></ins></div><div class="relative content-lazy lg:grid lg:grid-cols-[minmax(0,1fr)_clamp(230px,24%,300px)] lg:gap-x-6 xl:gap-x-8 lg:items-start"><div class="lg:order-2 lg:sticky lg:self-start" style="top:128px"></div><section id="hero-article" class="relative lg:order-1 bg-[#0a0a0a]/85 backdrop-blur-sm border border-[#C8AA6E]/15 p-5 md:p-9 overflow-hidden" style="box-shadow:0 1px 0 rgba(255,255,255,0.03) inset, 0 18px 38px -24px rgba(0,0,0,0.8)"><div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[#F0D060]/55 to-transparent" aria-hidden="true"></div><div class="absolute top-0 left-0 w-3 h-3 border-t border-l border-[#F0D060]/40" aria-hidden="true"></div><div class="absolute top-0 right-0 w-3 h-3 border-t border-r border-[#C8AA6E]/30" aria-hidden="true"></div><div class="absolute bottom-0 left-0 w-3 h-3 border-b border-l border-[#C8AA6E]/30" aria-hidden="true"></div><div class="absolute bottom-0 right-0 w-3 h-3 border-b border-r border-[#C8AA6E]/30" aria-hidden="true"></div><div class="absolute -top-32 -right-24 w-72 h-72 rounded-full bg-[#C8AA6E]/[0.05] blur-3xl pointer-events-none" aria-hidden="true"></div><div class="relative hero-article-body max-w-[860px] mx-auto"><h2 class="text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative"><span aria-hidden="true" class="block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3"></span>The team that earns Mathilda</h2>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">Her last balance pass, 2.1.88 (<a class="text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors" href="/patch-notes">patch notes</a>), sharpened her mid-to-late damage on both Soul Bloom and Circling Eagle and cut her ultimate&#x27;s mana cost, so the engages now carry real burst, not just utility. It does not change who you draft her with.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">Lock Mathilda when you have at least one hero who wants to close gap fast and does their best work right next to an enemy carry. Hayabusa, Gusion, Lancelot, and Saber are the obvious candidates. Less obvious but just as effective: Fanny (Guiding Wind&#x27;s speed boost lets her cable in faster), Yu Zhong in the EXP lane (using S2 to pull him into a midlane skirmish), and burst mages like Lunox who need a single entry window to one-shot.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">The disqualifying test is simple: look at your team comp and ask which hero benefits most from being teleported into the enemy backline right now. If you cannot name one, Mathilda is the wrong pick for this draft.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">On the enemy side, three heroes make her miserable. Franco&#x27;s Bloody Hunt suppresses her during or before Circling Eagle, stopping the orbit cold. Minsitthar&#x27;s King&#x27;s Calling creates an anti-blink zone that prevents her final dash from landing. Lolita&#x27;s Nokhom Shield blocks Soul Bloom wisps entirely, turning S1 into wasted mana. If the enemy team has two of these three, consider Floryn or Estes instead.</p>
<h2 class="text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative"><span aria-hidden="true" class="block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3"></span>Everything runs through Guiding Wind</h2>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">Soul Bloom deals real burst damage and Circling Eagle&#x27;s knockup is a genuine teamfight disruptor. But neither of those matters unless Guiding Wind is doing its job, because Guiding Wind is what separates Mathilda from every other support: it lets her hand one ally a free Flicker on a short cooldown.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">The mechanic is positional, not targeted. Mathilda leaps to a spot, a circular field forms around her, and the first ally who walks into the field gets pulled to her position and shares her speed boost. This means two things. First, Mathilda has to telegraph the jump to the ally who needs it, either through voice comms or by placing the field directly in front of them. Second, the window is brief: the buff expires moments after the ally leaves the field, so the decision to commit has to happen immediately.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">The failure mode is Mathilda jumping in alone, nobody following, and eating three people&#x27;s attention while her ally stands outside the field wondering what to do. This is not a kit problem. It is a coordination problem, and it is the entire reason Mathilda underperforms in solo queue relative to her five-stack ceiling.</p>
<h2 class="text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative"><span aria-hidden="true" class="block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3"></span>The first eight minutes</h2>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">Mathilda&#x27;s opening eight minutes are about information and timing, not kills.</p>
<ol class="list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2">
<li class="text-[#9BA0B4]"><strong class="text-[#E8E6E3] font-semibold">Start near the bottom buff, then rotate toward mid.</strong> Accompany your jungler to their first clear for vision, then position in the river between mid and jungle to threaten both lanes. Do not camp in one spot. Your passive charges while you move, so every rotation generates passive procs.</li>
<li class="text-[#9BA0B4]"><strong class="text-[#E8E6E3] font-semibold">Use Soul Bloom as a threat, not a burst.</strong> Walking for the full charge window generates up to 6 wisps. Most players release too early at 2-3 wisps. Instead, S1 in the river, walk until the cast refreshes, then release only when at least 4 wisps are charged. A full-stack Soul Bloom on an out-of-position mid laner forces a Flash or scores a kill.</li>
<li class="text-[#9BA0B4]"><strong class="text-[#E8E6E3] font-semibold">Save Guiding Wind for the commit, not the approach.</strong> Using S2 to close distance in the early game burns the cooldown you need for the actual gank. Walk to position, then S2 into the gank window so your assassin jumps with you.</li>
</ol>
<h2 class="text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative"><span aria-hidden="true" class="block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3"></span>Fleeting Time is the hinge item</h2>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">Before Fleeting Time, Mathilda has one Circling Eagle per teamfight. After it, she can get it back mid-fight. Every kill or assist while the ult is on cooldown reduces it by 30%, which in a drawn-out skirmish means a second use before the fight resolves.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">Build it first after boots. Around the 12 to 14 minute mark you should have Arcane Boots with the Favor enchant and Fleeting Time completed. That is when Mathilda stops being a roam tax and starts being a fight engine. Favor tops up the lowest-HP ally every time she lands a shield, so the sustain rides on skills she is casting anyway; Fleeting Time handles the rest.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">Oracle is the second required item. Its Bless passive raises the shields and HP regen Mathilda receives by 25%, which makes the shield she keeps for herself on every Guiding Wind meaningfully larger. On a hero whose mid-game identity is built around that shield, the boost is not marginal.</p>
<h2 class="text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative"><span aria-hidden="true" class="block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3"></span>Circling Eagle: mark the carry, not the tank</h2>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">The wrong reflex in a teamfight is targeting whoever is closest. Circling Eagle&#x27;s value comes from what happens when it lands, not just the damage it deals. The knockup at the end creates a brief lock for your team to pile onto. Mark the enemy carry with that window, not the tank.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">Two rules for positioning during the orbit:</p>
<ol class="list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2">
<li class="text-[#9BA0B4]"><strong class="text-[#E8E6E3] font-semibold">Do not orbit toward your own team.</strong> The final dash path is toward the Soul Mark. If enemies are standing between you and the marked target when you dash, the knockup hits them and the mark transfers. A knocked tank means the carry escapes untouched.</li>
<li class="text-[#9BA0B4]"><strong class="text-[#E8E6E3] font-semibold">Cast Guiding Wind during the orbit.</strong> Mathilda can use S2 while circling without breaking the orbit. This is how she calls in a cleanup assassin to the marked target&#x27;s position while she is still locked in the ult animation. Used correctly, it synchronizes the assassin&#x27;s arrival with her knockup.</li>
</ol>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">After the knockup: immediately trigger Soul Bloom if you have wisps built up. The mark still exists on the knocked enemy for a moment, and Soul Bloom prioritizes marked targets, so the burst follows the CC naturally.</p><div id="ad-7246933188" class="my-8" style="width:100%"><style>#ad-7246933188{min-height:280px}@media(min-width:768px){#ad-7246933188{min-height:320px}}</style><p class="text-[10px] font-heading uppercase tracking-[0.2em] text-[#9BA0B4]/40 text-center mb-2">Advertisement</p><ins class="adsbygoogle" style="display:block;text-align:center" data-ad-client="ca-pub-3465999061396690" data-ad-slot="7246933188" data-ad-format="fluid" data-ad-layout="in-article"></ins></div><h2 class="text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative"><span aria-hidden="true" class="block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3"></span>Itemization: three locks and two real conversations</h2>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">Arcane Boots with Favor, Fleeting Time, and Oracle are fixed. They cover the three things Mathilda needs: rotation sustain, ult frequency, and shield amplification.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">The remaining three slots are situational:</p>
<ul class="list-disc list-inside text-[#9BA0B4] my-3 space-y-2 ml-2">
<li class="text-[#9BA0B4]"><strong class="text-[#E8E6E3] font-semibold">Dominance Ice</strong> is the default fourth item against drafts that win through healing, and it now answers magic damage as much as physical. Both of its passives work off the enemies standing near Mathilda: Fortress Shield adds Hybrid Defense for each hero within 5 units, and Lifebane cuts their shields and HP regen to 60% of normal, which is exactly what breaks a sustain-heavy enemy trying to grind through her.</li>
<li class="text-[#9BA0B4]"><strong class="text-[#E8E6E3] font-semibold">Antique Cuirass</strong> over Dominance Ice when the physical threat is skill-based and the enemy has no healing worth cutting. Deter stacks to three charges and reduces physical damage per charge, which is negligible against a Karrie but significant against a Paquito or Zilong landing repeated skillsets.</li>
<li class="text-[#9BA0B4]"><strong class="text-[#E8E6E3] font-semibold">Athena&#x27;s Shield</strong> when the enemy mage or magic jungler is fed and you need the magic damage reduction window. The 25% reduction triggers on the first hit after returning from combat, which lines up well with Mathilda&#x27;s approach pattern before every ult.</li>
<li class="text-[#9BA0B4]"><strong class="text-[#E8E6E3] font-semibold">Immortality</strong> belongs in the sixth slot, not bought mid-game as a panic purchase. The second life lets you complete an orbit and knockup even if you enter a fight at low HP.</li>
</ul>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]">The boot enchant is always Favor. Encourage has value on passive supports who stay glued to the carry all game; Mathilda rotates too frequently for its damage buff to sit on the right people.</p>
<h2 class="text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative"><span aria-hidden="true" class="block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3"></span>Mistakes that lose Mathilda games</h2>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]"><strong class="text-[#E8E6E3] font-semibold">Releasing Soul Bloom at two or three wisps.</strong> Two wisps is light poke. Six wisps can kill a squishy target. The charge window feels long when you are in a fight, so most players panic-release early. Hold the skill until the wisp count is near maximum, then trigger. The damage difference is large enough to change outcomes.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]"><strong class="text-[#E8E6E3] font-semibold">Ulting on the frontline tank.</strong> The orbit feels safe when you are circling someone who cannot kill you before it ends. But the knockup landing on a tank gives the enemy backline free seconds to delete your teammates. Mathilda is control-immune during the orbit, so she does not need the safety of a soft target. Take the risk and mark the carry.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]"><strong class="text-[#E8E6E3] font-semibold">Using Guiding Wind as a personal escape.</strong> S2 is conditionally useful for dodging a single skillshot, but every time you use it solo you burn the window where an ally could have gotten a free teleport into the fight. The solo escape is almost never worth more than the team initiation it costs.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]"><strong class="text-[#E8E6E3] font-semibold">Orbiting into Minsitthar&#x27;s King&#x27;s Calling.</strong> Once you are circling, you cannot cancel. If Minsitthar places his zone before your dash triggers, the final dash fails. Treat King&#x27;s Calling the same way any dash-dependent hero does: do not commit while it is active.</p>
<p class="text-[#9BA0B4] leading-relaxed mb-4 text-[15px]"><strong class="text-[#E8E6E3] font-semibold">Pulling allies backward by mistake.</strong> Guiding Wind deposits the triggered ally at Mathilda&#x27;s current position. If you jump backward while retreating and an ally steps into the field intending to escape with you, they arrive at wherever you landed, which may be deeper in the fight than either of you wanted. Communicate your S2 jumps or allies will walk into your field during retreats expecting an escape and find themselves further forward instead.</p>
<h2 class="text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative"><span aria-hidden="true" class="block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3"></span>Key tips</h2>
<div class="my-5 p-4 flex gap-3" style="background:rgba(200,170,110,0.08);border:1px solid rgba(200,170,110,0.35)"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lightbulb w-4 h-4 flex-shrink-0 mt-0.5" aria-hidden="true" style="color:#C8AA6E"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"></path><path d="M9 18h6"></path><path d="M10 22h4"></path></svg><div class="min-w-0 flex-1"><p class="text-[11px] font-heading font-bold uppercase tracking-wider mb-1" style="color:#C8AA6E">Tip</p><p class="text-sm text-[#9BA0B4] leading-relaxed">Soul Bloom wisp count scales with movement distance, not time elapsed. Activate Sprint or time your Ancestral Guidance passive burst while S1 is charging to cover more ground and reach the 6-wisp cap faster than the enemy expects.</p></div></div>
<div class="my-5 p-4 flex gap-3" style="background:rgba(0,170,255,0.08);border:1px solid rgba(0,170,255,0.35)"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info w-4 h-4 flex-shrink-0 mt-0.5" aria-hidden="true" style="color:#00AAFF"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg><div class="min-w-0 flex-1"><p class="text-[11px] font-heading font-bold uppercase tracking-wider mb-1" style="color:#00AAFF">Note</p><p class="text-sm text-[#9BA0B4] leading-relaxed">Circling Eagle&#x27;s knockup mark transfers to the first enemy hero hit during the final dash, not necessarily the original target. If a tank or frontliner stands between Mathilda and her marked carry, they absorb the knockup and the carry walks free. Aim the dash path with that in mind.</p></div></div>
<div class="my-5 p-4 flex gap-3" style="background:rgba(200,170,110,0.08);border:1px solid rgba(200,170,110,0.35)"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lightbulb w-4 h-4 flex-shrink-0 mt-0.5" aria-hidden="true" style="color:#C8AA6E"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"></path><path d="M9 18h6"></path><path d="M10 22h4"></path></svg><div class="min-w-0 flex-1"><p class="text-[11px] font-heading font-bold uppercase tracking-wider mb-1" style="color:#C8AA6E">Tip</p><p class="text-sm text-[#9BA0B4] leading-relaxed">You can cast Guiding Wind during Circling Eagle without interrupting the orbit. This is Mathilda&#x27;s highest-value play: orbit the carry to hold them in place, then pull your assassin in to finish the job while you are still mid-orbit.</p></div></div>
<div class="my-5 p-4 flex gap-3" style="background:rgba(0,170,255,0.08);border:1px solid rgba(0,170,255,0.35)"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info w-4 h-4 flex-shrink-0 mt-0.5" aria-hidden="true" style="color:#00AAFF"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg><div class="min-w-0 flex-1"><p class="text-[11px] font-heading font-bold uppercase tracking-wider mb-1" style="color:#00AAFF">Note</p><p class="text-sm text-[#9BA0B4] leading-relaxed">Pull Yourself Together on the Support Emblem trims Flicker&#x27;s cooldown, and the trim grows with every kill or assist you stack through the fight. Come out the far side of a long skirmish and Flicker is back a beat early, which is often the one extra entry or escape that decides it. General cooldown reduction from items does not touch battle spells, so this talent is the only lever you have on Flicker&#x27;s timer.</p></div></div><aside class="not-prose mt-10 border border-mlbb-gold/25 bg-mlbb-bg-accent/30 p-5 sm:p-6" aria-label="About the author of this Mathilda guide"><div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:gap-5"><a class="shrink-0" aria-label="About Slendertaker" href="/authors/slendertaker"><img alt="Slendertaker" loading="lazy" width="72" height="72" decoding="async" data-nimg="1" class="h-[72px] w-[72px] rounded-full border border-mlbb-gold/50 object-cover" style="color:transparent" src="/authors/slendertaker.webp"/></a><div class="min-w-0 flex-1"><div class="text-xs uppercase tracking-wider text-mlbb-text-secondary">Written by</div><a class="font-heading text-lg text-mlbb-gold hover:text-mlbb-gold-bright" rel="author" href="/authors/slendertaker">Slendertaker</a><div class="text-sm text-mlbb-text-secondary">Mythic Immortal, Founder &amp; Editor of MLBBHub</div><p class="mt-3 text-sm leading-relaxed text-mlbb-text">Slendertaker climbed to Mythic Immortal in Mobile Legends, the apex of the ranked ladder, before sitting down to build the tool he wished existed while he was getting there. MLBBHub is that tool. He writes every hero guide on the site personally, picks the curated builds, and owns the data pipeline that keeps patch notes, items, and emblems in sync.</p><div class="mt-4 flex flex-wrap gap-2"><a href="https://github.com/slendertaker" target="_blank" rel="nofollow noopener noreferrer me" class="inline-flex items-center gap-1.5 border border-mlbb-gold/30 bg-mlbb-bg-accent/40 px-3 py-1 text-xs text-mlbb-text-secondary transition hover:border-mlbb-gold hover:text-mlbb-gold-bright" aria-label="GitHub profile"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-github" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg><span>GitHub</span></a><a href="https://x.com/slendertaker7" target="_blank" rel="nofollow noopener noreferrer me" class="inline-flex items-center gap-1.5 border border-mlbb-gold/30 bg-mlbb-bg-accent/40 px-3 py-1 text-xs text-mlbb-text-secondary transition hover:border-mlbb-gold hover:text-mlbb-gold-bright" aria-label="X profile"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-twitter" aria-hidden="true"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg><span>X</span></a><a href="https://slendertaker.com" target="_blank" rel="nofollow noopener noreferrer me" class="inline-flex items-center gap-1.5 border border-mlbb-gold/30 bg-mlbb-bg-accent/40 px-3 py-1 text-xs text-mlbb-text-secondary transition hover:border-mlbb-gold hover:text-mlbb-gold-bright" aria-label="slendertaker.com profile"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-external-link" aria-hidden="true"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg><span>slendertaker.com</span></a></div></div></div></aside></div></section></div></div><div id="tabpanel-skills" role="tabpanel" aria-labelledby="tab-skills" hidden=""></div><div id="tabpanel-matchups" role="tabpanel" aria-labelledby="tab-matchups" tabindex="0" hidden=""><div class="space-y-6 lg:space-y-8"><div class="glass-card border-mlbb-gold/15 p-4 sm:p-5" style="opacity:0;transform:translateY(-8px)"><div class="grid grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-x-3 gap-y-4 lg:grid-cols-[auto_auto_minmax(0,1fr)_auto] lg:gap-x-5"><div class="w-10 h-10 bg-mlbb-red/10 border border-mlbb-red/30 flex items-center justify-center"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield w-5 h-5 text-mlbb-red" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path></svg></div><div class="min-w-0"><p class="text-xs font-heading font-bold text-text-primary uppercase tracking-wider">Top Counter</p><p class="flex min-w-0 flex-wrap items-baseline gap-x-1.5 text-sm text-text-accent-bright font-heading font-bold"><span class="min-w-0 truncate">Esmeralda</span><span class="shrink-0 text-mlbb-green text-xs">+<!-- -->4.3<!-- --> pp</span></p></div><a aria-label="Open full counter page for Mathilda" class="group inline-flex h-8 items-center justify-center gap-1.5 border border-mlbb-gold/20 bg-surface-2/45 px-2.5 font-heading text-[10px] font-bold uppercase tracking-wider text-text-accent transition-colors hover:border-mlbb-gold-bright/45 hover:text-text-accent-bright lg:col-start-4 lg:row-start-1" href="/counter/mathilda"><span>View all</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a><div class="col-span-3 grid gap-2 text-center grid-cols-3 sm:flex sm:items-center sm:justify-around lg:col-span-1 lg:col-start-3 lg:row-start-1"><div><p class="text-lg font-heading font-bold text-mlbb-green">8</p><p class="text-[9px] text-text-muted uppercase tracking-wider">Counters</p></div><div><p class="text-lg font-heading font-bold text-text-accent">10</p><p class="text-[9px] text-text-muted uppercase tracking-wider">Weak To</p></div><div><p class="text-lg font-heading font-bold text-text-accent-bright truncate">Balanced</p><p class="text-[9px] text-text-muted uppercase tracking-wider">Peak Phase</p></div></div></div></div><div class="grid gap-6 lg:grid-cols-2 lg:items-start lg:gap-6"><section><div class="mb-4"><div class="flex items-center gap-3 mb-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield w-5 h-5 text-mlbb-green" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path></svg><h2 class="text-lg md:text-xl font-heading font-bold text-text-primary">How to Counter<!-- --> <span style="color:#ff4444">Mathilda</span></h2></div><p class="text-xs text-text-muted max-w-2xl">These heroes have the biggest measured edge against Mathilda in ranked matches. Pick any of them for a statistical advantage in draft.</p></div><div class="space-y-3"><div class="group relative bg-surface-3 border border-mlbb-gold/15 hover:border-mlbb-green/30 transition-all duration-300" style="opacity:0;transform:translateY(12px)"><div class="flex items-center gap-3 p-3 sm:gap-4 sm:p-4"><div class="flex-shrink-0 w-7 sm:w-8 text-center"><span class="text-base sm:text-lg font-heading font-bold text-text-accent">#<!-- -->1</span></div><a class="flex-shrink-0" href="/heroes/esmeralda"><div class="relative overflow-hidden flex-shrink-0 rounded-full" style="width:48px;height:48px;min-width:48px;background-color:#3498DB12"><img alt="Esmeralda hero icon" loading="lazy" width="48" height="48" decoding="async" data-nimg="1" class="h-full w-full object-cover" style="color:transparent" srcSet="https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_4661a64a2c6b724e7b67032fcbface27.png&amp;w=48&amp;output=webp&amp;q=75&amp;we 1x, https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_4661a64a2c6b724e7b67032fcbface27.png&amp;w=96&amp;output=webp&amp;q=75&amp;we 2x" src="https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_4661a64a2c6b724e7b67032fcbface27.png&amp;w=96&amp;output=webp&amp;q=75&amp;we"/></div></a><div class="min-w-0 flex-1"><div class="flex items-center gap-2 sm:gap-3 flex-wrap"><a class="min-w-0 max-w-full truncate font-heading font-bold text-base sm:text-lg text-text-primary hover:text-text-accent-bright transition-colors" href="/heroes/esmeralda">Esmeralda</a><div class="inline-flex items-center justify-center font-heading font-bold bg-gradient-to-br from-[#9BA0B4] to-[#606478] text-[#101012] w-6 h-6 text-xs animate-tier-pop">C</div><div class="gap-1.5 hidden sm:flex"><span class="text-[10px] px-1.5 py-0.5" style="background-color:#3498DB20;color:#71b7e6">Tank</span><span class="text-[10px] px-1.5 py-0.5" style="background-color:#9B59B620;color:#b98bcc">Mage</span></div></div><p class="text-xs text-text-muted mt-1 line-clamp-2">Esmeralda&#x27;s durability and kit give them a strong matchup advantage against Mathilda throughout the game.</p></div><div class="flex-shrink-0 text-right"><p class="flex items-center justify-end gap-1 text-lg sm:text-xl font-heading font-bold" style="color:#44ff88"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trending-up w-3.5 h-3.5" aria-hidden="true"><path d="M16 7h6v6"></path><path d="m22 7-8.5 8.5-5-5L2 17"></path></svg>+<!-- -->4.3</p><p class="text-[9px] text-text-muted uppercase hidden sm:block">win rate delta</p></div></div><div class="absolute top-0 left-0 w-3 h-3 border-t border-l border-mlbb-gold/20 pointer-events-none"></div><div class="absolute bottom-0 right-0 w-3 h-3 border-b border-r border-mlbb-gold/20 pointer-events-none"></div></div><div class="group relative bg-surface-3 border border-mlbb-gold/15 hover:border-mlbb-green/30 transition-all duration-300" style="opacity:0;transform:translateY(12px)"><div class="flex items-center gap-3 p-3 sm:gap-4 sm:p-4"><div class="flex-shrink-0 w-7 sm:w-8 text-center"><span class="text-base sm:text-lg font-heading font-bold text-text-accent">#<!-- -->2</span></div><a class="flex-shrink-0" href="/heroes/odette"><div class="relative overflow-hidden flex-shrink-0 rounded-full" style="width:48px;height:48px;min-width:48px;background-color:#9B59B612"><img alt="Odette hero icon" loading="lazy" width="48" height="48" decoding="async" data-nimg="1" class="h-full w-full object-cover" style="color:transparent" srcSet="https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_d9251718a8894546ba04cfa9ca68dedc.png&amp;w=48&amp;output=webp&amp;q=75&amp;we 1x, https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_d9251718a8894546ba04cfa9ca68dedc.png&amp;w=96&amp;output=webp&amp;q=75&amp;we 2x" src="https://wsrv.nl/?url=https%3A%2F%2Fakmweb.youngjoygame.com%2Fweb%2Fsvnres%2Fimg%2Ftest%2Fhomepage_2_2_16_1232_1%2F100_d9251718a8894546ba04cfa9ca68dedc.png&amp;w=96&amp;output=webp&amp;q=75&amp;we"/></div></a><div class="min-w-0 flex-1"><div class="flex items-center gap-2 sm:gap-3 flex-wrap"><a class="min-w-0 max-w-full truncate font-heading font-bold text-base sm:text-lg text-text-primary hover:text-text-accent-bright transition-colors" href="/heroes/odette">Odette</a><div class="inline-flex items-center justify-center font-heading font-bold bg-gradient-to-br from-[#00AAFF] to-[#0077CC] text-[#00111a] shadow-[0_0_12px_rgba(0,170,255,0.3)] w-6 h-6 text-xs animate-tier-pop">B</div><div class="gap-1.5 hidden sm:flex"><span class="text-[10px] px-1.5 py-0.5" style="background-color:#9B59B620;color:#b98bcc">Mage</span></div></div><p class="text-xs text-text-muted mt-1 line-clamp-2">Odette has a statistical edge over Mathilda based on ranked matchup data. Pick Odette to gain an advantage in draft.</p></div><div class="flex-shrink-0 text-right"><p class="flex items-center justify-end gap-1 text-lg sm:text-xl font-heading font-bold" style="color:#44ff88"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="rou