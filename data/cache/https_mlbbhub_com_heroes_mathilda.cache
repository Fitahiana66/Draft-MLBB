ria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"absolute bottom-0 left-0 w-3 h-3 border-b border-l border-[#C8AA6E]/30\",\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"absolute bottom-0 right-0 w-3 h-3 border-b border-r border-[#C8AA6E]/30\",\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"absolute -top-32 -right-24 w-72 h-72 rounded-full bg-[#C8AA6E]/[0.05] blur-3xl pointer-events-none\",\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"relative hero-article-body max-w-[860px] mx-auto\",\"children\":[[[[\"$\",\"h2\",\"h2-0\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The team that earns Mathilda\"]}],\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[\"Her last balance pass, 2.1.88 (\",[\"$\",\"$L40\",\"a-0\",{\"href\":\"/patch-notes\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"patch notes\"}],\"), sharpened her mid-to-late damage on both Soul Bloom and Circling Eagle and cut her ultimate's mana cost, so the engages now carry real burst, not just utility. It does not change who you draft her with.\"]}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Lock Mathilda when you have at least one hero who wants to close gap fast and does their best work right next to an enemy carry. Hayabusa, Gusion, Lancelot, and Saber are the obvious candidates. Less obvious but just as effective: Fanny (Guiding Wind's speed boost lets her cable in faster), Yu Zhong in the EXP lane (using S2 to pull him into a midlane skirmish), and burst mages like Lunox who need a single entry window to one-shot.\"}],\"\\n\",[\"$\",\"p\",\"p-2\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The disqualifying test is simple: look at your team comp and ask which hero benefits most from being teleported into the enemy backline right now. If you cannot name one, Mathilda is the wrong pick for this draft.\"}],\"\\n\",[\"$\",\"p\",\"p-3\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"On the enemy side, three heroes make her miserable. Franco's Bloody Hunt suppresses her during or before Circling Eagle, stopping the orbit cold. Minsitthar's King's Calling creates an anti-blink zone that prevents her final dash from landing. Lolita's Nokhom Shield blocks Soul Bloom wisps entirely, turning S1 into wasted mana. If the enemy team has two of these three, consider Floryn or Estes instead.\"}],\"\\n\",\"$L7f\",\"\\n\",\"$L80\",\"\\n\",\"$L81\",\"\\n\",\"$L82\",\"\\n\",\"$L83\",\"\\n\",\"$L84\",\"\\n\",\"$L85\",\"\\n\",\"$L86\",\"\\n\",\"$L87\",\"\\n\",\"$L88\",\"\\n\",\"$L89\",\"\\n\",\"$L8a\",\"\\n\",\"$L8b\",\"\\n\",\"$L8c\",\"\\n\",\"$L8d\",\"\\n\",\"$L8e\"],\"$L8f\",\"$L90\"],\"$L91\"]}]]}]]}]\n"])</script><script>self.__next_f.push([1,"a7:I[392015,[\"$7\",\"$8\",\"$9\",\"$a\",\"$b\",\"$2e\",\"$3e\",\"$3f\"],\"default\"]\nb1:I[131354,[\"$7\",\"$8\",\"$9\",\"$a\",\"$b\",\"$2e\",\"$3e\",\"$3f\"],\"default\"]\n6e:[\"$\",\"$L6b\",\"zilong\",{\"href\":\"/heroes/zilong\",\"className\":\"group block\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative bg-surface-4 border border-mlbb-gold/20 overflow-hidden card-hover hover:border-mlbb-gold/50\",\"style\":{\"boxShadow\":\"0 2px 8px rgba(0,0,0,0.3)\"},\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 p-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative w-14 h-14 rounded-full overflow-hidden flex-shrink-0 bg-surface-3\",\"children\":[\"$\",\"$L6