on-300 pointer-events-none" style="background:radial-gradient(ellipse at center, #3498DB12 0%, transparent 70%)"></div><div class="absolute top-0 left-0 w-3 h-3 border-t border-l border-mlbb-gold/0 group-hover:border-mlbb-gold/50 transition-all duration-300 pointer-events-none"></div><div class="absolute bottom-0 right-0 w-3 h-3 border-b border-r border-mlbb-gold/0 group-hover:border-mlbb-gold/50 transition-all duration-300 pointer-events-none"></div><div class="absolute bottom-0 left-0 right-0 h-[1px] opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none" style="background:linear-gradient(90deg, transparent, #3498DB, transparent)"></div></div></a></div></div></div><div class="mt-6 text-center"><a class="inline-flex items-center gap-2 text-sm text-text-accent hover:text-text-accent-bright transition-colors font-heading uppercase tracking-wider" href="/heroes">Browse All Heroes<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right w-4 h-4" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></a></div></section></div></section></div><section class="content-lazy relative border-t border-border-subtle py-12 md:py-16" aria-labelledby="hero-faq-heading"><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","@id":"https://mlbbhub.com/heroes/mathilda#faq","url":"https://mlbbhub.com/heroes/mathilda","inLanguage":"en","mainEntity":[{"@type":"Question","name":"What is the best Mathilda build in 2026?","acceptedAnswer":{"@type":"Answer","text":"Mathilda's strongest build centers on Flask of the Oasis, Enchanted Talisman and Fleeting Time as core items, paired with the Support Emblem and the Flicker battle spell. The full six-item order, flex options for different matchups, and talent setup are in the build section on this page."}},{"@type":"Question","name":"What is the best emblem for Mathilda?","acceptedAnswer":{"@type":"Answer","text":"The recommended emblem for Mathilda is Support Emblem, set up with the Agility, Pull Yourself Together and Focusing Mark talents. The full emblem and talent breakdown, including alternatives for specific matchups, is in the build section."}},{"@type":"Question","name":"What lane and role is Mathilda in Mobile Legends?","acceptedAnswer":{"@type":"Answer","text":"Mathilda is a Support and Assassin hero, usually played as a Roamer. Role and lane decide which builds, emblems, and counters matter most, all of which are covered on this page."}},{"@type":"Question","name":"Who counters Mathilda?","acceptedAnswer":{"@type":"Answer","text":"Mathilda is countered most by Esmeralda, Odette and Popol and Kupa, the heroes with the biggest measured edge against Mathilda in ranked play. The full counter list, the heroes Mathilda beats, and game-phase tips are in the counters section."}},{"@type":"Question","name":"Is Mathilda hard to play?","acceptedAnswer":{"@type":"Answer","text":"Mathilda is rated Hard difficulty in Mobile Legends. Mathilda has a higher skill floor, so expect a learning curve on combos and positioning before the hero pays off."}},{"@type":"Question","name":"What is Mathilda's win rate this patch?","acceptedAnswer":{"@type":"Answer","text":"Mathilda currently holds a 44.8% win rate, a 0.1% pick rate, and a 0.2% ban rate in ranked Mobile Legends, refreshed daily from match data. Win and pick rates broken down by rank, from Epic to Mythical Glory, are in the rank stats section."}}]}</script><div class="container-mlbb relative z-10"><div class="mb-6 flex items-center gap-3"><span class="flex h-9 w-9 items-center justify-center border border-mlbb-gold/30 bg-mlbb-gold/10 text-text-accent" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-question-mark h-4 w-4" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><path d="M12 17h.01"></path></svg></span><h2 id="hero-faq-heading" class="font-heading text-xl font-bold uppercase tracking-[0.04em] text-text-accent-bright md:text-2xl">Mathilda FAQ</h2></div><p class="mb-6 max-w-[80ch] text-sm leading-relaxed text-text-muted md:text-[15px]">Mathilda is a Support and Assassin hero played as a Roamer.<!-- --> Its strongest build centers on Flask of the Oasis, Enchanted Talisman, Fleeting Time; open the <a class="font-semibold text-text-accent underline decoration-text-accent/30 underline-offset-2 transition-colors hover:text-text-accent-bright" href="/build-simulator?hero=mathilda&amp;items=tough-boots%2Cflask-of-the-oasis%2Cenchanted-talisman%2Cfleeting-time%2Coracle%2Cimmortality&amp;blessing=favor&amp;spell=flicker&amp;emblem=support&amp;talents=agility%2Cpull-yourself-together%2Cfocusing-mark&amp;flex=warrior-boots.tough-boots%2Cdominance-ice.oracle%2Cwinter-crown.immortality">Mathilda build simulator</a> for the full item order and final stats, or compare every available loadout on the <a class="font-semibold text-text-accent underline decoration-text-accent/30 underline-offset-2 transition-colors hover:text-text-accent-bright" href="/builds/mathilda">Mathilda builds page</a>. <!-- -->See every hero that beats it on the <a class="font-semibold text-text-accent underline decoration-text-accent/30 underline-offset-2 transition-colors hover:text-text-accent-bright" href="/counter/mathilda">Mathilda counter page</a>.</p><div class="space-y-3"><div class="glass-card overflow-hidden"><h3 class="text-sm md:text-base font-heading font-semibold"><button id="_R_falubsnnauivbH1_" type="button" aria-expanded="true" aria-controls="_R_falubsnnauivb_" class="w-full flex items-center justify-between gap-3 p-5 text-left cursor-pointer text-[#E8E6E3] hover:text-[#C8AA6E] transition-colors"><span>What is the best Mathilda build in 2026?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down w-4 h-4 flex-shrink-0 transition-transform duration-200 rotate-180 text-[#C8AA6E]" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></h3><div id="_R_falubsnnauivb_" role="region" aria-labelledby="_R_falubsnnauivbH1_" class="grid transition-[grid-template-rows] duration-200 grid-rows-[1fr]"><div class="overflow-hidden"><div class="px-5 pb-5 -mt-1"><p class="text-sm text-[#9BA0B4] leading-relaxed">Mathilda&#x27;s strongest build centers on Flask of the Oasis, Enchanted Talisman and Fleeting Time as core items, paired with the Support Emblem and the Flicker battle spell. The full six-item order, flex options for different matchups, and talent setup are in the build section on this page.</p></div></div></div></div><div class="glass-card overflow-hidden"><h3 class="text-sm md:text-base font-heading font-semibold"><button id="_R_nalubsnnauivbH1_" type="button" aria-expanded="false" aria-controls="_R_nalubsnnauivb_" class="w-full flex items-center justify-between gap-3 p-5 text-left cursor-pointer text-[#E8E6E3] hover:text-[#C8AA6E] transition-colors"><span>What is the best emblem for Mathilda?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down w-4 h-4 flex-shrink-0 transition-transform duration-200 text-[#9BA0B4]" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></h3><div id="_R_nalubsnnauivb_" role="region" aria-labelledby="_R_nalubsnnauivbH1_" inert="" class="grid transition-[grid-template-rows] duration-200 grid-rows-[0fr]"><div class="overflow-hidden"><div class="px-5 pb-5 -mt-1"><p class="text-sm text-[#9BA0B4] leading-relaxed">The recommended emblem for Mathilda is Support Emblem, set up with the Agility, Pull Yourself Together and Focusing Mark talents. The full emblem and talent breakdown, including alternatives for specific matchups, is in the build section.</p></div></div></div></div><div class="glass-card overflow-hidden"><h3 class="text-sm md:text-base font-heading font-semibold"><button id="_R_valubsnnauivbH1_" type="button" aria-expanded="false" aria-controls="_R_valubsnnauivb_" class="w-full flex items-center justify-between gap-3 p-5 text-left cursor-pointer text-[#E8E6E3] hover:text-[#C8AA6E] transition-colors"><span>What lane and role is Mathilda in Mobile Legends?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down w-4 h-4 flex-shrink-0 transition-transform duration-200 text-[#9BA0B4]" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></h3><div id="_R_valubsnnauivb_" role="region" aria-labelledby="_R_valubsnnauivbH1_" inert="" class="grid transition-[grid-template-rows] duration-200 grid-rows-[0fr]"><div class="overflow-hidden"><div class="px-5 pb-5 -mt-1"><p class="text-sm text-[#9BA0B4] leading-relaxed">Mathilda is a Support and Assassin hero, usually played as a Roamer. Role and lane decide which builds, emblems, and counters matter most, all of which are covered on this page.</p></div></div></div></div><div class="glass-card overflow-hidden"><h3 class="text-sm md:text-base font-heading font-semibold"><button id="_R_17alubsnnauivbH1_" type="button" aria-expanded="false" aria-controls="_R_17alubsnnauivb_" class="w-full flex items-center justify-between gap-3 p-5 text-left cursor-pointer text-[#E8E6E3] hover:text-[#C8AA6E] transition-colors"><span>Who counters Mathilda?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down w-4 h-4 flex-shrink-0 transition-transform duration-200 text-[#9BA0B4]" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></h3><div id="_R_17alubsnnauivb_" role="region" aria-labelledby="_R_17alubsnnauivbH1_" inert="" class="grid transition-[grid-template-rows] duration-200 grid-rows-[0fr]"><div class="overflow-hidden"><div class="px-5 pb-5 -mt-1"><p class="text-sm text-[#9BA0B4] leading-relaxed">Mathilda is countered most by Esmeralda, Odette and Popol and Kupa, the heroes with the biggest measured edge against Mathilda in ranked play. The full counter list, the heroes Mathilda beats, and game-phase tips are in the counters section.</p></div></div></div></div><div class="glass-card overflow-hidden"><h3 class="text-sm md:text-base font-heading font-semibold"><button id="_R_1falubsnnauivbH1_" type="button" aria-expanded="false" aria-controls="_R_1falubsnnauivb_" class="w-full flex items-center justify-between gap-3 p-5 text-left cursor-pointer text-[#E8E6E3] hover:text-[#C8AA6E] transition-colors"><span>Is Mathilda hard to play?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down w-4 h-4 flex-shrink-0 transition-transform duration-200 text-[#9BA0B4]" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></h3><div id="_R_1falubsnnauivb_" role="region" aria-labelledby="_R_1falubsnnauivbH1_" inert="" class="grid transition-[grid-template-rows] duration-200 grid-rows-[0fr]"><div class="overflow-hidden"><div class="px-5 pb-5 -mt-1"><p class="text-sm text-[#9BA0B4] leading-relaxed">Mathilda is rated Hard difficulty in Mobile Legends. Mathilda has a higher skill floor, so expect a learning curve on combos and positioning before the hero pays off.</p></div></div></div></div><div class="glass-card overflow-hidden"><h3 class="text-sm md:text-base font-heading font-semibold"><button id="_R_1nalubsnnauivbH1_" type="button" aria-expanded="false" aria-controls="_R_1nalubsnnauivb_" class="w-full flex items-center justify-between gap-3 p-5 text-left cursor-pointer text-[#E8E6E3] hover:text-[#C8AA6E] transition-colors"><span>What is Mathilda&#x27;s win rate this patch?</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down w-4 h-4 flex-shrink-0 transition-transform duration-200 text-[#9BA0B4]" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></h3><div id="_R_1nalubsnnauivb_" role="region" aria-labelledby="_R_1nalubsnnauivbH1_" inert="" class="grid transition-[grid-template-rows] duration-200 grid-rows-[0fr]"><div class="overflow-hidden"><div class="px-5 pb-5 -mt-1"><p class="text-sm text-[#9BA0B4] leading-relaxed">Mathilda currently holds a 44.8% win rate, a 0.1% pick rate, and a 0.2% ban rate in ranked Mobile Legends, refreshed daily from match data. Win and pick rates broken down by rank, from Epic to Mythical Glory, are in the rank stats section.</p></div></div></div></div></div></div></section><!--$--><!--/$--></div></main><footer class="content-lazy relative bg-[#000000] border-t border-[#C8AA6E]/20 overflow-hidden"><div class="absolute inset-0 hex-pattern opacity-40 pointer-events-none"></div><div class="absolute inset-0 pointer-events-none" style="background:radial-gradient(ellipse 80% 60% at 50% 100%, rgba(200,170,110,0.03), transparent)"></div><div class="absolute top-0 left-0 right-0 h-[2px] z-10 overflow-hidden energy-line" aria-hidden="true"></div><div class="relative z-10 pt-4 pb-4"><div class="container-mlbb"><div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-x-12 gap-y-8"><div class="col-span-1 sm:col-span-2"><div class="flex i