tool\":[{\"@type\":\"HowToTool\",\"name\":\"Marksman Emblem\"},{\"@type\":\"HowToTool\",\"name\":\"Inspire Battle Spell\"}],\"step\":[{\"@type\":\"HowToStep\",\"position\":1,\"name\":\"Buy Swift Boots\",\"text\":\"Purchase Swift Boots (710 gold) as item 1 in the Split-Push Crit Pressure build for Argus.\",\"url\":\"https://mlbbhub.com/heroes/argus#build-split-push-crit-pressure\"},{\"@type\":\"HowToStep\",\"position\":2,\"name\":\"Buy Corrosion Scythe\",\"text\":\"Purchase Corrosion Scythe (2,050 gold) as item 2 in the Split-Push Crit Pressure build for Argus.\",\"url\":\"https://mlbbhub.com/heroes/argus#build-split-push-crit-pressure\"},{\"@type\":\"HowToStep\",\"position\":3,\"name\":\"Buy Haas's Claws\",\"text\":\"Purchase Haas's Claws (2,020 gold) as item 3 in the Split-Push Crit Pressure build for Argus.\",\"url\":\"https://mlbbhub.com/heroes/argus#build-split-push-crit-pressure\"},{\"@type\":\"HowToStep\",\"position\":4,\"name\":\"Buy Berserker's Fury\",\"text\":\"Purchase Berserker's Fury (2,390 gold) as item 4 in the Split-Push Crit Pressure build for Argus.\",\"url\":\"https://mlbbhub.com/heroes/argus#build-split-push-crit-pressure\"},{\"@type\":\"HowToStep\",\"position\":5,\"name\":\"Buy Golden Staff\",\"text\":\"Purchase Golden Staff (2,000 gold) as item 5 in the Split-Push Crit Pressure build for Argus.\",\"url\":\"https://mlbbhub.com/heroes/argus#build-split-push-crit-pressure\"},{\"@type\":\"HowToStep\",\"position\":6,\"name\":\"Buy Malefic Roar\",\"text\":\"Purchase Malefic Roar (2,060 gold) as item 6 in the Split-Push Crit Pressure build for Argus.\",\"url\":\"https://mlbbhub.com/heroes/argus#build-split-push-crit-pressure\"}],\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://mlbbhub.com/heroes/argus\"},\"datePublished\":\"2026-04-12T00:00:00.000Z\",\"dateModified\":\"2026-08-18T00:00:00.000Z\",\"author\":{\"@type\":\"Organization\",\"name\":\"MLBBHub\",\"url\":\"https://mlbbhub.com\"}}5e:[\"$\",\"script\",\"1\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$63\"}}]\n64:T8d9,{\"@context\":\"https://schema.org\",\"@type\":\"HowTo\",\"name\":\"How to Build Argus in Mobile Legends: CC and Burst Safe\",\"description\":\"Safer teamfight setup for control-heavy or magic-burst games where Argus needs to survive the first lockout before attacking.\",\"totalTime\":\"PT15M\",\"supply\":[{\"@type\":\"HowToSupply\",\"name\":\"Tough Boots\"},{\"@type\":\"HowToSupply\",\"name\":\"Corrosion Scythe\"},{\"@type\":\"HowToSupply\",\"name\":\"Demon Hunter Sword\"},{\"@type\":\"HowToSupply\",\"name\":\"Golden Staff\"},{\"@type\":\"HowToSupply\",\"name\":\"Rose Gold Meteor\"},{\"@type\":\"HowToSupply\",\"name\":\"Immortality\"}],\"tool\":[{\"@type\":\"HowToTool\",\"name\":\"Fighter Emblem\"},{\"@type\":\"HowToTool\",\"name\":\"Flicker Battle Spell\"}],\"step\":[{\"@type\":\"HowToStep\",\"position\":1,\"name\":\"Buy Tough Boots\",\"text\":\"Purchase Tough Boots (700 gold) as item 1 in the CC and Burst Safe build for Argus.\",\"url\":\"https://mlbbhub.com/heroes/argus#build-cc-burst-safe\"},{\"@type\":\"HowToStep\",\"position\":2,\"name\":\"Buy Corrosion Scythe\",\"text\":\"Purchase Corrosion Scythe (2,050 gold) as item 2 in the CC and Burst Safe build for Argus.\",\"url\":\"https://mlbbhub.com/heroes/argus#build-cc-burst-safe\"},{\"@type\":\"HowToStep\",\"position\":3,\"name\":\"Buy Demon Hunter Sword\",\"text\":\"Purchase Demon Hunter Sword (2,180 gold) as item 3 in the CC and Burst Safe build for Argus.\",\"url\":\"https://mlbbhub.com/heroes/argus#build-cc-burst-safe\"},{\"@type\":\"HowToStep\",\"position\":4,\"name\":\"Buy Golden Staff\",\"text\":\"Purchase Golden Staff (2,000 gold) as item 4 in the CC and Burst Safe build for Argus.\",\"url\":\"https://mlbbhub.com/heroes/argus#build-cc-burst-safe\"},{\"@type\":\"HowToStep\",\"position\":5,\"name\":\"Buy Rose Gold Meteor\",\"text\":\"Purchase Rose Gold Meteor (1,820 gold) as item 5 in the CC and Burst Safe build for Argus.\",\"url\":\"https://mlbbhub.com/heroes/argus#build-cc-burst-safe\"},{\"@type\":\"HowToStep\",\"position\":6,\"name\":\"Buy Immortality\",\"text\":\"Purchase Immortality (2,120 gold) as item 6 in the CC and Burst Safe build for Argus.\",\"url\":\"https://mlbbhub.com/heroes/argus#build-cc-burst-safe\"}],\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://mlbbhub.com/heroes/argus\"},\"datePublished\":\"2026-04-12T00:00:00.000Z\",\"dateModified\":\"2026-08-18T00:00:00.000Z\",\"author\":{\"@type\":\"Organization\",\"name\":\"MLBBHub\",\"url\":\"https://mlbbhub.com\"}}5f:[\"$\",\"script\",\"2\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$64\"}}]\n60:[\"$\",\"$L65\",null,{\"hero\":{\"id\":45,\"name\":\"Argus\",\"slug\":\"argus\",\"title\":\"Dark Angel\",\"role\":[\"Fighter\"],\"specialty\":[\"Charge\",\"Burst\"],\"lane\":[\"EXP\"],\"tier\":\"S\",\"difficulty\":2,\"releaseYear\":2017,\"stats\":{\"durability\":70,\"offense\":50,\"controlEffect\":50,\"difficulty\":60},\"winRate\":56,\"pickRate\":0.48,\"banRate\":1.11,\"counters\":{\"strongAgainst\":[{\"heroSlug\":\"gord\",\"heroName\":\"Gord\",\"advantage\":\"strong\",\"tip\":\"Argus counters heroes with poor mobility who cannot escape his attacks once he closes in, such as Gord and Aurora.\"},{\"heroSlug\":\"aurora\",\"heroName\":\"Aurora\",\"advantage\":\"strong\",\"tip\":\"Argus counters heroes with poor mobility who cannot escape his attacks once he closes in, such as Gord and Aurora.\"}],\"weakAgainst\":[{\"heroSlug\":\"gatotkaca\",\"heroName\":\"Gatotkaca\",\"advantage\":\"weak\",\"tip\":\"Argus is countered by Tanks with high Physical Defense, like Gatotkaca and Tigreal, because a lot of his damage comes from Basic Attacks.\"},{\"heroSlug\":\"tigreal\",\"heroName\":\"Tigreal\",\"advantage\":\"weak\",\"tip\":\"Argus is countered by Tanks with high Physical Defense, like Gatotkaca and Tigreal, because a lot of his damage comes from Basic Attacks.\"}]},\"splashArt\":\"https://akmweb.youngjoygame.com/web/svnres/file/mlbb/homepage/100_802afa50ffd43d553c3b924d111249c1.jpg\",\"portrait\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_0bd96658e5b8ec578226ea1622bd7231.png\",\"officialMatchups\":[{\"kind\":\"best_ally\",\"heroId\":\"36\",\"heroName\":\"Aurora\",\"heroSlug\":\"aurora\",\"icon\":\"https://akmweb.youngjoygame.com/web/madmin/image/737f20a2934bbae1c5fd1b129dcbe066.jpg?w=200-200-fefefe\",\"tip\":\"-Ranged and can keepyou from being harassed.\\n-Can Harass back.\\n-Has decentmagic damage.\\n-You both haveslow-inducing and stun-inflicting skills, so when skills are used properly, youboth can easily kill enemies or protect yourselves.\"},{\"kind\":\"counters\",\"heroId\":\"46\",\"heroName\":\"Odette\",\"heroSlug\":\"odette\",\"icon\":\"https://akmweb.youngjoygame.com/web/madmin/image/071fd5539ac4ba53b1dc27195cd6d4bd.png?w=150-150-fff8da\",\"tip\":\"Argus can easily catch Odette with his skills.\\n-Argus is able to cancel Odette’s Ultimate withhis 1st skill, since it has a stun.\\n-Argus’ ultimate can let Argus dive into Odette’sultimate without dying and can kill Odette at the same time.\"},{\"kind\":\"countered_by\",\"heroId\":\"9\",\"heroName\":\"Akai\",\"heroSlug\":\"akai\",\"icon\":\"https://akmweb.youngjoygame.com/web/madmin/image/25141fb8aa27cfbe9f030449721b11af.png?w=150-150-4f3225\",\"tip\":\"Akai’s ultimatecan disable Argus during the whole duration of Argus’ ultimate.\\n-Akai’s ultimatecan stop Argus from being able to get near or attack.\"}],\"skills\":{\"skills\":[{\"name\":\"Warmonger\",\"type\":\"Passive\",\"description\":\"Malice Energy grants Argus an initial Crit Chance of 30%. Argus's Crits are converted into Demonic Slash, which ignores 30% of the target's Physical Defense, deals 90 (+25% Total Physical Attack) Physical Damage, and recovers 140 HP.\\n\\nDemonic Slash cannot Crit, but can still trigger Crit-related effects.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Malice Energy\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" grants Argus an initial Crit Chance of 30%. Argus's Crits are converted into \"},{\"type\":\"text\",\"text\":\"Demonic Slash\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\", which ignores 30% of the target's \"},{\"type\":\"text\",\"text\":\"Physical Defense\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\", deals 90\"},{\"type\":\"text\",\"text\":\" (+25% Total Physical Attack)\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Physical Damage\",\"color\":\"#fb1f1f\"},{\"type\":\"text\",\"text\":\", and recovers 140 HP.\\n\\nDemonic Slash cannot Crit, but can still trigger Crit-related effects.\"}],\"cooldown\":null,\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_f8a28cd195d4ec474f361daee0d0de6c.png\",\"tags\":[\"Buff\"]},{\"name\":\"Demonic Grip\",\"type\":\"Skill 1\",\"description\":\"First Cast: Argus stretches out a demonic hand in the target direction, dealing 125 (+60% Extra Physical Attack) Physical Damage to the first enemy hero or creep hit, stunning them for 0.7s. Both Argus and the target are pulled toward each other, then the target is slowed by 40% for 2s.\\nIf no enemy is hit, Argus pulls himself toward the hand's destination instead.\\n\\nUse Again: Argus dashes and performs a wide slash, dealing 175 (+100% Extra Physical Attack) Physical Damage.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"First Cast\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\": Argus stretches out a demonic hand in the target direction, dealing 125\"},{\"type\":\"text\",\"text\":\" (+60% Extra Physical Attack)\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Physical Damage\",\"color\":\"#fb1f1f\"},{\"type\":\"text\",\"text\":\" to the first enemy hero or creep hit, stunning them for 0.7s. Both Argus and the target are pulled toward each other, then the target is slowed by 40% for 2s.\\nIf no enemy is hit, Argus pulls himself toward the hand's destination instead.\\n\\n\"},{\"type\":\"text\",\"text\":\"Use Again\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\": Argus dashes and performs a wide slash, dealing 175\"},{\"type\":\"text\",\"text\":\" (+100% Extra Physical Attack)\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Physical Damage\",\"color\":\"#fb1f1f\"},{\"type\":\"text\",\"text\":\".\"}],\"cooldown\":\"12s\",\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_b90caeb8b5854f2585f4c9af760e026a.png\",\"tags\":[\"Mobility\",\"Debuff\"]},{\"name\":\"Meteoric Sword\",\"type\":\"Skill 2\",\"description\":\"After a short charge, Argus thrusts his Meteoric Sword in the target direction, dealing 120 (+100% Total Physical Attack) Physical Damage. If this hits an enemy hero, Argus briefly stuns them and gains 30% Attack Speed for 3s. Meteoric Sword's damage also gains a 40% boost to Crit Chance and Crit Damage.\\n\\nMeteoric Sword counts as a Basic Attack and can trigger Attack Effects. Attack Speed shortens the charge time.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"After a short charge, Argus thrusts his \"},{\"type\":\"text\",\"text\":\"Meteoric Sword\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" in the target direction, dealing 120\"},{\"type\":\"text\",\"text\":\" (+100% Total Physical Attack)\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Physical Damage\",\"color\":\"#fb1f1f\"},{\"type\":\"text\",\"text\":\". If this hits an enemy hero, Argus briefly stuns them and gains 30% Attack Speed for 3s. Meteoric Sword's damage also gains a 40% boost to Crit Chance and Crit Damage.\\n\\nMeteoric Sword counts as a Basic Attack and can trigger Attack Effects. Attack Speed shortens the charge time.\"}],\"cooldown\":\"8s\",\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_79110528884ec6365c2e9395dc1bc11b.png\",\"tags\":[\"CC\",\"Damage\"]},{\"name\":\"Eternal Evil\",\"type\":\"Ultimate\",\"description\":\"Argus removes all control effects, gains Death Immunity for 4s, and deals 300 (+180% Extra Physical Attack) Physical Damage to nearby enemies. This damage scales with Argus's lost HP, dealing up to 50% extra damage when his HP falls below 30%.\\nWhen Death Immunity ends, Argus recovers HP equal to all damage dealt to enemy heroes during its duration.\\n\\nPassive: If Argus takes fatal damage while Eternal Evil is not on cooldown, he automatically enters Death Immunity.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Argus removes all control effects, gains \"},{\"type\":\"text\",\"text\":\"Death Immunity\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" for 4s, and deals 300\"},{\"type\":\"text\",\"text\":\" (+180% Extra Physical Attack)\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Physical Damage\",\"color\":\"#fb1f1f\"},{\"type\":\"text\",\"text\":\" to nearby enemies. This damage scales with Argus's lost HP, dealing up to 50% extra damage when his HP falls below 30%.\\nWhen \"},{\"type\":\"text\",\"text\":\"Death Immunity\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" ends, Argus recovers HP equal to all damage dealt to enemy heroes during its duration.\\n\\nPassive: If Argus takes fatal damage while \"},{\"type\":\"text\",\"text\":\"Eternal Evil\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" is not on cooldown, he automatically enters \"},{\"type\":\"text\",\"text\":\"Death Immunity\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\".\"}],\"cooldown\":\"45s\",\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_41fe2a5e02169da266ce942372ad1e91.png\",\"tags\":[\"Death Immunity\",\"Buff\"]}],\"skillUpgradePriority\":\"3-2-1\",\"skillPriorityTip\":\"Level 1 - The best one to take is Argus’ 2nd skill –Meteoric Sword. Since you will need it for burst damage against minions andmonsters at early. Don’t worry about survivability, since you will level up inno time and be able to get his 1st skill – Demonic Grip for mobility.\\nRetribution\\n-This can greatly help you to farm early andfaster.\\n-You can steal enemy ‘s jungle monsters moreeffectively.\\n-When upgraded with a jungling item, it can be ahandy slow-inducing skill.\",\"skillPriorityTipRich\":[{\"type\":\"text\",\"text\":\"Level 1 - The best one to take is Argus’ 2nd skill –Meteoric Sword. Since you will need it for burst damage against minions andmonsters at early. Don’t worry about survivability, since you will level up inno time and be able to get his 1st skill – Demonic Grip for mobility.\"},{\"type\":\"lineBreak\"},{\"type\":\"text\",\"text\":\"Retribution\"},{\"type\":\"lineBreak\"},{\"type\":\"text\",\"text\":\"-This can greatly help you to farm early andfaster.\"},{\"type\":\"lineBreak\"},{\"type\":\"text\",\"text\":\"-You can steal enemy ‘s jungle monsters moreeffectively.\"},{\"type\":\"lineBreak\"},{\"type\":\"text\",\"text\":\"-When upgraded with a jungling item, it can be ahandy slow-inducing skill.\"}]},\"synergies\":[{\"heroSlug\":\"angela\",\"heroName\":\"Angela\",\"synergyScore\":8,\"reason\":\"Argus works well with utility Supports like Angela and Rafaela who can provide extra Movement Speed and CC to allow Argus to stick to his targets and dish out maximum damage.\"},{\"heroSlug\":\"rafaela\",\"heroName\":\"Rafaela\",\"synergyScore\":8,\"reason\":\"Argus works well with utility Supports like Angela and Rafaela who can provide extra Movement Speed and CC to allow Argus to stick to his targets and dish out maximum damage.\"}],\"combos\":[{\"type\":\"laning\",\"title\":\"LANING COMBOS\",\"description\":\"In the laning phase, use Argus's 1st Skill to close in on the opponent and slow them with his 2nd Skill while hitting with Basic Attacks. If the enemy tries to run, use the second cast of his 1st Skill to chase.\",\"skillSequence\":[{\"skillId\":4510,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_b90caeb8b5854f2585f4c9af760e026a.png\"},{\"skillId\":4520,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_79110528884ec6365c2e9395dc1bc11b.png\"},{\"skillId\":4500,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_f98d2e98eaebfb31c6c5101cf1c3201a.png\"},{\"skillId\":4510,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_b90caeb8b5854f2585f4c9af760e026a.png\"}]},{\"type\":\"teamfight\",\"title\":\"TEAMFIGHT COMBOS\",\"description\":\"In teamfights, use Argus's 1st Skill to pull himself towards the enemy formation, then use the skill again to dash into their backline. Next, slow the enemy with his 2nd Skill and use Basic Attacks until his HP is low, then pop his Ultimate and continue the assault with Basic Attacks.\",\"skillSequence\":[{\"skillId\":4510,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_b90caeb8b5854f2585f4c9af760e026a.png\"},{\"skillId\":4510,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_b90caeb8b5854f2585f4c9af760e026a.png\"},{\"skillId\":4520,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_79110528884ec6365c2e9395dc1bc11b.png\"},{\"skillId\":4500,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_f98d2e98eaebfb31c6c5101cf1c3201a.png\"},{\"skillId\":4530,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_41fe2a5e02169da266ce942372ad1e91.png\"},{\"skillId\":4500,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_f98d2e98eaebfb31c6c5101cf1c3201a.png\"}]}],\"metaDescription\":\"Argus build, counter, and guide for MLBB EXP lane strategy. Learn item spikes, emblem choices, split-push timing, ultimate discipline, and draft traps.\",\"builds\":[],\"overviewLede\":\"Argus is an EXP lane fighter who wins by turning one committed target into health, tempo, and turret pressure. He is pickable when the enemy must fight him in melee range. He becomes a liability when the draft can kite, suppress, or waste his transformation without giving him something meaningful to hit.\"},\"serverLocale\":\"en\",\"curatedBuilds\":{\"source\":\"curated\",\"hero\":\"argus\",\"patch\":\"2.1.95\",\"lastReviewed\":\"2026-08-18\",\"stalePatch\":true,\"currentPatch\":\"2.2.16a\",\"builds\":[{\"slot\":1,\"id\":\"exp-attack-effect-default\",\"name\":\"EXP Attack-Effect Default\",\"roleContext\":\"EXP\",\"items\":[{\"slug\":\"swift-boots\",\"name\":\"Swift Boots\",\"cost\":710,\"fixed\":false},{\"slug\":\"corrosion-scythe\",\"name\":\"Corrosion Scythe\",\"cost\":2050,\"fixed\":false},{\"slug\":\"demon-hunter-sword\",\"name\":\"Demon Hunter Sword\",\"cost\":2180,\"fixed\":false},{\"slug\":\"golden-staff\",\"name\":\"Golden Staff\",\"cost\":2000,\"fixed\":false},{\"slug\":\"haass-claws\",\"name\":\"Haas's Claws\",\"cost\":2020,\"fixed\":false},{\"slug\":\"malefic-roar\",\"name\":\"Malefic Roar\",\"cost\":2060,\"fixed\":false}],\"coreItems\":[{\"slug\":\"corrosion-scythe\",\"name\":\"Corrosion Scythe\"},{\"slug\":\"demon-hunter-sword\",\"name\":\"Demon Hunter Sword\"},{\"slug\":\"golden-staff\",\"name\":\"Golden Staff\"}],\"emblem\":{\"slug\":\"marksman\",\"name\":\"Marksman Emblem\",\"talents\":[{\"slug\":\"swift\",\"name\":\"Swift\",\"iconUrl\":\"/images/talents/swift.png\",\"bucket\":\"standard\"},{\"slug\":\"weapon-master\",\"name\":\"Weapon Master\",\"iconUrl\":\"/images/talents/weapon-master.png\",\"bucket\":\"standard\"},{\"slug\":\"war-cry\",\"name\":\"War Cry\",\"iconUrl\":\"/images/talents/war-cry.png\",\"bucket\":\"core\"}]},\"spell\":{\"slug\":\"flicker\",\"name\":\"Flicker\"},\"blessing\":null,\"flexItems\":[{\"item\":{\"slug\":\"sea-halberd\",\"name\":\"Sea Halberd\"},\"replace\":{\"slug\":\"haass-claws\",\"name\":\"Haas's Claws\"},\"trigger\":\"Use when sustain, shields, or high-extra-HP frontliners are keeping the first target alive.\"},{\"item\":{\"slug\":\"rose-gold-meteor\",\"name\":\"Rose Gold Meteor\"},\"replace\":{\"slug\":\"malefic-roar\",\"name\":\"Malefic Roar\"},\"trigger\":\"Use against magic burst that can force Eternal Evil before Argus reaches basic-attack range.\"},{\"item\":{\"slug\":\"wind-of-nature\",\"name\":\"Wind of Nature\"},\"replace\":{\"slug\":\"haass-claws\",\"name\":\"Haas's Claws\"},\"trigger\":\"Use against physical basic-attack burst when one immunity window decides the Lord fight.\"}],\"notes\":\"Default ranked setup built around Corrosion slow, Demon Hunter Sword HP pressure, and Golden Staff attack-effect repeats.\",\"totalCost\":11020,\"statLines\":[{\"key\":\"physatk\",\"labelKey\":\"common.stats.physicalAttack\",\"unit\":\"flat\",\"group\":\"offensive\",\"value\":220,\"sources\":[\"Corrosion Scythe\",\"Demon Hunter Sword\",\"Golden Staff\",\"Haas's Claws\",\"Malefic Roar\"]},{\"key\":\"critchance\",\"labelKey\":\"common.stats.criticalChance\",\"unit\":\"percent\",\"group\":\"offensive\",\"value\":20,\"sources\":[\"Haas's Claws\"]},{\"key\":\"attackspeed\",\"labelKey\":\"common.stats.attackSpeed\",\"unit\":\"percent\",\"group\":\"offensive\",\"value\":95,\"sources\":[\"Swift Boots\",\"Corrosion Scythe\",\"Demon Hunter Sword\",\"Golden Staff\",\"Haas's Claws\"]},{\"key\":\"lifesteal\",\"labelKey\":\"common.stats.lifesteal\",\"unit\":\"percent\",\"group\":\"offensive\",\"value\":20,\"sources\":[\"Haas's Claws\"]},{\"key\":\"movespeed\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"flat\",\"group\":\"utility\",\"value\":40,\"sources\":[\"Swift Boots\"]},{\"key\":\"movespeedPct\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"percent\",\"group\":\"utility\",\"value\":5,\"sources\":[\"Corrosion Scythe\"]}],\"conflicts\":[],\"simulatorUrl\":\"/build-simulator?hero=argus\u0026items=swift-boots%2Ccorrosion-scythe%2Cdemon-hunter-sword%2Cgolden-staff%2Chaass-claws%2Cmalefic-roar\u0026spell=flicker\u0026emblem=marksman\u0026talents=swift%2Cweapon-master%2Cwar-cry\u0026flex=sea-halberd.haass-claws%2Crose-gold-meteor.malefic-roar%2Cwind-of-nature.haass-claws\"},{\"slot\":2,\"id\":\"split-push-crit-pressure\",\"name\":\"Split-Push Crit Pressure\",\"roleContext\":\"EXP\",\"items\":[{\"slug\":\"swift-boots\",\"name\":\"Swift Boots\",\"cost\":710,\"fixed\":false},{\"slug\":\"corrosion-scythe\",\"name\":\"Corrosion Scythe\",\"cost\":2050,\"fixed\":false},{\"slug\":\"haass-claws\",\"name\":\"Haas's Claws\",\"cost\":2020,\"fixed\":false},{\"slug\":\"berserkers-fury\",\"name\":\"Berserker's Fury\",\"cost\":2390,\"fixed\":false},{\"slug\":\"golden-staff\",\"name\":\"Golden Staff\",\"cost\":2000,\"fixed\":false},{\"slug\":\"malefic-roar\",\"name\":\"Malefic Roar\",\"cost\":2060,\"fixed\":false}],\"coreItems\":[{\"slug\":\"corrosion-scythe\",\"name\":\"Corrosion Scythe\"},{\"slug\":\"haass-claws\",\"name\":\"Haas's Claws\"},{\"slug\":\"berserkers-fury\",\"name\":\"Berserker's Fury\"}],\"emblem\":{\"slug\":\"marksman\",\"name\":\"Marksman Emblem\",\"talents\":[{\"slug\":\"fatal\",\"name\":\"Fatal\",\"iconUrl\":\"/images/talents/fatal.png\",\"bucket\":\"standard\"},{\"slug\":\"weapon-master\",\"name\":\"Weapon Master\",\"iconUrl\":\"/images/talents/weapon-master.png\",\"bucket\":\"standard\"},{\"slug\":\"war-cry\",\"name\":\"War Cry\",\"iconUrl\":\"/images/talents/war-cry.png\",\"bucket\":\"core\"}]},\"spell\":{\"slug\":\"inspire\",\"name\":\"Inspire\"},\"blessing\":null,\"flexItems\":[{\"item\":{\"slug\":\"demon-hunter-sword\",\"name\":\"Demon Hunter Sword\"},\"replace\":{\"slug\":\"malefic-roar\",\"name\":\"Malefic Roar\"},\"trigger\":\"Use when the enemy front line answers you with stacked HP instead of armor, so the percent-current-HP hit beats flat penetration.\"},{\"item\":{\"slug\":\"sea-halberd\",\"name\":\"Sea Halberd\"},\"replace\":{\"slug\":\"malefic-roar\",\"name\":\"Malefic Roar\"},\"trigger\":\"Use against Estes, Floryn, Yu Zhong, or any shield-heavy front-to-back comp that outlasts a side-lane siege.\"},{\"item\":{\"slug\":\"rose-gold-meteor\",\"name\":\"Rose Gold Meteor\"},\"replace\":{\"slug\":\"golden-staff\",\"name\":\"Golden Staff\"},\"trigger\":\"Use when a magic jungler or burst mage can delete Argus on the rotation to your lane.\"},{\"item\":{\"slug\":\"immortality\",\"name\":\"Immortality\"},\"replace\":{\"slug\":\"malefic-roar\",\"name\":\"Malefic Roar\"},\"trigger\":\"Use once a single death hands over Lord or the base, and the split needs to survive the collapse rather than out-damage it.\"}],\"notes\":\"Side-lane pressure build. Patch 2.1.90 rebalanced Demonic Slash from 80 (+50% Total Physical Attack) to 120 (+25%) and made its regen a flat 140, which halves what raw attack items return to the passive, so this stays on the crit and attack-effect engine instead of stacking Physical Attack. Berserker's Fury carries it after the 2.1.88 rework: crits now add True Damage, which is what gets through the defender who walks into the side lane to stop the push.\",\"totalCost\":11230,\"statLines\":[{\"key\":\"physatk\",\"labelKey\":\"common.stats.physicalAttack\",\"unit\":\"flat\",\"group\":\"offensive\",\"value\":245,\"sources\":[\"Corrosion Scythe\",\"Haas's Claws\",\"Berserker's Fury\",\"Golden Staff\",\"Malefic Roar\"]},{\"key\":\"critchance\",\"labelKey\":\"common.stats.criticalChance\",\"unit\":\"percent\",\"group\":\"offensive\",\"value\":45,\"sources\":[\"Haas's Claws\",\"Berserker's Fury\"]},{\"key\":\"critdmg\",\"labelKey\":\"common.stats.criticalDamage\",\"unit\":\"percent\",\"group\":\"offensive\",\"value\":30,\"sources\":[\"Berserker's Fury\"]},{\"key\":\"attackspeed\",\"labelKey\":\"common.stats.attackSpeed\",\"unit\":\"percent\",\"group\":\"offensive\",\"value\":75,\"sources\":[\"Swift Boots\",\"Corrosion Scythe\",\"Haas's Claws\",\"Golden Staff\"]},{\"key\":\"lifesteal\",\"labelKey\":\"common.stats.lifesteal\",\"unit\":\"percent\",\"group\":\"offensive\",\"value\":20,\"sources\":[\"Haas's Claws\"]},{\"key\":\"movespeed\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"flat\",\"group\":\"utility\",\"value\":40,\"sources\":[\"Swift Boots\"]},{\"key\":\"movespeedPct\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"percent\",\"group\":\"utility\",\"value\":5,\"sources\":[\"Corrosion Scythe\"]}],\"conflicts\":[],\"simulatorUrl\":\"/build-simulator?hero=argus\u0026items=swift-boots%2Ccorrosion-scythe%2Chaass-claws%2Cberserkers-fury%2Cgolden-staff%2Cmalefic-roar\u0026spell=inspire\u0026emblem=marksman\u0026talents=fatal%2Cweapon-master%2Cwar-cry\u0026flex=demon-hunter-sword.malefic-roar%2Csea-halberd.malefic-roar%2Crose-gold-meteor.golden-staff%2Cimmortality.malefic-roar\"},{\"slot\":3,\"id\":\"cc-burst-safe\",\"name\":\"CC and Burst Safe\",\"roleContext\":\"EXP\",\"items\":[{\"slug\":\"tough-boots\",\"name\":\"Tough Boots\",\"cost\":700,\"fixed\":false},{\"slug\":\"corrosion-scythe\",\"name\":\"Corrosion Scythe\",\"cost\":2050,\"fixed\":false},{\"slug\":\"demon-hunter-sword\",\"name\":\"Demon Hunter Sword\",\"cost\":2180,\"fixed\":false},{\"slug\":\"golden-staff\",\"name\":\"Golden Staff\",\"cost\":2000,\"fixed\":false},{\"slug\":\"rose-gold-meteor\",\"name\":\"Rose Gold Meteor\",\"cost\":1820,\"fixed\":false},{\"slug\":\"immortality\",\"name\":\"Immortality\",\"cost\":2120,\"fixed\":false}],\"coreItems\":[{\"slug\":\"corrosion-scythe\",\"name\":\"Corrosion Scythe\"},{\"slug\":\"demon-hunter-sword\",\"name\":\"Demon Hunter Sword\"},{\"slug\":\"golden-staff\",\"name\":\"Golden Staff\"}],\"emblem\":{\"slug\":\"fighter\",\"name\":\"Fighter Emblem\",\"talents\":[{\"slug\":\"firmness\",\"name\":\"Firmness\",\"iconUrl\":\"/images/talents/firmness.png\",\"bucket\":\"standard\"},{\"slug\":\"weapon-master\",\"n