:\"Elite\",\"tagSlug\":\"elite\",\"price\":\"599\",\"portraitFile\":\"Hero454-portrait.png\",\"portraitUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/argus/Hero454-portrait-20220525165231.webp\",\"splashUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/argus/Argus-Catastrophe-20200824133432.webp\",\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Argus/Cosmetics\"},{\"name\":\"Darth Vader\",\"tier\":\"Grand\",\"rawTier\":\"Grand\",\"tag\":\"Star Wars\",\"tagSlug\":\"star-wars\",\"price\":\"Limited-time Event\",\"portraitFile\":\"Hero456-portrait.png\",\"portraitUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/argus/Hero456-portrait-20220525165232.webp\",\"splashUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/argus/Argus-Darth-Vader-20211209065727.webp\",\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Argus/Cosmetics\"},{\"name\":\"Winged Nightmare\",\"tier\":\"Common\",\"rawTier\":\"Common\",\"tag\":\"S27\",\"tagSlug\":\"s27\",\"price\":\"Season 27\",\"portraitFile\":\"Hero457-portrait.png\",\"portraitUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/argus/Hero457-portrait-20221118130656.webp\",\"splashUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/argus/Argus-Winged-Nightmare-20250703150956.webp\",\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Argus/Cosmetics\"},{\"name\":\"Raiden Maru\",\"tier\":\"Exquisite\",\"rawTier\":\"Exquisite\",\"tag\":null,\"tagSlug\":null,\"price\":\"Limited-time Event\",\"portraitFile\":\"Hero459-portrait.png\",\"portraitUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/argus/Hero459-portrait-20260626040057.webp\",\"splashUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/argus/Argus-Raiden-Maru-20260824013840.webp\",\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Argus/Cosmetics\"},{\"name\":\"Malediction\",\"tier\":\"Common\",\"rawTier\":\"Common\",\"tag\":\"Elite\",\"tagSlug\":\"elite\",\"price\":\"188\",\"portraitFile\":\"Hero454-portrait.png\",\"portraitUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/argus/Hero454-portrait-20220525165231.webp\",\"splashUrl\":null,\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Argus/Cosmetics\"}],\"lore\":{\"backstory\":\"Argus was once a radiant angel of the celestial order, twin brother to Rafaela. When a great war erupted between heaven and the Abyss, Argus was captured and corrupted by dark forces. The angel of light became a fallen warrior, his once-golden wings turned black and his sword cursed with undying fury. Now Argus exists in a state between life and death, his Eternal Evil ability a reflection of the curse that prevents him from finding peace. He fights without fear, for he has already lost everything.\",\"allies\":[{\"heroSlug\":\"rafaela\",\"heroName\":\"Rafaela\",\"relationship\":\"Twin sister who still hopes to redeem him\"},{\"heroSlug\":\"valentina\",\"heroName\":\"Valentina\",\"relationship\":\"Dark queen who facilitated his corruption\"}],\"rivals\":[{\"heroSlug\":\"tigreal\",\"heroName\":\"Tigreal\",\"relationship\":\"Champion of the light he betrayed\"},{\"heroSlug\":\"lunox\",\"heroName\":\"Lunox\",\"relationship\":\"Cosmic being whose balance he disrupted\"}]},\"loreUrlName\":\"$undefined\",\"statsHistory\":[{\"date\":\"2026-09-07\",\"winRate\":54.61,\"pickRate\":0.46,\"banRate\":0.87},{\"date\":\"2026-09-10\",\"winRate\":54.71,\"pickRate\":0.49,\"banRate\":0.91},{\"date\":\"2026-09-16\",\"winRate\":54.37,\"pickRate\":0.43,\"banRate\":0.84},{\"date\":\"2026-09-28\",\"winRate\":55.32,\"pickRate\":0.68,\"banRate\":1.78},{\"date\":\"2026-10-02\",\"winRate\":55.35,\"pickRate\":0.64,\"banRate\":1.57},{\"date\":\"2026-10-09\",\"winRate\":55.73,\"pickRate\":0.56,\"banRate\":1.28},{\"date\":\"2026-10-17\",\"winRate\":56,\"pickRate\":0.48,\"banRate\":1.11}]},\"relatedHeroesSlot\":\"$L66\",\"statsSeoSlot\":\"$L67\",\"fieldManualSlot\":\"$L68\"}]\n61:[\"$\",\"$L69\",null,{\"heroName\":\"Argus\",\"heroSlug\":\"argus\",\"roles\":\"$60:props:hero:role\",\"lanes\":\"$60:props:hero:lane\",