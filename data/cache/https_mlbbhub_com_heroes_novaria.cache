ute bottom-0 left-0 h-3 w-3" aria-hidden="true" style="border-bottom:1px solid #E74C3C80;border-left:1px solid #E74C3C80"></span><span class="pointer-events-none absolute bottom-0 right-0 h-3 w-3" aria-hidden="true" style="border-bottom:1px solid #E74C3C80;border-right:1px solid #E74C3C80"></span><div class="pointer-events-none absolute -left-10 -bottom-10 h-32 w-32 rounded-full blur-3xl" aria-hidden="true" style="background-color:#E74C3C22"></div><div class="relative flex min-w-0 items-center gap-3"><div class="relative h-12 w-12 shrink-0 overflow-hidden rounded-full" style="border:2px solid #E74C3C80;box-shadow:0 0 18px #E74C3C55"><img alt="Flameshot" loading="lazy" width="48" height="48" decoding="async" data-nimg="1" class="h-full w-full object-cover" style="color:transparent" src="/images/spells/flameshot.png"/></div><div class="min-w-0 flex-1"><p class="flex items-center gap-1 font-heading text-[10px] font-bold uppercase tracking-[0.22em]" style="color:#E74C3C"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-zap h-2.5 w-2.5" aria-hidden="true"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"></path></svg>Battle Spell</p><p class="mt-0.5 truncate font-heading text-base font-bold uppercase tracking-wide text-mlbb-text sm:text-lg xl:text-base">Flameshot</p></div></div></div></div><div class="relative grid grid-cols-2 gap-px overflow-hidden border border-mlbb-gold/18 bg-surface-1/45 sm:grid-cols-4 lg:col-start-1 lg:row-start-2 lg:self-start" style="box-shadow:inset 0 1px 0 rgba(240,208,96,0.08)"><div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-mlbb-gold-bright/50 to-transparent" aria-hidden="true"></div><div class="relative min-w-0 bg-surface-2/85 px-3 py-2 sm:px-4 sm:py-3" title="Clock of Destiny, Lightning Truncheon, Genius Wand, Divine Glaive, Blood Wings"><p class="truncate font-heading text-[9.5px] font-bold uppercase tracking-[0.2em] text-mlbb-text-secondary/85">Magic Power</p><p class="mt-1 font-heading text-[18px] font-bold leading-tight tracking-tight text-mlbb-text sm:text-[22px]"><span class="text-mlbb-gold-bright">+345</span></p></div><div class="relative min-w-0 bg-surface-2/85 px-3 py-2 sm:px-4 sm:py-3" title="Divine Glaive"><p class="truncate font-heading text-[9.5px] font-bold uppercase tracking-[0.2em] text-mlbb-text-secondary/85">Magic Penetration</p><p class="mt-1 font-heading text-[18px] font-bold leading-tight tracking-tight text-mlbb-text sm:text-[22px]"><span class="text-mlbb-gold-bright">+40%</span></p></div><div class="relative min-w-0 bg-surface-2/85 px-3 py-2 sm:px-4 sm:py-3" title="Arcane Boots, Genius Wand"><p class="truncate font-heading text-[9.5px] font-bold uppercase tracking-[0.2em] text-mlbb-text-secondary/85">Magic Penetration</p><p class="mt-1 font-heading text-[18px] font-bold leading-tight tracking-tight text-mlbb-text sm:text-[22px]"><span class="text-mlbb-gold-bright">+20</span></p></div><div class="relative min-w-0 bg-surface-2/85 px-3 py-2 sm:px-4 sm:py-3" title="Clock of Destiny"><p class="truncate font-heading text-[9.5px] font-bold uppercase tracking-[0.2em] text-mlbb-text-secondary/85">HP</p><p class="mt-1 font-heading text-[18px] font-bold leading-tight tracking-tight text-mlbb-text sm:text-[22px]"><span class="text-mlbb-gold-bright">+400</span></p></div></div></div><div class="relative mt-4 overflow-hidden border border-mlbb-gold/18 bg-gradient-to-br from-surface-3/75 to-surface-2/85 px-4 py-3.5"><div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-mlbb-gold/40 to-transparent" aria-hidden="true"></div><div class="mb-2.5 flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right-left h-3.5 w-3.5 text-text-accent" aria-hidden="true"><path d="m16 3 4 4-4 4"></path><path d="M20 7H4"></path><path d="m8 21-4-4 4-4"></path><path d="M4 17h16"></path></svg><p class="font-heading text-[10.5px] font-bold uppercase tracking-[0.22em] text-text-accent">Situational Swaps</p></div><ul class="space-y-2"><li class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-[12.5px] leading-relaxed text-mlbb-text-secondary"><a class="font-heading font-bold uppercase tracking-wide text-mlbb-text transition-colors hover:text-mlbb-gold-bright" href="/items/holy-crystal">Holy Crystal</a><span class="inline-flex items-baseline gap-1.5 text-[11px] uppercase tracking-wide text-mlbb-text-secondary/80"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right relative top-[1px] h-3 w-3 text-text-accent/65" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><span class="text-mlbb-text-secondary/65">over</span><a class="font-semibold text-text-accent transition-colors hover:text-mlbb-gold-bright" href="/items/blood-wings">Blood Wings</a></span><span class="basis-full text-[12.5px] text-mlbb-text-secondary/90 sm:basis-auto sm:before:mx-1 sm:before:text-mlbb-text-secondary/50 sm:before:content-[&#x27;•&#x27;]">Use when your frontline is protecting you and the enemy backline is reachable through Astral Echo. Raw Magic Power is stronger than the shield in clean poke games.</span></li><li class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-[12.5px] leading-relaxed text-mlbb-text-secondary"><a class="font-heading font-bold uppercase tracking-wide text-mlbb-text transition-colors hover:text-mlbb-gold-bright" href="/items/winter-crown">Winter Crown</a><span class="inline-flex items-baseline gap-1.5 text-[11px] uppercase tracking-wide text-mlbb-text-secondary/80"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right relative top-[1px] h-3 w-3 text-text-accent/65" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><span class="text-mlbb-text-secondary/65">over</span><a class="font-semibold text-text-accent transition-colors hover:text-mlbb-gold-bright" href="/items/blood-wings">Blood Wings</a></span><span class="basis-full text-[12.5px] text-mlbb-text-secondary/90 sm:basis-auto sm:before:mx-1 sm:before:text-mlbb-text-secondary/50 sm:before:content-[&#x27;•&#x27;]">Enemy has a committed backline diver such as Ling, Fanny, Hayabusa, Natalia, or Gusion. Frozen buys the one window Novaria needs to reset through a wall.</span></li><li class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-[12.5px] leading-relaxed text-mlbb-text-secondary"><a class="font-heading font-bold uppercase tracking-wide text-mlbb-text transition-colors hover:text-mlbb-gold-bright" href="/items/glowing-wand">Glowing Wand</a><span class="inline-flex items-baseline gap-1.5 text-[11px] uppercase tracking-wide text-mlbb-text-secondary/80"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right relative top-[1px] h-3 w-3 text-text-accent/65" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><span class="text-mlbb-text-secondary/65">over</span><a class="font-semibold text-text-accent transition-colors hover:text-mlbb-gold-bright" href="/items/genius-wand">Genius Wand</a></span><span class="basis-full text-[12.5px] text-mlbb-text-secondary/90 sm:basis-auto sm:before:mx-1 sm:before:text-mlbb-text-secondary/50 sm:before:content-[&#x27;•&#x27;]">Enemy sustain is keeping frontliners alive through poke. Lifebane matters more than early Magic Defense shred against healer or regen-heavy drafts.</span></li></ul></div></div></article><article id="build-2" role="tabpanel" aria-labelledby="build-tab-2" hidden="" class="group/build relative overflow-hidden border border-mlbb-gold/22 bg-surface-2/92 scroll-mt-24" style="box-shadow:0 1px 0 rgba(255,255,255,0.04) inset, 0 30px 60px -36px rgba(0,0,0,0.95);opacity:0;transform:translateY(24px)"><div class="pointer-events-none absolute inset-0 opacity-[0.06] hex-pattern" aria-hidden="true"></div><div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-mlbb-gold-bright/80 to-transparent" aria-hidden="true"></div><div class="pointer-events-none absolute left-0 top-0 h-full w-[3px] bg-gradient-to-b from-mlbb-gold-bright/70 via-mlbb-gold/30 to-transparent" aria-hidden="true"></div><div class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full blur-3xl transition-opacity duration-500 group-hover/build:opacity-90" aria-hidden="true" style="background-color:#9B59B61f"></div><span class="pointer-events-none absolute -right-4 top-2 font-heading text-[140px] font-black leading-none text-text-accent-bright/[0.04] sm:-right-2 sm:top-0 sm:text-[180px]" aria-hidden="true">02</span><div class="relative p-4 sm:p-5"><header class="mb-4 flex flex-col gap-2.5 sm:flex-row sm:flex-wrap sm:items-start sm:justify-between"><div class="min-w-0 flex-1"><h3 class="font-heading text-xl font-bold uppercase leading-tight tracking-[0.04em] text-mlbb-text sm:text-2xl">Frontline Control</h3><p class="mt-1.5 max-w-2xl text-[13px] leading-relaxed text-mlbb-text-secondary sm:text-sm xl:max-w-none">Use this into tanky or sustain-heavy drafts where Novaria&#x27;s job is repeated scouting, slows, and HP pressure rather than a single burst pick.</p></div><div class="flex flex-wrap items-center gap-2 sm:shrink-0"><div class="flex items-center gap-1.5 border border-mlbb-gold-bright/35 bg-gradient-to-br from-mlbb-gold-bright/12 to-mlbb-gold-bright/2 px-3 py-1.5"><span class="font-heading text-[9px] font-bold uppercase tracking-[0.2em] text-text-accent/85">Cost</span><span class="font-heading text-[13px] font-bold tracking-wide text-text-accent-bright">11,090<!-- -->g</span></div><a target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 border border-mlbb-blue/35 bg-gradient-to-br from-mlbb-blue/14 to-mlbb-blue/3 px-3 py-1.5 font-heading text-[11px] font-bold uppercase tracking-[0.16em] text-mlbb-blue-light transition-all duration-200 hover:border-mlbb-blue-light/60 hover:bg-mlbb-blue/20 hover:text-[#9fdcff]" href="/build-simulator?hero=novaria&amp;items=magic-boots%2Cenchanted-talisman%2Cice-queen-wand%2Cglowing-wand%2Cwishing-lantern%2Cdivine-glaive&amp;spell=flameshot&amp;emblem=mage&amp;talents=agility%2Cbargain-hunter%2Cimpure-rage&amp;flex=clock-of-destiny.ice-queen-wand%2Cgenius-wand.wishing-lantern%2Cblood-wings.wishing-lantern">Simulator<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-external-link h-3 w-3" aria-hidden="true"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg></a></div></header><div class="lg:grid lg:grid-cols-[minmax(0,1.45fr)_minmax(0,1fr)] lg:gap-x-5 lg:gap-y-4 xl:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)]"><div class="mb-4 lg:col-start-1 lg:row-start-1 lg:mb-0"><div class="relative"><div class="pointer-events-none absolute left-[8%] right-[8%] top-[22px] h-px sm:top-[30px]" aria-hidden="true" style="background:linear-gradient(90deg, transparent, rgba(200,170,110,0.45) 12%, rgba(240,208,96,0.55) 50%, rgba(200,170,110,0.45) 88%, transparent)"></div><div class="relat