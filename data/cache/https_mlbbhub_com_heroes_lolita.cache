hildren\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#B07ECC\",\"background\":\"#B07ECC1a\",\"border\":\"1px solid #B07ECC40\"},\"children\":\"Epic\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Lolita\",\"rank\":\"Epic\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=epic\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Epic\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Epic\",\"name\":\"Lolita\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"55.43\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Lolita\",\"delta\":\"+1.47%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.05\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.36\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Epic\"}}]]}]]}],[\"$\",\"article\",\"legend\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #4dc9f6, #4dc9f633)\",\"boxShadow\":\"0 0 12px -2px #4dc9f680\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#4dc9f6\",\"background\":\"#4dc9f61a\",\"border\":\"1px solid #4dc9f640\"},\"children\":\"Legend\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Lolita\",\"rank\":\"Legend\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=legend\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Legend\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Legend\",\"name\":\"Lolita\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"55.35\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Lolita\",\"delta\":\"+1.39%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.08\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.20\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Legend\"}}]]}]]}],[\"$\",\"article\",\"mythic\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[\"$L9d\",\"$L9e\",\"$L9f\"]}],\"$La0\",\"$La1\"]}]\n7e:[\"$\",\"h2\",\"h2-1\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The whole hero is one permission check\"]}]\n7f:[\"$\",\"p\",\"p-3\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Lolita is not an engage tank first. She is a permission check.\"}]\n80:[\"$\",\"p\",\"p-4\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Guardian's Reflection asks whether the enemy is actually allowed to play the fight from range. If the answer is no, everything else in her kit gets easier. Power Charge becomes reliable because targets hesitate instead of kiting freely. Noumenon Blast becomes a real threat because enemies burn movement early or clump in bad spaces while waiting for the shield to disappear. Even her passive matters more in those stalled fights, because each extra shield cycle keeps her healthy enough to stay planted in front of the backline while they keep firing.\"}]\n81:[\"$\",\"p\",\"p-5\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"That is the mistake most Lolita players make when they try to force highlight-reel initiations. They treat the hero like Tigreal with a prettier animation. Lolita does not need to be first on the screen to control the fight. In many games, her best sequence is simpler: stand in the firing lane, force the ranged carry to stop dealing damage, then spend Power Charge on the first target who panics and steps too close. Her ultimate is the punishment after the enemy loses formation, not the entire plan by itself.\"}]\n82:[\"$\",\"p\",\"p-6\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Once you understand that, her role becomes much cleaner. She protects first, punishes second, and only hard engages when the draft gives her cover to do it.\"}]\n83:[\"$\",\"h2\",\"h2-2\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"First four minutes: make the map smaller\"]}]\n84:[\"$\",\"ol\",\"ol-0\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Start on the side that actually matters.\"}],\" Leash your jungler briefly, then move toward the gold lane river if the enemy draft has a projectile gold laner or poke mid. Do not waste the first minute on a vanity invade. Let the enemy wave come slightly toward your side, hold the brush, and make the lane feel cramped. Lolita wins early by removing safe space, not by clearing minions herself.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Take Power Charge first, then unlock the shield.\"}],\" Level 1 Lolita needs a stun more than she needs a shield. Power Charge punishes a greedy face-check, protects your marksman from an early brush collapse, and gives you a reliable way to tag the enemy gold laner if your jungler paths nearby. At level 2, Guardian's Reflection changes the lane. From that point on, stop throwing S1 out for chip damage unless you are sure the trade will stick.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Save Flicker for the first real objective fight.\"}],\" Before the first Turtle, Flicker is worth more as threat than as movement. Burn it only if it secures first blood on a priority carry or saves your gold laner from a dive that would break the lane open. If you spend Flicker for random poke before the first objective, you arrive at the first 4v4 with no angle, no bailout, and no reason for the enemy to respect your ultimate.\"]}],\"\\n\"]}]\n85:[\"$\",\"h2\",\"h2-3\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The spike you are farming toward\"]}]\n86:[\"$\",\"p\",\"p-7\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[\"Lolita's first real breakpoint is \",[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Magic Boots plus Thunder Belt\"}],\", usually somewhere around the 6 to 8 minute mark if your early rotations were not a disaster. If the enemy has heavy control or double physical pressure, the boot type can change, but Thunder Belt is the part that matters.\"]}]\n87:[\"$\",\"p\",\"p-8\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Before that spike, Lolita is mostly a denial tool. She blocks damage, threatens a short stun, and waits for teammates to convert. After Thunder Belt, every clean Power Charge auto starts feeling expensive for the other side. The item turns that enhanced basic attack into a heavy slow plus true damage, and every successful hero hit starts stacking permanent hybrid defense. That means your first touch in a fight is no longer just setup. It is damage, control, and long-term stat growth in one action.\"}]\n88:[\"$\",\"p\",\"p-9\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"This changes how you can path the map. You stop being a body standing next to your marksman and become a roamer who can walk into a river choke, tag one target, and make the next contest harder for the enemy. If the opposing gold lane is lifesteal-heavy or a sustain fighter keeps running through your frontline, Dominance Ice often becomes the next buy right after this spike, and that is the moment front-to-back fights start tilting in your favor. The key point is simple: Thunder Belt is where Lolita stops asking teammates to do all the punishment for her.\"}]\n89:[\"$\",\"$La2\",null,{\"slot\":\"7246933188\",\"variant\":\"in-article\",\"className\":\"my-8\"}]\n8a:[[\"$\",\"h2\",\"h2-0\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Teamfights are won before the hammer lands\"]}],\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The wrong reflex on Lolita is to channel Noumenon Blast from fog every time the map opens. Good players are waiting for that. They will sidestep it, cancel it, or force you to release it early for nothing. Lolita is stronger when the threat of the channel shapes movement first.\"}],\"\\n\",[\"$\",\"ol\",\"ol-0\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Stand in the lane your carry wants to use.\"}],\" If your marksman is your win condition, you should be one screen segment in front of that marksman, not fishing in a side brush for hero clips. Your shield matters only if it intercepts the damage pattern that would reach your backline.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Use Guardian's Reflection on commitment, not on threat.\"}],\" Do not raise the shield just because Granger or Chang'e is nearby. Walk first. Wait for the cast angle. Then block when the damage is already committed. Early shield usage gives competent opponents time to hold abilities, reposition, and restart the fight on their terms.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Treat the ultimate as follow-up unless the enemy has already spent mobility.\"}],\" If you stun one target with Power Charge, or if your frontliner has already forced a dash, that is your green light to channel. Raw max-range ultimates are escape drills for the enemy team. Follow-up ultimates are kill zones.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"There is one edge case worth knowing. If your side has a hero like Mathilda or Angela enabling a forward commit, you can channel more aggressively because someone can rescue the overextension or turn it into a dive. If your draft has no secondary protection, you are a bodyguard first. Stay home, deny the projectile window, and let the enemy be the one who gets impatient.\"}],\"\\n\",[\"$\",\"h2\",\"h2-1\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Itemization is one core and several arguments\"]}],\"\\n\",[\"$\",\"p\",\"p-2\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Lolita does not want a rigid six-item script. She wants roam boots, an early Thunder Belt timing, and then the exact defense profile that makes the enemy draft feel awkward.\"}],\"\\n\",[\"$\",\"p\",\"p-3\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Magic Boots\"}],\" are the default when the enemy cannot easily punish your channels and you want faster shield and ultimate cycles. \",\"$La3\",\" take over when chain crowd control or magic engage is the real reason fights are being lost. \",\"$La4\",\" are for lanes where two physical threats are hitting you early and you need to stand in front of them without bleeding out before mid game.\"]}],\"\\n\",\"$La5\",\"\\n\",\"$La6\",\"\\n\",\"$La7\",\"\\n\",\"$La8\",\"\\n\",\"$La9\",\"\\n\",\"$Laa\",\"\\n\",\"$Lab\",\"\\n\",\"$Lac\",\"\\n\",\"$Lad\",\"\\n\",\"$Lae\",\"\\n\",\"$Laf\",\"\\n\",\"$Lb0\",\"\\n\",\"$Lb1\",\"\\n\",\"$Lb2\",\"\\n\",\"$Lb3\",\"\\n\",\"$Lb4\",\"\\n\",\"$Lb5\"]\n8b:[\"$\",\"$Lb6\",null,{\"heroName\":\"Lolita\"}]\n"])</script><script>self.__next_f.push([1,"8c:[\"$\",\"div\",null,{\"className\":\"relative bg-surface-4 border border-mlbb-gold/20 overflow-hidden card-hover hover:border-mlbb-gold/50\",\"style\":{\"boxShadow\":\"0 2px 8px rgba(0,0,0,0.3)\"},\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 p-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative w-14 h-14 rounded-full overflow-hidden flex-shrink-0 bg-surface-3\",\"children\":[\"$\",\"$L6b\",null,{\"src\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_4661a64a2c6b724e7b67032fcbface27.png\",\"alt\":\"Esmeralda - Astrologer\",\"unoptimized\":false,\"priority\":\"$undefined\",\"fetchPriority\":\"$undefined\",\"fill\":tr