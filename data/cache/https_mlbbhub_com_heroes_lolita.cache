ontrol is heavy enough that Fortitude's duration cut is worth giving up 15 Movement Speed.\"},{\"item\":{\"slug\":\"dominance-ice\",\"name\":\"Dominance Ice\"},\"replace\":{\"slug\":\"fleeting-time\",\"name\":\"Fleeting Time\"},\"trigger\":\"Use when enemy sustain or attack speed must be checked before ultimate resets matter.\"},{\"item\":{\"slug\":\"guardian-helmet\",\"name\":\"Guardian Helmet\"},\"replace\":{\"slug\":\"antique-cuirass\",\"name\":\"Antique Cuirass\"},\"trigger\":\"Use when your team already wins first contact but Lolita enters every second rotation too low.\"}],\"notes\":\"Pickoff setup for teams that need Conceal plus Flicker to start fights from fog instead of only peeling behind Guardian's Reflection.\",\"totalCost\":11060,\"statLines\":[{\"key\":\"adaptiveatk\",\"labelKey\":\"common.stats.adaptiveAttack\",\"unit\":\"flat\",\"group\":\"offensive\",\"value\":30,\"sources\":[\"Fleeting Time\"]},{\"key\":\"hp\",\"labelKey\":\"common.stats.hp\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":4020,\"sources\":[\"Thunder Belt\",\"Fleeting Time\",\"Athena's Shield\",\"Antique Cuirass\",\"Immortality\"]},{\"key\":\"hpregen\",\"labelKey\":\"common.stats.hpRegen\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":6,\"sources\":[\"Athena's Shield\",\"Antique Cuirass\"]},{\"key\":\"physdefense\",\"labelKey\":\"common.stats.physicalDefense\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":70,\"sources\":[\"Thunder Belt\",\"Antique Cuirass\",\"Immortality\"]},{\"key\":\"magicdefense\",\"labelKey\":\"common.stats.magicDefense\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":63,\"sources\":[\"Thunder Belt\",\"Athena's Shield\"]},{\"key\":\"slowreduction\",\"labelKey\":\"common.stats.slowReduction\",\"unit\":\"percent\",\"group\":\"defensive\",\"value\":35,\"sources\":[\"Rapid Boots\"]},{\"key\":\"movespeed\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"flat\",\"group\":\"utility\",\"value\":75,\"sources\":[\"Rapid Boots\",\"Thunder Belt\"]},{\"key\":\"cdreduction\",\"labelKey\":\"common.stats.cooldownReduction\",\"unit\":\"percent\",\"group\":\"utility\",\"value\":15,\"sources\":[\"Fleeting Time\"]}],\"conflicts\":[],\"simulatorUrl\":\"/build-simulator?hero=lolita\u0026items=rapid-boots%2Cthunder-belt%2Cfleeting-time%2Cathenas-shield%2Cantique-cuirass%2Cimmortality\u0026blessing=conceal\u0026spell=flicker\u0026emblem=support\u0026talents=agility%2Cpull-yourself-together%2Cfocusing-mark\u0026flex=tough-boots.rapid-boots%2Cdominance-ice.fleeting-time%2Cguardian-helmet.antique-cuirass\"},{\"slot\":3,\"id\":\"roam-anti-basic-wall\",\"name\":\"Roam Anti-Basic Wall\",\"roleContext\":\"Roam\",\"items\":[{\"slug\":\"warrior-boots\",\"name\":\"Warrior Boots\",\"cost\":720,\"fixed\":false},{\"slug\":\"dominance-ice\",\"name\":\"Dominance Ice\",\"cost\":2010,\"fixed\":false},{\"slug\":\"blade-armor\",\"name\":\"Blade Armor\",\"cost\":1910,\"fixed\":false},{\"slug\":\"chastise-pauldron\",\"name\":\"Chastise Pauldron\",\"cost\":2100,\"fixed\":false},{\"slug\":\"oracle\",\"name\":\"Oracle\",\"cost\":1860,\"fixed\":false},{\"slug\":\"immortality\",\"name\":\"Immortality\",\"cost\":2120,\"fixed\":false}],\"coreItems\":[{\"slug\":\"dominance-ice\",\"name\":\"Dominance Ice\"},{\"slug\":\"blade-armor\",\"name\":\"Blade Armor\"},{\"slug\":\"chastise-pauldron\",\"name\":\"Chastise Pauldron\"}],\"emblem\":{\"slug\":\"tank\",\"name\":\"Tank Emblem\",\"talents\":[{\"slug\":\"vitality\",\"name\":\"Vitality\",\"iconUrl\":\"/images/talents/vitality.png\",\"bucket\":\"standard\"},{\"slug\":\"tenacity\",\"name\":\"Tenacity\",\"iconUrl\":\"/images/talents/tenacity.png\",\"bucket\":\"standard\"},{\"slug\":\"concussive-blast\",\"name\":\"Concussive Blast\",\"iconUrl\":\"/images/talents/concussive-blast.png\",\"bucket\":\"core\"}]},\"spell\":{\"slug\":\"revitalize\",\"name\":\"Revitalize\"},\"blessing\":{\"slug\":\"encourage\",\"name\":\"Encourage\"},\"flexItems\":[{\"item\":{\"slug\":\"tough-boots\",\"name\":\"Tough Boots\"},\"replace\":{\"slug\":\"warrior-boots\",\"name\":\"Warrior Boots\"},\"trigger\":\"Use when the marksman is backed by enough control that Lolita cannot hold shield angles cleanly.\"},{\"item\":{\"slug\":\"athenas-shield\",\"name\":\"Athena's Shield\"},\"replace\":{\"slug\":\"oracle\",\"name\":\"Oracle\"},\"trigger\":\"Use when magic burst is the threat that breaks Lolita before the basic-attack carry can be punished.\"},{\"item\":{\"slug\":\"thunder-belt\",\"name\":\"Thunder Belt\"},\"replace\":{\"slug\":\"chastise-pauldron\",\"name\":\"Chastise Pauldron\"},\"trigger\":\"Use when the enemy marksman is not the only threat and Lolita can safely stack enhanced basic attacks.\"}],\"notes\":\"Defensive anti-marksman wall for games where Lolita must absorb repeated basic attacks and hold Revitalize for grouped objective fights.\",\"totalCost\":10720,\"statLines\":[{\"key\":\"hp\",\"labelKey\":\"common.stats.hp\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":2550,\"sources\":[\"Chastise Pauldron\",\"Oracle\",\"Immortality\"]},{\"key\":\"physdefense\",\"labelKey\":\"common.stats.physicalDefense\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":203,\"sources\":[\"Warrior Boots\",\"Dominance Ice\",\"Blade Armor\",\"Chastise Pauldron\",\"Oracle\",\"Immortality\"]},{\"key\":\"magicdefense\",\"labelKey\":\"common.stats.magicDefense\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":60,\"sources\":[\"Dominance Ice\",\"Oracle\"]},{\"key\":\"critdmgReduction\",\"labelKey\":\"common.stats.criticalDamageReduction\",\"unit\":\"percent\",\"group\":\"defensive\",\"value\":20,\"sources\":[\"Blade Armor\"]},{\"key\":\"movespeed\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"flat\",\"group\":\"utility\",\"value\":40,\"sources\":[\"Warrior Boots\"]},{\"key\":\"movespeedPct\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"percent\",\"group\":\"utility\",\"value\":5,\"sources\":[\"Dominance Ice\"]},{\"key\":\"cdreduction\",\"labelKey\":\"common.stats.cooldownReducti