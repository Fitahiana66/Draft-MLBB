\"@context\":\"https://schema.org\",\"@type\":\"HowTo\",\"name\":\"How to Build Lolita in Mobile Legends: Roam Conceal Pickoff\",\"description\":\"Pickoff setup for teams that need Conceal plus Flicker to start fights from fog instead of only peeling behind Guardian's Reflection.\",\"totalTime\":\"PT15M\",\"supply\":[{\"@type\":\"HowToSupply\",\"name\":\"Rapid Boots\"},{\"@type\":\"HowToSupply\",\"name\":\"Thunder Belt\"},{\"@type\":\"HowToSupply\",\"name\":\"Fleeting Time\"},{\"@type\":\"HowToSupply\",\"name\":\"Athena's Shield\"},{\"@type\":\"HowToSupply\",\"name\":\"Antique Cuirass\"},{\"@type\":\"HowToSupply\",\"name\":\"Immortality\"}],\"tool\":[{\"@type\":\"HowToTool\",\"name\":\"Support Emblem\"},{\"@type\":\"HowToTool\",\"name\":\"Flicker Battle Spell\"}],\"step\":[{\"@type\":\"HowToStep\",\"position\":1,\"name\":\"Buy Rapid Boots\",\"text\":\"Purchase Rapid Boots (750 gold) as item 1 in the Roam Conceal Pickoff build for Lolita.\",\"url\":\"https://mlbbhub.com/heroes/lolita#build-roam-conceal-pickoff\"},{\"@type\":\"HowToStep\",\"position\":2,\"name\":\"Buy Thunder Belt\",\"text\":\"Purchase Thunder Belt (1,820 gold) as item 2 in the Roam Conceal Pickoff build for Lolita.\",\"url\":\"https://mlbbhub.com/heroes/lolita#build-roam-conceal-pickoff\"},{\"@type\":\"HowToStep\",\"position\":3,\"name\":\"Buy Fleeting Time\",\"text\":\"Purchase Fleeting Time (2,050 gold) as item 3 in the Roam Conceal Pickoff build for Lolita.\",\"url\":\"https://mlbbhub.com/heroes/lolita#build-roam-conceal-pickoff\"},{\"@type\":\"HowToStep\",\"position\":4,\"name\":\"Buy Athena's Shield\",\"text\":\"Purchase Athena's Shield (2,150 gold) as item 4 in the Roam Conceal Pickoff build for Lolita.\",\"url\":\"https://mlbbhub.com/heroes/lolita#build-roam-conceal-pickoff\"},{\"@type\":\"HowToStep\",\"position\":5,\"name\":\"Buy Antique Cuirass\",\"text\":\"Purchase Antique Cuirass (2,170 gold) as item 5 in the Roam Conceal Pickoff build for Lolita.\",\"url\":\"https://mlbbhub.com/heroes/lolita#build-roam-conceal-pickoff\"},{\"@type\":\"HowToStep\",\"position\":6,\"name\":\"Buy Immortality\",\"text\":\"Purchase Immortality (2,120 gold) as item 6 in the Roam Conceal Pickoff build for Lolita.\",\"url\":\"https://mlbbhub.com/heroes/lolita#build-roam-conceal-pickoff\"}],\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://mlbbhub.com/heroes/lolita\"},\"datePublished\":\"2026-04-18T00:00:00.000Z\",\"dateModified\":\"2026-08-18T00:00:00.000Z\",\"author\":{\"@type\":\"Organization\",\"name\":\"MLBBHub\",\"url\":\"https://mlbbhub.com\"}}5e:[\"$\",\"script\",\"1\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$63\"}}]\n64:T90a,{\"@context\":\"https://schema.org\",\"@type\":\"HowTo\",\"name\":\"How to Build Lolita in Mobile Legends: Roam Anti-Basic Wall\",\"description\":\"Defensive anti-marksman wall for games where Lolita must absorb repeated basic attacks and hold Revitalize for grouped objective fights.\",\"totalTime\":\"PT15M\",\"supply\":[{\"@type\":\"HowToSupply\",\"name\":\"Warrior Boots\"},{\"@type\":\"HowToSupply\",\"name\":\"Dominance Ice\"},{\"@type\":\"HowToSupply\",\"name\":\"Blade Armor\"},{\"@type\":\"HowToSupply\",\"name\":\"Chastise Pauldron\"},{\"@type\":\"HowToSupply\",\"name\":\"Oracle\"},{\"@type\":\"HowToSupply\",\"name\":\"Immortality\"}],\"tool\":[{\"@type\":\"HowToTool\",\"name\":\"Tank Emblem\"},{\"@type\":\"HowToTool\",\"name\":\"Revitalize Battle Spell\"}],\"step\":[{\"@type\":\"HowToStep\",\"position\":1,\"name\":\"Buy Warrior Boots\",\"text\":\"Purchase Warrior Boots (720 gold) as item 1 in the Roam Anti-Basic Wall build for Lolita.\",\"url\":\"https://mlbbhub.com/heroes/lolita#build-roam-anti-basic-wall\"},{\"@type\":\"HowToStep\",\"position\":2,\"name\":\"Buy Dominance Ice\",\"text\":\"Purchase Dominance Ice (2,010 gold) as item 2 in the Roam Anti-Basic Wall build for Lolita.\",\"url\":\"https://mlbbhub.com/heroes/lolita#build-roam-anti-basic-wall\"},{\"@type\":\"HowToStep\",\"position\":3,\"name\":\"Buy Blade Armor\",\"text\":\"Purchase Blade Armor (1,910 gold) as item 3 in the Roam Anti-Basic Wall build for Lolita.\",\"url\":\"https://mlbbhub.com/heroes/lolita#build-roam-anti-basic-wall\"},{\"@type\":\"HowToStep\",\"position\":4,\"name\":\"Buy Chastise Pauldron\",\"text\":\"Purchase Chastise Pauldron (2,100 gold) as item 4 in the Roam Anti-Basic Wall build for Lolita.\",\"url\":\"https://mlbbhub.com/heroes/lolita#build-roam-anti-basic-wall\"},{\"@type\":\"HowToStep\",\"position\":5,\"name\":\"Buy Oracle\",\"text\":\"Purchase Oracle (1,860 gold) as item 5 in the Roam Anti-Basic Wall build for Lolita.\",\"url\":\"https://mlbbhub.com/heroes/lolita#build-roam-anti-basic-wall\"},{\"@type\":\"HowToStep\",\"position\":6,\"name\":\"Buy Immortality\",\"text\":\"Purchase Immortality (2,120 gold) as item 6 in the Roam Anti-Basic Wall build for Lolita.\",\"url\":\"https://mlbbhub.com/heroes/lolita#build-roam-anti-basic-wall\"}],\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://mlbbhub.com/heroes/lolita\"},\"datePublished\":\"2026-04-18T00:00:00.000Z\",\"dateModified\":\"2026-08-18T00:00:00.000Z\",\"author\":{\"@type\":\"Organization\",\"name\":\"MLBBHub\",\"url\":\"https://mlbbhub.com\"}}5f:[\"$\",\"script\",\"2\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$64\"}}]\n60:[\"$\",\"$L65\",null,{\"hero\":{\"id\":20,\"name\":\"Lolita\",\"slug\":\"lolita\",\"title\":\"Steel Elf\",\"role\":[\"Support\",\"Tank\"],\"specialty\":[\"Guard\",\"Crowd Control\"],\"lane\":[\"Roam\"],\"tier\":\"A\",\"difficulty\":2,\"releaseYear\":2016,\"stats\":{\"durability\":100,\"offense\":10,\"controlEffect\":90,\"difficulty\":50},\"winRate\":54,\"pickRate\":0.08,\"banRate\":0.19,\"counters\":{\"strongAgainst\":[{\"heroSlug\":\"kimmy\",\"heroName\":\"Kimmy\",\"advantage\":\"strong\",\"tip\":\"Lolita's shield makes her strong against heroes who rely on projectiles and ranged skills, such as Kimmy and Cyclops.\"},{\"heroSlug\":\"cyclops\",\"heroName\":\"Cyclops\",\"advantage\":\"strong\",\"tip\":\"Lolita's shield makes her strong against heroes who rely on projectiles and ranged skills, such as Kimmy and Cyclops.\"}],\"weakAgainst\":[{\"heroSlug\":\"ling\",\"heroName\":\"Ling\",\"advantage\":\"weak\",\"tip\":\"Lolita is countered by melee heroes with high burst damage like Ling and Paquito.\"},{\"heroSlug\":\"paquito\",\"heroName\":\"Paquito\",\"advantage\":\"weak\",\"tip\":\"Lolita is countered by melee heroes with high burst damage like Ling and Paquito.\"}]},\"splashArt\":\"https://akmweb.youngjoygame.com/web/svnres/file/mlbb/homepage/100_1bc4973e512cf4958fe639e12391666e.jpg\",\"portrait\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_474cea36a4bfdc7bf7d94530853a99b2.png\",\"officialMatchups\":[{\"kind\":\"best_ally\",\"heroId\":\"39\",\"heroName\":\"Roger\",\"heroSlug\":\"roger\",\"icon\":\"https://akmwebstatic.yuanzhanapp.com/web/madmin/image_d2f1ce4289d7399177b7f8a25bdf593d.png\",\"tip\":\"Laning with him is really good because you both have crowd control and damage to kill anyone.\"},{\"kind\":\"counters\",\"heroId\":\"33\",\"heroName\":\"Cyclops\",\"heroSlug\":\"cyclops\",\"icon\":\"https://akmwebstatic.yuanzhanapp.com/web/madmin/image_cef4d89fd02965d3aae272c30990dbe8.png\",\"tip\":\"You can block each and every single attack so he is generally not a huge threat.\"},{\"kind\":\"countered_by\",\"heroId\":\"25\",\"heroName\":\"Kagura\",\"heroSlug\":\"kagura\",\"icon\":\"https://akmweb.youngjoygame.com/web/madmin/image/b7bedaacdacd3de349e538f72fe640c9.png?w=150-150-423c5f\",\"tip\":\"Kagura is a really slippery mage with multiple escape abilities. If you stun her with skill 1, she can get away easily. Her ultimate and teleporting to umbrella can cancel your ultimate, cancelling your most powerful skill. The only way to not get your ultimate interrupted is to pay attention to her skill usage. Make sure she have used both her umbrella teleport and dash, so she have no chance to cancel or escape your ultimate.\"}],\"skills\":{\"skills\":[{\"name\":\"Noumenon Energy Core\",\"type\":\"Passive\",\"description\":\"Every 6s to 3s (scales with Noumenon Blast level), the Noumenon Energy Core grants Lolita 20 (+2.5% Max HP) (+20% Total Magic Power) shield. When Lolita casts a skill, the Noumenon Energy Core grants Lolita and nearby allied heroes an extra shield. This shield can stack up to 3 times and lasts 30s.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Every 6s to 3s (scales with \"},{\"type\":\"text\",\"text\":\"Noumenon Blast\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" level), the Noumenon Energy Core grants Lolita 20 (+2.5% Max HP) \"},{\"type\":\"text\",\"text\":\"(+20% Total Magic Power)\",\"color\":\"#62f8fe\"},{\"type\":\"text\",\"text\":\" shield. When Lolita casts a skill, the Noumenon Energy Core grants Lolita and nearby allied heroes an extra shield. This shield can stack up to 3 times and lasts 30s.\"}],\"cooldown\":null,\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_8c26e0d0018fb46934ec1e079ddbe695.png\",\"tags\":[\"Shield\"]},{\"name\":\"Power Charge\",\"type\":\"Skill 1\",\"description\":\"Lolita dashes in the target direction. Her next Basic Attack within 4s will perform a short dash to the target, dealing 400 (+100% Total Physical Attack) Physical Damage and stunning them for 0.5s. This damage is doubled against Minions.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Lolita dashes in the target direction. Her next Basic Attack within 4s will perform a short dash to the target, dealing 400\"},{\"type\":\"text\",\"text\":\" (+100% Total Physical Attack)\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Physical Damage\",\"color\":\"#fb1f1f\"},{\"type\":\"text\",\"text\":\" and stunning them for 0.5s. This damage is doubled against Minions.\"}],\"cooldown\":\"10s\",\"manaCost\":\"70\",\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_e1554a16e239a56ab24a59ed06542a07.png\",\"tags\":[\"Mobility\",\"CC\"]},{\"name\":\"Guardian's Reflection\",\"type\":\"Skill 2\",\"description\":\"Lolita raises her shield and reflects all incoming ranged Basic Attacks and Projectiles in the direction of the shield for 3s. The shield will break after taking 1000 (+15% Max HP) damage.\\n\\nThe damage and effects from the Unique Passives of an attacker's equipment will not apply to the shield and will not be reflected. This skill can be interrupted by high level control effects.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Lolita raises her shield and reflects all incoming ranged Basic Attacks and \"},{\"type\":\"text\",\"text\":\"Projectiles\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" in the direction of the shield for 3s. The shield will break after taking 1000 (+15% Max HP) damage.\\n\\nThe damage and effects from the Unique Passives of an attacker's equipment will not apply to the shield and will not be reflected. This skill can be interrupted by high level control effects.\"}],\"cooldown\":\"15s\",\"manaCost\":\"90\",\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_c667899aa7f531fa5b199327be638d54.png\",\"tags\":[\"Shield\",\"Damage\"]},{\"name\":\"Noumenon Blast\",\"type\":\"Ultimate\",\"description\":\"Passive: Reduces the interval of Noumenon Energy Core by 1s each time this skill is upgraded.\\n\\nActive: Lolita begins charging for 2s while slowing enemies in a fan-shaped area by 60%. When the charging is complete or is stopped, Lolita slams her hammer on the ground, dealing up to 600 (+100% Total Physical Attack) Physical Damage to enemies in the area and stunning them for up to 2s (damage and stun duration scale with charge time).\\n\\nUse Again: Lolita immediately stops charging and slams her hammer on the ground.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Passive\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\": Reduces the interval of \"},{\"type\":\"text\",\"text\":\"Noumenon Energy Core\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" by 1s each time this skill is upgraded.\\n\\n\"},{\"type\":\"text\",\"text\":\"Active\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\": Lolita begins charging for 2s while slowing enemies in a fan-shaped area by 60%. When the charging is complete or is stopped, Lolita slams her hammer on the ground, dealing up to 600\"},{\"type\":\"text\",\"text\":\" (+100% Total Physical Attack)\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Physical Damage\",\"color\":\"#fb1f1f\"},{\"type\":\"text\",\"text\":\" to enemies in the area and stunning them for up to 2s (damage and stun duration scale with charge time).\\n\\n\"},{\"type\":\"text\",\"text\":\"Use Again\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\": Lolita immediately stops charging and slams her hammer on the ground.\"}],\"cooldown\":\"55s\",\"manaCost\":\"100\",\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_139bfe9c5e5ab063c0988222a5a3c456.png\",\"tags\":[\"CC\",\"AOE\"]}],\"skillUpgradePriority\":\"3-1-2\",\"skillPriorityTip\":\"Flicker is good to do combos and for chasing / escape\",\"skillPriorityTipRich\":[{\"type\":\"text\",\"text\":\"Flicker is good to do combos and for chasing / escape\"}]},\"synergies\":[{\"heroSlug\":\"hanabi\",\"heroName\":\"Hanabi\",\"synergyScore\":8,\"reason\":\"Due to her powerful defensive and CC abilities, Lolita is great at protecting Marksmen like Hanabi and Layla.\"},{\"heroSlug\":\"layla\",\"heroName\":\"Layla\",\"synergyScore\":8,\"reason\":\"Due to her powerful defensive and CC abilities, Lolita is great at protecting Marksmen like Hanabi and Layla.\"}],\"combos\":[{\"type\":\"teamfight\",\"title\":\"TEAMFIGHT COMBOS\",\"description\":\"In teamfights, use Lolita's 2nd Skill to reflect ranged attacks, followed by her 1st Skill to charge into enemies' midst, then use her enhanced Basic Attack to stun the target and deal damage. Follow up with her Ultimate for more damage and CC, and finish off the enemy with your team.\",\"skillSequence\":[{\"skillId\":2020,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_c667899aa7f531fa5b199327be638d54.png\"},{\"skillId\":2010,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_e1554a16e239a56ab24a59ed06542a07.png\"},{\"skillId\":2000,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_f98d2e98eaebfb31c6c5101cf1c3201a.png\"},{\"skillId\":2030,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_139bfe9c5e5ab063c0988222a5a3c456.png\"}]},{\"type\":\"laning\",\"title\":\"LANING COMBOS\",\"description\":\"In the laning phase, use Lolita's 1st Skill and enhanced Basic Attack to stun the enemy, then use her 2nd Skill to reflect ranged attacks.\",\"skillSequence\":[{\"skillId\":2010,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_e1554a16e239a56ab24a59ed06542a07.png\"},{\"skillId\":2000,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_f98d2e98eaebfb31c6c5101cf1c3201a.png\"},{\"skillId\":2020,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_c667899aa7f531fa5b199327be638d54.png\"}]}],\"metaDescription\":\"Lolita build, counter, and strategy guide for Mobile Legends. Learn when to draft her, how Thunder Belt changes fights, and which enemy comps make her a trap.\",\"builds\":[],\"overviewLede\":\"Lolita is not a blind tank. She is a veto button for drafts that want to win through bullets, stars, cards, and long-range poke, and she feels ordinary the moment the enemy stops giving her something to reject. Pick her when one denied projectile window will decide the fight, then play the rest of the game around that stolen tempo.\"},\"serverLocale\":\"en\",\"curatedBuilds\":{\"source\":\"curated\",\"hero\":\"lolita\",\"patch\":\"2.1.67\",\"lastReviewed\":\"2026-08-18\",\"stalePatch\":true,\"currentPatch\":\"2.2.16a\",\"builds\":[{\"slot\":1,\"id\":\"roam-favor-projectile-peel\",\"name\":\"Roam Favor Projectile Peel\",\"roleContext\":\"Roam\",\"items\":[{\"slug\":\"tough-boots\",\"name\":\"Tough Boots\",\"cost\":700,\"fixed\":false},{\"slug\":\"thunder-belt\",\"name\":\"Thunder Belt\",\"cost\":1820,\"fixed\":false},{\"slug\":\"flask-of-the-oasis\",\"name\":\"Flask of the Oasis\",\"cost\":1850,\"fixed\":false},{\"slug\":\"dominance-ice\",\"name\":\"Dominance Ice\",\"cost\":2010,\"fixed\":false},{\"slug\":\"oracle\",\"name\":\"Oracle\",\"cost\":1860,\"fixed\":false},{\"slug\":\"immortality\",\"name\":\"Immortality\",\"cost\":2120,\"fixed\":false}],\"coreItems\":[{\"slug\":\"thunder-belt\",\"name\":\"Thunder Belt\"},{\"slug\":\"flask-of-the-oasis\",\"name\":\"Flask of the Oasis\"},{\"slug\":\"dominance-ice\",\"name\":\"Dominance Ice\"}],\"emblem\":{\"slug\":\"support\",\"name\":\"Support Emblem\",\"talents\":[{\"slug\":\"agility\",\"name\":\"Agility\",\"iconUrl\":\"/images/talents/agility.png\",\"bucket\":\"standard\"},{\"slug\":\"pull-yourself-together\",\"name\":\"Pull Yourself Together\",\"iconUrl\":\"/images/talents/pull-yourself-together.png\",\"bucket\":\"standard\"},{\"slug\":\"focusing-mark\",\"name\":\"Focusing Mark\",\"iconUrl\":\"/images/talents/focusing-mark.png\",\"bucket\":\"core\"}]},\"spell\":{\"slug\":\"flicker\",\"name\":\"Flicker\"},\"blessing\":{\"slug\":\"favor\",\"name\":\"Favor\"},\"flexItems\":[{\"item\":{\"slug\":\"athenas-shield\",\"name\":\"Athena's Shield\"},\"replace\":{\"slug\":\"oracle\",\"name\":\"Oracle\"},\"trigger\":\"Use when one magic burst combo can remove Lolita before Guardian's Reflection or Flicker can reset the fight.\"},{\"item\":{\"slug\":\"radiant-armor\",\"name\":\"Radiant Armor\"},\"replace\":{\"slug\":\"oracle\",\"name\":\"Oracle\"},\"trigger\":\"Use against repeated magic poke or burn that keeps tagging Lolita before objective fights.\"},{\"item\":{\"slug\":\"antique-cuirass\",\"name\":\"Antique Cuirass\"},\"replace\":{\"slug\":\"dominance-ice\",\"name\":\"Dominance Ice\"},\"trigger\":\"Use when physical skill burst matters more than attack-speed pressure or enemy sustain.\"}],\"notes\":\"Default ranked roam setup for projectile-heavy drafts where Lolita protects the carry while still threatening Flicker stun and Thunder Belt trades.\",\"totalCost\":10360,\"statLines\":[{\"key\":\"magicpower\",\"labelKey\":\"common.stats.magicPower\",\"unit\":\"flat\",\"group\":\"offensive\",\"value\":60,\"sources\":[\"Flask of the Oasis\"]},{\"key\":\"hp\",\"labelKey\":\"common.stats.hp\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":2750,\"sources\":[\"Thunder Belt\",\"Flask of the Oasis\",\"Oracle\",\"Immortality\"]},{\"key\":\"physdefense\",\"labelKey\":\"common.stats.physicalDefense\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":90,\"sources\":[\"Thunder Belt\",\"Dominance Ice\",\"Oracle\",\"Immortality\"]},{\"key\":\"magicdefense\",\"labelKey\":\"common.stats.magicDefense\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":93,\"sources\":[\"Tough Boots\",\"Thunder Belt\",\"Dominance Ice\",\"Oracle\"]},{\"key\":\"movespeed\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"flat\",\"group\":\"utility\",\"value\":60,\"sources\":[\"Tough Boots\",\"Thunder Belt\"]},{\"key\":\"movespeedPct\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"percent\",\"group\":\"utility\",\"value\":5,\"sources\":[\"Dominance Ice\"]},{\"key\":\"cdreduction\",\"labelKey\":\"common.stats.cooldownReduction\",\"unit\":\"percent\",\"group\":\"utility\",\"value\":20,\"sources\":[\"Flask of the Oasis\",\"Oracle\"]},{\"key\":\"healingEffect\",\"labelKey\":\"common.stats.healingEffect\",\"unit\":\"percent\",\"group\":\"u