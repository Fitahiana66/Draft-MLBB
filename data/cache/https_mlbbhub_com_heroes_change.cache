 border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #C8AA6E, #C8AA6E33)\",\"boxShadow\":\"0 0 12px -2px #C8AA6E80\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#C8AA6E\",\"background\":\"#C8AA6E1a\",\"border\":\"1px solid #C8AA6E40\"},\"children\":\"Mythical Honor\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Chang'e\",\"rank\":\"Mythical Honor\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=mythical_honor\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Mythical Honor\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Mythical Honor\",\"name\":\"Chang'e\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"46.10\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Chang'e\",\"delta\":\"-1.83%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.55\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.12\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Mythical Honor\"}}]]}]]}]\na5:[\"$\",\"article\",\"mythical_glory\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #ff5d73, #ff5d7333)\",\"boxShadow\":\"0 0 12px -2px #ff5d7380\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#ff5d73\",\"background\":\"#ff5d731a\",\"border\":\"1px solid #ff5d7340\"},\"children\":\"Mythical Glory+\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Chang'e\",\"rank\":\"Mythical Glory+\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=mythical_glory\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Mythical Glory+\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Mythical Glory+\",\"name\":\"Chang'e\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"44.45\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Chang'e\",\"delta\":\"-3.48%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.38\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.06\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Mythical Glory+\"}}]]}]]}]\na7:[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}]\na8:[\"$\",\"p\",\"p-3\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"The three locked items are Genius Wand, Holy Crystal, and Divine Glaive.\"}],\" Genius Wand first for the magic defense shred and early power spike. Holy Crystal second for the raw Magic Power and percentage multiplier. Divine Glaive third for its Spellbreaker passive, which grants extra magic penetration that scales with the target's magic defense. By the time you have all three, Meteor Shower punches through Athena's Shield and Radiant Armor regardless of how much magic resistance the enemy stacked.\"]}]\na9:[\"$\",\"p\",\"p-4\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"The boot slot.\"}],\" Arcane Boots is the default for the flat magic penetration, which amplifies every hit in Chang'e's multi-projectile kit. Tough Boots replaces it when the enemy has three or more crowd-control threats: a dead Chang'e deals no sustained damage, and Tough Boots' Fortitude passive reduces CC duration by a full 30 percent. Rapid Boots does not fit Chang'e because its Side Effect passive strips movement speed when she deals or takes damage, which is her entire job.\"]}]\naa:[\"$\",\"p\",\"p-5\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"The fourth slot.\"}],\" Ice Queen Wand when you need the slow to kite divers: its Ice Bound passive stacks a percentage slow per hit and layers on top of Starmoon Shockwave's built-in slow, making it almost impossible for fighters to close distance during your ultimate channel. Glowing Wand when the enemy has two or more HP-stacking frontliners: Scorch burns them for percent-max-HP damage per second and ticks alongside every meteor. Blood Wings when you are snowballing: the Guard shield stacks with Crescent Moon's shield, giving you two layers of defense before the enemy touches your health bar.\"]}]\nab:[\"$\",\"p\",\"p-6\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"The fifth slot.\"}],\" Enchanted Talisman if extended objective fights are running you dry: 20 percent CDR plus the Mana Spring passive, which regenerates a chunk of max mana over each ten-second window, means you can ult twice per Lord contest. Blood Wings if you did not buy it in the fourth slot and want the double-shield safety.\"]}]\nac:[\"$\",\"p\",\"p-7\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"The weakest common default is Clock of Destiny.\"}],\" It offers HP, mana, a modest flat amount of Magic Power, and CDR, but its passive stacks hybrid defense on damage dealt rather than adding damage or penetration. Every other item Chang'e rushes gives either immediate magic defense shred (Genius Wand), a percentage multiplier on her total damage (Holy Crystal), or percent-based penetration (Divine Glaive). Clock of Destiny delays all three of them and adds sustain that Chang'e does not need if she manages her mana.\"]}]\nad:[\"$\",\"h2\",\"h2-2\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Mistakes that lose Chang'e games\"]}]\nae:[\"$\",\"p\",\"p-8\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Ulting into Lolita's Guardian's Reflection.\"}],\" Every meteor you fire into Lolita's shield is absorbed and charges her counterblast. She blocks the full channel, then unloads all that stored damage back at your team. If Lolita raises her shield, cancel Meteor Shower immediately by issuing a move command and wait for the shield to expire. A canceled ult on cooldown stings. Feeding her team a damage bomb from your own meteors loses the fight.\"]}]\naf:[\"$\",\"p\",\"p-9\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Channeling ult without Crescent Moon active.\"}],\" Base Meteor Shower fires a fraction of the projectiles the empowered version does, so you lose the second meteor stream, the extra slow stacks, and half the Genius Wand shred procs that make the channel lethal. Pressing R without S2 active is literally playing half the hero. If Crescent Moon is on cooldown because the shield just broke, wait for it to come back. Never raw-ult.\"]}]\nb0:[\"$\",\"p\",\"p-10\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Activating Crescent Moon reactively after the burst already landed.\"}],\" The shield scales with Total Magic Power, not max HP. It absorbs roughly one assassin rotation's worth of damage. If you press S2 after Saber already landed his full combo, you put the shield on when you are at low HP and the next stray auto attack will pop it. Activate Crescent Moon preemptively before you see the threat. The shield is free armor. Wearing it before the punch lands is the entire point of the skill.\"]}]\nb1:[\"$\",\"p\",\"p-11\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Forcing fights before Genius Wand is complete.\"}],\" Chang'e's ult without Genius Wand does chip damage that feels satisfying but does not actually kill. The magic defense shred is what makes the channel lethal. If you pick a fight at minute 5 with only boots and components, you will channel for the full duration, deal a chunk of someone's HP, deplete your mana bar, and watch them recall and return. Farm to Genius Wand first. Then fight.\"]}]\nb2:[\"$\",\"p\",\"p-12\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Ignoring your mana bar before committing to an ult channel.\"}],\" One full rotation (S2 plus S1 plus ultimate) still eats a real slice of Chang'e's mana pool at mid-game even after the 2.1.61 cost buffs, and a channel you have to abandon because the bar hit zero is a wasted cooldown and a lost fight. Always check your mana before committing. If you are below the threshold for a full rotation, poke with S1, clear a wave, and look for the next window.\"]}]\nb3:[\"$\",\"h2\",\"h2-3\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Key tips\"]}]\nb4:[\"$\",\"div\",\"blockquote-0\",{\"className\":\"my-5 p-4 flex gap-3\",\"style\":{\"background\":\"rgba(200,170,110,0.08)\",\"border\":\"1px solid rgba(200,170,110,0.35)\"},\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-lightbulb w-4 h-4 flex-shrink-0 mt-0.5\",\"aria-hidden\":\"true\",\"style\":{\"color\":\"#C8AA6E\"},\"children\":[[\"$\",\"path\",\"1gvzjb\",{\"d\":\"M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5\"}],[\"$\",\"path\",\"x1upvd\",{\"d\":\"M9 18h6\"}],[\"$\",\"path\",\"ceow96\",{\"d\":\"M10 22h4\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[11px] font-heading font-bold uppercase tracking-wider mb-1\",\"style\":{\"color\":\"#C8AA6E\"},\"children\":\"Tip\"}],[[\"$\",\"p\",\"0\",{\"className\":\"text-sm text-[#9BA0B4] leading-relaxed\",\"children\":[\"Cancel Meteor Shower early when no one is standing in it. The full channel locks you in place and burns mana on empty meteors. A move command ends the channel instantly. Fire enough meteors to stack Trouble Maker on the target, then finish with S1 instead of standing still for the full duration.\"]}]]]}]]}]\nb5:[\"$\",\"div\",\"blockquote-1\",{\"className\":\"my-5 p-4 flex gap-3\",\"style\":{\"background\":\"rgba(0,170,255,0.08)\",\"border\":\"1px solid rgba(0,170,255,0.35)\"},\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-info w-4 h-4 flex-shrink-0 mt-0.5\",\"aria-hidden\":\"true\",\"style\":{\"color\":\"#00AAFF\"},\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"1dtifu\",{\"d\":\"M12 16v-4\"}],[\"$\",\"path\",\"e9boi3\",{\"d\":\"M12 8h.01\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[11px] font-heading font-bold uppercase tracking-wider mb-1\",\"style\":{\"color\":\"#00AAFF\"},\"children\":\"Note\"}],[[\"$\",\"p\",\"0\",{\"className\":\"text-sm text-[#9BA0B4] leading-relaxed\",\"children\":[\"Meteor Shower deals bonus damage to minions and creeps, which means you can steal Turtle or Lord from over a wall. Aim your ult through the pit when the objective is low. The full channel with Crescent Moon's second meteor stream will out-DPS most junglers' Retribution timing if you start channeling early enough.\"]}]]]}]]}]\nb6:[\"$\",\"div\",\"blockquote-2\",{\"className\":\"my-5 p-4 flex gap-3\",\"style\":{\"background\":\"rgba(200,170,110,0.08)\",\"border\":\"1px solid rgba(200,170,110,0.35)\"},\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-lightbulb w-4 h-4 flex-shrink-0 mt-0.5\",\"aria-hidden\":\"true\",\"style\":{\"color\":\"#C8AA6E\"},\"children\":[[\"$\",\"path\",\"1gvzjb\",{\"d\":\"M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5\"}],[\"$\",\"path\",\"x1upvd\",{\"d\":\"M9 18h6\"}],[\"$\",\"path\",\"ceow96\",{\"d\":\"M10 22h4\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[11px] font-heading font-bold uppercase tracking-wider mb-1\",\"style\":{\"color\":\"#C8AA6E\"},\"children\":\"Tip\"}],[[\"$\",\"p\",\"0\",{\"className\":\"text-sm text-[#9BA0B4] leading-relaxed\",\"children\":[\"Crescent Moon's movement speed burst triggers on every skill cast, not just S2. During a chase, cycle S1 on cooldown even if it misses, because each cast refreshes the decaying speed bonus. This makes Chang'e one of the fastest heroes in the game during extended sequences where she keeps casting.\"]}]]]}]]}]\nb7:[\"$\",\"div\",\"blockquote-3\",{\"className\":\"my-5 p-4 flex gap-3\",\"style\":{\"background\":\"rgba(0,170,255,0.08)\",\"border\":\"1px solid rgba(0,170,255,0.35)\"},\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-info w-4 h-4 flex-shrink-0 mt-0.5\",\"aria-hidden\":\"true\",\"style\":{\"color\":\"#00AAFF\"},\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"1dtifu\",{\"d\":\"M12 16v-4\"}],[\"$\",\"path\",\"e9boi3\",{\"d\":\"M12 8h.01\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[11px] font-heading font-bold uppercase tracking-wider mb-1\",\"style\":{\"color\":\"#00AAFF\"},\"children\":\"Note\"}],[[\"$\",\"p\",\"0\",{\"className\":\"text-sm text-[#9BA0B4] leading-relaxed\",\"children\":[\"In a side lane split-push, Crescent Moon's enhanced basics still deal bonus magic damage to towers, though the 2.1.30 patch trimmed how much. Push a lane, force a rotation, then ult toward the objective they left unguarded.\"]}]]]}]]}]\n"])</script></body></html>