ToStep\",\"position\":6,\"name\":\"Buy Divine Glaive\",\"text\":\"Purchase Divine Glaive (1,970 gold) as item 6 in the Split-Push Attack Speed build for Chang'e.\",\"url\":\"https://mlbbhub.com/heroes/change#build-split-push-attack-speed\"}],\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://mlbbhub.com/heroes/change\"},\"datePublished\":\"2026-04-13T00:00:00.000Z\",\"dateModified\":\"2026-05-12T00:00:00.000Z\",\"author\":{\"@type\":\"Organization\",\"name\":\"MLBBHub\",\"url\":\"https://mlbbhub.com\"}}5f:[\"$\",\"script\",\"1\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$63\"}}]\n64:T8e5,{\"@context\":\"https://schema.org\",\"@type\":\"HowTo\",\"name\":\"How to Build Chang'e in Mobile Legends: Anti-Dive Control\",\"description\":\"Defensive mid setup for hard-engage drafts where Chang'e must keep Crescent Moon active, slow divers, and survive the first lockout.\",\"totalTime\":\"PT15M\",\"supply\":[{\"@type\":\"HowToSupply\",\"name\":\"Tough Boots\"},{\"@type\":\"HowToSupply\",\"name\":\"Genius Wand\"},{\"@type\":\"HowToSupply\",\"name\":\"Ice Queen Wand\"},{\"@type\":\"HowToSupply\",\"name\":\"Winter Crown\"},{\"@type\":\"HowToSupply\",\"name\":\"Divine Glaive\"},{\"@type\":\"HowToSupply\",\"name\":\"Blood Wings\"}],\"tool\":[{\"@type\":\"HowToTool\",\"name\":\"Mage Emblem\"},{\"@type\":\"HowToTool\",\"name\":\"Purify Battle Spell\"}],\"step\":[{\"@type\":\"HowToStep\",\"position\":1,\"name\":\"Buy Tough Boots\",\"text\":\"Purchase Tough Boots (700 gold) as item 1 in the Anti-Dive Control build for Chang'e.\",\"url\":\"https://mlbbhub.com/heroes/change#build-anti-dive-control\"},{\"@type\":\"HowToStep\",\"position\":2,\"name\":\"Buy Genius Wand\",\"text\":\"Purchase Genius Wand (2,000 gold) as item 2 in the Anti-Dive Control build for Chang'e.\",\"url\":\"https://mlbbhub.com/heroes/change#build-anti-dive-control\"},{\"@type\":\"HowToStep\",\"position\":3,\"name\":\"Buy Ice Queen Wand\",\"text\":\"Purchase Ice Queen Wand (2,040 gold) as item 3 in the Anti-Dive Control build for Chang'e.\",\"url\":\"https://mlbbhub.com/heroes/change#build-anti-dive-control\"},{\"@type\":\"HowToStep\",\"position\":4,\"name\":\"Buy Winter Crown\",\"text\":\"Purchase Winter Crown (1,910 gold) as item 4 in the Anti-Dive Control build for Chang'e.\",\"url\":\"https://mlbbhub.com/heroes/change#build-anti-dive-control\"},{\"@type\":\"HowToStep\",\"position\":5,\"name\":\"Buy Divine Glaive\",\"text\":\"Purchase Divine Glaive (1,970 gold) as item 5 in the Anti-Dive Control build for Chang'e.\",\"url\":\"https://mlbbhub.com/heroes/change#build-anti-dive-control\"},{\"@type\":\"HowToStep\",\"position\":6,\"name\":\"Buy Blood Wings\",\"text\":\"Purchase Blood Wings (2,100 gold) as item 6 in the Anti-Dive Control build for Chang'e.\",\"url\":\"https://mlbbhub.com/heroes/change#build-anti-dive-control\"}],\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://mlbbhub.com/heroes/change\"},\"datePublished\":\"2026-04-13T00:00:00.000Z\",\"dateModified\":\"2026-05-12T00:00:00.000Z\",\"author\":{\"@type\":\"Organization\",\"name\":\"MLBBHub\",\"url\":\"https://mlbbhub.com\"}}60:[\"$\",\"script\",\"2\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$64\"}}]\n61:[\"$\",\"$L65\",null,{\"hero\":{\"id\":61,\"name\":\"Chang'e\",\"slug\":\"change\",\"title\":\"Moon Palace Immortal\",\"role\":[\"Mage\"],\"specialty\":[\"Poke\",\"Burst\"],\"lane\":[\"Mid\"],\"tier\":\"C\",\"difficulty\":2,\"releaseYear\":2018,\"stats\":{\"durability\":40,\"offense\":80,\"controlEffect\":20,\"difficulty\":40},\"winRate\":47.88,\"pickRate\":0.71,\"banRate\":0.34,\"counters\":{\"strongAgainst\":[{\"heroSlug\":\"eudora\",\"heroName\":\"Eudora\",\"advantage\":\"strong\",\"tip\":\"Chang'e is strong against squishy heroes who have low mobility and short damage range, such as Eudora and Odette. Chang'e can easily hit them with her long-range skills while dodging their attacks.\"},{\"heroSlug\":\"odette\",\"heroName\":\"Odette\",\"advantage\":\"strong\",\"tip\":\"Chang'e is strong against squishy heroes who have low mobility and short damage range, such as Eudora and Odette. Chang'e can easily hit them with her long-range skills while dodging their attacks.\"}],\"weakAgainst\":[{\"heroSlug\":\"hanzo\",\"heroName\":\"Hanzo\",\"advantage\":\"weak\",\"tip\":\"Chang'e is countered by agile Assassins with high burst like Hanzo and Harley, as they can avoid Chang'e's skills and use their high burst damage to kill her since she lacks self-protection.\"},{\"heroSlug\":\"harley\",\"heroName\":\"Harley\",\"advantage\":\"weak\",\"tip\":\"Chang'e is countered by agile Assassins with high burst like Hanzo and Harley, as they can avoid Chang'e's skills and use their high burst damage to kill her since she lacks self-protection.\"}]},\"splashArt\":\"https://akmweb.youngjoygame.com/web/svnres/file/mlbb/homepage/100_bf3d5cdc1c0e33f5aab7732e153c7409.jpg\",\"portrait\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_46cfe9c30e8a14f85b4d022496aca274.png\",\"officialMatchups\":[{\"kind\":\"best_ally\",\"heroId\":\"6\",\"heroName\":\"Tigreal\",\"heroSlug\":\"tigreal\",\"icon\":\"https://akmwebstatic.yuanzhanapp.com/web/madmin/image_23a7a603ff9d20074777d52e2eb202f3.jpg\",\"tip\":\"Chang’e works great with heroes that can concentrate enemy units in a single area. These kinds of heroes can help her 2nd skill reach its maximum DPS potential.\"},{\"kind\":\"counters\",\"heroId\":\"54\",\"heroName\":\"Jawhead\",\"heroSlug\":\"jawhead\",\"icon\":\"https://akmwebstatic.yuanzhanapp.com/web/madmin/image_9bddad128d45821b7fd6abb9773d7c53.png\",\"tip\":\"Heroes that often charge towards their targets should be aware of Chang’e. The slow and stun effect of her 1st and 2nd skills will stop fast-moving enemies in their tracks.\"},{\"kind\":\"countered_by\",\"heroId\":\"3\",\"heroName\":\"Saber\",\"heroSlug\":\"saber\",\"icon\":\"https://akmweb.youngjoygame.com/web/madmin/image/35a5d68d1704e2c4c6323abd4859a622.jpg?w=100-100-4b3f67\",\"tip\":\"Since Chang’e does not skills that allow her to blink or boost her movement speed, she is particularly vulnerable to assassin type heroes that kill in an instant.\"}],\"skills\":{\"skills\":[{\"name\":\"Trouble Maker\",\"type\":\"Passive\",\"description\":\"Each time Chang'e deals damage to an enemy, she leaves a mark on them that reduces their Movement Speed by 1% (up to 20%).\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Each time Chang'e deals damage to an enemy, she leaves a mark on them that reduces their Movement Speed by 1% (up to 20%).\"}],\"cooldown\":null,\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_4d7332d176c72445d8cc3ee0317dacde.png\",\"tags\":[\"Debuff\"]},{\"name\":\"Starmoon Shockwave\",\"type\":\"Skill 1\",\"description\":\"Chang'e sends an energy sphere in the target direction, dealing 350 (+130% Total Magic Power) Magic Damage to enemies in its path and slowing them by 10% for 1.5s.\\n\\nCrescent Moon: The Crescent Moon sends 4 extra energy spheres along with Chang'e's, each dealing 20% damage and slowing enemies hit. The slow effect can stack (up to 20%).\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Chang'e sends an energy sphere in the target direction, dealing 350\"},{\"type\":\"text\",\"text\":\" (+130% Total Magic Power)\",\"color\":\"#62f8fe\"},{\"type\":\"text\",\"text\":\" Magic Damage to enemies in its path and slowing them by 10% for 1.5s.\\n\\n\"},{\"type\":\"text\",\"text\":\"Crescent Moon\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\": The \"},{\"type\":\"text\",\"text\":\"Crescent Moon\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" sends 4 extra energy spheres along with Chang'e's, each dealing 20% damage and slowing enemies hit. The slow effect can stack (up to 20%).\"}],\"cooldown\":\"7s\",\"manaCost\":\"60\",\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_a02d601ba3fe650adef7922262df55c4.png\",\"tags\":[\"AOE\",\"Slow\"]},{\"name\":\"Crescent Moon\",\"type\":\"Skill 2\",\"description\":\"Chang'e summons the Crescent Moon, gaining a permanent 300 (+150% Total Magic Power) shield and 10% Movement Speed until the shield is broken. Each time she casts a skill, she gains an extra 50% Movement Speed that decays over 2.5s.\\nCrescent Moon: Enhances her Basic Attacks to deal 20 (+35% Total Magic Power) extra Magic Damage 2 times.\\n\\nEach time Chang'e deals Magic Damage with her Basic Attacks or skills, this skill's cooldown is reduced by 0.2s.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Chang'e summons the \"},{\"type\":\"text\",\"text\":\"Crescent Moon\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\", gaining a permanent 300\"},{\"type\":\"text\",\"text\":\" (+150% Total Magic Power)\",\"color\":\"#62f8fe\"},{\"type\":\"text\",\"text\":\" shield and 10% Movement Speed until the shield is broken. Each time she casts a skill, she gains an extra 50% Movement Speed that decays over 2.5s.\\n\"},{\"type\":\"text\",\"text\":\"Crescent Moon\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\": Enhances her Basic Attacks to deal 20\"},{\"type\":\"text\",\"text\":\" (+35% Total Magic Power)\",\"color\":\"#62f8fe\"},{\"type\":\"text\",\"text\":\" extra Magic Damage 2 times.\\n\\nEach time Chang'e deals Magic Damage with her Basic Attacks or skills, this skill's cooldown is reduced by 0.2s.\"}],\"cooldown\":\"12s\",\"manaCost\":\"60\",\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_7cccc4df5ed4adc5cedaaf446aab3a6a.png\",\"tags\":[\"Buff\",\"Shield\"]},{\"name\":\"Meteor Shower\",\"type\":\"Ultimate\",\"description\":\"Chang'e gains 10% Movement Speed for 4s. During this time, she fires 30 meteors in the target direction, each dealing 60 (+21% Total Magic Power) Magic Damage to the first enemy hit. This skill deals 100% extra damage to minions and creeps.\\n\\nCrescent Moon: Fires meteors alongside Chang'e, each dealing 33% damage.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Chang'e gains 10% Movement Speed for 4s. During this time, she fires 30 meteors in the target direction, each dealing 60\"},{\"type\":\"text\",\"text\":\" (+21% Total Magic Power)\",\"color\":\"#62f8fe\"},{\"type\":\"text\",\"text\":\" Magic Damage to the first enemy hit. This skill deals 100% extra damage to minions and creeps.\\n\\n\"},{\"type\":\"text\",\"text\":\"Crescent Moon\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\": Fires meteors alongside Chang'e, each dealing 33% damage.\"}],\"cooldown\":\"24s\",\"manaCost\":\"120\",\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_43c4ffb92aa2cf0242ed4fc0571c1a5d.png\",\"tags\":[\"Burst\"]}],\"skillUpgradePriority\":\"3-1-2-0-1/2\",\"skillPriorityTip\":\"The 2nd skill is primary DPS skill for Chang’e. When upgrading skills, first focus on the 2nd skill, followed by her ultimate. The first skill should be her lowest priority.\",\"skillPriorityTipRich\":[{\"type\":\"text\",\"text\":\"The 2nd skill is primary DPS skill for Chang’e. When upgrading skills, first focus on the 2nd skill, followed by her ultimate. The first skill should be her lowest priority.\"}]},\"synergies\":[{\"heroSlug\":\"gatotkaca\",\"heroName\":\"Gatotkaca\",\"synergyScore\":8,\"reason\":\"Chang'e works well with Tanks who can pull enemies together, like Gatotkaca and Tigreal, because Chang'e can follow them into teamfights to deal massive damage.\"},{\"heroSlug\":\"tigreal\",\"heroName\":\"Tigreal\",\"synergyScore\":8,\"reason\":\"Chang'e works well with Tanks who can pull enemies together, like Gatotkaca and Tigreal, because Chang'e can follow them into teamfights to deal massive damage.\"}],\"combos\":[{\"type\":\"teamfight\",\"title\":\"TEAMFIGHT COMBOS\",\"description\":\"In teamfights, get the shield from Chang'e's 2nd Skill, then use her 1st Skill to poke enemies, and follow up with her Ultimate if the 1st Skill was on target. Chang'e needs to move around during her Ultimate to keep herself safe and make sure the meteors can hit the target.\",\"skillSequence\":[{\"skillId\":6120,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_7cccc4df5ed4adc5cedaaf446aab3a6a.png\"},{\"skillId\":6110,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_a02d601ba3fe650adef7922262df55c4.png\"},{\"skillId\":6130,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_43c4ffb92aa2cf0242ed4fc0571c1a5d.png\"}]},{\"type\":\"laning\",\"title\":\"LANING COMBOS\",\"description\":\"In the laning phase, get the buff from Chang'e's 2nd Skill first, then mark the enemy with her Basic Attacks. Cast her 1st Skill to slow down low HP enemy, and finish them off with her Ultimate.\",\"skillSequence\":[{\"skillId\":6120,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_7cccc4df5ed4adc5cedaaf446aab3a6a.png\"},{\"skillId\":6100,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_f98d2e98eaebfb31c6c5101cf1c3201a.png\"},{\"skillId\":6110,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_a02d601ba3fe650adef7922262df55c4.png\"},{\"skillId\":6130,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_43c4ffb92aa2cf0242ed4fc0571c1a5d.png\"}]}],\"metaDescription\":\"Chang'e build, counter, and strategy guide: Genius Wand shred, slow stacks that pin ult targets, positioning, and the mana rules that decide her lane.\",\"builds\":[],\"overviewLede\":\"Chang'e is a siege mage who converts mana into map pressure. Her rabbit companion grants a permanent shield, enhanced basics that chew through towers, and a Meteor Shower ultimate that turns jungle corridors into no-go zones. She is not a burst mage: she is sustained-fire artillery that forces the enemy to choose between defending a split push and contesting an objective.\"},\"serverLocale\":\"en\",\"curatedBuilds\":{\"source\":\"curated\",\"hero\":\"change\",\"patch\":\"2.1.67\",\"lastReviewed\":\"2026-05-12\",\"stalePatch\":true,\"currentPatch\":\"2.2.16a\",\"builds\":[{\"slot\":1,\"id\":\"mid-siege-default\",\"name\":\"Mid Siege Default\",\"roleContext\":\"Mid\",\"items\":[{\"slug\":\"magic-boots\",\"name\":\"Magic Boots\",\"cost\":710,\"fixed\":false},{\"slug\":\"genius-wand\",\"name\":\"Genius Wand\",\"cost\":2000,\"fixed\":false},{\"slug\":\"holy-crystal\",\"name\":\"Holy Crystal\",\"cost\":3000,\"fixed\":false},{\"slug\":\"blood-wings\",\"name\":\"Blood Wings\",\"cost\":2100,\"fixed\":false},{\"slug\":\"divine-glaive\",\"name\":\"Divine Glaive\",\"cost\":1970,\"fixed\":false},{\"slug\":\"enchanted-talisman\",\"name\":\"Enchanted Talisman\",\"cost\":2070,\"fixed\":false}],\"coreItems\":[{\"slug\":\"genius-wand\",\"name\":\"Genius Wand\"},{\"slug\":\"holy-crystal\",\"name\":\"Holy Crystal\"},{\"slug\":\"divine-glaive\",\"name\":\"Divine Glaive\"}],\"emblem\":{\"slug\":\"mage\",\"name\":\"Mage Emblem\",\"talents\":[{\"slug\":\"swift\",\"name\":\"Swift\",\"iconUrl\":\"/images/talents/swift.png\",\"bucket\":\"standard\"},{\"slug\":\"wilderness-blessing\",\"name\":\"Wilderness Blessing\",\"iconUrl\":\"/images/talents/wilderness-blessing.png\",\"bucket\":\"standard\"},{\"slug\":\"impure-rage\",\"name\":\"Impure Rage\",\"iconUrl\":\"/images/talents/impure-rage.png\",\"bucket\":\"core\"}]},\"spell\":{\"slug\":\"flicker\",\"name\":\"Flicker\"},\"blessing\":null,\"flexItems\":[{\"item\":{\"slug\":\"arcane-boots\",\"name\":\"Arcane Boots\"},\"replace\":{\"slug\":\"magic-boots\",\"name\":\"Magic Boots\"},\"trigger\":\"Use when the enemy mid and roamer cannot punish you early and flat Magic Penetration matters more than cooldown tempo.\"},{\"item\":{\"slug\":\"glowing-wand\",\"name\":\"Glowing Wand\"},\"replace\":{\"slug\":\"enchanted-talisman\",\"name\":\"Enchanted Talisman\"},\"trigger\":\"Use when the enemy relies on healing, shields, or HP-stacking frontliners and your mana discipline is stable.\"},{\"item\":{\"slug\":\"winter-crown\",\"name\":\"Winter Crown\"},\"replace\":{\"slug\":\"enchanted-talisman\",\"name\":\"Enchanted Talisman\"},\"trigger\":\"Use when one dive combo can break Crescent Moon and kill you before Meteor Shower finishes.\"},{\"item\":{\"slug\":\"ice-queen-wand\",\"name\":\"Ice Queen Wand\"},\"replace\":{\"slug\":\"blood-wings\",\"name\":\"Blood Wings\"},\"trigger\":\"Use when your team needs repeated slows to keep fighters inside Meteor Shower rather than extra shield value.\"}],\"notes\":\"Default mid build for ranked games where Chang'e wants early Genius Wand shred, Holy Crystal damage, and enough late mana to keep sieging.\",\"totalCost\":11850,\"statLines\":[{\"key\":\"magicpower\",\"labelKey\":\"common.stats.magicPower\",\"unit\":\"flat\",\"group\":\"offensive\",\"value\":465,\"sources\":[\"Genius Wand\",\"Holy Crystal\",\"Blood Wings\",\"Divine Glaive\",\"Enchanted Talisman\"]},{\"key\":\"magicpen\",\"labelKey\":\"common.stats.magicPenetration\",\"unit\":\"percent\",\"group\":\"offensive\",\"value\":40,\"sources\":[\"Divine Glaive\"]},{\"key\":\"magicpenFlat\",\"labelKey\":\"common.stats.magicPenetration\",\"unit\":\"flat\",\"group\":\"offensive\",\"value\":10,\"sources\":[\"Genius Wand\"]},{\"key\":\"hp\",\"labelKey\":\"common.stats.hp\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":300,\"sources\":[\"Enchanted Talisman\"]},{\"key\":\"movespeed\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"flat\",\"group\":\"utility\",\"value\":40,\"sources\":[\"Magic Boots\"]},{\"key\":\"movespeedPct\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"percent\",\"group\":\"utility\",\"value\":5,\"sources\":[\"Genius Wand\"]},{\"key\":\"cdreduction\",\"labelKey\":\"common.stats.cooldownReduction\",\"unit\":\"percent\",\"grou