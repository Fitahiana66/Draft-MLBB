\"Dominance Ice\"},{\"@type\":\"HowToSupply\",\"name\":\"Blade Armor\"},{\"@type\":\"HowToSupply\",\"name\":\"Antique Cuirass\"},{\"@type\":\"HowToSupply\",\"name\":\"Athena's Shield\"},{\"@type\":\"HowToSupply\",\"name\":\"Immortality\"}],\"tool\":[{\"@type\":\"HowToTool\",\"name\":\"Tank Emblem\"},{\"@type\":\"HowToTool\",\"name\":\"Flicker Battle Spell\"}],\"step\":[{\"@type\":\"HowToStep\",\"position\":1,\"name\":\"Buy Warrior Boots\",\"text\":\"Purchase Warrior Boots (720 gold) as item 1 in the Roam Anti-Physical Peel build for Tigreal.\",\"url\":\"https://mlbbhub.com/heroes/tigreal#build-roam-anti-physical-peel\"},{\"@type\":\"HowToStep\",\"position\":2,\"name\":\"Buy Dominance Ice\",\"text\":\"Purchase Dominance Ice (2,010 gold) as item 2 in the Roam Anti-Physical Peel build for Tigreal.\",\"url\":\"https://mlbbhub.com/heroes/tigreal#build-roam-anti-physical-peel\"},{\"@type\":\"HowToStep\",\"position\":3,\"name\":\"Buy Blade Armor\",\"text\":\"Purchase Blade Armor (1,910 gold) as item 3 in the Roam Anti-Physical Peel build for Tigreal.\",\"url\":\"https://mlbbhub.com/heroes/tigreal#build-roam-anti-physical-peel\"},{\"@type\":\"HowToStep\",\"position\":4,\"name\":\"Buy Antique Cuirass\",\"text\":\"Purchase Antique Cuirass (2,170 gold) as item 4 in the Roam Anti-Physical Peel build for Tigreal.\",\"url\":\"https://mlbbhub.com/heroes/tigreal#build-roam-anti-physical-peel\"},{\"@type\":\"HowToStep\",\"position\":5,\"name\":\"Buy Athena's Shield\",\"text\":\"Purchase Athena's Shield (2,150 gold) as item 5 in the Roam Anti-Physical Peel build for Tigreal.\",\"url\":\"https://mlbbhub.com/heroes/tigreal#build-roam-anti-physical-peel\"},{\"@type\":\"HowToStep\",\"position\":6,\"name\":\"Buy Immortality\",\"text\":\"Purchase Immortality (2,120 gold) as item 6 in the Roam Anti-Physical Peel build for Tigreal.\",\"url\":\"https://mlbbhub.com/heroes/tigreal#build-roam-anti-physical-peel\"}],\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://mlbbhub.com/heroes/tigreal\"},\"datePublished\":\"2026-04-20T00:00:00.000Z\",\"dateModified\":\"2026-05-13T00:00:00.000Z\",\"author\":{\"@type\":\"Organization\",\"name\":\"MLBBHub\",\"url\":\"https://mlbbhub.com\"}}5f:[\"$\",\"script\",\"2\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$64\"}}]\n60:[\"$\",\"$L65\",null,{\"hero\":{\"id\":6,\"name\":\"Tigreal\",\"slug\":\"tigreal\",\"title\":\"Warrior of Dawn\",\"role\":[\"Tank\"],\"specialty\":[\"Crowd Control\"],\"lane\":[\"Roam\"],\"tier\":\"D\",\"difficulty\":1,\"releaseYear\":2016,\"stats\":{\"durability\":80,\"offense\":10,\"controlEffect\":100,\"difficulty\":10},\"winRate\":44.79,\"pickRate\":2.01,\"banRate\":6,\"counters\":{\"strongAgainst\":[{\"heroSlug\":\"zilong\",\"heroName\":\"Zilong\",\"advantage\":\"strong\",\"tip\":\"Tigreal's Passive can negate enemy Basic Attacks, making him strong against heroes that deal damage with their Basic Attacks, such as Zilong and Freya.\"},{\"heroSlug\":\"freya\",\"heroName\":\"Freya\",\"advantage\":\"strong\",\"tip\":\"Tigreal's Passive can negate enemy Basic Attacks, making him strong against heroes that deal damage with their Basic Attacks, such as Zilong and Freya.\"}],\"weakAgainst\":[{\"heroSlug\":\"change\",\"heroName\":\"Chang'e\",\"advantage\":\"weak\",\"tip\":\"But as a melee hero, Tigreal is countered by Ranged Mage heroes like Chang'e and Zhask.\"},{\"heroSlug\":\"zhask\",\"heroName\":\"Zhask\",\"advantage\":\"weak\",\"tip\":\"But as a melee hero, Tigreal is countered by Ranged Mage heroes like Chang'e and Zhask.\"}]},\"splashArt\":\"https://akmweb.youngjoygame.com/web/svnres/file/mlbb/homepage/100_ec2ad5967a2d8a0ac5e2cef2a1e24411.jpg\",\"portrait\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_8b30576754be1a4f8bebd09df8d6bec7.png\",\"officialMatchups\":[{\"kind\":\"best_ally\",\"heroId\":\"23\",\"heroName\":\"Gord\",\"heroSlug\":\"gord\",\"icon\":\"https://akmwebstatic.yuanzhanapp.com/web/madmin/image_24b9fa9519483b3d2168261b0fb6c0cf.png\",\"tip\":\"Tigreal put all the enemies together with his skill combination and gord with his stun and ultimate kills them all while Tigreal has all of them stunned. The most of the times my friend gets Triple Kill/Maniac and even once he reached Savage by doing this combo. A nice team.\"},{\"kind\":\"counters\",\"heroId\":\"1\",\"heroName\":\"Miya\",\"heroSlug\":\"miya\",\"icon\":\"https://indoch.s3.ml.moonlian.com/web/madmin/image_a844f9aa51baefa6878801edd85fec5e.png\",\"tip\":\"The only mobility Miya has is her Ultimate, and it has a big cooldown, making Tigreal able to reach her while escaping by using Flicker and 2nd ability, and even only his 2nd would be enough.\"},{\"kind\":\"countered_by\",\"heroId\":\"15\",\"heroName\":\"Eudora\",\"heroSlug\":\"eudora\",\"icon\":\"https://akmwebstatic.yuanzhanapp.com/web/madmin/image_ed32e3c71ecd41652fc54a7efd02aba4.jpg\",\"tip\":\"It is obvious why she is here, she has a stun that lasts enough to let the enemy team lower your hp faster if you don't take care, Tigreal is pretty hard, but not inmortal like Argus with his Ulti. Keep an eye on it.\"}],\"skills\":{\"skills\":[{\"name\":\"Fearless\",\"type\":\"Passive\",\"description\":\"Tigreal gains 1 stack of Fearless each time he is hit by a Basic Attack. At 4 stacks, he consumes them to block the next incoming Basic Attack (including attacks from Turrets).\\nHe also gains 1 stack of Fearless each time he casts a skill.\\n\\nDamage from minions does not add or consume Fearless stacks.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Tigreal gains 1 stack of \"},{\"type\":\"text\",\"text\":\"Fearless\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" each time he is hit by a Basic Attack. At 4 stacks, he consumes them to block the next incoming Basic Attack (including attacks from Turrets).\\nHe also gains 1 stack of \"},{\"type\":\"text\",\"text\":\"Fearless\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" each time he casts a skill.\\n\\nDamage from minions does not add or consume \"},{\"type\":\"text\",\"text\":\"Fearless\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" stacks.\"}],\"cooldown\":null,\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_5b028ce65e323d962d7060705f59743f.png\",\"tags\":[\"Buff\"]},{\"name\":\"Attack Wave\",\"type\":\"Skill 1\",\"description\":\"Tigreal smashes the ground with his hammer, sending a shockwave that erupts 3 times in a fan-shaped area. Each eruption deals 270 (+70% Total Physical Attack) Physical Damage to enemies hit and slows them by 20% / 40% / 60% for 1.5s.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Tigreal smashes the ground with his hammer, sending a shockwave that erupts 3 times in a fan-shaped area. Each eruption deals 270\"},{\"type\":\"text\",\"text\":\" (+70% Total Physical Attack)\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Physical Damage\",\"color\":\"#fb1f1f\"},{\"type\":\"text\",\"text\":\" to enemies hit and slows them by 20% / 40% / 60% for 1.5s.\"}],\"cooldown\":\"7s\",\"manaCost\":\"45\",\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_8e00063700ab16f53d840986b98aae25.png\",\"tags\":[\"AOE\",\"Slow\"]},{\"name\":\"Sacred Hammer\",\"type\":\"Skill 2\",\"description\":\"Tigreal charges in the target direction, dealing (+100% Total Physical Attack) Physical Damage to enemies along the way and pushing them to the end of the charge.\\n\\nUse Again: Tigreal can use this skill again within 4s, dealing 280 (+60% Total Physical Attack) Physical Damage to enemies in front of him and knocking them airborne for 0.6s.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Tigreal charges in the target direction, dealing \"},{\"type\":\"text\",\"text\":\" (+100% Total Physical Attack)\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Physical Damage\",\"color\":\"#fb1f1f\"},{\"type\":\"text\",\"text\":\" to enemies along the way and pushing them to the end of the charge.\\n\\n\"},{\"type\":\"text\",\"text\":\"Use Again\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\": Tigreal can use this skill again within 4s, dealing 280\"},{\"type\":\"text\",\"text\":\" (+60% Total Physical Attack)\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Physical Damage\",\"color\":\"#fb1f1f\"},{\"type\":\"text\",\"text\":\" to enemies in front of him and knocking them airborne for 0.6s.\"}],\"cooldown\":\"16s\",\"manaCost\":\"70\",\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_e9baf5e58ce0fb23c0fcb6176cc8ed5d.png\",\"tags\":[\"Charge\",\"CC\"]},{\"name\":\"Implosion\",\"type\":\"Ultimate\",\"description\":\"Tigreal unleashes the power of his hammer, pulling nearby enemies to him, dealing 600 (+130% Total Physical Attack) Physical Damage and stunning them for 1.8s.\\n\\nThe first half of the channeling can be interrupted by control effects, while the second half can only be interrupted by Suppression.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Tigreal unleashes the power of his hammer, pulling nearby enemies to him, dealing 600\"},{\"type\":\"text\",\"text\":\" (+130% Total Physical Attack)\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Physical Damage\",\"color\":\"#fb1f1f\"},{\"type\":\"text\",\"text\":\" and stunning them for 1.8s.\\n\\nThe first half of the channeling can be interrupted by control effects, while the second half can only be interrupted by \"},{\"type\":\"text\",\"text\":\"Suppression\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\".\"}],\"cooldown\":\"55s\",\"manaCost\":\"120\",\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_46e5c2b6f8fd6fda995a63d5c10f19e5.png\",\"tags\":[\"CC\",\"AOE\"]}],\"skillUpgradePriority\":\"3-1-2\",\"skillPriorityTip\":\"You should max his 2nd ability to reduce its cooldown and mana consume, it is important to max that ability due to the movility it provides you when you are far from a battle and want to go and helpm, also because it is the most useful Tigreal skill after his Ultimate. Anyway, you should start picking the first ability for a faster cleaning of your line in early game and to spam it to your oponents. (Max Ultimate whenever is possible)\\nFlicker - It is obligatory to always pick Flicker, and the reason is really simple; it is the best spell that you can use to combine Tigreal skills as mentioned above.\",\"skillPriorityTipRich\":[{\"type\":\"text\",\"text\":\"You should max his 2nd ability to reduce its cooldown and mana consume, it is important to max that ability due to the movility it provides you when you are far from a battle and want to go and helpm, also because it is the most useful Tigreal skill after his Ultimate. Anyway, you should start picking the first ability for a faster cleaning of your line in early game and to spam it to your oponents. (Max Ultimate whenever is possible)\"},{\"type\":\"lineBreak\"},{\"type\":\"text\",\"text\":\"Flicker - It is obligatory to always pick Flicker, and the reason is really simple; it is the best spell that you can use to combine Tigreal skills as mentioned above.\"}]},\"synergies\":[{\"heroSlug\":\"vexana\",\"heroName\":\"Vexana\",\"synergyScore\":8,\"reason\":\"Tigreal works well with heroes with strong initiation skills, that gives him a better chance to hit the enemies with his CC skills, such as Vexana and Odette.\"},{\"heroSlug\":\"odette\",\"heroName\":\"Odette\",\"synergyScore\":8,\"reason\":\"Tigreal works well with heroes with strong initiation skills, that gives him a better chance to hit the enemies with his CC skills, such as Vexana and Odette.\"}],\"combos\":[{\"type\":\"teamfight\",\"title\":\"TEAMFIGHT COMBOS\",\"description\":\"In teamfights, Tigreal should cast his 2nd Skill to charge in and then pull the enemy team towards him with his Ultimate. At the end of his CC, cast his 2nd Skill again to extend it, then use his 1st Skill to deal damage.\",\"skillSequence\":[{\"skillId\":620,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_e9baf5e58ce0fb23c0fcb6176cc8ed5d.png\"},{\"skillId\":630,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_46e5c2b6f8fd6fda995a63d5c10f19e5.png\"},{\"skillId\":620,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_e9baf5e58ce0fb23c0fcb6176cc8ed5d.png\"},{\"skillId\":610,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_8e00063700ab16f53d840986b98aae25.png\"}]},{\"type\":\"laning\",\"title\":\"LANING COMBOS\",\"description\":\"In the laning phase, Tigreal can use his 2nd Skill to charge the enemy target and knock them airborne by casting it again. He then finishes with his 1st Skill to deal damage.\",\"skillSequence\":[{\"skillId\":620,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_e9baf5e58ce0fb23c0fcb6176cc8ed5d.png\"},{\"skillId\":620,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_e9baf5e58ce0fb23c0fcb6176cc8ed5d.png\"},{\"skillId\":610,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_8e00063700ab16f53d840986b98aae25.png\"}]}],\"metaDescription\":\"Tigreal build, counter, and strategy guide for Mobile Legends. Conceal or Encourage, Flicker timings, item flex, and the drafts that make him worth picking.\",\"builds\":[],\"overviewLede\":\"Tigreal is not a tank you blind-pick because you want a front line. He is a bush-controlled initiation test: if the enemy draft cannot reliably cancel or cleanse his engage, one clean combo decides the fight. If they can, he turns into a predictable wall with a long cooldown problem.\"},\"serverLocale\":\"en\",\"curatedBuilds\":{\"source\":\"curated\",\"hero\":\"tigreal\",\"patch\":\"2.1.67\",\"lastReviewed\":\"2026-05-13\",\"stalePatch\":true,\"currentPatch\":\"2.2.16a\",\"builds\":[{\"slot\":1,\"id\":\"roam-conceal-flicker-pickoff\",\"name\":\"Roam Conceal Flicker Pickoff\",\"roleContext\":\"Roam\",\"items\":[{\"slug\":\"rapid-boots\",\"name\":\"Rapid Boots\",\"cost\":750,\"fixed\":false},{\"slug\":\"dominance-ice\",\"name\":\"Dominance Ice\",\"cost\":2010,\"fixed\":false},{\"slug\":\"fleeting-time\",\"name\":\"Fleeting Time\",\"cost\":2050,\"fixed\":false},{\"slug\":\"athenas-shield\",\"name\":\"Athena's Shield\",\"cost\":2150,\"fixed\":false},{\"slug\":\"antique-cuirass\",\"name\":\"Antique Cuirass\",\"cost\":2170,\"fixed\":false},{\"slug\":\"immortality\",\"name\":\"Immortality\",\"cost\":2120,\"fixed\":false}],\"coreItems\":[{\"slug\":\"dominance-ice\",\"name\":\"Dominance Ice\"},{\"slug\":\"fleeting-time\",\"name\":\"Fleeting Time\"},{\"slug\":\"athenas-shield\",\"name\":\"Athena's Shield\"}],\"emblem\":{\"slug\":\"support\",\"name\":\"Support Emblem\",\"talents\":[{\"slug\":\"agility\",\"name\":\"Agility\",\"iconUrl\":\"/images/talents/agility.png\",\"bucket\":\"standard\"},{\"slug\":\"pull-yourself-together\",\"name\":\"Pull Yourself Together\",\"iconUrl\":\"/images/talents/pull-yourself-together.png\",\"bucket\":\"standard\"},{\"slug\":\"focusing-mark\",\"name\":\"Focusing Mark\",\"iconUrl\":\"/images/talents/focusing-mark.png\",\"bucket\":\"core\"}]},\"spell\":{\"slug\":\"flicker\",\"name\":\"Flicker\"},\"blessing\":{\"slug\":\"conceal\",\"name\":\"Conceal\"},\"flexItems\":[{\"item\":{\"slug\":\"tough-boots\",\"name\":\"Tough Boots\"},\"replace\":{\"slug\":\"rapid-boots\",\"name\":\"Rapid Boots\"},\"trigger\":\"Use when layered crowd control can stop Tigreal before Sacred Hammer or Implosion completes.\"},{\"item\":{\"slug\":\"radiant-armor\",\"name\":\"Radiant Armor\"},\"replace\":{\"slug\":\"athenas-shield\",\