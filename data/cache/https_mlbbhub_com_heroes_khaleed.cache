osition\":2,\"name\":\"Buy War Axe\",\"text\":\"Purchase War Axe (2,100 gold) as item 2 in the EXP Sustain Bruiser build for Khaleed.\",\"url\":\"https://mlbbhub.com/heroes/khaleed#build-exp-sustain-bruiser\"},{\"@type\":\"HowToStep\",\"position\":3,\"name\":\"Buy Thunder Belt\",\"text\":\"Purchase Thunder Belt (1,820 gold) as item 3 in the EXP Sustain Bruiser build for Khaleed.\",\"url\":\"https://mlbbhub.com/heroes/khaleed#build-exp-sustain-bruiser\"},{\"@type\":\"HowToStep\",\"position\":4,\"name\":\"Buy Oracle\",\"text\":\"Purchase Oracle (1,860 gold) as item 4 in the EXP Sustain Bruiser build for Khaleed.\",\"url\":\"https://mlbbhub.com/heroes/khaleed#build-exp-sustain-bruiser\"},{\"@type\":\"HowToStep\",\"position\":5,\"name\":\"Buy Queen's Wings\",\"text\":\"Purchase Queen's Wings (2,250 gold) as item 5 in the EXP Sustain Bruiser build for Khaleed.\",\"url\":\"https://mlbbhub.com/heroes/khaleed#build-exp-sustain-bruiser\"},{\"@type\":\"HowToStep\",\"position\":6,\"name\":\"Buy Immortality\",\"text\":\"Purchase Immortality (2,120 gold) as item 6 in the EXP Sustain Bruiser build for Khaleed.\",\"url\":\"https://mlbbhub.com/heroes/khaleed#build-exp-sustain-bruiser\"}],\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://mlbbhub.com/heroes/khaleed\"},\"datePublished\":\"2026-04-18T00:00:00.000Z\",\"dateModified\":\"2026-05-13T00:00:00.000Z\",\"author\":{\"@type\":\"Organization\",\"name\":\"MLBBHub\",\"url\":\"https://mlbbhub.com\"}}5f:[\"$\",\"script\",\"2\",{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$64\"}}]\n60:[\"$\",\"$L65\",null,{\"hero\":{\"id\":98,\"name\":\"Khaleed\",\"slug\":\"khaleed\",\"title\":\"Desert Scimitar\",\"role\":[\"Fighter\"],\"specialty\":[\"Damage\",\"Regen\"],\"lane\":[\"Roam\",\"EXP\"],\"tier\":\"B\",\"difficulty\":2,\"releaseYear\":2020,\"stats\":{\"durability\":80,\"offense\":50,\"controlEffect\":50,\"difficulty\":50},\"winRate\":50.79,\"pickRate\":0.12,\"banRate\":0.08,\"counters\":{\"strongAgainst\":[{\"heroSlug\":\"cyclops\",\"heroName\":\"Cyclops\",\"advantage\":\"strong\",\"tip\":\"Khaleed counters heroes who lack mobility like Cyclops and Xavier since they will have difficult time avoiding his combo.\"},{\"heroSlug\":\"xavier\",\"heroName\":\"Xavier\",\"advantage\":\"strong\",\"tip\":\"Khaleed counters heroes who lack mobility like Cyclops and Xavier since they will have difficult time avoiding his combo.\"}],\"weakAgainst\":[{\"heroSlug\":\"x-borg\",\"heroName\":\"X.Borg\",\"advantage\":\"weak\",\"tip\":\"Khaleed is countered by heroes who have the ability to knock him back or airborne to interrupt his 2nd Skill, such as X.Borg and Chou.\"},{\"heroSlug\":\"chou\",\"heroName\":\"Chou\",\"advantage\":\"weak\",\"tip\":\"Khaleed is countered by heroes who have the ability to knock him back or airborne to interrupt his 2nd Skill, such as X.Borg and Chou.\"}]},\"splashArt\":\"https://akmweb.youngjoygame.com/web/svnres/file/mlbb/homepage/100_155712d0d854711a12f2754865acc17b.jpg\",\"portrait\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_540a6a9d343842674ce002082366ec9d.png\",\"officialMatchups\":[{\"kind\":\"best_ally\",\"heroId\":\"93\",\"heroName\":\"Atlas\",\"heroSlug\":\"atlas\",\"icon\":\"https://akmwebstatic.yuanzhanapp.com/web/madmin/image_a2f68d5c30c0198006b2c85b7a5cb48b.png\",\"tip\":\"Atlas,Angela,Vale\"},{\"kind\":\"counters\",\"heroId\":\"27\",\"heroName\":\"Sun\",\"heroSlug\":\"sun\",\"icon\":\"https://akmwebstatic.yuanzhanapp.com/web/madmin/image_802a9c5f922e63054fcf11aa7d012482.png\",\"tip\":\"Sun,Dyrroth,Karrie\"},{\"kind\":\"countered_by\",\"heroId\":\"9\",\"heroName\":\"Akai\",\"heroSlug\":\"akai\",\"icon\":\"https://akmweb.youngjoygame.com/web/madmin/image/25141fb8aa27cfbe9f030449721b11af.png?w=150-150-4f3225\",\"tip\":\"Akai,Chou,Yi Sun-shin\"}],\"skills\":{\"skills\":[{\"name\":\"Sand Walk\",\"type\":\"Passive\",\"description\":\"Khaleed accumulates Desert Power while moving. After Desert Power is fully charged, he will glide on sand, increasing Movement Speed by 35%, making his next Basic Attack deal 50 (+140% Total Physical Attack) Physical Damage to the target (cannot Crit), and reducing the target's Movement Speed by 40% for 1.5s.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Khaleed accumulates \"},{\"type\":\"text\",\"text\":\"Desert Power\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" while moving. After \"},{\"type\":\"text\",\"text\":\"Desert Power\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" is fully charged, he will glide on sand, increasing Movement Speed by 35%, making his next Basic Attack deal 50\"},{\"type\":\"text\",\"text\":\" (+140% Total Physical Attack)\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Physical Damage\",\"color\":\"#fb1f1f\"},{\"type\":\"text\",\"text\":\" to the target (cannot Crit), and reducing the target's Movement Speed by 40% for 1.5s.\"}],\"cooldown\":null,\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_de65492aeccc8a5738aa42de8a33141e.png\",\"tags\":[\"Speed Up\",\"Damage\"]},{\"name\":\"Desert Tornado\",\"type\":\"Skill 1\",\"description\":\"Khaleed whirls his scimitar, dealing 175 (+130% Total Physical Attack) Physical Damage to enemies in the area and pulling them toward him. This skill can be used up to 3 time(s) in a row.\\n\\nThis skill deals 60% damage to Minions and Creeps.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Khaleed whirls his scimitar, dealing 175\"},{\"type\":\"text\",\"text\":\" (+130% Total Physical Attack)\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Physical Damage\",\"color\":\"#fb1f1f\"},{\"type\":\"text\",\"text\":\" to enemies in the area and pulling them toward him. This skill can be used up to 3 time(s) in a row.\\n\\nThis skill deals 60% damage to Minions and Creeps.\"}],\"cooldown\":\"6.5s\",\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_4d923b809f919ef60ae354ec162cc853.png\",\"tags\":[\"AOE\"]},{\"name\":\"Quicksand Guard\",\"type\":\"Skill 2\",\"description\":\"Khaleed protects himself with quicksand, restoring HP equal to 60 + 5% of his lost HP and 10 Desert Power every 0.5s. He also gains 25% Damage Reduction for up to 4s.\\n\\nWhile channeling, quicksand appears beneath him, slowing the enemy by 60%.\\nThis is a Focused Cast. Other control effects will interrupt this skill.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Khaleed protects himself with quicksand, restoring HP equal to 60 + 5% of his lost HP and 10 \"},{\"type\":\"text\",\"text\":\"Desert Power\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" every 0.5s. He also gains 25% Damage Reduction for up to 4s.\\n\\nWhile channeling, quicksand appears beneath him, slowing the enemy by 60%.\\nThis is a \"},{\"type\":\"text\",\"text\":\"Focused Cast\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\". Other control effects will interrupt this skill.\"}],\"cooldown\":\"18s\",\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_d70b9b7d9c0de2d528e8f86bcebe9093.png\",\"tags\":[\"Reduce DMG\",\"Heal\"]},{\"name\":\"Raging Sandstorm\",\"type\":\"Ultimate\",\"description\":\"Khaleed rides the sandstorm and charges toward a designated location, dealing 100 (+50% Total Physical Attack) Physical Damage to enemies along the way and knocking them toward his destination. Khaleed is immune to control effects during this process.\\n\\nUpon reaching the destination, Khaleed will smash the ground, dealing 450 (+160% Total Physical Attack) Physical Damage to enemies in the area and stunning them for 1s, and fully charge his Desert Power.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Khaleed rides the sandstorm and charges toward a designated location, dealing 100\"},{\"type\":\"text\",\"text\":\" (+50% Total Physical Attack)\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Physical Damage\",\"color\":\"#fb1f1f\"},{\"type\":\"text\",\"text\":\" to enemies along the way and knocking them toward his destination. Khaleed is immune to control effects during this process.\\n\\nUpon reaching the destination, Khaleed will smash the ground, dealing 450\"},{\"type\":\"text\",\"text\":\" (+160% Total Physical Attack)\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Physical Damage\",\"color\":\"#fb1f1f\"},{\"type\":\"text\",\"text\":\" to enemies in the area and stunning them for 1s, and fully charge his \"},{\"type\":\"text\",\"text\":\"Desert Power\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\".\"}],\"cooldown\":\"46s\",\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_af48a3f5f3aaf4ea2f41f018fc51e92a.png\",\"tags\":[\"CC\",\"Mobility\"]}],\"skillUpgradePriority\":\"3-1-2\"},\"synergies\":[{\"heroSlug\":\"roger\",\"heroName\":\"Roger\",\"synergyScore\":8,\"reason\":\"Because Khaleed can deal a lot of AOE damage, he works well with heroes like Roger and Karina who excel at finishing off multiple low HP targets.\"},{\"heroSlug\":\"karina\",\"heroName\":\"Karina\",\"synergyScore\":8,\"reason\":\"Because Khaleed can deal a lot of AOE damage, he works well with heroes like Roger and Karina who excel at finishing off multiple low HP targets.\"}],\"combos\":[{\"type\":\"laning\",\"title\":\"LANING COMBOS\",\"description\":\"In the laning phase, move around to fill up Khaleed's Desert Power first, then hit the opponent with the enhanced Basic Attack to slow them and follow up with 3 hits from his 1st Skill. This should fill up his Desert Power again, allowing for another enhanced Basic Attack.\",\"skillSequence\":[{\"skillId\":9800,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_f98d2e98eaebfb31c6c5101cf1c3201a.png\"},{\"skillId\":9810,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_4d923b809f919ef60ae354ec162cc853.png\"},{\"skillId\":9800,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_f98d2e98eaebfb31c6c5101cf1c3201a.png\"}]},{\"type\":\"teamfight\",\"title\":\"TEAMFIGHT COMBOS\",\"description\":\"In teamfights, use Khaleed's Ultimate to initiate, then hit a target with his enhanced Basic Attack and continue the attack with his 1st Skill. Once Desert Power is full again, use another Basic Attack. Then use Khaleed's 2nd Skill to recover HP and reduce incoming damage.\",\"skillSequence\":[{\"skillId\":9830,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_af48a3f5f3aaf4ea2f41f018fc51e92a.png\"},{\"skillId\":9800,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_f98d2e98eaebfb31c6c5101cf1c3201a.png\"},{\"skillId\":9810,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_4d923b809f919ef60ae354ec162cc853.png\"},{\"skillId\":9800,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_f98d2e98eaebfb31c6c5101cf1c3201a.png\"},{\"skillId\":9820,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_d70b9b7d9c0de2d528e8f86bcebe9093.png\"}]}],\"metaDescription\":\"Khaleed build, counter, and roam guide for Mobile Legends: Thunder Belt power spike, ult angle discipline, and when the roamer pick is a draft mistake.\",\"builds\":[],\"overviewLede\":\"Khaleed is sold in the hero pool as an EXP fighter, but the version that actually wins games in 2026 is a roamer carrying Thunder Belt. The Desert Power passive plus a Thunder Belt proc is the single cleanest true-damage tick a non-jungler can produce, and his ultimate is the longest CC-immune forced engage in the roam pool.\"},\"serverLocale\":\"en\",\"curatedBuilds\":{\"source\":\"curated\",\"hero\":\"khaleed\",\"patch\":\"2.1.67\",\"lastReviewed\":\"2026-05-13\",\"stalePatch\":true,\"currentPatch\":\"2.2.16a\",\"builds\":[{\"slot\":1,\"id\":\"roam-thunder-control\",\"name\":\"Roam Thunder Control\",\"roleContext\":\"Roam\",\"items\":[{\"slug\":\"tough-boots\",\"name\":\"Tough Boots\",\"cost\":700,\"fixed\":false},{\"slug\":\"thunder-belt\",\"name\":\"Thunder Belt\",\"cost\":1820,\"fixed\":false},{\"slug\":\"dominance-ice\",\"name\":\"Dominance Ice\",\"cost\":2010,\"fixed\":false},{\"slug\":\"oracle\",\"name\":\"Oracle\",\"cost\":1860,\"fixed\":false},{\"slug\":\"antique-cuirass\",\"name\":\"Antique Cuirass\",\"cost\":2170,\"fixed\":false},{\"slug\":\"immortality\",\"name\":\"Immortality\",\"cost\":2120,\"fixed\":false}],\"coreItems\":[{\"slug\":\"thunder-belt\",\"name\":\"Thunder Belt\"},{\"slug\":\"dominance-ice\",\"name\":\"Dominance Ice\"},{\"slug\":\"oracle\",\"name\":\"Oracle\"}],\"emblem\":{\"slug\":\"tank\",\"name\":\"Tank Emblem\",\"talents\":[{\"slug\":\"vitality\",\"name\":\"Vitality\",\"iconUrl\":\"/images/talents/vitality.png\",\"bucket\":\"standard\"},{\"slug\":\"tenacity\",\"name\":\"Tenacity\",\"iconUrl\":\"/images/talents/tenacity.png\",\"bucket\":\"standard\"},{\"slug\":\"concussive-blast\",\"name\":\"Concussive Blast\",\"iconUrl\":\"/images/talents/concussive-blast.png\",\"bucket\":\"core\"}]},\"spell\":{\"slug\":\"flicker\",\"name\":\"Flicker\"},\"blessing\":{\"slug\":\"conceal\",\"name\":\"Conceal\"},\"flexItems\":[{\"item\":{\"slug\":\"radiant-armor\",\"name\":\"Radiant Armor\"},\"replace\":{\"slug\":\"antique-cuirass\",\"name\":\"Antique Cuirass\"},\"trigger\":\"Use against repeated magic poke, burn, or DPS that keeps hitting Khaleed while Quicksand Guard is channeling.\"},{\"item\":{\"slug\":\"athenas-shield\",\"name\":\"Athena's Shield\"},\"replace\":{\"slug\":\"antique-cuirass\",\"name\":\"Antique Cuirass\"},\"trigger\":\"Use when one burst mage decides the fight before Khaleed can spend the S2 heal.\"},{\"item\":{\"slug\":\"rapid-boots\",\"name\":\"Rapid Boots\"},\"replace\":{\"slug\":\"tough-boots\",\"name\":\"Tough Boots\"},\"trigger\":\"Use when the enemy has low crowd control and Khaleed's main job is crossing river first for vision and Thunder Belt stacks.\"}],\"notes\":\"Default roam setup that turns Sand Walk into a Thunder Belt engage tool while keeping enough defense to survive after the first ult angle.\",\"totalCost\":10680,\"statLines\":[{\"key\":\"hp\",\"labelKey\":\"common.stats.hp\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":3370,\"sources\":[\"Thunder Belt\",\"Oracle\",\"Antique Cuirass\",\"Immortality\"]},{\"key\":\"hpregen\",\"labelKey\":\"common.stats.hpRegen\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":4,\"sources\":[\"Antique Cuirass\"]},{\"key\":\"physdefense\",\"labelKey\":\"common.stats.physicalDefense\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":130,\"sources\":[\"Thunder Belt\",\"Dominance Ice\",\"Oracle\",\"Antique Cuirass\",\"Immortality\"]},{\"key\":\"magicdefense\",\"labelKey\":\"common.stats.magicDefense\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":93,\"sources\":[\"Tough Boots\",\"Thunder Belt\",\"Dominance Ice\",\"Oracle\"]},{\"key\":\"movespeed\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"flat\",\"group\":\"utility\",\"value\":60,\"sources\":[\"Tough Boots\",\"Thunder Belt\"]},{\"key\":\"movespeedPct\",\"labelKey\":\"common.stats.movementSpeed\",\"unit\":\"percent\",\"group\":\"utility\",\"value\":5,\"sources\":[\"Dominance Ice\"]},{\"key\":\"cdreduction\",\"labelKey\":\"common.stats.cooldownReduction\",\"unit\":\"percent\",\"group\":\"utility\",\"value\":10,\"sources\":[\"Oracle\"]}],\"conflicts\":[],\"simulatorUrl\":\"/build-simulator?hero=khaleed\u0026items=tough-boots%2Cthunder-belt%2Cdominance-ice%2Coracle%2Cantique-cuirass%2Cimmortality\u0026blessing=conceal\u0026spell=flicker\u0026emblem=tank\u0026talents=v