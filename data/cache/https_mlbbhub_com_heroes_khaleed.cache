ext-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#B07ECC\",\"background\":\"#B07ECC1a\",\"border\":\"1px solid #B07ECC40\"},\"children\":\"Epic\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Khaleed\",\"rank\":\"Epic\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=epic\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Epic\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Epic\",\"name\":\"Khaleed\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"52.75\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Khaleed\",\"delta\":\"+1.92%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.07\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.10\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Epic\"}}]]}]]}],[\"$\",\"article\",\"legend\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #4dc9f6, #4dc9f633)\",\"boxShadow\":\"0 0 12px -2px #4dc9f680\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#4dc9f6\",\"background\":\"#4dc9f61a\",\"border\":\"1px solid #4dc9f640\"},\"children\":\"Legend\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Khaleed\",\"rank\":\"Legend\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=legend\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Legend\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Legend\",\"name\":\"Khaleed\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"52.51\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Khaleed\",\"delta\":\"+1.68%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.10\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.10\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Legend\"}}]]}]]}],[\"$\",\"article\",\"mythic\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[\"$L9f\",\"$La0\",\"$La1\"]}],\"$La2\",\"$La3\"]}]\n7e:[\"$\",\"h2\",\"h2-1\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The one thing that makes Khaleed work\"]}]\n7f:[\"$\",\"p\",\"p-4\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Khaleed is not a fighter. He is a mobile CC platform whose basic attacks true-damage-proc defense items.\"}]\n80:[\"$\",\"p\",\"p-5\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Sand Walk charges while he is moving, not while he is fighting, which is why he is a roamer and not a laner. A roamer walks more than a laner in the first ten minutes, and every step charges the next enhanced basic. That enhanced basic lands a heavy slow on the target, which is enough time to land all three casts of Desert Tornado on them and long enough for a Thunder Belt proc to add true damage in the same window. Nothing else in the kit makes sense without this loop. S2 exists to survive the part of the fight before the loop resets. The ult exists to start the loop on a target who is not standing next to him yet.\"}]\n81:[\"$\",\"p\",\"p-6\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The tell for a good Khaleed is whether he arrives at the fight with Desert Power already charged. If he crosses the river with no orange ring under his feet, he is playing the kit wrong.\"}]\n82:[\"$\",\"h2\",\"h2-2\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Laning: the first six minutes\"]}]\n83:[\"$\",\"p\",\"p-7\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Khaleed is a roamer. He visits lanes; he does not own one. The opening rotation is the game.\"}]\n84:[\"$\",\"ol\",\"ol-0\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Take S1 at level 1 and start at the buff your jungler does not want.\"}],\" Usually that means starting red if your jungler takes blue, then rotating to river before minions clash. Desert Power charges during the walk, so by the time you arrive at mid, your enhanced basic is ready for the first harass window.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"First gank target is the squishy mid mage.\"}],\" Ult at an angle so the knockback pushes them into your mid laner, not into their own tower. If you ult straight down-lane, you hand them free tower range. If you ult from the side, the stun lands in kill range.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Never cast S2 before you are already committed.\"}],\" Quicksand Guard is a Focused Cast, which means any CC interrupts it and you eat the full combo with no heal and no damage reduction. Use it after the fight has started and the enemy has blown their first hard lock, not as a pre-emptive shield.\"]}],\"\\n\"]}]\n85:[\"$\",\"h2\",\"h2-3\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The power spike you are farming toward\"]}]\n86:[\"$\",\"p\",\"p-8\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Thunder Belt plus a boot upgrade. That is the whole conversation.\"}]\n87:[\"$\",\"p\",\"p-9\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"$L40\",\"a-0\",{\"href\":\"/items/thunder-belt\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Thunder Belt\"}],\" turns a periodic basic attack into a true-damage tick that scales with your defensive stats instead of your attack, and staples a near-total slow onto the target for a beat. Because the proc reads your physical and magic defense, every tank item you buy quietly raises that tick. Khaleed's enhanced basic already carries its own slow, and Desert Power recharges fast enough during rotations that the enhanced basic comes back every few seconds of walking. Land the two on the same swing and a squishy is frozen in place long enough for your team's follow-up to connect.\"]}]\n88:[\"$\",\"p\",\"p-10\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Before Thunder Belt the hero ganks. After Thunder Belt the hero executes. That is the line. The spike lands around the 9 to 12 minute mark depending on rotation farm, and it is the point where Khaleed stops being a nuisance and starts being the reason a fight opens.\"}]\n89:[\"$\",\"h2\",\"h2-4\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Teamfight positioning and target priority\"]}]\n8a:[\"$\",\"p\",\"p-11\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The reflex when you play a mana-less fighter with a big ult is to charge first and ask questions later. On Khaleed that reflex gets your team aced.\"}]\n8b:[\"$\",\"ol\",\"ol-1\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Ult last, not first.\"}],\" Raging Sandstorm is CC-immune during the charge but it is loud and slow, which means any tank with a ready engage tool (Khufra ball, Atlas ult, Tigreal hook) will catch you the instant you land. Let your primary tank burn the enemy's hard CC first, then ult into the backline while their lock is on cooldown.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Angle the ult to knock them toward your team, not through it.\"}],\" The knockback path runs from Khaleed's start position to the destination. If you ult from behind the enemy carry, they get shoved further from your team and toward their own support. Ult from the side or from your team's flank so the displacement lands them inside your damage.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"S1 is a commit, not an escape.\"}],\" Desert Tornado is an AoE whirl that pulls enemies in and lets you reposition a step between each of its three casts. It is sticking power, not a getaway: it barely moves you and it dodges nothing. Cast it when you already have a target pinned, not as a panic button when you are the one caught out.\"]}],\"\\n\"]}]\n8c:[\"$\",\"p\",\"p-12\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Edge case: if your support is Angela or Faramis, you can ult further forward than usual because Angela's shield follows you through the charge and Faramis can rez the greed. If your second frontliner is Johnson or Franco, stay conservative; both of them expect the initiator to survive their own engage.\"}]\n8d:[\"$\",\"$La4\",null,{\"slot\":\"7246933188\",\"variant\":\"in-article\",\"className\":\"my-8\"}]\n8e:[[\"$\",\"h2\",\"h2-0\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Itemization: defaults vs flex slots\"]}],\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Two slots are locked, four are real conversations.\"}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Locked\"}],\": Warrior Boots or Tough Boots (read the enemy comp, not the guide) and Thunder Belt. Go Tough Boots if the enemy has two CC threats or two burst mages; the 30% slow and CC duration reduction is worth more than 18 physical defense in every roam fight.\"]}],\"\\n\",[\"$\",\"p\",\"p-2\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Flex slot 1 is anti-heal when the enemy has Estes, Esmeralda, Alice, or Yu Zhong.\"}],\" \",[\"$\",\"$L40\",\"a-0\",{\"href\":\"/items/dominance-ice\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Dominance Ice\"}],\" is the right pick over \",[\"$\",\"$L40\",\"a-1\",{\"href\":\"/items/sea-halberd\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Sea Halberd\"}],\" for this build: its Lifebane cuts the shield and HP regen of every enemy within 5 units to 60% of normal, which is always ticking in a melee where your whole job is to stand in the middle of the fight, and its 40 physical defense plus 5% movement speed feed the Thunder Belt proc and Desert Power rotations. Sea Halberd's cut lasts three seconds on your target, but the attack stats on it fight the defense-scaling thesis of this build.\"]}],\"\\n\",[\"$\",\"p\",\"p-3\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Flex slot 2 is defense scaling\"}],\". Against a physical-heavy enemy take \",[\"$\",\"$L40\",\"a-0\",{\"href\":\"/items/antique-cuirass\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Antique Cuirass\"}],\" for the stacking damage reduction against skill users. Against a mage-heavy enemy take \",[\"$\",\"$L40\",\"a-1\",{\"href\":\"/items/athenas-shield\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Athena's Shield\"}],\" for the 25% magic damage reduction on hit. Do not take both; the second defensive item should be situational, not symmetric.\"]}],\"\\n\",[\"$\",\"p\",\"p-4\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Flex slot 3 is utility\"}],\". \",[\"$\",\"$L40\",\"a-0\",{\"href\":\"/items/oracle\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Oracle\"}],\" is underrated on Khaleed specifically because its Bless passive increases received shield and HP regen effects by 25%, which makes the S2 heal roughly a quarter bigger during the focused cast. Alternatively, \",\"$La5\",\" if you are the primary engage and dying first; the 30% damage reduction under 40% HP plus the 2-second cooldown refund means you get S2 back faster when it matters.\"]}],\"\\n\",\"$La6\",\"\\n\",\"$La7\",\"\\n\",\"$La8\",\"\\n\",\"$La9\",\"\\n\",\"$Laa\",\"\\n\",\"$Lab\",\"\\n\",\"$Lac\",\"\\n\",\"$Lad\",\"\\n\",\"$Lae\",\"\\n\",\"$Laf\",\"\\n\",\"$Lb0\",\"\\n\",\"$Lb1\",\"\\n\",\"$Lb2\",\"\\n\",\"$Lb3\"]\n8f:[\"$\",\"$Lb4\",null,{\"heroName\":\"Khaleed\"}]\n"])</script><script>self.__next_f.push([1,"90:[\"$\",\"$L6a\",\"phoveus\",{\"href\":\"/heroes/phoveus\",\"className\":\"group block\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative bg-surface-4 border border-mlbb-gold/20 overflow-hidden card-hover hover:border-mlbb-gold/50\",\"style\":{\"boxShadow\":\"0 2px 8px rgba(0,0,0,0.3)\"},\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 p-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative w-14 h-14 rounded-full overflow-hidden flex-shrink-0 bg-surface-3\",\"children\":[\"$\",\"$L6b\",null,{\"src\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_af21c0dd8b5308c27974bff900803a9a.png\",\"alt\":\"Phoveus - Chains of Sin\",\"unoptimized\":false,\"priority\":\"$undefined\",\"fetchPriority\":\"$undefined\",\"fill\":true,\"className\":\"object-cover group-hover:scale-110 transition-transform duration-300\",\"sizes\":\"56px\",\"placeholder\":\"blur\",\"blurDataURL\":\"data:image