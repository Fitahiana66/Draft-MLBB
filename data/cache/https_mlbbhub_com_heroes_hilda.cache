andom.com/wiki/Hilda/Cosmetics\"},{\"name\":\"Aries\",\"tier\":\"Deluxe\",\"rawTier\":\"Deluxe\",\"tag\":\"Zodiac\",\"tagSlug\":\"zodiac\",\"price\":\"Zodiac Summon\",\"portraitFile\":\"Hero355-portrait.png\",\"portraitUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/hilda/Hero355-portrait-20230317100645.webp\",\"splashUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/hilda/Hilda-Aries-20230321152141.webp\",\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Hilda/Cosmetics\"},{\"name\":\"Bass Craze\",\"tier\":\"Exceptional\",\"rawTier\":\"Exceptional\",\"tag\":\"Special\",\"tagSlug\":\"special\",\"price\":\"749\",\"portraitFile\":\"Hero356-portrait.png\",\"portraitUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/hilda/Hero356-portrait-20220525165055.webp\",\"splashUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/hilda/Hilda-Bass-Craze-20250407150244.webp\",\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Hilda/Cosmetics\"},{\"name\":\"Carmine Craze\",\"tier\":\"Exceptional\",\"rawTier\":\"Exceptional\",\"tag\":\"Special\",\"tagSlug\":\"special\",\"price\":\"2022/12 StarLight Reward\",\"portraitFile\":\"Hero356-portrait.png\",\"portraitUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/hilda/Hero356-portrait-20220525165055.webp\",\"splashUrl\":null,\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Hilda/Cosmetics\"}],\"lore\":{\"backstory\":\"Hilda is a fearsome warrior from the Megalith Wasteland, a desolate region where only the strongest survive. She was raised among wild beasts and learned to fight by wrestling bears and wolves. Her massive greatsword was forged from a meteor that fell near her mountain home, imbued with the power of the wilderness itself. Hilda draws strength from the land, regenerating rapidly when surrounded by nature. Her Power of Wildness grows with each enemy she defeats, making her a snowballing threat that becomes more dangerous as battles rage on.\",\"allies\":[{\"heroSlug\":\"franco\",\"heroName\":\"Franco\",\"relationship\":\"Northern ally from the frozen wastes\"},{\"heroSlug\":\"aulus\",\"heroName\":\"Aulus\",\"relationship\":\"Young warrior she mentors in combat\"}],\"rivals\":[{\"heroSlug\":\"alucard\",\"heroName\":\"Alucard\",\"relationship\":\"Demon hunter who clashes with her wild nature\"},{\"heroSlug\":\"silvanna\",\"heroName\":\"Silvanna\",\"relationship\":\"Imperial knight who considers her uncivilized\"}]},\"loreUrlName\":\"Hilda\",\"statsHistory\":[{\"date\":\"2026-09-07\",\"winRate\":50.79,\"pickRate\":0.59,\"banRate\":3.82},{\"date\":\"2026-09-10\",\"winRate\":50.73,\"pickRate\":0.59,\"banRate\":4.34},{\"date\":\"2026-09-16\",\"winRate\":50.62,\"pickRate\":0.59,\"banRate\":6.12},{\"date\":\"2026-09-28\",\"winRate\":49.95,\"pickRate\":0.6,\"banRate\":5.37},{\"date\":\"2026-10-02\",\"winRate\":50.16,\"pickRate\":0.6,\"banRate\":5.88},{\"date\":\"2026-10-09\",\"winRate\":50.39,\"pickRate\":0.58,\"banRate\":7.38},{\"date\":\"2026-10-17\",\"winRate\":50.72,\"pickRate\":0.56,\"banRate\":8.93}]},\"relatedHeroesSlot\":\"$L66\",\"statsSeoSlot\":\"$L67\",\"fieldManualSlot\":\"$L68\"}]\n61:[\"$\",\"$L69\",null,{\"heroName\":\"Hilda\",\"heroSlug\":\"hilda\",\"roles\":\"$60:props:hero:role\",\"lanes\":\"$60:props:hero:lane\",\"difficulty\":1,\"winRate\":50.72,\"pickRate\":0.56,\"banRate\":8.93,\"curatedBuilds\":\"$60:props:curatedBuilds\",\"topCounters\":\"$60:props:tabData:counterData:countersThisHero\",\"hasCounterPage\":true,\"hasRankStats\":true,\"locale\":\"en\",\"pageUrl\":\"https://mlbbhub.com/heroes/hilda\",\"year\":2026}]\n"])</script><script>self.__next_f.push([1,"6a:I[313915,[\"$7\",\"$8\",\"$9\",\"$a\",\"$b\",\"$2e\",\"$3e\",\"$3f\"],\"default\"]\n6b:I[279344,[\"$7\",\"$8\",\"$9\",\"$a\",\"$b\",\"$2e\",\"$3e\",\"$3f\"],\"Image\"]\n6c:I[842376,[\"$7\",\"$8\",\"$9\",\"$a\",\"$b\",\"$2e\",\"$3e\",\"$3f\"],\"default\"]\n7d:I[365750,[\"$7\",\"$8\",\"$9\",\"$a\",\"$b\",\"$2e\",\"$3e\",\"$3f\"],\"default\"]\n66:[\"$\",\"section\",null,{\"className\":\"content-laz