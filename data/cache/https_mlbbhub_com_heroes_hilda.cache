":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#B07ECC\",\"background\":\"#B07ECC1a\",\"border\":\"1px solid #B07ECC40\"},\"children\":\"Epic\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Hilda\",\"rank\":\"Epic\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=epic\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Epic\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Epic\",\"name\":\"Hilda\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"54.59\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Hilda\",\"delta\":\"+3.68%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.70\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"19.96\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Epic\"}}]]}]]}],[\"$\",\"article\",\"legend\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #4dc9f6, #4dc9f633)\",\"boxShadow\":\"0 0 12px -2px #4dc9f680\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#4dc9f6\",\"background\":\"#4dc9f61a\",\"border\":\"1px solid #4dc9f640\"},\"children\":\"Legend\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Hilda\",\"rank\":\"Legend\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=legend\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Legend\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Legend\",\"name\":\"Hilda\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"52.01\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Hilda\",\"delta\":\"+1.10%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.79\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"16.24\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Legend\"}}]]}]]}],[\"$\",\"article\",\"mythic\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[\"$La5\",\"$La6\",\"$La7\"]}],\"$La8\",\"$La9\"]}]\n7e:[\"$\",\"$L40\",\"a-7\",{\"href\":\"/heroes/melissa\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Melissa\"}]\n7f:[\"$\",\"$L40\",\"a-8\",{\"href\":\"/heroes/estes\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Estes\"}]\n80:[\"$\",\"p\",\"p-1\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[\"She is the wrong pick when the enemy draft has two of \",[\"$\",\"$L40\",\"a-0\",{\"href\":\"/heroes/karrie\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Karrie\"}],\", \",[\"$\",\"$L40\",\"a-1\",{\"href\":\"/heroes/kimmy\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Kimmy\"}],\", \",[\"$\",\"$L40\",\"a-2\",{\"href\":\"/heroes/valir\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Valir\"}],\", \",[\"$\",\"$L40\",\"a-3\",{\"href\":\"/heroes/franco\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Franco\"}],\", or \",[\"$\",\"$L40\",\"a-4\",{\"href\":\"/heroes/baxia\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Baxia\"}],\". Karrie and Kimmy outrange her bush poke and kite the whole teamfight into open ground where she has no passive. Valir knocks her back the instant she commits S1. Franco hooks her out of bushes before she gets to enhance her basic. Baxia's passive is built to eat sustain heroes and his second skill ignores her S1 shield. If you cannot name which draft condition you are in right now, Hilda is the wrong pick and you should swap to a more flexible roamer like \",[\"$\",\"$L40\",\"a-5\",{\"href\":\"/heroes/edith\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Edith\"}],\" or \",[\"$\",\"$L40\",\"a-6\",{\"href\":\"/heroes/mathilda\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Mathilda\"}],\".\"]}]\n81:[\"$\",\"h2\",\"h2-1\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The one thing that makes Hilda work\"]}]\n82:[\"$\",\"p\",\"p-2\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Hilda is a setup hero whose setup is invisible. Every basic attack and every skill hit plants a Wilderness mark on the target, and those marks convert her ultimate from a brief single-target stun into a percent-max-HP execute that shreds a chunk of the target's physical and magic defense. The fantasy the UI sells you is the ult slash. The actual game is the twelve seconds before the ult, where you are walking through bush lines stacking marks on the same squishy and nobody on the enemy team registers that anything is happening.\"}]\n83:[\"$\",\"p\",\"p-3\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[\"The 2.1.30 rework (\",[\"$\",\"$L40\",\"a-0\",{\"href\":\"/patch-notes\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"patch notes\"}],\") made this identity cleaner by separating her engage tools. Before the rework, her enhanced basic attack was chained to Skill 1, so committing S1 and committing the enhance cost the same cooldown. Now the enhanced basic lives on the passive and fires when you enter any bush, while S1 is a pure shield-plus-speed burst. That split is what makes her a roamer again instead of an EXP brawler: you can stack marks in bushes without spending your defensive cooldown, then save S1 for the moment the fight actually starts. Patch 2.1.88 (\",[\"$\",\"$L40\",\"a-1\",{\"href\":\"/patch-notes\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"patch notes\"}],\") pushed that further by scaling the S1 shield up to nearly a third of her max HP at max rank (while shaving a little base HP and S2 burst), so S1 is now a genuine panic button rather than a token bubble. If you play her like a pre-rework bruiser who all-ins with S1 first, you are throwing the best thing about her kit.\"]}]\n84:[\"$\",\"h2\",\"h2-2\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Laning: the first 8 minutes\"]}]\n85:[\"$\",\"p\",\"p-4\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"You are roaming. You do not have a lane.\"}]\n86:[\"$\",\"ol\",\"ol-0\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Start on gold lane for the first two waves.\"}],\" Your enhanced bush basic slow locks the enemy jungler out of their red buff invade timing, and a level-2 S2 into the enemy marksman usually burns their battle spell. Leave before the third wave: you are not a gold lane tank, you are a harassment tax.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Rotate to EXP lane at 1:30 to contest blue buff side bushes.\"}],\" The EXP laner wants vision and a shielded walk-up; you give both. If the enemy EXP is a ranged poker (\",[\"$\",\"$L40\",\"a-0\",{\"href\":\"/heroes/gloo\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Gloo\"}],\", \",[\"$\",\"$L40\",\"a-1\",{\"href\":\"/heroes/yve\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Yve\"}],\" pulled to EXP, \",[\"$\",\"$L40\",\"a-2\",{\"href\":\"/heroes/valir\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Valir\"}],\"), do not stand in their lane, just clear the tri-bush line and leave.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"First Turtle is yours to set up, not to smite.\"}],\" Sit in the Turtle pit bush fifteen seconds before spawn, apply bush enhance on whoever contests, and pop S1 shield the moment your jungler starts damage. Do not ult the Turtle. Save the ult for the enemy jungler the moment they show up to contest; three marks plus ult deletes them from half HP.\"]}],\"\\n\"]}]\n87:[\"$\",\"p\",\"p-5\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[\"Battle spell is \",[\"$\",\"$L40\",\"a-0\",{\"href\":\"/spells\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Flicker\"}],\" in ranked and \",[\"$\",\"$L40\",\"a-1\",{\"href\":\"/spells\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Sprint\"}],\" only if the enemy draft has zero point-click CC. \",[\"$\",\"$L40\",\"a-2\",{\"href\":\"/spells\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Execute\"}],\" belongs on EXP lane Hilda, not on roam Hilda; as a roamer your job is to land the engage and let your carry finish, not to steal the kill.\"]}]\n88:[\"$\",\"h2\",\"h2-3\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The power spike you are farming toward\"]}]\n89:[\"$\",\"p\",\"p-6\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[\"Two items. \",[\"$\",\"$L40\",\"a-0\",{\"href\":\"/items/thunder-belt\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Thunder Belt\"}],\" and \",[\"$\",\"$L40\",\"a-1\",{\"href\":\"/items/dominance-ice\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Dominance Ice\"}],\", in that order, ideally closed out by minute 9 to 10.\"]}]\n8a:[\"$\",\"p\",\"p-7\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Thunder Belt is not subtle about why it's on this hero. The Thunderbolt passive fires true damage scaled off your total hybrid defense every four seconds on basic attack, and Hilda's whole kit is designed around repeatedly applying the enhanced basic from bush. The item stacks hybrid defense permanently on hit, which means your Thunder Belt proc keeps getting stronger during the same fight. The 99% slow on the proc is also what lets you set up S2's third-strike knockback on a target who would otherwise dash out. Build the Ares Belt component first for the raw HP.\"}]\n8b:[\"$\",\"p\",\"p-8\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Dominance Ice is your anti-dive sustain check and your grouped-fight defense anchor in one slot. Both passives are a short-range aura now: Fortress Shield stacks Hybrid Defense for every enemy hero within 5 units of you, and Lifebane cuts the Shield and HP Regen of those same enemies to 60% for as long as they stay close. Because you are the durable body the enemy assassin and marksman have to stand next to in order to reach your carry, the heroes who want to lifesteal off you are exactly the ones losing their sustain the moment they commit. (The anti-heal on your actual kill target is Sea Halberd's job, covered below.)\"}]\n8c:[\"$\",\"p\",\"p-9\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The spike happens because after Thunder Belt and Dominance Ice you can commit S1 into a four-person cluster and survive the return fire while Thunderbolt ticks true damage every four seconds to everyone standing near your target. Before this spike you are a vision bot with a long-cooldown ult. After this spike you are the person who starts teamfights and lives through them.\"}]\n8d:[\"$\",\"h2\",\"h2-4\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Teamfight positioning and target priority\"]}]\n8e:[\"$\",\"p\",\"p-10\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The reflex when you see a fed enemy assassin is to peel for your carry. On most tanks that reflex is correct. On Hilda it is usually wrong, because her peel is terrible (no point-click CC, only a flicker of a stun on a single-target ult, no displacement). She peels by threatening to delete the assassin's teammates from across the fight, not by body-blocking.\"}]\n8f:[\"$\",\"ol\",\"ol-1\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Do not initiate from the front.\"}],\" Hilda has no front-to-back engage. Her S1 is a personal shield, not a team speed boost like \",[\"$\",\"$L40\",\"a-0\",{\"href\":\"/heroes/atlas\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Atlas\"}],\" or \",[\"$\",\"$L40\",\"a-1\",{\"href\":\"/heroes/mathilda\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Mathilda\"}],\". Walk to a flank bush, apply bush enhance on whichever backline carry is closest to your bush line, and open the fight by slow-locking them into your team's follow-up.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Your target is the highest-HP squishy, not the tank.\"}],\" Her ult's bonus damage scales off the target's max HP, so in absolute terms it carves a bigger piece out of a beefy mage or marksman than out of a tank's even-larger pool padded by physical defense. Use ult on the juicy backline target, not the closest body.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"S2 is a commitment tool, not a poke tool.\"}],\" The lock-on does not break on the target using a dash or entering fog, so the full 3-strike chain lands even if they Flicker. Save S2 for the target you are about to ult; wasting S2 on the tank means you arrive at the execute window with 0 marks and an ult that only does its tiny base stun.\"]}],\"\\n\"]}]\n90:[\"$\",\"p\",\"p-11\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[\"The support-conditional edge case: if your main carry is \",[\"$\",\"$L40\",\"a-0\",{\"href\":\"/heroes/ixia\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Ixia\"}],\" or any carry that wants a long front-to-back fight, you can flex into a peel-first role by sitting on top of them and saving S2 for the first diver in. If your carry is a flanker (\",[\"$\",\"$L40\",\"a-1\",{\"href\":\"/heroes/fanny\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Fanny\"}],\", \",[\"$\",\"$L40\",\"a-2\",{\"href\":\"/heroes/ling\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Ling\"}],\"), never peel; mirror-flank them and open on the same target.\"]}]\n91:[\"$\",\"$Laa\",null,{\"slot\":\"7246933188\",\"variant\":\"in-article\",\"className\":\"my-8\"}]\n92:[[\"$\",\"h2\",\"h2-0\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Itemization: defenses lock, flex slot flexes\"]}],\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Boots, Thunder Belt, and Dominance Ice are locked. Everything after that is a real conversation.\"}],\"\\n\",[\"$\",\"ul\",\"ul-0\",{\"className\":\"list-disc list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Boots choice\"}],\" is not automatic. \",[\"$\",\"$L40\",\"a-0\",{\"href\":\"/items/tough-boots\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Tough Boots\"}],\" is the default vs any draft with one or more hard-CC heroes because 30% CC duration reduction keeps you mobile through the exact spells that shut you down (Franco hook, Khufra ult, Atlas ult). \",[\"$\",\"$L40\",\"a-1\",{\"href\":\"/items/warrior-boots\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Warrior Boots\"}],\" is correct vs heavy early physical pressure (Aamon jungle, Lancelot). \",[\"$\",\"$L40\",\"a-2\",{\"href\":\"/items/rapid-boots\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Rapid Boots\"}],\" is a tempo roam pick if and only if the game is likely to be decided before minute 10; the Side Effect speed loss on taking damage punishes the exact fights Hilda wants to be in.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Versus physical burst\"}],\", close with \",[\"$\",\"$L40\",\"a-0\",{\"href\":\"/items/antique-cuirass\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Antique Cuirass\"}],\" before \",[\"$\",\"$L40\",\"a-1\",{\"href\":\"/items/blade-armor\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Blade Armor\"}],\". Antique Cuirass has higher HP and the Deter passive stacks, while Blade Armor is a niche pick vs auto-attack marksmen and actively worse vs skill-damage physicals.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Versus magic burst\"}],\", \",[\"$\",\"$L40\",\"a-0\",{\"href\":\"/items/athenas-shield\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Athena's Shield\"}],\" for single-threat mages (\",[\"$\",\"$L40\",\"a-1\",{\"href\":\"/heroes/eudora\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Eudora\"}],\", \",[\"$\",\"$L40\",\"a-2\",{\"href\":\"/heroes/lylia\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Lylia\"}],\") and \",[\"$\",\"$L40\",\"a-3\",{\"href\":\"/items/radiant-armor\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Radiant Armor\"}],\" for sustained magic DPS (\",\"$Lab\",\", \",\"$Lac\",\"). Don't build both; they cover different curves.\"]}],\"\\n\",\"$Lad\",\"\\n\",\"$Lae\",\"\\n\"]}],\"\\n\",\"$Laf\",\"\\n\",\"$Lb0\",\"\\n\",\"$Lb1\",\"\\n\",\"$Lb2\",\"\\n\",\"$Lb3\",\"\\n\",\"$Lb4\",\"\\n\",\"$Lb5\",\"\\n\",\"$Lb6\",\"\\n\",\"$Lb7\",\"\\n\",\"$Lb8\",\"\\n\",\"$Lb9\",\"\\n\",\"$Lba\",\"\\n\",\"$Lbb\",\"\\n\",\"$Lbc\",\"\\n\",\"$Lbd\"]\n93:[\"$\",\"$Lbe\",null,{\"heroName\":\"Hilda\"}]\n"])</script><script>self.__next_f.push([1,"94:[\"$\",\"div\",null,{\"className\":\"relative bg-surface-4 border border-mlbb-gold/20 overflow-hidden card-hover hover:border-mlbb-gold/50\",\"style\":{\"boxShadow\":\"0 2px 8px rgba(0,0,0,0.3)\"},\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 p-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative w-14 h-14 rounded-full overflow-hidden flex-shrink-0 bg-surface-3\",\"children\":[\"$\",\"$L6b\",null,{\"src\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_4661a64a2c6b724e7b67032fcbface27.png\",\"alt\":\"Esmeralda - Astrologer\",\"unoptimized\":false,\"priority\":\"$undefined\",\"fetchPriority\":\"$undefined\",\"fill\":true,\"className\":\"object-cover group-hover:scale-110 transition-transform duration-300\",\"sizes\":\"56px\",\"placeholder\":\"blur\",\"blurDataURL\":\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTAwIiBoZWlnaHQ9IjEwMCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48cmVjdCB3aWR0aD0iMTAwIiBoZWlnaHQ9IjEwMCIgZmlsbD0iIzBkMTIyNSIvPjwvc3ZnPg==\"}]}],[\"$\",\"div\",