dom.com/wiki/Irithel/Cosmetics\"},{\"name\":\"Checkered Knight\",\"tier\":\"Exceptional\",\"rawTier\":\"Exceptional\",\"tag\":\"Starlight\",\"tagSlug\":\"starlight\",\"price\":\"2025/02 StarLight Member\",\"portraitFile\":\"Hero438-portrait.png\",\"portraitUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/irithel/Hero438-portrait-20241201052814.webp\",\"splashUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/irithel/Irithel-Checkered-Knight-20250211140705.webp\",\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Irithel/Cosmetics\"},{\"name\":\"Ice Spike\",\"tier\":\"Deluxe\",\"rawTier\":\"Deluxe\",\"tag\":\"Epic\",\"tagSlug\":\"epic\",\"price\":\"Limited-time Event\",\"portraitFile\":\"Hero433-portrait.png\",\"portraitUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/irithel/Hero433-portrait-20220525165212.webp\",\"splashUrl\":null,\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Irithel/Cosmetics\"},{\"name\":\"Neon Knight\",\"tier\":\"Exceptional\",\"rawTier\":\"Exceptional\",\"tag\":\"Starlight\",\"tagSlug\":\"starlight\",\"price\":\"2025/01 StarLight Reward\",\"portraitFile\":null,\"portraitUrl\":null,\"splashUrl\":null,\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Irithel/Cosmetics\"},{\"name\":\"Rosy Knight\",\"tier\":\"Exceptional\",\"rawTier\":\"Exceptional\",\"tag\":\"Starlight\",\"tagSlug\":\"starlight\",\"price\":\"Limited-time Event\",\"portraitFile\":null,\"portraitUrl\":null,\"splashUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/irithel/Irithel-Rosy-Knight-20250703150916.webp\",\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Irithel/Cosmetics\"}],\"lore\":{\"backstory\":\"Irithel was abandoned as an infant in the untamed jungles of the Land of Dawn and raised by Leo, a giant smilodon, a prehistoric saber-toothed predator of immense strength and loyalty. Growing up among beasts, she learned to communicate with animals, track prey through any terrain, and fire a heavy crossbow with deadly accuracy while riding Leo at full gallop. When civilization encroached upon her jungle home, Irithel reluctantly joined the conflict, fighting to protect the wild places and the creatures that raised her. Her Heavy Crossbow and Leo's savage charges make them one of the most formidable mounted combat pairs on any battlefield.\",\"allies\":[{\"heroSlug\":\"miya\",\"heroName\":\"Miya\",\"relationship\":\"Moon Elf Queen who respects her bond with nature\"},{\"heroSlug\":\"moskov\",\"heroName\":\"Moskov\",\"relationship\":\"Fellow marksman who once shared her wild hunting grounds\"}],\"rivals\":[{\"heroSlug\":\"clint\",\"heroName\":\"Clint\",\"relationship\":\"Frontier gunslinger whose expansion threatens her jungle home\"},{\"heroSlug\":\"karrie\",\"heroName\":\"Karrie\",\"relationship\":\"Lightborn warrior whose technology clashes with her primal ways\"}]},\"loreUrlName\":\"$undefined\",\"statsHistory\":[{\"date\":\"2026-09-07\",\"winRate\":51.01,\"pickRate\":0.45,\"banRate\":0.37},{\"date\":\"2026-09-10\",\"winRate\":50.99,\"pickRate\":0.44,\"banRate\":0.37},{\"date\":\"2026-09-16\",\"winRate\":50.44,\"pickRate\":0.42,\"banRate\":0.35},{\"date\":\"2026-09-28\",\"winRate\":52.34,\"pickRate\":0.41,\"banRate\":0.22},{\"date\":\"2026-10-02\",\"winRate\":52.35,\"pickRate\":0.42,\"banRate\":0.23},{\"date\":\"2026-10-09\",\"winRate\":52.31,\"pickRate\":0.41,\"banRate\":0.24},{\"date\":\"2026-10-17\",\"winRate\":52.47,\"pickRate\":0.39,\"banRate\":0.26}]},\"relatedHeroesSlot\":\"$L66\",\"statsSeoSlot\":\"$L67\",\"fieldManualSlot\":\"$L68\"}]\n62:[\"$\",\"$L69\",null,{\"heroName\":\"Irithel\",\"heroSlug\":\"irithel\",\"roles\":\"$61:props:hero:role\",\"lanes\":\"$61:props:hero:lane\",\"difficulty\":1,\"winRate\":52.47,\"pickRate\":0.39,\"banRate\":0.26,\"curatedBuilds\":\"$61:props:curatedBuilds\",\"topCounters\":\"$61:props:tabData:counterData:countersThisHero\",\"hasCounterPage\":true,\"hasRankStats\":true,\"locale\":\"en\",\"pageUrl\":\"https://mlbbhub.com/heroes/irithel\",\"year\":2026}]\n"])</script