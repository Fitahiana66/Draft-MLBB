ren\":[\"$Lb2\",\"$Lb3\",\"$Lb4\"]}],\"$Lb5\",\"$Lb6\"]}]\n7e:[\"$\",\"$L40\",\"a-4\",{\"href\":\"/heroes/angela\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Angela\"}]\n7f:[\"$\",\"$L40\",\"a-5\",{\"href\":\"/heroes/mathilda\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Mathilda\"}]\n80:[\"$\",\"$L40\",\"a-6\",{\"href\":\"/heroes/rafaela\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Rafaela\"}]\n81:[\"$\",\"$L40\",\"a-7\",{\"href\":\"/heroes/esmeralda\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Esmeralda\"}]\n82:[\"$\",\"$L40\",\"a-8\",{\"href\":\"/heroes/gloo\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Gloo\"}]\n83:[\"$\",\"$L40\",\"a-9\",{\"href\":\"/heroes/fredrinn\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Fredrinn\"}]\n84:[\"$\",\"$L40\",\"a-10\",{\"href\":\"/heroes/yu-zhong\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Yu Zhong\"}]\n85:[\"$\",\"$L40\",\"a-11\",{\"href\":\"/heroes/franco\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Franco\"}]\n86:[\"$\",\"$L40\",\"a-12\",{\"href\":\"/heroes/hayabusa\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Hayabusa\"}]\n87:[\"$\",\"$L40\",\"a-13\",{\"href\":\"/heroes/lancelot\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Lancelot\"}]\n88:[\"$\",\"$L40\",\"a-14\",{\"href\":\"/heroes/helcurt\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Helcurt\"}]\n89:[\"$\",\"$L40\",\"a-15\",{\"href\":\"/heroes/ling\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Ling\"}]\n8a:[\"$\",\"$L40\",\"a-16\",{\"href\":\"/heroes/natalia\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Natalia\"}]\n8b:[\"$\",\"$L40\",\"a-17\",{\"href\":\"/heroes/saber\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Saber\"}]\n8c:[\"$\",\"$L40\",\"a-18\",{\"href\":\"/heroes/gusion\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Gusion\"}]\n8d:[\"$\",\"$L40\",\"a-19\",{\"href\":\"/heroes/aamon\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Aamon\"}]\n8e:[\"$\",\"$L40\",\"a-20\",{\"href\":\"/heroes/brody\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Brody\"}]\n8f:[\"$\",\"$L40\",\"a-21\",{\"href\":\"/heroes/lesley\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Lesley\"}]\n90:[\"$\",\"$L40\",\"a-22\",{\"href\":\"/heroes/clint\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Clint\"}]\n91:[\"$\",\"p\",\"p-2\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The disqualifying test is simple. Point at the tank or support on your team who will eat the assassin's ultimate for you. If you cannot name them out loud before the match starts, do not lock Irithel.\"}]\n92:[\"$\",\"h2\",\"h2-1\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The one thing that makes Irithel work\"]}]\n93:[\"$\",\"p\",\"p-3\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Irithel's passive is the entire hero. She fires two bolts per basic attack, each carrying more than half her total physical attack, and she does it without stopping her movement. Every other marksman pays a kiting tax: plant to shoot, shuffle, plant. Irithel does not plant. She strafes across the screen at full attack speed, and that single mechanical freedom is what makes her two-item spike feel like a cheat code.\"}]\n94:[\"$\",\"p\",\"p-4\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[\"The design cost is that her bolts have a refill cycle. After every shot her crossbow takes longer than a normal marksman's autocycle to reload, and her extra bolt on the next basic only lands after she has physically moved some distance. She is a hero you \",[\"$\",\"em\",\"em-0\",{\"children\":\"commit to walking forward with\"}],\". Standing still gives up roughly a third of her potential output; walking through the lane, nudging side to side, is where her DPS actually lives.\"]}]\n95:[\"$\",\"p\",\"p-5\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"$L40\",\"a-0\",{\"href\":\"/heroes/irithel\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Heavy Crossbow\"}],\" changes the shot profile entirely. During the ultimate window she trades the two-bolt split for a single empowered bolt that deals AOE damage around the target. Against a clumped backline that flips her ult into a fight-winner, which is why any enemy composition that groups to fight through chokes is a green-light pick for her.\"]}]\n96:[\"$\",\"h2\",\"h2-2\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Laning: the first five minutes\"]}]\n97:[\"$\",\"ol\",\"ol-0\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Take Strafe at level 1 and zone the wave.\"}],\" The defense reduction it leaves behind stacks with any follow-up basic, and a single cast pushes the enemy marksman off the cannon wave. Do not open with a basic-attack trade; open with a Strafe drop on their feet and walk forward into the damage window it opens. Strafe's cooldown scales down with rank, so once you max it the ability is up almost every wave rather than every other wave.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Prioritize Force of the Queen at level 2.\"}],\" The slow is your only defensive tool until you buy \",[\"$\",\"$L40\",\"a-0\",{\"href\":\"/items/corrosion-scythe\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Corrosion Scythe\"}],\". Hold it for the first gank rather than spending it for wave clear, because if a \",[\"$\",\"$L40\",\"a-1\",{\"href\":\"/heroes/saber\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Saber\"}],\" or \",[\"$\",\"$L40\",\"a-2\",{\"href\":\"/heroes/ling\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Ling\"}],\" comes bot and you burned your slow on minions, you are dead before Flicker comes off cooldown.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Do not ult for a lane kill before level 6.\"}],\" The ultimate's value is the AOE empowered bolt during teamfights and the mount-up reposition. Blowing it to close out a solo-lane kill means you fight the next rotation without it, and marksmen who ult for their first kill are the ones who feed the mid turret five minutes later.\"]}],\"\\n\"]}]\n98:[\"$\",\"div\",\"blockquote-0\",{\"className\":\"my-5 p-4 flex gap-3\",\"style\":{\"background\":\"rgba(0,170,255,0.08)\",\"border\":\"1px solid rgba(0,170,255,0.35)\"},\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-info w-4 h-4 flex-shrink-0 mt-0.5\",\"aria-hidden\":\"true\",\"style\":{\"color\":\"#00AAFF\"},\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"1dtifu\",{\"d\":\"M12 16v-4\"}],[\"$\",\"path\",\"e9boi3\",{\"d\":\"M12 8h.01\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-[11px] font-heading font-bold uppercase tracking-wider mb-1\",\"style\":{\"color\":\"#00AAFF\"},\"children\":\"Note\"}],[[\"$\",\"p\",\"0\",{\"className\":\"text-sm text-[#9BA0B4] leading-relaxed\",\"children\":[\"Always take \",[\"$\",\"$L40\",\".$a-0\",{\"href\":\"/spells\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Flicker\"}],\" over Inspire. Irithel has no dash and no blink. Flicker is the only thing that lets her walk out of a Franco hook cancel window or around a Khufra leash, and Inspire's attack-speed burst is redundant with Corrosion Scythe's stacking attack speed anyway.\"]}]]]}]]}]\n99:[\"$\",\"h2\",\"h2-3\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The power spike you are farming toward\"]}]\n9a:[\"$\",\"p\",\"p-6\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"$L40\",\"a-0\",{\"href\":\"/items/demon-hunter-sword\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Demon Hunter Sword\"}],\" plus \",[\"$\",\"$L40\",\"a-1\",{\"href\":\"/items/corrosion-scythe\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Corrosion Scythe\"}],\" is the fight-winning combination, and it lands around the twelve-minute mark on a clean lane. Demon Hunter Sword's Devour passive adds 8% of the target's current HP as physical damage on every basic attack, which on Irithel means every pair of bolts carries both the flat physical damage and the percent-HP chunk. Against a \",[\"$\",\"$L40\",\"a-2\",{\"href\":\"/heroes/gloo\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Gloo\"}],\" or a \",[\"$\",\"$L40\",\"a-3\",{\"href\":\"/heroes/fredrinn\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Fredrinn\"}],\" who built two armor items, that percent-HP clause is the difference between a ten-second duel and a four-second deletion.\"]}]\n9b:[\"$\",\"p\",\"p-7\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Corrosion Scythe is what turns the kit from good-in-lane to oppressive-in-teamfights. The slow stacks up to five times on a single target, and because Irithel outputs so many basics per second, the stack caps before anyone can disengage. The attack-speed ramp from Impulse also piles on during the same window, so her DPS is still climbing while the enemy's movement speed is decaying. Stand in the wrong spot for two seconds against a fed Irithel with these two items and you are not getting out.\"}]\n9c:[\"$\",\"p\",\"p-8\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The specific thing that changes at the spike: before it, she kites and trades. After it, she wins duels into any solo-squishy in the enemy backline and shreds any frontliner stupid enough to face-tank her. Her physical attack growth is high for a marksman, so every point of per-level scaling hits harder and the two-item spike lands with more punch. You are not farming toward a late-game scaling curve; you are farming toward a two-item kill window.\"}]\n9d:[\"$\",\"$Lb7\",null,{\"slot\":\"7246933188\",\"variant\":\"in-article\",\"className\":\"my-8\"}]\n9e:[[\"$\",\"h2\",\"h2-0\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Teamfight positioning and target priority\"]}],\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The reflex when you see a clumped enemy team is to ult into them for the AOE damage. That reflex is usually wrong. Heavy Crossbow is the single best survival tool Irithel has outside of Flicker, because the leap distance gets her off a dive and the empowered bolts reset her teamfight DPS rhythm. Spending it as an opener means you start the fight with no reposition, and an Irithel with no reposition cannot survive the follow-up dive.\"}],\"\\n\",[\"$\",\"ol\",\"ol-0\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Position on the opposite side of the map from the enemy assassin's starting rotation.\"}],\" If their \",[\"$\",\"$L40\",\"a-0\",{\"href\":\"/heroes/lancelot\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Lancelot\"}],\" starts red buff, you stand bot-side of the fight. If their \",[\"$\",\"$L40\",\"a-1\",{\"href\":\"/heroes/hayabusa\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Hayabusa\"}],\" starts blue, you stand top-side. Distance from the flank is a better defense than any item.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Ult away from the threat, not toward the kill.\"}],\" When a \",[\"$\",\"$L40\",\"a-0\",{\"href\":\"/heroes/khufra\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Khufra\"}],\" lines up a jump, burn Heavy Crossbow to leap perpendicular to his vector, not into the kill. The empowered bolts still output damage during the reposition, so you are not losing teamfight DPS, you are just landing it from a safer angle.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Target priority is range, not health.\"}],\" Your split-bolt passive means you pour DPS into whoever you are auto-attacking for the full duration. Locking onto a \",[\"$\",\"$L40\",\"a-0\",{\"href\":\"/heroes/gloo\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Gloo\"}],\" because he is low is how you die to his backline. Lock onto the enemy marksman first, their mage second, and only swap to the tank after both squishies are dead or have burned their escapes.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[\"If your support is \",[\"$\",\"$L40\",\"a-0\",{\"href\":\"/heroes/estes\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Estes\"}],\" or \",[\"$\",\"$L40\",\"a-1\",{\"href\":\"/heroes/angela\",\"prefetch\":false,\"className\":\"text-[#C8AA6E] hover:text-[#F0D060] underline decoration-[#C8AA6E]/40 hover:decoration-[#F0D060] transition-colors\",\"children\":\"Angela\"}],\", you can push your positioning one step further up than normal because both supports can out-heal chip poke. If your support is \",\"$Lb8\",\" or \",\"$Lb9\",\", stay a full screen back; their kits break CC after the fact, which means you eat the first hook or pull before the peel arrives.\"]}],\"\\n\",\"$Lba\",\"\\n\",\"$Lbb\",\"\\n\",\"$Lbc\",\"\\n\",\"$Lbd\",\"\\n\",\"$Lbe\",\"\\n\",\"$Lbf\",\"\\n\",\"$Lc0\",\"\\n\",\"$Lc1\",\"\\n\",\"$Lc2\",\"\\n\",\"$Lc3\",\"\\n\",\"$Lc4\",\"\\n\",\"$Lc5\",\"\\n\",\"$Lc6\",\"\\n\",\"$Lc7\",\"\\n\",\"$Lc8\",\"\\n\",\"$Lc9\",\"\\n\",\"$Lca\"]\n9f:[\"$\",\"$Lcb\",null,{\"heroName\":\"Irithel\"}]\n"])</script><script>self.__next_f.push([1,"a0:[\"$\",\"div\",null,{\"className\":\"relative bg-surface-4 border border-mlbb-gold/20 overflow-hidden card-hover hover:border-mlbb-gold/50\",\"style\":{\"boxShadow\":\"0 2px 8px rgba(0,0,0,0.3)\"},\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 p-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative w-14 h-14 rounded-full overflow-hidden flex-shrink-0 bg-surface-3\",\"children\":[\"$\",\"$L6b\",null,{\"src\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_