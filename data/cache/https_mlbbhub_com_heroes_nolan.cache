xt\":\" \"},{\"type\":\"text\",\"text\":\"Physical Damage\",\"color\":\"#fb1f1f\"},{\"type\":\"text\",\"text\":\" and leaving a \"},{\"type\":\"text\",\"text\":\"Rift\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\". (Damage to and from Minions or Creeps will not prevent Nolan from getting this effect.)\"}],\"cooldown\":null,\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_655b024d09823ec48d3557e202a404b7.png\",\"tags\":[\"Damage\"]},{\"name\":\"Expansion\",\"type\":\"Skill 1\",\"description\":\"Nolan cuts a rectangular area in front of him with his cosmic gauge, dealing 230 (+40% Total Physical Attack) Physical Damage and leaving a Rift at the first enemy hit.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Nolan cuts a rectangular area in front of him with his cosmic gauge, dealing 230\"},{\"type\":\"text\",\"text\":\" (+40% Total Physical Attack)\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Physical Damage\",\"color\":\"#fb1f1f\"},{\"type\":\"text\",\"text\":\" and leaving a \"},{\"type\":\"text\",\"text\":\"Rift\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\" at the first enemy hit.\"}],\"cooldown\":\"2.5s\",\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_f9e7e389d9aa59fb42aff11a2303cf1c.png\",\"tags\":[\"AOE\"]},{\"name\":\"Gauge\",\"type\":\"Skill 2\",\"description\":\"Nolan charges in the target direction and slashes with his cosmic gauge, dealing 70 (+13% Total Physical Attack) Physical Damage to enemies in his path and leaving a Rift.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Nolan charges in the target direction and slashes with his cosmic gauge, dealing 70\"},{\"type\":\"text\",\"text\":\" (+13% Total Physical Attack)\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Physical Damage\",\"color\":\"#fb1f1f\"},{\"type\":\"text\",\"text\":\" to enemies in his path and leaving a \"},{\"type\":\"text\",\"text\":\"Rift\",\"color\":\"#a6aafb\"},{\"type\":\"text\",\"text\":\".\"}],\"cooldown\":\"2.5s\",\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_23fc06b2b01c5abdf0c91182ab8eebc0.png\",\"tags\":[\"Mobility\"]},{\"name\":\"Fracture\",\"type\":\"Ultimate\",\"description\":\"Nolan slashes at the target location 3 times, dealing 120 (+50% Extra Physical Attack) Physical Damage with each slash while leaving 3 rifts and slowing the target hit by 30% for 0.5s. The rifts will be activated automatically while Nolan dashes backward.\",\"descriptionRich\":[{\"type\":\"text\",\"text\":\"Nolan slashes at the target location 3 times, dealing 120\"},{\"type\":\"text\",\"text\":\" (+50% Extra Physical Attack)\",\"color\":\"#fba51f\"},{\"type\":\"text\",\"text\":\" \"},{\"type\":\"text\",\"text\":\"Physical Damage\",\"color\":\"#fb1f1f\"},{\"type\":\"text\",\"text\":\" with each slash while leaving 3 rifts and slowing the target hit by 30% for 0.5s. The rifts will be activated automatically while Nolan dashes backward.\"}],\"cooldown\":\"21s\",\"manaCost\":null,\"icon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_a24a1a342fb4f6bd6f1d59de13e77a05.png\",\"tags\":[\"Burst\"]}],\"skillUpgradePriority\":\"3-1-2\"},\"synergies\":[{\"heroSlug\":\"tigreal\",\"heroName\":\"Tigreal\",\"synergyScore\":8,\"reason\":\"Nolan works well with Tanks that can initiate and CC the enemy so Nolan to focus on dealing as much damage as possible, such as Tigreal and Gatotkaca.\"},{\"heroSlug\":\"gatotkaca\",\"heroName\":\"Gatotkaca\",\"synergyScore\":8,\"reason\":\"Nolan works well with Tanks that can initiate and CC the enemy so Nolan to focus on dealing as much damage as possible, such as Tigreal and Gatotkaca.\"}],\"combos\":[{\"type\":\"teamfight\",\"title\":\"TEAMFIGHT COMBOS\",\"description\":\"In teamfights, approach the enemy using Nolan's 2nd Skill and enhanced Basic Attack, then activate the rift with his 1st Skill. Use Nolan's 2nd Skill to dash through the enemy, and unleash his Ultimate to activate all the rifts while dashing back to safety.\",\"skillSequence\":[{\"skillId\":12220,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_23fc06b2b01c5abdf0c91182ab8eebc0.png\"},{\"skillId\":12200,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_f98d2e98eaebfb31c6c5101cf1c3201a.png\"},{\"skillId\":12210,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_f9e7e389d9aa59fb42aff11a2303cf1c.png\"},{\"skillId\":12220,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_23fc06b2b01c5abdf0c91182ab8eebc0.png\"},{\"skillId\":12230,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_a24a1a342fb4f6bd6f1d59de13e77a05.png\"}]},{\"type\":\"laning\",\"title\":\"LANING COMBOS\",\"description\":\"In the laning phase, use Nolan's 2nd Skill and enhanced Basic Attack to catch the enemy, then use his 1st Skill to activate the rift. Follow up with his 2nd Skill into his 1st Skill to activate another rift explosion.\",\"skillSequence\":[{\"skillId\":12220,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_23fc06b2b01c5abdf0c91182ab8eebc0.png\"},{\"skillId\":12200,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_f98d2e98eaebfb31c6c5101cf1c3201a.png\"},{\"skillId\":12210,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_f9e7e389d9aa59fb42aff11a2303cf1c.png\"},{\"skillId\":12220,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_23fc06b2b01c5abdf0c91182ab8eebc0.png\"},{\"skillId\":12210,\"skillIcon\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_f9e7e389d9aa59fb42aff11a2303cf1c.png\"}]}],\"metaDescription\":\"Nolan build and counter guide for Mobile Legends. Heptaseas + Hunter Strike spike, rift-combo setup, Phoveus and Khufra matchups, and when to skip the pick.\",\"builds\":[],\"overviewLede\":\"Nolan is the assassin whose damage does not exist until two of his rifts touch. Pick him when your draft has peel for a short setup window and a squishy backline you can actually reach. Pick anything else when the enemy already locked Phoveus, Khufra, or Franco.\"},\"serverLocale\":\"en\",\"curatedBuilds\":{\"source\":\"curated\",\"hero\":\"nolan\",\"patch\":\"2.1.95\",\"lastReviewed\":\"2026-08-18\",\"stalePatch\":true,\"currentPatch\":\"2.2.16a\",\"builds\":[{\"slot\":1,\"id\":\"jungle-rift-burst\",\"name\":\"Jungle Rift Burst\",\"roleContext\":\"Jungle\",\"items\":[{\"slug\":\"tough-boots\",\"name\":\"Tough Boots\",\"cost\":700,\"fixed\":false},{\"slug\":\"blade-of-the-heptaseas\",\"name\":\"Blade of the Heptaseas\",\"cost\":1950,\"fixed\":false},{\"slug\":\"hunter-strike\",\"name\":\"Hunter Strike\",\"cost\":2010,\"fixed\":false},{\"slug\":\"malefic-roar\",\"name\":\"Malefic Roar\",\"cost\":2060,\"fixed\":false},{\"slug\":\"blade-of-despair\",\"name\":\"Blade of Despair\",\"cost\":3010,\"fixed\":false},{\"slug\":\"immortality\",\"name\":\"Immortality\",\"cost\":2120,\"fixed\":false}],\"coreItems\":[{\"slug\":\"blade-of-the-heptaseas\",\"name\":\"Blade of the Heptaseas\"},{\"slug\":\"hunter-strike\",\"name\":\"Hunter Strike\"},{\"slug\":\"malefic-roar\",\"name\":\"Malefic Roar\"}],\"emblem\":{\"slug\":\"assassin\",\"name\":\"Assassin Emblem\",\"talents\":[{\"slug\":\"rupture\",\"name\":\"Rupture\",\"iconUrl\":\"/images/talents/rupture.png\",\"bucket\":\"standard\"},{\"slug\":\"seasoned-hunter\",\"name\":\"Seasoned Hunter\",\"iconUrl\":\"/images/talents/seasoned-hunter.png\",\"bucket\":\"standard\"},{\"slug\":\"killing-spree\",\"name\":\"Killing Spree\",\"iconUrl\":\"/images/talents/killing-spree.png\",\"bucket\":\"core\"}]},\"spell\":{\"slug\":\"retribution\",\"name\":\"Retribution\"},\"blessing\":{\"slug\":\"ice-retribution\",\"name\":\"Ice Retribution\"},\"flexItems\":[{\"item\":{\"slug\":\"magic-boots\",\"name\":\"Magic Boots\"},\"replace\":{\"slug\":\"tough-boots\",\"name\":\"Tough Boots\"},\"trigger\":\"Use when the enemy has low chain control and shorter rift cycles matter more than tenacity.\"},{\"item\":{\"slug\":\"sky-piercer\",\"name\":\"Sky Piercer\"},\"replace\":{\"slug\":\"blade-of-despair\",\"name\":\"Blade of Despair\"},\"trigger\":\"Use only when Nolan is already converting early picks and can protect execute stacks through the next objective fight.\"},{\"item\":{\"slug\":\"rose-gold-meteor\",\"name\":\"Rose Gold Meteor\"},\"replace\":{\"slug\":\"immortality\",\"name\":\"Immortality\"},\"trigger\":\"Use against magic burst when a shield and movement burst save the first dive better than a delayed revive.\"}],\"notes\":\"Default jungle setup for priming Cosmic Leap with Heptaseas, detonating the first rift pair, then using Hunter Strike and Ice Retribution to keep the target inside follow-up range.\",\"totalCost\":11850,\"statLines\":[{\"key\":\"physatk\",\"labelKey\":\"common.stats.physicalAttack\",\"unit\":\"flat\",\"group\":\"offensive\",\"value\":370,\"sources\":[\"Blade of the Heptaseas\",\"Hunter Strike\",\"Malefic Roar\",\"Blade of Despair\"]},{\"key\":\"physpenFlat\",\"labelKey\":\"common.stats.physicalPenetration\",\"unit\":\"flat\",\"group\":\"offensive\",\"value\":30,\"sources\":[\"Blade of the Heptaseas\",\"Hunter Strike\"]},{\"key\":\"hp\",\"labelKey\":\"common.stats.hp\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":1050,\"sources\":[\"Blade of the Heptaseas\",\"Immortality\"]},{\"key\":\"physdefense\",\"labelKey\":\"common.stats.physicalDefense\",\"unit\":\"flat\",\"group\":\"defensive\",\"value\":15,\"sources\":[\"Immortality\"]},{\"key\":\"magicdefense\",\"labelKey\":\"common.stats.mag