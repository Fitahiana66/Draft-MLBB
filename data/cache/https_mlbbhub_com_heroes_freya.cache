me\":\"Christmas Carnival\",\"tier\":\"Exceptional\",\"rawTier\":\"Exceptional\",\"tag\":\"Christmas\",\"tagSlug\":\"christmas\",\"price\":\"Limited-time Event\",\"portraitFile\":\"Hero227-portrait.png\",\"portraitUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/freya/Hero227-portrait-20220525164806.webp\",\"splashUrl\":null,\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Freya/Cosmetics\"},{\"name\":\"Raven Shogun\",\"tier\":\"Deluxe\",\"rawTier\":\"Deluxe\",\"tag\":\"Epic\",\"tagSlug\":\"epic\",\"price\":\"899\",\"portraitFile\":\"Hero228-portrait.png\",\"portraitUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/freya/Hero228-portrait-20220525164807.webp\",\"splashUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/freya/Freya-Raven-Shogun-20231029212115.webp\",\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Freya/Cosmetics\"},{\"name\":\"S.A.B.E.R. Manhunter\",\"tier\":\"Deluxe\",\"rawTier\":\"Deluxe\",\"tag\":\"S.A.B.E.R.\",\"tagSlug\":\"s-a-b-e-r\",\"price\":\"899\",\"portraitFile\":\"Hero229-portrait.png\",\"portraitUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/freya/Hero229-portrait-20220525164809.webp\",\"splashUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/freya/Freya-S-A-B-E-R-Manhunter-20231029212129.webp\",\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Freya/Cosmetics\"},{\"name\":\"Galactic Vanquisher\",\"tier\":\"Supreme\",\"rawTier\":\"Supreme\",\"tag\":\"Legend\",\"tagSlug\":\"legend\",\"price\":\"200\",\"portraitFile\":\"Hero102210-portrait.png\",\"portraitUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/freya/Hero102210-portrait-20240114101726.webp\",\"splashUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/freya/Freya-Galactic-Vanquisher-20240122091706.webp\",\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Freya/Cosmetics\"},{\"name\":\"Spartan Spirit\",\"tier\":\"Exceptional\",\"rawTier\":\"Exceptional\",\"tag\":\"Starlight\",\"tagSlug\":\"starlight\",\"price\":\"2020/05 StarLight Reward\",\"portraitFile\":\"Hero226-portrait.png\",\"portraitUrl\":\"https://esportpedia.b-cdn.net/mlbbhub/skins/freya/Hero226-portrait-20220525164805.webp\",\"splashUrl\":null,\"sourceUrl\":\"https://mobile-legends.fandom.com/wiki/Freya/Cosmetics\"}],\"lore\":{\"backstory\":\"Freya is a Valkyrie warrior, a divine shield-maiden chosen by the gods to judge the worthy on the battlefield. She wields the sacred Wings of Faith, a pair of enchanted weapons that transform between sword and shield depending on her battle stance. When the gods fell silent and the Abyss grew bold, Freya descended from the divine halls to fight alongside mortals. Her Sacred Orbs mark her transition into Valkyrie state, where she becomes an unstoppable force of divine wrath that can turn the tide of any battle.\",\"allies\":[{\"heroSlug\":\"zilong\",\"heroName\":\"Zilong\",\"relationship\":\"Dragon warrior who earned her divine respect\"},{\"heroSlug\":\"argus\",\"heroName\":\"Argus\",\"relationship\":\"Former angel she hopes to redeem through combat\"}],\"rivals\":[{\"heroSlug\":\"dyrroth\",\"heroName\":\"Dyrroth\",\"relationship\":\"Abyssal prince who defies divine judgment\"},{\"heroSlug\":\"thamuz\",\"heroName\":\"Thamuz\",\"relationship\":\"Demon lord who challenges the gods' authority\"}]},\"loreUrlName\":\"FreyaValkyrie\",\"statsHistory\":[{\"date\":\"2026-09-07\",\"winRate\":47.57,\"pickRate\":0.56,\"banRate\":1.92},{\"date\":\"2026-09-10\",\"winRate\":47.53,\"pickRate\":0.56,\"banRate\":2},{\"date\":\"2026-09-16\",\"winRate\":47.56,\"pickRate\":0.56,\"banRate\":2.22},{\"date\":\"2026-09-28\",\"winRate\":47.38,\"pickRate\":0.51,\"banRate\":1.29},{\"date\":\"2026-10-02\",\"winRate\":47.61,\"pickRate\":0.52,\"banRate\":1.29},{\"date\":\"2026-10-09\",\"winRate\":47.88,\"pickRate\":0.56,\"banRate\":1.41},{\"date\":\"2026-10-17\",\"winRate\":48.11,\"pickRate\":0.7,\"banRate\":1.78}]},\"relatedHeroesSlot\":\"$L66\",\"statsSeoSlot\":\"$L67\",\"fieldManualSlot\":\"$L68\"}]\n61:[\"$\",\"$L69\",null,{\"heroName\