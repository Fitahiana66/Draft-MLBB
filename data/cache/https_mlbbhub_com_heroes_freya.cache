olTrend\",\"params\":{\"days\":7}}],\" \"]}],[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-trending-up inline-block w-2.5 h-2.5 sm:w-3.5 sm:h-3.5 text-text-muted\",\"aria-hidden\":\"true\",\"children\":[\"$La0\",\"$La1\",\"$undefined\"]}],\"+0.33%\"]}]]}]}],\"$La2\",\"$La3\"]]}]\n7b:[\"$\",\"p\",null,{\"className\":\"mt-3 flex flex-wrap items-center gap-x-5 gap-y-1.5 text-[11px] text-text-muted\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-1.5\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block h-3 w-5 rounded-sm bg-mlbb-gold/[0.07] ring-1 ring-inset ring-mlbb-gold/20\",\"aria-hidden\":\"true\"}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankColDelta\"}]]}],[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-1.5\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-trending-up h-3.5 w-3.5 text-text-muted\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"box55l\",{\"d\":\"M16 7h6v6\"}],[\"$\",\"path\",\"1t1m79\",{\"d\":\"m22 7-8.5 8.5-5-5L2 17\"}],\"$undefined\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankColTrend\",\"params\":{\"days\":7}}]]}]]}]\n7c:[\"$\",\"div\",null,{\"className\":\"mt-5 grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-3\",\"children\":[[\"$\",\"article\",\"epic\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #B07ECC, #B07ECC33)\",\"boxShadow\":\"0 0 12px -2px #B07ECC80\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#B07ECC\",\"background\":\"#B07ECC1a\",\"border\":\"1px solid #B07ECC40\"},\"children\":\"Epic\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Freya\",\"rank\":\"Epic\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=epic\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Epic\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Epic\",\"name\":\"Freya\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"46.66\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Freya\",\"delta\":\"-1.42%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.94\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"3.75\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Epic\"}}]]}]]}],[\"$\",\"article\",\"legend\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #4dc9f6, #4dc9f633)\",\"boxShadow\":\"0 0 12px -2px #4dc9f680\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#4dc9f6\",\"background\":\"#4dc9f61a\",\"border\":\"1px solid #4dc9f640\"},\"children\":\"Legend\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Freya\",\"rank\":\"Legend\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=legend\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Legend\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Legend\",\"name\":\"Freya\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"47.03\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Freya\",\"delta\":\"-1.05%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.65\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"2.50\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Legend\"}}]]}]]}],[\"$\",\"article\",\"mythic\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #f59e0b, #f59e0b33)\",\"boxShadow\":\"0 0 12px -2px #f59e0b80\"}}],\"$La4\",\"$La5\"]}],\"$La6\",\"$La7\"]}]\n7e:[\"$\",\"p\",\"p-2\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Good drafts to pair her with: Franco + Chang'e + Freya + Karrie + Estes (two frontline, one melts, one peels). Bad drafts: any composition where Freya is the lane bully and primary initiator at the same time.\"}]\n7f:[\"$\",\"h2\",\"h2-1\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The one thing that makes Freya work\"]}]\n80:[\"$\",\"p\",\"p-3\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Freya is a meter that refills with basic attacks. Everything in her kit is downstream of that meter.\"}]\n81:[\"$\",\"p\",\"p-4\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The Power of Einherjar passive caps at 6 Sacred Orbs. Every basic attack generates one, and orbs regenerate slowly out of combat. Consuming one grants 100% attack speed on her next basic (a fully-stacked orb bar is roughly 1.5 seconds of uninterrupted empowered autos). Valkyrie Slash has no base cooldown at all but consumes 2 orbs per cast. Her ultimate dives onto a target area with Control Immunity, slows everyone in the landing path, and enters a 10-second Valkyrie state with ranged splash basics that deal bonus damage and recover HP.\"}]\n82:[\"$\",\"p\",\"p-5\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"This is why she feels broken when she is strong and griefable when she is weak. If you walk into a fight with 6 orbs and ult ready, you are a melee hero who throws two S2 dashes and then unloads ten seconds of ranged splash autos that heal on every hit. If you walk in with 0 orbs, you are a bruiser with a jump-in shield and no damage amplifier. The gap between those two states is the entire hero.\"}]\n83:[\"$\",\"p\",\"p-6\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The rework's stated goal was fixing the \\\"spam S2 to buff attack speed\\\" problem. It succeeded. The new problem is that players treat the orb bar like mana (infinite) instead of like a charge counter (6, use carefully). Auto a jungle camp for 3 seconds before rotating to lane. That's the whole identity.\"}]\n84:[\"$\",\"h2\",\"h2-2\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Laning: the first five minutes\"]}]\n85:[\"$\",\"ol\",\"ol-1\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Open with S1 at level 1 in the EXP lane\"}],\", S2 first if you are jungle. The skill upgrade priority for EXP is 3-2-1 (ult \u003e S2 \u003e S1), but level 1 S1 wins trades harder than level 1 S2 because the shield absorbs minion aggro and the airborne knock locks in your damage.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Stack the orb bar before the wave arrives.\"}],\" Basic-attack the first minion wave fully to enter the meeting at 6 orbs. If your opponent is Paquito or Yu Zhong, do not trade without a full bar. A 6-orb empowered S2 into basic chain is roughly 40% of their HP at level 4; an empty-bar S2 is a tickle.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Burn Flicker over Retribution in EXP lane.\"}],\" The old editorial recommended Retribution. Wrong for EXP Freya. Flicker is the gap-closer she does not have in her base kit: her S1 is telegraphed and dodgeable, her S2 needs orbs. Flicker-S1 is the actual engage. Keep Retribution for the jungle role only.\"]}],\"\\n\"]}]\n86:[\"$\",\"p\",\"p-7\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The level 4 all-in is the first real power window. 6 orbs, rank 2 S1 up, ult just off cooldown. Walk into minion aggro, Flicker on top of them, S1 to knock airborne, S2 twice to dump orbs (burns 4 of 6), basic attack twice more for the last two orbs, then walk out. This kills most EXP laners without an escape skill and forces a recall from anyone with a dash.\"}]\n87:[\"$\",\"h2\",\"h2-3\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The power spike you are farming toward\"]}]\n88:[\"$\",\"p\",\"p-8\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[\"Freya's spike is \",[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"War Axe plus attack-speed boots at around the 6-to-8 minute mark\"}],\", not a two-item damage spike like most fighters.\"]}]\n89:[\"$\",\"p\",\"p-9\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"War Axe's Fighting Spirit passive grants 12 extra Physical Attack per second for 4 seconds, stacking up to 6 times, with a 10% true damage bonus at full stacks. Freya stacks it faster than almost any other hero in the game because her ranged splash basics during Valkyrie state each count as separate attack instances. A full 6-stack proc on ult against a 5-man huddle applies true damage to everyone in the splash radius. This is the specific mechanical reason War Axe is non-negotiable on her: no other second item compounds her ult like it does.\"}]\n8a:[\"$\",\"p\",\"p-10\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"What changes at that spike: pre-War Axe, you have to commit your ult to secure a single kill. Post-War Axe, you cast ult on the front of a teamfight and three enemies take meaningful true-damage bleed for the full 10 seconds, not just your primary target. You stop needing to pick the right ult target and start just picking the most central one.\"}]\n8b:[\"$\",\"p\",\"p-11\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Patch 2.1.88 raised the cooldown to 44-28 seconds (still starting after cast, not on cast), up from the 34-26 established in the 2.1.40 buff. At max rank, a 10-second active window plus 28 seconds of downtime gives you roughly 1.5 Valkyrie cycles per minute in the mid-game. Plan your objectives around those windows: turtle timing, lord timing, third-rotation ganks. If your ult is on cooldown, your job is split-push and wave-clear, not skirmish.\"}]\n8c:[\"$\",\"h2\",\"h2-4\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Teamfight positioning and target priority\"]}]\n8d:[\"$\",\"p\",\"p-12\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The reflex when you see a stacked teamfight is to ult into the middle of it. That reflex is wrong more often than it is right.\"}]\n8e:[\"$\",\"ol\",\"ol-2\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Land ult behind the enemy frontline, not on top of it.\"}],\" The dive slow on the landing path and the ranged splash basics are meant to deny the enemy backline from repositioning. If you land on the tank, the marksman just walks backward and you auto-attack a Khufra for 10 seconds. Aim for the gap behind their Gloo, between Clint and the wall.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Do not S1 to engage once you are in Valkyrie state.\"}],\" S1 breaks the Valkyrie animation and you lose roughly 1.5 seconds of ranged splash basics. Save S1 for the moment their support dashes in to peel. You want the knock-airborne on the Estes, not on the tank you already landed next to.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Track your orb count during the ult.\"}],\" Valkyrie state does not pause the passive. You are still spending orbs on S2, and you can still auto yourself to 0 orbs if you mash. The 100% attack speed buff from orb consumption during Valkyrie is the highest single damage moment in the kit. If you are about to execute a low-HP target, hold your next S2 so the orb-empowered basic lands first.\"]}],\"\\n\"]}]\n8f:[\"$\",\"p\",\"p-13\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Support-conditional edge case: if your support is Estes, you can push your ult landing spot 2-3 body-lengths deeper because his regen partially covers Freya's reduced sustain in Valkyrie state. If your support is Diggie or Mathilda, you do not get that depth. Land on the frontline edge instead of deep.\"}]\n90:[\"$\",\"$La8\",null,{\"slot\":\"7246933188\",\"variant\":\"in-article\",\"className\":\"my-8\"}]\n91:[[\"$\",\"h2\",\"h2-0\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Itemization: two locked slots plus three real conversations\"]}],\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[\"Locked slots: \",[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"War Axe\"}],\" and \",[\"$\",\"strong\",\"strong-1\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Immortality\"}],\". Build them in every game, in that order, with War Axe first. The 220-1200 shield scale on Immortality respawn plus the 16% Max HP regen is mathematically worth more on Freya than on most fighters because her re-engage tool is her ult cooldown, which refreshes while dead.\"]}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[\"Flex slot 1, \",[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"attack-speed item\"}],\": Corrosion Scythe or Golden Staff. Corrosion gives you the slow on basics (80 extra physical damage, 8% slow, up to 5 stacks) which glues runners to you during Valkyrie state. Golden Staff's Endless Strike passive adds 80% attack speed on every third basic and extends the AS cap to 500%, which scales harder in 20+ minute games. Pick Corrosion if enemies have escape tools (Lancelot, Fanny). Pick Golden Staff if they do not and the game will go long.\"]}],\"\\n\",[\"$\",\"p\",\"p-2\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[\"Flex slot 2, \",[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"second attack item\"}],\": Endless Battle or Haas's Claws. Endless Battle's Divine Justice passive triggers 60% Physical Attack as true damage on the first basic after a skill cast; Freya casts a skill every 1-2 seconds during Valkyrie state, so this passive fires roughly 6-8 times per ult. Haas's Claws is the crit-build path (20% crit, 15% AS, Frenzy stacks 20% AS on crits): pick it only if you are also running Golden Staff for the crit-to-AS conversion.\"]}],\"\\n\",[\"$\",\"p\",\"p-3\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[\"Flex slot 3, \",[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"defensive\"}],\": Brute Force Breastplate if they have two or more physical threats; Oracle or Radiant Armor if they have two magic threats. Avoid stacking pure defense (Dominance Ice on Freya is a beginner trap: it is straight Physical and Magic Defense with no attack stats, and her kit's shield and Valkyrie-state healing already cover the survive-and-swing fantasy).\"]}],\"\\n\",[\"$\",\"p\",\"p-4\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[\"Stacking conflict to know: \",[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Corrosion Scythe and Feather of Heaven share the Impulse passive, which does not stack between items\"}],\". Never buy both. A common mistake is adding Feather on top of Corrosion expecting attack-speed compounding; you are paying 2000g for a 30% attack-speed boost that overwrites the one you already have.\"]}],\"\\n\",[\"$\",\"p\",\"p-5\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[\"Boots: \",[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Warrior Boots\"}],\" (+18 physical defense, Valor passive for stacking defense under fire) for most games. \",\"$La9\",\" only if you are ahead and split-pushing. Never Tough Boots; the dive's Control Immunity plus her own shield means raw magic defense is a worse return than movement speed.\"]}],\"\\n\",\"$Laa\",\"\\n\",\"$Lab\",\"\\n\",\"$Lac\",\"\\n\",\"$Lad\",\"\\n\",\"$Lae\",\"\\n\",\"$Laf\",\"\\n\",\"$Lb0\",\"\\n\",\"$Lb1\",\"\\n\",\"$Lb2\",\"\\n\",\"$Lb3\",\"\\n\",\"$Lb4\",\"\\n\",\"$Lb5\",\"\\n\",\"$Lb6\"]\n92:[\"$\",\"$Lb7\",null,{\"heroName\":\"Freya\"}]\n"])</script><script>self.__next_f.push([1,"93:[\"$\",\"div\",null,{\"className\":\"relative bg-surface-4 border border-mlbb-gold/20 overflow-hidden card-hover hover:border-mlbb-gold/50\",\"style\":{\"boxShadow\":\"0 2px 8px rgba(0,0,0,0.3)\"},\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 p-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative w-14 h-14 rounded-full overflow-hidden flex-shrink-0 bg-surface-3\",\"children\":[\"$\",\"$L6b\",null,{\"src\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_c5d24a1dad6cef21de2698a4ed1d80ce.png\",\"alt\":\"Minsitthar - Courageous Warrior\",\"unoptimized\":false,\"priority\":\"$undefined\",\"fetchPriority\":\"$undefined\",\"fill\":true,\"class