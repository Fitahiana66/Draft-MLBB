ending-up h-3.5 w-3.5 text-text-muted\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"box55l\",{\"d\":\"M16 7h6v6\"}],[\"$\",\"path\",\"1t1m79\",{\"d\":\"m22 7-8.5 8.5-5-5L2 17\"}],\"$undefined\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankColTrend\",\"params\":{\"days\":7}}]]}]]}]\n7c:[\"$\",\"div\",null,{\"className\":\"mt-5 grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-3\",\"children\":[[\"$\",\"article\",\"epic\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #B07ECC, #B07ECC33)\",\"boxShadow\":\"0 0 12px -2px #B07ECC80\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#B07ECC\",\"background\":\"#B07ECC1a\",\"border\":\"1px solid #B07ECC40\"},\"children\":\"Epic\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Rafaela\",\"rank\":\"Epic\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=epic\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Epic\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Epic\",\"name\":\"Rafaela\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"55.11\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Rafaela\",\"delta\":\"-1.67%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.72\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"4.96\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Epic\"}}]]}]]}],[\"$\",\"article\",\"legend\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"absolute left-0 top-0 bottom-0 w-[3px]\",\"style\":{\"background\":\"linear-gradient(to bottom, #4dc9f6, #4dc9f633)\",\"boxShadow\":\"0 0 12px -2px #4dc9f680\"}}],[\"$\",\"header\",null,{\"className\":\"mb-2 flex items-baseline justify-between gap-x-3 gap-y-1 flex-wrap\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"flex items-baseline gap-2.5 text-sm md:text-base font-heading font-semibold text-text-primary uppercase tracking-[0.06em]\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block rounded-sm px-2 py-0.5 text-[10px] font-bold tracking-[0.16em] self-center\",\"style\":{\"color\":\"#4dc9f6\",\"background\":\"#4dc9f61a\",\"border\":\"1px solid #4dc9f640\"},\"children\":\"Legend\"}],[\"$\",\"span\",null,{\"children\":[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankCardH3\",\"params\":{\"name\":\"Rafaela\",\"rank\":\"Legend\"}}]}]]}],[\"$\",\"$L40\",null,{\"href\":\"/tier-list?rank=legend\",\"prefetch\":false,\"className\":\"text-[11px] font-heading uppercase tracking-[0.18em] text-text-accent hover:text-text-accent-bright transition-colors\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankTierListLink\",\"params\":{\"rank\":\"Legend\"}}],\" →\"]}]]}],[\"$\",\"p\",null,{\"className\":\"text-text-muted text-[13px] leading-relaxed\",\"children\":[[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceLead\",\"params\":{\"rank\":\"Legend\",\"name\":\"Rafaela\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"57.06\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid1\",\"params\":{\"name\":\"Rafaela\",\"delta\":\"+0.28%\"}}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"0.97\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceMid2\"}],[\"$\",\"strong\",null,{\"className\":\"text-text-primary\",\"children\":[\"13.14\",\"%\"]}],[\"$\",\"$L4c\",null,{\"k\":\"pages.heroes.rankSentenceAfter\",\"params\":{\"rank\":\"Legend\"}}]]}]]}],[\"$\",\"article\",\"mythic\",{\"className\":\"group relative min-w-0 border border-mlbb-gold/15 bg-surface-1/40 p-3.5 pl-5 md:p-4 md:pl-6 transition-colors hover:border-mlbb-gold/30\",\"children\":[\"$La0\",\"$La1\",\"$La2\"]}],\"$La3\",\"$La4\"]}]\n7e:[\"$\",\"h2\",\"h2-1\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Everything good she does starts with spacing, not healing\"]}]\n7f:[\"$\",\"p\",\"p-3\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Rafaela wins games by changing spacing. Healing is only the visible part.\"}]\n80:[\"$\",\"p\",\"p-4\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Light of Retribution is the skill that makes the hero work. It checks bushes, breaks conceal patterns, tags runners with a slow, and stacks extra damage when the same target keeps getting clipped. Patch 2.1.88 pushed its early damage up enough that the poke is now a genuine lane threat rather than a utility ping, which rewards keeping the same target in range. That means Rafaela is strongest when fights stay connected for a few seconds and the enemy has to keep walking through the same corridor.\"}]\n81:[\"$\",\"p\",\"p-5\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Holy Healing looks like a sustain button, but it is really a positioning tool with healing attached. The move speed is what lets your jungler arrive first, lets your marksman kite one more step, or lets your EXP laner stay close enough to finish an all-in. The heal matters, especially after Rafaela's last buff in patch 2.1.40 improved the magic scaling and speed-up value, but the reason the hero stays relevant is that she changes who controls distance.\"}]\n82:[\"$\",\"p\",\"p-6\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Holy Baptism then punishes whatever that spacing creates. Its animation is not fast enough to be a blind engage tool from max range. It is a confirmation spell. Use it when the target's path is already narrowed by a wall, a chase line, an ally's crowd control, or their own greed.\"}]\n83:[\"$\",\"p\",\"p-7\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Once you read the kit that way, Rafaela stops feeling like a passive backline nurse and starts reading like what she is: a traffic officer for skirmishes.\"}]\n84:[\"$\",\"h2\",\"h2-2\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The first five minutes\"]}]\n85:[\"$\",\"ol\",\"ol-0\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Start with Light of Retribution and escort the first clear.\"}],\" Help your jungler on the opening buff, then sweep the nearest river and mid bushes with S1 before the first rotation turns violent. Rafaela's best early value is denying a cheese invade and making the first mid contest safer for her team.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Use Holy Healing after contact, not before it.\"}],\" If you cast S2 while nobody is threatened, you spend mana for nothing and your ally reaches the fight with no rescue tool left. Wait until the enemy commits a slow, dash, or first burst spell, then answer with the speed-up so your ally either escapes the second layer or chases the retreat.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Keep Flicker or Sprint for the stun angle, not for travel time.\"}],\" Rafaela already rotates fast enough. Burning your spell just to arrive earlier removes the only thing that makes Holy Baptism reliable against competent players. Save the spell for the moment when a clean line stun decides Turtle or saves your carry from a dive.\"]}],\"\\n\"]}]\n86:[\"$\",\"p\",\"p-8\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"If a lane is stable, do not babysit it. Rafaela gains value by revisiting mid, river, and the next collapse point over and over. She is a rhythm roamer, not a pocket support.\"}]\n87:[\"$\",\"h2\",\"h2-3\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"The spike you are farming toward\"]}]\n88:[\"$\",\"p\",\"p-9\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[\"Rafaela's real two-item spike is \",[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Enchanted Talisman plus Flask of the Oasis\"}],\", usually around the 8 to 10 minute mark if your early rotations were clean.\"]}]\n89:[\"$\",\"p\",\"p-10\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Enchanted Talisman fixes the hero's biggest structural problem. Rafaela wants to cast on every rotation, but she spends mana fast and hates slow, empty recalls. Talisman gives cooldown reduction, mana sustain through Mana Spring, and an extra cap on cooldown reduction so you can keep S1 and S2 available for every river fight instead of every other one.\"}]\n8a:[\"$\",\"p\",\"p-11\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Flask is what turns the hero from annoying into decisive. Once it is online, every well-timed heal or shield cast on a threatened ally can create a rescue shield and shave time off Rafaela's own cooldowns. Mechanically that changes everything. Before Flask, your second cast often arrives after the target dies. After Flask, the first rescue frequently creates the time window for the second rescue.\"}]\n8b:[\"$\",\"p\",\"p-12\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"That is the moment when you stop playing only to stabilize lanes and start forcing repeated skirmishes. If your assassin or fighter is even on gold, this is the window where Rafaela lets them play above curve.\"}]\n8c:[\"$\",\"$La5\",null,{\"slot\":\"7246933188\",\"variant\":\"in-article\",\"className\":\"my-8\"}]\n8d:[[\"$\",\"h2\",\"h2-0\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Teamfights: do not stand too far back\"]}],\"\\n\",[\"$\",\"p\",\"p-0\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"The common wrong reflex is hiding behind the marksman and pressing heal on cooldown. That is how Rafaela turns into a worse Estes. She needs to play close enough to control entry paths, but never so close that she becomes the first clean target.\"}],\"\\n\",[\"$\",\"p\",\"p-1\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Three positioning rules matter more than raw healing numbers:\"}],\"\\n\",[\"$\",\"ol\",\"ol-0\",{\"className\":\"list-decimal list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Stand one step off your front line, not two steps behind your carry.\"}],\" You need S1 range on bushes, flank paths, and the first diver. If you stand too deep, the assassin reaches your backline before you have touched them once.\"]}],\"\\n\",[\"$\",\"li\",\"li-1\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Aim Holy Baptism at where the target must go next.\"}],\" The spell is strongest as follow-up or peel. Fire through the choke, the wall exit, or the dash landing spot. Max-range guesses get sidestepped and waste the fight.\"]}],\"\\n\",[\"$\",\"li\",\"li-2\",{\"className\":\"text-[#9BA0B4]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"Heal on damage breakpoints, not on rhythm.\"}],\" Good Rafaela players do not mash S2 whenever it lights up. They wait for the enemy's second layer of damage, then answer after anti-heal or crowd control has already been committed.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",\"p-2\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"There is one edge case where you can play greedier. If your team already has a hard engage tank like Khufra or Atlas starting fights for you, Rafaela can step wider to look for an immediate follow-up stun. If your only frontliner is a bruiser who wants to kite in and out, keep Holy Baptism for peel and stay much tighter to your carry line.\"}],\"\\n\",[\"$\",\"h2\",\"h2-1\",{\"className\":\"text-xl md:text-[26px] font-heading font-bold text-[#F0D060] mt-10 mb-4 first:mt-0 text-balance uppercase tracking-[0.04em] leading-tight relative\",\"children\":[[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"block w-10 h-[3px] bg-gradient-to-r from-[#F0D060] to-[#C8AA6E]/0 mb-3\"}],\"Itemization: the locked core and the real flexes\"]}],\"\\n\",[\"$\",\"p\",\"p-3\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":\"Rafaela does not have six open item slots. She has a core, then a set of conversations.\"}],\"\\n\",[\"$\",\"p\",\"p-4\",{\"className\":\"text-[#9BA0B4] leading-relaxed mb-4 text-[15px]\",\"children\":[[\"$\",\"strong\",\"strong-0\",{\"className\":\"text-[#E8E6E3] font-semibold\",\"children\":\"The locked core is boots, Enchanted Talisman, and Flask of the Oasis.\"}],\" Talisman solves the mana and cooldown problem. Flask gives her first real mid-game rescue threshold. Boots are the pacing slot:\"]}],\"\\n\",[\"$\",\"ul\",\"ul-0\",{\"className\":\"list-disc list-inside text-[#9BA0B4] my-3 space-y-2 ml-2\",\"children\":[\"\\n\",[\"$\",\"li\",\"li-0\",{\"className\":\"text-[#9BA0B4]\",\"children\":[\"$La6\",\" are the default when the enemy has real crowd control or magic poke. Rafaela dies if she gets chain locked, so tenacity and magic defense are never wasted.\"]}],\"\\n\",\"$La7\",\"\\n\"]}],\"\\n\",\"$La8\",\"\\n\",\"$La9\",\"\\n\",\"$Laa\",\"\\n\",\"$Lab\",\"\\n\",\"$Lac\",\"\\n\",\"$Lad\",\"\\n\",\"$Lae\",\"\\n\",\"$Laf\",\"\\n\",\"$Lb0\",\"\\n\",\"$Lb1\",\"\\n\",\"$Lb2\",\"\\n\",\"$Lb3\",\"\\n\",\"$Lb4\"]\n8e:[\"$\",\"$Lb5\",null,{\"heroName\":\"Rafaela\"}]\n"])</script><script>self.__next_f.push([1,"8f:[\"$\",\"div\",null,{\"className\":\"relative bg-surface-4 border border-mlbb-gold/20 overflow-hidden card-hover hover:border-mlbb-gold/50\",\"style\":{\"boxShadow\":\"0 2px 8px rgba(0,0,0,0.3)\"},\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 p-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative w-14 h-14 rounded-full overflow-hidden flex-shrink-0 bg-surface-3\",\"children\":[\"$\",\"$L6b\",null,{\"src\":\"https://akmweb.youngjoygame.com/web/svnres/img/test/homepage_2_2_16_1232_1/100_d9251718a8894546ba04cfa9ca68dedc.png\",\"alt\":\"Odette - Swan Princess\",\"unoptimized\":false,\"priority\":\"$undefined\",\"fetchPriority\":\"$undefined\",\"fill\":true,\"className\":\"object-cover group-hover:scale-110 transition-transform duration-300\",\"sizes\":\"56px\",\"placeholder\":\"blur\",\"blurDataURL\":\"data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTAwIiBoZWlnaHQ9IjEwMCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48cmVjdCB3aWR0aD0iMTAwIiBoZWlnaHQ9IjEwMCIgZmlsbD0iIzBkMTIyNSIvPjwvc3ZnPg==\"}]}],[\"$\",\"div\",null,{\"className\":\"flex-1 min-w-0\",\"children\":[[\"$\",\"h4\",null,{\"className\":\"font-heading font-bold text-text-primary group-hover:text-text-accent-bright transition-colors truncate\",\"children\":\"Odette\"}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mt-0.5\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-[10px] font-heading uppercase tracking-wider px-1.5 py-0.5\",\"style\":{\"